// The theme gallery of the settings page (docs/device-themes.md, section 4; mockup
// docs/mockups/device-themes/gallery/gallery.html, layout B): one sideways strip per
// group, Classic and Devices, with page arrows, a thin scroll bar and a fade. A click
// switches the theme at once. The classic tiles are the main page drawn live from the
// palette; the device tiles are pictures in skins/thumbs (tools/skin-art/thumbs.py).
// Drawn in the Ember look, or the Tape Deck or Phosphor or Desktop 95 or Comic Book look while that theme is on; Spatial Glass
// tints the Ember look (a white frame and check bead, a cyan focus ring, no fades). The Quest The Brick The
// Menu frames each picture in pixels: grey, white on the lit tile, gold with the glove on the
// current one, and a gold ring round the keyboard focus.
// Phone draws smaller framed tiles on its LCD, the current one inverted in a double frame.
// Pocket Synth draws its tiles as pads, the current one lit orange, and a row of LEDs for
// where the strip is. Fighter Select draws select rows: name plates, the current tile in a
// red frame with the P1 cursor and tag, a red scroll bar.

import { Theme, Deck, Ph, Os, OsBevel, OsDotted, Comic, InkShadow, Glass, Quest, QPx, Brick, Am, Palette, Icon, IconBtn, Win, Pk, PkRing, PkTile, SynKey, Fi, FiSkew, Cz, CzWell } from "common.slint";
import { Pb } from "skins/x-pinball-parts.slint";

export struct ThemeTile {
    // As in Theme.names.
    name: string,
    art: image,
    art2: image,
    // The colour band of its Tape Deck label.
    band: color,
    // Its place in Theme.names, filled in from Rust.
    index: int,
}

export global Gallery {
    // One line per device skin. Adding a skin's tile is adding its line here, with the
    // same name as in Theme.names; the art of all 15 skins is in skins/thumbs already.
    out property <[ThemeTile]> devices: [
        { name: "Tape Deck", art: @image-url("skins/thumbs/tape.png"), art2: @image-url("skins/thumbs/tape@2x.png"), band: #c9331f },
        { name: "Phosphor", art: @image-url("skins/thumbs/phosphor.png"), art2: @image-url("skins/thumbs/phosphor@2x.png"), band: #3fd46a },
        { name: "Desktop 95", art: @image-url("skins/thumbs/dv-os95.png"), art2: @image-url("skins/thumbs/dv-os95@2x.png"), band: #008080 },
        { name: "Comic Book", art: @image-url("skins/thumbs/x-comic.png"), art2: @image-url("skins/thumbs/x-comic@2x.png"), band: #f2c230 },
        { name: "Spatial Glass", art: @image-url("skins/thumbs/x-spatial.png"), art2: @image-url("skins/thumbs/x-spatial@2x.png"), band: #9aa6c8 },
        { name: "Car Dashboard", art: @image-url("skins/thumbs/x-dash.png"), art2: @image-url("skins/thumbs/x-dash@2x.png"), band: #3aa0d6 },
        { name: "Pocket", art: @image-url("skins/thumbs/px-pocket.png"), art2: @image-url("skins/thumbs/px-pocket@2x.png"), band: #8bac0f },
        { name: "Quest Menu", art: @image-url("skins/thumbs/px-quest.png"), art2: @image-url("skins/thumbs/px-quest@2x.png"), band: #2f5fd0 },
        { name: "Brick Phone", art: @image-url("skins/thumbs/dv-brick.png"), art2: @image-url("skins/thumbs/dv-brick@2x.png"), band: #7a8a3a },
        { name: "Answering Machine", art: @image-url("skins/thumbs/dv-answer.png"), art2: @image-url("skins/thumbs/dv-answer@2x.png"), band: #d9452b },
        { name: "Pocket Synth", art: @image-url("skins/thumbs/dv-synth.png"), art2: @image-url("skins/thumbs/dv-synth@2x.png"), band: #ff6a1a },
        { name: "Fighter Select", art: @image-url("skins/thumbs/x-fighter.png"), art2: @image-url("skins/thumbs/x-fighter@2x.png"), band: #d63a2a },
        { name: "Cozy Cabin", art: @image-url("skins/thumbs/px-cozy.png"), art2: @image-url("skins/thumbs/px-cozy@2x.png"), band: #c9822e },
        { name: "Pinball", art: @image-url("skins/thumbs/x-pinball.png"), art2: @image-url("skins/thumbs/x-pinball@2x.png"), band: #e0316b },
        { name: "Phonograph", art: @image-url("skins/thumbs/x-phono.png"), art2: @image-url("skins/thumbs/x-phono@2x.png"), band: #b48c4b },
    ];
    // Set from Rust at start: the classic themes, and the lines above whose theme is in
    // Theme.names, both in the order of Theme.names and with their place there.
    in property <[ThemeTile]> classic;
    in property <[ThemeTile]> shown;
}

// A classic theme's tile picture: its main page in miniature, plain rectangles in its
// colours, so it follows any palette change.
component Mini inherits Rectangle {
    in property <Palette> p;
    width: 104px;
    height: 64px;
    clip: true;
    background: p.bg;
    Rectangle { x: 0; y: 0; width: 104px; height: 5px; background: p.footer; }
    Rectangle { x: 4px; y: 8px; width: 38px; height: 46px; border-radius: 4px; background: p.card; }
    Rectangle { x: 9px; y: 15px; width: 24px; height: 5px; border-radius: 1px; background: p.text; }
    Rectangle { x: 9px; y: 23px; width: 15px; height: 2px; background: p.wave; }
    Rectangle { x: 16px; y: 33px; width: 14px; height: 14px; border-radius: 7px; background: p.accent; }
    Rectangle { x: 46px; y: 8px; width: 54px; height: 6px; border-radius: 3px; background: p.raised; }
    for r in 5: Rectangle {
        x: 46px;
        y: 17px + r * 7.5px;
        width: 54px;
        height: 6px;
        border-radius: 2px;
        background: r == 1 ? p.raised : p.row;
        if r == 1: Rectangle { x: 0; width: 2px; background: root.p.accent; }
        Rectangle { x: 4px; y: 2px; width: 14px; height: 2px; background: root.p.text; opacity: 0.75; }
        Rectangle { x: 26px; y: 2px; width: 18px; height: 2px; background: root.p.wave; }
    }
    Rectangle { x: 0; y: 57px; width: 104px; height: 7px; background: p.footer; }
    Rectangle { x: 4px; y: 60px; width: 30px; height: 1px; background: p.accent; }
}

// One tile: a radio button named after its theme.
component Tile inherits Rectangle {
    in property <ThemeTile> tile;
    in property <bool> classic;
    in property <bool> focused;
    callback picked();
    out property <bool> on: root.tile.index == Theme.current;
    property <bool> hover: t.has-hover;
    property <bool> down: t.pressed && t.has-hover;
    property <bool> hi: 1phx < 0.7px;
    width: Theme.brick ? 72px : 110px;
    height: Theme.brick ? 66px : 90px;
    accessible-role: radio-button;
    accessible-label: root.tile.name;
    accessible-checked: root.on;
    accessible-action-default => { root.picked(); }

    // Pocket: the picture in a dark 2px frame, its name in small caps under it; the
    // current one double framed with its name on a dark tag and a corner flag, the focused
    // one double framed in mid green, a mid green name under the pointer.
    if Theme.pocket: Rectangle {
        Rectangle {
            x: 3px;
            y: 3px;
            width: 104px;
            height: 64px;
            opacity: root.down ? 0.8 : 1;
            if root.classic: Mini { p: Theme.palettes[root.tile.index]; }
            if !root.classic: Image {
                width: 104px;
                height: 64px;
                source: root.hi ? root.tile.art2 : root.tile.art;
                image-fit: fill;
            }
        }
        PkRing { x: 1px; y: 1px; width: 108px; height: 68px; }
        if root.on || root.focused: PkRing { x: -1px; y: -1px; width: 112px; height: 72px; ink: Pk.l0; }
        if root.on || root.focused: PkRing { x: -3px; y: -3px; width: 116px; height: 76px; ink: root.on ? Pk.l3 : Pk.l1; }
        if root.on: Path {
            x: 110px - 6px - 12px;
            y: 5px;
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            commands: "M 0 0 L 12 0 L 12 12 Z";
            fill: Pk.l3;
        }
        Rectangle {
            x: 1px;
            y: 74px;
            // A long name (Answering Machine) runs a little into the gap and sets tighter.
            width: min(pk-name.preferred-width + 6px, 118px);
            height: 13px;
            background: root.on ? Pk.l3 : root.hover ? Pk.l1 : transparent;
            PkRing { visible: root.focused && !root.on; }
            pk-name := Text {
                x: 3px;
                width: parent.width - 6px;
                text: root.tile.name.to-uppercase();
                color: root.on ? Pk.l0 : Pk.l3;
                font-family: Pk.small;
                font-size: 8px;
                letter-spacing: pk-fit.preferred-width + 6px > 118px ? 0 : 0.5px;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            pk-fit := Text {
                visible: false;
                text: pk-name.text;
                font-family: Pk.small;
                font-size: 8px;
                letter-spacing: 0.5px;
                accessible-role: none;
            }
        }
    }

    // Ember: a framed picture, the name under it, a check on the current one.
    if !Theme.tape && !Theme.phos && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.brick && !Theme.synth && !Theme.fighter && !Theme.cozy: Rectangle {
        Rectangle {
            y: 0;
            height: 70px;
            border-radius: Theme.pinball ? 0 : Theme.answer ? 6px : 8px;
            border-width: root.on || root.focused ? 2px : 1px;
            border-color: Theme.glass ? (root.focused ? Glass.cyan : root.on ? #ffffff : root.hover || root.down ? #ffffff73 : #ffffff2e)
                : Theme.answer ? (root.focused ? Am.amber : root.on ? Am.rec : root.hover || root.down ? Am.print-soft : Am.edge)
                : root.focused ? Theme.text : root.on ? Theme.accent : root.hover || root.down ? Theme.edge : Theme.divider;
            background: Theme.glass ? (root.down ? #ffffff26 : root.hover ? #ffffff1a : #0000002e)
                : Theme.answer ? (root.on ? Am.lit : root.down ? #e1d7c1 : root.hover ? #e8dfcb : Am.paper)
                : root.down ? Theme.raised : root.hover ? Theme.hover : Theme.bg;
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: 104px;
            height: 64px;
            opacity: root.down ? 0.8 : 1;
            if root.classic: Mini { p: Theme.palettes[root.tile.index]; }
            if !root.classic: Image {
                width: 104px;
                height: 64px;
                source: root.hi ? root.tile.art2 : root.tile.art;
                image-fit: fill;
            }
        }
        // Answering Machine: a red lamp instead of the check.
        if root.on && Theme.answer: Rectangle {
            x: 110px - 14px;
            y: 6px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: #ffd2c6;
            Rectangle { x: 1px; y: 1px; width: 6px; height: 6px; border-radius: 3px; background: Am.led; }
        }
        if root.on && !Theme.answer: Rectangle {
            x: 110px - 12px;
            y: -6px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: Theme.glass ? #ffffff : Theme.accent;
            Icon {
                name: "check";
                tint: Theme.glass ? #24222b : Theme.on-accent;
                stroke-width: 1.8px;
                width: 11px;
                height: 11px;
            }
        }
        Text {
            y: 75px;
            height: 15px;
            text: root.tile.name;
            color: Theme.glass ? (root.on || root.hover ? Glass.ink : Glass.ink2) : Theme.answer ? (root.on ? Am.rec : Am.print) : root.on ? Theme.accent : root.hover ? Theme.text : Theme.muted;
            font-family: Theme.pinball ? Pb.font : Theme.answer ? "Courier Prime" : Theme.pages == 6 ? "Manrope" : "Inter Tight";
            font-size: Theme.answer ? 11px : 12px;
            font-weight: Theme.pinball ? 600 : Theme.answer ? 700 : root.on ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }

    // Quest Menu: the picture in a 3px pixel frame, the name under it; the lit tile on the
    // light blue, the current one framed in gold with its name gold and the glove.
    if Theme.quest: Rectangle {
        Rectangle { visible: root.hover || root.down; background: Quest.sel; }
        Rectangle {
            visible: root.focused;
            x: -6px;
            y: -6px;
            width: 122px;
            height: 82px;
            border-width: 3px;
            border-color: Quest.gold;
            Rectangle { x: 3px; y: 3px; width: 116px; height: 76px; border-width: 3px; border-color: Quest.ink; }
        }
        Rectangle {
            x: 0;
            y: 0;
            width: 110px;
            height: 70px;
            background: Quest.ink;
            border-width: 3px;
            border-color: root.on ? Quest.gold : root.focused ? Quest.pale : root.hover || root.down ? Quest.white : Quest.grey;
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: 104px;
            height: 64px;
            opacity: root.down ? 0.8 : 1;
            if root.classic: Mini { p: Theme.palettes[root.tile.index]; }
            if !root.classic: Image {
                width: 104px;
                height: 64px;
                source: root.hi ? root.tile.art2 : root.tile.art;
                image-fit: fill;
            }
        }
        if root.on: QPx {
            x: 0;
            y: 75px + (15px - self.height) / 2;
            source: @image-url("skins/px-quest/hand.png");
            s: 2;
        }
        Text {
            x: root.on ? 18px : 0;
            y: 75px;
            width: root.on ? 92px : 110px;
            height: 15px;
            text: root.tile.name;
            color: root.on ? Quest.gold : Quest.white;
            font-family: Quest.font;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }

    // Tape Deck: the picture in a sunk well, a cassette label with the theme's colour
    // band under it, an amber well and a lit lamp on the current one, a red frame on the
    // focused one.
    if Theme.tape: Rectangle {
        Rectangle {
            y: 0;
            height: 70px;
            background: root.on ? Deck.amber : root.hover ? #2c1f15 : #1b1410;
            Rectangle { y: 0; height: 1px; background: root.on ? Deck.amber : #000000; }
            Rectangle { y: parent.height - 1px; height: 1px; background: root.on ? Deck.amber : #ffffff99; }
            Rectangle {
                x: 3px;
                y: root.down ? 4px : 3px;
                width: 104px;
                height: 64px;
                opacity: root.down ? 0.8 : 1;
                if root.classic: Mini { p: Theme.palettes[root.tile.index]; }
                if !root.classic: Image {
                    width: 104px;
                    height: 64px;
                    source: root.hi ? root.tile.art2 : root.tile.art;
                    image-fit: fill;
                }
            }
        }
        Rectangle {
            y: 70px;
            height: 20px;
            background: root.on || root.hover ? Deck.spine-out : Deck.spine;
            Rectangle { y: parent.height - 1px; height: 1px; background: #0000008c; }
            HorizontalLayout {
                padding-right: 6px;
                spacing: 5px;
                Rectangle { width: 6px; background: root.classic ? Theme.palettes[root.tile.index].accent : root.tile.band; }
                Text {
                    horizontal-stretch: 1;
                    text: root.tile.name;
                    color: Deck.ink;
                    font-family: "Caveat";
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
                if root.on: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: @radial-gradient(circle, #fff0c8 0%, #f2a64a 45%, #9a5a14 100%);
                    }
                }
            }
        }
        // The keyboard focus: a red frame round the whole tile, plain on dark and light art.
        if root.focused: Rectangle {
            border-width: 2px;
            border-color: Deck.red;
        }
    }

    // Phosphor: the picture in a thin frame, the name under it; the current one in a bright
    // frame with its name in inverted video, the focused one in a light frame.
    if Theme.phos: Rectangle {
        Rectangle {
            y: 0;
            height: 70px;
            border-width: root.on || root.focused ? 2px : 1px;
            border-color: root.focused ? Ph.hi : root.on ? Ph.ph : root.hover ? Ph.mid : Ph.line;
            background: Ph.bg;
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: 104px;
            height: 64px;
            opacity: root.down ? 0.8 : 1;
            if root.classic: Mini { p: Theme.palettes[root.tile.index]; }
            if !root.classic: Image {
                width: 104px;
                height: 64px;
                source: root.hi ? root.tile.art2 : root.tile.art;
                image-fit: fill;
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 74px;
            width: min(name.preferred-width + 8px, parent.width);
            height: 16px;
            background: root.on ? Ph.ph : transparent;
            name := Text {
                x: 4px;
                width: parent.width - 8px;
                text: root.tile.name;
                color: root.on ? Ph.bg : root.hover ? Ph.hi : Ph.mid;
                font-family: Ph.mono;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
        }
    }

    // Desktop 95: the picture in a black line on the white list, its name under it, navy
    // on the current one, a dotted line round the focused one's name.
    if Theme.os95: Rectangle {
        Rectangle {
            x: 2px;
            y: 2px;
            width: 106px;
            height: 68px;
            background: root.on ? Os.navy : #000000;
        }
        Rectangle {
            x: root.on ? 4px : 3px;
            y: root.on ? 4px : 3px;
            width: root.on ? 102px : 104px;
            height: root.on ? 62px : 64px;
            clip: true;
            opacity: root.down ? 0.8 : 1;
            Rectangle {
                x: root.on ? -1px : 0;
                y: root.on ? -1px : 0;
                width: 104px;
                height: 64px;
                if root.classic: Mini { p: Theme.palettes[root.tile.index]; }
                if !root.classic: Image {
                    width: 104px;
                    height: 64px;
                    source: root.hi ? root.tile.art2 : root.tile.art;
                    image-fit: fill;
                }
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 74px;
            width: min(parent.width, os-name.preferred-width + 6px);
            height: 15px;
            background: root.on ? Os.navy : transparent;
            os-name := Text {
                x: 3px;
                width: parent.width - 6px;
                height: parent.height;
                text: root.tile.name;
                color: root.on ? #ffffff : #000000;
                font-family: Os.font;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            OsDotted { visible: root.focused; tint: root.on ? #ffe14d : #010101; }
        }
    }

    // Comic Book: the picture in an ink frame, the name under it; the current one has a
    // red frame on a hard shadow, its name in a yellow caption and the PICKED stamp; the
    // keyboard focus is a yellow and ink ring.
    if Theme.comic: Rectangle {
        if root.focused: Rectangle {
            x: -5px;
            y: -5px;
            width: 120px;
            height: 80px;
            background: Comic.ink;
            Rectangle { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; background: Comic.yellow; }
        }
        InkShadow { visible: (root.on || root.hover) && !root.down; y: 3px; height: 70px; off: 3px; }
        Rectangle {
            x: root.down ? 1px : 0;
            y: root.down ? 1px : 0;
            height: 70px;
            background: Comic.ink;
            Rectangle {
                x: root.on ? 3.5px : 2.5px;
                y: root.on ? 3.5px : 2.5px;
                width: parent.width - 2 * self.x;
                height: parent.height - 2 * self.y;
                clip: true;
                if root.classic: Mini { x: (parent.width - 104px) / 2; y: (parent.height - 64px) / 2; p: Theme.palettes[root.tile.index]; }
                if !root.classic: Image {
                    x: (parent.width - 104px) / 2;
                    y: (parent.height - 64px) / 2;
                    width: 104px;
                    height: 64px;
                    source: root.hi ? root.tile.art2 : root.tile.art;
                    image-fit: fill;
                }
            }
            if root.on: Rectangle { border-width: 3.5px; border-color: Comic.red; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 74px;
            width: min(comic-name.preferred-width + 10px, 110px);
            height: 16px;
            background: root.on ? Comic.yellow : root.hover ? Comic.pale : transparent;
            border-width: root.on ? 2px : 0;
            border-color: Comic.ink;
            comic-name := Text {
                x: 5px;
                width: parent.width - 10px;
                text: root.tile.name;
                color: Comic.ink;
                font-family: "Comic Neue";
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
        }
        if root.on: Image {
            x: 110px - 48px;
            y: -9px;
            width: 53px;
            height: 23px;
            source: root.hi ? @image-url("skins/x-comic/picked@2x.png") : @image-url("skins/x-comic/picked.png");
            image-fit: fill;
            accessible-role: none;
        }
    }

    // Brick Phone: the picture in an ink frame on the LCD, the name under it; the current
    // one on ink in a double frame with its name inverted; a frame round the focused one.
    if Theme.brick: Rectangle {
        if root.focused || root.hover: Rectangle {
            x: -4px;
            y: -4px;
            width: 80px;
            height: 54px;
            border-width: root.focused ? 2px : 1px;
            border-color: root.focused ? Brick.ink : Brick.rule;
        }
        if root.on: Rectangle {
            x: -3px;
            y: -3px;
            width: 78px;
            height: 52px;
            border-width: 2px;
            border-color: Brick.ink;
        }
        Rectangle {
            x: 0;
            y: 0;
            width: 72px;
            height: 46px;
            background: root.on ? Brick.ink : Brick.lcd1;
            border-width: 2px;
            border-color: Brick.ink;
            Rectangle {
                x: 4px;
                y: 4px;
                width: 64px;
                height: 38px;
                clip: true;
                opacity: root.down ? 0.8 : 1;
                if root.classic: Mini { x: -20px; y: -13px; p: Theme.palettes[root.tile.index]; }
                if !root.classic: Image {
                    width: 64px;
                    height: 38px;
                    source: root.hi ? root.tile.art2 : root.tile.art;
                    image-fit: fill;
                }
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 50px;
            width: min(brick-name.preferred-width + 6px, 76px);
            height: 15px;
            background: root.on ? Brick.ink : transparent;
            brick-name := Text {
                x: 3px;
                width: parent.width - 6px;
                height: parent.height;
                text: root.tile.name;
                color: root.on ? Brick.lcd1 : Brick.ink;
                font-family: Brick.words;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
        }
    }

    // Pocket Synth: the picture on a pad that sinks while it is held; the current one is an
    // orange pad with a glow, its name orange; an orange ring round the focused one.
    if Theme.synth: Rectangle {
        if root.focused: Rectangle {
            x: -4px;
            y: -4px;
            width: 118px;
            height: 78px;
            border-radius: 11px;
            border-width: 2px;
            border-color: #ff5a1e;
        }
        SynKey {
            x: 0;
            y: 0;
            width: 110px;
            height: 70px;
            radius: 8px;
            kind: root.on ? 3 : 0;
            pressed: root.down;
            hover: root.hover;
        }
        Rectangle {
            x: 3px;
            y: root.down ? 4px : 3px;
            width: 104px;
            height: 64px;
            if root.classic: Mini { p: Theme.palettes[root.tile.index]; }
            if !root.classic: Image {
                width: 104px;
                height: 64px;
                source: root.hi ? root.tile.art2 : root.tile.art;
                image-fit: fill;
            }
        }
        Text {
            x: 0;
            y: 75px;
            width: 110px;
            height: 15px;
            text: root.tile.name;
            color: root.on ? #e94a12 : #1c1c1b;
            font-size: 12px;
            font-weight: root.on ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }

    // Fighter Select: a fighter tile of the select grid: the picture over a name plate in a
    // violet rim; hovered violet, focused gold, the current one in a red frame and plate with
    // the P1 cursor and tag.
    if Theme.fighter: Rectangle {
        property <length> rim: root.on ? 3px : root.focused || root.hover ? 2px : 1px;
        Rectangle {
            x: -parent.rim;
            y: -parent.rim;
            width: 110px + 2 * parent.rim;
            height: 84px + 2 * parent.rim;
            background: root.on ? Fi.p1 : root.focused ? Fi.gold : root.hover ? #6d64a3 : Fi.edge;
        }
        Rectangle { x: 0; y: 0; width: 110px; height: 84px; background: #000000; }
        Rectangle {
            x: 2px;
            y: 2px;
            width: 106px;
            height: 60px;
            clip: true;
            if root.classic: Mini { x: 1px; y: -2px; p: Theme.palettes[root.tile.index]; }
            if !root.classic: Image {
                x: 1px;
                y: -2px;
                width: 104px;
                height: 64px;
                source: root.hi ? root.tile.art2 : root.tile.art;
                image-fit: fill;
            }
        }
        Rectangle {
            x: 2px;
            y: 64px;
            width: 106px;
            height: 18px;
            background: root.on ? @linear-gradient(180deg, #5a0f22 0%, #2a0712 100%) : @linear-gradient(180deg, #221c40 0%, #16122c 100%);
            Text {
                x: 5px;
                width: parent.width - 10px;
                height: parent.height;
                text: root.tile.name;
                color: #ffffff;
                font-family: Fi.body;
                font-size: 10.5px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
        }
        if root.on: Rectangle {
            x: -6px;
            y: -6px;
            width: 122px;
            height: 96px;
            Rectangle { x: 0; y: 0; width: 10px; height: 2px; background: Fi.gold; }
            Rectangle { x: 0; y: 0; width: 2px; height: 10px; background: Fi.gold; }
            Rectangle { x: parent.width - 10px; y: 0; width: 10px; height: 2px; background: Fi.gold; }
            Rectangle { x: parent.width - 2px; y: 0; width: 2px; height: 10px; background: Fi.gold; }
            Rectangle { x: 0; y: parent.height - 2px; width: 10px; height: 2px; background: Fi.gold; }
            Rectangle { x: 0; y: parent.height - 10px; width: 2px; height: 10px; background: Fi.gold; }
            Rectangle { x: parent.width - 10px; y: parent.height - 2px; width: 10px; height: 2px; background: Fi.gold; }
            Rectangle { x: parent.width - 2px; y: parent.height - 10px; width: 2px; height: 10px; background: Fi.gold; }
        }
        if root.on: Rectangle {
            x: (110px - self.width) / 2;
            y: -11px;
            width: 26px;
            height: 15px;
            FiSkew { x: 0; y: 0; width: parent.width; height: parent.height; body: Fi.p1; rim: #000000; rim-w: 2px; }
            Text {
                text: "P1";
                color: #ffffff;
                font-family: Fi.lean;
                font-size: 10px;
                letter-spacing: 1px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }

    // Cozy Cabin: the picture in an ink ring on the dark shelf and the name in cream under
    // it; the current one ringed honey with a honey nub over it and its name on a honey
    // label, the focused one ringed in pale parchment, a hovered one in light wood.
    if Theme.cozy: Rectangle {
        Rectangle {
            x: -3px;
            y: -3px;
            width: 116px;
            height: 76px;
            background: root.on ? Cz.honey : root.focused ? Cz.parch-hl : root.hover || root.down ? Cz.wood-hl : Cz.ink;
        }
        Rectangle { x: 0; y: 0; width: 110px; height: 70px; background: Cz.ink; }
        Rectangle {
            x: 3px;
            y: root.down ? 4px : 3px;
            width: 104px;
            height: 64px;
            if root.classic: Mini { p: Theme.palettes[root.tile.index]; }
            if !root.classic: Image {
                width: 104px;
                height: 64px;
                source: root.hi ? root.tile.art2 : root.tile.art;
                image-fit: fill;
            }
        }
        Rectangle { visible: root.on; x: 49px; y: -9px; width: 12px; height: 6px; background: Cz.honey; }
        Rectangle {
            x: (110px - self.width) / 2;
            y: 76px;
            width: root.on ? min(110px, cz-name.preferred-width + 10px) : 110px;
            height: 15px;
            background: root.on ? Cz.honey : transparent;
            cz-name := Text {
                text: root.tile.name;
                color: root.on ? Cz.ink : Cz.cream;
                font-family: Cz.font;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
        }
    }

    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// The fade at one end of a strip, to the rack (Tape Deck) or to the card colour (Ember).
// The Ember one is strips of the card colour on whole device pixels: a see-through
// gradient of a dark colour left bright specks on the tile edges under it.
component Fade inherits Rectangle {
    // Its opaque side is on the right.
    in property <bool> to-right;
    property <int> strips: 10;
    // Where it sits in the window; the window size names it to be read again on a resize.
    property <length> at-x: Win.width > 0 && root.width > 0 ? self.absolute-position.x : self.absolute-position.x;
    width: Theme.tape ? 26px : 30px; // As Strip.fade-w.
    visible: !Theme.os95 && !Theme.pocket && !Theme.brick;
    background: !Theme.tape ? transparent
        : root.to-right ? @linear-gradient(90deg, #b5ad9f00 0%, #b5ad9f 100%)
        : @linear-gradient(270deg, #c5bdb000 0%, #c5bdb0 100%);
    for i in Theme.tape || Theme.glass ? 0 : root.strips: Rectangle {
        property <length> from: round((root.at-x + i * root.width / root.strips) / 1phx) * 1phx - root.at-x;
        property <length> to: round((root.at-x + (i + 1) * root.width / root.strips) / 1phx) * 1phx - root.at-x;
        x: self.from;
        width: self.to - self.from;
        // Phosphor's strips sit on the window's black, not on a card.
        background: (Theme.phos ? Theme.bg : Theme.answer ? Am.paper : Theme.fighter ? Fi.panel : Theme.cozy ? Cz.well : Theme.card).with-alpha(root.to-right ? (i + 0.5) / root.strips : 1 - (i + 0.5) / root.strips);
    }
}

// One group: its head (name, count, page arrows), the strip of tiles and its scroll bar.
component Strip inherits VerticalLayout {
    in property <string> title;
    in property <[ThemeTile]> tiles;
    in property <bool> classic;
    // A rule above it, between the groups.
    in property <bool> divided;
    callback picked(int);
    // Up and Down move to the other group.
    callback up();
    callback down();
    public function focus-in() { keys.focus(); }

    property <length> tile-w: Theme.brick ? 72px : 110px;
    property <length> gap-max: Theme.tape ? 10px : Theme.comic ? 10px : Theme.brick ? 6px : 12px;
    // Desktop 95: the tiles sit in a sunken white list.
    property <length> pad: Theme.os95 || Theme.brick ? 4px : 0;
    property <length> view-w: view.width - 2 * root.pad;
    property <int> n: root.tiles.length;
    // Room after the last tile for the check that sticks out of the current one (Ember).
    property <length> end-pad: Theme.tape ? 0 : Theme.comic ? 4px : Theme.brick ? 4px : 6px;
    // The width of the fade at an edge; a tile scrolled into view clears it.
    property <length> fade-w: Theme.tape ? 26px : Theme.brick ? 4px : 30px;
    // When every tile fits, the gap shrinks (not under 4px) so none is cut off.
    property <bool> fits: root.n * root.tile-w + max(0, root.n - 1) * 4px + root.end-pad <= root.view-w;
    property <length> gap: root.fits && root.n > 1 ? min(root.gap-max, (root.view-w - root.end-pad - root.n * root.tile-w) / (root.n - 1)) : root.gap-max;
    property <length> pitch: root.tile-w + root.gap;
    property <length> content-w: root.n * root.tile-w + max(0, root.n - 1) * root.gap + root.end-pad;
    property <length> max-off: max(0px, root.content-w - root.view-w);
    property <int> per: max(1, floor((root.view-w + root.gap) / root.pitch));
    property <bool> scrolls: root.max-off > 0.5px;
    // Where the current theme is in this strip, or -1.
    property <int> cur-pos: -1;
    // Where the current theme was when the page opened: the strip opens scrolled to it.
    property <int> start: -1;
    // The scroll offset; a binding to the start until the strip is moved.
    property <length> off: root.start < 0 || root.start * root.pitch + root.tile-w + root.end-pad <= root.view-w ? 0 : min(root.max-off, root.start * root.pitch - root.fade-w);
    // Where the strip is going, and where it is drawn while it slides there.
    property <length> to-off: clamp(root.off, 0, root.max-off);
    property <length> x-off: root.to-off;
    property <bool> moving;
    animate x-off { duration: root.moving ? 180ms : 0ms; easing: ease-out; }
    // The tile under the keyboard focus.
    property <int> cursor: -1;

    function scroll-to(o: length) {
        root.moving = true;
        root.off = clamp(o, 0, root.max-off);
    }
    function page(by: int) {
        root.scroll-to((round(root.to-off / root.pitch) + by * root.per) * root.pitch);
    }
    function reveal(i: int) {
        let edge = max(root.end-pad, root.fade-w);
        if (i * root.pitch - root.fade-w < root.to-off) {
            root.scroll-to(i * root.pitch - root.fade-w);
        } else if (i * root.pitch + root.tile-w + edge > root.to-off + root.view-w) {
            root.scroll-to(i * root.pitch + root.tile-w + edge - root.view-w);
        }
    }
    function move(i: int) {
        if (root.n == 0) { return; }
        root.cursor = clamp(i, 0, root.n - 1);
        root.reveal(root.cursor);
    }

    // Its head.
    if root.divided && !Theme.tape && !Theme.phos && !Theme.os95 && !Theme.quest && !Theme.brick: Rectangle { height: 6px; }
    if root.divided && !Theme.tape && !Theme.phos && !Theme.os95 && !Theme.quest && !Theme.brick && !Theme.fighter && !Theme.cozy: Rectangle { height: Theme.comic ? 2.5px : 1px; background: Theme.comic ? Comic.ink : Theme.glass ? #ffffff1a : Theme.divider; }
    if root.divided && Theme.brick: Rectangle { height: 6px; }
    if root.divided && Theme.phos: Rectangle { height: 8px; }
    if Theme.tape: Rectangle { height: 4px; }
    if root.divided && Theme.os95: Rectangle { height: 6px; }
    if root.divided && Theme.quest: Rectangle { height: 9px; }
    HorizontalLayout {
        height: Theme.tape ? 26px : Theme.os95 ? 24px : Theme.brick ? 22px : 30px;
        padding-left: Theme.tape ? 2px : Theme.brick ? 0 : 4px;
        padding-right: Theme.tape ? 2px : 0;
        padding-top: root.divided && !Theme.tape && !Theme.phos && !Theme.os95 && !Theme.quest && !Theme.brick ? 6px : 0;
        spacing: Theme.brick ? 6px : 8px;
        // Car Dashboard: small caps, as the cards' names. Brick Phone: the LCD's small caps.
        if !Theme.tape && !Theme.comic: Text {
            text: Theme.dash || Theme.quest || Theme.brick || Theme.answer || Theme.synth || Theme.fighter || Theme.cozy || Theme.pinball ? root.title.to-uppercase() : root.title;
            color: Theme.pinball ? Pb.plasma-hi : Theme.cozy ? Cz.brown : Theme.fighter ? #ffffff : Theme.pocket ? Pk.l3 : Theme.phos ? Ph.hi : Theme.glass ? Glass.ink : Theme.dash ? Theme.muted : Theme.quest ? Quest.white : Theme.answer ? Am.print : Theme.synth ? #7a766d : Theme.text;
            font-family: Theme.pinball ? Pb.font : Theme.cozy ? Cz.caps : Theme.fighter ? Fi.lean : Theme.pocket ? Pk.big : Theme.phos ? Ph.mono : Theme.os95 ? Os.font : Theme.dash ? "Manrope" : Theme.synth ? Theme.mono : Theme.answer ? "Barlow Condensed" : Theme.quest ? Quest.label : Theme.brick ? Brick.caps : "Inter Tight";
            font-size: Theme.pinball ? 11px : Theme.cozy ? 11px : Theme.fighter ? 13px : Theme.pocket ? 20px : Theme.phos ? 12.5px : Theme.os95 ? 12.5px : Theme.dash ? 9px : Theme.quest ? 11px : Theme.brick ? 8px : Theme.answer ? 10px : Theme.synth ? 8px : 12px;
            font-weight: Theme.pinball ? 700 : Theme.phos || Theme.quest || Theme.brick || Theme.fighter || Theme.cozy ? 400 : Theme.os95 ? 700 : Theme.dash ? 800 : Theme.answer ? 700 : Theme.synth ? 700 : 600;
            letter-spacing: Theme.pinball ? 3px : Theme.cozy ? 2.5px : Theme.fighter ? 2px : Theme.dash ? 2.3px : Theme.quest ? 0.5px : Theme.brick ? 0.5px : Theme.answer ? 2.4px : Theme.synth ? 1.9px : 0;
            vertical-alignment: center;
        }
        if Theme.answer: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 16px;
                border-radius: 3px;
                background: Am.smoke;
                Text {
                    text: (root.n < 10 ? "0" : "") + root.n;
                    color: Am.led;
                    font-family: "Memo Segments";
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
        if Theme.comic: VerticalLayout {
            alignment: center;
            Rectangle {
                width: ctag.preferred-width + 14px;
                height: 19px;
                background: Comic.ink;
                ctag := Text {
                    x: 7px;
                    y: 1px;
                    height: parent.height - 1px;
                    text: root.title.to-uppercase();
                    color: Comic.yellow;
                    font-family: "Bangers";
                    font-size: 14px;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                }
            }
        }
        if Theme.tape: VerticalLayout {
            alignment: center;
            Rectangle {
                width: plate.preferred-width + 16px;
                height: 18px;
                background: Deck.brass;
                Rectangle { y: 0; height: 1px; background: #f6e2b4; }
                Rectangle { y: parent.height - 1px; height: 1px; background: #2a1a0c; }
                plate := Text {
                    text: root.title.to-uppercase();
                    color: #3a2610;
                    font-family: "Oswald";
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 2.8px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if !Theme.answer && !Theme.synth: Text {
            text: root.n;
            color: Theme.pinball ? Pb.mute : Theme.cozy ? Cz.brown : Theme.fighter ? Fi.dim : Theme.pocket ? Pk.l2 : Theme.tape ? #6f665a : Theme.os95 ? Os.note : Theme.comic ? Comic.sub : Theme.glass ? Glass.ink3 : Theme.dash ? #56606c : Theme.brick ? Brick.ink2 : Theme.quest ? Quest.grey : Theme.dim;
            font-family: Theme.pinball ? Theme.mono : Theme.cozy ? Cz.title : Theme.fighter ? Fi.body : Theme.pocket ? Pk.small : Theme.tape || Theme.dash ? Theme.mono : Theme.os95 ? Os.font : Theme.phos ? Ph.mono : Theme.comic ? "Bangers" : Theme.quest ? Quest.label : Theme.brick ? Brick.caps : "Inter Tight";
            font-size: Theme.pinball ? 11px : Theme.cozy ? 16px : Theme.fighter ? 9.5px : Theme.pocket ? 8px : Theme.tape ? 10px : Theme.phos ? 11px : Theme.comic ? 14px : Theme.dash ? 10px : Theme.quest ? 11px : Theme.brick ? 7px : 12px;
            letter-spacing: Theme.comic ? 1px : Theme.fighter ? 1.5px : 0;
            font-weight: Theme.fighter ? 700 : 400;
            vertical-alignment: center;
            accessible-role: none;
        }
        if Theme.synth: VerticalLayout {
            alignment: center;
            Rectangle {
                width: count.preferred-width + 8px;
                height: 14px;
                border-radius: 3px;
                border-width: 1px;
                border-color: #a9a59b;
                count := Text {
                    text: root.n;
                    color: #7a766d;
                    font-family: Theme.mono;
                    font-size: 8px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
        // Fighter Select: a red rule fading out to the right.
        if Theme.fighter: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Rectangle { height: 2px; background: @linear-gradient(90deg, Fi.p1 0%, #ff2d4a00 100%); }
        }
        Rectangle { horizontal-stretch: Theme.fighter ? 0 : 1; }
        // Always in the layout, so the width does not depend on whether it scrolls.
        HorizontalLayout {
            visible: root.scrolls;
            spacing: Theme.tape ? 3px : 2px;
            VerticalLayout {
                alignment: center;
                IconBtn {
                    size: Theme.os95 ? 22px : Theme.pocket ? 18px : Theme.quest ? 27px : Theme.brick ? 18px : Theme.answer ? 24px : 26px;
                    height: Theme.tape ? 22px : Theme.os95 || Theme.pocket ? 18px : Theme.comic ? 24px : Theme.quest ? 27px : Theme.brick ? 18px : Theme.answer ? 22px : 26px;
                    round: !Theme.comic && !Theme.brick && !Theme.answer;
                    key: "[<]";
                    icon: "back";
                    icon-size: Theme.tape ? 11px : 13px;
                    tint: Theme.muted;
                    label: "Previous " + root.title + " themes";
                    tip: "Previous";
                    enabled: root.x-off > 0.5px;
                    clicked => { root.page(-1); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconBtn {
                    size: Theme.os95 ? 22px : Theme.pocket ? 18px : Theme.quest ? 27px : Theme.brick ? 18px : Theme.answer ? 24px : 26px;
                    height: Theme.tape ? 22px : Theme.os95 || Theme.pocket ? 18px : Theme.comic ? 24px : Theme.quest ? 27px : Theme.brick ? 18px : Theme.answer ? 22px : 26px;
                    round: !Theme.comic && !Theme.brick && !Theme.answer;
                    key: "[>]";
                    icon: "chevron";
                    icon-size: Theme.tape ? 11px : 13px;
                    tint: Theme.muted;
                    label: "More " + root.title + " themes";
                    tip: "More";
                    enabled: root.x-off < root.max-off - 0.5px;
                    clicked => { root.page(1); }
                }
            }
        }
    }

    // The strip.
    view := Rectangle {
        height: Theme.tape ? 94px : Theme.brick ? 74px : Theme.cozy ? 106px : 98px;
        clip: true;
        // Cozy Cabin: a dark shelf in an ink ring.
        if Theme.cozy: CzWell { }
        if Theme.os95: Rectangle {
            background: #ffffff;
            OsBevel { kind: 2; }
        }
        accessible-role: radio-group;
        accessible-label: root.title;
        keys := FocusScope {
            focus-gained => {
                if (root.cursor < 0 || root.cursor >= root.n) {
                    root.cursor = root.cur-pos >= 0 ? root.cur-pos : round(root.to-off / root.pitch);
                }
                root.reveal(root.cursor);
            }
            key-pressed(e) => {
                if (e.text == Key.LeftArrow) { root.move(root.cursor - 1); return accept; }
                if (e.text == Key.RightArrow) { root.move(root.cursor + 1); return accept; }
                if (e.text == Key.Home) { root.move(0); return accept; }
                if (e.text == Key.End) { root.move(root.n - 1); return accept; }
                if (e.text == Key.PageUp) { root.move(root.cursor - root.per); return accept; }
                if (e.text == Key.PageDown) { root.move(root.cursor + root.per); return accept; }
                if (e.text == Key.UpArrow) { root.up(); return accept; }
                if (e.text == Key.DownArrow) { root.down(); return accept; }
                if ((e.text == Key.Return || e.text == " ") && root.cursor >= 0 && root.cursor < root.n) {
                    root.picked(root.tiles[root.cursor].index);
                    return accept;
                }
                reject
            }
        }
        // The mouse wheel scrolls the strip under it while it can move, then the page.
        TouchArea {
            scroll-event(e) => {
                let d = e.delta-x != 0 ? e.delta-x : e.delta-y;
                let next = clamp(root.to-off - d, 0, root.max-off);
                if (!root.scrolls || abs(next - root.to-off) < 0.5px) { return reject; }
                root.scroll-to(next);
                accept
            }
            for tile[i] in root.tiles: Tile {
                x: root.pad + i * root.pitch - root.x-off;
                y: Theme.tape ? 2px : Theme.os95 ? 4px : Theme.brick ? 5px : Theme.fighter || Theme.cozy ? 12px : 6px;
                tile: tile;
                classic: root.classic;
                focused: keys.has-focus && i == root.cursor;
                init => {
                    if (self.on) {
                        root.cur-pos = i;
                        root.start = i;
                    }
                }
                changed on => {
                    if (self.on) {
                        root.cur-pos = i;
                    } else if (root.cur-pos == i) {
                        root.cur-pos = -1;
                    }
                }
                picked => {
                    root.cursor = i;
                    root.picked(tile.index);
                }
            }
        }
        // The fades at an edge it scrolls past.
        if root.x-off < root.max-off - 0.5px: Fade {
            x: parent.width - self.width;
            to-right: true;
        }
        if root.x-off > 0.5px: Fade { x: 0; }
    }

    // The scroll bar, while there is more than fits.
    // Desktop 95: a grey scroll bar, a raised thumb on a checker track, in the list's frame.
    VerticalLayout {
        padding-left: Theme.tape ? 2px : Theme.os95 ? 0 : Theme.brick ? 2px : 4px;
        padding-right: Theme.tape ? 2px : Theme.os95 ? 0 : Theme.brick ? 2px : 4px;
        padding-top: Theme.tape ? 4px : Theme.os95 ? 0 : Theme.brick ? 2px : 6px;
        padding-bottom: Theme.tape ? 6px : 0;
        Rectangle {
            visible: root.scrolls;
            height: Theme.pinball ? 7px : Theme.tape ? 4px : Theme.os95 ? 16px : Theme.comic ? 5px : Theme.synth ? 5px : Theme.answer ? 6px : Theme.brick ? 5px : Theme.pocket ? 6px : Theme.quest ? 9px : Theme.fighter ? 4px : 3px;
            border-radius: Theme.tape || Theme.phos || Theme.os95 || Theme.comic || Theme.brick || Theme.quest || Theme.pocket || Theme.fighter || Theme.cozy ? 0 : Theme.pinball ? 3.5px : Theme.answer ? 3px : 2px;
            background: Theme.pinball ? #050507 : Theme.cozy ? Cz.parch-d : Theme.fighter ? #1b1733 : Theme.pocket ? transparent : Theme.tape ? #1b1410 : Theme.phos ? Ph.faint : Theme.os95 ? Os.face : Theme.comic ? #ffffff : Theme.glass ? #ffffff1f : Theme.quest ? Quest.ink : Theme.brick ? Brick.ghost : Theme.answer ? #c7bba1 : Theme.synth ? transparent : Theme.divider;
            border-width: Theme.pinball ? 1px : Theme.comic ? 1.5px : Theme.quest ? 3px : Theme.brick ? 1px : 0;
            border-color: Theme.pinball ? #5e5866 : Theme.quest ? Quest.rule : Theme.brick ? Brick.ink : Comic.ink;
            property <length> thumb-w: Theme.pinball ? 13px : max(30px, self.width * root.view-w / max(root.content-w, 1px));
            // Sized from the parent, not in percent: a percent size here made a binding loop
            // with the Car Dashboard's flexbox settings page.
            Image {
                visible: Theme.os95;
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                source: 1phx < 0.7px ? @image-url("skins/dv-os95/checker@2x.png") : @image-url("skins/dv-os95/checker.png");
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
                horizontal-alignment: left;
                vertical-alignment: top;
            }
            PkTile { visible: Theme.pocket; x: 0; y: 0; width: parent.width; height: parent.height; source: @image-url("skins/px-pocket/dith.png"); }
            property <int> led-on: round(root.x-off / root.pitch);
            for k in Theme.synth ? root.n : 0: Rectangle {
                x: (parent.width - root.n * 9px + 4px) / 2 + k * 9px;
                y: 0;
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: k == parent.led-on ? #ff5a1e : #c4c0b6;
            }
            Rectangle {
                visible: !Theme.synth;
                x: Theme.quest ? 3px + (root.max-off > 0 ? root.x-off / root.max-off * (parent.width - 6px - self.width) : 0) : root.max-off > 0 ? root.x-off / root.max-off * (parent.width - self.width) : 0;
                y: Theme.pinball ? -4px : Theme.tape ? -1px : Theme.quest ? 3px : Theme.answer ? -3px : 0;
                width: Theme.quest ? max(30px, (parent.width - 6px) * root.view-w / max(root.content-w, 1px)) : parent.thumb-w;
                height: Theme.pinball ? 13px : Theme.tape ? 6px : Theme.os95 ? 16px : Theme.comic ? 5px : Theme.pocket ? 6px : Theme.brick ? 5px : Theme.answer ? 12px : Theme.fighter ? 4px : 3px;
                border-radius: Theme.tape || Theme.phos || Theme.os95 || Theme.comic || Theme.brick || Theme.quest || Theme.pocket || Theme.fighter || Theme.cozy ? 0 : Theme.answer ? 3px : 2px;
                background: Theme.pinball ? transparent : Theme.cozy ? Cz.brown : Theme.fighter ? Fi.p1 : Theme.pocket ? Pk.l3 : Theme.tape ? @linear-gradient(180deg, #e3c58a 0%, #9c7538 100%) : Theme.phos ? Ph.ph : Theme.os95 ? Os.face : Theme.comic ? Comic.ink : Theme.glass ? #ffffff73
                    : Theme.answer ? @linear-gradient(180deg, #635c56 0%, #4b4540 100%) : Theme.quest ? Quest.grey : Theme.edge;
                OsBevel { visible: Theme.os95; kind: 0; }
                Image {
                    visible: Theme.pinball;
                    x: 0;
                    y: 0;
                    width: 13px;
                    height: 13px;
                    source: 1phx < 0.7px ? @image-url("skins/x-pinball/ball@2x.png") : @image-url("skins/x-pinball/ball.png");
                    image-fit: fill;
                }
            }
        }
    }
}

// Both groups. `picked` gives the place in Theme.names.
export component ThemeGallery inherits VerticalLayout {
    callback picked(int);
    classic := Strip {
        title: "Classic";
        tiles: Gallery.classic;
        classic: true;
        picked(i) => { root.picked(i); }
        down => { devices.focus-in(); }
    }
    devices := Strip {
        title: "Devices";
        tiles: Gallery.shown;
        divided: true;
        picked(i) => { root.picked(i); }
        up => { classic.focus-in(); }
    }
}

// Both groups side by side, for a wide page (Phosphor's settings).
export component ThemeGallerySide inherits HorizontalLayout {
    callback picked(int);
    spacing: 22px;
    classic := Strip {
        horizontal-stretch: 1;
        title: "Classic";
        tiles: Gallery.classic;
        classic: true;
        picked(i) => { root.picked(i); }
        down => { devices.focus-in(); }
    }
    devices := Strip {
        horizontal-stretch: 1;
        title: "Devices";
        tiles: Gallery.shown;
        picked(i) => { root.picked(i); }
        up => { classic.focus-in(); }
    }
}
