// The Phosphor skin's parts, shared by its main page (phosphor.slint) and its other
// pages (phosphor-pages.slint): the lit block, the pixel glyphs, the caps labels, the
// "-- WORD ----" rules, the title bar and the glass. The colours (Ph), the dashed rule
// (PhDash), the light shade (PhShade) and the bracketed key (PhKey) are in common.slint, so
// the shared widgets can draw the terminal look too.

import { Ph, PhDash, PhKey as Kbd, Main } from "../common.slint";

// A lit block with its glow: the status lamp and the prompt's cursor.
export component Block inherits Rectangle {
    in property <color> ink: Ph.ph;
    in property <bool> lit: true;
    property <bool> hi: 1phx < 0.7px;
    Image {
        visible: root.lit;
        x: -10px;
        y: -10px;
        width: root.width + 20px;
        height: root.height + 20px;
        source: root.hi ? @image-url("phosphor/halo@2x.png") : @image-url("phosphor/halo.png");
        image-fit: fill;
        opacity: root.ink == Ph.ph ? 1 : 0.5;
    }
    Rectangle { background: root.lit ? root.ink : Ph.faint; }
}

// Small pixel glyphs on a 16 unit grid: the microphone of the record key, stop and pause.
export component Glyph inherits Path {
    in property <string> name;
    in property <color> ink;
    viewbox-width: 16;
    viewbox-height: 16;
    fill: root.ink;
    stroke: transparent;
    commands: root.name == "stop" ? "M4 4L12 4L12 12L4 12Z"
        : root.name == "pause" ? "M4 3L7 3L7 13L4 13Z M9 3L12 3L12 13L9 13Z"
        : root.name == "play" ? "M5 3L6 3L6 4L7 4L7 5L8 5L8 6L9 6L9 7L10 7L10 9L9 9L9 10L8 10L8 11L7 11L7 12L6 12L6 13L5 13Z"
        : "M6 1L10 1L10 9L6 9Z M5 2L6 2L6 8L5 8Z M10 2L11 2L11 8L10 8Z M3 6L4 6L4 9L3 9Z M12 6L13 6L13 9L12 9Z M4 9L5 9L5 10L4 10Z M11 9L12 9L12 10L11 10Z M5 10L11 10L11 11L5 11Z M7 11L9 11L9 14L7 14Z M5 14L11 14L11 15L5 15Z";
}

// A small label in caps, as over the sections ("IN", "LVL", "CLIPS").
export component Caps inherits Text {
    color: Ph.dim;
    font-family: Ph.mono;
    font-size: 10px;
    letter-spacing: 2px;
    vertical-alignment: center;
}

// The title bar: [<] and where it goes back to (other pages), the name, the tty, then
// Settings (main page), minimise and close as keys.
export component Title inherits Rectangle {
    in property <bool> wide;
    // Other pages: the back key's word ("clips", "back"); empty on the main page.
    in property <string> back-word;
    in property <string> tty: "tty0";
    in property <bool> settings: true;
    callback go(int);
    callback back();
    height: 34px;
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    PhDash { y: parent.height - 1px; height: 1px; }
    HorizontalLayout {
        padding-left: root.back-word != "" ? 9px : 12px;
        padding-right: 10px;
        spacing: 10px;
        if root.back-word != "": VerticalLayout {
            alignment: center;
            Kbd { key: "[<]"; tail: root.back-word; tail-ink: Ph.mid; label: "Back"; tip: ""; clicked => { root.back(); } }
        }
        Text {
            text: "THRASHER";
            color: Ph.hi;
            font-family: Ph.crt;
            font-size: 24px;
            letter-spacing: 2px;
            vertical-alignment: center;
        }
        Text {
            text: root.tty;
            color: Ph.dim;
            font-family: Ph.mono;
            font-size: 10px;
            letter-spacing: 1px;
            vertical-alignment: center;
            accessible-role: none;
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 6px;
            if root.settings: VerticalLayout {
                alignment: center;
                Kbd { key: "[s]"; tail: root.wide ? "etup" : "et"; ink: Ph.mid; tail-ink: Ph.mid; label: "Settings"; clicked => { root.go(3); } }
            }
            VerticalLayout {
                alignment: center;
                Kbd { key: "[_]"; ink: Ph.mid; label: "Minimize"; clicked => { Main.minimize-window(); } }
            }
            VerticalLayout {
                alignment: center;
                Kbd { key: "[x]"; ink: Ph.mid; danger: true; label: "Close"; clicked => { Main.close-window(); } }
            }
        }
    }
}

// The rule over a section: "-- REC ------", cut off at the edge. It is drawing only: a
// screen reader skips it.
export component Header inherits Rectangle {
    in property <string> word: "REC";
    in property <color> ink: Ph.dim;
    horizontal-stretch: 1;
    min-width: 0;
    height: txt.preferred-height;
    txt := Text {
        x: 0;
        width: 100%;
        text: "-- " + root.word + " " + "------------------------------------------------------------------------------------------------------------------------------------------------";
        color: root.ink;
        font-family: Ph.mono;
        font-size: 10px;
        letter-spacing: 2px;
        overflow: clip;
        accessible-role: none;
    }
}

// The glass, over everything and never in the way: a dark scanline every third pixel, and
// the tube's vignette in the corners. The scanlines are plain lines, not a tiled image over
// the whole window: only a third of the pixels blend, so a moving part stays cheap to
// redraw. Each line sits on whole device pixels. Its parent must fill the window.
export component Glass inherits Rectangle {
    property <bool> hi: 1phx < 0.7px;
    for i in ceil(root.height / 3px): Rectangle {
        y: round((i * 3px + 2px) / 1phx) * 1phx;
        height: max(1phx, round(1px / 1phx) * 1phx);
        background: #00000038;
    }
    Image {
        x: 0;
        y: 0;
        width: 200px;
        height: 200px;
        source: root.hi ? @image-url("phosphor/vig-tl@2x.png") : @image-url("phosphor/vig-tl.png");
        image-fit: fill;
        accessible-role: none;
    }
    Image {
        x: parent.width - 200px;
        y: 0;
        width: 200px;
        height: 200px;
        source: root.hi ? @image-url("phosphor/vig-tr@2x.png") : @image-url("phosphor/vig-tr.png");
        image-fit: fill;
        accessible-role: none;
    }
    Image {
        x: 0;
        y: parent.height - 200px;
        width: 200px;
        height: 200px;
        source: root.hi ? @image-url("phosphor/vig-bl@2x.png") : @image-url("phosphor/vig-bl.png");
        image-fit: fill;
        accessible-role: none;
    }
    Image {
        x: parent.width - 200px;
        y: parent.height - 200px;
        width: 200px;
        height: 200px;
        source: root.hi ? @image-url("phosphor/vig-br@2x.png") : @image-url("phosphor/vig-br.png");
        image-fit: fill;
        accessible-role: none;
    }
}
