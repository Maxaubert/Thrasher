// Thrasher's window in the "Ember" look (mockups, issue #3): orange on warm black.
// Pages: the clip list (main), one clip (manage), editing its transcript, settings
// and the model library. The window draws its own frame and title bar. The small
// always-on-top widget is a separate mode of the same window.

import { LineEdit, TextEdit } from "std-widgets.slint";
import "./fonts/InterTight-400.ttf";
import "./fonts/InterTight-500.ttf";
import "./fonts/InterTight-600.ttf";
import "./fonts/InterTight-800.ttf";
import "./fonts/JetBrainsMono-500.ttf";

// The notification-area icon. Its image is drawn in Rust (orange dot while recording).
export component Tray inherits SystemTrayIcon {
    in property <image> image;
    in property <bool> recording;
    callback toggle-record();
    callback show-window();
    callback show-widget();
    callback quit();
    icon: image;
    tooltip: recording ? "Thrasher: recording" : "Thrasher";
    clicked => { show-window(); }
    Menu {
        MenuItem {
            title: recording ? "Stop recording" : "Start recording";
            activated => { toggle-record(); }
        }
        MenuItem {
            title: "Show window";
            activated => { show-window(); }
        }
        MenuItem {
            title: "Show widget";
            activated => { show-widget(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { quit(); }
        }
    }
}

// One line of the model library: a group heading, or a model in that group's card.
export struct ModelRow {
    header: bool,
    title: string,
    by: string,
    // Position in the catalog, for download and use.
    index: int,
    size: string,
    quality: int,
    speed: int,
    downloaded: bool,
    active: bool,
    first: bool,
    last: bool,
}

export struct WordRow {
    text: string,
    is-silence: bool,
    // A word typed in and spoken in the user's voice; pending while it is generated.
    spoken: bool,
    pending: bool,
    // Generating it failed; editing the phrase tries again.
    failed: bool,
}

export struct OrderRow {
    name: string,
    note: string,
}

export struct ClipRow {
    name: string,
    duration: string,
    // "Today 09:14 · transcribed" and the like.
    meta: string,
    has-system: bool,
    transcribed: bool,
    // Peak per column, 0..1, for the small waveform.
    wave: [float],
}

// The one tooltip in the window. A button without text reports here while the mouse
// is over it; the window draws the bubble on top of everything after a short wait.
global Tips {
    in-out property <string> text;
    // The hovered button, in window coordinates.
    in-out property <Point> at;
    in-out property <length> w;
    in-out property <length> h;
    in-out property <bool> wanted;
    in-out property <bool> shown;
    public function hover(on: bool, text: string, at: Point, w: length, h: length) {
        if (on) {
            self.text = text;
            self.at = at;
            self.w = w;
            self.h = h;
            self.shown = false;
            self.wanted = true;
        } else if (self.text == text) {
            self.wanted = false;
            self.shown = false;
        }
    }
    public function hide() {
        self.wanted = false;
        self.shown = false;
    }
}

struct Palette {
    bg: color,
    card: color,
    row: color,
    raised: color,
    line: color,
    line-soft: color,
    edge: color,
    text: color,
    text2: color,
    muted: color,
    dim: color,
    accent: color,
    accent-hover: color,
    on-accent: color,
    wave: color,
    wave-dim: color,
    track: color,
    danger: color,
    hover: color,
    hover-soft: color,
    row-hover: color,
    picked: color,
    popup: color,
    popup-edge: color,
    knob: color,
    faint: color,
    fainter: color,
    rec-rest: color,
    divider: color,
    border: color,
    card-edge: color,
    footer: color,
    press: color,
}

// The colours. `current` picks one of the palettes, in the order of `names`; the
// settings page switches it.
export global Theme {
    in-out property <int> current: 0;
    out property <[string]> names: ["Ember", "Volt", "Glacier", "Mint", "Violet", "Signal", "Chalk"];
    property <[Palette]> palettes: [
        // Ember
        { bg: #0b0908, card: #150f0b, row: #1a120c, raised: #1f1610, line: #221a15, line-soft: #1c1510, edge: #3a2b20, text: #f1ece8, text2: #d8cfc8, muted: #a39a93, dim: #8a817a, accent: #ff6a1a, accent-hover: #ff8040, on-accent: #160a03, wave: #5a4436, wave-dim: #4a3a2f, track: #2b211a, danger: #ff8f7a, hover: #2a1d14, hover-soft: #261b13, row-hover: #120d0a, picked: #24180f, popup: #1f1610, popup-edge: #4a3626, knob: #7d7168, faint: #6d625a, fainter: #4a3f37, rec-rest: #6d4a33, divider: #221912, border: #2a2019, card-edge: #241b15, footer: #110c09, press: #3a2618 },
        // Volt
        { bg: #0a0a09, card: #12110e, row: #151411, raised: #1a1915, line: #1e1d19, line-soft: #181714, edge: #323028, text: #ededec, text2: #d2d1ce, muted: #a09f95, dim: #89877b, accent: #ffd426, accent-hover: #ffdd56, on-accent: #1a1400, wave: #4f4d41, wave-dim: #434136, track: #26251f, danger: #ff8f7a, hover: #22211c, hover-soft: #1f1e1a, row-hover: #0f0f0d, picked: #231e0c, popup: #1a1915, popup-edge: #3e3c32, knob: #79776c, faint: #69675e, fainter: #47453a, rec-rest: #625313, divider: #1d1c17, border: #25241e, card-edge: #1f1e1a, footer: #0e0e0c, press: #342c0e },
        // Glacier
        { bg: #07090c, card: #0c0f14, row: #0e1218, raised: #11161e, line: #141a23, line-soft: #10151c, edge: #202b3a, text: #ebecee, text2: #cbcfd5, muted: #8c98aa, dim: #6f7f95, accent: #4da3ff, accent-hover: #74b7ff, on-accent: #04101f, wave: #34455c, wave-dim: #2c3a4d, track: #19212c, danger: #ff8f7a, hover: #161e28, hover-soft: #151b24, row-hover: #0a0d12, picked: #0e1824, popup: #11161e, popup-edge: #283548, knob: #617084, faint: #546173, fainter: #2e3d53, rec-rest: #204063, divider: #131921, border: #18202b, card-edge: #151b24, footer: #090c11, press: #132335 },
        // Mint
        { bg: #080b0a, card: #0d1311, row: #101614, raised: #141b19, line: #17201d, line-soft: #121a17, edge: #26342f, text: #ebeeed, text2: #cdd3d1, muted: #92a49e, dim: #778d86, accent: #3ee8a8, accent-hover: #68edbb, on-accent: #03170f, wave: #3c544c, wave-dim: #334640, track: #1d2824, danger: #ff8f7a, hover: #1a2421, hover-soft: #18211e, row-hover: #0c100f, picked: #0d211a, popup: #141b19, popup-edge: #2f413b, knob: #687d76, faint: #5b6c66, fainter: #364b44, rec-rest: #1b5b43, divider: #161e1b, border: #1c2723, card-edge: #18211e, footer: #0b0f0e, press: #113125 },
        // Violet
        { bg: #08070c, card: #0e0c14, row: #110f17, raised: #15121d, line: #181522, line-soft: #14111b, edge: #282337, text: #ecebee, text2: #ceccd4, muted: #958fa7, dim: #7a7391, accent: #a98bff, accent-hover: #bca5ff, on-accent: #120a26, wave: #403858, wave-dim: #362f4a, track: #1f1b2a, danger: #ff8f7a, hover: #1c1826, hover-soft: #191623, row-hover: #0c0b11, picked: #181424, popup: #15121d, popup-edge: #322c44, knob: #6c6580, faint: #5d5770, fainter: #39324f, rec-rest: #423763, divider: #171420, border: #1e1a29, card-edge: #191623, footer: #0c0a10, press: #231d35 },
        // Signal
        { bg: #0b0809, card: #120e0f, row: #161011, raised: #1b1415, line: #1f1819, line-soft: #191314, edge: #332729, text: #edecec, text2: #d2cece, muted: #a39396, dim: #8c787c, accent: #ff4060, accent-hover: #ff6a83, on-accent: #1f0309, wave: #523e41, wave-dim: #453437, track: #271e1f, danger: #ff8f7a, hover: #231b1c, hover-soft: #20191a, row-hover: #100c0d, picked: #230e12, popup: #1b1415, popup-edge: #403033, knob: #7b6a6d, faint: #6b5c5e, fainter: #4a373a, rec-rest: #631c28, divider: #1e1618, border: #261d1e, card-edge: #20191a, footer: #0f0b0c, press: #341218 },
        // Chalk
        { bg: #0a0a0a, card: #101010, row: #131313, raised: #181818, line: #1c1c1c, line-soft: #161616, edge: #2d2d2d, text: #ececec, text2: #d0d0d0, muted: #9b9b9b, dim: #828282, accent: #f2f2f2, accent-hover: #f5f5f5, on-accent: #0a0a0a, wave: #484848, wave-dim: #3d3d3d, track: #232323, danger: #ff8f7a, hover: #1f1f1f, hover-soft: #1c1c1c, row-hover: #0e0e0e, picked: #212121, popup: #181818, popup-edge: #383838, knob: #727272, faint: #646464, fainter: #404040, rec-rest: #5e5e5e, divider: #1a1a1a, border: #222222, card-edge: #1c1c1c, footer: #0d0d0d, press: #313131 },
    ];
    out property <color> bg: root.palettes[root.current].bg;
    out property <color> card: root.palettes[root.current].card;
    out property <color> row: root.palettes[root.current].row;
    out property <color> raised: root.palettes[root.current].raised;
    out property <color> line: root.palettes[root.current].line;
    out property <color> line-soft: root.palettes[root.current].line-soft;
    out property <color> edge: root.palettes[root.current].edge;
    out property <color> text: root.palettes[root.current].text;
    out property <color> text2: root.palettes[root.current].text2;
    out property <color> muted: root.palettes[root.current].muted;
    out property <color> dim: root.palettes[root.current].dim;
    out property <color> accent: root.palettes[root.current].accent;
    out property <color> accent-hover: root.palettes[root.current].accent-hover;
    out property <color> on-accent: root.palettes[root.current].on-accent;
    out property <color> wave: root.palettes[root.current].wave;
    out property <color> wave-dim: root.palettes[root.current].wave-dim;
    out property <color> track: root.palettes[root.current].track;
    out property <color> danger: root.palettes[root.current].danger;
    out property <color> hover: root.palettes[root.current].hover;  // hovered button or row
    out property <color> hover-soft: root.palettes[root.current].hover-soft;  // hovered field
    out property <color> row-hover: root.palettes[root.current].row-hover;  // hovered clip row
    out property <color> picked: root.palettes[root.current].picked;  // clip picked for a merge
    out property <color> popup: root.palettes[root.current].popup;  // menus and tips
    out property <color> popup-edge: root.palettes[root.current].popup-edge;  // menu outline
    out property <color> knob: root.palettes[root.current].knob;  // switch knob when off
    out property <color> faint: root.palettes[root.current].faint;  // tenths of the timer while recording
    out property <color> fainter: root.palettes[root.current].fainter;  // tenths when idle
    out property <color> rec-rest: root.palettes[root.current].rec-rest;  // level bars at rest while recording
    out property <color> divider: root.palettes[root.current].divider;  // line between rows
    out property <color> border: root.palettes[root.current].border;  // card outline
    out property <color> card-edge: root.palettes[root.current].card-edge;  // transcript card outline
    out property <color> footer: root.palettes[root.current].footer;  // now playing bar
    out property <color> press: root.palettes[root.current].press;  // pressed download button
    out property <string> mono: "JetBrains Mono";
}

// Line icons on a 24 unit grid, drawn as paths so they never depend on fonts.
component Icon inherits Path {
    in property <string> name;
    in property <color> tint: Theme.text;
    in property <bool> solid: name == "play" || name == "pause" || name == "stop" || name == "dots" || name == "grip" || name == "dot";
    width: 14px;
    height: 14px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: solid ? transparent : tint;
    stroke-width: 2px;
    fill: solid ? tint : transparent;
    commands: name == "gear" ? "M 15 12 A 3 3 0 1 1 9 12 A 3 3 0 1 1 15 12 Z M 12 2 L 12 5 M 12 19 L 12 22 M 2 12 L 5 12 M 19 12 L 22 12 M 5 5 L 7 7 M 17 17 L 19 19 M 5 19 L 7 17 M 17 7 L 19 5"
        : name == "pin" ? "M 12 17 L 12 22 M 9 3 L 15 3 L 14 10 L 18 14 L 6 14 L 10 10 Z"
        : name == "widget" ? "M 3 8 L 21 8 L 21 16 L 3 16 Z"
        : name == "expand" ? "M 4 4 L 20 4 L 20 20 L 4 20 Z M 4 9 L 20 9"
        : name == "close" ? "M 6 6 L 18 18 M 18 6 L 6 18"
        : name == "back" ? "M 15 6 L 9 12 L 15 18"
        : name == "chevron" ? "M 9 6 L 15 12 L 9 18"
        : name == "down" ? "M 6 9 L 12 15 L 18 9"
        : name == "up" ? "M 6 15 L 12 9 L 18 15"
        : name == "grip" ? "M 7.6 6 A 1.6 1.6 0 1 0 10.8 6 A 1.6 1.6 0 1 0 7.6 6 Z M 13.2 6 A 1.6 1.6 0 1 0 16.4 6 A 1.6 1.6 0 1 0 13.2 6 Z M 7.6 12 A 1.6 1.6 0 1 0 10.8 12 A 1.6 1.6 0 1 0 7.6 12 Z M 13.2 12 A 1.6 1.6 0 1 0 16.4 12 A 1.6 1.6 0 1 0 13.2 12 Z M 7.6 18 A 1.6 1.6 0 1 0 10.8 18 A 1.6 1.6 0 1 0 7.6 18 Z M 13.2 18 A 1.6 1.6 0 1 0 16.4 18 A 1.6 1.6 0 1 0 13.2 18 Z"
        : name == "dot" ? "M 4 12 A 8 8 0 1 0 20 12 A 8 8 0 1 0 4 12 Z"
        : name == "import" ? "M 12 4 L 12 15 M 7 10 L 12 15 L 17 10 M 4 19 L 20 19"
        : name == "dots" ? "M 10.2 5 A 1.8 1.8 0 1 0 13.8 5 A 1.8 1.8 0 1 0 10.2 5 Z M 10.2 12 A 1.8 1.8 0 1 0 13.8 12 A 1.8 1.8 0 1 0 10.2 12 Z M 10.2 19 A 1.8 1.8 0 1 0 13.8 19 A 1.8 1.8 0 1 0 10.2 19 Z"
        : name == "pencil" ? "M 4 20 L 8 20 L 19 9 L 15 5 L 4 16 Z"
        : name == "trash" ? "M 4 7 L 20 7 M 10 11 L 10 17 M 14 11 L 14 17 M 6 7 L 7 20 L 17 20 L 18 7 M 9 7 L 9 4 L 15 4 L 15 7"
        : name == "rewind" ? "M 3 12 A 9 9 0 1 0 12 3 A 9.75 9.75 0 0 0 5.26 5.74 L 3 8 M 3 3 L 3 8 L 8 8"
        : name == "forward" ? "M 21 12 A 9 9 0 1 1 12 3 C 14.52 3 16.93 4 18.74 5.74 L 21 8 M 21 3 L 21 8 L 16 8"
        : name == "mic" ? "M 9 6 A 3 3 0 0 1 15 6 L 15 12 A 3 3 0 0 1 9 12 Z M 5 11 A 7 7 0 0 0 19 11 M 12 18 L 12 21"
        : name == "play" ? "M 8 5 L 19 12 L 8 19 Z"
        : name == "pause" ? "M 6 5 L 10 5 L 10 19 L 6 19 Z M 14 5 L 18 5 L 18 19 L 14 19 Z"
        : name == "stop" ? "M 6 6 L 18 6 L 18 18 L 6 18 Z"
        : name == "minimize" ? "M 5 12 L 19 12"
        : name == "check" ? "M 5 12 L 10 17 L 19 7"
        : name == "updown" ? "M 8 10 L 12 6 L 16 10 M 8 14 L 12 18 L 16 14"
        : name == "folder" ? "M 3 7 L 9 7 L 11 9 L 21 9 L 21 19 L 3 19 Z"
        : name == "search" ? "M 18 11 A 7 7 0 1 1 4 11 A 7 7 0 1 1 18 11 Z M 20 20 L 16 16"
        // The side rail's icons, after Lucide.
        : name == "cog" ? "M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z"
        : name == "pushpin" ? "M12 17v5 M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"
        : name == "pip" ? "M21 9V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4 M14 13h6a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2z"
        : name == "file-plus" ? "M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z M14 2v4a2 2 0 0 0 2 2h4 M12 12v6 M9 15h6"
        : name == "copy" ? "M10 8h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-10a2 2 0 0 1-2-2v-10a2 2 0 0 1 2-2z M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
        : name == "list" ? "M8 6h13 M8 12h13 M8 18h13 M3 6h1 M3 12h1 M3 18h1"
        : "";
}

// What a tooltip looks like: a small dark bubble with a thin warm edge.
component Tip inherits Rectangle {
    in property <string> text;
    background: Theme.popup.with-alpha(0.95);
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.popup-edge;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000099;
    width: bubble.preferred-width;
    height: bubble.preferred-height;
    bubble := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 5px;
        padding-bottom: 5px;
        Text {
            text: root.text;
            color: Theme.text2;
            font-size: 12px;
            font-weight: 500;
        }
    }
}

// A text button. Primary is the orange one; the rest are outlined.
component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <length> font-size: 13px;
    callback clicked;
    height: 36px;
    min-width: label.preferred-width + 26px;
    border-radius: 9px;
    background: primary ? (t.has-hover && enabled ? Theme.accent-hover : Theme.accent) : (t.has-hover && enabled ? Theme.raised : transparent);
    border-width: primary ? 0 : 1px;
    border-color: on ? Theme.accent : Theme.edge;
    opacity: enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if (enabled) { root.clicked(); } }
    label := Text {
        text: root.text;
        color: primary ? Theme.on-accent : danger ? Theme.danger : on ? Theme.accent : Theme.text;
        font-size: root.font-size;
        font-weight: primary ? 800 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A round or square button holding one icon.
component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    // The tooltip: a word or two, no punctuation. The label is for screen readers.
    in property <string> tip: label;
    in property <length> size: 30px;
    in property <length> icon-size: 13px;
    in property <bool> round;
    in property <bool> filled;
    in property <bool> outlined;
    in property <bool> active;
    in property <color> tint: filled ? Theme.on-accent : active ? Theme.accent : Theme.dim;
    in property <bool> enabled: true;
    callback clicked;
    width: size;
    height: size;
    border-radius: round ? size / 2 : 7px;
    background: filled ? (t.has-hover ? Theme.accent-hover : Theme.accent) : t.has-hover && enabled ? Theme.raised : transparent;
    border-width: outlined ? 1px : 0;
    border-color: Theme.edge;
    opacity: enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if (enabled) { root.clicked(); } }
    Icon {
        name: root.icon;
        tint: t.has-hover && !root.filled && !root.active ? Theme.text : root.tint;
        width: root.icon-size;
        height: root.icon-size;
    }
    // The button has no text, so hovering it names what it does.
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); }
    @children
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: checked ? Theme.accent : Theme.track;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: label;
    accessible-action-default => { root.checked = !root.checked; root.toggled(root.checked); }
    Rectangle {
        x: root.checked ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? Theme.on-accent : Theme.knob;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}

// Vertical bars, one per value. Bars left of `progress` (a fraction) are orange.
component Wave inherits Rectangle {
    in property <[float]> values;
    in property <float> progress: -1;
    in property <color> played: Theme.accent;
    in property <color> rest: Theme.wave;
    in property <length> gap: 2px;
    in property <length> min-bar: 2px;
    HorizontalLayout {
        spacing: root.gap;
        for v[i] in root.values: Rectangle {
            Rectangle {
                width: parent.width;
                height: max(root.min-bar, v * root.height);
                y: (parent.height - self.height) / 2;
                border-radius: 1.5px;
                background: (i + 0.5) / root.values.length <= root.progress ? root.played : root.rest;
            }
        }
    }
}

// One choice in the export menu.
component ExportItem inherits Rectangle {
    in property <string> text;
    in property <string> tag;
    in property <bool> current;
    callback clicked;
    height: 34px;
    border-radius: 6px;
    background: t.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: "Export " + text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            text: root.text;
            color: t.has-hover || root.current ? Theme.text : Theme.text2;
            font-size: 13px;
            font-weight: root.current ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.tag;
            color: Theme.dim;
            font-family: Theme.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Every export, grouped: the full project, the audio formats, and the transcript
// files. `choose` gets 7 for the full project, 0 to 2 for FLAC, WAV and MP3, and 3 to 6
// for SRT, VTT, word timestamps and the timed text.
component ExportChoices inherits VerticalLayout {
    in property <bool> subtitles;
    in property <int> format: -1;
    callback choose(int);
    ExportItem { text: "All files"; tag: "folder"; clicked => { root.choose(7); } }
    Rectangle {
        height: 9px;
        Rectangle { x: 10px; width: parent.width - 20px; height: 1px; background: Theme.edge; }
    }
    HorizontalLayout {
        padding-left: 10px;
        height: 24px;
        Text {
            text: "AUDIO";
            color: Theme.dim;
            font-family: Theme.mono;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
    ExportItem { text: "FLAC"; tag: "lossless"; current: root.format == 0; clicked => { root.choose(0); } }
    ExportItem { text: "WAV"; tag: "standard"; current: root.format == 1; clicked => { root.choose(1); } }
    ExportItem { text: "MP3"; tag: "small"; current: root.format == 2; clicked => { root.choose(2); } }
    if root.subtitles: Rectangle {
        height: 9px;
        Rectangle { x: 10px; width: parent.width - 20px; height: 1px; background: Theme.edge; }
    }
    if root.subtitles: HorizontalLayout {
        padding-left: 10px;
        height: 24px;
        Text {
            text: "TRANSCRIPT";
            color: Theme.dim;
            font-family: Theme.mono;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
    if root.subtitles: ExportItem { text: "Text with times"; tag: "txt"; clicked => { root.choose(6); } }
    if root.subtitles: ExportItem { text: "Subtitles SRT"; tag: "video"; clicked => { root.choose(3); } }
    if root.subtitles: ExportItem { text: "Subtitles VTT"; tag: "web"; clicked => { root.choose(4); } }
    if root.subtitles: ExportItem { text: "Word timestamps"; tag: "json"; clicked => { root.choose(5); } }
}

// Height of ExportChoices.
// The window's height, so a dropdown can open upwards when there is no room below.
global Win {
    in-out property <length> height: 600px;
}

global ExportSize {
    out property <length> audio: 34px + 9px + 24px + 3 * 34px;
    out property <length> transcript: 9px + 24px + 4 * 34px;
}

// One row in a menu.
component MenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> more;
    // The current choice: a check mark on the right.
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    border-radius: 6px;
    background: t.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: text;
    accessible-checked: root.checked;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Text {
            text: root.text;
            color: root.danger ? Theme.danger : t.has-hover ? Theme.text : Theme.text2;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.more: Icon {
            name: "chevron";
            tint: Theme.dim;
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
        }
        if root.checked: Icon {
            name: "check";
            tint: Theme.accent;
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
        }
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The project dropdown over the clip list: pick a project, make a new one, or
// rename, delete (when empty) or export the current one. Project 0 is Inbox.
component ProjectPicker inherits Rectangle {
    in property <[string]> projects;
    in property <int> current;
    in property <bool> enabled: true;
    in property <bool> has-clips;
    callback choose(int);
    callback create();
    callback rename();
    callback delete();
    callback export();
    property <int> shown-rows: min(root.projects.length, 8);
    width: row.preferred-width + 16px;
    height: 30px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: t.has-hover && root.enabled ? Theme.raised : transparent;
    accessible-role: combobox;
    accessible-label: "Project";
    accessible-value: root.current >= 0 && root.current < root.projects.length ? root.projects[root.current] : "";
    accessible-expandable: true;
    accessible-action-default => { if (root.enabled) { popup.show(); } }
    accessible-action-expand => { if (root.enabled) { popup.show(); } }
    row := HorizontalLayout {
        x: 8px;
        spacing: 6px;
        Text {
            text: root.current >= 0 && root.current < root.projects.length ? root.projects[root.current] : "";
            color: Theme.text;
            font-size: 13px;
            font-weight: 800;
            vertical-alignment: center;
        }
        Icon {
            name: "down";
            tint: Theme.muted;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
        }
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 220px;
        height: root.shown-rows * 34px + 9px + (root.current > 0 ? 4 : 2) * 34px + 10px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 20px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000099;
            VerticalLayout {
                padding: 5px;
                Flickable {
                    height: root.shown-rows * 34px;
                    content-height: root.projects.length * 34px;
                    for p[i] in root.projects: MenuRow {
                        y: i * 34px;
                        width: parent.width;
                        text: p;
                        checked: i == root.current;
                        clicked => { root.choose(i); popup.close(); }
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle { x: 10px; width: parent.width - 20px; height: 1px; background: Theme.edge; }
                }
                MenuRow { text: "New project"; clicked => { root.create(); popup.close(); } }
                if root.current > 0: MenuRow { text: "Rename project"; clicked => { root.rename(); popup.close(); } }
                MenuRow { text: "Export project"; enabled: root.has-clips; clicked => { root.export(); popup.close(); } }
                if root.current > 0: MenuRow { text: "Delete project"; danger: true; enabled: !root.has-clips; clicked => { root.delete(); popup.close(); } }
            }
        }
    }
}

component ClipItem inherits Rectangle {
    in property <ClipRow> item;
    // Width of the small waveform; 0 leaves it out (narrow windows).
    in property <length> wave-width: 84px;
    in property <bool> selected;
    // Part of a selection of several clips (Ctrl or Shift click).
    in property <bool> picked;
    // How many clips are picked, when this one is among them; its menu offers to merge.
    in property <int> merge-count;
    in property <bool> active;
    in property <bool> playing;
    in property <float> progress;
    callback play();
    callback cue(float);
    callback play-at(float);
    // A click highlights the clip and a double click plays or pauses it. Ctrl and Shift
    // pick several. The three-dot menu (or a right click, or the right arrow key) opens
    // it.
    callback select(bool, bool);
    callback merge();
    callback open();
    callback rename();
    callback export(int);
    callback delete();
    // The projects, for "Move to", and the one this clip is in.
    in property <[string]> projects;
    in property <int> project;
    callback move-to(int);
    // The menu shows the export formats instead of its main choices.
    property <bool> exporting;
    // The menu shows the projects to move the clip to.
    property <bool> moving;
    // Where the menu opens: under the dots, or where the right click was.
    property <length> menu-x;
    property <length> menu-y;
    height: 52px;
    border-radius: 10px;
    background: root.picked ? Theme.picked : root.active || root.selected ? Theme.row : row-touch.has-hover ? Theme.row-hover : transparent;
    border-width: root.selected || root.picked ? 1px : 0;
    border-color: root.picked ? Theme.accent.with-alpha(0.33) : Theme.edge;
    accessible-role: list-item;
    accessible-label: root.item.name + ", " + root.item.duration;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected || root.picked;
    accessible-action-default => { root.select(false, false); }
    row-touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.has-hover) {
                root.select(e.modifiers.control, e.modifiers.shift);
            }
            // On release: the press that closes an open menu is used up by that menu,
            // so opening on the press would only work every other time.
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.menu-at(self.mouse-x, self.mouse-y);
            }
        }
        double-clicked => { root.play(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            IconBtn {
                size: 32px;
                round: true;
                icon-size: 11px;
                icon: root.active && root.playing ? "pause" : "play";
                label: (root.active && root.playing ? "Pause " : "Play ") + root.item.name;
                tip: root.active && root.playing ? "Pause" : "Play";
                filled: root.active;
                outlined: !root.active;
                tint: root.active ? Theme.on-accent : Theme.text;
                clicked => { root.play(); }
            }
        }
        // A click on the waveform moves the clip's start there (and jumps while it
        // plays); a double click plays from there.
        if root.wave-width > 0: Rectangle {
            width: root.wave-width;
            height: 28px;
            y: (parent.height - self.height) / 2;
            Wave {
                height: 22px;
                y: (parent.height - self.height) / 2;
                gap: 1px;
                values: root.item.wave;
                progress: root.active ? root.progress : -1;
            }
            TouchArea {
                mouse-cursor: pointer;
                // Ctrl or Shift picks clips here too, as anywhere on the row.
                property <bool> picking;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { self.picking = e.modifiers.control || e.modifiers.shift; }
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.picking && self.has-hover) {
                        root.select(e.modifiers.control, e.modifiers.shift);
                    }
                    // A right click here opens the same menu as anywhere on the row.
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                        root.menu-at(
                            self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                            self.absolute-position.y - root.absolute-position.y + self.mouse-y);
                    }
                }
                clicked => { if (!self.picking) { root.cue(clamp(self.mouse-x / self.width, 0, 1)); } }
                double-clicked => { root.play-at(clamp(self.mouse-x / self.width, 0, 1)); }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.item.meta;
                color: root.active ? Theme.accent : Theme.dim;
                font-size: 11px;
                overflow: elide;
            }
        }
        Text {
            text: root.item.duration;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 12px;
            vertical-alignment: center;
        }
        // The three-dot menu: manage, rename, export, delete.
        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            background: dots.has-hover ? Theme.raised : transparent;
            accessible-role: button;
            accessible-label: "Menu for " + root.item.name;
            accessible-action-default => { root.open-menu(); }
            Icon {
                name: "dots";
                tint: dots.has-hover ? Theme.text : Theme.dim;
                width: 16px;
                height: 16px;
            }
            property <bool> hovering: dots.has-hover;
            changed hovering => { Tips.hover(self.hovering, "More options", self.absolute-position, self.width, self.height); }
            dots := TouchArea {
                mouse-cursor: pointer;
                clicked => { Tips.hide(); root.open-menu(); }
            }

        }
    }
    // Opens the menu where the right click was (row coordinates).
    function menu-at(x: length, y: length) {
        menu.close();
        root.menu-x = min(x, root.width - 210px);
        root.menu-y = y;
        root.exporting = false;
        root.moving = false;
        menu.show();
    }
    function open-menu() {
        root.menu-x = root.width - 8px - 210px;
        root.menu-y = (root.height + 28px) / 2 + 4px;
        root.exporting = false;
        root.moving = false;
        menu.show();
    }
    menu := PopupWindow {
        x: min(root.menu-x, root.width - self.width);
        y: root.menu-y;
        width: root.exporting ? 250px : 210px;
        height: root.exporting ? 10px + 34px + ExportSize.audio + (root.item.transcribed ? ExportSize.transcript : 0)
            : root.moving ? 10px + 34px + min(root.projects.length, 8) * 34px
            : (root.projects.length > 1 ? 5 : 4) * 34px + 9px + 10px + (root.merge-count >= 2 ? 34px + 9px : 0);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 20px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000099;
            if !root.exporting && !root.moving: VerticalLayout {
                padding: 5px;
                if root.merge-count >= 2: MenuRow { text: "Merge " + root.merge-count + " clips"; clicked => { root.merge(); menu.close(); } }
                if root.merge-count >= 2: Rectangle {
                    height: 9px;
                    Rectangle { x: 10px; width: parent.width - 20px; height: 1px; background: Theme.edge; }
                }
                MenuRow { text: "Manage"; clicked => { root.open(); menu.close(); } }
                MenuRow { text: "Rename"; clicked => { root.rename(); menu.close(); } }
                MenuRow { text: "Export"; more: true; clicked => { root.exporting = true; } }
                if root.projects.length > 1: MenuRow { text: "Move to"; more: true; clicked => { root.moving = true; } }
                Rectangle {
                    height: 9px;
                    Rectangle { x: 10px; width: parent.width - 20px; height: 1px; background: Theme.edge; }
                }
                MenuRow { text: "Delete"; danger: true; clicked => { root.delete(); menu.close(); } }
            }
            if root.moving: VerticalLayout {
                padding: 5px;
                MenuRow { text: "‹  Move to"; clicked => { root.moving = false; } }
                Flickable {
                    height: min(root.projects.length, 8) * 34px;
                    content-height: root.projects.length * 34px;
                    for p[i] in root.projects: MenuRow {
                        y: i * 34px;
                        width: parent.width;
                        text: p;
                        checked: i == root.project;
                        enabled: i != root.project;
                        clicked => { root.move-to(i); menu.close(); }
                    }
                }
            }
            if root.exporting: VerticalLayout {
                padding: 5px;
                MenuRow { text: "‹  Export"; clicked => { root.exporting = false; } }
                ExportChoices {
                    subtitles: root.item.transcribed;
                    choose(kind) => { root.export(kind); menu.close(); }
                }
            }
        }
    }
}

// A back link at the top of a page.
component BackLink inherits Rectangle {
    in property <string> text;
    callback clicked;
    width: row.preferred-width + 16px;
    height: 28px;
    border-radius: 6px;
    background: t.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: "Back to " + text;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        x: 8px;
        spacing: 4px;
        Icon { name: "back"; tint: Theme.muted; y: (parent.height - self.height) / 2; }
        Text {
            text: root.text;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A scrolling area with a thin bar that only shows when there is more to see. It
// widens under the mouse and can be dragged.
component Scroller inherits Rectangle {
    out property <length> visible-width <=> fl.width;
    out property <length> visible-height <=> fl.height;
    in-out property <length> content-height <=> fl.content-height;
    in-out property <length> content-y <=> fl.content-y;
    callback scrolled <=> fl.flicked;
    property <length> range: fl.content-height - fl.height;
    property <length> thumb-h: max(28px, fl.height * fl.height / max(fl.content-height, 1px));
    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-height: 50px;
    fl := Flickable {
        width: parent.width;
        height: parent.height;
        mouse-drag-pan-enabled: false;
        @children
    }
    if root.range > 1px: Rectangle {
        x: parent.width - self.width - 2px;
        y: (-fl.content-y / root.range) * (fl.height - root.thumb-h);
        width: drag.has-hover || drag.pressed ? 6px : 3px;
        height: root.thumb-h;
        border-radius: self.width / 2;
        background: drag.pressed ? Theme.text.with-alpha(0.33) : drag.has-hover ? Theme.text.with-alpha(0.2) : Theme.text.with-alpha(0.11);
        animate width, background { duration: 120ms; }
        drag := TouchArea {
            x: -6px;
            width: parent.width + 8px;
            moved => {
                if (self.pressed) {
                    fl.content-y = clamp(-(parent.y + self.mouse-y - self.pressed-y) / (fl.height - root.thumb-h) * root.range, -root.range, 0);
                }
            }
        }
    }
}

// The export button. A click opens a menu above it with every export (see
// ExportChoices for what `export` gets).
component ExportButton inherits Rectangle {
    in property <int> format;
    in property <bool> subtitles;
    callback export(int);
    function choose(kind: int) {
        popup.close();
        root.export(kind);
    }
    height: 36px;
    width: label.preferred-width + 60px;
    border-radius: 9px;
    background: t.has-hover ? Theme.accent-hover : Theme.accent;
    accessible-role: button;
    accessible-label: "Export";
    accessible-expandable: true;
    accessible-action-default => { popup.show(); }
    accessible-action-expand => { popup.show(); }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 14px;
        spacing: 10px;
        label := Text {
            text: "Export";
            color: Theme.on-accent;
            font-size: 13px;
            font-weight: 800;
            vertical-alignment: center;
        }
        Icon {
            name: "up";
            tint: Theme.on-accent;
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
            stroke-width: 2.5px;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    // Opens above the button and closes on a choice or a click anywhere else.
    // The button sits on the right, so the menu lines up with its right edge.
    popup := PopupWindow {
        x: root.width - self.width;
        y: -self.height - 6px;
        width: 250px;
        height: 10px + ExportSize.audio + (root.subtitles ? ExportSize.transcript : 0);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 20px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000099;
            VerticalLayout {
                padding: 5px;
                ExportChoices {
                    subtitles: root.subtitles;
                    format: root.format;
                    choose(kind) => { root.choose(kind); }
                }
            }
        }
    }
}

// An invisible strip along a window edge or corner that resizes the window.
component ResizeEdge inherits TouchArea {
    in property <int> direction;
    callback resize(int);
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
            root.resize(root.direction);
        }
    }
}

// A window button in the title bar. The close button turns red on hover, like Windows.
component WinBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger;
    callback clicked;
    width: 44px;
    height: 32px;
    background: t.has-hover ? (danger ? #c42b1c : Theme.raised) : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    Icon {
        name: root.icon;
        tint: t.has-hover ? (root.danger ? #ffffff : Theme.text) : Theme.dim;
        width: 12px;
        height: 12px;
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.label, self.absolute-position, self.width, self.height); }
    t := TouchArea { clicked => { Tips.hide(); root.clicked(); } }
}

// The window's own title bar: drag it to move the window. Whatever is put inside goes
// on the left; minimise and close are always on the right.
component RailBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> tip: label;
    // The page you are on: a raised square and an accent bar.
    in property <bool> current;
    // A switch that is on: the icon turns the accent colour.
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: root.current || (t.has-hover && root.enabled) ? Theme.raised : transparent;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    if root.current: Rectangle {
        x: -7px;
        y: 9px;
        width: 3px;
        height: parent.height - 18px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    Icon {
        name: root.icon;
        width: 17px;
        height: 17px;
        tint: root.on ? Theme.accent : root.current || t.has-hover ? Theme.text : Theme.dim;
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

component TitleBar inherits Rectangle {
    in property <length> left-padding: 8px;
    // Pushes the content to the left; off when the content stretches itself.
    in property <bool> fill: true;
    callback minimize();
    callback close();
    height: 32px;
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    HorizontalLayout {
        padding-left: root.left-padding;
        spacing: 2px;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            @children
            if root.fill: Rectangle { horizontal-stretch: 1; }
        }
        WinBtn { icon: "minimize"; label: "Minimize"; clicked => { root.minimize(); } }
        WinBtn { icon: "close"; label: "Close"; danger: true; clicked => { root.close(); } }
    }
}

// A round back button and a large page title.
// A list whose rows can be dragged into another order, or moved with their arrows.
// `moved(from, to)` reports a move; `act(i)` the row's text button, if `action` names one.
component OrderList inherits Rectangle {
    in property <[OrderRow]> rows;
    // A text button on each row, like "Take out"; empty for none.
    in property <string> action;
    // An x on each row instead, that takes the row out of the list.
    in property <bool> removable;
    // A play button on each row; the row named `playing-name` shows pause.
    in property <bool> playable;
    in property <string> playing-name;
    in property <bool> enabled: true;
    callback moved(int, int);
    callback act(int);
    callback play(int);
    property <length> row-h: 50px;
    property <int> dragging: -1;
    property <length> drag-dy;
    property <int> target: root.dragging < 0 ? -1 : clamp(round((root.dragging * root.row-h + root.drag-dy) / root.row-h), 0, root.rows.length - 1);
    height: root.rows.length * root.row-h;
    // One touch area for the whole list, under the rows: the drag is measured
    // against the list, which stays put, not against a row that moves. The row's
    // buttons sit on top and take their own clicks.
    TouchArea {
        enabled: root.enabled && root.rows.length > 1;
        mouse-cursor: root.dragging >= 0 ? grabbing : grab;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.drag-dy = 0;
                root.dragging = clamp(floor(self.mouse-y / root.row-h), 0, root.rows.length - 1);
            }
            if (e.kind == PointerEventKind.up && root.dragging >= 0) {
                let from = root.dragging;
                let to = root.target;
                root.dragging = -1;
                root.drag-dy = 0;
                if (to != from) { root.moved(from, to); }
            }
        }
        moved => {
            if (self.pressed && root.dragging >= 0) {
                root.drag-dy = clamp(self.mouse-y - self.pressed-y, -root.dragging * root.row-h, (root.rows.length - 1 - root.dragging) * root.row-h);
            }
        }
    }
    for r[i] in root.rows: Rectangle {
        // The dragged row follows the mouse, raised, buttons and all; the others make
        // room where it would land.
        y: i * root.row-h + (i == root.dragging ? root.drag-dy
            : root.dragging >= 0 && i > root.dragging && i <= root.target ? -root.row-h
            : root.dragging >= 0 && i < root.dragging && i >= root.target ? root.row-h
            : 0);
        // The others slide, only while dragging; the dragged row never lags, and after
        // the drop every row takes its new place at once.
        animate y { duration: root.dragging >= 0 && i != root.dragging ? 150ms : 0ms; easing: ease-out; }
        height: root.row-h;
        z: i == root.dragging ? 1 : 0;
        border-radius: 10px;
        background: i == root.dragging ? Theme.raised : transparent;
        border-width: i == root.dragging ? 1px : 0;
        border-color: Theme.edge;
        drop-shadow-blur: i == root.dragging ? 16px : 0;
        drop-shadow-offset-y: i == root.dragging ? 6px : 0;
        drop-shadow-color: #00000099;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 8px;
            spacing: 10px;
            Icon {
                name: "grip";
                tint: Theme.dim;
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
            }
            Text {
                // The place the row has right now, also mid-drag.
                text: (i == root.dragging ? root.target
                    : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1
                    : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1
                    : i) + 1;
                color: Theme.accent;
                font-family: Theme.mono;
                font-size: 12px;
                vertical-alignment: center;
                width: 16px;
            }
            if root.playable: VerticalLayout {
                alignment: center;
                IconBtn {
                    size: 30px;
                    round: true;
                    outlined: r.name != root.playing-name;
                    filled: r.name == root.playing-name;
                    icon: r.name == root.playing-name ? "pause" : "play";
                    icon-size: 10px;
                    tint: r.name == root.playing-name ? Theme.on-accent : Theme.text;
                    label: (r.name == root.playing-name ? "Pause " : "Play ") + r.name;
                    tip: r.name == root.playing-name ? "Pause" : "Play";
                    clicked => { root.play(i); }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 1px;
                Text { text: r.name; color: Theme.text; font-size: 14px; overflow: elide; }
                if r.note != "": Text { text: r.note; color: Theme.dim; font-size: 11px; overflow: elide; }
            }
            if root.removable: VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: "close";
                    icon-size: 12px;
                    label: "Remove " + r.name;
                    tip: "Remove";
                    size: 28px;
                    enabled: root.enabled;
                    clicked => { root.act(i); }
                }
            }
            if root.action != "": VerticalLayout {
                alignment: center;
                Btn {
                    text: root.action;
                    height: 28px;
                    font-size: 12px;
                    enabled: root.enabled;
                    accessible-label: root.action + " " + r.name;
                    clicked => { root.act(i); }
                }
            }
        }
        if i < root.rows.length - 1 && root.dragging < 0: Rectangle {
            x: 10px;
            y: parent.height - 1px;
            width: parent.width - 20px;
            height: 1px;
            background: Theme.divider;
        }
    }
}

component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> note;
    callback back();
    padding-left: 20px;
    padding-right: 22px;
    padding-bottom: 6px;
    spacing: 10px;
    Rectangle {
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: bt.has-hover ? Theme.raised : Theme.card;
        accessible-role: button;
        accessible-label: "Back";
        accessible-action-default => { root.back(); }
        Icon { name: "back"; tint: Theme.muted; width: 15px; height: 15px; }
        bt := TouchArea { mouse-cursor: pointer; clicked => { root.back(); } }
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 24px;
        font-weight: 800;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Text {
        text: root.note;
        color: Theme.dim;
        font-size: 12px;
        vertical-alignment: center;
    }
}

// A dropdown in the Ember look; the list opens below it.
component Select inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    in property <string> label;
    callback selected(int);
    // Up and Down pick the next option straight away, closed or open, so two
    // choices are easy to compare.
    function step(by: int) {
        if (root.model.length == 0) { return; }
        let next = clamp(root.current-index + by, 0, root.model.length - 1);
        if (next != root.current-index) {
            root.current-index = next;
            root.selected(next);
        }
    }
    function open() {
        keys.focus();
        popup.show();
    }
    width: 200px;
    height: 32px;
    border-radius: 8px;
    border-width: keys.has-focus ? 1px : 0;
    border-color: Theme.edge;
    background: t.has-hover && enabled ? Theme.hover-soft : Theme.raised;
    opacity: enabled ? 1 : 0.45;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: current-index >= 0 && current-index < model.length ? model[current-index] : "";
    accessible-expandable: true;
    accessible-action-default => { if (enabled) { root.open(); } }
    accessible-action-expand => { if (enabled) { root.open(); } }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.UpArrow) { root.step(-1); return accept; }
            if (e.text == Key.DownArrow) { root.step(1); return accept; }
            if (e.text == Key.Return || e.text == " ") { root.open(); return accept; }
            reject
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 9px;
        spacing: 8px;
        Text {
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Icon {
            name: "updown";
            tint: Theme.muted;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
        }
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    // Opens below the box, or above it when it would not fit below; never over it.
    property <length> list-height: min(root.model.length * 32px + 10px, 298px);
    property <bool> upwards: root.absolute-position.y + root.height + 4px + self.list-height > Win.height
        && root.absolute-position.y - 4px - self.list-height >= 0;
    popup := PopupWindow {
        x: 0;
        y: root.upwards ? -root.list-height - 4px : root.height + 4px;
        width: max(root.width, 120px);
        height: root.list-height;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 20px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000099;
            FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                        root.step(e.text == Key.UpArrow ? -1 : 1);
                        // Keep the picked row in view.
                        let top = root.current-index * 32px;
                        if (top < -list.content-y) { list.content-y = -top; }
                        if (top + 32px > -list.content-y + list.height) { list.content-y = list.height - top - 32px; }
                        return accept;
                    }
                    if (e.text == Key.Return || e.text == Key.Escape || e.text == " ") {
                        popup.close();
                        keys.focus();
                        return accept;
                    }
                    reject
                }
            }
            list := Flickable {
                x: 5px;
                y: 5px;
                width: parent.width - 10px;
                height: parent.height - 10px;
                content-height: root.model.length * 32px;
                for item[i] in root.model: Rectangle {
                    y: i * 32px;
                    height: 32px;
                    border-radius: 6px;
                    background: i == root.current-index ? Theme.hover : it.has-hover ? Theme.hover-soft : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: item;
                            color: i == root.current-index ? Theme.text : Theme.text2;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if i == root.current-index: Icon {
                            name: "check";
                            tint: Theme.accent;
                            width: 13px;
                            height: 13px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    it := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// A single-line text field in the Ember look, with an optional icon on the left.
component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> icon;
    in property <bool> mono;
    in property <bool> invalid;
    in property <string> label;
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted(string);
    public function grab() {
        input.focus();
        input.select-all();
    }
    height: 36px;
    border-radius: 8px;
    background: Theme.bg;
    border-width: 1px;
    border-color: invalid ? Theme.danger : input.has-focus ? Theme.accent : Theme.edge;
    opacity: enabled ? 1 : 0.45;
    Rectangle {
        visible: input.has-focus && !root.invalid;
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 11px;
        border-width: 3px;
        border-color: Theme.accent.with-alpha(0.16);
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        if root.icon != "": Icon {
            name: root.icon;
            tint: Theme.dim;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.dim;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                enabled: root.enabled;
                single-line: true;
                vertical-alignment: center;
                color: Theme.text;
                font-size: 13px;
                font-family: root.mono ? Theme.mono : "Inter Tight";
                selection-background-color: Theme.accent.with-alpha(0.4);
                selection-foreground-color: Theme.text;
                accessible-label: root.label;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }
    }
}

// Click it, then press the keys you want. Shows them as key caps.
component ShortcutBox inherits Rectangle {
    in property <[string]> keys;
    in property <string> label;
    // The pressed key and modifiers; returns true when it made a usable shortcut.
    callback captured(string, bool, bool, bool, bool) -> bool;
    callback cleared();
    callback done();
    property <bool> listening: fs.has-focus;
    width: 200px;
    height: 32px;
    border-radius: 8px;
    background: listening ? Theme.accent.with-alpha(0.08) : t.has-hover ? Theme.hover-soft : Theme.raised;
    border-width: 1px;
    border-color: listening ? Theme.accent : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { fs.focus(); }
    t := TouchArea { mouse-cursor: pointer; clicked => { fs.focus(); } }
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.done(); return accept; }
            if ((event.text == Key.Backspace || event.text == Key.Delete) && !event.modifiers.control && !event.modifiers.alt) {
                root.cleared();
                root.done();
                return accept;
            }
            if (root.captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta)) {
                root.done();
            }
            accept
        }
    }
    if root.listening: HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: Theme.accent;
            y: (parent.height - self.height) / 2;
        }
        Text { text: "Press the keys"; color: Theme.accent; font-size: 13px; font-weight: 600; vertical-alignment: center; }
    }
    if !root.listening && root.keys.length == 0: Text {
        text: "Not set";
        color: Theme.dim;
        font-size: 13px;
    }
    if !root.listening && root.keys.length > 0: HorizontalLayout {
        alignment: center;
        spacing: 4px;
        for k in root.keys: Rectangle {
            width: cap.preferred-width + 14px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.edge;
            cap := Text { text: k; color: Theme.text; font-family: Theme.mono; font-size: 11px; }
        }
    }
}

// Settings are grouped in rounded cards with a title above.
component Card inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    Text {
        text: root.title;
        color: Theme.muted;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px;
        x: 8px;
    }
    Rectangle {
        background: Theme.card;
        border-radius: 14px;
        VerticalLayout {
            @children
        }
    }
}

// One line in a card: a label (and an optional note under it) and its control.
component CardRow inherits VerticalLayout {
    in property <string> label;
    in property <string> note;
    in property <bool> last;
    HorizontalLayout {
        min-height: 52px;
        padding-left: 16px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.label; color: Theme.text; font-size: 14px; overflow: elide; }
            if root.note != "": Text { text: root.note; color: Theme.dim; font-size: 12px; overflow: elide; }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            @children
        }
    }
    if !root.last: Rectangle { height: 1px; background: Theme.divider; }
}

// A filter chip on the model page.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    width: label.preferred-width + 24px;
    height: 28px;
    border-radius: 14px;
    background: on ? Theme.text : t.has-hover ? Theme.raised : transparent;
    border-width: on ? 0 : 1px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: root.on ? Theme.bg : Theme.muted;
        font-size: 12px;
        font-weight: root.on ? 800 : 500;
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A short bar showing 1 to 5.
component Meter inherits Rectangle {
    in property <int> value;
    width: 30px;
    height: 5px;
    border-radius: 2.5px;
    background: Theme.track;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 5) / 5;
        border-radius: 2.5px;
        background: Theme.text2;
    }
}

// The round record button: a mic, or a stop square while recording.
component RecordButton inherits IconBtn {
    in property <bool> recording;
    size: 56px;
    round: true;
    filled: true;
    icon: root.recording ? "stop" : "mic";
    icon-size: root.recording ? 18px : 24px;
    label: root.recording ? "Stop and save" : "Record";
    tip: root.recording ? "Stop" : "Record";
}

// The recorder: status, time, live level and the record buttons. Mode 0 is a narrow
// window (one line, a round Record button), 1 the default, 2 a wide window (a tall
// panel beside the clip list).
component RecorderCard inherits Rectangle {
    in property <int> mode: 1;
    in property <bool> recording;
    in property <bool> paused;
    in property <string> device-label;
    in property <string> elapsed;
    in property <string> elapsed-tenth;
    in property <[float]> live;
    callback record();
    callback pause();
    background: Theme.card;
    border-radius: root.mode == 2 ? 18px : 14px;
    vertical-stretch: root.mode == 2 ? 1 : 0;
    VerticalLayout {
    // Narrow: time and status on the left, round buttons on the right, level below.
    if root.mode == 0: VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: root.recording ? Theme.accent : Theme.wave-dim;
                    }
                    Text {
                        text: root.recording ? (root.paused ? "PAUSED" : "RECORDING") : "READY";
                        color: root.recording ? Theme.accent : Theme.muted;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 0.7px;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Text {
                        text: root.elapsed;
                        color: root.recording ? Theme.text : Theme.knob;
                        font-family: Theme.mono;
                        font-size: 34px;
                        letter-spacing: -1px;
                    }
                    Text {
                        text: root.elapsed-tenth;
                        color: root.recording ? Theme.faint : Theme.fainter;
                        font-family: Theme.mono;
                        font-size: 34px;
                        letter-spacing: -1px;
                    }
                }
            }
            if root.recording: VerticalLayout {
                alignment: center;
                IconBtn {
                    size: 44px;
                    round: true;
                    outlined: true;
                    icon: root.paused ? "play" : "pause";
                    icon-size: 14px;
                    tint: Theme.text;
                    label: root.paused ? "Resume" : "Pause";
                    clicked => { root.pause(); }
                }
            }
            VerticalLayout {
                alignment: center;
                RecordButton {
                    recording: root.recording;
                    clicked => { root.record(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.device-label;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                max-width: 160px;
            }
            Wave {
                height: 18px;
                horizontal-stretch: 1;
                values: root.live;
                progress: root.recording && !root.paused ? 2 : -1;
                rest: root.recording ? Theme.rec-rest : Theme.track;
            }
        }
    }
    // Default and wide: the full card. Wide stretches it and gives the time more room.
    if root.mode != 0: VerticalLayout {
        padding: root.mode == 2 ? 26px : 22px;
        padding-top: root.mode == 2 ? 22px : 20px;
        padding-bottom: root.mode == 2 ? 24px : 18px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: root.recording ? Theme.accent : Theme.wave-dim;
            }
            Text {
                text: root.recording ? (root.paused ? "PAUSED" : "RECORDING") : "READY";
                color: root.recording ? Theme.accent : Theme.muted;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 0.7px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.device-label;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        if root.mode == 2: Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: start;
            Text {
                text: root.elapsed;
                color: root.recording ? Theme.text : Theme.knob;
                font-family: Theme.mono;
                font-size: root.mode == 2 ? 72px : 56px;
                letter-spacing: -2px;
            }
            Text {
                text: root.elapsed-tenth;
                color: root.recording ? Theme.faint : Theme.fainter;
                font-family: Theme.mono;
                font-size: root.mode == 2 ? 72px : 56px;
                letter-spacing: -2px;
            }
        }
        Wave {
            height: root.mode == 2 ? 80px : 52px;
            values: root.live;
            progress: root.recording && !root.paused ? 2 : -1;
            rest: root.recording ? Theme.rec-rest : Theme.track;
        }
        if root.mode == 2: Rectangle { vertical-stretch: 1; }
        // Wide: the same round buttons as the one-line recorder.
        // The record button stays in the middle: pause gets a fixed spot on its left,
        // balanced by an empty one on its right.
        if root.mode == 2: HorizontalLayout {
            alignment: center;
            spacing: 14px;
            VerticalLayout {
                width: 44px;
                alignment: center;
                if root.recording: IconBtn {
                    size: 44px;
                    round: true;
                    outlined: true;
                    icon: root.paused ? "play" : "pause";
                    icon-size: 14px;
                    tint: Theme.text;
                    label: root.paused ? "Resume" : "Pause";
                    clicked => { root.pause(); }
                }
            }
            RecordButton {
                recording: root.recording;
                clicked => { root.record(); }
            }
            Rectangle { width: 44px; }
        }
        if root.mode != 2 && root.recording: HorizontalLayout {
            spacing: 10px;
            Btn {
                primary: true;
                text: "Stop and save";
                font-size: 15px;
                height: root.mode == 2 ? 52px : 46px;
                horizontal-stretch: 1;
                clicked => { root.record(); }
            }
            Btn {
                text: root.paused ? "Resume" : "Pause";
                font-size: 14px;
                height: root.mode == 2 ? 52px : 46px;
                width: 120px;
                clicked => { root.pause(); }
            }
        }
        if root.mode != 2 && !root.recording: Btn {
            primary: true;
            text: "Record";
            font-size: 15px;
            height: root.mode == 2 ? 52px : 46px;
            clicked => { root.record(); }
        }
    }
    }
}

// The transcript on the clip page: words and pauses, Show marks, Edit, or the
// Transcribe button and progress. It sits in the page's scroll on normal windows and
// fills its own column on wide ones.
component TranscriptCard inherits Rectangle {
    in property <string> transcript;
    in property <bool> transcribing;
    in property <float> transcribe-progress;
    in property <[WordRow]> words;
    in property <int> current-word: -1;
    in-out property <bool> show-marks;
    in property <bool> can-transcribe;
    in property <bool> recording;
    // Editing happens in the card itself: the words become a text box with the pause
    // tags in orange, and Cancel and Save take the place of Show marks and Edit.
    in property <bool> editing;
    in-out property <string> edit-draft;
    in property <string> edit-badge;
    in property <bool> speaking;
    callback edit();
    callback transcribe();
    callback seek-word(int);
    callback edited(string);
    callback cancel();
    callback save();
    pure callback edit-markup(string) -> styled-text;
    pure callback plain-selection(string, int, int) -> string;
    // The copy button shows a check mark for a moment after a copy.
    property <bool> copied;
    // Where the editor's cursor is, and how tall it is.
    property <Point> caret;
    property <length> caret-h: 20px;
        border-radius: 14px;
        border-width: 1px;
        border-color: root.editing ? Theme.accent : Theme.card-edge;
        VerticalLayout {
            padding: 18px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 8px;
            HorizontalLayout {
                height: 28px;
                Text {
                    text: "TRANSCRIPT";
                    color: Theme.muted;
                    font-size: 12px;
                    font-weight: 800;
                    letter-spacing: 0.7px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.editing && root.edit-badge != "": Rectangle {
                    width: badge.preferred-width + 16px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 10px;
                    background: Theme.accent;
                    badge := Text {
                        text: root.edit-badge;
                        color: Theme.on-accent;
                        font-size: 11px;
                        font-weight: 800;
                    }
                }
                if root.editing: HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 6px;
                    padding-left: 8px;
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            text: "Cancel";
                            height: 28px;
                            font-size: 12px;
                            clicked => { root.cancel(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            primary: true;
                            text: "Save";
                            height: 28px;
                            font-size: 12px;
                            enabled: root.edit-draft != root.transcript && !root.speaking;
                            clicked => { root.save(); }
                        }
                    }
                }
                if root.transcript != "" && !root.transcribing && !root.editing: VerticalLayout {
                    alignment: center;
                    padding-right: 6px;
                    IconBtn {
                        size: 28px;
                        icon: root.copied ? "check" : "copy";
                        icon-size: 13px;
                        active: root.copied;
                        label: "Copy the transcript";
                        tip: "Copy";
                        clicked => {
                            // The words only, without the pause tags.
                            copy-buf.text = root.plain-selection(root.transcript, 0, 2147483647);
                            copy-buf.select-all();
                            copy-buf.copy();
                            copy-buf.clear-selection();
                            copy-buf.text = "";
                            root.copied = true;
                            copied-timer.running = true;
                        }
                    }
                }
                if root.transcript != "" && !root.transcribing && !root.editing: HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 8px;
                    padding-right: 10px;
                    Text {
                        text: "Show marks";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: "Show marks";
                            checked <=> root.show-marks;
                        }
                    }
                }
                if root.transcript != "" && !root.transcribing && !root.editing: Rectangle {
                    width: edit-row.preferred-width + 20px;
                    height: 26px;
                    y: 1px;
                    border-radius: 7px;
                    background: edit-touch.has-hover ? Theme.hover : Theme.raised;
                    accessible-role: button;
                    accessible-label: "Edit transcript";
                    accessible-action-default => { root.edit(); }
                    edit-row := HorizontalLayout {
                        x: 10px;
                        spacing: 6px;
                        Icon { name: "pencil"; width: 12px; height: 12px; y: (parent.height - self.height) / 2; }
                        Text { text: "Edit"; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                    }
                    edit-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.edit(); }
                    }
                }
            }
            if root.transcribing: VerticalLayout {
                spacing: 10px;
                alignment: start;
                Text {
                    text: "Transcribing " + round(root.transcribe-progress * 100) + "%";
                    color: Theme.text2;
                    font-size: 14px;
                }
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.track;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.transcribe-progress, 0, 1);
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
            }
            if root.transcript == "" && !root.transcribing: VerticalLayout {
                alignment: start;
                spacing: 12px;
                Text {
                    text: "No transcript yet";
                    color: Theme.dim;
                    font-size: 14px;
                }
                if root.can-transcribe: HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: "Transcribe";
                        enabled: !root.recording;
                        clicked => { root.transcribe(); }
                    }
                }
            }
            if root.editing: Rectangle {
                vertical-stretch: 1;
                clip: true;
            ed-scroll := Scroller {
                VerticalLayout {
                    padding-left: 0;
                    padding-right: 10px;
                    padding-top: 2px;
                    padding-bottom: 6px;
                    Rectangle {
                        height: editor.height;
                        StyledText {
                            width: parent.width;
                            y: 0;
                            text: root.edit-markup(editor.text);
                            default-color: Theme.text2;
                            default-font-family: "Inter Tight";
                            default-font-size: 15px;
                        }
                        editor := TextInput {
                            width: parent.width;
                            height: max(self.preferred-height, ed-scroll.visible-height - 8px);
                            text <=> root.edit-draft;
                            font-family: "Inter Tight";
                            font-size: 15px;
                            single-line: false;
                            wrap: word-wrap;
                            color: transparent;
                            selection-background-color: Theme.accent.with-alpha(0.3);
                            selection-foreground-color: transparent;
                            accessible-role: text-input;
                            accessible-label: "Transcript";
                            init => { self.focus(); }
                            edited => { root.edit-draft = self.text; root.edited(self.text); }
                            cursor-position-changed(p) => {
                                root.caret = p;
                                // Keep the cursor in view.
                                if (p.y + 2px + root.caret-h > -ed-scroll.content-y + ed-scroll.visible-height) {
                                    ed-scroll.content-y = -(p.y + 2px + root.caret-h + 6px - ed-scroll.visible-height);
                                } else if (p.y + 2px < -ed-scroll.content-y) {
                                    ed-scroll.content-y = -max(0px, p.y);
                                }
                            }
                            key-pressed(e) => {
                                // With the marks hidden, copying gives just the words.
                                if (e.modifiers.control && (e.text == "c" || e.text == "C") && !root.show-marks) {
                                    clip-buf.text = root.plain-selection(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                                    clip-buf.select-all();
                                    clip-buf.copy();
                                    // Emptied at once, so it is never drawn with a selection.
                                    clip-buf.clear-selection();
                                    clip-buf.text = "";
                                    return accept;
                                }
                                reject
                            }
                        }
                        // The text box's own cursor has the (invisible) text colour.
                        if editor.has-focus && editor.anchor-position-byte-offset == editor.cursor-position-byte-offset: Rectangle {
                            x: root.caret.x;
                            y: root.caret.y;
                            width: 2px;
                            height: root.caret-h;
                            background: Theme.accent;
                        }
                    }
                }
            }
            // Holds the words being copied for a moment; see the editor's key-pressed.
            clip-buf := TextInput {
                x: 0;
                y: 0;
                width: 20px;
                height: 20px;
                color: transparent;
                read-only: true;
            }
            }
            if root.transcript != "" && !root.transcribing && !root.editing: Scroller {
                vertical-stretch: 1;
                // A new transcript starts at the top; Slint would keep the old offset.
                property <string> shown: root.transcript;
                init => { self.content-y = 0; }
                changed shown => { self.content-y = 0; }
                FlexboxLayout {
                    spacing: 1px;
                    flex-wrap: wrap;
                    alignment: start;
                    for w[i] in root.words: Rectangle {
                        // Plain view: pauses take no room at all.
                        property <bool> hidden: w.is-silence && !root.show-marks;
                        property <bool> marks: root.show-marks;
                        visible: !hidden;
                        horizontal-stretch: 0;
                        border-radius: 3px;
                        background: i == root.current-word ? Theme.accent : wt.has-hover ? Theme.raised : transparent;
                        width: hidden ? 0 : label.preferred-width + 6px;
                        height: hidden ? 0 : label.preferred-height + 4px;
                        label := Text {
                            text: w.text;
                            // Spoken words are generated speech: shown in a different colour.
                            color: i == root.current-word ? Theme.on-accent
                                : w.is-silence ? Theme.accent
                                : !marks ? Theme.text2
                                : w.failed ? Theme.danger
                                : w.pending ? Theme.faint
                                : w.spoken ? Theme.accent
                                : Theme.text2;
                            font-size: 15px;
                            font-italic: w.spoken && marks;
                        }
                        wt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.seek-word(i); }
                        }
                    }
                }
            }
        }
    // Holds the transcript for a moment while it is copied.
    copy-buf := TextInput {
        x: 0;
        y: 0;
        width: 20px;
        height: 20px;
        color: transparent;
        read-only: true;
    }
    copied-timer := Timer {
        interval: 1500ms;
        running: false;
        triggered => {
            root.copied = false;
            self.running = false;
        }
    }
}

export component AppWindow inherits Window {
    title: "Thrasher";
    in property <image> window-icon;
    icon: window-icon;
    background: compact ? transparent : Theme.bg;
    default-font-family: "Inter Tight";
    default-font-size: 13px;
    preferred-width: 520px;
    preferred-height: 600px;
    min-width: compact ? 240px : 420px;
    min-height: compact ? 124px : 480px;
    always-on-top: pinned || compact;
    no-frame: true;

    // Window size classes. A size never adds or removes options; it only rearranges
    // them (docs/plan.md section 14).
    property <bool> narrow: root.width < 470px;
    property <bool> wide: root.width >= 820px;
    // Only a tall window has room for the big recorder card above the list; other
    // portrait windows get the one-line recorder, so the list keeps its space.
    property <bool> tall: root.height >= 820px;

    // 0 clips, 1 one clip, 3 settings, 4 models, 5 merge (2 was the old edit page)
    in-out property <int> page;

    in-out property <bool> recording;
    in-out property <bool> paused;
    in property <string> elapsed: "00:00";
    in property <string> elapsed-tenth: ".0";
    in property <[float]> live;
    in property <string> device-label;
    in property <float> mic-level;
    in property <float> system-level;

    in property <[ClipRow]> clips;
    in-out property <int> selected: -1;
    // Clip loaded in the player (playing or paused), or -1.
    in property <int> active-clip: -1;
    in property <bool> playing;
    in property <float> play-fraction;
    in property <string> play-position: "0:00";
    in property <string> play-length: "0:00";
    in-out property <int> speed-index: 1;
    // The transcript shows pauses and the marks for edited and spoken words.
    in-out property <bool> show-marks: true;
    in-out property <bool> looping;
    in property <[float]> detail-wave;
    in property <string> detail-meta;

    in-out property <string> status;
    in property <bool> can-transcribe;
    in property <bool> transcribing;
    in property <float> transcribe-progress;
    in-out property <bool> speaking;
    in property <float> speak-progress;
    in property <string> speak-stage;
    in property <string> transcript;
    in property <[WordRow]> words;
    in property <int> current-word: -1;
    in property <string> edit-badge;
    in property <string> edit-length;
    in property <string> edit-was;
    in-out property <bool> renaming;
    // A question in front of the page: 1 rename a clip, 2 confirm deleting it; which
    // clip, and the name being typed.
    // The projects (0 is Inbox) and the one shown.
    in property <[string]> projects: ["Inbox"];
    in property <int> project;
    callback choose-project(int);
    callback create-project(string);
    callback rename-project(string);
    callback delete-project();
    callback export-project();
    // Clip i moves to project p.
    callback move-clip(int, int);
    // Files are being dragged over the window.
    in property <bool> dropping;
    // 1 rename clip, 2 delete clip, 3 unsaved changes, 4 new project, 5 rename project.
    in-out property <int> dialog;
    in-out property <int> dialog-clip;
    in-out property <string> dialog-text;
    // The transcript as typed in the editor, to save or throw away when leaving it.
    in-out property <string> edit-draft;
    // The transcript is being edited in its card on the clip page; where to go once
    // the editor is left (-1: stay).
    in-out property <bool> editing;
    property <int> leave-to: -1;

    in property <[string]> mic-devices;
    in-out property <int> mic-index;
    in-out property <bool> record-system;
    in property <string> folder;
    in property <string> name-template;
    in property <string> name-preview;
    in-out property <int> export-format;
    in-out property <bool> clean-voice;
    in property <[string]> languages;
    in-out property <int> language-index;
    in property <[ModelRow]> models;
    in property <string> model-summary;
    in property <string> models-used;
    in property <int> model-count;
    in-out property <string> model-query;
    in-out property <int> model-filter;
    in-out property <bool> model-compressed;
    in property <bool> name-invalid;
    in property <[string]> hotkey-parts;
    in property <int> downloading: -1;
    in property <float> download-progress;
    in-out property <string> hotkey;
    in-out property <bool> close-to-tray: true;
    in property <[string]> recording-limits;
    in-out property <int> recording-limit-index: 2;
    in-out property <bool> start-with-windows;
    in-out property <bool> pinned;
    in-out property <bool> compact;
    in-out property <length> list-y;
    in-out property <length> list-height: 300px;

    callback toggle-record();
    callback toggle-pause();
    // Play or pause clip `i` from the list.
    callback play-clip(int);
    callback open-clip(int);
    // Play or pause the selected clip.
    callback toggle-play();
    callback seek-fraction(float);
    callback skip(float);
    callback speed-changed(int);
    callback stop-playback();
    callback delete-selected();
    callback delete-last();
    callback rename-selected(string);
    callback mic-changed(int);
    callback system-changed(bool);
    callback pinned-changed(bool);
    callback compact-changed(bool);
    callback open-folder();
    callback change-folder();
    // See ExportButton for the kinds.
    callback export-as(int);
    // Clip i at a point of its length (0..1): cue puts it there without playing,
    // play-clip-at plays from there.
    callback cue-clip(int, float);
    callback play-clip-at(int, float);
    // Picking clips: a click, Ctrl+click (add or remove) or Shift+click (a range).
    in property <[bool]> picked;
    in property <int> picked-count;
    callback pick(int, bool, bool);
    // The merge page: the picked clips in merge order, and the new clip's name.
    in property <[OrderRow]> merge-rows;
    in-out property <string> merge-name;
    in property <bool> merging;
    callback start-merge();
    callback merge-move(int, int);
    callback merge-remove(int);
    callback merge-play(int);
    callback merge-run(string);
    // A merge finished: the status line and the new clip's name (empty on failure).
    callback merged(string, string);
    // A merged clip's parts, shown on its page; empty for an ordinary clip.
    in property <[OrderRow]> parts;
    in property <bool> parts-busy;
    callback parts-move(int, int);
    callback part-take-out(int);
    // Reordering or taking out a part finished, with the status line.
    callback parts-done(string);
    // Asks for audio files and adds each as a clip; `imported` reports back.
    callback import-files();
    // The status line, the last clip, and every new clip (one per line).
    callback imported(string, string, string);
    // A transcription run ended: whether it worked, and the line to show.
    callback transcribed(bool, string);
    in-out property <bool> auto-transcribe;
    callback auto-transcribe-changed(bool);
    // Longer pauses are shortened to this after each transcription.
    in property <[string]> max-pauses;
    in-out property <int> max-pause-index;
    callback max-pause-changed(int);
    // The transcript editor's text as styled text, with the pause tags coloured.
    pure callback edit-markup(string) -> styled-text;
    // The selected part of the editor text (two byte offsets) without pause tags.
    pure callback plain-selection(string, int, int) -> string;
    // Starts resizing the window from an edge: 0 top, 1 bottom, 2 right, 3 left,
    // 4 top right, 5 top left, 6 bottom right, 7 bottom left.
    callback resize-window(int);
    callback transcribe-selected();
    callback selection-changed(int);
    callback edit-changed(string);
    callback apply-transcript(string);
    // A saved edit was baked: refresh the clip list. The argument is its name.
    callback library-changed(string);
    callback cancel-speaking();
    callback seek-word(int);
    callback export-format-changed(int);
    callback clean-voice-changed(bool);
    callback language-changed(int);
    callback template-edited(string);
    callback template-accepted(string);
    callback hotkey-accepted(string);
    callback close-to-tray-changed(bool);
    callback recording-limit-changed(int);
    // Settings picked theme i of Theme.names.
    callback theme-changed(int);
    callback start-with-windows-changed(bool);
    callback download-model(int);
    // The model page's search, chips or compressed toggle changed.
    callback models-filter-changed();
    // A key pressed in the shortcut box, with Ctrl, Alt, Shift and Win. True when it
    // made a shortcut.
    callback hotkey-captured(string, bool, bool, bool, bool) -> bool;
    callback minimize-window();
    callback close-window();
    callback cancel-download();
    callback use-model(int);
    // Clip waveforms finished drawing in the background.
    callback waves-ready();
    callback quit();

    changed selected => { root.selection-changed(root.selected); }

    // Status messages fade out after a while.
    status-timer := Timer {
        interval: 8s;
        running: false;
        triggered => { self.running = false; root.status = ""; }
    }
    // Saving from the editor leaves it, so its unsaved-changes question goes too.
    changed page => {
        Tips.hide();
        if (root.dialog == 3) { root.dialog = 0; }
    }
    // Saving ends editing, so its unsaved-changes question goes too.
    changed editing => { if (!root.editing && root.dialog == 3) { root.dialog = 0; } }
    changed status => { status-timer.running = false; status-timer.running = root.status != ""; }

    function move-selection(delta: int) {
        if (clips.length == 0) { return; }
        selected = clamp(selected < 0 ? clips.length - 1 : selected + delta, 0, clips.length - 1);
        if (selected * 54px < -list-y) {
            list-y = -(selected * 54px);
        } else if ((selected + 1) * 54px > -list-y + list-height) {
            list-y = -((selected + 1) * 54px - list-height);
        }
    }

    // Keeps the list from staying scrolled past its end after it shrinks (a delete).
    function clamp-list() {
        list-y = clamp(list-y, min(0px, list-height - clips.length * 54px), 0px);
    }

    function ask-rename(i: int) {
        root.dialog-clip = i;
        root.dialog-text = root.clips[i].name;
        root.dialog = 1;
    }
    function ask-delete(i: int) {
        root.dialog-clip = i;
        root.dialog = 2;
        keys.focus();
    }
    function start-edit() {
        root.stop-playback();
        root.edit-draft = root.transcript;
        root.editing = true;
        root.edit-changed(root.transcript);
    }
    // Leaving the editor with changes asks whether to save them (dialog 3); then it
    // goes to page `to` (-1 stays on the clip).
    function leave-editor(to: int) {
        root.leave-to = to;
        if (root.edit-draft == root.transcript || root.speaking) {
            root.editing = false;
            if (to >= 0) { root.go(to); }
        } else {
            root.dialog-clip = root.selected;
            root.dialog = 3;
            keys.focus();
        }
    }
    function discard-edit() {
        root.dialog = 0;
        root.edit-draft = root.transcript;
        root.editing = false;
        if (root.leave-to >= 0) { root.go(root.leave-to); }
        keys.focus();
    }
    function close-dialog() {
        root.dialog = 0;
        keys.focus();
    }
    function confirm-dialog() {
        let kind = root.dialog;
        root.dialog = 0;
        if (kind == 4) {
            root.create-project(root.dialog-text);
        } else if (kind == 5) {
            root.rename-project(root.dialog-text);
        } else {
            root.selected = root.dialog-clip;
        }
        if (kind == 1) {
            root.rename-selected(root.dialog-text);
        } else if (kind == 2) {
            root.delete-selected();
            if (root.page != 0) { root.go(0); }
        } else if (kind == 3) {
            root.apply-transcript(root.edit-draft);
            if (root.leave-to >= 0) { root.go(root.leave-to); }
        }
        keys.focus();
    }

    function go(p: int) {
        root.renaming = false;
        root.editing = false;
        root.page = p;
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (root.dialog != 0) {
                if (event.text == Key.Escape) { root.close-dialog(); }
                if (event.text == Key.Return && root.dialog == 2) { root.confirm-dialog(); }
                return accept;
            }
            if (renaming) { return reject; }
            if (root.editing) {
                if (event.text == Key.Escape) { root.leave-editor(-1); return accept; }
                return reject;
            }
            if (event.text == Key.Escape) {
                if (page != 0) { root.go(page == 4 ? 3 : 0); } else { root.stop-playback(); root.pick(-1, false, false); }
                return accept;
            }
            if (page >= 3) { return reject; }
            // Space plays and pauses the highlighted clip; with none highlighted, or
            // while recording, it records.
            if (event.text == " ") {
                if (recording || compact || selected < 0) { root.toggle-record(); }
                else if (page == 1) { root.toggle-play(); }
                else { root.play-clip(selected); }
                return accept;
            }
            if (event.text == "p" && recording) { root.toggle-pause(); return accept; }
            if (page == 1) {
                if (event.text == Key.Return) { root.toggle-play(); return accept; }
                if (event.text == Key.LeftArrow) { root.skip(-5); return accept; }
                if (event.text == Key.RightArrow) { root.skip(5); return accept; }
                if (event.text == Key.F2) { root.renaming = true; return accept; }
                return reject;
            }
            if (event.text == Key.Return) { if (selected >= 0) { root.play-clip(selected); } return accept; }
            if (event.text == Key.RightArrow && selected >= 0) { root.open-clip(selected); root.go(1); return accept; }
            if (event.text == Key.Delete) { if (selected >= 0) { root.ask-delete(selected); } return accept; }
            if (event.text == Key.Backspace) { if (clips.length > 0) { root.ask-delete(clips.length - 1); } return accept; }
            if (event.text == Key.F2) { if (selected >= 0) { root.ask-rename(selected); } return accept; }
            if (event.text == Key.UpArrow) { root.move-selection(-1); return accept; }
            if (event.text == Key.DownArrow) { root.move-selection(1); return accept; }
            reject
        }

        // ---------- Widget ----------
        // The widget: status with open window, the time with pause and record, and
        // the live level.
        if compact: Rectangle {
            background: Theme.card;
            border-radius: 18px;
            border-width: 1px;
            border-color: root.recording ? Theme.accent : Theme.border;
            WindowMoveArea {
                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 14px;
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3.5px;
                            background: root.recording ? Theme.accent : Theme.wave-dim;
                        }
                        Text {
                            text: root.recording ? (root.paused ? "PAUSED" : "RECORDING") : "READY";
                            color: root.recording ? Theme.accent : Theme.muted;
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconBtn {
                            size: 26px;
                            round: true;
                            icon: "expand";
                            icon-size: 11px;
                            label: "Open the window";
                            tip: "Open window";
                            clicked => { root.compact-changed(false); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.elapsed;
                            color: root.recording ? Theme.text : Theme.text2;
                            font-family: Theme.mono;
                            font-size: 30px;
                            letter-spacing: -1px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.recording: VerticalLayout {
                            alignment: center;
                            IconBtn {
                                size: 36px;
                                round: true;
                                outlined: true;
                                icon: root.paused ? "play" : "pause";
                                icon-size: 12px;
                                tint: Theme.text;
                                label: root.paused ? "Resume" : "Pause";
                                clicked => { root.toggle-pause(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconBtn {
                                size: 44px;
                                round: true;
                                filled: true;
                                icon: root.recording ? "stop" : "mic";
                                icon-size: root.recording ? 15px : 20px;
                                label: root.recording ? "Stop recording" : "Record";
                                tip: root.recording ? "Stop" : "Record";
                                clicked => { root.toggle-record(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-right: 6px;
                        Wave {
                            height: 14px;
                            gap: 1px;
                            values: root.live;
                            progress: root.recording ? 2 : -1;
                            rest: Theme.track;
                        }
                    }
                }
            }
        }

        // ---------- Clips (main) ----------
        if !compact && page == 0: VerticalLayout {
            TitleBar {
                height: 38px;
                left-padding: 18px;
                fill: false;
                minimize => { root.minimize-window(); }
                close => { root.close-window(); }
                Text {
                    text: "Thrasher";
                    color: Theme.muted;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            // The side rail: clips and import at the top, then keep on top, the widget
            // and settings at the bottom.
            HorizontalLayout {
                vertical-stretch: 1;
                Rectangle {
                    width: 52px;
                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 10px;
                        spacing: 4px;
                        HorizontalLayout { alignment: center; RailBtn { icon: "list"; label: "Clips"; current: true; clicked => { keys.focus(); } } }
                        HorizontalLayout {
                            alignment: center;
                            RailBtn {
                                icon: "file-plus";
                                label: "Import audio or video";
                                tip: "Import";
                                enabled: !root.recording;
                                clicked => { root.import-files(); }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                        HorizontalLayout {
                            alignment: center;
                            RailBtn {
                                icon: "pushpin";
                                label: "Keep on top";
                                on: root.pinned;
                                clicked => { root.pinned = !root.pinned; root.pinned-changed(root.pinned); }
                            }
                        }
                        HorizontalLayout { alignment: center; RailBtn { icon: "pip"; label: "Small widget"; clicked => { root.compact-changed(true); } } }
                        HorizontalLayout { alignment: center; RailBtn { icon: "cog"; label: "Settings"; clicked => { root.go(3); } } }
                    }
                    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
                }
                body := FlexboxLayout {
                    // Wide: the recorder beside the list. Otherwise above it.
                    flex-direction: root.wide ? FlexboxLayoutDirection.row : FlexboxLayoutDirection.column;
                    flex-wrap: no-wrap;
                    alignment: stretch;
                    cross-axis-alignment: stretch;
                    vertical-stretch: 1;
                    spacing: root.wide ? 20px : 0;
                    padding-left: root.wide ? 18px : 0;
                    padding-right: root.wide ? 6px : 0;
                    padding-bottom: root.wide ? 16px : 0;
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        min-width: root.wide ? 380px : 0;
                        max-width: root.wide ? 380px : 100000px;
                        padding-left: root.wide ? 0 : root.narrow ? 12px : 16px;
                        padding-right: root.wide ? 0 : root.narrow ? 12px : 16px;
                        padding-top: root.wide ? 4px : 0;
                        RecorderCard {
                            mode: root.wide ? 2 : root.tall && !root.narrow ? 1 : 0;
                            recording: root.recording;
                            paused: root.paused;
                            device-label: root.device-label;
                            elapsed: root.elapsed;
                            elapsed-tenth: root.elapsed-tenth;
                            live: root.live;
                            record => { root.toggle-record(); keys.focus(); }
                            pause => { root.toggle-pause(); keys.focus(); }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;


                HorizontalLayout {
                    padding-left: root.wide ? 10px : root.narrow ? 18px : 22px;
                    padding-right: root.wide ? 14px : root.narrow ? 18px : 22px;
                    padding-top: root.wide ? 6px : 18px;
                    padding-bottom: 8px;
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        ProjectPicker {
                            x: -8px;
                            projects: root.projects;
                            current: root.project;
                            enabled: !root.recording;
                            has-clips: root.clips.length > 0;
                            choose(i) => { root.choose-project(i); keys.focus(); }
                            create => { root.dialog-text = ""; root.dialog = 4; }
                            rename => { root.dialog-text = root.projects[root.project]; root.dialog = 5; }
                            delete => { root.delete-project(); keys.focus(); }
                            export => { root.export-project(); keys.focus(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // Several clips picked: offer to merge them.
                    if root.picked-count >= 2: Text {
                        text: root.picked-count + " picked";
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if root.picked-count >= 2: VerticalLayout {
                        alignment: center;
                        Btn {
                            text: "Merge";
                            primary: true;
                            height: 28px;
                            font-size: 12px;
                            clicked => { root.start-merge(); root.go(5); }
                        }
                    }
                    if root.picked-count >= 2: VerticalLayout {
                        alignment: center;
                        Btn {
                            text: "Clear";
                            height: 28px;
                            font-size: 12px;
                            clicked => { root.pick(root.selected, false, false); keys.focus(); }
                        }
                    }
                }

                Scroller {
                    vertical-stretch: 1;
                    content-y <=> root.list-y;
                    property <int> count: root.clips.length;
                    init => { root.list-height = self.visible-height; root.clamp-list(); }
                    changed visible-height => { root.list-height = self.visible-height; root.clamp-list(); }
                    changed count => { root.clamp-list(); }
                    VerticalLayout {
                    alignment: start;
                    for clip[i] in root.clips: HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 2px;
                        ClipItem {
                            item: clip;
                            wave-width: root.narrow ? 0 : root.wide ? 160px : 84px;
                            selected: i == root.selected;
                            picked: root.picked[i];
                            merge-count: root.picked[i] ? root.picked-count : 0;
                            active: i == root.active-clip;
                            playing: root.playing;
                            progress: root.play-fraction;
                            play => { root.play-clip(i); keys.focus(); }
                            cue(f) => { root.cue-clip(i, f); keys.focus(); }
                            play-at(f) => { root.play-clip-at(i, f); keys.focus(); }
                            select(ctrl, shift) => { root.pick(i, ctrl, shift); keys.focus(); }
                            merge => { root.start-merge(); root.go(5); }
                            open => { root.open-clip(i); root.go(1); }
                            rename => { root.ask-rename(i); }
                            export(kind) => { root.selected = i; root.export-as(kind); keys.focus(); }
                            delete => { root.ask-delete(i); }
                            projects: root.projects;
                            project: root.project;
                            move-to(p) => { root.move-clip(i, p); keys.focus(); }
                        }
                    }
                    }
                }


                    }
                }
            }

            // Now playing: the clip in the player, else the highlighted one, else
            // nothing yet. The page's footer, across the whole window.
            now := Rectangle {
                property <int> shown: root.active-clip >= 0 && root.active-clip < root.clips.length ? root.active-clip
                    : root.selected >= 0 && root.selected < root.clips.length ? root.selected : -1;
                property <bool> is-active: self.shown >= 0 && self.shown == root.active-clip;
                vertical-stretch: 0;
                background: Theme.footer;
                height: 64px;
                Rectangle { y: 0; height: 1px; background: Theme.line; }
                HorizontalLayout {
                    padding-left: root.narrow ? 12px : 16px;
                    padding-right: root.narrow ? 14px : 20px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        IconBtn {
                            size: 40px;
                            round: true;
                            filled: true;
                            enabled: now.shown >= 0;
                            icon: now.is-active && root.playing ? "pause" : "play";
                            icon-size: 13px;
                            label: now.is-active && root.playing ? "Pause" : "Play";
                            clicked => { root.play-clip(now.shown); keys.focus(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: now.shown >= 0 ? root.clips[now.shown].name : "Nothing playing";
                                color: now.shown >= 0 ? Theme.text : Theme.dim;
                                font-size: 13px;
                                font-weight: 700;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: now.shown < 0 ? "--:-- / --:--"
                                    : (now.is-active ? root.play-position : "0:00") + " / " + root.clips[now.shown].duration;
                                color: Theme.muted;
                                font-family: Theme.mono;
                                font-size: 12px;
                            }
                        }
                        Rectangle {
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.track;
                            Rectangle {
                                x: 0;
                                width: parent.width * (now.is-active ? clamp(root.play-fraction, 0, 1) : 0);
                                border-radius: 2px;
                                background: Theme.accent;
                            }
                            // Click to jump; taller than the line so it is easy to hit.
                            TouchArea {
                                y: -8px;
                                height: parent.height + 16px;
                                enabled: now.shown >= 0;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected = now.shown;
                                    root.seek-fraction(self.mouse-x / self.width);
                                    keys.focus();
                                }
                            }
                        }
                    }
                }
            }

            // Messages float just above the footer, so nothing moves when they come
            // and go.
            Rectangle {
                height: 0;
                if root.status != "": Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: -64px - self.height - 8px;
                    width: min(msg.preferred-width + 24px, parent.width - 32px);
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.popup.with-alpha(0.95);
                    border-width: 1px;
                    border-color: Theme.popup-edge;
                    msg := Text {
                        text: root.status;
                        color: Theme.text2;
                        font-size: 12px;
                        overflow: elide;
                        x: 12px;
                        width: parent.width - 24px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // ---------- One clip ----------
        if !compact && page == 1 && root.selected >= 0: VerticalLayout {
            TitleBar {
                height: 38px;
                minimize => { root.minimize-window(); }
                close => { root.close-window(); }
                BackLink {
                    text: "Clips";
                    y: (parent.height - self.height) / 2;
                    clicked => { if (root.editing) { root.leave-editor(0); } else { root.go(0); } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
            vertical-stretch: 1;
            spacing: 2px;
            padding-right: root.wide ? 18px : 0;
            Scroller {
            vertical-stretch: 1;
            min-width: root.wide ? 460px : 50px;
            max-width: root.wide ? 460px : 100000px;
            VerticalLayout {
            alignment: start;
            padding-bottom: 8px;
            VerticalLayout {
                vertical-stretch: 0;
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 4px;
                spacing: 4px;
                if !root.renaming: HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.clips[root.selected].name;
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 800;
                        letter-spacing: -0.4px;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        IconBtn {
                            icon: "pencil";
                            label: "Rename clip";
                            tip: "Rename";
                            enabled: !root.recording;
                            clicked => { root.renaming = true; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconBtn {
                            icon: "trash";
                            label: "Delete clip";
                            tip: "Delete";
                            icon-size: 15px;
                            enabled: !root.recording;
                            clicked => { root.ask-delete(root.selected); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.renaming: HorizontalLayout {
                    spacing: 6px;
                    name-edit := LineEdit {
                        text: root.clips[root.selected].name;
                        font-size: 15px;
                        accepted(t) => { root.renaming = false; root.rename-selected(t); keys.focus(); }
                        init => { self.focus(); self.select-all(); }
                    }
                    Btn {
                        text: "Rename";
                        primary: true;
                        clicked => { root.renaming = false; root.rename-selected(name-edit.text); keys.focus(); }
                    }
                    Btn {
                        text: "Cancel";
                        clicked => { root.renaming = false; keys.focus(); }
                    }
                }
                Text {
                    text: root.detail-meta;
                    color: Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                }
            }

            // Player
            HorizontalLayout {
                vertical-stretch: 0;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 16px;
                Rectangle {
                    background: Theme.card;
                    border-radius: 14px;
                    VerticalLayout {
                        padding: 18px;
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 12px;
                        wave-box := Rectangle {
                            height: root.narrow ? 36px : 64px;
                            Wave {
                                values: root.detail-wave;
                                progress: root.active-clip == root.selected ? root.play-fraction : 0;
                                rest: Theme.wave-dim;
                            }
                            if root.active-clip == root.selected: Rectangle {
                                x: clamp(root.play-fraction, 0, 1) * (parent.width - 2px);
                                y: -4px;
                                width: 2px;
                                height: parent.height + 8px;
                                border-radius: 1px;
                                background: Theme.text;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.seek-fraction(self.mouse-x / self.width); keys.focus(); }
                            }
                        }
                        if !root.narrow: HorizontalLayout {
                            Text {
                                text: root.active-clip == root.selected ? root.play-position : "0:00";
                                color: Theme.muted;
                                font-family: Theme.mono;
                                font-size: 11px;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.clips[root.selected].duration;
                                color: Theme.muted;
                                font-family: Theme.mono;
                                font-size: 11px;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 36px;
                                    round: true;
                                    outlined: true;
                                    icon: "rewind";
                                    icon-size: 22px;
                                    tint: Theme.text;
                                    label: "Back 5 seconds";
                                    tip: "Back 5 seconds";
                                    clicked => { root.skip(-5); keys.focus(); }
                                    Text {
                                        text: "5";
                                        color: Theme.text;
                                        font-size: 8px;
                                        font-weight: 800;
                                        y: 13.5px;
                                    }
                                }
                            }
                            IconBtn {
                                size: 44px;
                                round: true;
                                filled: true;
                                icon: root.active-clip == root.selected && root.playing ? "pause" : "play";
                                icon-size: 14px;
                                label: root.active-clip == root.selected && root.playing ? "Pause" : "Play";
                                clicked => { root.toggle-play(); keys.focus(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 36px;
                                    round: true;
                                    outlined: true;
                                    icon: "forward";
                                    icon-size: 22px;
                                    tint: Theme.text;
                                    label: "Forward 5 seconds";
                                    clicked => { root.skip(5); keys.focus(); }
                                    Text {
                                        text: "5";
                                        color: Theme.text;
                                        font-size: 8px;
                                        font-weight: 800;
                                        y: 13.5px;
                                    }
                                }
                            }
                            if root.narrow: Text {
                                text: (root.active-clip == root.selected ? root.play-position : "0:00") + " / " + root.clips[root.selected].duration;
                                color: Theme.muted;
                                font-family: Theme.mono;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    width: 86px;
                                    height: 30px;
                                    label: "Speed";
                                    model: ["0.75×", "1.0×", "1.25×", "1.5×", "2.0×"];
                                    current-index <=> root.speed-index;
                                    selected(i) => { root.speed-changed(i); keys.focus(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    text: "Loop";
                                    height: 30px;
                                    font-size: 12px;
                                    on: root.looping;
                                    clicked => { root.looping = !root.looping; keys.focus(); }
                                }
                            }
                        }
                    }
                }
            }

            // Transcript (on wide windows it has its own column instead)
            if !root.wide: HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                TranscriptCard {
                    transcript: root.transcript;
                    transcribing: root.transcribing;
                    transcribe-progress: root.transcribe-progress;
                    words: root.words;
                    current-word: root.current-word;
                    show-marks <=> root.show-marks;
                    can-transcribe: root.can-transcribe;
                    recording: root.recording;
                    editing: root.editing;
                    edit-draft <=> root.edit-draft;
                    edit-badge: root.edit-badge;
                    speaking: root.speaking;
                    edit => { root.start-edit(); }
                    edited(t) => { root.edit-changed(t); }
                    cancel => { root.leave-editor(-1); }
                    save => { root.apply-transcript(root.edit-draft); }
                    edit-markup(t) => { return root.edit-markup(t); }
                    plain-selection(t, a, b) => { return root.plain-selection(t, a, b); }
                    transcribe => { root.transcribe-selected(); keys.focus(); }
                    seek-word(i) => { root.seek-word(i); keys.focus(); }
                    height: root.transcript != "" && !root.transcribing ? 170px : self.preferred-height;
                }
            }

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 18px;
                if root.parts.length >= 2: VerticalLayout {
                    padding-bottom: 18px;
                    Card {
                        title: root.parts-busy ? "PARTS  ·  WORKING..." : "PARTS";
                        VerticalLayout {
                            padding: 4px;
                            OrderList {
                                rows: root.parts;
                                action: "Take out";
                                enabled: !root.parts-busy && !root.recording;
                                moved(a, b) => { root.parts-move(a, b); }
                                act(i) => { root.part-take-out(i); }
                            }
                        }
                    }
                }
                Card {
                    title: "OPTIONS";
                    CardRow {
                        label: "Clean voice on export";
                        note: "Less noise";
                        last: true;
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                label: "Clean voice on export";
                                checked <=> root.clean-voice;
                                toggled(on) => { root.clean-voice-changed(on); }
                            }
                        }
                    }
                }
            }
            }
            }

            if root.wide: VerticalLayout {
                horizontal-stretch: 1;
                padding-top: 16px;
                TranscriptCard {
                    transcript: root.transcript;
                    transcribing: root.transcribing;
                    transcribe-progress: root.transcribe-progress;
                    words: root.words;
                    current-word: root.current-word;
                    show-marks <=> root.show-marks;
                    can-transcribe: root.can-transcribe;
                    recording: root.recording;
                    editing: root.editing;
                    edit-draft <=> root.edit-draft;
                    edit-badge: root.edit-badge;
                    speaking: root.speaking;
                    edit => { root.start-edit(); }
                    edited(t) => { root.edit-changed(t); }
                    cancel => { root.leave-editor(-1); }
                    save => { root.apply-transcript(root.edit-draft); }
                    edit-markup(t) => { return root.edit-markup(t); }
                    plain-selection(t, a, b) => { return root.plain-selection(t, a, b); }
                    transcribe => { root.transcribe-selected(); keys.focus(); }
                    seek-word(i) => { root.seek-word(i); keys.focus(); }
                    vertical-stretch: 1;
                }
            }
            }

            HorizontalLayout {
                vertical-stretch: 0;
                padding: 16px;
                padding-top: 12px;
                padding-bottom: 14px;
                spacing: 6px;
                Rectangle { horizontal-stretch: 1; }
                ExportButton {
                    format: root.export-format;
                    subtitles: root.transcript != "";
                    export(kind) => { root.export-as(kind); keys.focus(); }
                }
            }
            if root.status != "": Text {
                text: root.status;
                color: Theme.dim;
                font-size: 11px;
                overflow: elide;
                x: 22px;
                width: parent.width - 44px;
                height: 24px;
                vertical-alignment: center;
            }
        }

        // ---------- Settings ----------
        if !compact && page == 3: VerticalLayout {
            TitleBar {
                minimize => { root.minimize-window(); }
                close => { root.close-window(); }
            }
            PageHeader { title: "Settings"; back => { root.go(0); } }
            Scroller {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 12px;
                    padding-bottom: 20px;
                    spacing: 18px;
                    alignment: start;

                    FlexboxLayout {
                    flex-direction: root.wide ? FlexboxLayoutDirection.row : FlexboxLayoutDirection.column;
                    flex-wrap: no-wrap;
                    alignment: stretch;
                    cross-axis-alignment: root.wide ? CrossAxisAlignment.start : CrossAxisAlignment.stretch;
                    spacing: 18px;
                    VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 18px;
                    Card {
                        title: "RECORDING";
                        CardRow {
                            label: "Microphone";
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Microphone";
                                    model: root.mic-devices;
                                    current-index <=> root.mic-index;
                                    enabled: !root.recording;
                                    selected(i) => { root.mic-changed(i); }
                                }
                            }
                        }
                        CardRow {
                            label: "System audio";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "System audio";
                                    checked <=> root.record-system;
                                    toggled(on) => { root.system-changed(on); }
                                }
                            }
                        }
                        CardRow {
                            label: "Stop recording after";
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Stop recording after";
                                    model: root.recording-limits;
                                    current-index <=> root.recording-limit-index;
                                    selected(i) => { root.recording-limit-changed(i); }
                                }
                            }
                        }
                        CardRow {
                            label: "Clean voice on export";
                            last: true;
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Clean voice on export";
                                    checked <=> root.clean-voice;
                                    toggled(on) => { root.clean-voice-changed(on); }
                                }
                            }
                        }
                    }

                    Card {
                        title: "OUTPUT";
                        CardRow {
                            label: "Folder";
                            Text {
                                text: root.folder;
                                color: Theme.muted;
                                font-family: Theme.mono;
                                font-size: 12px;
                                overflow: elide;
                                max-width: 190px;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 32px;
                                    icon: "folder";
                                    label: "Open the folder";
                                    tip: "Open folder";
                                    tint: Theme.text2;
                                    clicked => { root.open-folder(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn { text: "Change"; height: 32px; font-size: 12px; enabled: !root.recording; clicked => { root.change-folder(); } }
                            }
                        }
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 6px;
                            Text { text: "File name"; color: Theme.text; font-size: 14px; }
                            TextField {
                                label: "File name";
                                mono: true;
                                text: root.name-template;
                                invalid: root.name-invalid;
                                edited(t) => { root.template-edited(t); }
                                accepted(t) => { root.template-accepted(t); keys.focus(); }
                            }
                            Text {
                                text: root.name-preview;
                                color: root.name-invalid ? Theme.danger : Theme.dim;
                                font-size: 12px;
                                font-family: root.name-invalid ? "Inter Tight" : Theme.mono;
                                overflow: elide;
                            }
                        }
                        Rectangle { height: 1px; background: Theme.divider; }
                        CardRow {
                            label: "Export format";
                            last: true;
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Export format";
                                    model: ["FLAC", "WAV", "MP3"];
                                    current-index <=> root.export-format;
                                    selected(i) => { root.export-format-changed(i); }
                                }
                            }
                        }
                    }

                    }
                    VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 18px;
                    Card {
                        title: "TRANSCRIPTION";
                        if !root.can-transcribe: CardRow { label: "Not in this build"; last: true; }
                        if root.can-transcribe: CardRow {
                            label: "Language";
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Language";
                                    model: root.languages;
                                    current-index <=> root.language-index;
                                    selected(i) => { root.language-changed(i); }
                                }
                            }
                        }
                        if root.can-transcribe: CardRow {
                            label: "Auto transcribe";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Auto transcribe";
                                    checked <=> root.auto-transcribe;
                                    toggled(on) => { root.auto-transcribe-changed(on); }
                                }
                            }
                        }
                        if root.can-transcribe: CardRow {
                            label: "Max pause";
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Max pause";
                                    model: root.max-pauses;
                                    current-index <=> root.max-pause-index;
                                    selected(i) => { root.max-pause-changed(i); }
                                }
                            }
                        }
                        if root.can-transcribe: Rectangle {
                            height: model-row.preferred-height;
                            accessible-role: button;
                            accessible-label: "Browse models";
                            accessible-action-default => { root.go(4); }
                            model-touch := TouchArea { mouse-cursor: pointer; clicked => { root.go(4); } }
                            model-row := CardRow {
                                width: 100%;
                                label: "Model";
                                note: root.model-summary;
                                last: true;
                                Text { text: "Browse"; color: model-touch.has-hover ? Theme.accent-hover : Theme.accent; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                Icon { name: "chevron"; tint: Theme.muted; y: (parent.height - self.height) / 2; }
                            }
                        }
                    }

                    Card {
                        title: "YOUR VOICE";
                        CardRow {
                            label: "Voice engine";
                            Text { text: "OmniVoice"; color: Theme.text2; font-size: 13px; vertical-alignment: center; }
                        }
                        CardRow {
                            label: "Voice sample";
                            last: true;
                            Text { text: "20 s from the clip"; color: Theme.text2; font-size: 13px; vertical-alignment: center; }
                        }
                    }

                    Card {
                        title: "SHORTCUTS AND WINDOW";
                        CardRow {
                            label: "Record from any app";
                            VerticalLayout {
                                alignment: center;
                                ShortcutBox {
                                    label: "Record from any app";
                                    keys: root.hotkey-parts;
                                    captured(text, ctrl, alt, shift, meta) => { return root.hotkey-captured(text, ctrl, alt, shift, meta); }
                                    cleared => { root.hotkey-accepted(""); }
                                    done => { keys.focus(); }
                                }
                            }
                            if root.hotkey-parts.length > 0: VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 28px;
                                    icon: "close";
                                    icon-size: 11px;
                                    label: "Clear the shortcut";
                                    tip: "Clear shortcut";
                                    clicked => { root.hotkey-accepted(""); }
                                }
                            }
                        }
                        CardRow {
                            label: "Close button hides to tray";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Close button hides to tray";
                                    checked <=> root.close-to-tray;
                                    toggled(on) => { root.close-to-tray-changed(on); }
                                }
                            }
                        }
                        CardRow {
                            label: "Theme";
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Theme";
                                    model: Theme.names;
                                    current-index: Theme.current;
                                    selected(i) => { root.theme-changed(i); }
                                }
                            }
                        }
                        CardRow {
                            label: "Start with Windows";
                            last: true;
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Start with Windows";
                                    checked <=> root.start-with-windows;
                                    toggled(on) => { root.start-with-windows-changed(on); }
                                }
                            }
                        }
                    }
                    }
                    }
                }
            }
            if root.status != "": Text {
                text: root.status;
                color: Theme.dim;
                font-size: 11px;
                overflow: elide;
                x: 22px;
                width: parent.width - 44px;
                height: 28px;
                vertical-alignment: center;
            }
        }

        // ---------- Merge ----------
        if !compact && page == 5: VerticalLayout {
            TitleBar {
                minimize => { root.minimize-window(); }
                close => { root.close-window(); }
            }
            PageHeader { title: "Merge clips"; note: root.merge-rows.length + " clips"; back => { root.go(0); } }
            Scroller {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 12px;
                    spacing: 18px;
                    Card {
                        title: "ORDER";
                        VerticalLayout {
                            padding: 4px;
                            OrderList {
                                rows: root.merge-rows;
                                removable: true;
                                playable: true;
                                playing-name: root.active-clip >= 0 && root.active-clip < root.clips.length && root.playing ? root.clips[root.active-clip].name : "";
                                enabled: !root.merging;
                                moved(a, b) => { root.merge-move(a, b); }
                                act(i) => { root.merge-remove(i); }
                                play(i) => { root.merge-play(i); }
                            }
                        }
                    }
                    Card {
                        title: "NEW CLIP";
                        CardRow {
                            label: "Name";
                            last: true;
                            TextField {
                                width: 220px;
                                label: "Name of the merged clip";
                                text <=> root.merge-name;
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 0;
                padding: 16px;
                padding-top: 12px;
                padding-bottom: 14px;
                spacing: 6px;
                Rectangle { horizontal-stretch: 1; }
                Btn {
                    text: "Cancel";
                    clicked => { root.go(0); }
                }
                Btn {
                    primary: true;
                    text: root.merging ? "Merging..." : "Merge " + root.merge-rows.length + " clips";
                    enabled: !root.merging && root.merge-name != "";
                    clicked => { root.merge-run(root.merge-name); }
                }
            }
            if root.status != "": Text {
                text: root.status;
                color: Theme.dim;
                font-size: 11px;
                overflow: elide;
                x: 22px;
                width: parent.width - 44px;
                height: 28px;
                vertical-alignment: center;
            }
        }

        // ---------- Models ----------
        if !compact && page == 4: VerticalLayout {
            TitleBar {
                minimize => { root.minimize-window(); }
                close => { root.close-window(); }
            }
            PageHeader { title: "Models"; note: root.models-used; back => { root.go(3); } }
            VerticalLayout {
                vertical-stretch: 0;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                spacing: 12px;
                TextField {
                    icon: "search";
                    label: "Search models";
                    placeholder: "Search " + root.model-count + " models";
                    text <=> root.model-query;
                    edited => { root.models-filter-changed(); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for f[i] in ["All", "Norwegian", "Swedish", "English", "Downloaded"]: Chip {
                        text: f;
                        on: root.model-filter == i;
                        clicked => { root.model-filter = i; root.models-filter-changed(); }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: "Show compressed versions too";
                            checked <=> root.model-compressed;
                            toggled => { root.models-filter-changed(); }
                        }
                    }
                    Text {
                        text: "Show compressed";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
            Scroller {
                vertical-stretch: 1;
                VerticalLayout {
                alignment: start;
                padding-bottom: 12px;
                for m in root.models: VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    if m.header: HorizontalLayout {
                        padding-top: 18px;
                        padding-bottom: 6px;
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: m.title;
                            color: Theme.muted;
                            font-size: 11px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            horizontal-stretch: 1;
                        }
                        Text { text: m.by; color: Theme.dim; font-size: 11px; }
                    }
                    if !m.header: Rectangle {
                        background: Theme.card;
                        border-top-left-radius: m.first ? 14px : 0;
                        border-top-right-radius: m.first ? 14px : 0;
                        border-bottom-left-radius: m.last ? 14px : 0;
                        border-bottom-right-radius: m.last ? 14px : 0;
                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 5px;
                                    Text { text: m.title; color: Theme.text; font-size: 14px; font-weight: 500; overflow: elide; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Text { text: "Quality"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
                                        Meter { value: m.quality; y: (parent.height - self.height) / 2; }
                                        Rectangle { width: 6px; }
                                        Text { text: "Speed"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
                                        Meter { value: m.speed; y: (parent.height - self.height) / 2; }
                                        Rectangle { width: 6px; }
                                        Text { text: m.size; color: Theme.dim; font-family: Theme.mono; font-size: 11px; vertical-alignment: center; }
                                    }
                                }
                                if m.active: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: use-label.preferred-width + 20px;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: Theme.accent.with-alpha(0.14);
                                        use-label := Text { text: "In use"; color: Theme.accent; font-size: 12px; font-weight: 800; }
                                    }
                                }
                                if m.downloaded && !m.active: VerticalLayout {
                                    alignment: center;
                                    Btn { text: "Use"; height: 30px; font-size: 12px; clicked => { root.use-model(m.index); } }
                                }
                                if root.downloading == m.index: VerticalLayout {
                                    alignment: center;
                                    Btn { text: "Cancel"; height: 30px; font-size: 12px; clicked => { root.cancel-download(); } }
                                }
                                if !m.downloaded && root.downloading != m.index: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: dl.preferred-width + 24px;
                                        height: 30px;
                                        border-radius: 8px;
                                        background: dl-touch.has-hover && root.downloading < 0 ? Theme.press : Theme.hover;
                                        opacity: root.downloading < 0 ? 1 : 0.4;
                                        accessible-role: button;
                                        accessible-label: "Download " + m.title;
                                        accessible-action-default => { if (root.downloading < 0) { root.download-model(m.index); } }
                                        dl := Text { text: "Download"; color: Theme.text; font-size: 12px; }
                                        dl-touch := TouchArea {
                                            enabled: root.downloading < 0;
                                            mouse-cursor: pointer;
                                            clicked => { root.download-model(m.index); }
                                        }
                                    }
                                }
                            }
                            if root.downloading == m.index: HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    height: 4px;
                                    y: (parent.height - self.height) / 2;
                                    horizontal-stretch: 1;
                                    border-radius: 2px;
                                    background: Theme.track;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * clamp(root.download-progress, 0, 1);
                                        border-radius: 2px;
                                        background: Theme.accent;
                                    }
                                }
                                Text {
                                    text: round(root.download-progress * 100) + "%";
                                    color: Theme.text2;
                                    font-family: Theme.mono;
                                    font-size: 11px;
                                }
                            }
                        }
                        if !m.last: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.divider; }
                    }
                }
                }
            }
            if root.models.length == 0: Text {
                text: "No models match";
                color: Theme.dim;
                font-size: 13px;
                horizontal-alignment: center;
                height: 60px;
            }
            if root.status != "": Text {
                text: root.status;
                color: Theme.dim;
                font-size: 11px;
                overflow: elide;
                x: 22px;
                width: parent.width - 44px;
                height: 28px;
                vertical-alignment: center;
            }
        }

        // New words take a while to speak: cover the window so that is obvious.
        if root.speaking && !root.compact: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: #000000c8;
            TouchArea { }
            Rectangle {
                width: min(parent.width - 48px, 340px);
                height: card.preferred-height;
                background: Theme.card;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.edge;
                card := VerticalLayout {
                    padding: 22px;
                    spacing: 12px;
                    Text {
                        text: "Speaking new words";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 800;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.speak-stage;
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.track;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.speak-progress, 0, 1);
                            border-radius: 2px;
                            background: Theme.accent;
                        }
                    }
                    HorizontalLayout {
                        Text {
                            text: round(root.speak-progress * 100) + "%";
                            color: Theme.muted;
                            font-family: Theme.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Btn {
                            text: "Cancel";
                            clicked => { root.cancel-speaking(); }
                        }
                    }
                }
            }
        }
    }

    if !compact: Rectangle {
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-color: Theme.border;
    }

    init => { keys.focus(); Win.height = self.height; }
    changed height => { Win.height = self.height; }

    // Files dragged over the window: a drop imports them.
    if root.dropping && !root.compact: Rectangle {
        background: Theme.bg.with-alpha(0.88);
        Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
            border-radius: 16px;
            border-width: 2px;
            border-color: Theme.accent;
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    Icon { name: "file-plus"; tint: Theme.accent; width: 34px; height: 34px; }
                }
                Text {
                    text: "Drop to import";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
            }
        }
    }

    if root.dialog >= 4 || (root.dialog != 0 && root.dialog-clip >= 0 && root.dialog-clip < root.clips.length): Rectangle {
        background: #000000a6;
        // A click outside the box cancels.
        TouchArea { clicked => { root.close-dialog(); } }
        Rectangle {
            width: min(parent.width - 48px, 360px);
            height: box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 30px;
            background: Theme.card;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: #000000aa;
            TouchArea { }
            box := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text {
                    text: root.dialog == 1 ? "Rename clip" : root.dialog == 3 ? "Unsaved changes" : root.dialog == 4 ? "New project"
                        : root.dialog == 5 ? "Rename project" : "Delete " + root.clips[root.dialog-clip].name + "?";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 800;
                    overflow: elide;
                }
                if root.dialog == 3: Text {
                    text: "Leave without saving";
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if root.dialog == 2: Text {
                    text: "Goes to the Recycle Bin";
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if root.dialog == 1 || root.dialog >= 4: TextField {
                    label: root.dialog == 4 ? "Project name" : "New name";
                    text <=> root.dialog-text;
                    init => { self.grab(); }
                    accepted => { root.confirm-dialog(); }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Btn {
                        text: "Cancel";
                        clicked => { root.close-dialog(); }
                    }
                    if root.dialog == 3: Btn {
                        text: "Discard changes";
                        clicked => { root.discard-edit(); }
                    }
                    Btn {
                        primary: true;
                        text: root.dialog == 1 || root.dialog == 5 ? "Rename" : root.dialog == 3 ? "Save" : root.dialog == 4 ? "Create" : "Delete";
                        enabled: (root.dialog != 1 && root.dialog < 4) || root.dialog-text != "";
                        clicked => { root.confirm-dialog(); }
                    }
                }
            }
        }
    }

    // The tooltip, below the hovered button (above it near the bottom edge), kept
    // inside the window.
    Timer {
        interval: 550ms;
        running: Tips.wanted && !Tips.shown;
        triggered => { Tips.shown = true; }
    }
    if Tips.shown && Tips.text != "": Tip {
        text: Tips.text;
        x: clamp(Tips.at.x + Tips.w / 2 - self.width / 2, 6px, root.width - self.width - 6px);
        y: Tips.at.y + Tips.h + 6px + self.height > root.height - 6px ? Tips.at.y - self.height - 6px : Tips.at.y + Tips.h + 6px;
    }

    // The window has no frame, so its edges and corners resize it here.
    if !compact: ResizeEdge { direction: 0; x: 12px; y: 0; width: parent.width - 24px; height: 5px; mouse-cursor: ns-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 1; x: 12px; y: parent.height - 5px; width: parent.width - 24px; height: 5px; mouse-cursor: ns-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 2; x: parent.width - 5px; y: 12px; width: 5px; height: parent.height - 24px; mouse-cursor: ew-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 3; x: 0; y: 12px; width: 5px; height: parent.height - 24px; mouse-cursor: ew-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 4; x: parent.width - 12px; y: 0; width: 12px; height: 12px; mouse-cursor: nesw-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 5; x: 0; y: 0; width: 12px; height: 12px; mouse-cursor: nwse-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 6; x: parent.width - 12px; y: parent.height - 12px; width: 12px; height: 12px; mouse-cursor: nwse-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 7; x: 0; y: parent.height - 12px; width: 12px; height: 12px; mouse-cursor: nesw-resize; resize(d) => { root.resize-window(d); } }

}
