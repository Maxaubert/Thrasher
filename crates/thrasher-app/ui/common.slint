            }
            list := Flickable {
                x: Theme.tape ? 0 : Theme.os95 ? 1px : Theme.comic ? 3px : Theme.synth ? 4px : Theme.quest ? 9px : Theme.pocket ? 2px : 5px;
                y: Theme.tape ? 3px : Theme.pocket ? 4px : Theme.os95 ? 1px : Theme.comic ? 6px : Theme.synth ? 9px : Theme.quest ? 9px : 5px + Theme.menu-top;
                width: parent.width - (Theme.tape ? 0 : Theme.os95 ? 2px : Theme.comic ? 6px : Theme.synth ? 8px : Theme.quest ? 18px : Theme.pocket ? 4px : 10px);
                height: parent.height - (Theme.tape ? 6px : Theme.pocket ? 8px : Theme.os95 ? 2px : Theme.comic ? 12px : Theme.quest ? 18px : Theme.synth ? 18px : 10px + Theme.menu-top);
                content-height: root.model.length * root.row-h;
                for item[i] in root.model: Rectangle {
                    // Desktop 95: the row under the mouse is navy, else the current one.
                    property <bool> os-lit: root.os-hot >= 0 ? root.os-hot == i : i == root.current-index;
                    property <bool> hovering: it.has-hover;
                    changed hovering => {
                        if (self.hovering) { root.os-hot = i; } else if (root.os-hot == i) { root.os-hot = -1; }
                    }
                    y: i * root.row-h;
                    height: root.row-h;
                    property <bool> pk-hot: it.has-hover || i == root.current-index;
                    border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.answer || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.dash ? 8px : 6px;
                    background: Theme.pocket ? (self.pk-hot ? Pk.l3 : transparent)
                        : Theme.pinball ? (i == root.current-index || it.has-hover ? Pb.lit-row : transparent)
                        : Theme.phono ? (i == root.current-index || it.has-hover ? Pn.lit-row : transparent)
                        : Theme.cozy ? (i == root.current-index ? Cz.honey : it.has-hover ? Cz.hover : transparent)
                        : Theme.quest ? transparent : Theme.tape ? (i == root.current-index ? Deck.amber : it.has-hover ? #2a2a2d : transparent)
                        : Theme.answer ? (i == root.current-index || it.has-hover ? Am.lit : transparent)
                        : Theme.synth ? (i == root.current-index ? #ff5a1e : it.has-hover ? #232625 : transparent)
                        : Theme.os95 ? (self.os-lit ? Os.navy : transparent)
                        : Theme.comic ? (i == root.current-index ? Comic.yellow : it.has-hover ? Comic.wash : transparent)
                        : Theme.dash ? (i == root.current-index || it.has-hover ? #62d2ff1f : transparent)
                        : Theme.brick ? (self.os-lit ? Brick.ink : transparent)
                        : i == root.current-index ? Theme.hover : it.has-hover ? Theme.hover-soft : transparent;
                    if Theme.comic && i == root.current-index: Rectangle { x: 0; width: 4px; background: Comic.red; }
                    if Theme.cozy && i == root.current-index: Rectangle { x: 0; width: 3px; background: Cz.ember; }
                    if Theme.pinball && (i == root.current-index || it.has-hover): Rectangle { x: 0; width: 3px; background: Pb.plasma; }
                    if Theme.phono && (i == root.current-index || it.has-hover): PnPointer { x: 5px; y: (parent.height - 7px) / 2; }
                    if Theme.pocket && (it.has-hover || i == root.current-index): PkPx { x: 5px; y: (parent.height - self.height) / 2; s: 1; source: @image-url("skins/px-pocket/chev.png"); colorize: Pk.l0; }
                    // Quest Menu: the hovered row lit with the glove, the current one gold with a
                    // check.
                    if Theme.quest: Rectangle {
                        QLit { visible: it.has-hover; x: 0; y: 0; }
                        HorizontalLayout {
                            padding-left: 27px;
                            padding-right: 9px;
                            spacing: 8px;
                            Text {
                                text: item;
                                color: i == root.current-index ? Quest.gold : Quest.white;
                                font-family: Quest.font;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if i == root.current-index: QPx {
                                y: (parent.height - self.height) / 2;
                                source: @image-url("skins/px-quest/tick.png");
                                colorize: Quest.gold;
                            }
                        }
                    }
                    if Theme.answer && (i == root.current-index || it.has-hover): Rectangle { x: 0; y: 0; width: 3px; height: parent.height; background: Am.rec; }
                    if Theme.os95: Text {
                        x: 4px;
                        width: parent.width - 8px;
                        text: item;
                        color: parent.os-lit ? #ffffff : #000000;
                        font-family: Os.font;
                        font-size: 12.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if Theme.brick: brow := HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 8px;
                        spacing: 7px;
                        // One line inverted: the one under the mouse, else the current one (as Desktop 95).
                        property <bool> lit: parent.os-lit;
                        VerticalLayout {
                            alignment: center;
                            BrickNum { text: i + 1; lit: brow.lit; }
                        }
                        Text {
                            text: item;
                            color: brow.lit ? Brick.lcd1 : Brick.ink;
                            font-family: Brick.words;
                            font-size: 18px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if i == root.current-index: VerticalLayout {
                            alignment: center;
                            BrickPx { source: @image-url("skins/dv-brick/x-check.png"); tint: brow.lit ? Brick.lcd1 : Brick.ink; }
                        }
                    }
                    if !Theme.os95 && !Theme.quest && !Theme.brick: HorizontalLayout {
                        padding-left: Theme.pocket || Theme.phono ? 16px : 10px;
                        padding-right: Theme.phono ? 12px : 10px;
                        spacing: 8px;
                        Text {
                            text: Theme.tape ? item.to-uppercase() : item;
                            color: Theme.pocket ? (it.has-hover || i == root.current-index ? Pk.l0 : Pk.l3) : Theme.tape ? (i == root.current-index ? #2a1406 : #d9d3c6) : Theme.comic ? Comic.ink : Theme.synth ? (i == root.current-index ? #ffffff : #eef3ee)
                                : Theme.pinball ? (i == root.current-index ? Pb.name-sel : Pb.ink)
                                : Theme.phono ? (i == root.current-index ? Pn.wax : Pn.ink)
                                : Theme.cozy ? Cz.ink
                                : Theme.dash && i == root.current-index ? Theme.accent
                                : Theme.answer ? Am.ink
                                : i == root.current-index ? Theme.text : Theme.text2;
                            font-family: Theme.pocket ? Pk.big : Theme.tape || Theme.synth ? Theme.mono : Theme.comic ? "Comic Neue" : Theme.dash ? "Manrope" : Theme.answer ? "Courier Prime" : Theme.phono ? Pn.font : Theme.pinball ? Pb.font : Theme.cozy ? Cz.font : "Inter Tight";
                            font-weight: Theme.pocket ? 400 : Theme.tape || Theme.dash || Theme.comic || Theme.answer ? 700 : Theme.cozy ? 400 : Theme.phono ? 600 : Theme.synth ? 500 : 400;
                            letter-spacing: Theme.tape ? 1.4px : 0;
                            font-size: Theme.phono ? 15px : Theme.pinball ? 15px : Theme.pocket ? 20px : Theme.tape ? 10.5px : Theme.dash || Theme.answer ? 12.5px : Theme.synth ? 11.5px : 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if i == root.current-index && Theme.pocket: PkPx { y: (parent.height - self.height) / 2; source: @image-url("skins/px-pocket/tick.png"); colorize: Pk.l0; }
                        if i == root.current-index && !Theme.tape && !Theme.pocket && !Theme.brick: Icon {
                            name: "check";
                            tint: Theme.comic ? Comic.ink : Theme.answer ? Am.rec : Theme.synth ? #ffffff : Theme.phono ? Pn.ink : Theme.pinball ? Pb.plasma : Theme.cozy ? Cz.ink : Theme.accent;
                            width: 13px;
                            height: 13px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    it := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// A single-line text field in the Ember look, with an optional icon on the left.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> icon;
    in property <bool> mono;
    in property <bool> invalid;
    in property <string> label;
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted(string);
    // Esc calls `escaped` instead of reaching the window (the search field).
    in property <bool> takes-escape;
    callback escaped();
    // Raising it puts the cursor in the field (Ctrl+F).
    in property <int> focus-ticket;
    changed focus-ticket => { root.grab(); }
    // Its look, for skins; the defaults are the classic field. Brick Phone: an LCD field in
    // a 2px ink frame, a second ink frame round it while it has the cursor.
    in property <length> radius: Theme.brick ? 0 : 8px;
    in property <color> fill: Theme.brick ? #ffe6aa40 : Theme.field;
    in property <color> rest-edge: Theme.edge;
    in property <color> ink: Theme.text;
    in property <color> hint: Theme.brick ? Brick.ink2 : Theme.dim;
    in property <length> font-size: Theme.brick ? 18px : 13px;
    in property <string> family: Theme.brick ? Brick.words : root.mono ? Theme.mono : Theme.dash ? "Manrope" : "Inter Tight";
    // The placeholder in italics (the Phonograph's search).
    in property <bool> hint-italic;
    in property <length> side: 12px;
    // The selected text (Brick Phone inverts it on its LCD).
    in property <color> select-fill: Theme.accent.with-alpha(0.4);
    in property <color> select-ink: Theme.tape ? root.ink : Theme.text;
    // No focus ring or accent edge: the skin shows focus on its own frame (Desktop 95).
    in property <bool> bare-focus;
    // The edge and the ring while it has the cursor, for skins (the Quest Menu: gold).
    in property <color> focus-edge: Theme.accent;
    in property <color> focus-ring: Theme.brick ? Brick.ink : Theme.accent.with-alpha(0.16);
    // The width of its edge (the Quest Menu's ink field has a 3px rim).
    in property <length> edge-width: 1px;
    // The cursor is in it (a skin draws its own resting cursor otherwise).
    out property <bool> has-focus: input.has-focus;
    public function grab() {
        input.focus();
        input.select-all();
    }
    height: 36px;
    // Drawn in body, not on the root: a root opacity, visible, shadow or border makes
    // Slint inline the whole widget at every use (docs/device-themes.md, Generated code size).
    // No x, y or size: it fills the root and passes its children's layout constraints on.
    body := Rectangle {
        border-radius: root.radius;
        background: root.fill;
        border-width: Theme.brick ? 2px : root.edge-width;
        border-color: invalid ? Theme.danger : input.has-focus && !root.bare-focus ? root.focus-edge : root.rest-edge;
        opacity: enabled ? 1 : 0.45;
        if input.has-focus && (!root.invalid || Theme.brick) && !root.bare-focus: Rectangle {
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: root.radius + (Theme.brick ? 0 : 3px);
            border-width: Theme.brick ? 2px : 3px;
            border-color: root.focus-ring;
        }
        HorizontalLayout {
            padding-left: root.side;
            padding-right: root.side;
            spacing: 8px;
            if root.icon != "" && Theme.brick: VerticalLayout {
                alignment: center;
                BrickPx { source: BrickIcons.pick(root.icon); tint: root.ink; }
            }
            if root.icon != "" && !Theme.quest && !Theme.brick: Icon {
                name: root.icon;
                tint: root.hint;
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
            }
            // Quest Menu: the pixel icon.
            if root.icon != "" && Theme.quest: QPx {
                y: (parent.height - self.height) / 2;
                s: 2;
                source: QIcons.pick(root.icon);
                colorize: root.text == "" ? Quest.dim : Quest.grey;
            }
            Rectangle {
                horizontal-stretch: 1;
                if root.text == "": Text {
                    width: 100%;
                    height: 100%;
                    text: root.placeholder;
                    color: root.hint;
                    font-size: root.font-size;
                    font-family: root.family;
                    font-italic: root.hint-italic;
                    vertical-alignment: center;
                    overflow: elide;
                }
                input := TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.text;
                    enabled: root.enabled;
                    single-line: true;
                    vertical-alignment: center;
                    color: root.ink;
                    font-size: root.font-size;
                    font-family: root.family;
                    selection-background-color: root.select-fill;
                    selection-foreground-color: root.select-ink;
                    accessible-label: root.label;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(self.text); }
                    key-pressed(e) => {
                        if (root.takes-escape && e.text == Key.Escape) {
                            root.escaped();
                            return accept;
                        }
                        reject
                    }
                }
            }
        }
        // Children given at a use site are drawn (and faded) with the rest, as before.
        @children
    }
}

// A source under an answer: its number, clip and time, and its words.
export component SourceRow inherits Rectangle {
    in property <AskSource> source;
    in property <bool> show-project;
    in property <string> project;
    callback clicked;
    height: 56px;
    border-radius: 10px;
    background: t.has-hover ? Theme.row-hover : transparent;
    accessible-role: button;
    accessible-label: root.source.n + " " + root.source.clip + " " + root.source.time;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 12px;
        Text {
            text: root.source.n;
            color: Theme.accent;
            font-family: Theme.mono;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            width: 16px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.source.clip; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                if root.show-project: Text { text: root.project; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
                Text { text: root.source.time; color: Theme.muted; font-family: Theme.mono; font-size: 11px; vertical-alignment: center; }
            }
            Text { text: root.source.text; color: Theme.dim; font-size: 12px; overflow: elide; }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One search result: the clip name (and project), then the words around the match
// with the match in the accent colour.
export component SearchRow inherits Rectangle {
    in property <SearchHit> hit;
    in property <bool> show-project;
    callback clicked;
    height: 52px;
    border-radius: 10px;
    background: t.has-hover ? Theme.row-hover : transparent;
    accessible-role: button;
    accessible-label: root.hit.clip + ", " + root.hit.before + " " + root.hit.matched + " " + root.hit.after;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.hit.clip;
                color: Theme.text;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.show-project: Text {
                text: root.hit.project;
                color: Theme.dim;
                font-size: 11px;
                vertical-alignment: center;
            }
            if root.hit.more > 0: Text {
                text: "+" + root.hit.more;
                color: Theme.dim;
                font-size: 11px;
                font-family: Theme.mono;
                vertical-alignment: center;
            }
        }
        if root.hit.matched != "": HorizontalLayout {
            spacing: 4px;
            if root.hit.before != "": Text {
                text: root.hit.before;
                color: Theme.dim;
                font-size: 12px;
                horizontal-stretch: 0;
            }
            Text {
                text: root.hit.matched;
                color: Theme.accent;
                font-size: 12px;
                font-weight: 700;
                horizontal-stretch: 0;
            }
            Text {
                text: root.hit.after;
                color: Theme.dim;
                font-size: 12px;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Click it, then press the keys you want. Shows them as key caps.
export component ShortcutBox inherits Rectangle {
    in property <[string]> keys;
    in property <string> label;
    // The pressed key and modifiers; returns true when it made a usable shortcut.
    callback captured(string, bool, bool, bool, bool) -> bool;
    callback cleared();
    callback done();
    property <bool> listening: fs.has-focus;
    width: Theme.phono ? 150px : Theme.pinball ? 150px : Theme.tape || Theme.cozy ? 140px : Theme.quest ? 150px : Theme.os95 ? 104px : Theme.comic ? 150px : Theme.pocket ? 130px : Theme.brick ? 120px : Theme.answer ? 140px : Theme.synth ? 140px : 200px;
    height: Theme.phono ? 28px : Theme.pinball ? 28px : Theme.cozy ? 24px : Theme.tape ? 28px : Theme.os95 ? 21px : Theme.comic ? 30px : Theme.pocket ? 22px : Theme.quest ? 25px : Theme.brick ? 22px : Theme.answer ? 26px : Theme.synth ? 28px : 32px;
    border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.pinball || Theme.phono ? 0 : 8px;
    // Tape Deck: a sunk well with real key caps. Desktop 95: a white hot key field. Comic
    // Book: ink key caps on the card, PRESS THE KEYS in a yellow caption while it listens.
    // Brick Phone: LCD key caps, an inverted "Press the keys" with a caret while it listens.
    background: Theme.cozy || Theme.pinball || Theme.phono ? transparent : Theme.tape ? #1b1410 : Theme.pocket ? (t.has-hover && !listening ? #b3bf6a : transparent) : Theme.os95 ? #ffffff : Theme.comic ? (t.has-hover && !listening ? Comic.pale : transparent)
        : Theme.quest ? (t.has-hover && !listening ? Quest.win-lo : transparent)
        : Theme.brick ? (t.has-hover && !listening ? Brick.ghost : transparent)
        : Theme.answer ? transparent
        : Theme.synth ? (listening ? #0b0c0c : transparent)
        : listening ? Theme.accent.with-alpha(0.08) : t.has-hover ? Theme.hover-soft : Theme.raised;
    border-width: Theme.os95 || Theme.brick || Theme.comic || Theme.pocket || Theme.quest || Theme.answer || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.synth ? (listening ? 2px : 0) : 1px;
    // Answering Machine: a small smoked display that reads the keys in red, "NOT SET"
    // dim, and "Press the keys" with a red caret while it listens.
    if Theme.answer: AmSmoke { x: 0; y: 0; width: parent.width; height: parent.height; }
    if Theme.answer && t.has-hover && !root.listening: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: 5px;
        background: #ffffff0f;
    }
    if Theme.answer: HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 2px;
        alignment: center;
        if root.listening: Rectangle {
            width: 2px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            background: Am.rec;
        }
        if root.listening: Text {
            text: "Press the keys";
            color: #b48e80;
            font-family: "Courier Prime";
            font-size: 12px;
            vertical-alignment: center;
        }
        if !root.listening && root.keys.length == 0: Text {
            text: "NOT SET";
            color: #7d5a4f;
            font-family: "Courier Prime";
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.7px;
            vertical-alignment: center;
        }
        if !root.listening: HorizontalLayout {
            alignment: start;
            for k[i] in root.keys: Text {
                text: (i > 0 ? " + " : "") + k.to-uppercase();
                color: #ff8a72;
                font-family: "Courier Prime";
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 0.7px;
                vertical-alignment: center;
            }
        }
    }
    border-color: listening ? Theme.accent : transparent;
    if Theme.os95: OsBevel { kind: 2; }
    if Theme.os95: HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;
        spacing: 0;
        if root.listening: Text {
            text: "Press the keys";
            color: Os.sh;
            font-family: Os.font;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.listening && root.keys.length == 0: Text {
            text: "Not set";
            color: Os.sh;
            font-family: Os.font;
            font-size: 12.5px;
            vertical-alignment: center;
        }
        if !root.listening: HorizontalLayout {
            alignment: start;
            for k[i] in root.keys: Text {
                text: (i > 0 ? " + " : "") + k;
                color: #000000;
                font-family: Os.font;
                font-size: 12.5px;
                vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if Theme.tape: Rectangle { y: 0; height: 2px; background: #00000080; }
    if Theme.tape: Rectangle { y: parent.height; height: 1px; background: #ffffff99; }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { fs.focus(); }
    t := TouchArea { mouse-cursor: pointer; clicked => { fs.focus(); } }
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.done(); return accept; }
            if ((event.text == Key.Backspace || event.text == Key.Delete) && !event.modifiers.control && !event.modifiers.alt) {
                root.cleared();
                root.done();
                return accept;
            }
            if (root.captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta)) {
                root.done();
            }
            accept
        }
    }
    if root.listening && Theme.comic: HorizontalLayout {
        alignment: end;
        Rectangle {
            width: press.preferred-width + 30px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            background: Comic.yellow;
            border-width: 2.5px;
            border-color: Comic.ink;
            Rectangle {
                x: 8px;
                y: (parent.height - self.height) / 2;
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: Comic.red;
                border-width: 2px;
                border-color: Comic.ink;
            }
            press := Text {
                x: 22px;
                y: 1px;
                height: parent.height - 1px;
                text: "PRESS THE KEYS";
                color: Comic.ink;
                font-family: "Bangers";
                font-size: 13px;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
        }
    }
    // Pocket: PRESS THE KEYS on a dark tag, "Not set" in mid green, or small LCD key caps,
    // all flush right.
    if root.listening && Theme.pocket: HorizontalLayout {
        alignment: end;
        Rectangle {
            width: pk-press.preferred-width + 10px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            background: Pk.l3;
            pk-press := Text { text: "PRESS THE KEYS"; color: Pk.l0; font-family: Pk.small; font-size: 8px; letter-spacing: 1px; vertical-alignment: center; }
        }
    }
    if !root.listening && root.keys.length == 0 && Theme.pocket: Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: "Not set";
        color: Pk.l2;
        font-family: Pk.big;
        font-size: 20px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if !root.listening && root.keys.length > 0 && Theme.pocket: HorizontalLayout {
        alignment: end;
        spacing: 4px;
        for k in root.keys: Rectangle {
            width: kcap.preferred-width + 10px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            background: Pk.l0;
            Rectangle { x: 2px; y: parent.height - 4px; width: parent.width - 4px; height: 2px; background: Pk.l1; }
            PkRing { }
            kcap := Text { y: -1px; text: k; color: Pk.l3; font-family: Pk.big; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    // Quest Menu: PRESS THE KEYS in gold after the cursor, pixel key caps in a grey rim, or
    // a dim Not set, all flush right.
    if root.listening && Theme.quest: HorizontalLayout {
        alignment: end;
        spacing: 6px;
        QPx {
            y: (parent.height - self.height) / 2;
            s: 2;
            source: @image-url("skins/px-quest/tri.png");
            colorize: Quest.gold;
        }
        Text {
            text: "PRESS THE KEYS";
            color: Quest.gold;
            font-family: Quest.label;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    if !root.listening && root.keys.length == 0 && Theme.quest: Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: "Not set";
        color: Quest.dim;
        font-family: Quest.font;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if !root.listening && root.keys.length > 0 && Theme.quest: HorizontalLayout {
        alignment: end;
        spacing: 4px;
        for k in root.keys: Rectangle {
            width: qcap.preferred-width + 14px;
            height: 19px;
            y: (parent.height - self.height) / 2;
            background: Quest.ink;
            border-width: 3px;
            border-color: Quest.grey;
            qcap := Text {
                y: 1px;
                height: parent.height - 1px;
                text: k.to-uppercase();
                color: Quest.white;
                font-family: Quest.label;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    if root.listening && Theme.brick: HorizontalLayout {
        alignment: end;
        Rectangle {
            width: bpress.preferred-width + 18px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            background: Brick.ink;
            bpress := Text {
                x: 6px;
                height: parent.height;
                text: "Press the keys";
                color: Brick.lcd1;
                font-family: Brick.words;
                font-size: 16px;
                vertical-alignment: center;
            }
            Rectangle { x: parent.width - 8px; y: 4px; width: 2px; height: parent.height - 8px; background: Brick.lcd1; }
        }
    }
    if !root.listening && root.keys.length == 0 && Theme.brick: Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: "Not set";
        color: Brick.ink;
        opacity: 0.6;
        font-family: Brick.words;
        font-size: 17px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if !root.listening && root.keys.length > 0 && Theme.brick: HorizontalLayout {
        alignment: end;
        spacing: 3px;
        for k in root.keys: VerticalLayout {
            alignment: center;
            Rectangle {
                width: bcap.preferred-width + 10px;
                height: 18px;
                border-width: 1px;
                border-color: Brick.ink;
                Rectangle { x: 0; y: parent.height - 3px; height: 3px; background: Brick.ink; }
                bcap := Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height - 2px;
                    text: k;
                    color: Brick.ink;
                    font-family: Brick.words;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    // Cozy Cabin: PRESS THE KEYS on a honey key with an ember square.
    if root.listening && Theme.cozy: CzKey { x: 0; y: 0; width: root.width; height: root.height; kind: 1; }
    // Pinball: PRESS THE KEYS on a small dot matrix, NOT SET on a dark plate, plasma key caps.
    if Theme.pinball: PbShortcutArt { x: 0; y: 0; width: root.width; height: root.height; listening: root.listening; keys: root.keys; }
    if Theme.phono: PnShortcutArt { x: 0; y: 0; width: root.width; height: root.height; listening: root.listening; keys: root.keys; }
    if root.listening && !Theme.pinball && !Theme.phono && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.brick && !Theme.answer: HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Rectangle {
            width: Theme.synth ? 6px : Theme.cozy ? 8px : 7px;
            height: Theme.synth ? 6px : Theme.cozy ? 8px : 7px;
            border-radius: Theme.synth ? 3px : Theme.cozy ? 0 : 3.5px;
            background: Theme.synth ? #ff5a1e : Theme.cozy ? Cz.ember : Theme.accent;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: Theme.tape || Theme.cozy ? "PRESS THE KEYS" : "Press the keys";
            color: Theme.synth ? #eef3ee : Theme.cozy ? Cz.ink : Theme.accent;
            font-family: Theme.tape ? "Oswald" : Theme.os95 ? Os.font : Theme.synth ? Theme.mono : Theme.cozy ? Cz.caps : "Inter Tight";
            font-size: Theme.cozy ? 10px : Theme.tape ? 11px : Theme.cozy ? 12px : Theme.synth ? 10.5px : 13px;
            font-weight: Theme.tape || Theme.cozy ? 500 : Theme.synth ? 700 : 600;
            letter-spacing: Theme.tape ? 2px : Theme.cozy ? 1.5px : 0;
            vertical-alignment: center;
        }
    }
    // Pocket Synth: dim mono words flush right; key caps of the sampler.
    if !root.listening && root.keys.length == 0 && Theme.synth: Text {
        x: 0;
        y: 0;
        width: parent.width - 2px;
        height: parent.height;
        text: "Not set";
        color: #7a766d;
        font-family: Theme.mono;
        font-size: 10.5px;
        font-weight: 500;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if !root.listening && root.keys.length > 0 && Theme.synth: HorizontalLayout {
        alignment: end;
        spacing: 5px;
        for k in root.keys: Rectangle {
            width: max(26px, scap.preferred-width + 16px);
            height: 24px;
            y: (parent.height - self.height) / 2 - 1px;
            SynKey { x: 0; y: 0; width: parent.width; height: parent.height; radius: 5px; }
            scap := Text {
                text: k.to-uppercase();
                color: #2a2a28;
                font-family: Theme.mono;
                font-size: 8px;
                font-weight: 700;
                letter-spacing: 1px;
            }
        }
    }
    // Cozy Cabin: Not set in parchment brown flush right, or parchment key caps.
    if !root.listening && root.keys.length == 0 && Theme.cozy: Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: "Not set";
        color: Cz.parch-dd;
        font-family: Cz.font;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if !root.listening && root.keys.length > 0 && Theme.cozy: HorizontalLayout {
        alignment: end;
        spacing: 6px;
        for k in root.keys: Rectangle {
            width: max(27px, ccap.preferred-width + 18px);
            height: 24px;
            y: (parent.height - self.height) / 2;
            CzKey { x: 0; y: 0; width: parent.width; height: parent.height; kind: 3; }
            ccap := Text {
                text: k.to-uppercase();
                color: Cz.ink;
                font-family: Cz.caps;
                font-size: 10px;
                letter-spacing: 1.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    if !root.listening && root.keys.length == 0 && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.brick && !Theme.answer && !Theme.synth && !Theme.cozy && !Theme.pinball && !Theme.phono: Text {
        text: Theme.tape ? "NOT SET" : "Not set";
        color: Theme.tape ? #8d7d6a : Theme.dim;
        font-family: Theme.tape ? "Oswald" : Theme.os95 ? Os.font : "Inter Tight";
        font-size: Theme.tape ? 11px : 13px;
        letter-spacing: Theme.tape ? 2px : 0;
    }
    if !root.listening && root.keys.length == 0 && Theme.comic: Text {
        x: 0;
        width: parent.width - 4px;
        height: parent.height;
        text: "Not set";
        color: Comic.faint;
        font-family: "Comic Neue";
        font-size: 12.5px;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if !root.listening && root.keys.length > 0 && Theme.comic: HorizontalLayout {
        alignment: end;
        padding-right: 2px;
        spacing: 5px;
        for k in root.keys: Rectangle {
            width: max(30px, czcap.preferred-width + 12px);
            height: 26px;
            y: (parent.height - self.height) / 2;
            InkShadow { off: 2px; }
            Rectangle { background: #ffffff; border-width: 2.5px; border-color: Comic.ink; }
            czcap := Text {
                y: 1px;
                height: parent.height - 1px;
                text: k.to-uppercase();
                color: Comic.ink;
                font-family: "Bangers";
                font-size: 13px;
                letter-spacing: 1px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    if !root.listening && root.keys.length > 0 && Theme.tape: HorizontalLayout {
        alignment: center;
        spacing: 4px;
        for k in root.keys: Rectangle {
            width: tcap.preferred-width + 10px;
            height: 19px;
            y: (parent.height - self.height) / 2;
            background: @linear-gradient(180deg, #f4efe4 0%, #d4ccbd 75%, #8f8778 75%, #6f685b 100%);
            Rectangle { y: 0; height: 1px; background: #ffffff; }
            tcap := Text {
                y: 0;
                height: parent.height * 0.78;
                vertical-alignment: center;
                horizontal-alignment: center;
                text: k.to-uppercase();
                color: Deck.key-ink;
                font-family: Theme.mono;
                font-size: 9.5px;
                font-weight: 700;
            }
        }
    }
    if !root.listening && root.keys.length > 0 && !Theme.tape && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.brick && !Theme.answer && !Theme.synth && !Theme.cozy && !Theme.pinball && !Theme.phono: HorizontalLayout {
        alignment: center;
        spacing: 4px;
        for k in root.keys: Rectangle {
            width: cap.preferred-width + 14px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.edge;
            cap := Text { text: k; color: Theme.text; font-family: Theme.mono; font-size: 11px; }
        }
    }
}

// Settings are grouped in rounded cards with a title above.
export component Card inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    Text {
        text: root.title;
        color: Theme.muted;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px;
        x: 8px;
    }
    VerticalLayout {
        @children
    }
}

// A piece of a card that is not a CardRow, with the card background.
// The first and last pieces of a card round its corners.
export component CardPart inherits Rectangle {
    in property <bool> first;
    in property <bool> last;
    background: Theme.card;
    border-top-left-radius: root.first ? 14px : 0;
    border-top-right-radius: root.first ? 14px : 0;
    border-bottom-left-radius: root.last ? 14px : 0;
    border-bottom-right-radius: root.last ? 14px : 0;
}

// Split out of CardRow, so its copies share it (see docs/device-themes.md, "Generated code size").
component CardRowText inherits VerticalLayout {
    in property <string> label;
    in property <string> note;
    alignment: center;
    spacing: 2px;
    horizontal-stretch: 1;
    Text { text: root.label; color: Theme.text; font-size: 14px; overflow: elide; }
    if root.note != "": Text { text: root.note; color: Theme.dim; font-size: 12px; overflow: elide; }
}

// One line in a card: a label (and an optional note under it) and its control.
export component CardRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <bool> first;
    in property <bool> last;
    background: Theme.card;
    border-top-left-radius: root.first ? 14px : 0;
    border-top-right-radius: root.first ? 14px : 0;
    border-bottom-left-radius: root.last ? 14px : 0;
    border-bottom-right-radius: root.last ? 14px : 0;
    VerticalLayout {
    HorizontalLayout {
        min-height: 52px;
        padding-left: 16px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        CardRowText { label: root.label; note: root.note; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            @children
        }
    }
    // Zero high on the last row (an `if` here was copied into every use of the row).
    Rectangle { height: root.last ? 0 : 1px; background: Theme.divider; }
    }
}

// A filter chip on the model page.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    width: label.preferred-width + 24px;
    height: 28px;
    border-radius: 14px;
    background: on ? Theme.text : t.has-hover ? Theme.raised : transparent;
    border-width: on ? 0 : 1px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: root.on ? Theme.bg : Theme.muted;
        font-size: 12px;
        font-weight: root.on ? 800 : 500;
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A short bar showing 1 to 5.
export component Meter inherits Rectangle {
    in property <int> value;
    width: 30px;
    height: 5px;
    border-radius: 2.5px;
    background: Theme.track;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 5) / 5;
        border-radius: 2.5px;
        background: Theme.text2;
    }
}

// ---------- Theme effects ----------
// The themes after Ember each have one effect: on the window behind everything
// (WindowFx) and on the recorder card behind its content (CardFx). They move with
// Fx.t, which the app advances as often as each effect needs and stops when nothing
// shows.

// A soft round glow that fades out from its middle. It is a small image scaled up:
// the software renderer draws that far faster than a radial gradient each frame.
export component Glow inherits Image {
    image-fit: fill;
}

// Falling flakes or petals over the whole area. Each one has its own size, speed
// and sway, from its index.
export component Fall inherits Rectangle {
    in property <int> count: 40;
    in property <color> tint: #ffffff;
    in property <float> speed: 50;
    in property <length> sway: 14px;
    in property <bool> petals;
    for i in root.count: Rectangle {
        property <float> r1: Math.mod(i * 37 + 11, 97) / 97;
        property <float> r2: Math.mod(i * 61 + 7, 89) / 89;
        property <float> r3: Math.mod(i * 17 + 3, 83) / 83;
        property <float> h: root.height / 1px + 20;
        width: root.petals ? (6 + self.r3 * 4) * 1px : (1.5 + self.r3 * 2.5) * 1px;
        height: root.petals ? self.width * 0.65 : self.width;
        border-radius: root.petals ? 0 : self.width / 2;
        border-top-left-radius: root.petals ? self.height : self.width / 2;
        border-bottom-right-radius: root.petals ? self.height : self.width / 2;
        background: root.tint;
        opacity: 0.25 + self.r3 * 0.6;
        x: self.r1 * root.width + Math.sin((Fx.t * 0.5 + i) * 1rad) * root.sway;
        y: (Math.mod(Fx.t * root.speed * (0.6 + self.r2 * 0.8) + self.r2 * self.h, self.h) - 10) * 1px;
        transform-rotation: root.petals ? (Fx.t * 50 + i * 47) * 1deg : 0deg;
    }
}

// Rising bubbles.
export component Bubbles inherits Rectangle {
    in property <int> count: 8;
    for i in root.count: Rectangle {
        property <float> r1: Math.mod(i * 41 + 5, 97) / 97;
        property <float> r2: Math.mod(i * 23 + 13, 89) / 89;
        property <float> h: root.height / 1px + 20;
        width: (3 + self.r2 * 4) * 1px;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: #b4faff80;
        opacity: 0.6;
        x: self.r1 * root.width + Math.sin((Fx.t * 0.8 + i * 2) * 1rad) * 6px;
        y: root.height - Math.mod(Fx.t * (22 + self.r2 * 20) + self.r1 * self.h, self.h) * 1px;
    }
}

// The window's effect, behind everything.
export component WindowFx inherits Rectangle {
    // Snow and Daylight: falling snow.
    if Theme.current == 1 || Theme.current == 2: Fall {
        count: 36;
        tint: Theme.current == 2 ? #9db3ca : #ffffff;
    }
    // Graphite: two cool glows drifting slowly.
    if Theme.current == 3: Rectangle {
        Glow {
            source: @image-url("fx/glow-teal.png");
            width: 320px;
            height: 320px;
            x: parent.width - 250px + Math.sin(Fx.slow * 6deg) * 40px;
            y: -130px + Math.cos(Fx.slow * 5deg) * 30px;
        }
        Glow {
            source: @image-url("fx/glow-indigo.png");
            width: 260px;
            height: 260px;
            x: -110px + Math.cos(Fx.slow * 4deg) * 30px;
            y: parent.height * 0.45 + Math.sin(Fx.slow * 5deg) * 30px;
        }
    }
    // Sakura: a few petals drifting down.
    if Theme.current == 4: Fall {
        count: 14;
        petals: true;
        tint: #f8b8cb;
        speed: 32;
        sway: 36px;
    }
    // Lagoon: water lit from above, sun rays swaying, bubbles.
    if Theme.current == 6: Rectangle {
        Image {
            width: parent.width;
            height: parent.height;
            image-fit: fill;
            source: @image-url("fx/lagoon-water.png");
        }
        for ray[k] in [{ x: 0.18, w: 90, s: 1.0 }, { x: 0.42, w: 60, s: 1.4 }, { x: 0.62, w: 110, s: 0.8 }, { x: 0.86, w: 70, s: 1.2 }]: Image {
            image-fit: fill;
            source: @image-url("fx/lagoon-ray.png");
            width: ray.w * 1px;
            height: parent.height * 0.8;
            x: parent.width * ray.x - self.width / 2 + Math.sin(Fx.slow * ray.s * 12deg) * 24px;
            y: -10px;
        }
        Bubbles { count: 8; }
    }
}

// A scrolling area with a thin bar that only shows when there is more to see. It
// widens under the mouse and can be dragged.
// The Scroller's decorations: the fade strips at its edges and each skin's scroll bar.
// One shared component, placed over the Scroller's list, so the Scroller (inlined at
// every use, as it always has children) does not copy these repeaters into every use.
// A theme picked in the settings gallery (gallery.slint) can build a new settings page;
// the gallery's strip asks the page's Scroller to scroll by `shift` (bumping `shifts`) so
// the picked tile lands where it was. Only a Scroller with keeps-gallery does it. When the
// page is too short to scroll that far down, it gets empty room at its end (`pad-h`, the
// content height it needs), which goes again as the user scrolls back up. When the tile sat
// lower than the page's top puts it, the view moves down instead (`top-h`, room above the
// content), which goes as the user scrolls down.
export global PageHold {
    in-out property <length> shift;
    in-out property <int> shifts;
}

component ScrollDecor inherits Rectangle {
    in property <bool> hold;
    property <int> shifts: PageHold.shifts;
    out property <length> pad-h;
    changed shifts => {
        if (root.hold && root.content-y + PageHold.shift > 0.5px) {
            // The tile sat lower than this page's top puts it: room above the content.
            root.top-h = root.content-y + PageHold.shift;
            root.top-view = root.height;
            root.top-w = root.width;
            root.content-y = 0;
        } else if (root.hold) {
            let want = min(0px, root.content-y + PageHold.shift);
            if (root.view-height - want > root.content-height) {
                root.pad-h = root.view-height - want;
                root.pad-view = root.view-height;
                root.pad-w = root.width;
            }
            root.content-y = want;
        }
    }
    // The view's size when the room was added. A resize drops the room: a taller view
    // could not scroll back out of it (the top of the page cut off), a narrower or wider
    // one (Desktop 95 going wide) has other content.
    property <length> pad-view;
    property <length> pad-w;
    function size-changed() {
        if (root.pad-h > 0 && (root.view-height != root.pad-view || root.width != root.pad-w)) { root.drop-pad(); }
        if (root.top-h > 0 && (root.height != root.top-view || root.width != root.top-w)) { root.top-h = 0; }
    }
    changed view-height => { root.size-changed(); }
    changed height => { root.size-changed(); }
    changed width => { root.size-changed(); }
    changed content-y => {
        if (root.pad-h > 0) { root.pad-h = min(root.pad-h, root.view-height - root.content-y); }
        // Scrolling down uses up the room above first: the content moves as in any scroll,
        // and the room does not come back.
        if (root.top-h > 0 && root.content-y < 0) {
            let t = min(root.top-h, -root.content-y);
            root.top-h -= t;
            root.content-y += t;
        }
    }
    // The page shows other content (a Desktop 95 tab): the room goes at once, and the
    // scroll stays inside the new content.
    public function drop-pad() {
        root.top-h = 0;
        if (root.pad-h > 0) {
            root.pad-h = 0;
            root.content-y = max(root.content-y, min(0px, root.view-height - root.content-height));
        }
    }
    // The room above the content after a pick (see `shifts`), and the view's size then.
    out property <length> top-h;
    property <length> top-view;
    property <length> top-w;
    in property <bool> fade;
    in property <bool> bar;
    in property <bool> ink-rail;
    in property <bool> quest-rail;
    in property <bool> rubber;
    in property <bool> bar95;
    in property <bool> pk-rail;
    in-out property <length> content-y;
    in property <length> content-height;
    in property <length> view-height;
    property <length> top-depth: root.fade ? clamp(-root.content-y, 0, 80px) : 0;
    property <length> bottom-depth: root.fade ? clamp(root.range + root.content-y, 0, 80px) : 0;
    property <int> strips: 10;
    // Where it sits in the window. absolute-position is not read again when only an
    // ancestor moves, so these name the window size to be worked out again on a resize.
    property <length> at-x: Win.width > 0 && Win.height > 0 && root.width > 0 ? self.absolute-position.x : self.absolute-position.x;
    property <length> at-y: Win.width > 0 && Win.height > 0 && root.height > 0 ? self.absolute-position.y : self.absolute-position.y;
    property <length> range: root.content-height - root.view-height;
    // Pinball: the thumb is the 13 px ball, so it runs the whole rail, top to bottom.
    property <length> thumb-h: Theme.pinball ? 13px : max(28px, root.view-height * root.view-height / max(root.content-height, 1px));
    property <length> track-h: root.view-height - 32px;
    property <length> thumb95: max(14px, root.track-h * root.view-height / max(root.content-height, 1px));
    for i in root.top-depth > 0 ? root.strips : 0: Rectangle {
        // Strip edges on whole device pixels, in window coordinates, so the strips
        // meet without a seam and the background lines up with the real one.
        property <length> from: round((root.at-y + i * root.top-depth / root.strips) / 1phx) * 1phx;
        property <length> to: round((root.at-y + (i + 1) * root.top-depth / root.strips) / 1phx) * 1phx;
        y: self.from - root.at-y;
        height: self.to - self.from;
        clip: true;
        opacity: 1 - (i + 0.5) / root.strips;
        Rectangle {
            x: -round(root.at-x / 1phx) * 1phx;
            y: -parent.from;
            width: Win.width;
            height: Win.height;
            background: Theme.bg;
            WindowFx { }
        }
    }
    for i in root.bottom-depth > 0 ? root.strips : 0: Rectangle {
        property <length> from: round((root.at-y + root.height - (i + 1) * root.bottom-depth / root.strips) / 1phx) * 1phx;
        property <length> to: round((root.at-y + root.height - i * root.bottom-depth / root.strips) / 1phx) * 1phx;
        y: self.from - root.at-y;
        height: self.to - self.from;
        clip: true;
        opacity: 1 - (i + 0.5) / root.strips;
        Rectangle {
            x: -round(root.at-x / 1phx) * 1phx;
            y: -parent.from;
            width: Win.width;
            height: Win.height;
            background: Theme.bg;
            WindowFx { }
        }
    }
    // Desktop 95: a grey scroll bar over its right 16px (the content leaves that room), with
    // arrow keys and a raised thumb on a checker track.
    if root.bar95: Rectangle {
        x: parent.width - 16px;
        width: 16px;
        height: parent.height;
        background: Os.face;
        Image {
            y: 16px;
            width: 16px;
            height: root.track-h;
            source: 1phx < 0.7px ? @image-url("skins/dv-os95/checker@2x.png") : @image-url("skins/dv-os95/checker.png");
            horizontal-tiling: repeat;
            vertical-tiling: repeat;
            horizontal-alignment: left;
            vertical-alignment: top;
            colorize: #ffffff;
        }
        for k in 2: Rectangle {
            y: k == 0 ? 0 : parent.height - 16px;
            width: 16px;
            height: 16px;
            background: Os.face;
            accessible-role: button;
            accessible-label: k == 0 ? "Scroll up" : "Scroll down";
            accessible-action-default => { root.content-y = clamp(root.content-y + (k == 0 ? 40px : -40px), -max(0px, root.range), 0); }
            OsBevel { kind: arrow.pressed && arrow.has-hover ? 1 : 0; }
            OsPx {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: k == 0 ? @image-url("skins/dv-os95/up.png") : @image-url("skins/dv-os95/arrow.png");
                opacity: root.range > 1px ? 1 : 0.45;
            }
            arrow := TouchArea {
                clicked => { root.content-y = clamp(root.content-y + (k == 0 ? 40px : -40px), -max(0px, root.range), 0); }
            }
        }
        if root.range > 1px: Rectangle {
            y: 16px + (-root.content-y / root.range) * (root.track-h - root.thumb95);
            width: 16px;
            height: root.thumb95;
            background: Os.face;
            OsBevel { kind: 0; }
            drag95 := TouchArea {
                moved => {
                    if (self.pressed) {
                        root.content-y = clamp(-(parent.y - 16px + self.mouse-y - self.pressed-y) / (root.track-h - root.thumb95) * root.range, -root.range, 0);
                    }
                }
            }
        }
    }
    // Comic Book: an inked rail along the right edge with a solid ink thumb.
    if root.ink-rail && !root.bar95 && root.range > 1px: Rectangle {
        x: parent.width - self.width;
        width: 8px;
        background: #ffffff;
        border-width: 2px;
        border-color: Comic.ink;
        Rectangle {
            x: 0;
            y: (-root.content-y / root.range) * (parent.height - root.thumb-h);
            height: root.thumb-h;
            background: rail-drag.pressed ? Comic.red : Comic.ink;
        }
        rail-drag := TouchArea {
            x: -4px;
            width: parent.width + 4px;
            // The thumb follows the pointer, centred on it.
            function follow() {
                root.content-y = clamp(-(self.mouse-y - root.thumb-h / 2) / max(1px, parent.height - root.thumb-h) * root.range, -root.range, 0);
            }
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.follow(); } }
            moved => { if (self.pressed) { self.follow(); } }
        }
    }
    // Pocket: a dithered rail 4px in from the right edge with a dark thumb (the content
    // leaves 14px).
    if root.pk-rail && root.range > 1px: Rectangle {
        x: parent.width - 10px;
        y: 6px;
        width: 6px;
        height: parent.height - 12px;
        PkTile { source: @image-url("skins/px-pocket/dith.png"); }
        Rectangle {
            x: 0;
            y: round((-root.content-y / root.range) * (parent.height - root.thumb-h) / 2px) * 2px;
            height: min(parent.height, root.thumb-h);
            background: Pk.l3;
        }
        pk-drag := TouchArea {
            x: -4px;
            width: parent.width + 6px;
            function follow() {
                root.content-y = clamp(-(self.mouse-y - root.thumb-h / 2) / max(1px, parent.height - root.thumb-h) * root.range, -root.range, 0);
            }
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.follow(); } }
            moved => { if (self.pressed) { self.follow(); } }
        }
    }
    if root.quest-rail && root.range > 1px: Rectangle {
        x: parent.width - self.width;
        width: 12px;
        background: Quest.ink;
        border-width: 3px;
        border-color: Quest.rule;
        property <length> qthumb: max(30px, (self.height - 6px) * root.view-height / max(root.content-height, 1px));
        Rectangle {
            x: 3px;
            y: 3px + round((-root.content-y / root.range) * (parent.height - 6px - parent.qthumb) / 1px) * 1px;
            width: parent.width - 6px;
            height: parent.qthumb;
            background: Quest.gold;
        }
        quest-drag := TouchArea {
            x: -4px;
            width: parent.width + 4px;
            function follow() {
                root.content-y = clamp(-(self.mouse-y - parent.qthumb / 2) / max(1px, parent.height - parent.qthumb) * root.range, -root.range, 0);
            }
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.follow(); } }
            moved => { if (self.pressed) { self.follow(); } }
        }
    }
    // Brick Phone: the LCD's bar, a ruled track between two ink lines and a solid thumb,
    // along the right edge (the content leaves it room).
    if root.bar && !root.bar95 && !root.ink-rail && Theme.brick: BrickBar {
        x: parent.width - 5px;
        y: 0;
        height: parent.height;
        content-y <=> root.content-y;
        content-h: root.content-height;
        view-h: root.view-height;
    }
    if root.rubber && !root.bar95 && !root.ink-rail && root.range > 1px: Rectangle {
        x: parent.width - self.width;
        width: 6px;
        border-radius: 3px;
        background: #b8ab90;
        Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: #00000026; }
        Rectangle {
            x: 0;
            y: (-root.content-y / root.range) * (parent.height - root.thumb-h);
            height: root.thumb-h;
            border-radius: 3px;
            background: @linear-gradient(180deg, #635c56 0%, #4b4540 100%);
        }
        rubber-drag := TouchArea {
            x: -6px;
            width: parent.width + 8px;
            function follow() {
                root.content-y = clamp(-(self.mouse-y - root.thumb-h / 2) / max(1px, parent.height - root.thumb-h) * root.range, -root.range, 0);
            }
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.follow(); } }
            moved => { if (self.pressed) { self.follow(); } }
        }
    }
    // Pinball: a wire rail along the edge; the ball is the thumb.
    Rectangle {
        visible: Theme.pinball && root.bar && !root.bar95 && !root.ink-rail && !root.pk-rail && !root.quest-rail && !root.rubber && root.range > 1px;
        x: parent.width - 9px;
        y: 2px;
        width: 5px;
        height: root.view-height - 4px;
        border-radius: 2.5px;
        background: #050507;
        border-width: 1px;
        border-color: #5e5866;
    }
    // Phonograph: a brass rod along the edge with a brass carriage for the thumb.
    if Theme.phono && root.bar && !root.bar95 && !root.ink-rail && !root.pk-rail && !root.quest-rail && !root.rubber && root.range > 1px: Rectangle {
        x: parent.width - 7.5px;
        y: 2px;
        width: 3px;
        height: root.view-height - 4px;
        border-radius: 1.5px;
        background: @linear-gradient(90deg, #4a3209 0%, #b58a35 50%, #4a3209 100%);
    }
    if root.bar && !root.bar95 && !root.ink-rail && !root.pk-rail && !root.quest-rail && !root.rubber && !Theme.brick && root.range > 1px: Rectangle {
        x: Theme.phono ? parent.width - 9px : Theme.pinball ? parent.width - 9px : parent.width - self.width - 2px;
        y: (-root.content-y / root.range) * (root.view-height - root.thumb-h);
        width: Theme.phono ? 6px : Theme.pinball ? 5px : drag.has-hover || drag.pressed ? 6px : 3px;
        height: root.thumb-h;
        border-radius: Theme.cozy ? 0 : self.width / 2;
        background: Theme.phono ? (drag.pressed || drag.has-hover ? @linear-gradient(90deg, #b58a35 0%, #fff3c8 45%, #d1a84f 100%) : @linear-gradient(90deg, #7a5717 0%, #f6e3a1 45%, #b58a35 100%)) : Theme.pinball ? transparent : Theme.cozy ? (drag.pressed || drag.has-hover ? Cz.honey : Cz.parch-dd) : Theme.synth ? (drag.pressed ? #e94a12 : #ff5a1e) : drag.pressed ? Theme.text.with-alpha(0.33) : drag.has-hover ? Theme.text.with-alpha(0.2) : Theme.text.with-alpha(0.11);
        animate width, background { duration: 120ms; }
        Image {
            visible: Theme.pinball;
            x: -4px;
            y: (parent.height - 13px) / 2;
            width: 13px;
            height: 13px;
            source: 1phx < 0.7px ? @image-url("skins/x-pinball/ball@2x.png") : @image-url("skins/x-pinball/ball.png");
            image-fit: fill;
        }
        drag := TouchArea {
            x: Theme.phono ? -2px : Theme.pinball ? -2px : -6px;
            width: parent.width + (Theme.phono ? 6px : Theme.pinball ? 6px : 8px);
            moved => {
                if (self.pressed) {
                    root.content-y = clamp(-(parent.y + self.mouse-y - self.pressed-y) / (root.view-height - root.thumb-h) * root.range, -root.range, 0);
                }
            }
        }
    }
}

export component Scroller inherits Rectangle {
    out property <length> visible-width <=> fl.width;
    out property <length> visible-height <=> fl.height;
    in-out property <length> content-height <=> fl.content-height;
    in-out property <length> content-y <=> fl.content-y;
    callback scrolled <=> fl.flicked;
    // Its content fades out at an edge it scrolls past: strips there repaint the window
    // background over it, more see-through the further in. Only for a list that sits on
    // the window background.
    in property <bool> fade;
    // Its own thin bar; off for a skin that draws its own (Brick Phone).
    in property <bool> bar: true;
    // The Comic Book's inked rail instead of the thin bar.
    in property <bool> ink-rail;
    // The Quest Menu's rail instead of the thin bar: 12px of ink in a blue rim along the
    // right edge with a gold thumb (the content leaves that room).
    in property <bool> quest-rail;
    // The Answering Machine's sunk track with a rubber thumb instead of the thin bar.
    in property <bool> rubber;
    // A settings page with the theme gallery: it scrolls to keep a picked tile in place.
    in property <bool> keeps-gallery;
    // Drops the room a gallery pick added at the end, for a page that swaps its content.
    public function drop-pad() { decor.drop-pad(); }
    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-height: 50px;
    // A pick that needs the page lower than its top moves the view down instead
    // (ScrollDecor's top-h), as room above the content.
    fl := Flickable {
        y: decor.top-h;
        width: parent.width;
        height: parent.height - decor.top-h;
        mouse-drag-pan-enabled: false;
        @children
        // The room a gallery pick adds at the end (ScrollDecor's pad-h); a layout, so the
        // Flickable counts it in its content height.
        VerticalLayout { min-height: decor.pad-h; }
    }
    in property <bool> bar95;
    in property <bool> pk-rail;
    decor := ScrollDecor {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        fade: root.fade;
        bar: root.bar;
        ink-rail: root.ink-rail;
        quest-rail: root.quest-rail;
        rubber: root.rubber;
        bar95: root.bar95;
        pk-rail: root.pk-rail;
        hold: root.keeps-gallery;
        content-y <=> fl.content-y;
        content-height: fl.content-height;
        view-height: fl.height;
    }
}

export struct FxPoint { x: length, y: length }

// Cyberpunk: the boxes the two snakes tour on the main page, in window px. Each box
// fills itself in when it moves (see the `tour` functions); the route is made in Rust
// (src/tour.rs) and only again when a box moves.
export struct TourBox { x: float, y: float, w: float, h: float, r: float, on: bool }
export struct TourPoint { x: float, y: float, tunnel: bool }
export global Tour {
    in-out property <TourBox> rec;
    in-out property <TourBox> tool;
    in-out property <TourBox> sel;
    // The top of the footer: a highlighted row below it is out of view.
    in-out property <float> foot: 100000;
    // recorder, toolbar, highlighted row, window width and height, footer top, wide
    pure callback route(TourBox, TourBox, TourBox, float, float, float, bool) -> [TourPoint];
}

// One snake of light along the route, its head at point `head` (fractional), its tail
// behind it in the direction it came from (`dir` 1 forward, -1 backward). In the gaps
// between boxes it runs faint and dotted, as through a tunnel.
export component TourSnake inherits Rectangle {
    in property <[TourPoint]> route;
    in property <float> head;
    in property <int> dir: 1;
    in property <color> tint;
    property <int> n: self.route.length;
    for i in 60: Rectangle {
        property <int> k: root.n > 0 ? Math.mod(Math.mod(Math.floor(root.head) - root.dir * i, root.n) + root.n, root.n) : 0;
        property <TourPoint> p: root.n > 0 ? root.route[self.k] : { x: -100, y: -100, tunnel: false };
        property <float> fade: (1 - i / 60) * (1 - i / 60);
        visible: root.n > 0 && !(self.p.tunnel && Math.mod(i, 4) >= 2);
        x: self.p.x * 1px - self.width / 2;
        y: self.p.y * 1px - self.height / 2;
        width: self.p.tunnel ? 1.6px : 3px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.tint.with-alpha((self.p.tunnel ? 0.35 : 1) * self.fade);
        // A soft glow round every third dot.
        if Math.mod(i, 3) == 0 && !self.p.tunnel: Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.tint.with-alpha(0.13 * parent.fade);
        }
    }
}

// The recorder card's effect, behind its content.
export component CardFx inherits Rectangle {
    in property <bool> recording;
    in property <length> radius: 14px;
    // Sakura and Kintsugi: a faint ensō circle in the corner.
    if Theme.current == 4 || Theme.current == 5: Path {
        property <length> size: max(170px, min(parent.width, parent.height) * 0.5);
        x: parent.width - self.size * 0.82;
        y: parent.height - self.size * 0.73;
        width: self.size;
        height: self.size;
        viewbox-width: 170;
        viewbox-height: 170;
        stroke: #efe7da;
        stroke-width: 14px * self.size / 170px;
        opacity: 0.035;
        commands: "M 129 26 A 78 78 0 1 1 46 17";
    }
    // Sakura: 録音 (recording) written faintly behind the timer.
    if Theme.current == 4: Path {
        property <bool> tall: parent.height > 300px;
        height: self.tall ? max(176px, parent.height * 0.42) : 176px;
        width: self.height / 2;
        x: parent.width - self.width - max(86px, parent.width * 0.1);
        y: self.tall ? parent.height * 0.22 : -10px;
        viewbox-width: 1000;
        viewbox-height: 2000;
        fill: root.recording ? Theme.accent : #efe7da;
        opacity: root.recording ? 0.1 : 0.06;
        commands: "M449 459 440 464C463 505 482 565 479 619C576 710 704 520 449 459ZM319 533C313 603 303 687 295 739L310 745C348 705 385 647 416 595C438 595 450 586 454 573ZM68 535 55 538C67 595 73 671 62 736C134 826 252 668 68 535ZM831 445C826 478 813 538 799 589C781 550 767 505 757 452V423H960C973 423 983 418 985 407C960 370 908 312 908 312L868 387V134C886 130 898 123 904 116L787 28L726 90H466L475 118H736V240H491L500 268H736V395H417L425 423H620V628C514 704 408 776 362 802L474 918C485 911 490 896 489 882L525 825V829C565 836 580 852 589 872C599 892 602 925 603 969C738 959 757 897 757 807V529C772 721 799 828 875 924C890 855 931 801 984 785L987 775C924 747 861 701 815 620C863 592 916 557 943 535C964 540 977 531 981 523ZM620 658V804C620 814 616 820 603 820L530 816C569 753 598 699 620 658ZM22 825 111 964C122 960 132 950 136 937C283 849 378 783 439 735L437 725L285 764V499H415C429 499 439 494 442 483C407 445 345 387 345 387L290 471H285V350H389C403 350 413 345 416 334C380 297 317 242 317 242L261 322H121C182 264 232 196 265 132C295 172 318 217 328 247C416 315 540 147 285 101C308 99 318 91 322 79L154 26C137 129 79 298 7 397L16 404C49 384 80 360 108 334L113 350H169V471H40L48 499H169V792C106 807 54 819 22 825ZM350 1727H652V1867H350ZM350 1699V1564H652V1699ZM205 1536V1974H226C287 1974 350 1942 350 1928V1895H652V1969H678C734 1969 804 1933 805 1922V1590C827 1585 840 1575 847 1567L710 1461L641 1536H358L205 1477ZM255 1189 247 1193C272 1244 296 1311 297 1375C312 1388 326 1396 341 1400H40L48 1428H941C955 1428 967 1423 970 1412C919 1367 833 1301 833 1301L758 1400H590C654 1354 723 1297 766 1256C789 1257 800 1249 804 1237L640 1187H905C919 1187 931 1182 933 1171C884 1128 801 1064 801 1064L728 1159H570V1067C595 1063 601 1054 602 1042L420 1028V1159H76L84 1187H619C605 1249 581 1335 557 1400H381C458 1379 482 1238 255 1189Z";
    }
    // Kintsugi: gold cracks across the card, with a slow shine running along them.
    if Theme.current == 5: Rectangle {
        property <float> p: Math.mod(Fx.t / 6, 1.4) - 0.2;
        // The cracks keep their shape: on a tall card one band at the card's width,
        // through the middle.
        Rectangle {
            property <bool> tall: root.height > 300px;
            height: self.tall ? root.width * 130 / 356 : root.height;
            y: self.tall ? (root.height - self.height) / 2 : 0;
            property <float> p: parent.p;
            for layer[k] in [{ w: 5px, o: 0.07 }, { w: 1.2px, o: 0.42 }]: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 356;
                viewbox-height: 130;
                stroke: #e0bb62;
                stroke-width: layer.w;
                opacity: layer.o;
                commands: "M0 92L46 80L70 98L120 70L150 78L196 40L230 52L270 18L300 26L356 6M150 78L168 112L160 130M230 52L248 84";
            }
            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 356;
                viewbox-height: 130;
                stroke: @linear-gradient(90deg, #fff6d800 0%, #fff6d800 Math.max(0, parent.p - 0.06) * 100%, #fff6d8 Math.max(0, Math.min(1, parent.p)) * 100%, #fff6d800 Math.min(1, parent.p + 0.06) * 100%, #fff6d800 100%);
                stroke-width: 1.8px;
                commands: "M0 92L46 80L70 98L120 70L150 78L196 40L230 52L270 18L300 26L356 6";
            }
        }
    }
}

// The recorder: status, time, live level and the record buttons. Mode 0 is a narrow
// window (one line, a round Record button), 1 the default, 2 a wide window (a tall
// panel beside the clip list).
// The snow on a card's top, worked out in Rust (src/snow.rs): Slint cannot build a
// path in a loop. Arguments: card width and corner radius in px, scale, seed.
export global Snow {
    pure callback body(float, float, float, int) -> string;
    pure callback under(float, float, float, int) -> string;
}

// Snow resting on a card (Snow and Daylight): it follows the card's top edge and round
// corners and reaches above and beside it, so the card must not clip it. The same
// seed gives a card the same snow every time.
export component SnowCap inherits Rectangle {
    in property <length> radius: 14px;
    in property <float> scale: 1;
    in property <int> seed: 1;
    // Room around the card for the snow, in px.
    property <length> pad: 24px;
    property <float> w: root.width / 1px;
    property <float> r: root.radius / 1px;
    Path {
        x: -root.pad;
        y: -root.pad;
        width: root.width + 2 * root.pad;
        height: root.pad + 60px;
        viewbox-x: -root.pad / 1px;
        viewbox-y: -root.pad / 1px;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        fill: Theme.current == 2
            ? @linear-gradient(180deg, #ffffff 17%, #f3f7fb 45%, #dde7f1 60%)
            : @linear-gradient(180deg, #ffffff 17%, #f1f6fb 45%, #e2ecf6 60%);
        commands: Snow.body(root.w, root.r, root.scale, root.seed);
    }
    Path {
        x: -root.pad;
        y: -root.pad;
        width: root.width + 2 * root.pad;
        height: root.pad + 60px;
        viewbox-x: -root.pad / 1px;
        viewbox-y: -root.pad / 1px;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        fill: Theme.current == 2 ? #c6d5e5 : #d3e2f1;
        commands: Snow.under(root.w, root.r, root.scale, root.seed);
    }
}

export component RecorderCard inherits Rectangle {
    in property <int> mode: 1;
    in property <bool> recording;
    in property <bool> paused;
    in property <string> device-label;
    in property <string> elapsed;
    in property <string> elapsed-tenth;
    in property <[float]> live;
    callback record();
    callback pause();
    background: Theme.card;
    border-radius: root.mode == 2 ? 18px : 14px;
    border-width: 1px;
    border-color: Theme.card-line;
    // Where it is in the window, for the Cyberpunk tour. absolute-position is not read
    // again when only an ancestor moves, so these name the window size as well.
    property <length> at-x: Win.width > 0 && Win.height > 0 ? self.absolute-position.x : self.absolute-position.x;
    property <length> at-y: Win.width > 0 && Win.height > 0 ? self.absolute-position.y : self.absolute-position.y;
    function tour() {
        Tour.rec = { x: self.at-x / 1px, y: self.at-y / 1px, w: self.width / 1px, h: self.height / 1px, r: self.border-radius / 1px, on: true };
    }
    init => { self.tour(); }
    changed at-x => { self.tour(); }
    changed at-y => { self.tour(); }
    changed width => { self.tour(); }
    changed height => { self.tour(); }
    // The snow rests on top of the card and reaches past its edge.
    clip: Theme.current != 1 && Theme.current != 2;
    vertical-stretch: root.mode == 2 ? 1 : 0;
    CardFx {
        recording: root.recording;
        radius: root.border-radius;
    }
    if Theme.current == 1 || Theme.current == 2: SnowCap {
        radius: root.border-radius;
        scale: root.mode == 2 ? 1.5 : 1;
        seed: 7;
    }
    VerticalLayout {
    // Narrow: time and status on the left, round buttons on the right, level below.
    if root.mode == 0: VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: root.recording ? Theme.accent : Theme.wave-dim;
                    }
                    Text {
                        text: root.recording ? (root.paused ? "PAUSED" : "RECORDING") : "READY";
                        color: root.recording ? Theme.accent : Theme.muted;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 0.7px;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Text {
                        text: root.elapsed;
                        color: root.recording ? Theme.text : Theme.knob;
                        font-family: Theme.mono;
                        font-size: 34px;
                        letter-spacing: -1px;
                    }
                    Text {
                        text: root.elapsed-tenth;
                        color: root.recording ? Theme.faint : Theme.fainter;
                        font-family: Theme.mono;
                        font-size: 34px;
                        letter-spacing: -1px;
                    }
                }
            }
            if root.recording: VerticalLayout {
                alignment: center;
                IconBtn {
                    size: 44px;
                    round: true;
                    outlined: true;
                    icon: root.paused ? "play" : "pause";
                    icon-size: 14px;
                    tint: Theme.text;
                    label: root.paused ? "Resume" : "Pause";
                    clicked => { root.pause(); }
                }
            }
            VerticalLayout {
                alignment: center;
                // The record button (IconBtn itself: a component inheriting it copies it).
                IconBtn {
                    size: 56px;
                    round: true;
                    radius: Theme.rec-square ? self.size * 0.26 : self.size / 2;
                    filled: true;
                    icon: root.recording ? "stop" : "mic";
                    icon-size: root.recording ? 18px : 24px;
                    label: root.recording ? "Stop and save" : "Record";
                    tip: root.recording ? "Stop" : "Record";
                    clicked => { root.record(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.device-label;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                max-width: 160px;
            }
            Wave {
                height: 18px;
                horizontal-stretch: 1;
                values: root.live;
                progress: root.recording && !root.paused ? 2 : -1;
                rest: root.recording ? Theme.rec-rest : Theme.track;
            }
        }
    }
    // Default and wide: the full card. Wide stretches it and gives the time more room.
    if root.mode != 0: VerticalLayout {
        padding: root.mode == 2 ? 26px : 22px;
        padding-top: root.mode == 2 ? 22px : 20px;
        padding-bottom: root.mode == 2 ? 24px : 18px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: root.recording ? Theme.accent : Theme.wave-dim;
            }
            Text {
                text: root.recording ? (root.paused ? "PAUSED" : "RECORDING") : "READY";
                color: root.recording ? Theme.accent : Theme.muted;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 0.7px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.device-label;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        if root.mode == 2: Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: start;
            Text {
                text: root.elapsed;
                color: root.recording ? Theme.text : Theme.knob;
                font-family: Theme.mono;
                font-size: root.mode == 2 ? 72px : 56px;
                letter-spacing: -2px;
            }
            Text {
                text: root.elapsed-tenth;
                color: root.recording ? Theme.faint : Theme.fainter;
                font-family: Theme.mono;
                font-size: root.mode == 2 ? 72px : 56px;
                letter-spacing: -2px;
            }
        }
        Wave {
            height: root.mode == 2 ? 80px : 52px;
            values: root.live;
            progress: root.recording && !root.paused ? 2 : -1;
            rest: root.recording ? Theme.rec-rest : Theme.track;
        }
        if root.mode == 2: Rectangle { vertical-stretch: 1; }
        // Wide: the same round buttons as the one-line recorder.
        // The record button stays in the middle: pause gets a fixed spot on its left,
        // balanced by an empty one on its right.
        if root.mode == 2: HorizontalLayout {
            alignment: center;
            spacing: 14px;
            VerticalLayout {
                width: 44px;
                alignment: center;
                if root.recording: IconBtn {
                    size: 44px;
                    round: true;
                    outlined: true;
                    icon: root.paused ? "play" : "pause";
                    icon-size: 14px;
                    tint: Theme.text;
                    label: root.paused ? "Resume" : "Pause";
                    clicked => { root.pause(); }
                }
            }
            // The record button (IconBtn itself: a component inheriting it copies it).
            IconBtn {
                size: 56px;
                round: true;
                radius: Theme.rec-square ? self.size * 0.26 : self.size / 2;
                filled: true;
                icon: root.recording ? "stop" : "mic";
                icon-size: root.recording ? 18px : 24px;
                label: root.recording ? "Stop and save" : "Record";
                tip: root.recording ? "Stop" : "Record";
                clicked => { root.record(); }
            }
            Rectangle { width: 44px; }
        }
        if root.mode != 2 && root.recording: HorizontalLayout {
            spacing: 10px;
            Btn {
                primary: true;
                text: "Stop and save";
                font-size: 15px;
                height: root.mode == 2 ? 52px : 46px;
                horizontal-stretch: 1;
                clicked => { root.record(); }
            }
            Btn {
                text: root.paused ? "Resume" : "Pause";
                font-size: 14px;
                height: root.mode == 2 ? 52px : 46px;
                width: 120px;
                clicked => { root.pause(); }
            }
        }
        if root.mode != 2 && !root.recording: Btn {
            primary: true;
            text: "Record";
            font-size: 15px;
            height: root.mode == 2 ? 52px : 46px;
            clicked => { root.record(); }
        }
    }
    }
}

// The transcript on the clip page: words and pauses, Show marks, Edit, or the
// Transcribe button and progress. It sits in the page's scroll on normal windows and
// fills its own column on wide ones.
export component TranscriptCard inherits Rectangle {
    in property <string> transcript;
    in property <bool> transcribing;
    // The running job is a translation.
    in property <bool> translating;
    in property <float> transcribe-progress;
    // The translation shown (its language code, empty for the original) and its text.
    in property <string> translation;
    in-out property <string> shown-lang;
    in property <[LangRow]> langs;
    callback choose-lang(string);
    callback install-for(int);
    callback lang-filter(string);
    // The local AI's summary and to-do list, and whether it is shown.
    in property <string> summary;
    in property <bool> summarising;
    in property <bool> can-ai;
    in-out property <bool> show-summary;
    callback summarise();
    property <bool> summary-view: root.show-summary && (root.summary != "" || root.summarising);
    property <bool> lang-view: root.shown-lang != "" && !root.summary-view;
    property <bool> original-view: !root.lang-view && !root.summary-view;
    in property <[WordRow]> words;
    in property <int> current-word: -1;
    in-out property <bool> show-marks;
    in property <bool> can-transcribe;
    in property <bool> recording;
    // Editing happens in the card itself: the words become a text box with the pause
    // tags in orange, and Cancel and Save take the place of Show marks and Edit.
    in property <bool> editing;
    in-out property <string> edit-draft;
    in property <string> edit-badge;
    in property <bool> speaking;
    callback edit();
    callback transcribe();
    callback seek-word(int);
    callback edited(string);
    callback cancel();
    callback save();
    pure callback edit-markup(string) -> styled-text;
    pure callback plain-selection(string, int, int) -> string;
    // The copy button shows a check mark for a moment after a copy.
    property <bool> copied;
    // Where the editor's cursor is, and how tall it is.
    property <Point> caret;
    property <length> caret-h: Theme.tape || Theme.os95 || Theme.synth || Theme.answer ? measure.preferred-height : Theme.pocket ? 18px : Theme.quest ? 17px : Theme.brick ? root.brick-size : 20px;
    // Tape Deck: the clip's name on the insert card, and the ruled lines of the card,
    // which scroll with the text (the shown view reports how far it is scrolled).
    in property <string> clip-name;
    // Brick Phone: the size of the words on the LCD (bigger in a wide window).
    in property <length> brick-size: 17px;
    property <length> text-size: Theme.phono ? 15.5px : Theme.pinball ? 15.5px : Theme.cozy ? 14px : Theme.brick ? root.brick-size : Theme.tape || Theme.synth ? 12px : Theme.os95 ? 19px : Theme.comic ? 13.5px : Theme.answer ? 13px : 15px;
    property <string> text-family: Theme.brick ? Brick.words : Theme.tape || Theme.synth ? Theme.mono : Theme.os95 ? "VT323" : Theme.comic ? "Comic Neue" : Theme.dash ? "Manrope" : Theme.answer ? "Courier Prime" : Theme.phono ? Pn.font : Theme.pinball ? Pb.font : Theme.cozy ? Cz.font : "Inter Tight";
    property <length> scroll-y;
    property <length> line-h: measure.preferred-height;
    property <length> rule-pitch: root.original-view && !root.editing ? root.line-h + 5px : root.line-h;
    property <length> rule-off: root.scroll-y - root.rule-pitch * floor(root.scroll-y / root.rule-pitch);
    measure := Text { visible: false; text: "Xg"; font-family: Theme.os95 ? "VT323" : Theme.answer ? "Courier Prime" : Theme.mono; font-size: Theme.os95 ? 19px : Theme.answer ? 13px : 12px; }
        // Comic Book: a tagged white panel with a thick ink edge, red and thicker while it
        // is typed on (the tag is drawn last, over the edge).
        border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.synth || Theme.pocket || Theme.quest || Theme.brick || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.dash ? 12px : Theme.answer ? 8px : 14px;
        // Pocket: the LCD is the card. Quest Menu: the page draws the window round it (gold
        // while it is typed on).
        // Brick Phone: a box in a 2px ink frame, a heavy double frame while it is typed on. Answering Machine: message paper,
        // whiter with a red edge while it is typed on. Pocket Synth: the keys sit on the
        // faceplate above a black screen.
        border-width: Theme.tape || Theme.os95 || Theme.synth || Theme.pocket || Theme.quest || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.comic ? (root.editing ? 4px : 3px) : Theme.brick ? (root.editing ? 3px : 2px) : 1px;
        border-color: Theme.comic ? (root.editing ? Comic.red : Comic.ink) : Theme.answer ? (root.editing ? Am.rec : Am.paper-edge) : root.editing ? Theme.accent : Theme.card-edge;
        background: Theme.comic ? #ffffff : Theme.answer ? (root.editing ? #fbf7ee : Am.paper) : transparent;
        Rectangle {
            visible: Theme.brick && root.editing;
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-width: 1px;
            border-color: Brick.ink;
        }
        VerticalLayout {
            padding: Theme.tape || Theme.os95 || Theme.pocket || Theme.quest || Theme.brick || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.comic ? 10px : Theme.dash ? 14px : Theme.answer ? 10px : 18px;
            padding-top: Theme.tape || Theme.os95 || Theme.pocket || Theme.quest || Theme.brick || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.comic ? 7px : Theme.dash ? 10px : Theme.answer ? 2px : 12px;
            padding-bottom: Theme.tape || Theme.os95 || Theme.brick || Theme.quest || Theme.pocket || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.comic ? 8px : Theme.answer ? 6px : 12px;
            spacing: Theme.tape || Theme.pocket ? 6px : Theme.os95 ? 4px : Theme.quest ? 9px : Theme.brick ? 0 : Theme.answer ? 6px : Theme.synth ? 10px : 8px;
            // Desktop 95: Notepad's toolbar; the window round it (skins/dv-os95-pages.slint)
            // carries the title, and the change count sits in its status bar.
            // Desktop 95 drops the empty bar while there is no text yet (mockup 1B).
            HorizontalLayout {
                property <bool> os-bare: Theme.os95 && !root.editing && (root.transcript == "" || root.transcribing);
                height: Theme.os95 ? (self.os-bare ? 0 : 27px) : Theme.comic ? 30px : Theme.brick ? 24px : Theme.pocket ? 22px : Theme.quest ? 27px : Theme.answer ? 32px : 28px;
                spacing: Theme.tape ? 5px : Theme.quest ? 6px : Theme.os95 ? 4px : Theme.comic ? 6px : Theme.answer ? 6px : Theme.pocket ? 5px : Theme.brick ? 4px : Theme.synth ? 6px : Theme.phono ? 8px : 0;
                // Pocket: TYPING or TRANSCRIPT on a dark tag (none over the words).
                if Theme.pocket && (root.editing || root.transcript == "" || root.transcribing): VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: pk-head.preferred-width + 10px;
                        height: 14px;
                        background: Pk.l3;
                        pk-head := Text { text: root.editing ? "TYPING" : "TRANSCRIPT"; color: Pk.l0; font-family: Pk.small; font-size: 8px; letter-spacing: 1px; vertical-alignment: center; }
                    }
                }
                padding-top: Theme.os95 && !self.os-bare ? 2px : 0;
                padding-bottom: Theme.os95 && !self.os-bare ? 2px : 0;
                padding-right: Theme.brick ? 3px : 0;
                // Brick Phone: the box's name inverted on the left.
                if Theme.brick: Rectangle {
                    width: btag.preferred-width + 12px;
                    background: Brick.ink;
                    btag := Text {
                        x: 6px;
                        height: parent.height;
                        text: root.editing ? "EDITING" : root.summary-view ? "SUMMARY" : root.lang-view ? "TRANSLATION" : "TRANSCRIPT";
                        color: Brick.lcd1;
                        font-family: Brick.caps;
                        font-size: 8px;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                    }
                }
                if Theme.brick && !root.editing: Rectangle { width: 2px; }
                // Car Dashboard: small caps, EDITING in ice while the words are edited.
                Text {
                    visible: !Theme.comic && !Theme.brick;
                    text: Theme.quest ? (root.summary-view && !root.editing ? "SUMMARY" : "TRANSCRIPT") : (Theme.dash || Theme.answer) && root.editing ? "EDITING" : Theme.answer && root.summary-view ? "SUMMARY" : Theme.answer && root.lang-view ? "TRANSLATION"
                        : Theme.os95 || Theme.pocket || Theme.brick || Theme.cozy || Theme.pinball || Theme.phono ? "" : "TRANSCRIPT";
                    horizontal-stretch: Theme.os95 || Theme.brick || (Theme.pocket && !root.editing && root.transcript != "" && !root.transcribing) || (Theme.quest && root.editing) ? 0 : 1;
                    color: Theme.quest ? Quest.gold : Theme.tape ? Deck.rail : Theme.dash ? (root.editing ? Theme.accent : #56606c) : Theme.answer ? (root.editing ? Am.rec : Am.print) : Theme.synth ? #7a766d : Theme.muted;
                    font-family: Theme.quest ? Quest.label : Theme.tape ? "Oswald" : Theme.os95 ? Os.font : Theme.dash ? "Manrope" : Theme.answer ? "Barlow Condensed" : Theme.synth ? Theme.mono : "Inter Tight";
                    font-size: Theme.quest ? 11px : Theme.tape ? 10px : Theme.dash ? 9px : Theme.answer ? 10px : Theme.synth ? 8px : 12px;
                    font-weight: Theme.tape ? 500 : Theme.quest ? 400 : Theme.answer || Theme.synth ? 700 : 800;
                    letter-spacing: Theme.quest ? 0.5px : Theme.tape ? 2.8px : Theme.dash ? 2.3px : Theme.answer ? 2.6px : Theme.synth ? 1.6px : 0.7px;
                    vertical-alignment: center;
                }
                // Quest Menu: the EDITING tag in ink on gold beside TRANSCRIPT.
                if Theme.quest && root.editing: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: q-editing.preferred-width + 8px;
                        height: 15px;
                        background: Quest.gold;
                        q-editing := Text {
                            y: 1px;
                            height: parent.height - 1px;
                            text: "EDITING";
                            color: Quest.ink;
                            font-family: Quest.label;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if Theme.quest && root.editing: Rectangle { horizontal-stretch: 1; }
                // Tape Deck: the change count is a red rubber stamp; Car Dashboard: an amber
                // chip.
                // Brick Phone: the change count in small caps.
                if root.editing && root.edit-badge != "" && Theme.brick: Text {
                    text: root.edit-badge.to-uppercase();
                    color: Brick.ink;
                    font-family: Brick.caps;
                    font-size: 7px;
                    letter-spacing: 0.4px;
                    vertical-alignment: center;
                }
                if root.editing && root.edit-badge != "" && !Theme.os95 && !Theme.brick: Rectangle {
                    width: badge.preferred-width + (Theme.quest ? 4px : Theme.tape ? 12px : Theme.pocket ? 10px : 16px);
                    height: Theme.tape ? 17px : Theme.comic ? 22px : Theme.pocket ? 14px : 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.phono ? 2px : Theme.pinball ? 3px : Theme.tape || Theme.answer ? 2px : Theme.pocket || Theme.quest || Theme.cozy ? 0 : Theme.comic ? 0 : Theme.synth ? 4px : 10px;
                    // Pocket: a dark tag. Quest Menu: a gold label.
                    // Answering Machine: a red stamp.
                    background: Theme.phono ? Pn.wax : Theme.pinball ? transparent : Theme.cozy ? Cz.ember : Theme.pocket ? Pk.l3 : Theme.quest ? transparent : Theme.tape ? #efe3c8e6 : Theme.comic ? Comic.red : Theme.dash ? #ffb54726 : Theme.answer ? transparent : Theme.synth ? #0b0c0c : Theme.accent;
                    border-width: Theme.phono ? 0 : Theme.pinball ? 1px : Theme.cozy ? 0 : Theme.quest ? 0 : Theme.tape ? 1.5px : Theme.comic ? 2.5px : Theme.dash || Theme.answer ? 1px : 0;
                    border-color: Theme.pinball ? #ff7a1a99 : Theme.comic ? Comic.ink : Theme.dash ? #ffb54780 : Theme.answer ? Am.rec : Deck.red;
                    badge := Text {
                        text: Theme.tape || Theme.comic || Theme.pocket || Theme.quest || Theme.answer || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? root.edit-badge.to-uppercase() : root.edit-badge;
                        color: Theme.phono ? Pn.wax-ink : Theme.pinball ? Pb.plasma : Theme.cozy ? Cz.cream : Theme.pocket ? Pk.l0 : Theme.quest ? Quest.gold : Theme.tape ? Deck.red : Theme.comic ? #ffffff : Theme.dash ? #ffb547 : Theme.answer ? Am.rec : Theme.synth ? #ff5a1e : Theme.on-accent;
                        font-family: Theme.phono ? Pn.caps : Theme.pinball ? Pb.font : Theme.cozy ? Cz.caps : Theme.pocket ? Pk.small : Theme.quest ? Quest.label : Theme.tape ? "Oswald" : Theme.os95 ? Os.font : Theme.comic ? "Bangers" : Theme.dash ? "Manrope" : Theme.answer ? "Barlow Condensed" : Theme.synth ? Theme.mono : "Inter Tight";
                        font-size: Theme.phono ? 8.5px : Theme.pinball ? 10px : Theme.cozy ? 10px : Theme.pocket ? 8px : Theme.quest ? 11px : Theme.tape ? 9px : Theme.dash ? 10.5px : Theme.comic ? 13px : Theme.answer ? 9px : Theme.synth ? 8.5px : 11px;
                        font-weight: Theme.tape || Theme.pinball ? 600 : Theme.phono ? 700 : Theme.pocket || Theme.quest ? 400 : Theme.comic || Theme.cozy ? 400 : Theme.answer || Theme.synth ? 700 : 800;
                        letter-spacing: Theme.cozy || Theme.pinball ? 1.5px : Theme.phono ? 1.3px : Theme.tape ? 1.3px : Theme.comic || Theme.pocket || Theme.synth ? 1px : Theme.answer ? 1.1px : 0;
                    }
                }
                if (Theme.os95 || Theme.brick) && root.editing: Rectangle { horizontal-stretch: 1; }
                if root.editing: HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: Theme.os95 ? 4px : Theme.brick ? 4px : 6px;
                    padding-left: Theme.os95 ? 0 : Theme.brick ? 4px : 8px;
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            text: "Cancel";
                            height: Theme.os95 ? 23px : Theme.pocket ? 18px : Theme.quest ? 24px : Theme.brick ? 19px : 28px;
                            font-size: 12px;
                            clicked => { root.cancel(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            primary: true;
                            text: "Save";
                            height: Theme.os95 ? 23px : Theme.pocket ? 18px : Theme.quest ? 24px : Theme.brick ? 19px : 28px;
                            font-size: 12px;
                            enabled: root.edit-draft != root.transcript && !root.speaking;
                            clicked => { root.save(); }
                        }
                    }
                }
                // Translate and Summary: a click shows that view (making it the first
                // time), a second click goes back to the original. Nothing moves.
                if root.transcript != "" && !root.transcribing && !root.editing && root.langs.length > 0: VerticalLayout {
                    alignment: center;
                    lang-btn := IconBtn {
                        size: Theme.brick ? 20px : Theme.os95 ? 23px : Theme.pocket ? 18px : Theme.quest ? 27px : 28px;
                        icon: "languages";
                        icon-size: 14px;
                        active: root.lang-view;
                        label: "Translate";
                        tip: "Translate";
                        clicked => {
                            root.lang-filter("");
                            lang-menu.show();
                        }
                    }
                    // A searchable list of languages, Original first.
                    lang-menu := PopupWindow {
                        // Tape Deck: it drops from under the key (mockup 1E). The others open leftwards.
                        x: Theme.tape || Theme.os95 || Theme.pocket || Theme.brick ? 0 : lang-btn.width - self.width;
                        y: lang-btn.height + 6px;
                        width: 250px;
                        height: Theme.menu-pad + 40px + Theme.menu-h + min(root.langs.length, 7) * Theme.menu-h + Theme.menu-pad;
                        close-policy: close-on-click-outside;
                        MenuCard {
                            VerticalLayout {
                                padding: Theme.menu-pad;
                                VerticalLayout {
                                    padding-bottom: 6px;
                                    padding-top: Theme.brick ? 2px : 0;
                                    padding-left: Theme.brick ? 2px : 0;
                                    padding-right: Theme.brick ? 2px : 0;
                                    TextField {
                                        height: Theme.tape ? 28px : Theme.os95 || Theme.pocket ? 22px : Theme.comic ? 30px : Theme.brick ? 24px : 34px;
                                        radius: Theme.tape ? 2px : Theme.quest || Theme.pocket ? 0 : Theme.os95 ? 0 : Theme.comic ? 15px : Theme.brick ? 0 : 8px;
                                        fill: Theme.phono ? #fffaf0 : Theme.pocket ? Pk.l0 : Theme.tape ? #fffaf0 : Theme.os95 ? #ffffff : Theme.comic ? #ffffff : Theme.answer ? Am.cream : Theme.brick ? #ffe6aa40 : Theme.quest ? Quest.ink : Theme.synth ? #0b0c0c : Theme.field;
                                        rest-edge: Theme.phono ? Pn.brass-mid : Theme.pocket ? Pk.l3 : Theme.tape ? #8f8778 : Theme.os95 ? Os.sh : Theme.comic ? Comic.ink : Theme.quest ? Quest.rule : Theme.synth ? #3a3e3c : Theme.edge;
                                        ink: Theme.phono ? Pn.ink : Theme.pocket ? Pk.l3 : Theme.tape ? Deck.ink : Theme.comic ? Comic.ink : Theme.synth ? #eef3ee : Theme.quest ? Quest.white : Theme.text;
                                        hint: Theme.phono ? Pn.faded : Theme.pocket ? Pk.l2 : Theme.tape ? Deck.ink-soft : Theme.os95 ? #7a7a7a : Theme.comic ? Comic.faint : Theme.quest ? Quest.dim : Theme.brick ? Brick.ink2 : Theme.synth ? #8c948e : Theme.dim;
                                        font-size: Theme.phono ? 14px : Theme.pocket ? 18px : Theme.tape ? 12px : Theme.os95 ? 12.5px : Theme.quest ? 14px : Theme.brick ? 16px : Theme.synth ? 11.5px : 13px;
                                        family: Theme.pocket ? Pk.big : Theme.os95 ? Os.font : Theme.comic ? "Comic Neue" : Theme.quest ? Quest.font : Theme.brick ? Brick.words : Theme.answer ? "Courier Prime" : Theme.synth ? Theme.mono : Theme.phono ? Pn.font : Theme.pinball ? Pb.font : Theme.cozy ? Cz.font : "Inter Tight";
                                        side: Theme.brick ? 6px : 12px;
                                        bare-focus: Theme.os95 || Theme.pocket || Theme.brick;
                                        edge-width: Theme.quest ? 3px : 1px;
                                        select-fill: Theme.quest ? Quest.sel : Theme.phono ? #e8c86e : Theme.accent.with-alpha(0.4);
                                        focus-edge: Theme.phono ? Pn.brass : Theme.accent;
                                        hint-italic: Theme.phono;
                                        focus-ring: Theme.quest || Theme.phono ? transparent : Theme.synth ? #ff5a1e40 : Theme.accent.with-alpha(0.16);
                                        icon: "search";
                                        placeholder: "Search";
                                        label: "Search languages";
                                        init => { self.grab(); }
                                        edited(t) => { root.lang-filter(t); }
                                    }
                                }
                                MenuRow {
                                    num: 1;
                                    text: "Original";
                                    checked: !root.lang-view;
                                    clicked => { root.shown-lang = ""; root.show-summary = false; lang-menu.close(); }
                                }
                                Flickable {
                                    height: min(root.langs.length, 7) * Theme.menu-h;
                                    content-height: root.langs.length * Theme.menu-h;
                                    for l[i] in root.langs: lrow := Rectangle {
                                        y: i * Theme.menu-h;
                                        width: parent.width;
