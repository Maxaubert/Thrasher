// The Fighter Select look of every page but the main one (mockups in
// docs/mockups/device-themes/x-fighter-pages/): picking a tile opens that fighter's profile
// (its portrait and name, the waveform as the stage it fights on, the transcript as its
// story), settings are the options screen in tagged panels, the models a roster with
// quality and speed as stat bars, merging a tag team of numbered fighters, Ask story mode
// with the answer in a dialogue box, the widget a pocket HUD with FIGHT, and every
// question an announcer panel over the dimmed page.
//
// Behaviour is shared: the state is in the Pages and Main globals, the actions are
// AppWindow's (reached through the callbacks here), and the shared widgets (the transcript
// card, menus, dropdowns, switches, keys) draw their slanted look themselves for this skin
// (`Theme.fighter`, the Fi parts in common.slint).

import { ThemeGallery } from "../gallery.slint";
import { Theme, Main, Pages, Tips, Icon, Btn, IconBtn, Toggle, Select, TextField, ShortcutBox, Scroller, OrderList, TranscriptCard, ExportButton, TrimTouch, AskSource, Fi, FiSkew, FiPortrait } from "../common.slint";
import { F, G, Glyph, Skew, Key, Label, TitleKey, P1Tag } from "x-fighter-parts.slint";

// ---------- Small parts ----------

// A page: the violet night with a faint glow from the top.
component Page inherits Rectangle {
    background: F.bg;
}

// The gold Back key of the title bar: a chevron and its word in the bold display type.
component BackKey inherits Key {
    in property <string> text;
    k: F.k14;
    body: F.gold;
    hot-body: #ffe066;
    rim: #000000;
    rim-w: 2px;
    width: back-row.preferred-width;
    height: 24px;
    back-row := HorizontalLayout {
        padding-left: 11px;
        padding-right: 12px;
        spacing: 6px;
        Icon {
            name: "back";
            tint: #000000;
            stroke-width: 2.8px;
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: #000000;
            font-family: F.disp;
            font-size: 12px;
            letter-spacing: 1.4px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The title bar of a page: the gold Back key, THRASHER, what the page is (PROFILE,
// OPTIONS), minimise and close; a red line under it.
component PageTitle inherits Rectangle {
    in property <string> back-text: "BACK";
    in property <string> back-label: "Back";
    in property <string> sub;
    callback back();
    height: 34px;
    background: @linear-gradient(90deg, #1a1430 0%, #0d0b16 70%);
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    Rectangle { y: parent.height - 2px; height: 2px; background: F.p1; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        padding-bottom: 2px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            BackKey { text: root.back-text; label: root.back-label; tip: "Back"; clicked => { root.back(); } }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            Text {
                text: "THRASH";
                accessible-label: "Thrasher";
                color: #ffffff;
                font-family: F.lean;
                font-size: 17px;
                letter-spacing: 1.5px;
                vertical-alignment: center;
            }
            Text {
                text: "ER";
                color: F.p1;
                font-family: F.lean;
                font-size: 17px;
                letter-spacing: 1.5px;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.sub;
            color: F.gold;
            font-family: F.body;
            font-weight: 700;
            font-size: 10px;
            letter-spacing: 2.5px;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                TitleKey { icon: G.min; sw: 3; label: "Minimize"; plain: true; clicked => { Main.minimize-window(); } }
            }
            VerticalLayout {
                alignment: center;
                TitleKey { icon: G.close; sw: 3; label: "Close"; danger: true; plain: true; clicked => { Main.close-window(); } }
            }
        }
    }
}

// A page heading: the name in the slanted type (its second word gold), a red rule
// fading out, and what is on the right.
component Heading inherits HorizontalLayout {
    in property <string> first;
    in property <string> second;
    in property <length> size: 22px;
    spacing: 10px;
    HorizontalLayout {
        horizontal-stretch: 0;
        Text {
            text: root.first;
            accessible-label: root.first + root.second;
            color: #ffffff;
            font-family: F.lean;
            font-size: root.size;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
        Text {
            text: root.second;
            color: F.gold;
            font-family: F.lean;
            font-size: root.size;
            letter-spacing: 1.5px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Rectangle { height: 2px; background: @linear-gradient(90deg, F.p1 0%, #ff2d4a00 100%); }
    }
    @children
}

// The band under a page's title bar that holds its heading.
component HeadBand inherits Rectangle {
    height: 44px;
    background: #0f0c1d;
    Rectangle { y: parent.height - 1px; height: 1px; background: F.line; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        @children
    }
}

// A tag on a panel's top edge: the words in the slanted type on red (gold or cyan), in a
// black rim.
component Tag inherits Rectangle {
    in property <string> text;
    // 0 red, 1 gold, 2 cyan.
    in property <int> tone;
    width: tag-text.preferred-width + 16px;
    height: 18px;
    Rectangle {
        background: #000000;
        Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            background: root.tone == 1 ? F.gold : root.tone == 2 ? F.cyan : F.p1;
        }
    }
    tag-text := Text {
        x: 8px;
        y: 1px;
        height: parent.height - 1px;
        text: root.text;
        color: root.tone == 0 ? #ffffff : #000000;
        font-family: F.lean;
        font-size: 12px;
        letter-spacing: 1.5px;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// A dark panel with a thin violet edge (gold while `hot`) and its tag across the top edge.
// The page leaves room above it for the tag.
component Panel inherits Rectangle {
    in property <string> tag;
    in property <int> tone;
    in property <bool> hot;
    in property <length> frame: root.hot ? 2px : 1px;
    Rectangle {
        background: root.hot ? F.gold : F.line;
        Rectangle {
            x: root.frame;
            y: root.frame;
            width: parent.width - 2 * root.frame;
            height: parent.height - 2 * root.frame;
            background: root.hot ? #16112a : #110e20;
        }
    }
    @children
    // `visible`, not `if`: the panel is used with children, so Slint copies it into every
    // use, and an `if` costs far more code there (docs/device-themes.md, Generated code size).
    Tag { visible: root.tag != ""; x: 10px; y: -9px; text: root.tag; tone: root.tone; }
}

// The field and its brackets.
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> invalid;
    in property <length> font-size: 14px;
    in property <bool> grab-at-start;
    callback accepted(string);
    callback edited(string);
    out property <bool> has-focus: well.has-focus;
    public function grab() { well.grab(); }
    height: 34px;
    Rectangle {
        visible: well.has-focus || root.invalid;
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        background: root.invalid ? F.p1 : F.gold;
    }
    well := TextField {
        radius: 0;
        fill: #07060e;
        rest-edge: Fi.well;
        ink: #ffffff;
        hint: F.faint;
        family: F.body;
        side: 12px;
        select-fill: #5a3d00;
        select-ink: #ffffff;
        focus-edge: F.gold;
        bare-focus: true;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        text <=> root.text;
        placeholder: root.placeholder;
        label: root.label;
        font-size: root.font-size;
        init => { if (root.grab-at-start) { self.grab(); } }
        accepted(t) => { root.accepted(t); }
        edited(t) => { root.edited(t); }
    }
    Rectangle {
        visible: well.has-focus && !root.invalid;
        x: -5px;
        y: -5px;
        width: root.width + 10px;
        height: root.height + 10px;
        Rectangle { x: 0; y: 0; width: 9px; height: 2px; background: F.gold; }
        Rectangle { x: 0; y: 0; width: 2px; height: 9px; background: F.gold; }
        Rectangle { x: parent.width - 9px; y: 0; width: 9px; height: 2px; background: F.gold; }
        Rectangle { x: parent.width - 2px; y: 0; width: 2px; height: 9px; background: F.gold; }
        Rectangle { x: 0; y: parent.height - 2px; width: 9px; height: 2px; background: F.gold; }
        Rectangle { x: 0; y: parent.height - 9px; width: 2px; height: 9px; background: F.gold; }
        Rectangle { x: parent.width - 9px; y: parent.height - 2px; width: 9px; height: 2px; background: F.gold; }
        Rectangle { x: parent.width - 2px; y: parent.height - 9px; width: 2px; height: 9px; background: F.gold; }
    }
}

// A slanted search or question field: a black well with an icon, gold edged while it has
// the cursor (or always, for the question).
component SlantField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <string> icon;
    in property <bool> gold;
    callback accepted();
    callback edited();
    public function grab() { input.grab(); }
    height: 34px;
    Skew {
        width: 100%;
        height: 100%;
        body: #07060e;
        rim: input.has-focus || (root.gold && root.text != "") ? F.gold : Fi.well;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 6px;
        Icon {
            name: root.icon;
            tint: root.gold || input.has-focus ? F.gold : F.dim;
            stroke-width: 2.2px;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
        }
        input := TextField {
            y: 3px;
            height: parent.height - 6px;
            radius: 0;
            fill: transparent;
            rest-edge: transparent;
            ink: #ffffff;
            hint: F.faint;
            font-size: 13px;
            family: F.body;
            side: 3px;
            select-fill: #5a3d00;
            select-ink: #ffffff;
            bare-focus: true;
            placeholder: root.placeholder;
            label: root.label;
            text <=> root.text;
            accepted => { root.accepted(); }
            edited => { root.edited(); }
        }
    }
}

// A message: a dark plate with a gold edge on its left (a violet one when there is none).
component Strip inherits Rectangle {
    in property <string> text;
    height: 30px;
    background: #120f24;
    Rectangle { x: 0; y: 0; width: 3px; height: parent.height; background: root.text != "" ? F.gold : F.line; }
    Text {
        x: 12px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        color: F.text2;
        font-family: F.body;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A message floating just above the bottom of a page.
component Toast inherits Rectangle {
    in property <string> text;
    in property <length> above: 14px;
    height: 0;
    Rectangle {
        visible: root.text != "";
        x: (parent.width - self.width) / 2;
        y: -root.above - self.height;
        width: min(msg.preferred-width + 36px, parent.width - 32px);
        height: 30px;
        background: F.edge;
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            background: #120f24;
        }
        Rectangle { x: 0; y: 0; width: 4px; height: parent.height; background: F.gold; }
        msg := Text {
            x: 16px;
            width: parent.width - 26px;
            height: parent.height;
            text: root.text;
            color: #ffffff;
            font-family: F.body;
            font-size: 12.5px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// The footer of a page: a dark bar under a line, its contents in a row.
component Footer inherits Rectangle {
    height: 52px;
    vertical-stretch: 0;
    background: #0b0915;
    Rectangle { x: 0; y: 0; width: parent.width; height: 2px; background: F.line; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 2px;
        spacing: 10px;
        @children
    }
}

// A slanted key with an icon and its word (RENAME, DELETE, BROWSE).
component WordKey inherits Key {
    in property <string> text;
    in property <string> icon;
    in property <bool> after;
    in property <int> kind;
    height: 26px;
    width: wk-row.preferred-width;
    body: root.kind == 1 ? F.gold : root.kind == 2 ? F.p1 : F.panel2;
    hot-body: root.kind == 1 ? #ffe066 : root.kind == 2 ? #ff5a6e : #2a2350;
    rim: root.kind != 0 ? #000000 : root.hot ? #5a4f96 : F.edge;
    rim-w: root.kind != 0 ? 2px : 1px;
    wk-row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        opacity: root.enabled ? 1 : 0.38;
        if root.icon != "" && !root.after: Icon {
            name: root.icon;
            tint: root.kind == 1 ? #000000 : #e9e4ff;
            stroke-width: 2.2px;
            width: 11px;
            height: 11px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.kind == 1 ? #000000 : root.kind == 2 ? #ffffff : #e9e4ff;
            font-family: F.disp;
            font-size: 12px;
            letter-spacing: 1.4px;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.icon != "" && root.after: Icon {
            name: root.icon;
            tint: root.kind == 1 ? #000000 : #e9e4ff;
            stroke-width: 2.4px;
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
        }
    }
}

// A thin slanted progress bar: a dark red well filling gold (cyan for `cyan`).
component Bar inherits Rectangle {
    in property <float> value;
    in property <bool> cyan;
    height: 10px;
    Skew { width: 100%; height: 100%; k: F.k24; body: #2a0a12; rim: #000000; rim-w: 2px; }
    Skew {
        visible: root.value > 0.005;
        x: 2px;
        y: 2px;
        width: max(6px, (root.width - 4px) * clamp(root.value, 0, 1));
        height: root.height - 4px;
        k: F.k24;
        body: root.cyan ? @linear-gradient(180deg, #b8f6ff 0%, F.cyan 40%, #0f8fb0 100%) : @linear-gradient(180deg, #fff27a 0%, F.gold 35%, F.gold2 100%);
    }
}

// ---------- One clip ----------

// The clip's waveform as the stage: a black well, the played part gold, the rest violet,
// the trimmed ends dark, gold trim brackets and a red play head. TrimTouch drags the
// handles and seeks.
component StageWave inherits Rectangle {
    callback trimmed(float, float);
    callback tapped();
    property <bool> active: Main.active-clip == Main.selected;
    property <float> played: root.active ? clamp(Main.play-fraction, 0, 1) : 0;
    property <length> pad: 8px;
    property <length> inner-w: root.width - 2 * root.pad;
    property <int> n: max(1, floor(root.inner-w / 4px));
    property <length> start-x: Pages.trim-start * root.inner-w;
    property <length> end-x: Pages.trim-end * root.inner-w;
    accessible-role: none;
    Rectangle {
        background: F.edge;
        Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; background: #000000; }
        Rectangle { x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; background: #07060e; }
    }
    Rectangle {
        x: root.pad;
        y: 6px;
        width: root.inner-w;
        height: root.height - 12px;
        for i in root.n: Rectangle {
            property <float> f: (i + 0.5) / root.n;
            property <float> v: Pages.detail-wave.length > 0 ? Pages.detail-wave[floor(i * Pages.detail-wave.length / root.n)] : 0.06;
            property <length> h: max(2px, round(clamp(self.v, 0, 1) * parent.height / 1px) * 1px);
            x: i * 4px + 1px;
            y: (parent.height - self.h) / 2;
            width: 2px;
            height: self.h;
            background: self.f < Pages.trim-start || self.f > Pages.trim-end ? #2c2650 : self.f <= root.played ? F.gold : #6d64a3;
        }
        // The trim brackets.
        for k in [0, 1]: Rectangle {
            property <length> at: k == 0 ? max(1px, root.start-x) : min(root.inner-w - 1px, root.end-x);
            property <bool> hot: touch.grab == k + 1 || (touch.has-hover && abs(touch.at - (k == 0 ? root.start-x : root.end-x)) <= 8px);
            x: self.at - 1px - (k == 0 ? 0 : 6px);
            y: -3px;
            width: 8px;
            height: parent.height + 6px;
            Rectangle { x: k == 0 ? 0 : 6px; y: 0; width: 2px; height: parent.height; background: parent.hot ? #fff27a : F.gold; }
            Rectangle { x: 0; y: 0; width: 8px; height: 2px; background: parent.hot ? #fff27a : F.gold; }
            Rectangle { x: 0; y: parent.height - 2px; width: 8px; height: 2px; background: parent.hot ? #fff27a : F.gold; }
        }
        Rectangle {
            visible: root.active;
            x: root.played * root.inner-w - 1px;
            y: -6px;
            width: 2px;
            height: parent.height + 12px;
            background: F.p1;
        }
    }
    touch := TrimTouch {
        pad: root.pad;
        trimmed(a, b) => { root.trimmed(a, b); }
        tapped => { root.tapped(); }
    }
}

// The round counter: where the clip is, gold with a hard red shadow, and OF its length
// under it (or beside it, `inline`).
component Counter inherits Rectangle {
    in property <length> size: 30px;
    in property <bool> right;
    in property <bool> inline;
    property <bool> active: Main.active-clip == Main.selected;
    property <string> pos: root.active ? Main.play-position : "0:00";
    property <string> total: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].duration : "";
    property <length> fig-h: round(root.size * 1.05 / 1px) * 1px;
    accessible-role: AccessibleRole.text;
    accessible-label: (root.active && Main.playing ? "Playing " : root.active ? "Paused " : "Stopped ") + root.pos + " of " + root.total;
    width: root.inline ? face.preferred-width + 14px + of.preferred-width : max(face.preferred-width + 2px, of.preferred-width);
    height: root.inline ? root.fig-h + 2px : root.fig-h + 16px;
    Rectangle {
        x: root.right && !root.inline ? root.width - self.width : 0;
        y: 0;
        height: root.fig-h + 2px;
        width: face.preferred-width + 2px;
        Text {
            x: 2px;
            y: 2px;
            height: root.fig-h;
            vertical-alignment: center;
            text: root.pos;
            color: F.p1d;
            font-family: F.figures;
            font-size: root.size;
            letter-spacing: 1px;
            accessible-role: none;
        }
        face := Text {
            x: 0;
            y: 0;
            height: root.fig-h;
            vertical-alignment: center;
            text: root.pos;
            color: F.gold;
            font-family: F.figures;
            font-size: root.size;
            letter-spacing: 1px;
            accessible-role: none;
        }
    }
    of := Text {
        x: root.inline ? face.preferred-width + 14px : root.right ? root.width - self.width : 0;
        y: root.inline ? root.fig-h - 16px : root.fig-h + 3px;
        height: 12px;
        text: "OF " + root.total;
        color: F.dim;
        font-family: F.body;
        font-size: root.inline ? 11px : 9px;
        font-weight: 700;
        letter-spacing: 2.2px;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// The portrait of the clip's fighter in its red frame, with the P1 tag.
component Portrait inherits Rectangle {
    Rectangle { x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px; background: F.p1; }
    Rectangle { background: #000000; }
    FiPortrait { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; pose: Main.selected; }
    Rectangle {
        x: 0;
        y: 0;
        width: p1.preferred-width + 10px;
        height: 15px;
        background: F.p1;
        p1 := Text {
            text: "P1";
            color: #ffffff;
            font-family: F.lean;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The clip's name in the slanted type, the line about it (the file name in cyan) and the
// rename field while renaming.
component Profile inherits VerticalLayout {
    in property <bool> big;
    callback rename(string);
    callback cancel-rename();
    property <string> name: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].name : "";
    spacing: 4px;
    Text {
        text: root.name;
        color: #ffffff;
        font-family: F.lean;
        // Wide: a long name steps down, so "clip_101 merged" fits the narrow column.
        font-size: root.big ? (root.name.character-count > 10 ? 30px : 40px) : 26px;
        letter-spacing: 1px;
        overflow: elide;
    }
    HorizontalLayout {
        Text {
            text: Pages.detail-head;
            color: F.dim;
            font-family: F.body;
            font-size: 10.5px;
            font-weight: 600;
            overflow: elide;
            horizontal-stretch: 0;
        }
        Text {
            text: Pages.detail-file != "" ? " · " : "";
            color: F.dim;
            font-family: F.body;
            font-size: 10.5px;
            font-weight: 600;
            horizontal-stretch: 0;
        }
        Text {
            text: Pages.detail-file;
            color: F.cyan;
            font-family: F.body;
            font-size: 10.5px;
            font-weight: 700;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

// The rename field with Cancel and Rename under it.
component RenameBox inherits VerticalLayout {
    callback rename(string);
    callback cancel();
    property <string> name: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].name : "";
    spacing: 10px;
    field := Field {
        height: 34px;
        font-size: 15px;
        label: "Clip name";
        text: root.name;
        grab-at-start: true;
        accepted(t) => { root.rename(t); }
    }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: Pages.detail-meta;
            color: F.dim;
            font-family: F.body;
            font-size: 10.5px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Btn { height: 26px; text: "Cancel"; clicked => { root.cancel(); } }
        Btn { height: 26px; primary: true; text: "Rename"; clicked => { root.rename(field.text); } }
    }
}

// The speed: five slanted cells with their values, the picked one gold.
component Speed inherits VerticalLayout {
    callback picked(int);
    spacing: 3px;
    alignment: end;
    Label { text: "SPEED"; font-size: 8.5px; height: 10px; }
    HorizontalLayout {
        spacing: 3px;
        accessible-role: list;
        accessible-label: "Speed";
        for v[i] in ["0.75", "1.0", "1.25", "1.5", "2.0"]: Rectangle {
            property <bool> on: i == Pages.speed-index;
            width: 32px;
            height: 22px;
            accessible-role: button;
            accessible-label: v + "×";
            accessible-checked: self.on;
            accessible-action-default => { Pages.speed-index = i; root.picked(i); }
            Skew {
                width: 100%;
                height: 100%;
                body: parent.on ? F.gold : st.has-hover ? #2a2350 : F.panel2;
                rim: parent.on ? #000000 : F.edge;
            }
            Text {
                text: v;
                color: parent.on ? #000000 : F.text2;
                font-family: F.body;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
            st := TouchArea {
                mouse-cursor: pointer;
                clicked => { Pages.speed-index = i; root.picked(i); }
            }
        }
    }
}

// A skip key with its 5 in a small gold box.
component Skip inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked;
    width: 34px;
    height: 30px;
    IconBtn {
        x: 0;
        y: 0;
        size: 34px;
        height: 30px;
        icon: root.icon;
        icon-size: 14px;
        label: root.label;
        tip: root.label;
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: parent.width - 10px;
        y: -7px;
        width: 14px;
        height: 13px;
        background: F.gold;
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            background: #000000;
            Text {
                text: "5";
                color: F.gold;
                font-family: F.lean;
                font-size: 9.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
}

// The transport: back 5 seconds, the big Replay key (red while it plays), forward 5
// seconds, the speed and Loop.
component Transport inherits HorizontalLayout {
    callback toggle-play();
    callback skip(float);
    callback speed-changed(int);
    callback refocus();
    property <bool> playing: Main.active-clip == Main.selected && Main.playing;
    vertical-stretch: 0;
    spacing: 8px;
    VerticalLayout {
        alignment: end;
        Skip { icon: "rewind"; label: "Back 5 seconds"; clicked => { root.skip(-5); root.refocus(); } }
    }
    VerticalLayout {
        alignment: end;
        Key {
            width: 48px;
            height: 36px;
            body: root.playing ? @linear-gradient(180deg, #ff5a6e 0%, F.p1 55%, #c0102a 100%) : F.gold;
            hot-body: root.playing ? #ff5a6e : #ffe066;
            rim: #000000;
            rim-w: 2px;
            label: root.playing ? "Pause" : "Play";
            tip: root.playing ? "Pause" : "Play";
            clicked => { root.toggle-play(); root.refocus(); }
            Glyph {
                x: 17px;
                y: 11px;
                width: 14px;
                height: 14px;
                view: 12;
                solid: root.playing ? G.pause : G.play;
                tint: root.playing ? #ffffff : #000000;
            }
        }
    }
    VerticalLayout {
        alignment: end;
        Skip { icon: "forward"; label: "Forward 5 seconds"; clicked => { root.skip(5); root.refocus(); } }
    }
    Rectangle { width: 4px; }
    Speed { picked(i) => { root.speed-changed(i); root.refocus(); } }
    Rectangle { horizontal-stretch: 1; }
    VerticalLayout {
        alignment: end;
        Btn {
            height: 26px;
            text: "Loop";
            on: Pages.looping;
            clicked => { Pages.looping = !Pages.looping; root.refocus(); }
        }
    }
}

// Clean voice on export: the switch, the words in the slanted type and what it does.
component CleanVoice inherits HorizontalLayout {
    callback changed-to(bool);
    spacing: 10px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Toggle {
            label: "Clean voice on export";
            checked <=> Pages.clean-voice;
            toggled(on) => { root.changed-to(on); }
        }
    }
    Text {
        text: "CLEAN VOICE ON EXPORT";
        color: #ffffff;
        font-family: F.lean;
        font-size: 12.5px;
        letter-spacing: 1.5px;
        vertical-alignment: center;
        accessible-role: none;
    }
    Text {
        text: "Less noise";
        color: F.dim;
        font-family: F.body;
        font-size: 11.5px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

// The transcript panel: TRANSCRIPT (SUMMARY, TRANSLATION) on its red tag, the frame and tag
// gold while it is edited.
component StoryPanel inherits Panel {
    tag: Pages.editing ? "EDITING" : Pages.show-summary && (Pages.summary != "" || Pages.summarising) ? "SUMMARY"
        : Pages.shown-lang != "" ? "TRANSLATION" : "TRANSCRIPT";
    tone: Pages.editing ? 1 : 0;
    hot: Pages.editing;
}

// A merged clip's parts, as numbered name plates that can be put in another order.
component Parts inherits Panel {
    callback moved(int, int);
    callback take-out(int);
    callback rename(int);
    tag: "PARTS";
    height: parts-box.preferred-height;
    parts-box := VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 16px;
        padding-bottom: 4px;
        if Pages.parts-busy: Text {
            height: 14px;
            text: "WORKING";
            color: F.gold;
            font-family: F.body;
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: 2px;
            horizontal-alignment: right;
        }
        OrderList {
            rows: Pages.parts;
            menu: true;
            enabled: !Pages.parts-busy && !Main.recording;
            moved(a, b) => { root.moved(a, b); }
            act(i) => { root.take-out(i); }
            rename(i) => { root.rename(i); }
        }
    }
}

// The footer of the clip page: the latest message (or the export running) and the red
// Export key.
component ClipFooter inherits Footer {
    callback refocus();
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Strip { text: Main.export-state == 1 ? "Exporting " + Main.export-name : Main.status; }
    }
    VerticalLayout {
        alignment: center;
        ExportButton {
            width: 128px;
            height: 36px;
            format: Pages.export-format;
            subtitles: Pages.transcript != "";
            state: Main.export-state;
            progress: Main.export-progress;
            export(kind) => { Main.export-as(kind); root.refocus(); }
        }
    }
}

// The one-clip page, the fighter's profile. Portrait: the profile panel (portrait, name,
// Rename and Delete, the counter), the stage panel (waveform and transport), the parts of a
// merged clip, the transcript panel, Clean voice and the footer. Wide: the profile, the
// stage and the options on the left, the parts and the transcript on the right.
export component ClipPage inherits Page {
    in property <bool> narrow;
    in property <bool> wide;
    callback go(int);
    callback refocus();
    // Leaving the editor asks about unsaved changes first (AppWindow.leave-editor).
    callback leave-editor(int);
    callback start-edit();
    callback ask-delete(int);
    callback rename-selected(string);
    callback toggle-play();
    callback skip(float);
    callback speed-changed(int);
    callback trim-changed(float, float);
    callback clean-voice-changed(bool);
    callback parts-move(int, int);
    callback part-take-out(int);
    callback rename-part(int);
    // The transcript card's actions (see TranscriptCard).
    callback choose-lang(string);
    callback lang-filter(string);
    callback install-for(int);
    callback summarise();
    callback edit-changed(string);
    callback apply-transcript(string);
    callback transcribe();
    callback seek-word(int);
    pure callback edit-markup(string) -> styled-text;
    pure callback plain-selection(string, int, int) -> string;

    property <string> name: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].name : "";

    function rename(t: string) {
        Pages.renaming = false;
        root.rename-selected(t);
        root.refocus();
    }

    VerticalLayout {
        PageTitle {
            back-text: "CLIPS";
            back-label: "Back to Clips";
            sub: "PROFILE";
            back => { if (Pages.editing) { root.leave-editor(0); } else { root.go(0); } }
        }

        // Portrait.
        if !root.wide: VerticalLayout {
            vertical-stretch: 1;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 18px;
            padding-bottom: 6px;
            spacing: 16px;
            Panel {
                tag: "FIGHTER";
                height: pro.preferred-height;
                pro := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 16px;
                    padding-bottom: 12px;
                    spacing: 12px;
                    if !Pages.renaming: VerticalLayout {
                        Portrait { width: 64px; height: 70px; }
                    }
                    if !Pages.renaming: VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Profile { }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            IconBtn {
                                size: 28px;
                                height: 24px;
                                icon: "pencil";
                                icon-size: 12px;
                                label: "Rename clip";
                                tip: "Rename";
                                enabled: !Main.recording;
                                clicked => { Pages.renaming = true; }
                            }
                            IconBtn {
                                size: 28px;
                                height: 24px;
                                icon: "trash";
                                icon-size: 12px;
                                label: "Delete clip";
                                tip: "Delete";
                                enabled: !Main.recording;
                                clicked => { root.ask-delete(Main.selected); }
                            }
                        }
                    }
                    if !Pages.renaming: VerticalLayout {
                        alignment: center;
                        Counter { right: true; }
                    }
                    if Pages.renaming: VerticalLayout {
                        RenameBox {
                            horizontal-stretch: 1;
                            rename(t) => { root.rename(t); }
                            cancel => { Pages.renaming = false; root.refocus(); }
                        }
                    }
                }
            }
            Panel {
                tag: "STAGE";
                tone: 1;
                height: stage.preferred-height;
                stage := VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 16px;
                    padding-bottom: 10px;
                    spacing: 12px;
                    StageWave {
                        height: 52px;
                        trimmed(a, b) => { root.trim-changed(a, b); }
                        tapped => { root.refocus(); }
                    }
                    Transport {
                        toggle-play => { root.toggle-play(); }
                        skip(s) => { root.skip(s); }
                        speed-changed(i) => { root.speed-changed(i); }
                        refocus => { root.refocus(); }
                    }
                }
            }
            if Pages.parts.length >= 2: VerticalLayout {
                Parts {
                    moved(a, b) => { root.parts-move(a, b); }
                    take-out(i) => { root.part-take-out(i); }
                    rename(i) => { root.rename-part(i); }
                }
            }
            StoryPanel {
                vertical-stretch: 1;
                min-height: 60px;
                // Cut to the panel when the parts leave it little room.
                Rectangle {
                    clip: true;
                    TranscriptCard {
                        clip-name: root.name;
                        transcript: Pages.transcript;
                        transcribing: Pages.transcribing;
                        translating: Pages.translating;
                        translation: Pages.translation;
                        shown-lang <=> Pages.shown-lang;
                        langs: Pages.langs;
                        summary: Pages.summary;
                        summarising: Pages.summarising;
                        can-ai: Main.can-ai;
                        show-summary <=> Pages.show-summary;
                        transcribe-progress: Pages.transcribe-progress;
                        words: Pages.words;
                        current-word: Pages.current-word;
                        show-marks <=> Pages.show-marks;
                        can-transcribe: Pages.can-transcribe;
                        recording: Main.recording;
                        editing: Pages.editing;
                        edit-draft <=> Pages.edit-draft;
                        edit-badge: Pages.edit-badge;
                        speaking: Pages.speaking;
                        x: 12px;
                        y: 14px;
                        width: parent.width - 24px;
                        height: parent.height - 24px;
                        choose-lang(c) => { root.choose-lang(c); }
                        lang-filter(t) => { root.lang-filter(t); }
                        install-for(k) => { root.install-for(k); }
                        summarise => { root.summarise(); }
                        edit => { root.start-edit(); }
                        edited(t) => { root.edit-changed(t); }
                        cancel => { root.leave-editor(-1); }
                        save => { root.apply-transcript(Pages.edit-draft); }
                        edit-markup(t) => { return root.edit-markup(t); }
                        plain-selection(t, a, b) => { return root.plain-selection(t, a, b); }
                        transcribe => { root.transcribe(); root.refocus(); }
                        seek-word(i) => { root.seek-word(i); root.refocus(); }
                    }
                }
            }
            CleanVoice {
                height: 24px;
                vertical-stretch: 0;
                changed-to(on) => { root.clean-voice-changed(on); }
            }
        }

        // Wide.
        if root.wide: HorizontalLayout {
            vertical-stretch: 1;
            Rectangle {
                width: 440px;
                background: @linear-gradient(180deg, #1f1027 0%, #110e20 60%);
                Rectangle { x: parent.width - 2px; y: 0; width: 2px; height: parent.height; background: #000000; }
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 18px;
                    padding-top: 14px;
                    padding-bottom: 12px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 14px;
                        height: 172px;
                        vertical-stretch: 0;
                        if !Pages.renaming: VerticalLayout {
                            padding: 2px;
                            Portrait { width: 136px; height: 164px; }
                        }
                        if !Pages.renaming: VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 10px;
                            HorizontalLayout {
                                alignment: end;
                                spacing: 6px;
                                WordKey {
                                    text: "RENAME";
                                    icon: "pencil";
                                    label: "Rename clip";
                                    tip: "Rename";
                                    enabled: !Main.recording;
                                    clicked => { Pages.renaming = true; }
                                }
                                WordKey {
                                    text: "DELETE";
                                    icon: "trash";
                                    label: "Delete clip";
                                    tip: "Delete";
                                    enabled: !Main.recording;
                                    clicked => { root.ask-delete(Main.selected); }
                                }
                            }
                            Profile { big: true; }
                            // In a start aligned row: the counter's fixed width would otherwise
                            // cap the column's width and cut the name short.
                            HorizontalLayout {
                                alignment: start;
                                Counter { size: 44px; inline: true; }
                            }
                        }
                        if Pages.renaming: VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            RenameBox {
                                rename(t) => { root.rename(t); }
                                cancel => { Pages.renaming = false; root.refocus(); }
                            }
                        }
                    }
                    Heading { first: "THE "; second: "STAGE"; size: 16px; height: 22px; vertical-stretch: 0; }
                    StageWave {
                        height: clamp(root.height - 520px, 64px, 96px);
                        vertical-stretch: 0;
                        trimmed(a, b) => { root.trim-changed(a, b); }
                        tapped => { root.refocus(); }
                    }
                    HorizontalLayout {
                        height: 12px;
                        vertical-stretch: 0;
                        Text {
                            text: Main.active-clip == Main.selected ? Main.play-position : "0:00";
                            color: F.gold;
                            font-family: F.body;
                            font-size: 10.5px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].duration : "";
                            color: F.dim;
                            font-family: F.body;
                            font-size: 10.5px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            horizontal-alignment: right;
                        }
                    }
                    Transport {
                        toggle-play => { root.toggle-play(); }
                        skip(s) => { root.skip(s); }
                        speed-changed(i) => { root.speed-changed(i); }
                        refocus => { root.refocus(); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Panel {
                        tag: "OPTIONS";
                        tone: 1;
                        height: 50px;
                        vertical-stretch: 0;
                        CleanVoice {
                            x: 12px;
                            y: 14px;
                            width: parent.width - 24px;
                            height: 28px;
                            changed-to(on) => { root.clean-voice-changed(on); }
                        }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 20px;
                padding-bottom: 12px;
                spacing: 20px;
                if Pages.parts.length >= 2: VerticalLayout {
                    Parts {
                        moved(a, b) => { root.parts-move(a, b); }
                        take-out(i) => { root.part-take-out(i); }
                        rename(i) => { root.rename-part(i); }
                    }
                }
                StoryPanel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        padding-top: 16px;
                        padding-bottom: 12px;
                        TranscriptCard {
                            clip-name: root.name;
                            transcript: Pages.transcript;
                            transcribing: Pages.transcribing;
                            translating: Pages.translating;
                            translation: Pages.translation;
                            shown-lang <=> Pages.shown-lang;
                            langs: Pages.langs;
                            summary: Pages.summary;
                            summarising: Pages.summarising;
                            can-ai: Main.can-ai;
                            show-summary <=> Pages.show-summary;
                            transcribe-progress: Pages.transcribe-progress;
                            words: Pages.words;
                            current-word: Pages.current-word;
                            show-marks <=> Pages.show-marks;
                            can-transcribe: Pages.can-transcribe;
                            recording: Main.recording;
                            editing: Pages.editing;
                            edit-draft <=> Pages.edit-draft;
                            edit-badge: Pages.edit-badge;
                            speaking: Pages.speaking;
                            vertical-stretch: 1;
                            choose-lang(c) => { root.choose-lang(c); }
                            lang-filter(t) => { root.lang-filter(t); }
                            install-for(k) => { root.install-for(k); }
                            summarise => { root.summarise(); }
                            edit => { root.start-edit(); }
                            edited(t) => { root.edit-changed(t); }
                            cancel => { root.leave-editor(-1); }
                            save => { root.apply-transcript(Pages.edit-draft); }
                            edit-markup(t) => { return root.edit-markup(t); }
                            plain-selection(t, a, b) => { return root.plain-selection(t, a, b); }
                            transcribe => { root.transcribe(); root.refocus(); }
                            seek-word(i) => { root.seek-word(i); root.refocus(); }
                        }
                    }
                }
            }
        }

        ClipFooter { refocus => { root.refocus(); } }
    }
}

// ---------- Settings ----------

// A tagged panel of settings; its rows follow.
component Card inherits Panel {
    in property <string> title;
    tag: root.title;
    height: unit.preferred-height;
    unit := VerticalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 14px;
        padding-bottom: 4px;
        @children
    }
}

// Split out of SRow, so its copies share it (see docs/device-themes.md, "Generated code size").
component SRowText inherits VerticalLayout {
    in property <string> label;
    in property <string> note;
    alignment: center;
    spacing: 1px;
    horizontal-stretch: 1;
    Text {
        text: root.label;
        color: #ffffff;
        font-family: F.body;
        font-size: 13px;
        font-weight: 700;
        overflow: elide;
    }
    if root.note != "": Text {
        text: root.note;
        color: F.dim;
        font-family: F.body;
        font-size: 10.5px;
        font-weight: 600;
        overflow: elide;
    }
}

// One line of a panel: its name (and a note under it) and its controls.
component SRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <bool> first;
    min-height: 38px;
    Rectangle { visible: !root.first; x: 0; y: 0; width: parent.width; height: 1px; background: #1f1a3a; }
    HorizontalLayout {
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 8px;
        SRowText { label: root.label; note: root.note; }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            @children
        }
    }
}

// A value on the right of a row: OmniVoice, Downloading 64%.
component Value inherits Text {
    color: F.text2;
    font-family: F.body;
    font-size: 12.5px;
    font-weight: 700;
    vertical-alignment: center;
}

// The Files panel: the folder with Open and Change, the file name with the next name under
// it, the export format and Clean voice.
component FilesCard inherits Card {
    in property <bool> wide;
    callback refocus();
    callback open-folder();
    callback change-folder();
    callback template-edited(string);
    callback template-accepted(string);
    callback export-format-changed(int);
    callback clean-voice-changed(bool);
    title: "FILES";
    SRow {
        first: true;
        label: "Folder";
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: min(path.preferred-width + 18px, root.wide ? 130px : 170px);
                height: 24px;
                background: Fi.well;
                Rectangle {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    background: #07060e;
                }
                path := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: Pages.folder;
                    color: F.text2;
                    font-family: F.body;
                    font-size: 11.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconBtn {
                size: 28px;
                height: 24px;
                icon: "folder";
                label: "Open the folder";
                tip: "Open folder";
                clicked => { root.open-folder(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn { text: "Change"; height: 24px; font-size: 11px; enabled: !Main.recording; clicked => { root.change-folder(); } }
        }
    }
    Rectangle {
        height: names.preferred-height;
        Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: #1f1a3a; }
        names := VerticalLayout {
            padding-top: 8px;
            padding-bottom: 9px;
            padding-right: 6px;
            spacing: 6px;
            Text {
                text: "File name";
                color: #ffffff;
                font-family: F.body;
                font-size: 13px;
                font-weight: 700;
            }
            Field {
                height: 32px;
                font-size: 13.5px;
                label: "File name";
                text: Pages.name-template;
                invalid: Pages.name-invalid;
                edited(t) => { root.template-edited(t); }
                accepted(t) => { root.template-accepted(t); root.refocus(); }
            }
            Text {
                text: Pages.name-preview;
                color: Pages.name-invalid ? Fi.danger : F.dim;
                font-family: F.body;
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: 0.3px;
                overflow: elide;
            }
        }
    }
    SRow {
        label: "Export format";
        VerticalLayout {
            alignment: center;
            Select {
                width: min(self.natural, 220px);
                height: 28px;
                label: "Export format";
                model: ["FLAC", "WAV", "MP3"];
                current-index <=> Pages.export-format;
                selected(i) => { root.export-format-changed(i); }
            }
        }
    }
    SRow {
        label: "Clean voice on export";
        VerticalLayout {
            alignment: center;
            Toggle {
                label: "Clean voice on export";
                checked <=> Pages.clean-voice;
                toggled(on) => { root.clean-voice-changed(on); }
            }
        }
    }
}

// The Transcription panel.
component TranscriptionCard inherits Card {
    callback go(int);
    callback language-changed(int);
    callback auto-transcribe-changed(bool);
    callback ai-names-changed(bool);
    callback max-pause-changed(int);
    title: "TRANSCRIPTION";
    if !Pages.can-transcribe: SRow { first: true; label: "Not in this build"; }
    if Pages.can-transcribe: SRow {
        first: true;
        label: "Language";
        VerticalLayout {
            alignment: center;
            Select {
                width: min(self.natural, 220px);
                height: 28px;
                label: "Language";
                model: Pages.languages;
                current-index <=> Pages.language-index;
                selected(i) => { root.language-changed(i); }
            }
        }
    }
    if Pages.can-transcribe: SRow {
        label: "Auto transcribe";
        VerticalLayout {
            alignment: center;
            Toggle {
                label: "Auto transcribe";
                checked <=> Pages.auto-transcribe;
                toggled(on) => { root.auto-transcribe-changed(on); }
            }
        }
    }
    if Pages.can-transcribe && Main.can-ai: SRow {
        label: "AI names";
        note: Pages.auto-transcribe ? "" : "Auto transcribe off";
        VerticalLayout {
            alignment: center;
            Toggle {
                label: "AI names";
                enabled: Pages.auto-transcribe;
                checked <=> Pages.ai-names;
                toggled(on) => { root.ai-names-changed(on); }
            }
        }
    }
    if Pages.can-transcribe: SRow {
        label: "Max pause";
        VerticalLayout {
            alignment: center;
            Select {
                width: min(self.natural, 220px);
                height: 28px;
                label: "Max pause";
                model: Pages.max-pauses;
                current-index <=> Pages.max-pause-index;
                selected(i) => { root.max-pause-changed(i); }
            }
        }
    }
    if Pages.can-transcribe: SRow {
        label: "Model";
        note: Pages.model-summary;
        VerticalLayout {
            alignment: center;
            WordKey {
                text: "BROWSE";
                icon: "chevron";
                after: true;
                kind: 1;
                label: "Browse models";
                tip: "Browse";
                clicked => { root.go(4); }
            }
        }
    }
}

// The AI panel: the model, whether it is ready (a green dot) or downloading (a bar), and
// the translator.
component AiCard inherits Card {
    callback ai-model-changed(int);
    callback download-ai(int);
    title: "AI";
    SRow {
        first: true;
        label: "AI model";
        VerticalLayout {
            alignment: center;
            Select {
                width: min(self.natural, 220px);
                height: 28px;
                label: "AI model";
                model: Pages.ai-models;
                current-index <=> Pages.ai-model-index;
                selected(i) => { root.ai-model-changed(i); }
            }
        }
    }
    SRow {
        label: Pages.ai-ready ? "Ready" : Pages.ai-download >= 0 ? "Downloading " + round(Pages.ai-download * 100) + "%" : "Not downloaded";
        if Pages.ai-ready: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: F.green;
            }
        }
        if !Pages.ai-ready && Pages.ai-download >= 0: VerticalLayout {
            alignment: center;
            Bar { width: 110px; value: Pages.ai-download; }
        }
        if !Pages.ai-ready && Pages.ai-download < 0: VerticalLayout {
            alignment: center;
            Btn { height: 26px; primary: true; text: "Download"; clicked => { root.download-ai(0); } }
        }
    }
    SRow {
        label: "Translation";
        note: "Ministral 3B · 2.1 GB";
        if Pages.translator-ready: Value { text: "Ready"; color: F.gold; }
        if !Pages.translator-ready && Pages.translator-download >= 0: Value {
            text: "Downloading " + round(Pages.translator-download * 100) + "%";
            color: F.gold;
        }
        if !Pages.translator-ready && Pages.translator-download < 0: VerticalLayout {
            alignment: center;
            Btn { height: 26px; primary: true; text: "Download"; clicked => { root.download-ai(1); } }
        }
    }
}

// Your voice.
component VoiceCard inherits Card {
    title: "YOUR VOICE";
    SRow {
        first: true;
        label: "Voice engine";
        Value { text: "OmniVoice"; }
    }
    SRow {
        label: "Voice sample";
        Value { text: "20 s from the clip"; }
    }
}

// The Recording panel.
component RecordingCard inherits Card {
    callback refocus();
    callback mic-changed(int);
    callback system-changed(bool);
    callback recording-limit-changed(int);
    callback hotkey-captured(string, bool, bool, bool, bool) -> bool;
    callback hotkey-accepted(string);
    title: "RECORDING";
    SRow {
        first: true;
        label: "Microphone";
        VerticalLayout {
            alignment: center;
            Select {
                width: min(self.natural, 220px);
                height: 28px;
                label: "Microphone";
                model: Pages.mic-devices;
                current-index <=> Pages.mic-index;
                enabled: !Main.recording;
                selected(i) => { root.mic-changed(i); }
            }
        }
    }
    SRow {
        label: "System audio";
        VerticalLayout {
            alignment: center;
            Toggle {
                label: "System audio";
                checked <=> Pages.record-system;
                toggled(on) => { root.system-changed(on); }
            }
        }
    }
    SRow {
        label: "Stop recording after";
        VerticalLayout {
            alignment: center;
            Select {
                width: min(self.natural, 220px);
                height: 28px;
                label: "Stop recording after";
                model: Pages.recording-limits;
                current-index <=> Pages.recording-limit-index;
                selected(i) => { root.recording-limit-changed(i); }
            }
        }
    }
    SRow {
        label: "Record hotkey";
        VerticalLayout {
            alignment: center;
            ShortcutBox {
                label: "Record hotkey";
                keys: Pages.hotkey-parts;
                captured(text, ctrl, alt, shift, meta) => { return root.hotkey-captured(text, ctrl, alt, shift, meta); }
                cleared => { root.hotkey-accepted(""); }
                done => { root.refocus(); }
            }
        }
        if Pages.hotkey-parts.length > 0: VerticalLayout {
            alignment: center;
            IconBtn {
                size: 24px;
                height: 22px;
                icon: "close";
                icon-size: 12px;
                label: "Clear the shortcut";
                tip: "Clear shortcut";
                clicked => { root.hotkey-accepted(""); }
            }
        }
    }
}

// The Window panel.
component WindowCard inherits Card {
    callback close-to-tray-changed(bool);
    callback start-with-windows-changed(bool);
    title: "WINDOW";
    SRow {
        first: true;
        label: "Close button hides to tray";
        VerticalLayout {
            alignment: center;
            Toggle {
                label: "Close button hides to tray";
                checked <=> Pages.close-to-tray;
                toggled(on) => { root.close-to-tray-changed(on); }
            }
        }
    }
    SRow {
        label: "Start with Windows";
        VerticalLayout {
            alignment: center;
            Toggle {
                label: "Start with Windows";
                checked <=> Pages.start-with-windows;
                toggled(on) => { root.start-with-windows-changed(on); }
            }
        }
    }
}

export component SettingsPage inherits Page {
    in property <bool> wide;
    callback back();
    callback go(int);
    callback refocus();
    callback theme-changed(int);
    callback mic-changed(int);
    callback system-changed(bool);
    callback recording-limit-changed(int);
    callback hotkey-captured(string, bool, bool, bool, bool) -> bool;
    callback hotkey-accepted(string);
    callback open-folder();
    callback change-folder();
    callback template-edited(string);
    callback template-accepted(string);
    callback export-format-changed(int);
    callback clean-voice-changed(bool);
    callback language-changed(int);
    callback auto-transcribe-changed(bool);
    callback ai-names-changed(bool);
    callback max-pause-changed(int);
    callback ai-model-changed(int);
    callback download-ai(int);
    callback close-to-tray-changed(bool);
    callback start-with-windows-changed(bool);

    VerticalLayout {
        PageTitle { sub: "OPTIONS"; back => { root.back(); } }
        HeadBand { Heading { first: "SET"; second: "TINGS"; } }
        Rectangle {
            vertical-stretch: 1;
            background: @linear-gradient(180deg, #1a1438 0%, #0d0b16 55%);
            Scroller {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 16px;
                    padding-top: 20px;
                    padding-bottom: 30px;
                    spacing: 20px;
                    alignment: start;
                    Card {
                        title: "APPEARANCE";
                        VerticalLayout {
                            padding-bottom: 4px;
                            ThemeGallery { picked(i) => { root.theme-changed(i); } }
                        }
                    }
                    // Wide: the panels in three columns under the gallery. Portrait: one
                    // column, as the mockup stacks them.
                    HorizontalLayout {
                        spacing: 20px;
                        alignment: stretch;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 20px;
                            alignment: start;
                            RecordingCard {
                                refocus => { root.refocus(); }
                                mic-changed(i) => { root.mic-changed(i); }
                                system-changed(on) => { root.system-changed(on); }
                                recording-limit-changed(i) => { root.recording-limit-changed(i); }
                                hotkey-captured(text, ctrl, alt, shift, meta) => { return root.hotkey-captured(text, ctrl, alt, shift, meta); }
                                hotkey-accepted(t) => { root.hotkey-accepted(t); }
                            }
                            if root.wide: VerticalLayout {
                                WindowCard {
                                    close-to-tray-changed(on) => { root.close-to-tray-changed(on); }
                                    start-with-windows-changed(on) => { root.start-with-windows-changed(on); }
                                }
                            }
                            if !root.wide: VerticalLayout {
                                FilesCard {
                                    wide: false;
                                    refocus => { root.refocus(); }
                                    open-folder => { root.open-folder(); }
                                    change-folder => { root.change-folder(); }
                                    template-edited(t) => { root.template-edited(t); }
                                    template-accepted(t) => { root.template-accepted(t); }
                                    export-format-changed(i) => { root.export-format-changed(i); }
                                    clean-voice-changed(on) => { root.clean-voice-changed(on); }
                                }
                            }
                            if !root.wide: VerticalLayout {
                                TranscriptionCard {
                                    go(p) => { root.go(p); }
                                    language-changed(i) => { root.language-changed(i); }
                                    auto-transcribe-changed(on) => { root.auto-transcribe-changed(on); }
                                    ai-names-changed(on) => { root.ai-names-changed(on); }
                                    max-pause-changed(i) => { root.max-pause-changed(i); }
                                }
                            }
                            if !root.wide && Main.can-ai: VerticalLayout {
                                AiCard {
                                    ai-model-changed(i) => { root.ai-model-changed(i); }
                                    download-ai(k) => { root.download-ai(k); }
                                }
                            }
                            if !root.wide: VerticalLayout {
                                VoiceCard { }
                            }
                            if !root.wide: VerticalLayout {
                                WindowCard {
                                    close-to-tray-changed(on) => { root.close-to-tray-changed(on); }
                                    start-with-windows-changed(on) => { root.start-with-windows-changed(on); }
                                }
                            }
                        }
                        if root.wide: VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 20px;
                            alignment: start;
                            FilesCard {
                                wide: true;
                                refocus => { root.refocus(); }
                                open-folder => { root.open-folder(); }
                                change-folder => { root.change-folder(); }
                                template-edited(t) => { root.template-edited(t); }
                                template-accepted(t) => { root.template-accepted(t); }
                                export-format-changed(i) => { root.export-format-changed(i); }
                                clean-voice-changed(on) => { root.clean-voice-changed(on); }
                            }
                            VoiceCard { }
                        }
                        if root.wide: VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 20px;
                            alignment: start;
                            TranscriptionCard {
                                go(p) => { root.go(p); }
                                language-changed(i) => { root.language-changed(i); }
                                auto-transcribe-changed(on) => { root.auto-transcribe-changed(on); }
                                ai-names-changed(on) => { root.ai-names-changed(on); }
                                max-pause-changed(i) => { root.max-pause-changed(i); }
                            }
                            if Main.can-ai: VerticalLayout {
                                AiCard {
                                    ai-model-changed(i) => { root.ai-model-changed(i); }
                                    download-ai(k) => { root.download-ai(k); }
                                }
                            }
                        }
                    }
                }
            }
        }
        Toast { text: Main.status; }
    }
}

// ---------- Models ----------

// Quality or speed as five slanted cells, gold up to the value.
component Pips inherits HorizontalLayout {
    in property <string> label;
    in property <int> value;
    spacing: 6px;
    Text {
        text: root.label;
        color: F.dim;
        font-family: F.body;
        font-size: 8.5px;
        font-weight: 700;
        letter-spacing: 1.6px;
        vertical-alignment: center;
    }
    HorizontalLayout {
        spacing: 2px;
        alignment: start;
        for k in 5: VerticalLayout {
            alignment: center;
            Skew {
                width: 10px;
                height: 7px;
                k: F.k24;
                body: k < root.value ? F.gold : F.line;
            }
        }
    }
}

// A shelf chip: a slanted key, gold when it is the one picked.
component Shelf inherits Key {
    in property <string> text;
    in property <bool> on;
    height: 24px;
    width: chip-text.preferred-width + 22px;
    body: root.on ? F.gold : F.panel2;
    hot-body: root.on ? #ffe066 : #2a2350;
    rim: root.on ? #000000 : F.edge;
    accessible-checked: root.on;
    chip-text := Text {
        text: root.text.to-uppercase();
        color: root.on ? #000000 : F.text2;
        font-family: F.body;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// The shelves, wrapping onto a second row (portrait) or one under the other (wide).
component Shelves inherits Rectangle {
    in property <bool> column;
    callback changed();
    height: flow.preferred-height;
    flow := FlexboxLayout {
        flex-direction: root.column ? FlexboxLayoutDirection.column : FlexboxLayoutDirection.row;
        flex-wrap: root.column ? FlexboxLayoutWrap.no-wrap : FlexboxLayoutWrap.wrap;
        alignment: start;
        cross-axis-alignment: start;
        spacing: 5px;
        for f[i] in ["All", "Norwegian", "Swedish", "English", "Downloaded"]: Shelf {
            text: f;
            label: f;
            on: Pages.model-filter == i;
            clicked => { Pages.model-filter = i; root.changed(); }
        }
    }
}

component Compressed inherits HorizontalLayout {
    callback changed();
    spacing: 10px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Toggle {
            label: "Show compressed versions too";
            checked <=> Pages.model-compressed;
            toggled => { root.changed(); }
        }
    }
    Text {
        text: "Show compressed";
        color: F.text2;
        font-family: F.body;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

// The cyan chip of a heading: how much the models take, how many clips are merged.
component CyanChip inherits Rectangle {
    in property <string> text;
    width: chip.preferred-width + 16px;
    height: 18px;
    background: F.cyan;
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        background: F.bg;
    }
    chip := Text {
        text: root.text;
        color: F.cyan;
        font-family: F.body;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.8px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ModelsPage inherits Page {
    in property <bool> wide;
    callback back();
    callback filter-changed();
    callback use-model(int);
    callback cancel-download();
    callback download-model(int);
    VerticalLayout {
        PageTitle { sub: "ROSTER"; back => { root.back(); } }
        HeadBand {
            Heading {
                first: "MOD";
                second: "ELS";
                if !root.wide: VerticalLayout {
                    alignment: center;
                    CyanChip { text: Pages.models-used; }
                }
            }
        }
        if !root.wide: VerticalLayout {
            vertical-stretch: 0;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;
            SlantField {
                icon: "search";
                label: "Search models";
                placeholder: "Search " + Pages.model-count + " models";
                text <=> Pages.model-query;
                edited => { root.filter-changed(); }
            }
            Shelves { changed => { root.filter-changed(); } }
            Compressed { changed => { root.filter-changed(); } }
        }
        if !root.wide: Rectangle { height: 1px; vertical-stretch: 0; background: F.line; }
        HorizontalLayout {
            vertical-stretch: 1;
            if root.wide: Rectangle {
                width: 290px;
                background: @linear-gradient(180deg, #1f1027 0%, #110e20 60%);
                Rectangle { x: parent.width - 2px; y: 0; width: 2px; height: parent.height; background: #000000; }
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 16px;
                    padding-top: 22px;
                    padding-bottom: 16px;
                    spacing: 14px;
                    Panel {
                        tag: "FIND A MODEL";
                        height: find.preferred-height;
                        find := VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 18px;
                            padding-bottom: 14px;
                            spacing: 10px;
                            SlantField {
                                icon: "search";
                                label: "Search models";
                                placeholder: "Search " + Pages.model-count + " models";
                                text <=> Pages.model-query;
                                edited => { root.filter-changed(); }
                            }
                            Label { text: "SHELF"; height: 12px; }
                            Shelves { column: true; changed => { root.filter-changed(); } }
                            Compressed { changed => { root.filter-changed(); } }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: Pages.models-used.to-uppercase();
                            color: #ffffff;
                            font-family: F.lean;
                            font-size: 22px;
                            letter-spacing: 1px;
                            overflow: elide;
                        }
                    }
                }
            }
            Scroller {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    padding-left: 12px;
                    padding-right: 16px;
                    padding-top: 6px;
                    padding-bottom: 16px;
                    spacing: 6px;
                    for m in Pages.models: VerticalLayout {
                        if m.header: HorizontalLayout {
                            padding-top: 10px;
                            padding-bottom: 2px;
                            spacing: 8px;
                            Text {
                                text: m.title.to-uppercase();
                                color: F.gold;
                                font-family: F.lean;
                                font-size: 13px;
                                letter-spacing: 2px;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: m.by;
                                color: F.faint;
                                font-family: F.body;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                        if !m.header: Rectangle {
                            height: card.preferred-height;
                            background: m.active ? #6e1a30 : F.line;
                            Rectangle {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                background: m.active ? @linear-gradient(180deg, #5a0f22 0%, #2a0712 100%) : @linear-gradient(180deg, #1c1738 0%, #14112a 100%);
                            }
                            Rectangle { x: 0; y: 0; width: 3px; height: parent.height; background: m.active ? F.p1 : F.edge; }
                            card := VerticalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                padding-top: 7px;
                                padding-bottom: 8px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: m.title;
                                            color: #ffffff;
                                            font-family: F.body;
                                            font-size: 13px;
                                            font-weight: 700;
                                            overflow: elide;
                                        }
                                        HorizontalLayout {
                                            spacing: 14px;
                                            alignment: start;
                                            Pips { label: "QUALITY"; value: m.quality; }
                                            Pips { label: "SPEED"; value: m.speed; }
                                            Text {
                                                text: m.size;
                                                color: F.gold;
                                                font-family: F.body;
                                                font-size: 10.5px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    if m.active: VerticalLayout {
                                        alignment: center;
                                        Tag { text: "IN USE"; accessible-role: text; accessible-label: "In use"; }
                                    }
                                    if m.downloaded && !m.active: VerticalLayout {
                                        alignment: center;
                                        Btn { height: 26px; text: "Use"; clicked => { root.use-model(m.index); } }
                                    }
                                    if Pages.downloading == m.index: VerticalLayout {
                                        alignment: center;
                                        Btn { height: 26px; text: "Cancel"; clicked => { root.cancel-download(); } }
                                    }
                                    if !m.downloaded && Pages.downloading != m.index: VerticalLayout {
                                        alignment: center;
                                        Btn {
                                            height: 26px;
                                            primary: true;
                                            text: "Download";
                                            enabled: Pages.downloading < 0;
                                            accessible-label: "Download " + m.title;
                                            clicked => { root.download-model(m.index); }
                                        }
                                    }
                                }
                                if Pages.downloading == m.index: HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Bar { value: Pages.download-progress; }
                                    }
                                    Text {
                                        text: round(Pages.download-progress * 100) + "%";
                                        color: F.gold;
                                        font-family: F.body;
                                        font-size: 11px;
                                        font-weight: 700;
                                        width: 32px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    if Pages.models.length == 0: Text {
                        height: 80px;
                        text: "No models match";
                        color: F.faint;
                        font-family: F.lean;
                        font-size: 20px;
                        letter-spacing: 1.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Toast { text: Main.status; }
    }
}

// ---------- Merge ----------

// One fighter of the tag team (wide): its portrait with the place, its name and length.
component TeamCard inherits Rectangle {
    in property <int> place;
    in property <string> name;
    in property <string> note;
    Rectangle { x: -1px; y: -1px; width: parent.width + 2px; height: parent.height + 2px; background: F.edge; }
    Rectangle { background: #000000; }
    FiPortrait { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 46px; pose: root.place - 1; }
    Rectangle {
        x: 2px;
        y: parent.height - 42px;
        width: parent.width - 4px;
        height: 40px;
        background: @linear-gradient(180deg, #221c40 0%, #16122c 100%);
        VerticalLayout {
            padding-left: 7px;
            padding-right: 7px;
            alignment: center;
            spacing: 1px;
            Text { text: root.name; color: #ffffff; font-family: F.body; font-size: 12px; font-weight: 700; overflow: elide; }
            Text { text: root.note; color: F.gold; font-family: F.body; font-size: 10.5px; font-weight: 700; overflow: elide; }
        }
    }
    Skew { x: 6px; y: 6px; width: 24px; height: 22px; body: F.p1; rim: #000000; rim-w: 2px; }
    Text {
        x: 6px;
        y: 6px;
        width: 24px;
        height: 22px;
        text: root.place;
        color: #ffffff;
        font-family: F.lean;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The new clip's name.
component NewClip inherits Panel {
    tag: "NEW CLIP";
    tone: 1;
    height: 70px;
    Field {
        x: 12px;
        y: 22px;
        width: parent.width - 24px;
        height: 34px;
        font-size: 14px;
        text <=> Pages.merge-name;
        placeholder: "Name";
        label: "Name of the merged clip";
    }
}

export component MergePage inherits Page {
    in property <bool> wide;
    callback go(int);
    callback move(int, int);
    callback remove(int);
    callback play(int);
    callback run(string);
    property <string> playing-name: Main.active-clip >= 0 && Main.active-clip < Main.clips.length && Main.playing ? Main.clips[Main.active-clip].name : "";
    property <int> team: min(Pages.merge-rows.length, 4);
    VerticalLayout {
        PageTitle { back-text: "CLIPS"; sub: "TAG TEAM"; back => { root.go(0); } }
        HorizontalLayout {
            vertical-stretch: 1;
            if root.wide: Rectangle {
                width: 470px;
                background: @linear-gradient(180deg, #1f1027 0%, #110e20 60%);
                Rectangle { x: parent.width - 2px; y: 0; width: 2px; height: parent.height; background: #000000; }
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 18px;
                    padding-top: 12px;
                    padding-bottom: 14px;
                    spacing: 14px;
                    Heading {
                        first: "MERGE ";
                        second: "CLIPS";
                        size: 26px;
                        height: 34px;
                        VerticalLayout {
                            alignment: center;
                            CyanChip { text: Pages.merge-rows.length + " clips"; }
                        }
                    }
                    team-row := Rectangle {
                        height: 196px;
                        vertical-stretch: 0;
                        property <length> gap: 22px;
                        property <length> card-w: (self.width - (root.team - 1) * self.gap) / max(1, root.team);
                        for r[i] in root.team: Rectangle {
                            x: i * (parent.card-w + parent.gap);
                            y: 0;
                            width: parent.card-w;
                            height: parent.height;
                            TeamCard {
                                place: i + 1;
                                name: Pages.merge-rows[i].name;
                                note: Pages.merge-rows[i].note;
                            }
                            Text {
                                visible: i > 0;
                                x: -team-row.gap + 4px;
                                y: (parent.height - 60px) / 2;
                                width: team-row.gap - 6px;
                                height: 30px;
                                text: "+";
                                color: F.gold;
                                font-family: F.lean;
                                font-size: 26px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    NewClip { }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: root.wide ? 18px : 10px;
                padding-bottom: 10px;
                spacing: 18px;
                if !root.wide: VerticalLayout {
                    Heading {
                        first: "MERGE ";
                        second: "CLIPS";
                        size: 26px;
                        height: 32px;
                        VerticalLayout {
                            alignment: center;
                            CyanChip { text: Pages.merge-rows.length + " clips"; }
                        }
                    }
                }
                Panel {
                    tag: "ORDER";
                    vertical-stretch: 1;
                    Scroller {
                        x: 8px;
                        y: 14px;
                        width: parent.width - 12px;
                        height: parent.height - 20px;
                        VerticalLayout {
                            alignment: start;
                            padding-top: 2px;
                            padding-right: 8px;
                            OrderList {
                                rows: Pages.merge-rows;
                                removable: true;
                                playable: true;
                                playing-name: root.playing-name;
                                enabled: !Pages.merging;
                                moved(a, b) => { root.move(a, b); }
                                act(i) => { root.remove(i); }
                                play(i) => { root.play(i); }
                            }
                        }
                    }
                }
                if !root.wide: VerticalLayout {
                    NewClip { }
                }
            }
        }
        Footer {
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Strip { text: Main.status; }
            }
            VerticalLayout {
                alignment: center;
                Btn { height: 32px; text: "Cancel"; clicked => { root.go(0); } }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    height: 36px;
                    red: true;
                    text: Pages.merging ? "Merging" : "Merge " + Pages.merge-rows.length + " clips";
                    enabled: !Pages.merging && Pages.merge-name != "";
                    clicked => { root.run(Pages.merge-name); }
                }
            }
        }
    }
}

// ---------- Ask ----------

// A source of an answer: its number on a red tag, the clip (and its project), the time in
// gold and the words.
component Source inherits Rectangle {
    in property <AskSource> source;
    in property <bool> show-project;
    in property <string> project;
    callback clicked;
    height: 48px;
    accessible-role: button;
    accessible-label: root.source.n + " " + root.source.clip + " " + root.source.time;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        background: t.has-hover ? F.gold : F.line;
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            background: t.has-hover ? @linear-gradient(180deg, #2e2558 0%, #1d1838 100%) : @linear-gradient(180deg, #1c1738 0%, #14112a 100%);
        }
    }
    Skew { x: 8px; y: 8px; width: 24px; height: 22px; body: F.p1; rim: #000000; rim-w: 2px; }
    Text {
        x: 8px;
        y: 8px;
        width: 24px;
        height: 22px;
        text: root.source.n;
        color: #ffffff;
        font-family: F.lean;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    VerticalLayout {
        x: 42px;
        width: parent.width - 52px;
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            spacing: 7px;
            Text {
                text: root.source.clip;
                color: #ffffff;
                font-family: F.body;
                font-size: 12.5px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 0;
            }
            if root.show-project && root.project != "": VerticalLayout {
                alignment: center;
                Rectangle {
                    width: pj.preferred-width + 10px;
                    height: 12px;
                    background: F.cyan;
                    pj := Text {
                        text: root.project.to-uppercase();
                        color: #000000;
                        font-family: F.body;
                        font-size: 8.5px;
                        font-weight: 700;
                        letter-spacing: 1.4px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.source.time;
                color: F.gold;
                font-family: F.body;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.source.text;
            color: F.dim;
            font-family: F.body;
            font-size: 11.5px;
            font-weight: 600;
            overflow: elide;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The answer in a dialogue box: a portrait on the left, ANSWER on a gold tag, the words
// (or THINKING with three blocks).
component Answer inherits Rectangle {
    in property <length> max-h: 300px;
    in property <length> font-size: 13px;
    height: min(body.preferred-height + 30px, root.max-h);
    Rectangle { x: -1px; y: -1px; width: parent.width + 2px; height: parent.height + 2px; background: F.edge; }
    Rectangle { background: #000000; }
    Rectangle {
        x: 2px;
        y: 3px;
        width: parent.width - 4px;
        height: parent.height - 5px;
        background: @linear-gradient(180deg, #1d1838 0%, #110e20 100%);
    }
    Rectangle { x: 0; y: 0; width: parent.width; height: 3px; background: F.p1; }
    FiPortrait { x: 2px; y: 3px; width: 72px; height: parent.height - 5px; pose: 2; }
    Rectangle { x: 74px; y: 3px; width: 2px; height: parent.height - 3px; background: #000000; }
    Tag { x: 86px; y: -9px; text: "ANSWER"; tone: 1; }
    Scroller {
        x: 80px;
        y: 16px;
        width: parent.width - 86px;
        height: parent.height - 22px;
        body := VerticalLayout {
            padding-left: 6px;
            padding-right: 12px;
            padding-bottom: 8px;
            if Pages.answer == "": HorizontalLayout {
                spacing: 6px;
                height: 30px;
                alignment: start;
                Text {
                    text: "THINKING";
                    color: F.gold;
                    font-family: F.lean;
                    font-size: 16px;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                }
                for k in 3: VerticalLayout {
                    alignment: center;
                    Skew { width: 10px; height: 9px; body: F.gold; }
                }
            }
            if Pages.answer != "": Text {
                text: Pages.answer;
                color: F.text;
                font-family: F.body;
                font-size: root.font-size;
                font-weight: 600;
                wrap: word-wrap;
            }
        }
    }
}

// The sources, numbered as the answer cites them.
component Sources inherits VerticalLayout {
    callback open(int);
    spacing: 10px;
    Heading { first: "SOURCES"; second: ""; size: 16px; height: 22px; vertical-stretch: 0; }
    Scroller {
        VerticalLayout {
            alignment: start;
            padding-top: 2px;
            padding-right: 8px;
            padding-bottom: 4px;
            spacing: 6px;
            for s[i] in Pages.sources: Source {
                source: s;
                show-project: Pages.ask-all;
                project: s.place >= 0 && s.place < Main.projects.length ? Main.projects[s.place] : "";
                clicked => { root.open(i); }
            }
        }
    }
}

export component AskPage inherits Page {
    in property <bool> wide;
    callback go(int);
    callback ask(string, bool);
    callback open-source(int);
    VerticalLayout {
        PageTitle { sub: "STORY MODE"; back => { root.go(0); } }
        HeadBand { Heading { first: "ASK"; second: ""; } }
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 6px;
            SlantField {
                min-width: 80px;
                horizontal-stretch: 1;
                icon: "message";
                gold: true;
                placeholder: "Ask about your clips";
                label: "Question";
                text <=> Pages.question;
                init => { self.grab(); }
                accepted => { if (Pages.question != "" && !Pages.asking) { root.ask(Pages.question, Pages.ask-all); } }
            }
            if Main.projects.length > 1: VerticalLayout {
                alignment: center;
                Btn {
                    height: 32px;
                    text: "All projects";
                    on: Pages.ask-all;
                    accessible-role: checkbox;
                    accessible-label: "Ask all projects";
                    accessible-checked: Pages.ask-all;
                    clicked => { Pages.ask-all = !Pages.ask-all; }
                }
            }
            VerticalLayout {
                alignment: center;
                Key {
                    width: ask-row.preferred-width;
                    height: 32px;
                    body: #0b2f3a;
                    hot-body: #11414f;
                    rim: F.cyan;
                    label: "Ask";
                    tip: "Ask";
                    enabled: Pages.question != "" && !Pages.asking;
                    clicked => { root.ask(Pages.question, Pages.ask-all); }
                    ask-row := HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;
                        opacity: parent.enabled ? 1 : 0.38;
                        Icon {
                            name: "message";
                            tint: F.cyan;
                            stroke-width: 2.2px;
                            width: 13px;
                            height: 13px;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: "ASK";
                            color: F.cyan;
                            font-family: F.disp;
                            font-size: 13px;
                            letter-spacing: 1.4px;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; vertical-stretch: 0; background: F.line; }
        if !root.wide: VerticalLayout {
            vertical-stretch: 1;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 20px;
            padding-bottom: 16px;
            spacing: 16px;
            if Pages.answer != "" || Pages.asking: VerticalLayout {
                Answer { }
            }
            if Pages.sources.length > 0: VerticalLayout {
                Sources {
                    vertical-stretch: 1;
                    open(i) => { root.open-source(i); root.go(1); }
                }
            }
            if Pages.sources.length == 0: Rectangle { vertical-stretch: 1; }
        }
        if root.wide: HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 22px;
            padding-bottom: 18px;
            spacing: 20px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                if Pages.answer != "" || Pages.asking: VerticalLayout {
                    Answer { max-h: 460px; }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                if Pages.sources.length > 0: VerticalLayout {
                    Sources {
                        open(i) => { root.open-source(i); root.go(1); }
                    }
                }
                if Pages.sources.length == 0: Rectangle { }
            }
        }
        Toast { text: Main.status; }
    }
}

// ---------- The widget ----------

// The small always-on-top window as a pocket HUD (variant A): FIGHT (STOP while recording)
// on the left; the status word with its dot, the round clock and the health bar on the
// right, Open window top right and Pause while recording. The top edge turns red while
// recording. The whole card moves the window.
export component Widget inherits Rectangle {
    property <float> level: Main.recording && !Main.paused && Main.live.length > 0 ? clamp(Main.live[Main.live.length - 1], 0, 1) : 0;
    // The status dot blinks while recording, as on the main page.
    property <bool> lit: !Main.recording || Main.paused || F.blink;
    background: @linear-gradient(180deg, #1f1027 0%, #110e20 70%);
    Rectangle { border-width: 1px; border-color: #2a2445; }
    Rectangle { x: 0; y: 0; width: parent.width; height: 2px; background: Main.recording ? F.p1 : F.line; }
    WindowMoveArea {
        width: 100%;
        height: 100%;
        // FIGHT: the record diamond of the main page.
        Rectangle {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: 82px;
            height: 82px;
            accessible-role: button;
            accessible-label: Main.recording ? "Stop recording" : "Record";
            accessible-action-default => { Main.toggle-record(); }
            Image {
                x: -9px;
                y: -6px + (fight.pressed && fight.has-hover ? 2px : 0);
                width: 100px;
                height: 100px;
                image-fit: fill;
                source: Main.recording
                    ? (1phx < 0.7px ? @image-url("x-fighter/stop-p@2x.png") : @image-url("x-fighter/stop-p.png"))
                    : (1phx < 0.7px ? @image-url("x-fighter/rec-p@2x.png") : @image-url("x-fighter/rec-p.png"));
            }
            property <bool> hovering: fight.has-hover;
            changed hovering => { Tips.hover(self.hovering, Main.recording ? "Stop" : "Record", self.absolute-position, self.width, self.height); }
            fight := TouchArea {
                mouse-cursor: pointer;
                clicked => { Tips.hide(); Main.toggle-record(); }
            }
        }
        // The status, the clock and the bar.
        Rectangle {
            x: 100px;
            y: 10px;
            width: parent.width - 110px;
            height: parent.height - 20px;
            // READY, RECORDING or PAUSED with its dot.
            Rectangle {
                x: 0;
                y: 2px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: Main.recording && !Main.paused ? #3d0b14 : Main.paused ? #4a2a00 : #0b3d1d;
                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Main.paused ? F.gold2 : Main.recording ? (root.lit ? F.p1 : F.p1d) : F.green;
                }
            }
            Text {
                x: 17px;
                y: 0;
                width: parent.width - 50px;
                height: 16px;
                text: Main.paused ? "PAUSED" : Main.recording ? "RECORDING" : "READY";
                color: Main.recording && !Main.paused ? F.p1 : Main.paused ? F.gold2 : F.gold;
                font-family: F.lean;
                font-size: 13px;
                letter-spacing: 1.5px;
                vertical-alignment: center;
                accessible-label: (Main.recording ? (Main.paused ? "Paused " : "Recording ") : "Ready ") + Main.elapsed;
            }
            IconBtn {
                x: parent.width - self.width;
                y: -2px;
                size: 26px;
                height: 22px;
                icon: "expand";
                icon-size: 12px;
                label: "Open the window";
                tip: "Open window";
                clicked => { Main.compact-changed(false); }
            }
            // The round clock: white figures with a hard red shadow.
            Text {
                x: 2px;
                y: 24px;
                height: 36px;
                text: Main.elapsed;
                color: F.p1d;
                font-family: F.figures;
                font-size: Main.elapsed.character-count > 5 ? 26px : 34px;
                letter-spacing: 1px;
                vertical-alignment: center;
                accessible-role: none;
            }
            Text {
                x: 0;
                y: 22px;
                height: 36px;
                text: Main.elapsed;
                color: #ffffff;
                font-family: F.figures;
                font-size: Main.elapsed.character-count > 5 ? 26px : 34px;
                letter-spacing: 1px;
                vertical-alignment: center;
                accessible-role: none;
            }
            // The health bar: the live level in gold.
            Bar {
                x: 0;
                y: parent.height - 18px;
                width: parent.width - (Main.recording ? 34px : 0);
                height: 10px;
                value: root.level;
            }
            // In a plain box: an `if` whose root is a component copies the whole component.
            if Main.recording: Rectangle {
                x: parent.width - 28px;
                y: parent.height - 24px;
                width: 28px;
                height: 22px;
                IconBtn {
                    size: 28px;
                    height: 22px;
                    icon: Main.paused ? "play" : "pause";
                    icon-size: 10px;
                    label: Main.paused ? "Resume" : "Pause";
                    tip: Main.paused ? "Resume" : "Pause";
                    clicked => { Main.toggle-pause(); }
                }
            }
        }
    }
}

// ---------- Questions and covers ----------

// An announcer panel: a dark gradient box with a violet edge, a red top edge and a gold
// flavour tag on its right (K.O., WAIT, NEW STAGE, LOADING).
component Announcer inherits Rectangle {
    in property <string> flavour;
    Rectangle { x: -1px; y: -1px; width: parent.width + 2px; height: parent.height + 2px; background: F.edge; }
    Rectangle { background: @linear-gradient(180deg, #1d1838 0%, #110e20 60%); }
    Rectangle { x: -1px; y: -1px; width: parent.width + 2px; height: 3px; background: F.p1; }
    @children
    Rectangle {
        visible: root.flavour != "";
        x: parent.width - self.width - 12px;
        y: -12px;
        width: flav.preferred-width + 20px;
        height: 22px;
        background: #000000;
        Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            background: F.gold;
        }
        flav := Text {
            text: root.flavour;
            color: #000000;
            font-family: F.lean;
            font-size: 13px;
            letter-spacing: 2px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The title of a question in the slanted type; a clip's name after it in gold.
component Head inherits HorizontalLayout {
    in property <string> text;
    in property <string> clip-name;
    spacing: 8px;
    alignment: start;
    Text {
        text: root.text;
        color: #ffffff;
        font-family: F.lean;
        font-size: 24px;
        letter-spacing: 1px;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: root.clip-name == "" ? 1 : 0;
    }
    if root.clip-name != "": Text {
        text: root.clip-name;
        color: F.gold;
        font-family: F.body;
        font-size: 20px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

// A question over the dimmed page: the title (a clip's name in gold), a note or a name
// field, and the keys; Delete is the red key. AppWindow works out the words; the keys
// report back. A click outside cancels.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> note;
    in property <string> field;
    in property <string> ok;
    in property <bool> ok-enabled;
    // A single clip's delete question shows its name in gold.
    in property <string> clip-name;
    callback close();
    callback confirm();
    callback discard();
    property <int> kind: Main.dialog;
    property <bool> writes: root.kind == 1 || root.kind >= 4;
    background: #05040aa8;
    TouchArea { clicked => { root.close(); } }
    Announcer {
        width: min(parent.width - 48px, 340px);
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 30px;
        flavour: root.kind == 2 ? "K.O." : root.kind == 3 ? "WAIT" : root.kind == 4 ? "NEW STAGE" : "";
        TouchArea { }
        box := VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 22px;
            padding-bottom: 16px;
            spacing: 6px;
            Head {
                text: root.clip-name != "" ? "Delete" : root.title;
                clip-name: root.clip-name;
            }
            if root.note != "": Text {
                text: root.note;
                color: F.dim;
                font-family: F.body;
                font-size: 13px;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.writes: VerticalLayout {
                padding-top: 8px;
                spacing: 8px;
                Label { text: root.field.to-uppercase(); font-size: 9.5px; letter-spacing: 2.2px; height: 12px; }
                Field {
                    label: root.field;
                    text <=> Main.dialog-text;
                    grab-at-start: true;
                    accepted => { if (root.ok-enabled) { root.confirm(); } }
                }
            }
            HorizontalLayout {
                padding-top: 14px;
                alignment: end;
                spacing: 8px;
                Btn { height: 30px; text: "Cancel"; clicked => { root.close(); } }
                if root.kind == 3: VerticalLayout {
                    Btn { height: 30px; text: "Discard changes"; clicked => { root.discard(); } }
                }
                Btn {
                    height: 30px;
                    primary: root.kind != 2;
                    red: root.kind == 2;
                    text: root.ok;
                    enabled: root.ok-enabled;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}

// New words being spoken: an announcer panel with LOADING, the stage line, a health bar
// with the percent in gold and Cancel. It blocks clicks.
export component Speaking inherits Rectangle {
    callback cancel();
    background: #05040ab8;
    TouchArea { }
    Announcer {
        width: min(parent.width - 48px, 380px);
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 30px;
        flavour: "LOADING";
        box := VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 22px;
            padding-bottom: 16px;
            spacing: 8px;
            Head { text: "Speaking new words"; }
            Text {
                text: Pages.speak-stage;
                color: F.dim;
                font-family: F.body;
                font-size: 13px;
                font-weight: 600;
                wrap: word-wrap;
            }
            HorizontalLayout {
                padding-top: 6px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Bar { height: 14px; value: Pages.speak-progress; }
                }
                Text {
                    text: round(Pages.speak-progress * 100) + "%";
                    color: F.gold;
                    font-family: F.lean;
                    font-size: 20px;
                    vertical-alignment: center;
                    width: 48px;
                    horizontal-alignment: right;
                }
            }
            HorizontalLayout {
                padding-top: 6px;
                alignment: end;
                Btn { height: 30px; text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}

// Files dragged over the window: a gold frame inset 12px, NEW CHALLENGER on a red band, the
// gold plus diamond and the words with a red shadow.
export component Drop inherits Rectangle {
    background: #05040ae0;
    Rectangle {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        border-width: 3px;
        border-color: F.gold;
    }
    VerticalLayout {
        alignment: center;
        spacing: 16px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: nc.preferred-width + 32px;
                height: 26px;
                background: #000000;
                Rectangle { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; background: F.p1; }
                nc := Text {
                    text: "NEW CHALLENGER";
                    color: #ffffff;
                    font-family: F.lean;
                    font-size: 15px;
                    letter-spacing: 3px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 84px;
                height: 84px;
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 84;
                    viewbox-height: 84;
                    fill: F.p1;
                    commands: "M 42 0 L 84 42 L 42 84 L 0 42 Z";
                }
                Path {
                    x: 3px;
                    y: 3px;
                    width: parent.width - 6px;
                    height: parent.height - 6px;
                    viewbox-width: 78;
                    viewbox-height: 78;
                    fill: #000000;
                    commands: "M 39 0 L 78 39 L 39 78 L 0 39 Z";
                }
                Path {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: parent.height - 16px;
                    viewbox-width: 68;
                    viewbox-height: 68;
                    fill: @linear-gradient(135deg, #fff27a 0%, F.gold 45%, F.gold2 100%);
                    commands: "M 34 0 L 68 34 L 34 68 L 0 34 Z";
                }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "plus";
                    tint: #000000;
                    stroke-width: 3px;
                    width: 26px;
                    height: 26px;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: dt.preferred-width + 4px;
                height: 46px;
                Text {
                    x: 3px;
                    y: 3px;
                    text: dt.text;
                    color: F.p1d;
                    font-family: F.lean;
                    font-size: 34px;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                    height: parent.height;
                }
                dt := Text {
                    x: 0;
                    y: 0;
                    text: "Drop to import";
                    color: #ffffff;
                    font-family: F.lean;
                    font-size: 34px;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                    height: parent.height;
                }
            }
        }
    }
}
