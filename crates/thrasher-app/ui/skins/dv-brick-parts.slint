// The Brick Phone's parts, shared by its main page (dv-brick.slint) and its other pages
// (dv-brick-pages.slint): the rubber keys and their faces, the handset's shell and top, the
// bezel, the LCD's pixel glyphs, tiles, small caps, signal bars, timer and scrollbar. Moved
// out of dv-brick.slint unchanged; the colours are `Brick` in common.slint.

import { Main, Tips, Fx, Brick } from "../common.slint";

// A piece of art, the 2x cut when the display is dense.
export component Art inherits Image {
    in property <image> lo;
    in property <image> hi;
    source: 1phx < 0.7px ? root.hi : root.lo;
    image-fit: fill;
}

// A pixel glyph of the LCD at a whole scale of its art, without smoothing, in one colour.
export component Px inherits Image {
    in property <float> s: 1;
    in property <color> tint: Brick.ink;
    width: self.source.width * root.s * 1px;
    height: self.source.height * root.s * 1px;
    image-fit: fill;
    image-rendering: pixelated;
    colorize: root.tint;
}

// A white tile repeated over the box in one colour (rules, grids, dot screens).
export component Tile inherits Image {
    in property <color> tint;
    colorize: root.tint;
    horizontal-tiling: repeat;
    vertical-tiling: repeat;
    horizontal-alignment: left;
    vertical-alignment: top;
    image-rendering: pixelated;
}

// The look of a rubber key: its art round it (6 px out at the sides, 2 above, 8 below for
// the shadow), a hover or press tint in its shape, and what is on it. Kinds 0 Menu, 1
// Find, 2 the green key, 3 the red key and 4 a keypad key stretch with the window (three
// slices: the left 30 px, a stretched middle column and the right 30 px); 10 a wide
// keypad key, 11 and 12 the wide green and red keys, 13 a wide soft key and 14 a nub are
// one size. The other pages add 5, the green key while it is off (three slices), 15 the
// wide one off, and the widget's 16 green, 17 red and 18 red off keys.
export component KeyFace inherits Rectangle {
    in property <int> kind;
    in property <bool> hot;
    in property <bool> down;
    in property <bool> dim;
    property <bool> hi: 1phx < 0.7px;
    property <bool> sliced: root.kind < 10;
    // The corners, as CSS shrinks them to fit the key.
    property <length> tl: root.kind == 0 ? 7.1px : root.kind == 1 ? 16px : root.kind == 2 ? 6.4px : root.kind == 3 ? 14.4px : root.kind == 4 ? 11.5px
        : root.kind == 10 ? 16px : root.kind == 11 || root.kind == 15 ? 26px : root.kind == 12 ? 21px : root.kind == 13 ? 8px
        : root.kind == 5 ? 6.4px : root.kind == 16 ? 18px : root.kind >= 17 ? 15px : 9px;
    property <length> tr: root.kind == 0 ? 16px : root.kind == 1 ? 7.1px : root.kind == 2 ? 14.4px : root.kind == 3 ? 6.4px : root.kind == 4 ? 11.5px
        : root.kind == 10 ? 16px : root.kind == 11 || root.kind == 15 ? 26px : root.kind == 12 ? 21px : root.kind == 13 ? 8px
        : root.kind == 5 ? 14.4px : root.kind == 16 ? 18px : root.kind >= 17 ? 15px : 9px;
    property <length> br: root.kind == 0 ? 16px : root.kind == 1 ? 7.1px : root.kind == 2 ? 17.6px : root.kind == 3 ? 14.4px : root.kind == 4 ? 11.5px
        : root.kind == 10 ? 16px : root.kind == 11 || root.kind == 15 ? 26px : root.kind == 12 ? 21px : root.kind == 13 ? 18px
        : root.kind == 5 ? 17.6px : root.kind == 16 ? 18px : root.kind >= 17 ? 15px : 9px;
    property <length> bl: root.kind == 0 ? 7.1px : root.kind == 1 ? 16px : root.kind == 2 ? 14.4px : root.kind == 3 ? 17.6px : root.kind == 4 ? 11.5px
        : root.kind == 10 ? 16px : root.kind == 11 || root.kind == 15 ? 26px : root.kind == 12 ? 21px : root.kind == 13 ? 18px
        : root.kind == 5 ? 14.4px : root.kind == 16 ? 18px : root.kind >= 17 ? 15px : 9px;
    // The left slice, or the whole key for the fixed kinds.
    property <image> left: root.kind == 0 ? (root.hi ? @image-url("dv-brick/kp-menu-l@2x.png") : @image-url("dv-brick/kp-menu-l.png"))
        : root.kind == 1 ? (root.hi ? @image-url("dv-brick/kp-find-l@2x.png") : @image-url("dv-brick/kp-find-l.png"))
        : root.kind == 2 ? (root.hi ? @image-url("dv-brick/kp-rec-l@2x.png") : @image-url("dv-brick/kp-rec-l.png"))
        : root.kind == 3 ? (root.hi ? @image-url("dv-brick/kp-stop-l@2x.png") : @image-url("dv-brick/kp-stop-l.png"))
        : root.kind == 4 ? (root.hi ? @image-url("dv-brick/kp-pad-l@2x.png") : @image-url("dv-brick/kp-pad-l.png"))
        : root.kind == 10 ? (root.hi ? @image-url("dv-brick/kw-pad@2x.png") : @image-url("dv-brick/kw-pad.png"))
        : root.kind == 11 ? (root.hi ? @image-url("dv-brick/kw-rec@2x.png") : @image-url("dv-brick/kw-rec.png"))
        : root.kind == 12 ? (root.hi ? @image-url("dv-brick/kw-stop@2x.png") : @image-url("dv-brick/kw-stop.png"))
        : root.kind == 13 ? (root.hi ? @image-url("dv-brick/kw-soft@2x.png") : @image-url("dv-brick/kw-soft.png"))
        : root.kind == 5 ? (root.hi ? @image-url("dv-brick/kp-off-l@2x.png") : @image-url("dv-brick/kp-off-l.png"))
        : root.kind == 15 ? (root.hi ? @image-url("dv-brick/kw-off@2x.png") : @image-url("dv-brick/kw-off.png"))
        : root.kind == 16 ? (root.hi ? @image-url("dv-brick/kg-rec@2x.png") : @image-url("dv-brick/kg-rec.png"))
        : root.kind == 17 ? (root.hi ? @image-url("dv-brick/kg-stop@2x.png") : @image-url("dv-brick/kg-stop.png"))
        : root.kind == 18 ? (root.hi ? @image-url("dv-brick/kg-stopoff@2x.png") : @image-url("dv-brick/kg-stopoff.png"))
        : (root.hi ? @image-url("dv-brick/nub@2x.png") : @image-url("dv-brick/nub.png"));
    property <image> middle: root.kind == 0 ? (root.hi ? @image-url("dv-brick/kp-menu-m@2x.png") : @image-url("dv-brick/kp-menu-m.png"))
        : root.kind == 1 ? (root.hi ? @image-url("dv-brick/kp-find-m@2x.png") : @image-url("dv-brick/kp-find-m.png"))
        : root.kind == 2 ? (root.hi ? @image-url("dv-brick/kp-rec-m@2x.png") : @image-url("dv-brick/kp-rec-m.png"))
        : root.kind == 3 ? (root.hi ? @image-url("dv-brick/kp-stop-m@2x.png") : @image-url("dv-brick/kp-stop-m.png"))
        : root.kind == 5 ? (root.hi ? @image-url("dv-brick/kp-off-m@2x.png") : @image-url("dv-brick/kp-off-m.png"))
        : (root.hi ? @image-url("dv-brick/kp-pad-m@2x.png") : @image-url("dv-brick/kp-pad-m.png"));
    property <image> right: root.kind == 0 ? (root.hi ? @image-url("dv-brick/kp-menu-r@2x.png") : @image-url("dv-brick/kp-menu-r.png"))
        : root.kind == 1 ? (root.hi ? @image-url("dv-brick/kp-find-r@2x.png") : @image-url("dv-brick/kp-find-r.png"))
        : root.kind == 2 ? (root.hi ? @image-url("dv-brick/kp-rec-r@2x.png") : @image-url("dv-brick/kp-rec-r.png"))
        : root.kind == 3 ? (root.hi ? @image-url("dv-brick/kp-stop-r@2x.png") : @image-url("dv-brick/kp-stop-r.png"))
        : root.kind == 5 ? (root.hi ? @image-url("dv-brick/kp-off-r@2x.png") : @image-url("dv-brick/kp-off-r.png"))
        : (root.hi ? @image-url("dv-brick/kp-pad-r@2x.png") : @image-url("dv-brick/kp-pad-r.png"));
    Image {
        x: -6px;
        y: -2px;
        width: root.sliced ? 30px : root.width + 12px;
        height: root.height + 10px;
        source: root.left;
        image-fit: fill;
    }
    Image {
        visible: root.sliced;
        x: 24px;
        y: -2px;
        width: max(0px, root.width - 48px);
        height: root.height + 10px;
        source: root.middle;
        image-fit: fill;
    }
    Image {
        visible: root.sliced;
        x: root.width - 24px;
        y: -2px;
        width: 30px;
        height: root.height + 10px;
        source: root.right;
        image-fit: fill;
    }
    Rectangle {
        visible: root.hot || root.down;
        border-top-left-radius: root.tl;
        border-top-right-radius: root.tr;
        border-bottom-right-radius: root.br;
        border-bottom-left-radius: root.bl;
        background: root.down ? #00000038 : #ffffff0f;
    }
    Rectangle {
        y: root.down ? 1px : 0;
        width: root.width;
        height: root.height;
        opacity: root.dim ? 0.4 : 1;
        @children
    }
}

// A key that does something: a button with the classic accessible name and tooltip.
export component Key inherits Rectangle {
    in property <int> kind;
    in property <string> label;
    in property <string> tip: root.label;
    in property <bool> enabled: true;
    callback clicked;
    out property <bool> hot: t.has-hover && root.enabled;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    KeyFace {
        kind: root.kind;
        hot: root.hot;
        down: t.pressed && t.has-hover && root.enabled;
        dim: !root.enabled;
        @children
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

// A white key icon in one colour.
export component KeyIcon inherits Art {
    in property <color> tint;
    colorize: root.tint;
}

// The word on a key.
export component KeyWord inherits Text {
    color: Brick.label;
    font-family: Brick.keys;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 1.12px;
    vertical-alignment: center;
    accessible-role: none;
}

// The digit on a keypad key.
export component Digit inherits Text {
    color: Brick.amber;
    font-family: Brick.keys;
    font-size: 15px;
    font-weight: 700;
    vertical-alignment: center;
    horizontal-alignment: center;
    accessible-role: none;
}

// The small caps of the LCD (Pocket Small, Silkscreen with a square 5, draws one font pixel
// per px at 8px).
export component Caps inherits Text {
    color: Brick.ink;
    font-family: Brick.caps;
    font-size: 8px;
    letter-spacing: 0.48px;
    vertical-alignment: center;
    accessible-role: none;
}

// A grille of round holes, in rows and columns 8 px apart.
export component Grille inherits Rectangle {
    in property <int> cols;
    in property <int> rows: 1;
    width: root.cols * 8px - 4px;
    height: root.rows * 8px - 4px;
    for i in root.cols * root.rows: Rectangle {
        x: Math.mod(i, root.cols) * 8px;
        y: floor(i / root.cols) * 8px;
        width: 4px;
        height: 4px;
        Rectangle { y: 1px; border-radius: 2px; background: #ffffff14; }
        Rectangle { border-radius: 2px; background: #0c0c0d; }
    }
}

// The handset's body: a 2 px light along the top and a dark lip along the bottom, the
// moulded plastic between. Gradients ignore rounded corners, so the rounded ends are
// solid and the gradient fills the straight part.
export component Shell inherits Rectangle {
    in property <length> rt;
    in property <length> rb;
    Rectangle {
        border-top-left-radius: root.rt;
        border-top-right-radius: root.rt;
        border-bottom-left-radius: root.rb;
        border-bottom-right-radius: root.rb;
        background: #141517;
    }
    Rectangle {
        height: root.height - 4px;
        y: 0;
        border-top-left-radius: root.rt;
        border-top-right-radius: root.rt;
        border-bottom-left-radius: root.rb;
        border-bottom-right-radius: root.rb;
        background: #707378;
    }
    Rectangle {
        y: 2px;
        height: root.rt;
        border-top-left-radius: root.rt;
        border-top-right-radius: root.rt;
        background: Brick.p1;
    }
    Rectangle {
        y: 2px + root.rt;
        height: root.height - 6px - root.rt - root.rb;
        background: @linear-gradient(180deg, #55585e 0%, #33353a 36%, #232428 100%);
    }
    Rectangle {
        y: root.height - 4px - root.rb;
        height: root.rb;
        border-bottom-left-radius: root.rb;
        border-bottom-right-radius: root.rb;
        background: Brick.p3;
    }
}

// The top of the handset: the brand, (wide) the band words, minimise and close. Drag it
// to move the window.
export component Top inherits Rectangle {
    in property <bool> wide;
    height: 44px;
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    brand := Text {
        x: root.wide ? 110px : 80px;
        y: (parent.height - self.height) / 2 + 1px;
        text: "THRASHER";
        color: #00000099;
        font-family: Brick.keys;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 4.42px;
        accessible-role: none;
    }
    Text {
        x: brand.x;
        y: brand.y - 1px;
        text: "THRASHER";
        color: Brick.silver;
        font-family: Brick.keys;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 4.42px;
    }
    if root.wide: Text {
        x: brand.x + brand.preferred-width + 4px;
        y: (parent.height - self.height) / 2 + 1px;
        text: "DUAL BAND REC";
        color: Brick.label;
        font-family: Brick.keys;
        font-size: 8px;
        font-weight: 600;
        letter-spacing: 1.92px;
        accessible-role: none;
    }
    Key {
        x: parent.width - 22px - 30px - 8px - 30px;
        y: (parent.height - self.height) / 2;
        width: 30px;
        height: 18px;
        kind: 14;
        label: "Minimize";
        clicked => { Main.minimize-window(); }
        KeyIcon {
            x: 9px;
            y: 3px;
            width: 12px;
            height: 12px;
            lo: @image-url("dv-brick/i-min12.png");
            hi: @image-url("dv-brick/i-min12@2x.png");
            tint: Brick.silver;
        }
    }
    Key {
        x: parent.width - 22px - 30px;
        y: (parent.height - self.height) / 2;
        width: 30px;
        height: 18px;
        kind: 14;
        label: "Close";
        clicked => { Main.close-window(); }
        KeyIcon {
            x: 9px;
            y: 3px;
            width: 12px;
            height: 12px;
            lo: @image-url("dv-brick/i-close12.png");
            hi: @image-url("dv-brick/i-close12@2x.png");
            tint: Brick.close;
        }
    }
}

// The signal bars: the input level, as many lit as it is loud, from -60 dB to 0.
export component Sig inherits Rectangle {
    in property <int> n;
    in property <length> lo;
    in property <length> top;
    in property <length> bar;
    in property <length> gap;
    property <float> level: Main.recording && !Main.paused && Main.live.length > 0 ? Main.live[Main.live.length - 1] : 0;
    property <int> on: round(root.level * root.n);
    width: root.n * root.bar + (root.n - 1) * root.gap;
    height: root.top;
    accessible-role: none;
    for i in root.n: Rectangle {
        x: i * (root.bar + root.gap);
        width: root.bar;
        height: round((root.lo + (root.top - root.lo) * i / (root.n - 1)) / 1px) * 1px;
        y: root.height - self.height;
        background: i < root.on ? Brick.ink : Brick.ghost;
    }
}

// The timer, with the tenths smaller on the same baseline and the LCD's ghost of it 2 px
// down and right. Brick Figures has every digit the same width, so it holds still.
export component Timer inherits Rectangle {
    in property <length> size;
    property <length> small: round(root.size * 0.55 / 1px) * 1px;
    // The digits sit on the baseline (0.92 em down the line); the tenths' line is moved
    // down so both share it.
    property <length> drop: (root.size - root.small) * 0.92;
    property <length> lift: root.size * 0.24;
    width: big.preferred-width + tenth.preferred-width + 2px;
    height: root.size * 0.74;
    accessible-role: text;
    accessible-label: (Main.recording ? (Main.paused ? "Paused " : "Recording ") : "Ready ") + Main.elapsed + Main.elapsed-tenth;
    Text {
        x: 2px;
        y: 2px - root.lift;
        text: Main.elapsed;
        color: Brick.ghost;
        font-family: Brick.figures;
        font-size: root.size;
        font-weight: 700;
        accessible-role: none;
    }
    Text {
        x: big.preferred-width + 2px;
        y: root.drop + 2px - root.lift;
        text: Main.elapsed-tenth;
        color: Brick.ghost;
        font-family: Brick.figures;
        font-size: root.small;
        font-weight: 700;
        accessible-role: none;
    }
    big := Text {
        x: 0;
        y: -root.lift;
        text: Main.elapsed;
        color: Brick.ink;
        font-family: Brick.figures;
        font-size: root.size;
        font-weight: 700;
        accessible-role: none;
    }
    tenth := Text {
        x: big.preferred-width;
        y: root.drop - root.lift;
        text: Main.elapsed-tenth;
        color: Brick.ink;
        font-family: Brick.figures;
        font-size: root.small;
        font-weight: 700;
        accessible-role: none;
    }
}

// The LCD's scrollbar: a ruled track between two lines and a solid thumb; drag it.
export component Sbar inherits Rectangle {
    in-out property <length> content-y;
    in property <length> content-h;
    in property <length> view-h;
    property <length> range: root.content-h - root.view-h;
    property <length> thumb-h: root.range > 1px ? max(14px, root.height * root.view-h / max(root.content-h, 1px)) : root.height;
    width: 5px;
    Rectangle { x: 0; width: 1px; background: Brick.ink; }
    Rectangle { x: parent.width - 1px; width: 1px; background: Brick.ink; }
    Tile {
        x: 1px;
        width: 3px;
        height: parent.height;
        source: @image-url("dv-brick/t-rule.png");
        tint: Brick.ghost;
    }
    Rectangle {
        y: root.range > 1px ? (-root.content-y / root.range) * (root.height - root.thumb-h) : 0;
        height: root.thumb-h;
        background: Brick.ink;
        TouchArea {
            x: -4px;
            width: parent.width + 8px;
            enabled: root.range > 1px;
            moved => {
                if (self.pressed) {
                    root.content-y = clamp(-(parent.y + self.mouse-y - self.pressed-y) / (root.height - root.thumb-h) * root.range, -root.range, 0);
                }
            }
        }
    }
}

// The bezel round the LCD, with its printed words and a lit lip along the bottom.
export component Bezel inherits Rectangle {
    in property <bool> big;
    property <length> rt: root.big ? 20px : 18px;
    property <length> rb: root.big ? 20px : 26px;
    Rectangle {
        y: 1px;
        border-top-left-radius: root.rt;
        border-top-right-radius: root.rt;
        border-bottom-left-radius: root.rb;
        border-bottom-right-radius: root.rb;
        background: #ffffff1a;
    }
    Rectangle {
        border-top-left-radius: root.rt;
        border-top-right-radius: root.rt;
        border-bottom-left-radius: root.rb;
        border-bottom-right-radius: root.rb;
        background: Brick.bezel;
    }
    Caps {
        x: 16px;
        y: 3px;
        text: "THRASHER";
        color: #5b5d63;
        letter-spacing: 1.6px;
        vertical-alignment: top;
    }
    Caps {
        x: parent.width - 16px - self.preferred-width;
        y: 3px;
        text: "AMBER LCD";
        color: #5b5d63;
        letter-spacing: 1.6px;
        vertical-alignment: top;
    }
}

// What a key shows: an icon and a word side by side (portrait keys and the wide soft and
// call keys).
export component KeyRow inherits HorizontalLayout {
    in property <image> lo;
    in property <image> hi;
    in property <length> icon: 14px;
    in property <string> word;
    in property <color> tint: Brick.silver;
    in property <color> ink: Brick.label;
    in property <length> word-size: 8px;
    alignment: center;
    spacing: 6px;
    VerticalLayout {
        alignment: center;
        KeyIcon {
            width: root.icon;
            height: root.icon;
            lo: root.lo;
            hi: root.hi;
            tint: root.tint;
        }
    }
    KeyWord {
        text: root.word;
        color: root.ink;
        font-size: root.word-size;
    }
}

// What a keypad key shows: the digit, the icon of its job (keys 1 2 3) and its word. In
// a row on the portrait keypad, in a column on the wide one.
export component PadFace inherits Rectangle {
    in property <bool> big;
    in property <string> digit;
    in property <string> word;
    in property <bool> job;
    in property <image> lo;
    in property <image> hi;
    if !root.big: HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Digit { text: root.digit; }
        if root.job: VerticalLayout {
            alignment: center;
            KeyIcon {
                width: 13px;
                height: 13px;
                lo: root.lo;
                hi: root.hi;
                tint: Brick.amber;
            }
        }
        KeyWord {
            text: root.word;
            color: root.job ? #ffb24ae6 : Brick.label;
        }
    }
    if root.big: VerticalLayout {
        alignment: center;
        spacing: 2px;
        Digit {
            text: root.digit;
            height: 16px;
        }
        if root.job: HorizontalLayout {
            alignment: center;
            KeyIcon {
                width: 12px;
                height: 12px;
                lo: root.lo;
                hi: root.hi;
                tint: Brick.amber;
            }
        }
        KeyWord {
            text: root.word;
            color: root.job ? #ffb24ae6 : Brick.label;
            font-size: 7px;
            letter-spacing: 0.7px;
            horizontal-alignment: center;
        }
    }
}

// The small engraved caption over or under a part of the wide handset.
export component Cap inherits Text {
    color: Brick.label;
    font-family: Brick.keys;
    font-size: 7.5px;
    font-weight: 600;
    letter-spacing: 1.5px;
    horizontal-alignment: center;
    accessible-role: none;
}

// Where the handset's parts sit, worked out the same way by every page and by the
// questions and covers drawn over them. The main page keeps its keypad under the keys in
// portrait (four rows when there is room, else one); the other pages slide it away, so
// their LCD grows (pad rows 0). Wide windows put the keypad on the left wing.
export global Hand {
    public pure function pad-rows(h: length, main: bool) -> int {
        return !main ? 0 : h >= 540px ? 4 : 1;
    }
    public pure function bez-x(wide: bool) -> length {
        return wide ? 196px : 20px;
    }
    public pure function bez-h(h: length, wide: bool, rows: int) -> length {
        return wide ? h - 118px : rows <= 0 ? h - 168px : h - 164px - (rows * 23px + (rows - 1) * 6px);
    }
    // The soft keys: portrait under the bezel, as wide as the rocker leaves (the green
    // and red keys under them); wide under the LCD's corners, 110 px.
    public pure function soft-y(h: length, wide: bool, rows: int) -> length {
        return 58px + (wide ? h - 118px : rows <= 0 ? h - 168px : h - 164px - (rows * 23px + (rows - 1) * 6px)) + (wide ? 8px : 12px);
    }
    public pure function soft-w(w: length, wide: bool) -> length {
        return wide ? 110px : (w - 40px - 124px - 28px) / 2;
    }
    public pure function soft-left-x(w: length, wide: bool) -> length {
        return wide ? 206px : 20px;
    }
    public pure function soft-right-x(w: length, wide: bool) -> length {
        return wide ? w - 206px - 110px : w - 20px - (w - 40px - 124px - 28px) / 2;
    }
    // The right wing of a wide window closes up on a short one (k from 0 to 1).
    public pure function wing-k(h: length) -> float {
        return clamp((h - 118px - 12px - 278px) / 108px, 0, 1);
    }
    public pure function wing-y(h: length) -> length {
        return 58px + max(6px, (h - 118px - 278px - 108px * clamp((h - 118px - 12px - 278px) / 108px, 0, 1)) / 2 - 20px * clamp((h - 118px - 12px - 278px) / 108px, 0, 1));
    }
}

// The amber LCD's backlight: the glow, a light sheen at the top and the pixel grid. Its
// corners are rounded by `LcdCorners`, drawn over whatever is on it.
export component LcdGlass inherits Rectangle {
    background: @radial-gradient(circle, #f6bf5e 0%, #f0b04c 45%, #e39a33 100%);
    Rectangle {
        x: 0;
        y: 0;
        height: parent.height * 0.4;
        background: @linear-gradient(170deg, #ffffff38 0%, #ffffff00 70%);
    }
    Tile {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("dv-brick/t-grid.png");
        tint: #3b1f0512;
    }
}

// The LCD's rounded corners: the bezel's colour outside a quarter circle.
export component LcdCorners inherits Rectangle {
    for c in 4: Path {
        x: Math.mod(c, 2) == 0 ? 0 : root.width - 6px;
        y: c < 2 ? 0 : root.height - 6px;
        width: 6px;
        height: 6px;
        viewbox-width: 6;
        viewbox-height: 6;
        fill: Brick.bezel;
        commands: c == 0 ? "M 0 0 L 6 0 A 6 6 0 0 0 0 6 Z"
            : c == 1 ? "M 6 0 L 6 6 A 6 6 0 0 0 0 0 Z"
            : c == 2 ? "M 0 6 L 0 0 A 6 6 0 0 0 6 6 Z"
            : "M 6 6 L 0 6 A 6 6 0 0 0 6 0 Z";
    }
}

// The LCD's battery: a 16 x 9 box with three bars and a nub, LCD flavour.
export component Battery inherits Rectangle {
    width: 18px;
    height: 9px;
    Rectangle {
        x: 0;
        y: 0;
        width: 16px;
        height: 9px;
        border-width: 1.5px;
        border-color: Brick.ink;
        for i in 3: Rectangle {
            x: 3px + i * 4px;
            y: 2.5px;
            width: 3px;
            height: 4px;
            background: Brick.ink;
        }
    }
    Rectangle { x: 16px; y: 2.5px; width: 2px; height: 4px; background: Brick.ink; }
}
