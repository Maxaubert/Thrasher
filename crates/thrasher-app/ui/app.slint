// Thrasher's window in the "Ember" look (mockups, issue #3): orange on warm black.
// Pages: the clip list (main), one clip (manage), editing its transcript, settings
// and the model library. The window draws its own frame and title bar. The small
// always-on-top widget is a separate mode of the same window.
// The shared widgets and globals are in common.slint; the main page's look is the
// theme's skin, in skins/.

import { LineEdit, TextEdit } from "std-widgets.slint";
import "./fonts/InterTight-400.ttf";
import "./fonts/InterTight-500.ttf";
import "./fonts/InterTight-600.ttf";
import "./fonts/InterTight-800.ttf";
import "./fonts/JetBrainsMono-500.ttf";
import "./fonts/JetBrainsMono-700.ttf";
import "./fonts/Caveat-500.ttf";
import "./fonts/Caveat-700.ttf";
import "./fonts/Oswald-500.ttf";
import "./fonts/Oswald-600.ttf";
import {
    ModelRow, WordRow, OrderRow, SearchHit, LangRow, AskSource, ClipRow, Tips, Theme, Fx, Main, Win, Tour, TourPoint, Snow,
    Icon, Tip, Btn, IconBtn, Toggle, Wave, BackLink, ExportButton, ResizeEdge, TitleBar, OrderList, PageHeader, Select,
    TextField, SourceRow, ShortcutBox, Card, CardPart, CardRow, Chip, Meter, WindowFx, Scroller, TourSnake, TranscriptCard,
} from "common.slint";
import { MainPage as ClassicMain } from "skins/classic.slint";
import { MainPage as TapeMain } from "skins/tape.slint";
// What the app reaches from Rust.
export { ModelRow, WordRow, OrderRow, SearchHit, LangRow, AskSource, ClipRow, Theme, Fx, Main, Tour, Snow }

// The notification-area icon. Its image is drawn in Rust (orange dot while recording).
export component Tray inherits SystemTrayIcon {
    in property <image> image;
    in property <bool> recording;
    callback toggle-record();
    callback show-window();
    callback show-widget();
    callback quit();
    icon: image;
    tooltip: recording ? "Thrasher: recording" : "Thrasher";
    clicked => { show-window(); }
    Menu {
        MenuItem {
            title: recording ? "Stop recording" : "Start recording";
            activated => { toggle-record(); }
        }
        MenuItem {
            title: "Show window";
            activated => { show-window(); }
        }
        MenuItem {
            title: "Show widget";
            activated => { show-widget(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { quit(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Thrasher";
    in property <image> window-icon;
    icon: window-icon;
    background: compact ? transparent : Theme.bg;
    default-font-family: "Inter Tight";
    default-font-size: 13px;
    preferred-width: 520px;
    preferred-height: 600px;
    min-width: compact ? 240px : 420px;
    min-height: compact ? 124px : 480px;
    // Only the widget stays on top.
    always-on-top: compact;
    no-frame: true;
    if !compact: WindowFx { }

    // Window size classes. A size never adds or removes options; it only rearranges
    // them (docs/plan.md section 14).
    property <bool> narrow: root.width < 470px;
    property <bool> wide: root.width >= 820px;
    // Only a tall window has room for the big recorder card above the list; other
    // portrait windows get the one-line recorder, so the list keeps its space.
    property <bool> tall: root.height >= 820px;

    // 0 clips, 1 one clip, 3 settings, 4 models, 5 merge (2 was the old edit page)
    in-out property <int> page;

    // The main page's state lives in the Main global, so every skin can reach it; these
    // link to it, so the app sets and reads them here as before.
    in-out property <bool> recording <=> Main.recording;
    in-out property <bool> paused <=> Main.paused;
    in property <string> elapsed <=> Main.elapsed;
    in property <string> elapsed-tenth <=> Main.elapsed-tenth;
    in property <[float]> live <=> Main.live;
    in property <string> device-label <=> Main.device-label;
    in property <float> mic-level;
    in property <float> system-level;

    in property <[ClipRow]> clips <=> Main.clips;
    in-out property <int> selected <=> Main.selected;
    in property <int> active-clip <=> Main.active-clip;
    in property <bool> playing <=> Main.playing;
    in property <float> play-fraction <=> Main.play-fraction;
    in property <string> play-position <=> Main.play-position;
    in property <string> play-length: "0:00";
    in-out property <int> speed-index: 1;
    // The transcript shows pauses and the marks for edited and spoken words.
    in-out property <bool> show-marks: true;
    in-out property <bool> looping;
    in property <[float]> detail-wave;
    // The kept part of the highlighted clip, as parts of its length; the handles on
    // the player waveform move them.
    in-out property <float> trim-start: 0;
    in-out property <float> trim-end: 1;
    callback trim-changed(float, float);
    in property <string> detail-meta;

    in-out property <string> status <=> Main.status;
    in property <bool> can-transcribe;
    in property <bool> transcribing;
    in property <bool> translating;
    in property <string> translation;
    in-out property <string> shown-lang;
    in property <[LangRow]> langs;
    callback choose-lang(string);
    callback lang-filter(string);
    // A language needs a model: 1 opens the Whisper models, 2 the AI settings.
    callback install-for(int);
    // The translation model in settings, and its download (below 0 when none runs).
    in property <bool> translator-ready;
    in property <float> translator-download: -1;
    in property <string> summary;
    in property <bool> summarising;
    in property <bool> can-ai <=> Main.can-ai;
    in-out property <bool> show-summary;
    callback summarise-selected();
    // The AI finished translating clip `name` into `code`: whether it worked, and the
    // text or the error.
    callback translated(bool, string, string, string);
    // Ask: the question, whether it covers all projects, the answer as it is
    // written, and the passages it was given.
    in-out property <string> question;
    in-out property <bool> ask-all;
    in property <string> answer;
    in property <bool> asking;
    in property <[AskSource]> sources;
    callback ask(string, bool);
    callback open-source(int);
    callback answered();
    // The AI finished clip `name`: whether it worked, and the summary or the error.
    callback summarised(bool, string, string);
    // The AI model in settings: the choices, the one picked, whether it is
    // downloaded, and the download's progress (below 0 when none runs).
    in property <[string]> ai-models;
    in-out property <int> ai-model-index;
    in property <bool> ai-ready;
    in property <float> ai-download: -1;
    callback ai-model-changed(int);
    // 0 the summary model, 1 the translation model.
    callback download-ai(int);
    in property <float> transcribe-progress;
    in-out property <bool> speaking;
    in property <float> speak-progress;
    in property <string> speak-stage;
    in property <string> transcript;
    in property <[WordRow]> words;
    in property <int> current-word: -1;
    in property <string> edit-badge;
    in property <string> edit-length;
    in property <string> edit-was;
    in-out property <bool> renaming;
    // A question in front of the page: 1 rename a clip, 2 confirm deleting it; which
    // clip, and the name being typed.
    in property <[string]> projects <=> Main.projects;
    in property <int> project <=> Main.project;
    callback create-project(string);
    callback rename-project(string);
    // Files are being dragged over the window.
    in property <bool> dropping;
    in-out property <string> query <=> Main.query;
    in-out property <bool> search-all <=> Main.search-all;
    in property <[SearchHit]> hits <=> Main.hits;
    property <int> search-ticket <=> Main.search-ticket;
    // 1 rename clip, 2 delete clip, 3 unsaved changes, 4 new project, 5 rename project.
    in-out property <int> dialog <=> Main.dialog;
    // How many clips the delete dialog removes.
    property <int> delete-count: 1;
    in-out property <int> dialog-clip;
    in-out property <string> dialog-text <=> Main.dialog-text;
    // The transcript as typed in the editor, to save or throw away when leaving it.
    in-out property <string> edit-draft;
    // The transcript is being edited in its card on the clip page; where to go once
    // the editor is left (-1: stay).
    in-out property <bool> editing;
    property <int> leave-to: -1;

    in property <[string]> mic-devices;
    in-out property <int> mic-index;
    in-out property <bool> record-system;
    in property <string> folder;
    in property <string> name-template;
    in property <string> name-preview;
    in-out property <int> export-format;
    in-out property <bool> clean-voice;
    in property <[string]> languages;
    in-out property <int> language-index;
    in property <[ModelRow]> models;
    in property <string> model-summary;
    in property <string> models-used;
    in property <int> model-count;
    in-out property <string> model-query;
    in-out property <int> model-filter;
    in-out property <bool> model-compressed;
    in property <bool> name-invalid;
    in property <[string]> hotkey-parts;
    in property <int> downloading: -1;
    in property <float> download-progress;
    in-out property <string> hotkey;
    in-out property <bool> close-to-tray: true;
    in property <[string]> recording-limits;
    in-out property <int> recording-limit-index: 2;
    in-out property <bool> start-with-windows;
    in-out property <bool> compact;
    in-out property <length> list-y <=> Main.list-y;
    in-out property <length> list-height <=> Main.list-height;

    // Play or pause the selected clip.
    callback toggle-play();
    callback skip(float);
    callback speed-changed(int);
    callback stop-playback();
    callback delete-selected();
    callback delete-last();
    callback rename-selected(string);
    callback mic-changed(int);
    callback system-changed(bool);
    callback open-folder();
    callback change-folder();
    in-out property <int> export-state <=> Main.export-state;
    in property <float> export-progress <=> Main.export-progress;
    in property <string> export-name <=> Main.export-name;
    in property <[bool]> picked <=> Main.picked;
    in property <int> picked-count <=> Main.picked-count;
    // The merge page: the picked clips in merge order, and the new clip's name.
    in property <[OrderRow]> merge-rows;
    in-out property <string> merge-name;
    in property <bool> merging;
    callback merge-move(int, int);
    callback merge-remove(int);
    callback merge-play(int);
    callback merge-run(string);
    // A merge finished: the status line and the new clip's name (empty on failure).
    callback merged(string, string);
    // A merged clip's parts, shown on its page; empty for an ordinary clip.
    in property <[OrderRow]> parts;
    in property <bool> parts-busy;
    callback parts-move(int, int);
    callback part-take-out(int);
    // Renames part i of the open merged clip.
    callback rename-part(int, string);
    // The part the rename dialog (6) is for.
    property <int> dialog-part;
    // Reordering or taking out a part finished, with the status line.
    callback parts-done(string);
    // The status line, the last clip, and every new clip (one per line).
    callback imported(string, string, string);
    // A transcription run ended: whether it worked, and the line to show.
    callback transcribed(bool, string);
    in-out property <bool> auto-transcribe;
    callback auto-transcribe-changed(bool);
    // New recordings are named by the local AI; needs auto transcribe.
    in-out property <bool> ai-names;
    callback ai-names-changed(bool);
    // The AI named clip `old` in folder `dir`: `title` is the new name.
    callback ai-named(string, string, string);
    // Longer pauses are shortened to this after each transcription.
    in property <[string]> max-pauses;
    in-out property <int> max-pause-index;
    callback max-pause-changed(int);
    // The transcript editor's text as styled text, with the pause tags coloured.
    pure callback edit-markup(string) -> styled-text;
    // The selected part of the editor text (two byte offsets) without pause tags.
    pure callback plain-selection(string, int, int) -> string;
    // Starts resizing the window from an edge: 0 top, 1 bottom, 2 right, 3 left,
    // 4 top right, 5 top left, 6 bottom right, 7 bottom left.
    callback resize-window(int);
    callback transcribe-selected();
    callback selection-changed(int);
    callback edit-changed(string);
    callback apply-transcript(string);
    // A saved edit was baked: refresh the clip list. The argument is its name.
    callback library-changed(string);
    callback cancel-speaking();
    callback seek-word(int);
    callback export-format-changed(int);
    callback clean-voice-changed(bool);
    callback language-changed(int);
    callback template-edited(string);
    callback template-accepted(string);
    callback hotkey-accepted(string);
    callback close-to-tray-changed(bool);
    callback recording-limit-changed(int);
    // Settings picked theme i of Theme.names.
    callback theme-changed(int);
    callback start-with-windows-changed(bool);
    callback download-model(int);
    // The model page's search, chips or compressed toggle changed.
    callback models-filter-changed();
    // A key pressed in the shortcut box, with Ctrl, Alt, Shift and Win. True when it
    // made a shortcut.
    callback hotkey-captured(string, bool, bool, bool, bool) -> bool;
    callback cancel-download();
    callback use-model(int);
    // Clip waveforms finished drawing in the background.
    callback waves-ready();
    callback quit();

    changed selected => {
        if (root.selected < 0) {
            Tour.sel = { x: 0, y: 0, w: 0, h: 0, r: 0, on: false };
        }
        root.selection-changed(root.selected);
    }

    // Status messages fade out after a while.
    status-timer := Timer {
        interval: 8s;
        running: false;
        triggered => { self.running = false; root.status = ""; }
    }
    // Saving from the editor leaves it, so its unsaved-changes question goes too.
    changed page => {
        Tips.hide();
        if (root.dialog == 3) { root.dialog = 0; }
    }
    // Saving ends editing, so its unsaved-changes question goes too.
    changed editing => { if (!root.editing && root.dialog == 3) { root.dialog = 0; } }
    changed status => { status-timer.running = false; status-timer.running = root.status != ""; }

    function move-selection(delta: int) {
        if (clips.length == 0) { return; }
        selected = clamp(selected < 0 ? clips.length - 1 : selected + delta, 0, clips.length - 1);
        if (selected * Main.row-h < -list-y) {
            list-y = -(selected * Main.row-h);
        } else if ((selected + 1) * Main.row-h > -list-y + list-height) {
            list-y = -((selected + 1) * Main.row-h - list-height);
        }
    }

    function ask-rename(i: int) {
        root.dialog-clip = i;
        root.dialog-text = root.clips[i].name;
        root.dialog = 1;
    }
    function ask-delete(i: int) {
        root.dialog-clip = i;
        // A clip among several picked deletes them all.
        root.delete-count = root.picked-count >= 2 && i >= 0 && i < root.picked.length && root.picked[i] ? root.picked-count : 1;
        root.dialog = 2;
        keys.focus();
    }
    function start-edit() {
        root.stop-playback();
        root.edit-draft = root.transcript;
        root.editing = true;
        root.edit-changed(root.transcript);
    }
    // Leaving the editor with changes asks whether to save them (dialog 3); then it
    // goes to page `to` (-1 stays on the clip).
    function leave-editor(to: int) {
        root.leave-to = to;
        if (root.edit-draft == root.transcript || root.speaking) {
            root.editing = false;
            if (to >= 0) { root.go(to); }
        } else {
            root.dialog-clip = root.selected;
            root.dialog = 3;
            keys.focus();
        }
    }
    function discard-edit() {
        root.dialog = 0;
        root.edit-draft = root.transcript;
        root.editing = false;
        if (root.leave-to >= 0) { root.go(root.leave-to); }
        keys.focus();
    }
    function close-dialog() {
        root.dialog = 0;
        keys.focus();
    }
    function confirm-dialog() {
        let kind = root.dialog;
        root.dialog = 0;
        if (kind == 4) {
            root.create-project(root.dialog-text);
        } else if (kind == 5) {
            root.rename-project(root.dialog-text);
        } else if (kind == 6) {
            root.rename-part(root.dialog-part, root.dialog-text);
        } else {
            root.selected = root.dialog-clip;
        }
        if (kind == 1) {
            root.rename-selected(root.dialog-text);
        } else if (kind == 2) {
            root.delete-selected();
            if (root.page != 0) { root.go(0); }
        } else if (kind == 3) {
            root.apply-transcript(root.edit-draft);
            if (root.leave-to >= 0) { root.go(root.leave-to); }
        }
        keys.focus();
    }

    function go(p: int) {
        root.renaming = false;
        root.editing = false;
        // Settings and Models remember where they were opened from, so Back returns there.
        if (p == 3 && root.page != 3 && root.page != 4) { root.settings-back = root.page; }
        if (p == 4 && root.page != 4) { root.models-back = root.page; }
        root.page = p;
        keys.focus();
    }
    // Opens page p as `go` does; for the app's own jumps (a missing model).
    public function visit(p: int) { root.go(p); }
    // Where Back on Settings and on Models leads.
    property <int> settings-back: 0;
    property <int> models-back: 3;

    keys := FocusScope {
        key-pressed(event) => {
            if (root.dialog != 0) {
                if (event.text == Key.Escape) { root.close-dialog(); }
                if (event.text == Key.Return && root.dialog == 2) { root.confirm-dialog(); }
                return accept;
            }
            if (renaming) { return reject; }
            if (event.modifiers.control && (event.text == "f" || event.text == "F") && root.page == 0 && !root.compact) {
                root.search-ticket += 1;
                return accept;
            }
            if (root.editing) {
                if (event.text == Key.Escape) { root.leave-editor(-1); return accept; }
                return reject;
            }
            if (event.text == Key.Escape) {
                if (page != 0) { root.go(page == 4 ? root.models-back : page == 3 ? root.settings-back : 0); } else { root.stop-playback(); Main.pick(-1, false, false); }
                return accept;
            }
            if (page >= 3) { return reject; }
            // Space plays and pauses the highlighted clip; with none highlighted, or
            // while recording, it records.
            if (event.text == " ") {
                if (recording || compact || selected < 0) { Main.toggle-record(); }
                else if (page == 1) { root.toggle-play(); }
                else { Main.play-clip(selected); }
                return accept;
            }
            if (event.text == "p" && recording) { Main.toggle-pause(); return accept; }
            if (page == 1) {
                if (event.text == Key.Return) { root.toggle-play(); return accept; }
                if (event.text == Key.LeftArrow) { root.skip(-5); return accept; }
                if (event.text == Key.RightArrow) { root.skip(5); return accept; }
                if (event.text == Key.F2) { root.renaming = true; return accept; }
                return reject;
            }
            if (event.text == Key.Return) { if (selected >= 0) { Main.play-clip(selected); } return accept; }
            if (event.text == Key.RightArrow && selected >= 0) { Main.open-clip(selected); root.go(1); return accept; }
            if (event.text == Key.Delete) { if (selected >= 0) { root.ask-delete(selected); } return accept; }
            if (event.text == Key.Backspace) { if (clips.length > 0) { root.ask-delete(clips.length - 1); } return accept; }
            if (event.text == Key.F2) { if (selected >= 0) { root.ask-rename(selected); } return accept; }
            if (event.text == Key.UpArrow) { root.move-selection(-1); return accept; }
            if (event.text == Key.DownArrow) { root.move-selection(1); return accept; }
            reject
        }

        // ---------- Widget ----------
        // The widget: status with open window, the time with pause and record, and
        // the live level.
        if compact: Rectangle {
            background: Theme.card;
            border-radius: 18px;
            border-width: 1px;
            border-color: root.recording ? Theme.accent : Theme.border;
            WindowMoveArea {
                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 14px;
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3.5px;
                            background: root.recording ? Theme.accent : Theme.wave-dim;
                        }
                        Text {
                            text: root.recording ? (root.paused ? "PAUSED" : "RECORDING") : "READY";
                            color: root.recording ? Theme.accent : Theme.muted;
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconBtn {
                            size: 26px;
                            round: true;
                            icon: "expand";
                            icon-size: 11px;
                            label: "Open the window";
                            tip: "Open window";
                            clicked => { Main.compact-changed(false); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.elapsed;
                            color: root.recording ? Theme.text : Theme.text2;
                            font-family: Theme.mono;
                            font-size: 30px;
                            letter-spacing: -1px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.recording: VerticalLayout {
                            alignment: center;
                            IconBtn {
                                size: 36px;
                                round: true;
                                outlined: true;
                                icon: root.paused ? "play" : "pause";
                                icon-size: 12px;
                                tint: Theme.text;
                                label: root.paused ? "Resume" : "Pause";
                                clicked => { Main.toggle-pause(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconBtn {
                                size: 44px;
                                round: true;
                                filled: true;
                                icon: root.recording ? "stop" : "mic";
                                icon-size: root.recording ? 15px : 20px;
                                label: root.recording ? "Stop recording" : "Record";
                                tip: root.recording ? "Stop" : "Record";
                                clicked => { Main.toggle-record(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-right: 6px;
                        Wave {
                            height: 14px;
                            gap: 1px;
                            values: root.live;
                            progress: root.recording ? 2 : -1;
                            rest: Theme.track;
                        }
                    }
                }
            }
        }

        // ---------- Clips (main) ----------
        // The theme's skin builds it (ui/skins); the state and actions are in Main.
        if !compact && page == 0 && Theme.skin == 0: ClassicMain {
            narrow: root.narrow;
            wide: root.wide;
            tall: root.tall;
            go(p) => { root.go(p); }
            ask-rename(i) => { root.ask-rename(i); }
            ask-delete(i) => { root.ask-delete(i); }
            refocus => { keys.focus(); }
        }
        if !compact && page == 0 && Theme.skin == 1: TapeMain {
            narrow: root.narrow;
            wide: root.wide;
            tall: root.tall;
            go(p) => { root.go(p); }
            ask-rename(i) => { root.ask-rename(i); }
            ask-delete(i) => { root.ask-delete(i); }
            refocus => { keys.focus(); }
        }

        // ---------- One clip ----------
        if !compact && page == 1 && root.selected >= 0: VerticalLayout {
            TitleBar {
                height: 38px;
                minimize => { Main.minimize-window(); }
                close => { Main.close-window(); }
                BackLink {
                    text: "Clips";
                    y: (parent.height - self.height) / 2;
                    clicked => { if (root.editing) { root.leave-editor(0); } else { root.go(0); } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
            vertical-stretch: 1;
            spacing: 2px;
            padding-right: root.wide ? 18px : 0;
            Scroller {
            vertical-stretch: 1;
            fade: true;
            min-width: root.wide ? 460px : 50px;
            max-width: root.wide ? 460px : 100000px;
            VerticalLayout {
            alignment: start;
            padding-bottom: 8px;
            VerticalLayout {
                vertical-stretch: 0;
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 4px;
                spacing: 4px;
                if !root.renaming: HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.clips[root.selected].name;
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 800;
                        letter-spacing: -0.4px;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        IconBtn {
                            icon: "pencil";
                            label: "Rename clip";
                            tip: "Rename";
                            enabled: !root.recording;
                            clicked => { root.renaming = true; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconBtn {
                            icon: "trash";
                            label: "Delete clip";
                            tip: "Delete";
                            icon-size: 15px;
                            enabled: !root.recording;
                            clicked => { root.ask-delete(root.selected); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.renaming: HorizontalLayout {
                    spacing: 6px;
                    name-edit := LineEdit {
                        text: root.clips[root.selected].name;
                        font-size: 15px;
                        accepted(t) => { root.renaming = false; root.rename-selected(t); keys.focus(); }
                        init => { self.focus(); self.select-all(); }
                    }
                    Btn {
                        text: "Rename";
                        primary: true;
                        clicked => { root.renaming = false; root.rename-selected(name-edit.text); keys.focus(); }
                    }
                    Btn {
                        text: "Cancel";
                        clicked => { root.renaming = false; keys.focus(); }
                    }
                }
                Text {
                    text: root.detail-meta;
                    color: Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                }
            }

            // Player
            HorizontalLayout {
                vertical-stretch: 0;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 16px;
                Rectangle {
                    background: Theme.card;
                    border-radius: 14px;
                    VerticalLayout {
                        padding: 18px;
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 12px;
                        wave-box := Rectangle {
                            height: root.narrow ? 36px : 64px;
                            // The handle being dragged: 1 start, 2 end, 0 none.
                            property <int> grab;
                            property <bool> dragged;
                            // The drawing sits 8px in from each side, so a handle at an end
                            // still has room to be grabbed.
                            property <length> inner-w: self.width - 16px;
                            property <length> start-x: root.trim-start * self.inner-w;
                            property <length> end-x: root.trim-end * self.inner-w;
                            Rectangle {
                                x: 8px;
                                width: parent.width - 16px;
                                Wave {
                                    values: root.detail-wave;
                                    progress: root.active-clip == root.selected ? root.play-fraction : 0;
                                    rest: Theme.wave-dim;
                                }
                                // Trimmed off: dimmed.
                                Rectangle {
                                    x: 0;
                                    width: wave-box.start-x;
                                    background: Theme.card.with-alpha(0.75);
                                }
                                Rectangle {
                                    x: wave-box.end-x;
                                    width: parent.width - wave-box.end-x;
                                    background: Theme.card.with-alpha(0.75);
                                }
                                if root.active-clip == root.selected: Rectangle {
                                    x: clamp(root.play-fraction, 0, 1) * (parent.width - 2px);
                                    y: -4px;
                                    width: 2px;
                                    height: parent.height + 8px;
                                    border-radius: 1px;
                                    background: Theme.text;
                                }
                                // The handles: a bar with a grip at each end of the kept part.
                                for h[k] in [0, 1]: Rectangle {
                                    property <bool> on: k == 0 ? root.trim-start > 0.0005 : root.trim-end < 0.9995;
                                    property <bool> hot: wave-box.grab == k + 1 || (wave-touch.has-hover && abs(wave-touch.at - (k == 0 ? wave-box.start-x : wave-box.end-x)) <= 8px);
                                    x: (k == 0 ? wave-box.start-x : wave-box.end-x) - 1.5px;
                                    y: -6px;
                                    width: 3px;
                                    height: parent.height + 12px;
                                    border-radius: 1.5px;
                                    background: self.on || self.hot ? Theme.accent : Theme.muted.with-alpha(0.5);
                                    Rectangle {
                                        x: -3px;
                                        y: (parent.height - self.height) / 2;
                                        width: 9px;
                                        height: 20px;
                                        border-radius: 4.5px;
                                        background: parent.background;
                                    }
                                }
                            }
                            wave-touch := TouchArea {
                                property <length> at: self.mouse-x - 8px;
                                mouse-cursor: abs(self.at - wave-box.start-x) <= 8px || abs(self.at - wave-box.end-x) <= 8px
                                    ? MouseCursor.ew-resize : MouseCursor.pointer;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        wave-box.dragged = false;
                                        wave-box.grab = abs(self.at - wave-box.start-x) <= 8px ? 1
                                            : abs(self.at - wave-box.end-x) <= 8px ? 2 : 0;
                                    }
                                    if (e.kind == PointerEventKind.up && wave-box.grab != 0) {
                                        if (wave-box.dragged) { root.trim-changed(root.trim-start, root.trim-end); }
                                        wave-box.grab = 0;
                                    }
                                }
                                moved => {
                                    if (wave-box.grab == 1) {
                                        root.trim-start = clamp(self.at / wave-box.inner-w, 0, root.trim-end - 0.01);
                                        wave-box.dragged = true;
                                    } else if (wave-box.grab == 2) {
                                        root.trim-end = clamp(self.at / wave-box.inner-w, root.trim-start + 0.01, 1);
                                        wave-box.dragged = true;
                                    }
                                }
                                clicked => {
                                    // Runs before the release above; `dragged` is reset on the next press.
                                    if (!wave-box.dragged) { Main.seek-fraction(clamp(self.at / wave-box.inner-w, 0, 1)); }
                                    keys.focus();
                                }
                            }
                        }
                        if !root.narrow: HorizontalLayout {
                            Text {
                                text: root.active-clip == root.selected ? root.play-position : "0:00";
                                color: Theme.muted;
                                font-family: Theme.mono;
                                font-size: 11px;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.clips[root.selected].duration;
                                color: Theme.muted;
                                font-family: Theme.mono;
                                font-size: 11px;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 36px;
                                    round: true;
                                    outlined: true;
                                    icon: "rewind";
                                    icon-size: 22px;
                                    tint: Theme.text;
                                    label: "Back 5 seconds";
                                    tip: "Back 5 seconds";
                                    clicked => { root.skip(-5); keys.focus(); }
                                    Text {
                                        text: "5";
                                        color: Theme.text;
                                        font-size: 8px;
                                        font-weight: 800;
                                        y: 13.5px;
                                    }
                                }
                            }
                            IconBtn {
                                size: 44px;
                                round: true;
                                filled: true;
                                icon: root.active-clip == root.selected && root.playing ? "pause" : "play";
                                icon-size: 14px;
                                label: root.active-clip == root.selected && root.playing ? "Pause" : "Play";
                                clicked => { root.toggle-play(); keys.focus(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 36px;
                                    round: true;
                                    outlined: true;
                                    icon: "forward";
                                    icon-size: 22px;
                                    tint: Theme.text;
                                    label: "Forward 5 seconds";
                                    clicked => { root.skip(5); keys.focus(); }
                                    Text {
                                        text: "5";
                                        color: Theme.text;
                                        font-size: 8px;
                                        font-weight: 800;
                                        y: 13.5px;
                                    }
                                }
                            }
                            if root.narrow: Text {
                                text: (root.active-clip == root.selected ? root.play-position : "0:00") + " / " + root.clips[root.selected].duration;
                                color: Theme.muted;
                                font-family: Theme.mono;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    width: 86px;
                                    height: 30px;
                                    label: "Speed";
                                    model: ["0.75×", "1.0×", "1.25×", "1.5×", "2.0×"];
                                    current-index <=> root.speed-index;
                                    selected(i) => { root.speed-changed(i); keys.focus(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    text: "Loop";
                                    height: 30px;
                                    font-size: 12px;
                                    on: root.looping;
                                    clicked => { root.looping = !root.looping; keys.focus(); }
                                }
                            }
                        }
                    }
                }
            }

            // Transcript (on wide windows it has its own column instead)
            if !root.wide: HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                TranscriptCard {
                    transcript: root.transcript;
                    transcribing: root.transcribing;
                    translating: root.translating;
                    translation: root.translation;
                    shown-lang <=> root.shown-lang;
                    langs: root.langs;
                    choose-lang(c) => { root.choose-lang(c); }
                    lang-filter(t) => { root.lang-filter(t); }
                    install-for(k) => { root.install-for(k); }
                    summary: root.summary;
                    summarising: root.summarising;
                    can-ai: root.can-ai;
                    show-summary <=> root.show-summary;
                    summarise => { root.summarise-selected(); }
                    transcribe-progress: root.transcribe-progress;
                    words: root.words;
                    current-word: root.current-word;
                    show-marks <=> root.show-marks;
                    can-transcribe: root.can-transcribe;
                    recording: root.recording;
                    editing: root.editing;
                    edit-draft <=> root.edit-draft;
                    edit-badge: root.edit-badge;
                    speaking: root.speaking;
                    edit => { root.start-edit(); }
                    edited(t) => { root.edit-changed(t); }
                    cancel => { root.leave-editor(-1); }
                    save => { root.apply-transcript(root.edit-draft); }
                    edit-markup(t) => { return root.edit-markup(t); }
                    plain-selection(t, a, b) => { return root.plain-selection(t, a, b); }
                    transcribe => { root.transcribe-selected(); keys.focus(); }
                    seek-word(i) => { root.seek-word(i); keys.focus(); }
                    height: root.transcript != "" && !root.transcribing ? 170px : self.preferred-height;
                }
            }

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 18px;
                if root.parts.length >= 2: VerticalLayout {
                    padding-bottom: 18px;
                    Card {
                        title: root.parts-busy ? "PARTS  ·  WORKING..." : "PARTS";
                        CardPart {
                            first: true;
                            last: true;
                        VerticalLayout {
                            padding: 4px;
                            OrderList {
                                rows: root.parts;
                                menu: true;
                                enabled: !root.parts-busy && !root.recording;
                                moved(a, b) => { root.parts-move(a, b); }
                                act(i) => { root.part-take-out(i); }
                                rename(i) => {
                                    root.dialog-part = i;
                                    root.dialog-text = root.parts[i].name;
                                    root.dialog = 6;
                                }
                            }
                        }
                        }
                    }
                }
                Card {
                    title: "OPTIONS";
                    CardRow {
                        first: true;
                        label: "Clean voice on export";
                        note: "Less noise";
                        last: true;
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                label: "Clean voice on export";
                                checked <=> root.clean-voice;
                                toggled(on) => { root.clean-voice-changed(on); }
                            }
                        }
                    }
                }
            }
            }
            }

            if root.wide: VerticalLayout {
                horizontal-stretch: 1;
                padding-top: 16px;
                TranscriptCard {
                    transcript: root.transcript;
                    transcribing: root.transcribing;
                    translating: root.translating;
                    translation: root.translation;
                    shown-lang <=> root.shown-lang;
                    langs: root.langs;
                    choose-lang(c) => { root.choose-lang(c); }
                    lang-filter(t) => { root.lang-filter(t); }
                    install-for(k) => { root.install-for(k); }
                    summary: root.summary;
                    summarising: root.summarising;
                    can-ai: root.can-ai;
                    show-summary <=> root.show-summary;
                    summarise => { root.summarise-selected(); }
                    transcribe-progress: root.transcribe-progress;
                    words: root.words;
                    current-word: root.current-word;
                    show-marks <=> root.show-marks;
                    can-transcribe: root.can-transcribe;
                    recording: root.recording;
                    editing: root.editing;
                    edit-draft <=> root.edit-draft;
                    edit-badge: root.edit-badge;
                    speaking: root.speaking;
                    edit => { root.start-edit(); }
                    edited(t) => { root.edit-changed(t); }
                    cancel => { root.leave-editor(-1); }
                    save => { root.apply-transcript(root.edit-draft); }
                    edit-markup(t) => { return root.edit-markup(t); }
                    plain-selection(t, a, b) => { return root.plain-selection(t, a, b); }
                    transcribe => { root.transcribe-selected(); keys.focus(); }
                    seek-word(i) => { root.seek-word(i); keys.focus(); }
                    vertical-stretch: 1;
                }
            }
            }

            HorizontalLayout {
                vertical-stretch: 0;
                padding: 16px;
                padding-top: 12px;
                padding-bottom: 14px;
                spacing: 6px;
                Rectangle { horizontal-stretch: 1; }
                ExportButton {
                    format: root.export-format;
                    subtitles: root.transcript != "";
                    state: root.export-state;
                    progress: root.export-progress;
                    export(kind) => { Main.export-as(kind); keys.focus(); }
                }
            }
            if root.status != "": Text {
                text: root.status;
                color: Theme.dim;
                font-size: 11px;
                overflow: elide;
                x: 22px;
                width: parent.width - 44px;
                height: 24px;
                vertical-alignment: center;
            }
        }

        // ---------- Settings ----------
        if !compact && page == 3: VerticalLayout {
            TitleBar {
                minimize => { Main.minimize-window(); }
                close => { Main.close-window(); }
            }
            PageHeader { title: "Settings"; back => { root.go(root.settings-back); } }
            Scroller {
                vertical-stretch: 1;
                fade: true;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 12px;
                    padding-bottom: 20px;
                    spacing: 18px;
                    alignment: start;

                    FlexboxLayout {
                    flex-direction: root.wide ? FlexboxLayoutDirection.row : FlexboxLayoutDirection.column;
                    flex-wrap: no-wrap;
                    alignment: stretch;
                    cross-axis-alignment: root.wide ? CrossAxisAlignment.start : CrossAxisAlignment.stretch;
                    spacing: 18px;
                    VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 18px;
                    Card {
                        title: "APPEARANCE";
                        CardRow {
                            first: true;
                            label: "Theme";
                            last: true;
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Theme";
                                    model: Theme.names;
                                    current-index: Theme.current;
                                    selected(i) => { root.theme-changed(i); }
                                }
                            }
                        }
                    }

                    Card {
                        title: "RECORDING";
                        CardRow {
                            first: true;
                            label: "Microphone";
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Microphone";
                                    model: root.mic-devices;
                                    current-index <=> root.mic-index;
                                    enabled: !root.recording;
                                    selected(i) => { root.mic-changed(i); }
                                }
                            }
                        }
                        CardRow {
                            label: "System audio";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "System audio";
                                    checked <=> root.record-system;
                                    toggled(on) => { root.system-changed(on); }
                                }
                            }
                        }
                        CardRow {
                            label: "Stop recording after";
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Stop recording after";
                                    model: root.recording-limits;
                                    current-index <=> root.recording-limit-index;
                                    selected(i) => { root.recording-limit-changed(i); }
                                }
                            }
                        }
                        CardRow {
                            label: "Record hotkey";
                            last: true;
                            VerticalLayout {
                                alignment: center;
                                ShortcutBox {
                                    label: "Record hotkey";
                                    keys: root.hotkey-parts;
                                    captured(text, ctrl, alt, shift, meta) => { return root.hotkey-captured(text, ctrl, alt, shift, meta); }
                                    cleared => { root.hotkey-accepted(""); }
                                    done => { keys.focus(); }
                                }
                            }
                            if root.hotkey-parts.length > 0: VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 28px;
                                    icon: "close";
                                    icon-size: 11px;
                                    label: "Clear the shortcut";
                                    tip: "Clear shortcut";
                                    clicked => { root.hotkey-accepted(""); }
                                }
                            }
                        }
                    }

                    Card {
                        title: "FILES";
                        CardRow {
                            first: true;
                            label: "Folder";
                            Text {
                                text: root.folder;
                                color: Theme.muted;
                                font-family: Theme.mono;
                                font-size: 12px;
                                overflow: elide;
                                max-width: 190px;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 32px;
                                    icon: "folder";
                                    label: "Open the folder";
                                    tip: "Open folder";
                                    tint: Theme.text2;
                                    clicked => { root.open-folder(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn { text: "Change"; height: 32px; font-size: 12px; enabled: !root.recording; clicked => { root.change-folder(); } }
                            }
                        }
                        CardPart {
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 6px;
                            Text { text: "File name"; color: Theme.text; font-size: 14px; }
                            TextField {
                                label: "File name";
                                mono: true;
                                text: root.name-template;
                                invalid: root.name-invalid;
                                edited(t) => { root.template-edited(t); }
                                accepted(t) => { root.template-accepted(t); keys.focus(); }
                            }
                            Text {
                                text: root.name-preview;
                                color: root.name-invalid ? Theme.danger : Theme.dim;
                                font-size: 12px;
                                font-family: root.name-invalid ? "Inter Tight" : Theme.mono;
                                overflow: elide;
                            }
                        }
                        }
                        CardPart { height: 1px; Rectangle { background: Theme.divider; } }
                        CardRow {
                            label: "Export format";
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Export format";
                                    model: ["FLAC", "WAV", "MP3"];
                                    current-index <=> root.export-format;
                                    selected(i) => { root.export-format-changed(i); }
                                }
                            }
                        }
                        CardRow {
                            label: "Clean voice on export";
                            last: true;
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Clean voice on export";
                                    checked <=> root.clean-voice;
                                    toggled(on) => { root.clean-voice-changed(on); }
                                }
                            }
                        }
                    }

                    }
                    VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 18px;
                    Card {
                        title: "TRANSCRIPTION";
                        if !root.can-transcribe: CardRow { label: "Not in this build"; first: true; last: true; }
                        if root.can-transcribe: CardRow {
                            first: true;
                            label: "Language";
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Language";
                                    model: root.languages;
                                    current-index <=> root.language-index;
                                    selected(i) => { root.language-changed(i); }
                                }
                            }
                        }
                        if root.can-transcribe: CardRow {
                            label: "Auto transcribe";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Auto transcribe";
                                    checked <=> root.auto-transcribe;
                                    toggled(on) => { root.auto-transcribe-changed(on); }
                                }
                            }
                        }
                        if root.can-transcribe && root.can-ai: CardRow {
                            label: "AI names";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "AI names";
                                    enabled: root.auto-transcribe;
                                    checked <=> root.ai-names;
                                    toggled(on) => { root.ai-names-changed(on); }
                                }
                            }
                        }
                        if root.can-transcribe: CardRow {
                            label: "Max pause";
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "Max pause";
                                    model: root.max-pauses;
                                    current-index <=> root.max-pause-index;
                                    selected(i) => { root.max-pause-changed(i); }
                                }
                            }
                        }
                        if root.can-transcribe: Rectangle {
                            height: model-row.preferred-height;
                            accessible-role: button;
                            accessible-label: "Browse models";
                            accessible-action-default => { root.go(4); }
                            model-touch := TouchArea { mouse-cursor: pointer; clicked => { root.go(4); } }
                            model-row := CardRow {
                                width: 100%;
                                label: "Model";
                                note: root.model-summary;
                                last: true;
                                Text { text: "Browse"; color: model-touch.has-hover ? Theme.accent-hover : Theme.accent; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                Icon { name: "chevron"; tint: Theme.muted; y: (parent.height - self.height) / 2; }
                            }
                        }
                    }

                    if root.can-ai: Card {
                        title: "AI";
                        CardRow {
                            first: true;
                            label: "Model";
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    label: "AI model";
                                    model: root.ai-models;
                                    current-index <=> root.ai-model-index;
                                    selected(i) => { root.ai-model-changed(i); }
                                }
                            }
                        }
                        CardRow {
                            label: root.ai-ready ? "Ready" : root.ai-download >= 0 ? "Downloading " + round(root.ai-download * 100) + "%" : "Not downloaded";
                            if !root.ai-ready && root.ai-download < 0: VerticalLayout {
                                alignment: center;
                                Btn {
                                    text: "Download";
                                    height: 30px;
                                    font-size: 12px;
                                    clicked => { root.download-ai(0); }
                                }
                            }
                        }
                        CardRow {
                            label: "Translation";
                            note: "Ministral 3B · 2.1 GB";
                            last: true;
                            if root.translator-ready: Text { text: "Ready"; color: Theme.text2; font-size: 13px; vertical-alignment: center; }
                            if !root.translator-ready && root.translator-download >= 0: Text {
                                text: "Downloading " + round(root.translator-download * 100) + "%";
                                color: Theme.text2;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            if !root.translator-ready && root.translator-download < 0: VerticalLayout {
                                alignment: center;
                                Btn {
                                    text: "Download";
                                    height: 30px;
                                    font-size: 12px;
                                    clicked => { root.download-ai(1); }
                                }
                            }
                        }
                    }

                    Card {
                        title: "YOUR VOICE";
                        CardRow {
                            first: true;
                            label: "Voice engine";
                            Text { text: "OmniVoice"; color: Theme.text2; font-size: 13px; vertical-alignment: center; }
                        }
                        CardRow {
                            label: "Voice sample";
                            last: true;
                            Text { text: "20 s from the clip"; color: Theme.text2; font-size: 13px; vertical-alignment: center; }
                        }
                    }

                    Card {
                        title: "WINDOW";
                        CardRow {
                            first: true;
                            label: "Close button hides to tray";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Close button hides to tray";
                                    checked <=> root.close-to-tray;
                                    toggled(on) => { root.close-to-tray-changed(on); }
                                }
                            }
                        }
                        CardRow {
                            label: "Start with Windows";
                            last: true;
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Start with Windows";
                                    checked <=> root.start-with-windows;
                                    toggled(on) => { root.start-with-windows-changed(on); }
                                }
                            }
                        }
                    }
                    }
                    }
                }
            }
            if root.status != "": Text {
                text: root.status;
                color: Theme.dim;
                font-size: 11px;
                overflow: elide;
                x: 22px;
                width: parent.width - 44px;
                height: 28px;
                vertical-alignment: center;
            }
        }

        // ---------- Merge ----------
        if !compact && page == 5: VerticalLayout {
            TitleBar {
                minimize => { Main.minimize-window(); }
                close => { Main.close-window(); }
            }
            PageHeader { title: "Merge clips"; note: root.merge-rows.length + " clips"; back => { root.go(0); } }
            Scroller {
                vertical-stretch: 1;
                fade: true;
                VerticalLayout {
                    alignment: start;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 12px;
                    spacing: 18px;
                    Card {
                        title: "ORDER";
                        CardPart {
                            first: true;
                            last: true;
                        VerticalLayout {
                            padding: 4px;
                            OrderList {
                                rows: root.merge-rows;
                                removable: true;
                                playable: true;
                                playing-name: root.active-clip >= 0 && root.active-clip < root.clips.length && root.playing ? root.clips[root.active-clip].name : "";
                                enabled: !root.merging;
                                moved(a, b) => { root.merge-move(a, b); }
                                act(i) => { root.merge-remove(i); }
                                play(i) => { root.merge-play(i); }
                            }
                        }
                        }
                    }
                    Card {
                        title: "NEW CLIP";
                        CardRow {
                            first: true;
                            label: "Name";
                            last: true;
                            TextField {
                                width: 220px;
                                label: "Name of the merged clip";
                                text <=> root.merge-name;
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 0;
                padding: 16px;
                padding-top: 12px;
                padding-bottom: 14px;
                spacing: 6px;
                Rectangle { horizontal-stretch: 1; }
                Btn {
                    text: "Cancel";
                    clicked => { root.go(0); }
                }
                Btn {
                    primary: true;
                    text: root.merging ? "Merging..." : "Merge " + root.merge-rows.length + " clips";
                    enabled: !root.merging && root.merge-name != "";
                    clicked => { root.merge-run(root.merge-name); }
                }
            }
            if root.status != "": Text {
                text: root.status;
                color: Theme.dim;
                font-size: 11px;
                overflow: elide;
                x: 22px;
                width: parent.width - 44px;
                height: 28px;
                vertical-alignment: center;
            }
        }

        // ---------- Ask ----------
        if !compact && page == 6: VerticalLayout {
            TitleBar {
                minimize => { Main.minimize-window(); }
                close => { Main.close-window(); }
            }
            PageHeader { title: "Ask"; back => { root.go(0); } }
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 16px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 8px;
                    TextField {
                        height: 36px;
                        icon: "message";
                        placeholder: "Ask about your clips";
                        label: "Question";
                        text <=> root.question;
                        init => { self.grab(); }
                        accepted => { if (root.question != "" && !root.asking) { root.ask(root.question, root.ask-all); } }
                    }
                    if root.projects.length > 1: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: scope-text.preferred-width + 18px;
                            height: 28px;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: root.ask-all ? Theme.accent.with-alpha(0.5) : Theme.edge;
                            background: root.ask-all ? Theme.accent.with-alpha(0.08) : transparent;
                            accessible-role: checkbox;
                            accessible-label: "Ask all projects";
                            accessible-checked: root.ask-all;
                            accessible-action-default => { root.ask-all = !root.ask-all; }
                            scope-text := Text {
                                x: 9px;
                                y: (parent.height - self.height) / 2;
                                text: "All projects";
                                color: root.ask-all ? Theme.accent : Theme.muted;
                                font-size: 11px;
                                font-weight: 600;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.ask-all = !root.ask-all; }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            text: "Ask";
                            primary: true;
                            height: 36px;
                            enabled: root.question != "" && !root.asking;
                            clicked => { root.ask(root.question, root.ask-all); }
                        }
                    }
                }
                if root.answer != "" || root.asking: Rectangle {
                    background: Theme.card;
                    border-radius: 14px;
                    height: min(answer-box.preferred-height, 320px);
                    Scroller {
                        answer-box := VerticalLayout {
                            padding: 16px;
                            Text {
                                text: root.answer != "" ? root.answer : "Thinking";
                                color: root.answer != "" ? Theme.text2 : Theme.dim;
                                font-size: 15px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                if root.sources.length > 0: Text {
                    text: "SOURCES";
                    color: Theme.muted;
                    font-size: 11px;
                    font-weight: 800;
                    letter-spacing: 1px;
                }
                Scroller {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        for s[i] in root.sources: SourceRow {
                            source: s;
                            show-project: root.ask-all;
                            project: s.place >= 0 && s.place < root.projects.length ? root.projects[s.place] : "";
                            clicked => { root.open-source(i); root.go(1); }
                        }
                    }
                }
            }
        }

        // ---------- Models ----------
        if !compact && page == 4: VerticalLayout {
            TitleBar {
                minimize => { Main.minimize-window(); }
                close => { Main.close-window(); }
            }
            PageHeader { title: "Models"; note: root.models-used; back => { root.go(root.models-back); } }
            VerticalLayout {
                vertical-stretch: 0;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                spacing: 12px;
                TextField {
                    icon: "search";
                    label: "Search models";
                    placeholder: "Search " + root.model-count + " models";
                    text <=> root.model-query;
                    edited => { root.models-filter-changed(); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for f[i] in ["All", "Norwegian", "Swedish", "English", "Downloaded"]: Chip {
                        text: f;
                        on: root.model-filter == i;
                        clicked => { root.model-filter = i; root.models-filter-changed(); }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: "Show compressed versions too";
                            checked <=> root.model-compressed;
                            toggled => { root.models-filter-changed(); }
                        }
                    }
                    Text {
                        text: "Show compressed";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
            Scroller {
                vertical-stretch: 1;
                VerticalLayout {
                alignment: start;
                padding-bottom: 12px;
                for m in root.models: VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    if m.header: HorizontalLayout {
                        padding-top: 18px;
                        padding-bottom: 6px;
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: m.title;
                            color: Theme.muted;
                            font-size: 11px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            horizontal-stretch: 1;
                        }
                        Text { text: m.by; color: Theme.dim; font-size: 11px; }
                    }
                    if !m.header: Rectangle {
                        background: Theme.card;
                        border-top-left-radius: m.first ? 14px : 0;
                        border-top-right-radius: m.first ? 14px : 0;
                        border-bottom-left-radius: m.last ? 14px : 0;
                        border-bottom-right-radius: m.last ? 14px : 0;
                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 5px;
                                    Text { text: m.title; color: Theme.text; font-size: 14px; font-weight: 500; overflow: elide; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Text { text: "Quality"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
                                        Meter { value: m.quality; y: (parent.height - self.height) / 2; }
                                        Rectangle { width: 6px; }
                                        Text { text: "Speed"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
                                        Meter { value: m.speed; y: (parent.height - self.height) / 2; }
                                        Rectangle { width: 6px; }
                                        Text { text: m.size; color: Theme.dim; font-family: Theme.mono; font-size: 11px; vertical-alignment: center; }
                                    }
                                }
                                if m.active: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: use-label.preferred-width + 20px;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: Theme.accent.with-alpha(0.14);
                                        use-label := Text { text: "In use"; color: Theme.accent; font-size: 12px; font-weight: 800; }
                                    }
                                }
                                if m.downloaded && !m.active: VerticalLayout {
                                    alignment: center;
                                    Btn { text: "Use"; height: 30px; font-size: 12px; clicked => { root.use-model(m.index); } }
                                }
                                if root.downloading == m.index: VerticalLayout {
                                    alignment: center;
                                    Btn { text: "Cancel"; height: 30px; font-size: 12px; clicked => { root.cancel-download(); } }
                                }
                                if !m.downloaded && root.downloading != m.index: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: dl.preferred-width + 24px;
                                        height: 30px;
                                        border-radius: 8px;
                                        background: dl-touch.has-hover && root.downloading < 0 ? Theme.press : Theme.hover;
                                        opacity: root.downloading < 0 ? 1 : 0.4;
                                        accessible-role: button;
                                        accessible-label: "Download " + m.title;
                                        accessible-action-default => { if (root.downloading < 0) { root.download-model(m.index); } }
                                        dl := Text { text: "Download"; color: Theme.text; font-size: 12px; }
                                        dl-touch := TouchArea {
                                            enabled: root.downloading < 0;
                                            mouse-cursor: pointer;
                                            clicked => { root.download-model(m.index); }
                                        }
                                    }
                                }
                            }
                            if root.downloading == m.index: HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    height: 4px;
                                    y: (parent.height - self.height) / 2;
                                    horizontal-stretch: 1;
                                    border-radius: 2px;
                                    background: Theme.track;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * clamp(root.download-progress, 0, 1);
                                        border-radius: 2px;
                                        background: Theme.accent;
                                    }
                                }
                                Text {
                                    text: round(root.download-progress * 100) + "%";
                                    color: Theme.text2;
                                    font-family: Theme.mono;
                                    font-size: 11px;
                                }
                            }
                        }
                        if !m.last: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.divider; }
                    }
                }
                }
            }
            if root.models.length == 0: Text {
                text: "No models match";
                color: Theme.dim;
                font-size: 13px;
                horizontal-alignment: center;
                height: 60px;
            }
            if root.status != "": Text {
                text: root.status;
                color: Theme.dim;
                font-size: 11px;
                overflow: elide;
                x: 22px;
                width: parent.width - 44px;
                height: 28px;
                vertical-alignment: center;
            }
        }

        // New words take a while to speak: cover the window so that is obvious.
        if root.speaking && !root.compact: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: #000000c8;
            TouchArea { }
            Rectangle {
                width: min(parent.width - 48px, 340px);
                height: card.preferred-height;
                background: Theme.card;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.edge;
                card := VerticalLayout {
                    padding: 22px;
                    spacing: 12px;
                    Text {
                        text: "Speaking new words";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 800;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.speak-stage;
                        color: Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.track;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.speak-progress, 0, 1);
                            border-radius: 2px;
                            background: Theme.accent;
                        }
                    }
                    HorizontalLayout {
                        Text {
                            text: round(root.speak-progress * 100) + "%";
                            color: Theme.muted;
                            font-family: Theme.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Btn {
                            text: "Cancel";
                            clicked => { root.cancel-speaking(); }
                        }
                    }
                }
            }
        }
    }

    if !compact: Rectangle {
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-color: Theme.border;
    }

    init => { keys.focus(); Win.width = self.width; Win.height = self.height; }
    changed width => { Win.width = self.width; }
    changed height => { Win.height = self.height; }

    // Files dragged over the window: a drop imports them.
    if root.dropping && !root.compact: Rectangle {
        background: Theme.bg.with-alpha(0.88);
        Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
            border-radius: 16px;
            border-width: 2px;
            border-color: Theme.accent;
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    Icon { name: "file-plus"; tint: Theme.accent; width: 34px; height: 34px; }
                }
                Text {
                    text: "Drop to import";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
            }
        }
    }

    if root.dialog >= 4 || (root.dialog != 0 && root.dialog-clip >= 0 && root.dialog-clip < root.clips.length): Rectangle {
        background: #000000a6;
        // A click outside the box cancels.
        TouchArea { clicked => { root.close-dialog(); } }
        Rectangle {
            width: min(parent.width - 48px, 360px);
            height: box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 30px;
            background: Theme.card;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: #000000aa;
            TouchArea { }
            box := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text {
                    text: root.dialog == 1 ? "Rename clip" : root.dialog == 3 ? "Unsaved changes" : root.dialog == 4 ? "New project"
                        : root.dialog == 5 ? "Rename project" : root.dialog == 6 ? "Rename part"
                        : root.delete-count > 1 ? "Delete " + root.delete-count + " clips?" : "Delete " + root.clips[root.dialog-clip].name + "?";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 800;
                    overflow: elide;
                }
                if root.dialog == 3: Text {
                    text: "Leave without saving";
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if root.dialog == 2: Text {
                    text: root.delete-count > 1 ? "They go to the Recycle Bin" : "Goes to the Recycle Bin";
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if root.dialog == 1 || root.dialog >= 4: TextField {
                    label: root.dialog == 4 ? "Project name" : "New name";
                    text <=> root.dialog-text;
                    init => { self.grab(); }
                    accepted => { root.confirm-dialog(); }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Btn {
                        text: "Cancel";
                        clicked => { root.close-dialog(); }
                    }
                    if root.dialog == 3: Btn {
                        text: "Discard changes";
                        clicked => { root.discard-edit(); }
                    }
                    Btn {
                        primary: true;
                        text: root.dialog == 1 || root.dialog == 5 || root.dialog == 6 ? "Rename" : root.dialog == 3 ? "Save" : root.dialog == 4 ? "Create" : "Delete";
                        enabled: (root.dialog != 1 && root.dialog < 4) || root.dialog-text != "";
                        clicked => { root.confirm-dialog(); }
                    }
                }
            }
        }
    }

    // A finished export shows its check for a moment.
    Timer {
        interval: 2500ms;
        running: root.export-state == 2;
        triggered => { root.export-state = 0; }
    }

    // Cyberpunk: two snakes of light, cyan and magenta, touring the main page in
    // opposite directions: round the recorder, through the gap to the toolbar, the
    // highlighted clip, out to the window frame and back. A lap of a box takes a few
    // seconds; recording doubles the clock and so their speed.
    if Theme.current == 7 && !root.compact && root.page == 0: Rectangle {
        property <[TourPoint]> route: Tour.route(Tour.rec, Tour.tool, Tour.sel, root.width / 1px, root.height / 1px, Tour.foot, root.wide);
        property <float> head: Fx.t * 120;
        TourSnake { route: parent.route; head: parent.head; dir: 1; tint: #00f0ff; }
        TourSnake { route: parent.route; head: parent.route.length / 2 - parent.head; dir: -1; tint: #ff2bd6; }
    }

    // The tooltip, below the hovered button (above it near the bottom edge), kept
    // inside the window.
    Timer {
        interval: 550ms;
        running: Tips.wanted && !Tips.shown;
        triggered => { Tips.shown = true; }
    }
    if Tips.shown && Tips.text != "": Tip {
        text: Tips.text;
        x: clamp(Tips.at.x + Tips.w / 2 - self.width / 2, 6px, root.width - self.width - 6px);
        y: Tips.at.y + Tips.h + 6px + self.height > root.height - 6px ? Tips.at.y - self.height - 6px : Tips.at.y + Tips.h + 6px;
    }

    // The window has no frame, so its edges and corners resize it here.
    if !compact: ResizeEdge { direction: 0; x: 12px; y: 0; width: parent.width - 24px; height: 5px; mouse-cursor: ns-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 1; x: 12px; y: parent.height - 5px; width: parent.width - 24px; height: 5px; mouse-cursor: ns-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 2; x: parent.width - 5px; y: 12px; width: 5px; height: parent.height - 24px; mouse-cursor: ew-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 3; x: 0; y: 12px; width: 5px; height: parent.height - 24px; mouse-cursor: ew-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 4; x: parent.width - 12px; y: 0; width: 12px; height: 12px; mouse-cursor: nesw-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 5; x: 0; y: 0; width: 12px; height: 12px; mouse-cursor: nwse-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 6; x: parent.width - 12px; y: parent.height - 12px; width: 12px; height: 12px; mouse-cursor: nwse-resize; resize(d) => { root.resize-window(d); } }
    if !compact: ResizeEdge { direction: 7; x: 0; y: parent.height - 12px; width: 12px; height: 12px; mouse-cursor: nesw-resize; resize(d) => { root.resize-window(d); } }

}
