    property <length> row-h: Theme.cozy || Theme.pinball || Theme.phono ? 30px : Theme.tape || Theme.answer ? 26px : Theme.os95 ? 18px : Theme.comic ? 30px : Theme.pocket ? 22px : Theme.quest ? 27px : Theme.brick ? 22px : Theme.synth ? 28px : 32px;
