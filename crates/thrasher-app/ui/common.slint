        // Pocket: the dark picker, a light ring inside while it has the focus.
        // Brick Phone: a boxed value with a pixel arrow; its list is a numbered pick list.
        // Pocket Synth: a small black screen in a dark bezel and grey rim, orange while focused.
        border-width: Theme.phono ? 0 : Theme.pinball ? 1.5px : Theme.comic || Theme.answer || Theme.pocket || Theme.quest || Theme.cozy ? 0 : Theme.brick ? 2px : Theme.synth ? 2px : Theme.dash ? 1px : keys.has-focus && !Theme.os95 ? 1px : 0;
        border-color: Theme.pinball ? (keys.has-focus ? Pb.plasma : t.has-hover && enabled ? #c9c3cf : Pb.edge) : Theme.tape ? Deck.amber : Theme.dash ? (keys.has-focus ? Theme.accent : #ffffff1f) : Theme.synth ? (keys.has-focus ? #ff5a1e : #262625) : Theme.edge;
        // Tape Deck: a black Dymo label strip. Desktop 95: a sunken white drop down box, the
        // choice navy while it has the focus. Car Dashboard: a glass chip with a chevron.
        background: Theme.phono ? Pn.plate-face : Theme.pinball ? Pb.well : Theme.cozy ? transparent : Theme.tape ? (t.has-hover && enabled ? @linear-gradient(180deg, #2a2a2d 0%, #141416 100%) : Deck.dymo)
            : Theme.pocket ? (!root.enabled ? Pk.l1 : t.has-hover ? Pk.l2 : Pk.l3)
            : Theme.dash ? (t.has-hover && enabled ? #1f252d : #181d23)
            : Theme.synth ? (t.has-hover && enabled ? #1a1c1c : #0b0c0c)
            : Theme.comic || Theme.answer ? transparent
            : Theme.quest ? (keys.has-focus || (t.has-hover && enabled) ? Quest.sel : transparent)
            : Theme.brick ? (t.has-hover && enabled ? Brick.ghost : transparent)
            : Theme.os95 ? (root.enabled ? #ffffff : Os.face)
            : t.has-hover && enabled ? Theme.hover-soft : Theme.raised;
        opacity: enabled || Theme.os95 || Theme.pocket || Theme.quest ? 1 : Theme.brick || Theme.cozy || Theme.pinball ? 0.38 : Theme.answer ? 0.55 : 0.45;
        // Phonograph: a brass card holder round an ivory card, a bright brass ring while it
        // has the focus.
        if Theme.phono: PnHolder { x: 0; y: 0; width: root.width; height: root.height; hot: keys.has-focus; hover: t.has-hover && root.enabled; }
        // Cozy Cabin: the parchment picker in its ink ring, ringed honey while it has the focus.
        if Theme.cozy: CzNote { x: 0; y: 0; width: root.width; height: root.height; hot: keys.has-focus; tile: false; }
