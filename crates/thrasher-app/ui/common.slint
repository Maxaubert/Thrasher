        if Theme.comic: InkShadow { off: 5px; }
        // Pocket: an LCD window with a hard mid green shadow.
        if Theme.pocket: Rectangle { x: 4px; y: 4px; width: parent.width; height: parent.height; background: Pk.l2; }
