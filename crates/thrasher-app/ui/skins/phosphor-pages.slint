// The Phosphor look of every page but the main one (mockups in
// docs/mockups/device-themes/phosphor-pages/): the same green tube as the main page, each
// page a tty with its name in big CRT figures, sections under "-- WORD ----" rules,
// settings as lines with a dotted leader to their value, keys in brackets ([<]back, [r]ename)
// or boxed (PLAY, EXPORT), and the highlight in inverted video. The scanlines and the
// vignette lie over every page.
//
// Behaviour is shared: the state is in the Pages and Main globals, the actions are
// AppWindow's (reached through the callbacks here), and the shared widgets (the transcript
// card, menus, dropdowns, switches, boxed keys) draw their terminal look themselves for this
// skin (`Theme.phos`).

import { ThemeGallery, ThemeGallerySide } from "../gallery.slint";
import { Theme, Main, Pages, Tips, Ph, PhDash, PhShade, Btn, IconBtn, Toggle, Select, TextField, ShortcutBox, Scroller, OrderList, TranscriptCard, ExportButton, TrimTouch, AskSource, PhKey as Kbd } from "../common.slint";
import { Block, Glyph, Caps, Title, Header, Glass } from "phosphor-parts.slint";

// ---------- Small parts ----------

// Mono text in the tube's colours.
component Mono inherits Text {
    color: Ph.hi;
    font-family: Ph.mono;
    font-size: 13px;
    vertical-alignment: center;
}

// A rule with its word and the room around it, as a row of a layout.
component Rule inherits HorizontalLayout {
    in property <string> word;
    in property <color> ink: Ph.dim;
    Header { word: root.word; ink: root.ink; }
}

// The page's name in big CRT figures, a note on the right, a dashed rule under it.
component Heading inherits Rectangle {
    in property <string> title;
    in property <string> note;
    in property <length> size: 34px;
    height: 50px;
    vertical-stretch: 0;
    PhDash { y: parent.height - 1px; height: 1px; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        Text {
            text: root.title;
            color: Ph.hi;
            font-family: Ph.crt;
            font-size: root.size;
            letter-spacing: 1px;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.note != "": Text {
            text: root.note;
            color: Ph.dim;
            font-family: Ph.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// The bar at the bottom: the latest message as a "> " line, and whatever keys are put in.
component StatusBar inherits Rectangle {
    // Whether it prints the message (portrait merge has no room beside its keys).
    in property <bool> message: true;
    height: 30px;
    vertical-stretch: 0;
    Rectangle { y: 0; height: 1px; background: Ph.line; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Mono {
            text: root.message && Main.status != "" ? "> " + Main.status : "";
            color: Ph.mid;
            font-size: 12px;
            overflow: elide;
            horizontal-stretch: 1;
        }
        @children
    }
}

// A message in a box, floating just above the bar at the bottom (as on the main page).
component Toast inherits Rectangle {
    in property <string> text;
    in property <length> above: 8px;
    height: 0;
    if root.text != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: -root.above - self.height;
        width: min(msg.preferred-width + 24px, parent.width - 32px);
        height: 26px;
        background: Ph.bg2;
        border-width: 1px;
        border-color: Ph.ph;
        msg := Mono {
            x: 12px;
            width: parent.width - 24px;
            text: root.text;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: center;
        }
    }
}

// A prompt: a framed line with its prompt word ("ask>", "$ find", ">") and a text field
// after it. The frame lights while the cursor is in it, amber when the text is invalid.
component Prompt inherits Rectangle {
    in property <string> prompt: ">";
    in property <string> placeholder;
    in property <string> label;
    in property <bool> invalid;
    in property <bool> enabled: true;
    in property <length> font-size: 13px;
    in property <bool> grab-on-init;
    in-out property <string> text <=> field.text;
    out property <bool> has-focus: field.has-focus;
    callback edited(string);
    callback accepted(string);
    public function grab() { field.grab(); }
    height: 28px;
    border-width: 1px;
    border-color: root.invalid ? Ph.amber : field.has-focus ? Ph.ph : Ph.dim;
    background: Ph.bg;
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        padding-top: 1px;
        padding-bottom: 1px;
        spacing: 2px;
        Mono {
            text: root.prompt;
            color: Ph.dim;
            font-size: root.font-size;
            accessible-role: none;
        }
        field := TextField {
            horizontal-stretch: 1;
            height: root.height - 2px;
            radius: 0;
            fill: transparent;
            rest-edge: transparent;
            ink: Ph.hi;
            hint: Ph.dim;
            font-size: root.font-size;
            family: Ph.mono;
            side: 4px;
            bare-focus: true;
            enabled: root.enabled;
            placeholder: root.placeholder;
            label: root.label;
            init => { if (root.grab-on-init) { self.grab(); } }
            edited(t) => { root.edited(t); }
            accepted(t) => { root.accepted(t); }
        }
    }
}

// A boxed key: a frame inside a frame, the inside lit while it is hovered or held. Play,
// the widget's keys. `amber` lights it amber (paused).
component BoxKey inherits Rectangle {
    in property <string> word;
    in property <string> glyph;
    in property <string> hint;
    in property <string> label;
    in property <string> tip: label;
    in property <bool> on;
    in property <bool> amber;
    in property <length> size: 20px;
    // The room either side of the word.
    in property <length> pad: 12px;
    callback clicked;
    property <bool> lit: t.has-hover || root.on;
    width: row.preferred-width + 2 * root.pad;
    background: Ph.bg;
    border-width: 1px;
    border-color: root.amber ? Ph.amber : Ph.ph;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        border-width: 1px;
        border-color: root.lit ? Ph.bg2 : Ph.dim;
        background: root.lit ? (root.amber ? Ph.amber : Ph.ph) : #4dff7a0f;
    }
    row := HorizontalLayout {
        x: (parent.width - self.width) / 2;
        width: self.preferred-width;
        spacing: 8px;
        if root.glyph != "": VerticalLayout {
            alignment: center;
            Glyph {
                width: root.size * 0.7;
                height: root.size * 0.7;
                name: root.glyph;
                ink: root.lit ? Ph.bg : Ph.hi;
            }
        }
        if root.word != "": Text {
            text: root.word;
            color: root.lit ? Ph.bg : Ph.hi;
            font-family: Ph.crt;
            font-size: root.size;
            letter-spacing: 2px;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.hint != "": Text {
            text: root.hint;
            color: root.lit ? Ph.bg2 : Ph.dim;
            font-family: Ph.mono;
            font-size: 9.5px;
            letter-spacing: 1px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { if (root.tip != "") { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); } }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

// A bar in light shade, filled solid as far as `value` goes, and its percent.
component Progress inherits HorizontalLayout {
    in property <float> value;
    in property <bool> percent: true;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Rectangle {
            height: 12px;
            PhShade { width: 100%; height: 100%; }
            Rectangle { x: 0; width: parent.width * clamp(root.value, 0, 1); background: Ph.ph; }
        }
    }
    if root.percent: Mono {
        text: round(root.value * 100) + "%";
        color: Ph.mid;
        font-size: 11px;
        width: 34px;
        horizontal-alignment: right;
    }
}

// ---------- One clip ----------

// The clip's waveform in blocks of eight heights: the played part bright, the trimmed ends
// faint, the trim handles as lit bars with a block, the playhead a thin line. TrimTouch
// drags and seeks.
component Scan inherits Rectangle {
    callback trimmed(float, float);
    callback tapped();
    property <bool> active: Main.active-clip == Main.selected;
    property <float> played: root.active ? clamp(Main.play-fraction, 0, 1) : 0;
    property <length> inner-w: root.width - 16px;
    property <length> start-x: Pages.trim-start * root.inner-w;
    property <length> end-x: Pages.trim-end * root.inner-w;
    property <int> n: max(1, floor(root.inner-w / 5px));
    property <length> pitch: root.inner-w / root.n;
    Rectangle {
        x: 8px;
        width: root.inner-w;
        for i in root.n: Rectangle {
            property <float> f: (i + 0.5) / root.n;
            property <float> v: Pages.detail-wave.length > 0 ? Pages.detail-wave[floor(i * Pages.detail-wave.length / root.n)] : 0.06;
            property <int> q: max(1, round(self.v * 8));
            x: i * root.pitch;
            width: root.pitch - 1px;
            height: self.q / 8 * (root.height - 16px);
            y: (root.height - self.height) / 2;
            background: self.f < Pages.trim-start || self.f > Pages.trim-end ? Ph.faint : self.f <= root.played ? Ph.ph : Ph.dim;
        }
        if root.active: Rectangle {
            x: root.played * (parent.width - 1px);
            width: 1px;
            background: Ph.hi;
        }
        for k in [0, 1]: Rectangle {
            property <bool> on: k == 0 ? Pages.trim-start > 0.0005 : Pages.trim-end < 0.9995;
            property <bool> hot: touch.grab == k + 1 || (touch.has-hover && abs(touch.at - (k == 0 ? root.start-x : root.end-x)) <= 8px);
            property <bool> lit: self.on || self.hot;
            x: (k == 0 ? root.start-x : root.end-x) - 1px;
            width: 2px;
            background: self.lit ? Ph.hi : Ph.mid;
            Rectangle {
                x: -3px;
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 14px;
                background: parent.lit ? Ph.hi : Ph.mid;
            }
        }
    }
    touch := TrimTouch {
        pad: 8px;
        trimmed(a, b) => { root.trimmed(a, b); }
        tapped => { root.tapped(); }
    }
}

// The five steps of the playback speed, "SPD 0.75 1.0 1.25 1.5 2.0", the current one
// inverted.
component Speed inherits HorizontalLayout {
    callback picked(int);
    spacing: 10px;
    alignment: start;
    Caps { text: "SPD"; }
    Rectangle {
        width: steps.preferred-width;
        accessible-role: list;
        accessible-label: "Speed";
        steps := HorizontalLayout {
            spacing: 4px;
            for v[i] in ["0.75", "1.0", "1.25", "1.5", "2.0"]: Rectangle {
                width: st-text.preferred-width + 6px;
                background: i == Pages.speed-index ? Ph.ph : st.has-hover ? Ph.faint : transparent;
                accessible-role: button;
                accessible-label: v + "×";
                accessible-checked: i == Pages.speed-index;
                accessible-action-default => { Pages.speed-index = i; root.picked(i); }
                st-text := Mono {
                    text: v;
                    color: i == Pages.speed-index ? Ph.bg : Ph.hi;
                    font-size: 12px;
                    horizontal-alignment: center;
                    accessible-role: none;
                }
                st := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Pages.speed-index = i; root.picked(i); }
                }
            }
        }
    }
}

// The transport: [<5], the boxed play key, [5>] and (portrait) where it is of how long.
component Transport inherits HorizontalLayout {
    in property <bool> big;
    callback toggle-play();
    callback skip(float);
    callback refocus();
    property <bool> playing: Main.active-clip == Main.selected && Main.playing;
    spacing: 10px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Kbd {
            key: "[<5]";
            size: 13px;
            label: "Back 5 seconds";
            clicked => { root.skip(-5); root.refocus(); }
        }
    }
    BoxKey {
        height: root.big ? 36px : 32px;
        width: root.big ? 138px : 130px;
        glyph: root.playing ? "pause" : "play";
        word: root.playing ? "PAUSE" : "PLAY";
        hint: "[space]";
        size: root.big ? 19px : 18px;
        on: root.playing;
        label: root.playing ? "Pause" : "Play";
        clicked => { root.toggle-play(); root.refocus(); }
    }
    VerticalLayout {
        alignment: center;
        Kbd {
            key: "[5>]";
            size: 13px;
            label: "Forward 5 seconds";
            clicked => { root.skip(5); root.refocus(); }
        }
    }
    Rectangle { horizontal-stretch: 1; }
    if !root.big: Mono {
        text: (Main.active-clip == Main.selected ? Main.play-position : "0:00") + " / " + (Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].duration : "");
        color: Ph.mid;
        font-size: 12px;
    }
}

// The speed and [l]oop under the transport.
component SpeedLoop inherits HorizontalLayout {
    callback speed-changed(int);
    callback refocus();
    height: 22px;
    Speed { picked(i) => { root.speed-changed(i); root.refocus(); } }
    Rectangle { horizontal-stretch: 1; }
    VerticalLayout {
        alignment: center;
        Kbd {
            key: "[l]";
            tail: "oop";
            label: "Loop";
            tip: "";
            on: Pages.looping;
            clicked => { Pages.looping = !Pages.looping; root.refocus(); }
        }
    }
}

// The clip's name in CRT figures with [r]ename and [d]el, or, while renaming, the name as
// an "mv>" prompt with Rename and Cancel.
component NameLine inherits VerticalLayout {
    in property <bool> big;
    in property <string> name;
    callback rename(string);
    callback delete();
    callback cancel();
    spacing: 4px;
    if !Pages.renaming: HorizontalLayout {
        spacing: 10px;
        height: root.big ? 40px : 34px;
        Text {
            text: root.name;
            color: Ph.hi;
            font-family: Ph.crt;
            font-size: root.big ? 38px : 32px;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            padding-top: 6px;
            Kbd {
                key: "[r]";
                tail: "ename";
                label: "Rename clip";
                tip: "Rename";
                enabled: !Main.recording;
                clicked => { Pages.renaming = true; }
            }
        }
        VerticalLayout {
            alignment: center;
            padding-top: 6px;
            Kbd {
                key: "[d]";
                tail: "el";
                danger: true;
                label: "Delete clip";
                tip: "Delete";
                enabled: !Main.recording;
                clicked => { root.delete(); }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if Pages.renaming: HorizontalLayout {
        spacing: 6px;
        height: 34px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            field := Prompt {
                height: 28px;
                prompt: "mv>";
                label: "Clip name";
                text: root.name;
                grab-on-init: true;
                accepted(t) => { root.rename(t); }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn { height: 28px; primary: true; text: "Rename"; clicked => { root.rename(field.text); } }
        }
        VerticalLayout {
            alignment: center;
            Btn { height: 28px; text: "Cancel"; clicked => { root.cancel(); } }
        }
    }
    Mono {
        text: Pages.detail-meta;
        color: Ph.dim;
        font-size: 10.5px;
        overflow: elide;
    }
}

// Clean voice on export, the one option of a clip: "-- OPTIONS --", the line and its switch.
component Options inherits VerticalLayout {
    callback changed-to(bool);
    spacing: 8px;
    Rule { word: "OPTIONS"; }
    HorizontalLayout {
        spacing: 10px;
        height: 24px;
        Mono { text: "Clean voice on export"; overflow: elide; }
        Mono { text: "Less noise"; color: Ph.dim; font-size: 11px; horizontal-stretch: 1; overflow: elide; }
        VerticalLayout {
            alignment: center;
            Toggle {
                label: "Clean voice on export";
                checked <=> Pages.clean-voice;
                toggled(on) => { root.changed-to(on); }
            }
        }
    }
}

// A merged clip's parts: numbered lines that can be put in another order.
component Parts inherits VerticalLayout {
    callback moved(int, int);
    callback take-out(int);
    callback rename(int);
    spacing: 4px;
    Rule { word: Pages.parts-busy ? "PARTS  WORKING" : "PARTS"; }
    OrderList {
        rows: Pages.parts;
        menu: true;
        enabled: !Pages.parts-busy && !Main.recording;
        opacity: self.enabled ? 1 : 0.5;
        moved(a, b) => { root.moved(a, b); }
        act(i) => { root.take-out(i); }
        rename(i) => { root.rename(i); }
    }
}

// The one-clip page. Portrait: the clip (name, waveform, transport), the transcript, the
// option and the bar with Export. Wide: the clip on the left, the transcript on the right.
export component ClipPage inherits Rectangle {
    in property <bool> narrow;
    in property <bool> wide;
    callback go(int);
    callback refocus();
    // Leaving the editor asks about unsaved changes first (AppWindow.leave-editor).
    callback leave-editor(int);
    callback start-edit();
    callback ask-delete(int);
    callback rename-selected(string);
    callback toggle-play();
    callback skip(float);
    callback speed-changed(int);
    callback trim-changed(float, float);
    callback clean-voice-changed(bool);
    callback parts-move(int, int);
    callback part-take-out(int);
    callback rename-part(int);
    // The transcript card's actions (see TranscriptCard).
    callback choose-lang(string);
    callback lang-filter(string);
    callback install-for(int);
    callback summarise();
    callback edit-changed(string);
    callback apply-transcript(string);
    callback transcribe();
    callback seek-word(int);
    pure callback edit-markup(string) -> styled-text;
    pure callback plain-selection(string, int, int) -> string;

    property <string> name: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].name : "";

    function rename(t: string) {
        Pages.renaming = false;
        root.rename-selected(t);
        root.refocus();
    }
    background: Ph.bg;

    VerticalLayout {
        Title {
            back-word: "clips";
            tty: "tty1";
            settings: false;
            back => { if (Pages.editing) { root.leave-editor(0); } else { root.go(0); } }
        }

        // Portrait.
        if !root.wide: VerticalLayout {
            vertical-stretch: 0;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;
            Rule { word: "CLIP"; }
            NameLine {
                name: root.name;
                rename(t) => { root.rename(t); }
                delete => { root.ask-delete(Main.selected); }
                cancel => { Pages.renaming = false; root.refocus(); }
            }
        }
        if !root.wide: Rectangle {
            vertical-stretch: 0;
            height: deck.preferred-height;
            PhDash { y: 0; height: 1px; }
            PhDash { y: parent.height - 1px; height: 1px; }
            deck := VerticalLayout {
                padding-left: 6px;
                padding-right: 14px;
                padding-top: 8px;
                padding-bottom: 10px;
                spacing: 8px;
                Scan {
                    height: 48px;
                    trimmed(a, b) => { root.trim-changed(a, b); }
                    tapped => { root.refocus(); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    Transport {
                        toggle-play => { root.toggle-play(); }
                        skip(s) => { root.skip(s); }
                        refocus => { root.refocus(); }
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    SpeedLoop {
                        speed-changed(i) => { root.speed-changed(i); }
                        refocus => { root.refocus(); }
                    }
                }
            }
        }
        if !root.wide && Pages.parts.length >= 2: VerticalLayout {
            vertical-stretch: 0;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            Parts {
                moved(a, b) => { root.parts-move(a, b); }
                take-out(i) => { root.part-take-out(i); }
                rename(i) => { root.rename-part(i); }
            }
        }
        if !root.wide: VerticalLayout {
            vertical-stretch: 1;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 8px;
            padding-bottom: 8px;
            TranscriptCard {
                vertical-stretch: 1;
                clip-name: root.name;
                transcript: Pages.transcript;
                transcribing: Pages.transcribing;
                translating: Pages.translating;
                translation: Pages.translation;
                shown-lang <=> Pages.shown-lang;
                langs: Pages.langs;
                choose-lang(c) => { root.choose-lang(c); }
                lang-filter(t) => { root.lang-filter(t); }
                install-for(k) => { root.install-for(k); }
                summary: Pages.summary;
                summarising: Pages.summarising;
                can-ai: Main.can-ai;
                show-summary <=> Pages.show-summary;
                summarise => { root.summarise(); }
                transcribe-progress: Pages.transcribe-progress;
                words: Pages.words;
                current-word: Pages.current-word;
                show-marks <=> Pages.show-marks;
                can-transcribe: Pages.can-transcribe;
                recording: Main.recording;
                editing: Pages.editing;
                edit-draft <=> Pages.edit-draft;
                edit-badge: Pages.edit-badge;
                speaking: Pages.speaking;
                edit => { root.start-edit(); }
                edited(t) => { root.edit-changed(t); }
                cancel => { root.leave-editor(-1); }
                save => { root.apply-transcript(Pages.edit-draft); }
                edit-markup(t) => { return root.edit-markup(t); }
                plain-selection(t, a, b) => { return root.plain-selection(t, a, b); }
                transcribe => { root.transcribe(); root.refocus(); }
                seek-word(i) => { root.seek-word(i); root.refocus(); }
            }
        }
        if !root.wide: VerticalLayout {
            vertical-stretch: 0;
            padding-left: 14px;
            padding-right: 14px;
            padding-bottom: 10px;
            Options { changed-to(on) => { root.clean-voice-changed(on); } }
        }

        // Wide.
        if root.wide: HorizontalLayout {
            vertical-stretch: 1;
            Rectangle {
                width: 460px;
                PhDash { x: parent.width - 1px; width: 1px; down: true; }
                VerticalLayout {
                    width: parent.width - 1px;
                    VerticalLayout {
                        vertical-stretch: 0;
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 12px;
                        padding-bottom: 10px;
                        spacing: 8px;
                        Rule { word: "CLIP"; }
                        NameLine {
                            big: true;
                            name: root.name;
                            rename(t) => { root.rename(t); }
                            delete => { root.ask-delete(Main.selected); }
                            cancel => { Pages.renaming = false; root.refocus(); }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 0;
                        height: deck-w.preferred-height;
                        PhDash { y: 0; height: 1px; }
                        PhDash { y: parent.height - 1px; height: 1px; }
                        deck-w := VerticalLayout {
                            padding-left: 6px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 12px;
                            spacing: 6px;
                            Scan {
                                height: 80px;
                                trimmed(a, b) => { root.trim-changed(a, b); }
                                tapped => { root.refocus(); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                Mono {
                                    text: Main.active-clip == Main.selected ? Main.play-position : "0:00";
                                    color: Ph.dim;
                                    font-size: 10.5px;
                                    horizontal-stretch: 1;
                                }
                                Mono {
                                    text: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].duration : "";
                                    color: Ph.dim;
                                    font-size: 10.5px;
                                }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-top: 4px;
                                Transport {
                                    big: true;
                                    toggle-play => { root.toggle-play(); }
                                    skip(s) => { root.skip(s); }
                                    refocus => { root.refocus(); }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-top: 4px;
                                SpeedLoop {
                                    speed-changed(i) => { root.speed-changed(i); }
                                    refocus => { root.refocus(); }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; min-height: 0; }
                    VerticalLayout {
                        vertical-stretch: 0;
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-bottom: 10px;
                        Options { changed-to(on) => { root.clean-voice-changed(on); } }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 10px;
                spacing: 10px;
                if Pages.parts.length >= 2: Parts {
                    moved(a, b) => { root.parts-move(a, b); }
                    take-out(i) => { root.part-take-out(i); }
                    rename(i) => { root.rename-part(i); }
                }
                TranscriptCard {
                    vertical-stretch: 1;
                    clip-name: root.name;
                    transcript: Pages.transcript;
                    transcribing: Pages.transcribing;
                    translating: Pages.translating;
                    translation: Pages.translation;
                    shown-lang <=> Pages.shown-lang;
                    langs: Pages.langs;
                    choose-lang(c) => { root.choose-lang(c); }
                    lang-filter(t) => { root.lang-filter(t); }
                    install-for(k) => { root.install-for(k); }
                    summary: Pages.summary;
                    summarising: Pages.summarising;
                    can-ai: Main.can-ai;
                    show-summary <=> Pages.show-summary;
                    summarise => { root.summarise(); }
                    transcribe-progress: Pages.transcribe-progress;
                    words: Pages.words;
                    current-word: Pages.current-word;
                    show-marks <=> Pages.show-marks;
                    can-transcribe: Pages.can-transcribe;
                    recording: Main.recording;
                    editing: Pages.editing;
                    edit-draft <=> Pages.edit-draft;
                    edit-badge: Pages.edit-badge;
                    speaking: Pages.speaking;
                    edit => { root.start-edit(); }
                    edited(t) => { root.edit-changed(t); }
                    cancel => { root.leave-editor(-1); }
                    save => { root.apply-transcript(Pages.edit-draft); }
                    edit-markup(t) => { return root.edit-markup(t); }
                    plain-selection(t, a, b) => { return root.plain-selection(t, a, b); }
                    transcribe => { root.transcribe(); root.refocus(); }
                    seek-word(i) => { root.seek-word(i); root.refocus(); }
                }
            }
        }

        // The bar: the latest message, and Export.
        StatusBar {
            height: 44px;
            VerticalLayout {
                alignment: center;
                ExportButton {
                    width: 150px;
                    height: 32px;
                    format: Pages.export-format;
                    subtitles: Pages.transcript != "";
                    state: Main.export-state;
                    progress: Main.export-progress;
                    export(kind) => { Main.export-as(kind); root.refocus(); }
                }
            }
        }
    }
    Glass { }
}

// ---------- Settings ----------

// A section: its rule and its lines.
component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 2px;
    Rule { word: root.title; }
    Rectangle { height: 4px; }
    @children
}

// One line of a section: its name (and a note under it), a dotted leader, and its controls.
component Line inherits Rectangle {
    in property <string> label;
    in property <string> note;
    min-height: 30px;
    HorizontalLayout {
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 0;
            Mono { text: root.label; overflow: elide; }
            if root.note != "": Mono { text: root.note; color: Ph.dim; font-size: 10px; overflow: elide; }
        }
        Rectangle {
            horizontal-stretch: 1;
            min-width: 10px;
            PhDash { y: parent.height / 2 + 4px; height: 1px; opacity: 0.7; }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            @children
        }
    }
}

// A value printed at the end of a line: OmniVoice, Downloading 64%.
component Value inherits Mono {
    color: Ph.mid;
    font-size: 12px;
}

// The dropdown of a line, as wide as its choice needs.
component LineSelect inherits Select {
    width: min(self.natural, 200px);
    height: 24px;
}

export component SettingsPage inherits Rectangle {
    in property <bool> wide;
    callback back();
    callback go(int);
    callback refocus();
    callback theme-changed(int);
    callback mic-changed(int);
    callback system-changed(bool);
    callback recording-limit-changed(int);
    callback hotkey-captured(string, bool, bool, bool, bool) -> bool;
    callback hotkey-accepted(string);
    callback open-folder();
    callback change-folder();
    callback template-edited(string);
    callback template-accepted(string);
    callback export-format-changed(int);
    callback clean-voice-changed(bool);
    callback language-changed(int);
    callback auto-transcribe-changed(bool);
    callback ai-names-changed(bool);
    callback max-pause-changed(int);
    callback ai-model-changed(int);
    callback download-ai(int);
    callback close-to-tray-changed(bool);
    callback start-with-windows-changed(bool);
    background: Ph.bg;

    VerticalLayout {
        Title { back-word: "back"; tty: "tty3"; settings: false; back => { root.back(); } }
        Heading { title: "SETUP"; }
        Scroller {
            VerticalLayout {
                padding-left: 14px;
                padding-right: root.wide ? 14px : 18px;
                padding-top: 10px;
                padding-bottom: 18px;
                alignment: start;
                spacing: 16px;
                // The theme gallery; wide puts its two strips side by side, so the page
                // fits without scrolling.
                Section {
                    title: "APPEARANCE";
                    if !root.wide: ThemeGallery { picked(i) => { root.theme-changed(i); } }
                    if root.wide: ThemeGallerySide { picked(i) => { root.theme-changed(i); } }
                }
                FlexboxLayout {
                    flex-direction: root.wide ? FlexboxLayoutDirection.row : FlexboxLayoutDirection.column;
                    flex-wrap: no-wrap;
                    alignment: stretch;
                    cross-axis-alignment: root.wide ? CrossAxisAlignment.start : CrossAxisAlignment.stretch;
                    spacing: root.wide ? 22px : 16px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 16px;
                        Section {
                            title: "RECORDING";
                            Line {
                                label: "Microphone";
                                VerticalLayout {
                                    alignment: center;
                                    LineSelect {
                                        label: "Microphone";
                                        model: Pages.mic-devices;
                                        current-index <=> Pages.mic-index;
                                        enabled: !Main.recording;
                                        selected(i) => { root.mic-changed(i); }
                                    }
                                }
                            }
                            Line {
                                label: "System audio";
                                VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        label: "System audio";
                                        checked <=> Pages.record-system;
                                        toggled(on) => { root.system-changed(on); }
                                    }
                                }
                            }
                            Line {
                                label: "Stop recording after";
                                VerticalLayout {
                                    alignment: center;
                                    LineSelect {
                                        label: "Stop recording after";
                                        model: Pages.recording-limits;
                                        current-index <=> Pages.recording-limit-index;
                                        selected(i) => { root.recording-limit-changed(i); }
                                    }
                                }
                            }
                            Line {
                                label: "Record hotkey";
                                VerticalLayout {
                                    alignment: center;
                                    ShortcutBox {
                                        label: "Record hotkey";
                                        keys: Pages.hotkey-parts;
                                        captured(text, ctrl, alt, shift, meta) => { return root.hotkey-captured(text, ctrl, alt, shift, meta); }
                                        cleared => { root.hotkey-accepted(""); }
                                        done => { root.refocus(); }
                                    }
                                }
                                if Pages.hotkey-parts.length > 0: VerticalLayout {
                                    alignment: center;
                                    IconBtn {
                                        size: 22px;
                                        icon: "close";
                                        key: "[x]";
                                        label: "Clear the shortcut";
                                        tip: "Clear shortcut";
                                        clicked => { root.hotkey-accepted(""); }
                                    }
                                }
                            }
                        }
                        Section {
                            title: "WINDOW";
                            Line {
                                label: "Close button hides to tray";
                                VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        label: "Close button hides to tray";
                                        checked <=> Pages.close-to-tray;
                                        toggled(on) => { root.close-to-tray-changed(on); }
                                    }
                                }
                            }
                            Line {
                                label: "Start with Windows";
                                VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        label: "Start with Windows";
                                        checked <=> Pages.start-with-windows;
                                        toggled(on) => { root.start-with-windows-changed(on); }
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 16px;
                        Section {
                            title: "FILES";
                            Line {
                                label: "Folder";
                                VerticalLayout {
                                    alignment: center;
                                    Value {
                                        text: Pages.folder;
                                        overflow: elide;
                                        max-width: root.wide ? 120px : 170px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconBtn {
                                        size: 22px;
                                        icon: "folder";
                                        key: "[o]";
                                        tail: "pen";
                                        label: "Open the folder";
                                        tip: "Open folder";
                                        clicked => { root.open-folder(); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn { text: "Change"; height: 28px; enabled: !Main.recording; clicked => { root.change-folder(); } }
                                }
                            }
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 6px;
                                spacing: 5px;
                                Mono { text: "File name"; height: 20px; }
                                Prompt {
                                    label: "File name";
                                    text: Pages.name-template;
                                    invalid: Pages.name-invalid;
                                    edited(t) => { root.template-edited(t); }
                                    accepted(t) => { root.template-accepted(t); root.refocus(); }
                                }
                                Mono {
                                    text: Pages.name-preview;
                                    color: Pages.name-invalid ? Ph.amber : Ph.dim;
                                    font-size: 10.5px;
                                    overflow: elide;
                                }
                            }
                            Line {
                                label: "Export format";
                                VerticalLayout {
                                    alignment: center;
                                    LineSelect {
                                        label: "Export format";
                                        model: ["FLAC", "WAV", "MP3"];
                                        current-index <=> Pages.export-format;
                                        selected(i) => { root.export-format-changed(i); }
                                    }
                                }
                            }
                            Line {
                                label: "Clean voice on export";
                                VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        label: "Clean voice on export";
                                        checked <=> Pages.clean-voice;
                                        toggled(on) => { root.clean-voice-changed(on); }
                                    }
                                }
                            }
                        }
                        Section {
                            title: "YOUR VOICE";
                            Line { label: "Voice engine"; Value { text: "OmniVoice"; } }
                            Line { label: "Voice sample"; Value { text: "20 s from the clip"; } }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 16px;
                        Section {
                            title: "TRANSCRIPTION";
                            if !Pages.can-transcribe: Line { label: "Not in this build"; }
                            if Pages.can-transcribe: Line {
                                label: "Language";
                                VerticalLayout {
                                    alignment: center;
                                    LineSelect {
                                        label: "Language";
                                        model: Pages.languages;
                                        current-index <=> Pages.language-index;
                                        selected(i) => { root.language-changed(i); }
                                    }
                                }
                            }
                            if Pages.can-transcribe: Line {
                                label: "Auto transcribe";
                                VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        label: "Auto transcribe";
                                        checked <=> Pages.auto-transcribe;
                                        toggled(on) => { root.auto-transcribe-changed(on); }
                                    }
                                }
                            }
                            if Pages.can-transcribe && Main.can-ai: Line {
                                label: "AI names";
                                note: Pages.auto-transcribe ? "" : "Auto transcribe off";
                                VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        label: "AI names";
                                        enabled: Pages.auto-transcribe;
                                        checked <=> Pages.ai-names;
                                        toggled(on) => { root.ai-names-changed(on); }
                                    }
                                }
                            }
                            if Pages.can-transcribe: Line {
                                label: "Max pause";
                                VerticalLayout {
                                    alignment: center;
                                    LineSelect {
                                        label: "Max pause";
                                        model: Pages.max-pauses;
                                        current-index <=> Pages.max-pause-index;
                                        selected(i) => { root.max-pause-changed(i); }
                                    }
                                }
                            }
                            if Pages.can-transcribe: Rectangle {
                                height: model-row.preferred-height;
                                accessible-role: button;
                                accessible-label: "Browse models";
                                accessible-action-default => { root.go(4); }
                                model-touch := TouchArea { mouse-cursor: pointer; clicked => { root.go(4); } }
                                model-row := Line {
                                    width: 100%;
                                    label: "Model";
                                    note: Pages.model-summary;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: browse.preferred-width + 6px;
                                            height: 20px;
                                            background: model-touch.has-hover ? Ph.ph : transparent;
                                            browse := HorizontalLayout {
                                                x: 3px;
                                                width: self.preferred-width;
                                                Mono { text: "[b]"; color: model-touch.has-hover ? Ph.bg : Ph.hi; font-size: 12px; }
                                                Mono { text: "rowse >"; color: model-touch.has-hover ? Ph.bg2 : Ph.dim; font-size: 12px; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if Main.can-ai: Section {
                            title: "AI";
                            Line {
                                label: "Model";
                                VerticalLayout {
                                    alignment: center;
                                    LineSelect {
                                        label: "AI model";
                                        model: Pages.ai-models;
                                        current-index <=> Pages.ai-model-index;
                                        selected(i) => { root.ai-model-changed(i); }
                                    }
                                }
                            }
                            Line {
                                label: Pages.ai-ready ? "Ready" : Pages.ai-download >= 0 ? "Downloading " + round(Pages.ai-download * 100) + "%" : "Not downloaded";
                                if Pages.ai-ready: VerticalLayout {
                                    alignment: center;
                                    Block { width: 7px; height: 7px; }
                                }
                                if !Pages.ai-ready && Pages.ai-download >= 0: VerticalLayout {
                                    alignment: center;
                                    Progress { width: 90px; percent: false; value: Pages.ai-download; }
                                }
                                if !Pages.ai-ready && Pages.ai-download < 0: VerticalLayout {
                                    alignment: center;
                                    Btn { text: "Download"; height: 28px; clicked => { root.download-ai(0); } }
                                }
                            }
                            Line {
                                label: "Translation";
                                note: "Ministral 3B 2.1 GB";
                                if Pages.translator-ready: Value { text: "Ready"; }
                                if !Pages.translator-ready && Pages.translator-download >= 0: Value {
                                    text: "Downloading " + round(Pages.translator-download * 100) + "%";
                                }
                                if !Pages.translator-ready && Pages.translator-download < 0: VerticalLayout {
                                    alignment: center;
                                    Btn { text: "Download"; height: 28px; clicked => { root.download-ai(1); } }
                                }
                            }
                        }
                    }
                }
            }
        }
        StatusBar { }
    }
    Glass { }
}

// ---------- Models ----------

// Quality or speed as five pips.
component Pips inherits HorizontalLayout {
    in property <string> label;
    in property <int> value;
    spacing: 6px;
    Mono { text: root.label; color: Ph.dim; font-size: 10px; }
    HorizontalLayout {
        spacing: 1px;
        alignment: start;
        for k in 5: Rectangle {
            width: 5px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 6px;
                background: k < root.value ? Ph.ph : Ph.faint;
            }
        }
    }
}

// The five filters as --switches, in a row or in a column.
component Filters inherits VerticalLayout {
    in property <bool> column;
    callback changed();
    if !root.column: HorizontalLayout {
        spacing: 2px;
        alignment: start;
        for f[i] in ["All", "Norwegian", "Swedish", "English", "Downloaded"]: Kbd {
            key: "--" + f.to-lowercase();
            ink: Ph.mid;
            label: f;
            tip: "";
            on: Pages.model-filter == i;
            clicked => { Pages.model-filter = i; root.changed(); }
        }
    }
    if root.column: VerticalLayout {
        spacing: 3px;
        alignment: start;
        for f[i] in ["All", "Norwegian", "Swedish", "English", "Downloaded"]: HorizontalLayout {
            alignment: start;
            Kbd {
                key: "--" + f.to-lowercase();
                ink: Ph.mid;
                label: f;
                tip: "";
                on: Pages.model-filter == i;
                clicked => { Pages.model-filter = i; root.changed(); }
            }
        }
    }
}

// The search as "$ find" and the compressed switch.
component ModelSearch inherits Prompt {
    prompt: "$ find";
    label: "Search models";
    placeholder: "Search " + Pages.model-count + " models";
    height: 30px;
}

component Compressed inherits HorizontalLayout {
    callback changed();
    spacing: 10px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Toggle {
            label: "Show compressed versions too";
            checked <=> Pages.model-compressed;
            toggled => { root.changed(); }
        }
    }
    Mono { text: "Show compressed"; color: Ph.dim; font-size: 12px; }
}

export component ModelsPage inherits Rectangle {
    in property <bool> wide;
    callback back();
    callback filter-changed();
    callback use-model(int);
    callback cancel-download();
    callback download-model(int);
    background: Ph.bg;
    VerticalLayout {
        Title { back-word: "back"; tty: "tty4"; settings: false; back => { root.back(); } }
        if !root.wide: Heading { title: "MODELS"; note: Pages.models-used; }
        if !root.wide: VerticalLayout {
            vertical-stretch: 0;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 8px;
            spacing: 8px;
            ModelSearch { text <=> Pages.model-query; edited => { root.filter-changed(); } }
            Filters { changed => { root.filter-changed(); } }
            Compressed { changed => { root.filter-changed(); } }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            if root.wide: Rectangle {
                width: 300px;
                PhDash { x: parent.width - 1px; width: 1px; down: true; }
                VerticalLayout {
                    width: parent.width - 1px;
                    Heading { title: "MODELS"; size: 40px; height: 64px; }
                    VerticalLayout {
                        vertical-stretch: 1;
                        padding: 18px;
                        padding-top: 14px;
                        spacing: 14px;
                        ModelSearch { text <=> Pages.model-query; edited => { root.filter-changed(); } }
                        VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;
                            Rule { word: "FILTER"; }
                            Filters { column: true; changed => { root.filter-changed(); } }
                        }
                        Compressed { changed => { root.filter-changed(); } }
                        Rectangle { vertical-stretch: 1; }
                        VerticalLayout {
                            spacing: 8px;
                            Rule { word: "DISK"; }
                            Text {
                                text: Pages.models-used;
                                color: Ph.hi;
                                font-family: Ph.crt;
                                font-size: 30px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            Scroller {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    padding-left: root.wide ? 20px : 14px;
                    padding-right: root.wide ? 22px : 18px;
                    padding-top: root.wide ? 8px : 0;
                    padding-bottom: 12px;
                    for m in Pages.models: VerticalLayout {
                        if m.header: HorizontalLayout {
                            padding-top: 12px;
                            padding-bottom: 2px;
                            spacing: 8px;
                            Caps { text: m.title.to-uppercase(); }
                            Mono {
                                text: m.by;
                                color: Ph.dim;
                                font-size: 10px;
                                horizontal-alignment: right;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                        if !m.header: Rectangle {
                            height: model-row.preferred-height;
                            PhDash { y: parent.height - 1px; height: 1px; }
                            model-row := VerticalLayout {
                                padding-top: 7px;
                                padding-bottom: 7px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        Mono { text: m.title; overflow: elide; }
                                        HorizontalLayout {
                                            spacing: 14px;
                                            alignment: start;
                                            Pips { label: "Quality"; value: m.quality; }
                                            Pips { label: "Speed"; value: m.speed; }
                                            Mono { text: m.size; color: Ph.dim; font-size: 10px; }
                                        }
                                    }
                                    if m.active: VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: inuse.preferred-width + 14px;
                                            height: 20px;
                                            background: Ph.ph;
                                            inuse := Mono {
                                                text: "IN USE";
                                                color: Ph.bg;
                                                font-size: 11px;
                                                letter-spacing: 1px;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                    if m.downloaded && !m.active: VerticalLayout {
                                        alignment: center;
                                        Btn { text: "Use"; height: 28px; clicked => { root.use-model(m.index); } }
                                    }
                                    if Pages.downloading == m.index: VerticalLayout {
                                        alignment: center;
                                        Btn { text: "Cancel"; height: 28px; clicked => { root.cancel-download(); } }
                                    }
                                    if !m.downloaded && Pages.downloading != m.index: VerticalLayout {
                                        alignment: center;
                                        Btn {
                                            text: "Download";
                                            height: 28px;
                                            enabled: Pages.downloading < 0;
                                            accessible-label: "Download " + m.title;
                                            clicked => { root.download-model(m.index); }
                                        }
                                    }
                                }
                                if Pages.downloading == m.index: Progress { value: Pages.download-progress; }
                            }
                        }
                    }
                    if Pages.models.length == 0: Mono {
                        text: "No models match";
                        color: Ph.dim;
                        font-size: 12px;
                        height: 60px;
                    }
                }
            }
        }
        StatusBar { }
    }
    Glass { }
}

// ---------- Merge ----------

// The name of the merged clip, as a prompt.
component NameField inherits Prompt {
    height: 28px;
    placeholder: "Name";
    label: "Name of the merged clip";
}

// The keys of the bar: Cancel and Merge.
component MergeKeys inherits HorizontalLayout {
    callback cancel();
    callback merge();
    spacing: 8px;
    VerticalLayout { alignment: center; Btn { height: 30px; text: "Cancel"; clicked => { root.cancel(); } } }
    VerticalLayout {
        alignment: center;
        Btn {
            height: 30px;
            min-width: 150px;
            primary: true;
            text: Pages.merging ? "Merging" : "Merge " + Pages.merge-rows.length + " clips";
            enabled: !Pages.merging && Pages.merge-name != "";
            clicked => { root.merge(); }
        }
    }
}

export component MergePage inherits Rectangle {
    in property <bool> wide;
    callback go(int);
    callback move(int, int);
    callback remove(int);
    callback play(int);
    callback run(string);
    property <string> playing-name: Main.active-clip >= 0 && Main.active-clip < Main.clips.length && Main.playing ? Main.clips[Main.active-clip].name : "";
    background: Ph.bg;
    VerticalLayout {
        Title { back-word: "clips"; tty: "tty5"; settings: false; back => { root.go(0); } }
        if !root.wide: Heading { title: "MERGE CLIPS"; note: Pages.merge-rows.length + " clips"; }
        HorizontalLayout {
            vertical-stretch: 1;
            if root.wide: Rectangle {
                width: 400px;
                PhDash { x: parent.width - 1px; width: 1px; down: true; }
                VerticalLayout {
                    width: parent.width - 1px;
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 12px;
                    padding-bottom: 16px;
                    spacing: 10px;
                    alignment: start;
                    Rule { word: "MERGE"; }
                    Text {
                        text: "MERGE CLIPS";
                        color: Ph.hi;
                        font-family: Ph.crt;
                        font-size: 44px;
                        letter-spacing: 1px;
                    }
                    Mono { text: Pages.merge-rows.length + " clips"; color: Ph.dim; font-size: 11px; }
                    Rectangle { height: 8px; }
                    // The splice: one block per clip, in merge order.
                    Rule { word: "SPLICE"; }
                    VerticalLayout {
                        spacing: 4px;
                        splice := Rectangle {
                            height: 20px;
                            property <int> n: max(1, Pages.merge-rows.length);
                            property <length> seg: (self.width - (self.n - 1) * 4px) / self.n;
                            for r[k] in Pages.merge-rows: Rectangle {
                                x: k * (splice.seg + 4px);
                                width: splice.seg;
                                background: r.name == root.playing-name ? Ph.hi : Math.mod(k, 2) == 0 ? Ph.ph : Ph.mid;
                            }
                        }
                        Rectangle {
                            height: 14px;
                            for r[k] in Pages.merge-rows: Mono {
                                x: k * (splice.seg + 4px);
                                width: splice.seg;
                                height: 14px;
                                text: (k < 9 ? "0" : "") + (k + 1);
                                color: Ph.dim;
                                font-size: 10px;
                            }
                        }
                    }
                    Rectangle { height: 8px; }
                    Rule { word: "NEW CLIP"; }
                    HorizontalLayout {
                        spacing: 12px;
                        Caps { text: "NAME"; }
                        NameField { horizontal-stretch: 1; text <=> Pages.merge-name; }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                padding-left: root.wide ? 18px : 14px;
                padding-right: root.wide ? 18px : 14px;
                padding-top: 12px;
                spacing: 6px;
                Rule { word: "ORDER"; }
                Scroller {
                    VerticalLayout {
                        alignment: start;
                        OrderList {
                            rows: Pages.merge-rows;
                            removable: true;
                            playable: true;
                            playing-name: root.playing-name;
                            enabled: !Pages.merging;
                            moved(a, b) => { root.move(a, b); }
                            act(i) => { root.remove(i); }
                            play(i) => { root.play(i); }
                        }
                    }
                }
            }
        }
        if !root.wide: Rectangle {
            vertical-stretch: 0;
            height: newclip.preferred-height;
            PhDash { y: 0; height: 1px; }
            newclip := VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;
                Rule { word: "NEW CLIP"; }
                HorizontalLayout {
                    spacing: 12px;
                    Caps { text: "NAME"; }
                    NameField { horizontal-stretch: 1; text <=> Pages.merge-name; }
                }
            }
        }
        // Portrait has no room for the message beside the keys: it floats above the bar.
        StatusBar {
            height: 46px;
            message: root.wide;
            MergeKeys {
                cancel => { root.go(0); }
                merge => { root.run(Pages.merge-name); }
            }
        }
    }
    if !root.wide: Toast { y: root.height - 46px; text: Main.status; }
    Glass { }
}

// ---------- Ask ----------

// A passage an answer came from: "[1] clip_005  1:12", its words under it, the project
// before the clip with --all on.
component Source inherits Rectangle {
    in property <AskSource> source;
    in property <bool> show-project;
    in property <string> project;
    callback clicked;
    height: 42px;
    background: t.has-hover ? Ph.faint : transparent;
    accessible-role: button;
    accessible-label: root.source.n + " " + root.source.clip + " " + root.source.time;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            padding-top: 5px;
            Mono { text: "[" + root.source.n + "]"; height: 16px; }
            Rectangle { }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 0;
                if root.show-project && root.project != "": Mono { text: root.project + "/"; color: Ph.dim; }
                Mono { text: root.source.clip; overflow: elide; horizontal-stretch: 1; }
                Mono { text: root.source.time; color: Ph.mid; font-size: 11px; }
            }
            Mono { text: root.source.text; color: Ph.dim; font-size: 10.5px; overflow: elide; }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The answer in a box: "ANSWER" and the scope over a dashed rule, the words under it, or
// "Thinking" with the cursor while it comes.
component Answer inherits Rectangle {
    in property <length> max-h: 320px;
    height: min(body.preferred-height + 30px, root.max-h);
    border-width: 1px;
    border-color: Ph.line;
    background: Ph.bg2;
    HorizontalLayout {
        x: 10px;
        width: parent.width - 20px;
        y: 0;
        height: 24px;
        Caps { text: "ANSWER"; horizontal-stretch: 1; }
        Caps {
            text: Pages.ask-all ? "all projects" : Main.project >= 0 && Main.project < Main.projects.length ? Main.projects[Main.project] : "";
            letter-spacing: 1px;
        }
    }
    PhDash { x: 1px; y: 24px; width: parent.width - 2px; height: 1px; }
    Scroller {
        y: 28px;
        height: parent.height - 30px;
        body := VerticalLayout {
            padding-left: 10px;
            padding-right: 14px;
            padding-top: 4px;
            padding-bottom: 8px;
            if Pages.answer == "": HorizontalLayout {
                spacing: 4px;
                height: 22px;
                alignment: start;
                Mono { text: "Thinking"; color: Ph.dim; }
                VerticalLayout { alignment: center; Block { width: 8px; height: 15px; } }
            }
            if Pages.answer != "": Text {
                text: Pages.answer;
                color: Ph.ph;
                font-family: Ph.mono;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}

// The sources: their rule and their lines.
component Sources inherits VerticalLayout {
    callback open(int);
    spacing: 4px;
    if Pages.sources.length > 0: Rule { word: "SOURCES"; }
    Scroller {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            spacing: 2px;
            for s[i] in Pages.sources: Source {
                source: s;
                show-project: Pages.ask-all;
                project: s.place >= 0 && s.place < Main.projects.length ? Main.projects[s.place] : "";
                clicked => { root.open(i); }
            }
        }
    }
}

export component AskPage inherits Rectangle {
    in property <bool> wide;
    callback go(int);
    callback ask(string, bool);
    callback open-source(int);
    background: Ph.bg;
    VerticalLayout {
        Title { back-word: "back"; tty: "tty6"; settings: false; back => { root.go(0); } }
        Heading { title: "ASK"; }
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 12px;
            padding-bottom: 10px;
            spacing: 10px;
            Prompt {
                horizontal-stretch: 1;
                height: 32px;
                prompt: "ask>";
                placeholder: "Ask about your clips";
                label: "Question";
                grab-on-init: true;
                text <=> Pages.question;
                accepted => { if (Pages.question != "" && !Pages.asking) { root.ask(Pages.question, Pages.ask-all); } }
            }
            if Main.projects.length > 1: VerticalLayout {
                alignment: center;
                Kbd {
                    key: "--all";
                    ink: Ph.mid;
                    accessible-role: checkbox;
                    label: "Ask all projects";
                    tip: "";
                    on: Pages.ask-all;
                    clicked => { Pages.ask-all = !Pages.ask-all; }
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    height: 32px;
                    primary: true;
                    text: "Ask";
                    enabled: Pages.question != "" && !Pages.asking;
                    clicked => { root.ask(Pages.question, Pages.ask-all); }
                }
            }
        }
        if !root.wide: VerticalLayout {
            vertical-stretch: 1;
            padding-left: 14px;
            padding-right: 14px;
            padding-bottom: 12px;
            spacing: 12px;
            if Pages.answer != "" || Pages.asking: Answer { }
            Sources { open(i) => { root.open-source(i); root.go(1); } }
        }
        if root.wide: HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 14px;
            padding-right: 14px;
            padding-bottom: 12px;
            spacing: 22px;
            VerticalLayout {
                horizontal-stretch: 1.1;
                alignment: start;
                if Pages.answer != "" || Pages.asking: Answer { max-h: 460px; }
            }
            Sources {
                horizontal-stretch: 1;
                open(i) => { root.open-source(i); root.go(1); }
            }
        }
        StatusBar { }
    }
    Glass { }
}

// ---------- The widget ----------

// The small always-on-top window as a one line terminal: the lamp and the word with [^]
// to open the window, the clock in CRT figures, Pause and REC as boxed keys, and the level
// in blocks. The whole panel moves the window.
export component Widget inherits Rectangle {
    background: Ph.bg;
    border-width: 1px;
    border-color: Main.recording ? Ph.ph : Ph.line;
    WindowMoveArea {
        VerticalLayout {
            padding-top: 8px;
            padding-left: 12px;
            padding-right: 10px;
            padding-bottom: 10px;
            spacing: 6px;
            HorizontalLayout {
                height: 22px;
                spacing: 7px;
                VerticalLayout {
                    alignment: center;
                    Block {
                        width: 8px;
                        height: 8px;
                        ink: Main.paused ? Ph.amber : Ph.ph;
                        lit: Main.recording;
                    }
                }
                Mono {
                    text: Main.recording ? (Main.paused ? "PAUSED" : "RECORDING") : "READY";
                    color: Main.recording ? (Main.paused ? Ph.amber : Ph.hi) : Ph.dim;
                    font-size: 11px;
                    letter-spacing: 2px;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Kbd {
                        key: "[^]";
                        ink: Ph.mid;
                        label: "Open the window";
                        tip: "Open window";
                        clicked => { Main.compact-changed(false); }
                    }
                }
            }
            HorizontalLayout {
                height: 34px;
                spacing: 6px;
                Text {
                    text: Main.elapsed;
                    color: Main.recording ? Ph.hi : Ph.mid;
                    font-family: Ph.crt;
                    font-size: 36px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if Main.recording: BoxKey {
                    height: 26px;
                    pad: 8px;
                    glyph: Main.paused ? "play" : "pause";
                    hint: "[p]";
                    size: 18px;
                    amber: Main.paused;
                    label: Main.paused ? "Resume" : "Pause";
                    tip: "";
                    clicked => { Main.toggle-pause(); }
                }
                BoxKey {
                    height: 26px;
                    pad: 8px;
                    glyph: Main.recording ? "stop" : "mic";
                    word: Main.recording ? "STOP" : "REC";
                    size: 18px;
                    label: Main.recording ? "Stop recording" : "Record";
                    tip: Main.recording ? "Stop" : "Record";
                    clicked => { Main.toggle-record(); }
                }
            }
            // The level: blocks while recording (the loud tops amber), a dashed rest line
            // otherwise.
            level := Rectangle {
                height: 12px;
                property <int> n: max(1, floor(self.width / 4px));
                if !Main.recording: PhDash { y: (parent.height - 1px) / 2; height: 1px; }
                if Main.recording: Rectangle {
                    for i in level.n: Rectangle {
                        property <float> v: Main.live.length > 0 ? Main.live[floor(i * Main.live.length / level.n)] : 0;
                        x: i * 4px;
                        width: 3px;
                        height: max(2px, round(self.v * 6) / 6 * parent.height);
                        y: (parent.height - self.height) / 2;
                        background: self.v > 0.75 ? Ph.amber : Ph.ph;
                    }
                }
            }
        }
    }
}

// ---------- Questions and covers ----------

// A box over the dimmed window: a frame inside a frame, its rule, the question in CRT
// figures, a prompt to write in and a short row of boxed keys. AppWindow works out the
// words; the keys report back.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> note;
    in property <string> field;
    in property <string> ok;
    in property <bool> ok-enabled;
    // A single clip's delete question shows its name brighter.
    in property <string> clip-name;
    callback close();
    callback confirm();
    callback discard();
    property <int> kind: Main.dialog;
    property <bool> writes: root.kind == 1 || root.kind >= 4;
    background: #0000009e;
    TouchArea { clicked => { root.close(); } }
    box := Rectangle {
        width: min(parent.width - 48px, root.kind == 3 ? 400px : 360px);
        height: col.preferred-height + 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 30px;
        background: Ph.bg;
        border-width: 1px;
        border-color: Ph.ph;
        TouchArea { }
        Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            border-width: 1px;
            border-color: Ph.dim;
        }
        col := VerticalLayout {
            x: 5px;
            y: 5px;
            width: parent.width - 10px;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 14px;
            spacing: 10px;
            Rule { word: root.kind == 2 ? "RM" : root.kind == 3 ? "EDIT" : "NAME"; }
            if root.clip-name == "": Text {
                text: root.title;
                color: Ph.hi;
                font-family: Ph.crt;
                font-size: 28px;
                letter-spacing: 1px;
                overflow: elide;
            }
            if root.clip-name != "": HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Text {
                    text: "Delete";
                    color: Ph.hi;
                    font-family: Ph.crt;
                    font-size: 28px;
                    letter-spacing: 1px;
                }
                Text {
                    text: root.clip-name;
                    color: Ph.ph;
                    font-family: Ph.crt;
                    font-size: 28px;
                    letter-spacing: 1px;
                    overflow: elide;
                }
            }
            if root.note != "": Mono {
                text: root.note;
                color: Ph.mid;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.writes: VerticalLayout {
                spacing: 5px;
                Caps { text: root.field.to-uppercase(); }
                Prompt {
                    label: root.field;
                    grab-on-init: true;
                    text <=> Main.dialog-text;
                    accepted => { if (root.ok-enabled) { root.confirm(); } }
                }
            }
            HorizontalLayout {
                padding-top: 2px;
                alignment: end;
                spacing: 8px;
                Btn { height: 28px; text: "Cancel"; clicked => { root.close(); } }
                if root.kind == 3: Btn { height: 28px; text: "Discard changes"; clicked => { root.discard(); } }
                Btn {
                    height: 28px;
                    min-width: 80px;
                    primary: true;
                    red: root.kind == 2;
                    text: root.ok;
                    enabled: root.ok-enabled;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
    Glass { }
}

// New words being spoken: the box with the stage, the progress in cells and Cancel. It
// blocks clicks.
export component Speaking inherits Rectangle {
    callback cancel();
    background: #000000c8;
    TouchArea { }
    Rectangle {
        width: min(parent.width - 48px, 360px);
        height: col.preferred-height + 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 30px;
        background: Ph.bg;
        border-width: 1px;
        border-color: Ph.ph;
        Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            border-width: 1px;
            border-color: Ph.dim;
        }
        col := VerticalLayout {
            x: 5px;
            y: 5px;
            width: parent.width - 10px;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 14px;
            spacing: 10px;
            Rule { word: "TTS"; }
            Text {
                text: "Speaking new words";
                color: Ph.hi;
                font-family: Ph.crt;
                font-size: 28px;
                letter-spacing: 1px;
            }
            Mono { text: Pages.speak-stage; color: Ph.mid; font-size: 12px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 2px;
                height: 18px;
                Mono { text: "["; color: Ph.dim; }
                Rectangle {
                    horizontal-stretch: 1;
                    PhShade { y: (parent.height - 13px) / 2; height: 13px; width: 100%; }
                    Rectangle {
                        x: 0;
                        y: (parent.height - 13px) / 2;
                        height: 13px;
                        width: parent.width * clamp(Pages.speak-progress, 0, 1);
                        background: Ph.ph;
                    }
                }
                Mono { text: "]"; color: Ph.dim; }
                Mono { text: round(Pages.speak-progress * 100) + "%"; font-size: 12px; width: 44px; horizontal-alignment: right; }
            }
            HorizontalLayout {
                alignment: end;
                Btn { height: 28px; text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
    Glass { }
}

// Files dragged over the window: a bright frame, the file types in a box, DROP TO IMPORT
// and the import command at a cursor.
export component Drop inherits Rectangle {
    background: #050a06f2;
    Rectangle {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        border-width: 2px;
        border-color: Ph.ph;
        VerticalLayout {
            alignment: center;
            spacing: 14px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: types.preferred-width + 36px;
                    height: 40px;
                    border-width: 1px;
                    border-color: Ph.ph;
                    Rectangle {
                        x: 3px;
                        y: 3px;
                        width: parent.width - 6px;
                        height: parent.height - 6px;
                        border-width: 1px;
                        border-color: Ph.dim;
                    }
                    types := HorizontalLayout {
                        x: 18px;
                        width: self.preferred-width;
                        spacing: 10px;
                        Mono { text: "+"; color: Ph.hi; }
                        Mono { text: "*.wav *.mp3 *.m4a"; color: Ph.dim; }
                    }
                }
            }
            Text {
                text: "DROP TO IMPORT";
                color: Ph.hi;
                font-family: Ph.crt;
                font-size: 40px;
                letter-spacing: 3px;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 2px;
                Mono { text: "$ import"; color: Ph.dim; font-size: 12px; }
                VerticalLayout { alignment: center; Block { width: 8px; height: 15px; } }
            }
        }
    }
    Glass { }
}
