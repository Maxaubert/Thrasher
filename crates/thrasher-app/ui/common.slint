                        // The ruled lines, under each line of text.

                        if root.transcript != "" && !root.transcribing: Rectangle {
                            for k in max(0, ceil(parent.height / root.rule-pitch) + 1): Rectangle {
                                y: 23px + 7px + root.rule-off + (k + 1) * root.rule-pitch - (root.original-view && !root.editing ? 3px : 1px);
                                visible: self.y > 26px;
                                height: 1px;
                                background: #8c3c282e;
                            }
                        }
                        Rectangle { x: 23px; y: 24px; width: 1px; background: #c9331f59; }
                        Text {
                            x: 10px;
                            y: 0;
                            height: 20px;
                            text: root.editing ? "TYPING" : root.summary-view ? "SUMMARY" : root.lang-view ? "TRANSLATION" : "INSERT";
                            color: Deck.ink-soft;
                            font-family: "Oswald";
                            font-size: 8px;
                            letter-spacing: 1.9px;
                            vertical-alignment: center;
                        }
                        Text {
                            x: parent.width - self.width - 10px;
                            y: 0;
                            width: min(self.preferred-width, parent.width / 2);
                            height: 20px;
                            text: root.clip-name;
                            color: Deck.ink-soft;
                            font-family: "Oswald";
                            font-size: 8px;
                            letter-spacing: 1.2px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle { y: 20px; height: 3px; background: Deck.red; }
                        Rectangle { y: 23px; height: 2px; background: Deck.amber; }
                    }
                }
                // Pocket Synth: the second black screen, orange round its edge while it is typed
                // on; its head line names the view and the clip.
                SynScreen {
                    visible: Theme.synth;
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    hot: root.editing;
                    Rectangle {
                        x: 14px;
                        y: 14px;
                        width: 7px;
                        height: 7px;
                        background: root.editing ? #ff5a1e : #7d857f;
                    }
                    Text {
                        x: 28px;
                        y: 11px;
                        height: 13px;
                        text: root.editing ? "EDIT" : root.transcribing ? "WORKING" : root.transcript == "" ? "EMPTY" : root.summary-view ? "SUMMARY" : root.lang-view ? "TRANSLATION" : "ORIGINAL";
                        color: root.editing ? #eef3ee : #7d857f;
                        font-family: Theme.mono;
                        font-size: 7.5px;
                        font-weight: 700;
                        letter-spacing: 1.9px;
                        vertical-alignment: center;
                    }
                    Text {
                        x: parent.width / 2;
                        y: 11px;
                        width: parent.width / 2 - 14px;
                        height: 13px;
                        text: root.clip-name.to-uppercase();
                        color: #7d857f;
                        font-family: Theme.mono;
                        font-size: 7.5px;
                        font-weight: 700;
                        letter-spacing: 1.2px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    padding-left: Theme.tape ? 34px : Theme.os95 ? 8px : Theme.comic ? 4px : Theme.pocket && root.editing ? 8px : Theme.brick ? 7px : Theme.synth ? 12px : 0;
                    padding-right: Theme.tape ? 10px : Theme.os95 ? 2px : Theme.pocket && root.editing ? 4px : Theme.brick ? 3px : Theme.synth ? 4px : 0;
                    padding-top: Theme.tape ? 31px : Theme.os95 ? 4px : Theme.comic ? 2px : Theme.pocket && root.editing ? 6px : Theme.brick ? 5px : Theme.synth ? 32px : 0;
                    padding-bottom: Theme.tape ? 8px : Theme.os95 ? 2px : Theme.pocket && root.editing ? 6px : Theme.brick ? 5px : Theme.synth ? 10px : 0;
                    spacing: 8px;
            if root.transcribing: VerticalLayout {
                spacing: Theme.comic || Theme.quest || Theme.cozy || Theme.pinball || Theme.phono ? 12px : 10px;
                alignment: Theme.os95 || Theme.comic || Theme.quest || Theme.pocket || Theme.brick || Theme.cozy || Theme.pinball || Theme.phono ? LayoutAlignment.center : LayoutAlignment.start;
                padding-left: Theme.comic ? 24px : Theme.pocket ? 30px : Theme.brick ? 20px : Theme.cozy || Theme.pinball || Theme.phono ? 20px : 0;
                padding-right: Theme.comic ? 28px : Theme.pocket ? 30px : Theme.brick ? 24px : Theme.cozy || Theme.pinball || Theme.phono ? 20px : 0;
                if Theme.os95: HorizontalLayout { alignment: center; OsPx { source: @image-url("skins/dv-os95/hour.png"); s: 2; } }
                Text {
                    text: (root.translating ? "Translating " : "Transcribing ") + round(root.transcribe-progress * 100) + "%";
                    color: Theme.phono ? Pn.ink-soft : Theme.pinball ? Pb.dmd-3 : Theme.cozy ? Cz.ink : Theme.quest ? Quest.white : Theme.tape ? Deck.ink-soft : Theme.comic ? Comic.ink : Theme.synth ? #dfe5df : Theme.answer ? Am.print : Theme.text2;
                    font-family: Theme.phono ? Pn.font : Theme.pinball ? "Pinball Dots" : Theme.cozy ? Cz.title : Theme.quest ? Quest.font : Theme.tape ? "Caveat" : Theme.dash ? "Manrope" : Theme.os95 ? Os.font : Theme.comic ? "Bangers" : Theme.pocket ? Pk.big : Theme.brick ? Brick.words : Theme.answer ? "Courier Prime" : Theme.synth ? Theme.mono : "Inter Tight";
                    font-size: Theme.phono ? 18px : Theme.pinball ? 16px : Theme.cozy ? 28px : Theme.quest ? 15px : Theme.tape ? 22px : Theme.comic ? 24px : Theme.pocket ? 22px : Theme.brick ? 20px : Theme.synth ? 12px : 14px;
                    font-weight: Theme.tape ? 700 : Theme.phono ? 500 : 400;
                    font-italic: Theme.phono;
                    letter-spacing: Theme.comic || Theme.cozy ? 1.2px : 0;
                    horizontal-alignment: Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.cozy || Theme.pinball || Theme.phono ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
                }
                // Quest Menu: a gold EXP bar (blue while translating) in an ink well with a
                // grey rim.
                if Theme.quest: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        preferred-width: 280px;
                        min-width: 60px;
                        height: 21px;
                        background: Quest.ink;
                        border-width: 3px;
                        border-color: Quest.grey;
                        Rectangle {
                            x: 6px;
                            y: 6px;
                            width: (parent.width - 12px) * clamp(root.transcribe-progress, 0, 1);
                            height: 9px;
                            background: root.translating ? Quest.mp : Quest.gold;
                        }
                    }
                }
                // Brick Phone: a block bar in an ink frame.
                if Theme.brick: Rectangle {
                    height: 8px;
                    border-width: 1px;
                    border-color: Brick.ink;
                    property <int> blocks: 22;
                    for k in self.blocks: Rectangle {
                        x: 2px + k * (parent.width - 4px) / parent.blocks;
                        y: 2px;
                        width: (parent.width - 4px) / parent.blocks - 1px;
                        height: parent.height - 4px;
                        background: (k + 0.5) / parent.blocks <= root.transcribe-progress ? Brick.ink : Brick.ghost;
                    }
                }
                // Cozy Cabin: a segmented honey bar (moss while translating).
                if Theme.cozy: CzBar {
                    height: 18px;
                    progress: root.transcribe-progress;
                    fill: root.translating ? Cz.moss-l : Cz.honey;
                }
                // Pinball: the lane lamps lighting up.
                if Theme.pinball: HorizontalLayout {
                    alignment: center;
                    Lanes { value: root.transcribe-progress; }
                }
                // Phonograph: the wax being cut, the carriage at its head.
                if Theme.phono: PnBar { value: root.transcribe-progress; }
                if !Theme.os95 && !Theme.quest && !Theme.brick && !Theme.cozy && !Theme.pinball && !Theme.phono: Rectangle {
                    height: Theme.tape ? 8px : Theme.comic ? 16px : Theme.answer ? 8px : Theme.pocket ? 10px : Theme.synth ? 8px : 4px;
                    border-radius: Theme.tape || Theme.comic || Theme.pocket || Theme.synth ? 0 : 2px;
                    background: Theme.tape ? #1b1410 : Theme.pocket ? transparent : Theme.comic ? #ffffff : Theme.answer ? #3a2a24 : Theme.synth ? #2c302e : Theme.track;
                    PkTile { visible: Theme.pocket; source: @image-url("skins/px-pocket/dith.png"); }
                    PkRing { visible: Theme.pocket; }
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.transcribe-progress, 0, 1);
                        border-radius: Theme.tape || Theme.comic || Theme.pocket || Theme.synth ? 0 : 2px;
                        background: Theme.comic ? Comic.red : Theme.pocket ? Pk.l3 : Theme.synth ? #ff5a1e : Theme.accent;
                        Image {
                            visible: Theme.comic;
                            width: 100%;
                            height: 100%;
                            source: @image-url("skins/x-comic/dots-red.png");
                            horizontal-tiling: repeat;
                            vertical-tiling: repeat;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                        }
                        Rectangle { visible: Theme.comic; x: parent.width - 2.5px; width: 2.5px; background: Comic.ink; }
                    }
                    Rectangle { visible: Theme.comic; border-width: 2.5px; border-color: Comic.ink; }
                    // Pocket Synth: the bar in LED segments, a dark gap every 10px.
                    for k in Theme.synth ? floor(parent.width / 10px) : 0: Rectangle {
                        x: k * 10px + 8px;
                        y: 0;
                        width: 2px;
                        height: parent.height;
                        background: #0b0c0c;
                    }
                }
                // Desktop 95: a blocky progress bar.
                if Theme.os95: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        preferred-width: 240px;
                        min-width: 60px;
                        height: 16px;
                        background: Os.face;
                        OsBevel { kind: 2; }
                        property <int> blocks: floor(clamp(root.transcribe-progress, 0, 1) * (self.width - 4px) / 10px);
                        for k in self.blocks: Rectangle { x: 2px + k * 10px; y: 2px; width: 8px; height: 12px; background: Os.navy; }
                    }
                }
            }
            if root.transcript == "" && !root.transcribing: VerticalLayout {
                alignment: Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.cozy || Theme.pinball || Theme.phono ? LayoutAlignment.center : LayoutAlignment.start;
                spacing: Theme.brick ? 10px : 12px;
                Text {
                    text: "No transcript yet";
                    color: Theme.phono ? Pn.ink-soft : Theme.pinball ? #cfc4d6 : Theme.cozy ? Cz.ink : Theme.pocket ? Pk.l3 : Theme.quest ? Quest.white : Theme.tape ? Deck.ink-soft : Theme.comic ? Comic.ink : Theme.synth ? #8c948e : Theme.answer ? Am.print : Theme.brick ? Brick.ink : Theme.dim;
                    font-family: Theme.phono ? Pn.font : Theme.pinball ? Pb.font : Theme.cozy ? Cz.title : Theme.pocket ? Pk.big : Theme.quest ? Quest.font : Theme.tape ? "Caveat" : Theme.os95 ? Os.font : Theme.comic ? "Bangers" : Theme.dash ? "Manrope" : Theme.brick ? Brick.words : Theme.answer ? "Courier Prime" : Theme.synth ? Theme.mono : "Inter Tight";
                    font-size: Theme.phono ? 18px : Theme.pinball ? 15px : Theme.cozy ? 28px : Theme.quest ? 15px : Theme.tape || Theme.pocket ? 22px : Theme.comic ? 24px : Theme.brick ? 20px : Theme.synth ? 12px : 14px;
                    font-weight: Theme.tape ? 700 : Theme.phono ? 500 : 400;
                    font-italic: Theme.phono;
                    letter-spacing: Theme.comic || Theme.cozy ? 1.2px : 0;
                    horizontal-alignment: Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.cozy || Theme.pinball || Theme.phono ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
                }
                if root.can-transcribe: HorizontalLayout {
                    alignment: Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.cozy || Theme.pinball || Theme.phono ? LayoutAlignment.center : LayoutAlignment.start;
                    Btn {
                        primary: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.answer || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono;
                        height: Theme.quest ? 33px : Theme.tape ? 32px : Theme.os95 || Theme.pocket ? 23px : Theme.comic ? 40px : Theme.brick ? 24px : Theme.answer ? 30px : Theme.synth ? 28px : 36px;
                        text: "Transcribe";
                        enabled: !root.recording;
                        clicked => { root.transcribe(); }
                    }
                }
            }
            if root.editing: Rectangle {
                vertical-stretch: 1;
                clip: true;
            ed-scroll := Scroller {
                bar95: Theme.os95;
                pk-rail: Theme.pocket;
                quest-rail: Theme.quest;
                changed content-y => { root.scroll-y = self.content-y; }
                init => { root.scroll-y = self.content-y; }
                VerticalLayout {
                    padding-left: 0;
                    padding-right: Theme.os95 ? 22px : Theme.quest ? 18px : Theme.phono ? 16px : Theme.pinball ? 16px : 10px;
                    padding-top: 2px;
                    padding-bottom: 6px;
                    Rectangle {
                        height: editor.height;
                        StyledText {
                            width: parent.width;
                            y: 0;
                            text: root.edit-markup(editor.text);
                            default-color: Theme.phono ? Pn.ink : Theme.pinball ? Pb.ink : Theme.cozy ? Cz.ink : Theme.quest ? Quest.white : Theme.tape ? #2f2117 : Theme.comic ? Comic.ink : Theme.answer ? Am.ink : Theme.synth ? #dfe5df : Theme.text2;
                            default-font-family: Theme.pocket ? Pk.big : Theme.quest ? Quest.font : root.text-family;
                            default-font-size: Theme.pocket ? 20px : Theme.quest ? 14px : root.text-size;
                        }
                        editor := TextInput {
                            width: parent.width;
                            height: max(self.preferred-height, ed-scroll.visible-height - 8px);
                            text <=> root.edit-draft;
                            font-family: Theme.pocket ? Pk.big : Theme.quest ? Quest.font : root.text-family;
                            font-size: Theme.pocket ? 20px : Theme.quest ? 14px : root.text-size;
                            single-line: false;
                            wrap: word-wrap;
                            color: transparent;
                            selection-background-color: Theme.quest ? Quest.sel : Theme.accent.with-alpha(0.3);
                            selection-foreground-color: transparent;
                            accessible-role: text-input;
                            accessible-label: "Transcript";
                            init => { self.focus(); }
                            edited => { root.edit-draft = self.text; root.edited(self.text); }
                            cursor-position-changed(p) => {
                                root.caret = p;
                                // Keep the cursor in view.
                                if (p.y + 2px + root.caret-h > -ed-scroll.content-y + ed-scroll.visible-height) {
                                    ed-scroll.content-y = -(p.y + 2px + root.caret-h + 6px - ed-scroll.visible-height);
                                } else if (p.y + 2px < -ed-scroll.content-y) {
                                    ed-scroll.content-y = -max(0px, p.y);
                                }
                            }
                            key-pressed(e) => {
                                // With the marks hidden, copying gives just the words.
                                if (e.modifiers.control && (e.text == "c" || e.text == "C") && !root.show-marks) {
                                    clip-buf.text = root.plain-selection(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                                    clip-buf.select-all();
                                    clip-buf.copy();
                                    // Emptied at once, so it is never drawn with a selection.
                                    clip-buf.clear-selection();
                                    clip-buf.text = "";
                                    return accept;
                                }
                                reject
                            }
                        }
                        // The text box's own cursor has the (invisible) text colour.
                        Rectangle {
                            visible: editor.has-focus && editor.anchor-position-byte-offset == editor.cursor-position-byte-offset;
                            x: root.caret.x;
                            y: root.caret.y;
                            width: Theme.synth ? 7.5px : Theme.pocket ? 8px : Theme.comic ? 2.5px : Theme.quest ? 3px : 2px;
                            height: root.caret-h;
                            background: Theme.pocket ? Pk.l3 : Theme.synth ? #ff5a1ecc : Theme.accent;
                        }
                    }
                }
            }
            // Holds the words being copied for a moment; see the editor's key-pressed.
            clip-buf := TextInput {
                x: 0;
                y: 0;
                width: 20px;
                height: 20px;
                color: transparent;
                read-only: true;
            }
            }
            if root.summary-view && !root.transcribing && !root.editing: Scroller {
                vertical-stretch: 1;
                bar95: Theme.os95;
                pk-rail: Theme.pocket;
                quest-rail: Theme.quest;
                changed content-y => { root.scroll-y = self.content-y; }
                init => { root.scroll-y = self.content-y; }
                VerticalLayout {
                    padding-right: Theme.os95 ? 22px : Theme.pocket ? 14px : Theme.quest ? 18px : Theme.phono ? 16px : Theme.pinball ? 16px : 10px;
                    spacing: 8px;
                    if root.summarising && root.summary == "": Text {
                        text: "Summarising";
                        color: Theme.quest ? Quest.grey : Theme.tape ? Deck.ink-soft : Theme.comic ? Comic.sub : Theme.synth ? #8c948e : Theme.dim;
                        font-family: Theme.pocket ? Pk.big : Theme.quest ? Quest.font : root.text-family;
                        font-weight: Theme.comic ? 700 : 400;
                        font-size: Theme.pocket ? 20px : Theme.quest ? 14px : Theme.brick ? root.brick-size : Theme.tape || Theme.synth ? 12px : Theme.os95 ? 19px : Theme.comic ? 13.5px : 14px;
                    }
                    Text {
                        text: root.summary;
                        color: Theme.quest ? Quest.white : Theme.tape ? #2f2117 : Theme.comic ? Comic.ink : Theme.answer ? Am.ink : Theme.synth ? #dfe5df : Theme.text2;
                        font-family: Theme.pocket ? Pk.big : Theme.quest ? Quest.font : root.text-family;
                        font-weight: Theme.comic ? 700 : 400;
                        font-size: Theme.pocket ? 20px : Theme.quest ? 14px : Theme.answer ? 13px : root.text-size;
                        wrap: word-wrap;
                    }
                }
            }
            if root.lang-view && !root.transcribing && !root.editing: Scroller {
                vertical-stretch: 1;
                bar95: Theme.os95;
                pk-rail: Theme.pocket;
                quest-rail: Theme.quest;
                changed content-y => { root.scroll-y = self.content-y; }
                init => { root.scroll-y = self.content-y; }
                VerticalLayout {
                    padding-right: Theme.os95 ? 22px : Theme.pocket ? 14px : Theme.quest ? 18px : Theme.phono ? 16px : Theme.pinball ? 16px : 10px;
                    Text {
                        text: root.translation != "" ? root.translation : "Translating";
                        color: Theme.quest ? (root.translation != "" ? Quest.white : Quest.grey) : Theme.tape ? (root.translation != "" ? #2f2117 : Deck.ink-soft) : Theme.comic ? (root.translation != "" ? Comic.ink : Comic.sub)
                            : Theme.answer ? (root.translation != "" ? Am.ink : Am.print-soft)
                            : Theme.synth ? (root.translation != "" ? #dfe5df : #8c948e)
                            : root.translation != "" ? Theme.text2 : Theme.dim;
                        font-family: Theme.pocket ? Pk.big : Theme.quest ? Quest.font : root.text-family;
                        font-weight: Theme.comic ? 700 : 400;
                        font-size: Theme.pocket ? 20px : Theme.quest ? 14px : Theme.answer ? 13px : root.text-size;
                        wrap: word-wrap;
                    }
                }
            }
            if root.transcript != "" && !root.transcribing && !root.editing && !root.lang-view && !root.summary-view: Scroller {
                vertical-stretch: 1;
                bar95: Theme.os95;
                pk-rail: Theme.pocket;
                quest-rail: Theme.quest;
                // A new transcript starts at the top; Slint would keep the old offset.
                property <string> shown: root.transcript;
                init => { self.content-y = 0; root.scroll-y = 0; }
                changed shown => { self.content-y = 0; }
                changed content-y => { root.scroll-y = self.content-y; }
                FlexboxLayout {
                    spacing: Theme.pocket ? 0 : 1px;
                    // Pinball: clear of the wire rail and its 13 px ball.
