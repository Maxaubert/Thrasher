// The Comic Book main page: the recorder as a page of a comic, inked panels and all
// (docs/mockups/device-themes/x-comic.html). Record is a POW burst that shouts REC, the
// level meter is a BZZZZZZZZT sound effect that lights up, the timer talks in a speech
// bubble, every clip is a speech bubble (the highlighted one pops yellow), search is a
// thought bubble, and the status, the project and now showing are caption boxes.
// Portrait windows stack one panel per job; wide ones put a splash panel recorder on
// the left of the clips.
//
// The masthead, the bursts, the meter's two words, the PICKED tag and the halftone
// tiles are PNGs in x-comic/ (1x and 2x), cut from the mockup with headless Edge; the
// rest is drawn here. The STOP burst's ink boils (two frames) on the Fx clock, which
// runs only while recording.

import { Theme, Main, Tips, ProjectMenu, TextField, Scroller, ClipMenu, WaveSeek, ClipRow, SearchHit } from "../common.slint";
import { Comic, Dots, Box, Glyph, InkBtn, Caption, Tag, Bubble, Burst, Meter, InkBars, PlayDot } from "x-comic-parts.slint";

// The masthead: THRASHER with its issue tag, Settings, minimise and close.
component Title inherits Rectangle {
    in property <bool> big;
    callback go(int);
    property <bool> hi: 1phx < 0.7px;
    height: root.big ? 50px : 46px;
    background: Comic.paper;
    Rectangle { y: parent.height - 3px; height: 3px; background: Comic.ink; }
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    HorizontalLayout {
        padding-left: root.big ? 11px : 9px;
        padding-right: root.big ? 11px : 9px;
        padding-bottom: 3px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Image {
                // The art is 214 by 52, the name's top a little under its own.
                height: root.big ? 47px : 42px;
                width: self.height * 214 / 52;
                source: root.hi ? @image-url("x-comic/logo@2x.png") : @image-url("x-comic/logo.png");
                image-fit: fill;
                accessible-role: none;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            InkBtn {
                width: 30px;
                height: 30px;
                round: true;
                face: Comic.yellow;
                icon: "gear";
                icon-size: 17px;
                line: 2.5px;
                label: "Settings";
                clicked => { root.go(3); }
            }
        }
        VerticalLayout {
            alignment: center;
            InkBtn { width: 30px; height: 30px; icon: "min"; icon-size: 17px; label: "Minimize"; clicked => { Main.minimize-window(); } }
        }
        VerticalLayout {
            alignment: center;
            InkBtn { width: 30px; height: 30px; icon: "close"; icon-size: 17px; label: "Close"; clicked => { Main.close-window(); } }
        }
    }
}

// The status caption: a lamp and READY, RECORDING or PAUSED.
component Status inherits Caption {
    width: row.preferred-width;
    height: 22px;
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 9px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: !Main.recording ? #2fbf4f : Main.paused ? #f39b1d : Comic.red;
                border-width: 2px;
                border-color: Comic.ink;
            }
        }
        Text {
            text: Main.recording ? (Main.paused ? "PAUSED" : "RECORDING") : "READY";
            color: Comic.ink;
            font-family: "Bangers";
            font-size: 15px;
            letter-spacing: 1.2px;
            vertical-alignment: center;
        }
    }
}

// The timer in its speech bubble. The bubble's width follows the number of figures,
// not their shapes, so it holds still while the tenths run.
component Timer inherits Bubble {
    in property <length> size: 42px;
    property <string> shown: Main.elapsed + Main.elapsed-tenth;
    property <int> count: root.shown.character-count;
    // "00:00.0" has two separators, "1:02:03.4" three; Bangers' figures are about
    // 0.48 em, the separators 0.2 em.
    property <int> seps: root.count >= 9 ? 3 : 2;
    width: ((root.count - root.seps) * 0.48 + root.seps * 0.2) * root.size + root.count * 2px + root.size * 1.25;
    height: root.size * 1.22;
    tail: root.size * 0.42;
    accessible-role: AccessibleRole.text;
    accessible-label: root.shown;
    Text {
        y: root.size * 0.12;
        height: parent.height - root.size * 0.1;
        text: root.shown;
        color: Comic.ink;
        font-family: "Bangers";
        font-size: root.size;
        letter-spacing: 2px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// The microphone in a white caption box; INPUT in red on the big panel.
component Device inherits Box {
    in property <bool> big;
    in property <length> max-w: 260px;
    line: 2.5px;
    width: min(row.preferred-width, root.max-w);
    height: root.big ? 28px : 25px;
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Glyph { name: "mic"; stroke: 2.4; width: 14px; height: 14px; }
        }
        if root.big: Text {
            text: "INPUT";
            color: Comic.red;
            font-family: "Bangers";
            font-size: 13px;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
        Text {
            text: Main.device-label;
            color: Comic.ink;
            font-family: "Comic Neue";
            font-weight: 700;
            font-size: root.big ? 14px : 12.5px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Pause or Resume while recording, a small caption under the burst.
component PauseChip inherits Rectangle {
    in property <bool> big;
    property <bool> down: t.pressed && t.has-hover;
    width: chip.preferred-width;
    height: root.big ? 24px : 20px;
    accessible-role: button;
    accessible-label: Main.paused ? "Resume" : "Pause";
    accessible-action-default => { Main.toggle-pause(); }
    Box {
        line: 2px;
        off: 2px;
        down: root.down;
        face: t.has-hover && !root.down ? Comic.paper : #ffffff;
        chip := HorizontalLayout {
            padding-left: 6px;
            padding-right: 7px;
            spacing: 4px;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Glyph { name: Main.paused ? "play" : "pause"; width: root.big ? 11px : 9px; height: root.big ? 11px : 9px; }
            }
            word := Text {
                text: Main.paused ? "RESUME" : "PAUSE";
                color: Comic.ink;
                font-family: "Bangers";
                font-size: root.big ? 14px : 12px;
                letter-spacing: 1px;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, Main.paused ? "Resume" : "Pause", self.absolute-position, self.width, self.height); }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tips.hide(); Main.toggle-pause(); }
    }
}

// The burst with Pause under it while recording, centred in its room.
component BurstSpot inherits Rectangle {
    in property <bool> big;
    in property <length> most: 128px;
    callback refocus();
    property <length> chip-h: Main.recording ? (root.big ? 22px : 16px) : 0;
    property <length> d: max(40px, min(root.most, root.width, root.height - root.chip-h));
    Burst {
        big: root.big;
        x: (parent.width - self.width) / 2;
        y: (parent.height - root.chip-h - self.height) / 2;
        width: root.d;
        height: root.d;
    }
    if Main.recording: PauseChip {
        big: root.big;
        x: (parent.width - self.width) / 2;
        y: (parent.height - root.chip-h + root.d) / 2 - (root.big ? 6px : 6px);
    }
}

// The recorder panel in a portrait window: the caption, the timer and the meter with
// the microphone on the left, the burst on the right.
component RecFront inherits Box {
    in property <bool> tall;
    line: 3px;
    dots: 0;
    height: root.tall ? 196px : 164px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: space-between;
            HorizontalLayout { alignment: start; Status { } }
            HorizontalLayout { alignment: start; Timer { size: root.tall ? 50px : 42px; } }
            VerticalLayout {
                spacing: 4px;
                HorizontalLayout { alignment: start; Meter { width: root.tall ? 140px : 118px; } }
                HorizontalLayout { alignment: start; Device { max-w: 230px; } }
            }
        }
        BurstSpot {
            width: root.tall ? 160px : 128px;
            most: root.tall ? 160px : 128px;
        }
    }
}

// The splash panel in a wide window: the caption, the timer, the big burst, the meter
// and the microphone, top to bottom. The burst gives up room first.
component RecSide inherits Box {
    line: 3px;
    dots: 0;
    Tag { x: 0; y: 0; text: "MEANWHILE AT THE MIC"; }
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 33px;
        padding-bottom: 14px;
        spacing: 10px;
        HorizontalLayout { alignment: start; Status { } }
        HorizontalLayout { alignment: center; Timer { size: 58px; } }
        BurstSpot {
            big: true;
            vertical-stretch: 1;
            min-height: 90px;
            most: 200px;
        }
        HorizontalLayout { alignment: center; Meter { big: true; width: 178px; } }
        HorizontalLayout { alignment: center; Device { big: true; max-w: 320px; } }
    }
}

// The project picker as a yellow caption box. ProjectMenu holds what it offers.
component Picker inherits Rectangle {
    in property <bool> big;
    callback refocus();
    property <bool> enabled: !Main.recording;
    property <string> name: Main.project >= 0 && Main.project < Main.projects.length ? Main.projects[Main.project] : "";
    width: row.preferred-width;
    accessible-role: combobox;
    accessible-label: "Project";
    accessible-value: root.name;
    accessible-expandable: true;
    accessible-action-default => { if (root.enabled) { menu.show(); } }
    accessible-action-expand => { if (root.enabled) { menu.show(); } }
    Caption {
        down: t.pressed && t.has-hover && root.enabled;
        face: t.has-hover && root.enabled ? #ffe066 : Comic.yellow;
        opacity: root.enabled ? 1 : 0.6;
        row := HorizontalLayout {
            padding-left: 9px;
            padding-right: 9px;
            spacing: 6px;
            Text {
                text: root.name.to-uppercase();
                color: Comic.ink;
                font-family: "Bangers";
                font-size: root.big ? 18px : 17px;
                letter-spacing: 1.2px;
                vertical-alignment: center;
                max-width: 200px;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                Glyph { name: "down"; width: 12px; height: 12px; }
            }
        }
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := ProjectMenu {
        width: parent.width;
        height: parent.height;
        projects: Main.projects;
        current: Main.project;
        has-clips: Main.clips.length > 0;
        choose(i) => { Main.choose-project(i); root.refocus(); }
        create => { Main.dialog-text = ""; Main.dialog = 4; }
        rename => { Main.dialog-text = Main.projects[Main.project]; Main.dialog = 5; }
        delete => { Main.delete-project(); root.refocus(); }
        export => { Main.export-project(); root.refocus(); }
    }
}

// The toolbar: the project caption, the search thought bubble, then Import, Ask and
// the widget. The wide toolbar spells the buttons out.
component Toolbar inherits HorizontalLayout {
    in property <bool> big;
    callback go(int);
    callback refocus();
    // Where the search bubble starts, for its thought circles (drawn by the list).
    out property <length> search-x: search.x;
    property <length> item-h: root.big ? 40px : 36px;
    height: root.big ? 44px : 40px;
    spacing: root.big ? 8px : 6px;
    padding-right: 2px;
    VerticalLayout {
        alignment: center;
        Picker { height: root.item-h; big: root.big; refocus => { root.refocus(); } }
    }
    search := VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        min-width: 90px;
        Box {
            height: root.item-h;
            radius: root.item-h / 2;
            line: 2.5px;
            TextField {
                x: 2.5px;
                y: 2.5px;
                width: parent.width - 5px;
                height: parent.height - 5px;
                radius: (root.item-h - 5px) / 2;
                fill: #ffffff;
                rest-edge: #ffffff;
                ink: Comic.ink;
                hint: #8a7f69;
                font-size: 13.5px;
                family: "Comic Neue";
                side: 11px;
                icon: "search";
                placeholder: "Search";
                label: "Search clips";
                takes-escape: true;
                focus-ticket: Main.search-ticket;
                text <=> Main.query;
                edited(t) => { Main.search(t, Main.search-all); }
                escaped => { Main.query = ""; Main.search("", Main.search-all); root.refocus(); }
                accepted => { if (Main.hits.length > 0) { Main.open-hit(0); root.go(1); } }
            }
        }
    }
    // Search every project instead of this one.
    if Main.query != "" && Main.projects.length > 1: VerticalLayout {
        alignment: center;
        Rectangle {
            width: all-text.preferred-width + 18px;
            height: root.big ? 28px : 24px;
            accessible-role: checkbox;
            accessible-label: "Search all projects";
            accessible-checked: Main.search-all;
            accessible-action-default => { Main.search-all = !Main.search-all; Main.search(Main.query, Main.search-all); }
            Box {
                line: 2px;
                off: 2px;
                face: Main.search-all ? Comic.yellow : #ffffff;
                all-text := Text {
                    x: 9px;
                    height: parent.height;
                    text: "ALL PROJECTS";
                    color: Comic.ink;
                    font-family: "Bangers";
                    font-size: 12px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { Main.search-all = !Main.search-all; Main.search(Main.query, Main.search-all); }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        InkBtn {
            height: root.item-h;
            icon: "import";
            text: root.big ? "IMPORT" : "";
            label: "Import audio or video";
            tip: "Import";
            enabled: !Main.recording;
            clicked => { Main.import-files(); }
        }
    }
    if Main.can-ai: VerticalLayout {
        alignment: center;
        InkBtn {
            height: root.item-h;
            icon: "ask";
            text: root.big ? "ASK" : "";
            face: Comic.cyan;
            label: "Ask your clips";
            tip: "Ask";
            clicked => { root.go(6); }
        }
    }
    VerticalLayout {
        alignment: center;
        InkBtn {
            height: root.item-h;
            icon: "widget";
            text: root.big ? "WIDGET" : "";
            label: "Small widget";
            tip: "Widget";
            clicked => { Main.compact-changed(true); }
        }
    }
}

// One clip as a speech bubble from its play button: the waveform, the name, when it
// was made (and "transcribed" in blue), the length and the menu. The highlighted or
// picked one pops yellow with a hard shadow and a red PICKED tag.
component Row inherits Rectangle {
    in property <int> index;
    in property <ClipRow> item;
    in property <bool> big;
    in property <length> window-h;
    callback go(int);
    callback ask-rename(int);
    callback ask-delete(int);
    callback refocus();
    property <bool> selected: root.index == Main.selected;
    property <bool> picked: Main.picked[root.index];
    property <bool> active: root.index == Main.active-clip;
    property <bool> pop: root.selected || root.picked;
    property <bool> hi: 1phx < 0.7px;
    property <length> gap: root.big ? 5px : 3px;
    property <length> bh: root.height - root.gap;
    property <length> dot-d: root.big ? 30px : 26px;
    property <length> wave-w: root.big ? 70px : 38px;
    height: root.big ? 45px : 34px;
    accessible-role: list-item;
    accessible-label: root.item.name + ", " + root.item.duration;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected || root.picked;
    accessible-action-default => { root.select(false, false); }
    function select(ctrl: bool, shift: bool) {
        Main.pick(root.index, ctrl, shift);
        root.refocus();
    }
    row-touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.has-hover) {
                root.select(e.modifiers.control, e.modifiers.shift);
            }
            // On release: the press that closes an open menu is used up by that menu.
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                menu.show-at(self.mouse-x, self.mouse-y);
            }
        }
        // Opens just this clip, even out of several picked.
        double-clicked => { root.select(false, false); Main.open-clip(root.index); root.go(1); }
    }
    PlayDot {
        x: 0;
        y: (root.bh - self.height) / 2;
        width: root.dot-d;
        height: root.dot-d;
        hot: root.pop || root.active;
        pause: root.active && Main.playing;
        label: (root.active && Main.playing ? "Pause " : "Play ") + root.item.name;
        tip: root.active && Main.playing ? "Pause" : "Play";
        clicked => { Main.play-clip(root.index); root.refocus(); }
    }
    bubble := Rectangle {
        x: root.dot-d + (root.big ? 12px : 9px);
        y: 0;
        width: root.width - self.x - 4px;
        height: root.bh;
        property <length> line: root.pop ? 2.6px : 2.2px;
        // The hard shadow of the bubble that pops.
        Rectangle {
            visible: root.pop;
            x: 3px;
            y: 3px;
            border-radius: parent.height / 2;
            background: Comic.ink;
        }
        Rectangle {
            border-radius: parent.height / 2;
            background: root.pop ? Comic.yellow : #ffffff;
            border-width: bubble.line;
            border-color: Comic.ink;
        }
        // The tail, back towards the play button.
        Path {
            x: -9px;
            y: 0;
            width: 13px;
            height: parent.height;
            viewbox-width: 13;
            viewbox-height: parent.height / 1px;
            fill: root.pop ? Comic.yellow : #ffffff;
            stroke: Comic.ink;
            stroke-width: 2.2px;
            stroke-line-join: round;
            commands: "M 11.5 " + (bubble.height / 2px - 4) + " L 1.5 " + (bubble.height / 2px + 6) + " L 11.5 " + (bubble.height / 2px + 2.5);
        }
        HorizontalLayout {
            padding-left: root.big ? 12px : 9px;
            padding-right: root.big ? 8px : 6px;
            spacing: root.big ? 12px : 8px;
            // The waveform: a click on the highlighted clip moves its start, a double
            // click plays from there.
            Rectangle {
                width: root.wave-w;
                InkBars {
                    y: (parent.height - self.height) / 2;
                    height: root.big ? 22px : 18px;
                    values: root.item.wave;
                    progress: root.active ? Main.play-fraction : -1;
                }
                WaveSeek {
                    selected: root.selected;
                    active: root.active;
                    select(ctrl, shift) => { root.select(ctrl, shift); }
                    cue(f) => { Main.cue-clip(root.index, f); root.refocus(); }
                    play-at(f) => { Main.play-clip-at(root.index, f); root.refocus(); }
                    menu(x, y) => { menu.show-at(x - root.absolute-position.x, y - root.absolute-position.y); }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: root.big ? 1px : 0;
                Text {
                    text: root.item.name;
                    color: Comic.ink;
                    font-family: "Comic Neue";
                    font-weight: 700;
                    font-size: root.big ? 15px : 13.5px;
                    height: root.big ? 17px : 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 0;
                    Text {
                        text: root.item.when;
                        color: root.pop ? Comic.sub-on-yellow : Comic.sub;
                        font-family: "Comic Neue";
                        font-weight: 700;
                        font-size: root.big ? 11.5px : 10.5px;
                        height: root.big ? 14px : 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.item.transcribed: Text {
                        text: " · transcribed";
                        color: Comic.blue;
                        font-family: "Comic Neue";
                        font-weight: 700;
                        font-size: root.big ? 11.5px : 10.5px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if !root.item.transcribed: Rectangle { horizontal-stretch: 1; }
                }
            }
            Text {
                text: root.item.duration;
                color: Comic.ink;
                font-family: "Bangers";
                font-size: root.big ? 17px : 15px;
                letter-spacing: 1px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
            // The three-dot menu: manage, rename, export, delete.
            Rectangle {
                width: root.big ? 18px : 14px;
                accessible-role: button;
                accessible-label: "Menu for " + root.item.name;
                accessible-action-default => { root.open-menu(); }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 22px;
                    border-radius: 3px;
                    background: dots.has-hover ? #00000014 : transparent;
                }
                Glyph {
                    name: "more";
                    width: 18px;
                    height: 18px;
                }
                property <bool> hovering: dots.has-hover;
                changed hovering => { Tips.hover(self.hovering, "More options", self.absolute-position, self.width, self.height); }
                dots := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Tips.hide(); root.open-menu(); }
                }
            }
        }
        // PICKED, slapped on the corner.
        Image {
            visible: root.pop;
            x: parent.width - 50px;
            y: root.big ? -13px : -12px;
            width: 60px * (root.big ? 1 : 0.88);
            height: 26px * (root.big ? 1 : 0.88);
            source: root.hi ? @image-url("x-comic/picked@2x.png") : @image-url("x-comic/picked.png");
            image-fit: fill;
            accessible-role: none;
        }
    }
    function open-menu() {
        menu.show-at(root.width - 8px - 210px, (root.height + 24px) / 2 + 4px);
    }
    menu := ClipMenu {
        width: parent.width;
        height: parent.height;
        item: root.item;
        merge-count: root.picked ? Main.picked-count : 0;
        projects: Main.projects;
        project: Main.project;
        window-h: root.window-h;
        merge => { Main.start-merge(); root.go(5); }
        open => { Main.open-clip(root.index); root.go(1); }
        rename => { root.ask-rename(root.index); }
        export(kind) => { Main.selected = root.index; Main.export-as(kind); root.refocus(); }
        delete => { root.ask-delete(root.index); }
        move-to(p) => { Main.move-clip(root.index, p); root.refocus(); }
    }
}

// A search result as a speech bubble: the clip (and its project when all projects are
// searched, extra hits as a red +2), then the words around the match, the match
// marked in yellow.
component Hit inherits Rectangle {
    in property <SearchHit> hit;
    in property <bool> show-project;
    in property <bool> big;
    callback clicked;
    height: 50px;
    accessible-role: button;
    accessible-label: root.hit.clip + ", " + root.hit.before + " " + root.hit.matched + " " + root.hit.after;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        y: 0;
        height: parent.height - 4px;
        border-radius: 14px;
        background: t.has-hover ? Comic.paper : #ffffff;
        border-width: 2.2px;
        border-color: Comic.ink;
        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.hit.clip;
                    color: Comic.ink;
                    font-family: "Comic Neue";
                    font-weight: 700;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.show-project: Text {
                    text: root.hit.project.to-uppercase();
                    color: Comic.sub;
                    font-family: "Bangers";
                    font-size: 12px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
                if root.hit.more > 0: Text {
                    text: "+" + root.hit.more;
                    color: Comic.red;
                    font-family: "Bangers";
                    font-size: 13px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
            if root.hit.matched != "": HorizontalLayout {
                spacing: 3px;
                if root.hit.before != "": Text {
                    text: root.hit.before;
                    color: Comic.sub;
                    font-family: "Comic Neue";
                    font-weight: 700;
                    font-size: 11.5px;
                    horizontal-stretch: 0;
                }
                Rectangle {
                    width: mark.preferred-width + 6px;
                    horizontal-stretch: 0;
                    background: Comic.yellow;
                    mark := Text {
                        text: root.hit.matched;
                        color: Comic.ink;
                        font-family: "Comic Neue";
                        font-weight: 700;
                        font-size: 11.5px;
                        horizontal-alignment: center;
                    }
                }
                Text {
                    text: root.hit.after;
                    color: Comic.sub;
                    font-family: "Comic Neue";
                    font-weight: 700;
                    font-size: 11.5px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The clips panel: the bubbles, or the search results while there is a query. The
// thought circles of the search bubble above it are drawn here, over its outline.
component Clips inherits Box {
    in property <bool> big;
    in property <length> window-h;
    in property <length> thought-x;
    callback go(int);
    callback ask-rename(int);
    callback ask-delete(int);
    callback refocus();
    line: 3px;
    vertical-stretch: 1;
    property <length> pad-top: root.big ? 24px : 5px;
    // The room above and below the bubbles inside the list. Main.list-height leaves it
    // out, so keyboard scrolling brings a whole bubble into view.
    property <length> list-top: root.pad-top + (root.big ? 3px : 4px);
    property <length> list-bottom: 2px;
    if Main.query != "": Scroller {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        VerticalLayout {
            alignment: start;
            padding-top: root.pad-top + 2px;
            padding-left: root.big ? 10px : 7px;
            padding-right: root.big ? 14px : 10px;
            spacing: 2px;
            if Main.hits.length == 0: Text {
                text: "NO MATCHES";
                color: Comic.sub;
                font-family: "Bangers";
                font-size: 20px;
                letter-spacing: 1.5px;
                horizontal-alignment: center;
            }
            for h[i] in Main.hits: Hit {
                hit: h;
                big: root.big;
                show-project: Main.search-all;
                clicked => { Main.open-hit(i); root.go(1); }
            }
        }
    }
    if Main.query == "": Scroller {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        content-y <=> Main.list-y;
        property <int> count: Main.clips.length;
        init => { Main.list-height = self.visible-height - root.list-top - root.list-bottom; Main.clamp-list(); }
        changed visible-height => { Main.list-height = self.visible-height - root.list-top - root.list-bottom; Main.clamp-list(); }
        changed count => { Main.clamp-list(); }
        VerticalLayout {
            alignment: start;
            padding-top: root.list-top;
            padding-bottom: root.list-bottom;
            padding-left: root.big ? 10px : 6px;
            padding-right: root.big ? 12px : 9px;
            if Main.clips.length == 0: Text {
                text: "NO CLIPS YET";
                color: Comic.sub;
                font-family: "Bangers";
                font-size: 22px;
                letter-spacing: 1.5px;
                horizontal-alignment: center;
            }
            for clip[i] in Main.clips: Row {
                index: i;
                item: clip;
                big: root.big;
                window-h: root.window-h;
                go(p) => { root.go(p); }
                ask-rename(n) => { root.ask-rename(n); }
                ask-delete(n) => { root.ask-delete(n); }
                refocus => { root.refocus(); }
            }
        }
    }
    if root.big: Tag { x: 0; y: 0; text: "THE CLIPS SO FAR"; }
    // The search bubble's thoughts, rising from this panel's top.
    Rectangle {
        x: root.thought-x + 14px;
        y: root.big ? -13px : -12px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
        border-width: 2.2px;
        border-color: Comic.ink;
    }
    Rectangle {
        x: root.thought-x + 7px;
        y: root.big ? -2px : -2px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: #ffffff;
        border-width: 2px;
        border-color: Comic.ink;
    }
}

// Now showing, a yellow halftone strip: the play button, the clip's name in a caption,
// the progress bar (a click jumps there) and the time.
component Player inherits Box {
    in property <bool> big;
    callback refocus();
    property <int> shown: Main.active-clip >= 0 && Main.active-clip < Main.clips.length ? Main.active-clip
        : Main.selected >= 0 && Main.selected < Main.clips.length ? Main.selected : -1;
    property <bool> is-active: self.shown >= 0 && self.shown == Main.active-clip;
    property <float> at: root.is-active ? clamp(Main.play-fraction, 0, 1) : 0;
    line: 3px;
    dots: 1;
    face: Comic.yellow;
    vertical-stretch: 0;
    height: root.big ? 52px : 50px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            PlayDot {
                width: root.big ? 30px : 26px;
                height: root.big ? 30px : 26px;
                face: Comic.yellow;
                enabled: root.shown >= 0;
                pause: root.is-active && Main.playing;
                label: root.is-active && Main.playing ? "Pause" : "Play";
                tip: root.is-active && Main.playing ? "Pause" : "Play";
                clicked => { Main.play-clip(root.shown); root.refocus(); }
            }
        }
        VerticalLayout {
            alignment: center;
            max-width: root.big ? 300px : max(110px, root.width * 0.36);
            Rectangle {
                height: root.big ? 34px : 32px;
                background: #ffffff;
                border-width: 2.2px;
                border-color: Comic.ink;
                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    Text {
                        text: "NOW SHOWING";
                        color: Comic.red;
                        font-family: "Bangers";
                        font-size: 10.5px;
                        letter-spacing: 1px;
                        height: 11px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.shown >= 0 ? Main.clips[root.shown].name : "Nothing playing";
                        color: Comic.ink;
                        font-family: "Comic Neue";
                        font-weight: 700;
                        font-size: 13px;
                        height: 16px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 40px;
            Rectangle {
                height: 14px;
                background: #ffffff;
                Dots {
                    x: 2.5px;
                    y: 2.5px;
                    width: parent.width - 5px;
                    height: parent.height - 5px;
                    kind: 2;
                }
                Rectangle {
                    x: 2.5px;
                    y: 2.5px;
                    width: (parent.width - 5px) * root.at;
                    height: parent.height - 5px;
                    background: Comic.red;
                }
                Rectangle {
                    border-width: 2.5px;
                    border-color: Comic.ink;
                }
                // Click to jump; taller than the bar so it is easy to hit.
                TouchArea {
                    y: -8px;
                    height: parent.height + 16px;
                    enabled: root.shown >= 0;
                    mouse-cursor: pointer;
                    clicked => {
                        Main.selected = root.shown;
                        Main.seek-fraction(self.mouse-x / self.width);
                        root.refocus();
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: time.preferred-width + 16px;
                height: 22px;
                background: #ffffff;
                border-width: 2.2px;
                border-color: Comic.ink;
                time := Text {
                    y: 1px;
                    height: parent.height - 1px;
                    text: root.shown < 0 ? "--:-- / --:--"
                        : (root.is-active ? Main.play-position : "0:00") + " / " + Main.clips[root.shown].duration;
                    color: Comic.ink;
                    font-family: "Bangers";
                    font-size: 15px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// An export from the clip menu or the project menu: what it is, how far along, and a
// check when done. It takes its own room above the player.
component ExportStrip inherits Box {
    line: 2.5px;
    face: Comic.paper2;
    height: 30px;
    vertical-stretch: 0;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        if Main.export-state == 2: Text {
            text: "DONE!";
            color: Comic.red;
            font-family: "Bangers";
            font-size: 14px;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
        Text {
            text: (Main.export-state == 2 ? "Exported " : "Exporting ") + Main.export-name;
            color: Comic.ink;
            font-family: "Comic Neue";
            font-weight: 700;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if Main.export-state == 1: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 120px;
                height: 12px;
                background: #ffffff;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(Main.export-progress, 0, 1);
                    background: Comic.red;
                    animate width { duration: 150ms; }
                }
                Rectangle { border-width: 2px; border-color: Comic.ink; }
            }
        }
        if Main.export-state == 1: Text {
            text: round(Main.export-progress * 100) + "%";
            color: Comic.ink;
            font-family: "Bangers";
            font-size: 14px;
            letter-spacing: 1px;
            vertical-alignment: center;
            width: 36px;
            horizontal-alignment: right;
        }
    }
}

// The main page. Portrait: the masthead, then one panel per job: the recorder, the
// toolbar, the clips and now showing. Wide: the splash panel recorder on the left,
// the toolbar and the clips on the right, now showing across the bottom.
export component MainPage inherits VerticalLayout {
    // The window's size classes, as AppWindow works them out.
    in property <bool> narrow;
    in property <bool> wide;
    in property <bool> tall;
    // Opens page p (see AppWindow.page).
    callback go(int);
    // The rename and delete questions for clip i.
    callback ask-rename(int);
    callback ask-delete(int);
    // Gives the keyboard back to the window's shortcuts.
    callback refocus();

    property <length> pitch: root.wide ? 45px : 34px;
    init => { Main.row-h = root.pitch; }
    changed pitch => { Main.row-h = root.pitch; Main.clamp-list(); }

    Title { big: root.wide; go(p) => { root.go(p); } }

    if !root.wide: VerticalLayout {
        vertical-stretch: 1;
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 7px;
        padding-bottom: 9px;
        spacing: 7px;
        RecFront { tall: root.tall; }
        bar := Toolbar {
            go(p) => { root.go(p); }
            refocus => { root.refocus(); }
        }
        Clips {
            window-h: root.height;
            thought-x: bar.search-x;
            go(p) => { root.go(p); }
            ask-rename(n) => { root.ask-rename(n); }
            ask-delete(n) => { root.ask-delete(n); }
            refocus => { root.refocus(); }
        }
        if Main.export-state != 0: ExportStrip { }
        Player { refocus => { root.refocus(); } }
    }
    if root.wide: VerticalLayout {
        vertical-stretch: 1;
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 9px;
        padding-bottom: 11px;
        spacing: 9px;
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 9px;
            RecSide { width: (root.width - 31px) * 0.4; }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 9px;
                wbar := Toolbar {
                    big: true;
                    go(p) => { root.go(p); }
                    refocus => { root.refocus(); }
                }
                Clips {
                    big: true;
                    window-h: root.height;
                    thought-x: wbar.search-x;
                    go(p) => { root.go(p); }
                    ask-rename(n) => { root.ask-rename(n); }
                    ask-delete(n) => { root.ask-delete(n); }
                    refocus => { root.refocus(); }
                }
            }
        }
        if Main.export-state != 0: ExportStrip { }
        Player { big: true; refocus => { root.refocus(); } }
    }

    // Messages float just above now showing in a caption box, so nothing moves when
    // they come and go.
    Rectangle {
        height: 0;
        if Main.status != "": Caption {
            x: (parent.width - self.width) / 2;
            y: -(root.wide ? 63px : 59px) - self.height - 8px;
            width: min(msg.preferred-width + 24px, parent.width - 32px);
            height: 28px;
            msg := Text {
                text: Main.status;
                color: Comic.ink;
                font-family: "Comic Neue";
                font-weight: 700;
                font-size: 12.5px;
                overflow: elide;
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}
