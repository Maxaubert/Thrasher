// The Answering Machine main page: a beige 1980s answering machine on the hall table
// (docs/mockups/device-themes/dv-answer.html). The recorder is the smoked display (the
// clip count and the timer as red seven segment figures), the micro cassette and the
// LED level meter, with a big red REC key; Import, Ask and the widget are rubber keys;
// the clips are a numbered message log on paper, and the footer is the PLAY key with
// the tape slider. Portrait windows stack the machine above the log; wide ones put the
// machine on the left and move LOAD, ASK and MINI beside REC.
//
// Fixed art is PNGs in dv-answer/ (1x and 2x), cut from tools/skin-art/dv-answer.html
// with headless Edge. A part of variable width is three pieces (`Slice3`): its two ends
// and a 2px column stretched between them. The figures are the "Memo Segments" font,
// drawn from the mockup's segment shapes (tools/skin-art/dv-answer-fonts.py). The reels
// turn and the NEW lamp blinks on the Fx clock, which runs only while recording.

import { Theme, Fx, Main, Tips, Icon, ProjectMenu, TextField, Scroller, ClipMenu, WaveSeek, ClipRow, SearchHit } from "../common.slint";

// The machine's colours, from the mockup.
global Am {
    out property <color> print: #5b4f3d;
    out property <color> print-soft: #86795f;
    out property <color> logo: #6e624d;
    out property <color> edge: #a89b7f;
    out property <color> paper: #efe8d8;
    out property <color> paper-line: #d6cab0;
    out property <color> smoke: #1b1311;
    out property <color> led: #ff4630;
    // The unlit segments: the mockup's rgba(255,70,48,.09) on the smoked display.
    out property <color> led-dim: #ff46301a;
    out property <color> rec: #cf3c28;
    out property <color> ink: #2f271e;
    out property <color> ink2: #3c3227;
    out property <color> key-ink: #ece4d8;
    out property <color> rec-ink: #fff3ec;
    out property <color> disp-ink: #d9b9ab;
    out property <color> lab: #9f7f72;
    out property <color> green: #7fd15a;
    out property <color> amber: #ffb22e;
    out property <color> bar-off: #3a2a24;
    out property <color> wave: #8b7c63;
    out property <brush> body: @linear-gradient(180deg, #e8dfcb 0%, #d9cfb9 30%, #bfb399 100%);
    out property <brush> foot: @linear-gradient(180deg, #cfc4ac 0%, #bcb096 100%);
}

// A piece of art, the 2x cut when the display is dense.
component Art inherits Image {
    in property <image> lo;
    in property <image> hi;
    source: 1phx < 0.7px ? root.hi : root.lo;
    image-fit: fill;
}

// A part of variable width: its left and right ends and a thin middle column stretched
// between them. The pieces carry `pad` of shadow around the part on every side; `cap`
// is the width of an end piece.
component Slice3 inherits Rectangle {
    in property <image> l;
    in property <image> m;
    in property <image> r;
    in property <image> l2;
    in property <image> m2;
    in property <image> r2;
    in property <length> pad;
    in property <length> cap;
    property <bool> hi: 1phx < 0.7px;
    Image {
        x: -root.pad;
        y: -root.pad;
        width: root.cap;
        height: root.height + 2 * root.pad;
        source: root.hi ? root.l2 : root.l;
        image-fit: fill;
    }
    Image {
        x: root.cap - root.pad;
        y: -root.pad;
        width: max(0px, root.width + 2 * root.pad - 2 * root.cap);
        height: root.height + 2 * root.pad;
        source: root.hi ? root.m2 : root.m;
        image-fit: fill;
    }
    Image {
        x: root.width + root.pad - root.cap;
        y: -root.pad;
        width: root.cap;
        height: root.height + 2 * root.pad;
        source: root.hi ? root.r2 : root.r;
        image-fit: fill;
    }
}

// Small caps printed on the plastic.
component Lab inherits Text {
    color: Am.print;
    font-family: "Barlow Condensed";
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.8px;
    vertical-alignment: center;
    accessible-role: none;
}

// Red seven segment figures over their unlit segments. `ghost` is the same layout as
// all 8s (the caller knows the format); both are right-aligned so they line up.
component Seg inherits Rectangle {
    in property <string> text;
    in property <string> ghost;
    in property <length> size;
    in property <color> lit: Am.led;
    width: shadow.preferred-width;
    height: root.size;
    shadow := Text {
        x: root.width - self.width;
        text: root.ghost;
        color: Am.led-dim;
        font-family: "Memo Segments";
        font-size: root.size;
        accessible-role: none;
    }
    Text {
        x: root.width - self.width;
        text: root.text;
        color: root.lit;
        font-family: "Memo Segments";
        font-size: root.size;
        accessible-role: none;
    }
}

// A rubber nub in the title bar: Settings, minimise and close.
component Nub inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked;
    width: 24px;
    height: 22px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        y: t.pressed ? 1px : 0;
        Art {
            x: -6px;
            y: -6px;
            width: 36px;
            height: 34px;
            lo: @image-url("dv-answer/nub.png");
            hi: @image-url("dv-answer/nub@2x.png");
        }
        Rectangle {
            visible: t.has-hover;
            border-radius: 6px;
            background: #ffffff1a;
        }
        Icon {
            name: root.icon;
            tint: #e7dfd2;
            width: 13px;
            height: 13px;
        }
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.label, self.absolute-position, self.width, self.height); }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

// The title bar: the brand embossed in the plastic, the model badge, Settings ("SET"),
// minimise and close.
component Title inherits Rectangle {
    callback go(int);
    height: 34px;
    Rectangle { y: parent.height - 1px; height: 1px; background: Am.edge; }
    Rectangle { y: parent.height; height: 1px; background: #ffffff80; }
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            width: logo.preferred-width;
            Text {
                y: logo.y + 1px;
                text: logo.text;
                color: #ffffffb3;
                font-family: logo.font-family;
                font-size: logo.font-size;
                font-weight: logo.font-weight;
                letter-spacing: logo.letter-spacing;
                vertical-alignment: center;
                height: parent.height;
                accessible-role: none;
            }
            Text {
                y: logo.y - 1px;
                text: logo.text;
                color: #0000002e;
                font-family: logo.font-family;
                font-size: logo.font-size;
                font-weight: logo.font-weight;
                letter-spacing: logo.letter-spacing;
                vertical-alignment: center;
                height: parent.height;
                accessible-role: none;
            }
            logo := Text {
                text: "THRASHER";
                color: Am.logo;
                font-family: "Barlow Condensed";
                font-size: 15px;
                font-weight: 700;
                letter-spacing: 5.1px;
                vertical-alignment: center;
                height: parent.height;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: model.preferred-width + 10px;
                height: 14px;
                border-radius: 3px;
                border-width: 1px;
                border-color: Am.print-soft;
                model := Text {
                    x: 5px;
                    y: 1px;
                    height: parent.height - 1px;
                    text: "MEMO TX8";
                    color: Am.print-soft;
                    font-family: "Barlow Condensed";
                    font-size: 9.5px;
                    font-weight: 600;
                    letter-spacing: 1.9px;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        Lab {
            text: "SET";
            color: Am.print-soft;
            font-size: 8.5px;
            letter-spacing: 1.36px;
        }
        VerticalLayout {
            alignment: center;
            Nub { icon: "cog"; label: "Settings"; clicked => { root.go(3); } }
        }
        VerticalLayout {
            alignment: center;
            Nub { icon: "minimize"; label: "Minimize"; clicked => { Main.minimize-window(); } }
        }
        VerticalLayout {
            alignment: center;
            Nub { icon: "close"; label: "Close"; clicked => { Main.close-window(); } }
        }
    }
}

// A lamp: the NEW light (red) or the status dot (green ready, red recording, amber
// paused), with its glow.
component Lamp inherits Rectangle {
    // 0 the red LED, 1 the status dot.
    in property <int> kind;
    in property <bool> on: true;
    width: root.kind == 0 ? 8px : 7px;
    height: self.width;
    Art {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        lo: root.kind == 0 ? (root.on ? @image-url("dv-answer/led-on.png") : @image-url("dv-answer/led-off.png"))
            : !Main.recording ? @image-url("dv-answer/dot-ready.png") : Main.paused ? @image-url("dv-answer/dot-pause.png") : @image-url("dv-answer/dot-rec.png");
        hi: root.kind == 0 ? (root.on ? @image-url("dv-answer/led-on@2x.png") : @image-url("dv-answer/led-off@2x.png"))
            : !Main.recording ? @image-url("dv-answer/dot-ready@2x.png") : Main.paused ? @image-url("dv-answer/dot-pause@2x.png") : @image-url("dv-answer/dot-rec@2x.png");
    }
}

// The smoked display: the clip count with the NEW lamp, then the state, the timer and
// the microphone.
component Display inherits Rectangle {
    in property <bool> big;
    property <string> count: (Main.clips.length < 10 ? "0" : "") + Main.clips.length;
    property <string> clock: Main.elapsed + Main.elapsed-tenth;
    // The NEW lamp: lit while there are messages, blinking while one is recorded.
    property <bool> new-on: Main.recording && !Main.paused ? Math.mod(floor(Fx.t * 0.9), 2) == 0 : Main.clips.length > 0;
    accessible-role: AccessibleRole.text;
    accessible-label: (Main.recording ? (Main.paused ? "Paused " : "Recording ") : "Ready ") + root.clock;
    Slice3 {
        pad: 4px;
        cap: 14px;
        l: root.big ? @image-url("dv-answer/disp-w-l.png") : @image-url("dv-answer/disp-p-l.png");
        m: root.big ? @image-url("dv-answer/disp-w-m.png") : @image-url("dv-answer/disp-p-m.png");
        r: root.big ? @image-url("dv-answer/disp-w-r.png") : @image-url("dv-answer/disp-p-r.png");
        l2: root.big ? @image-url("dv-answer/disp-w-l@2x.png") : @image-url("dv-answer/disp-p-l@2x.png");
        m2: root.big ? @image-url("dv-answer/disp-w-m@2x.png") : @image-url("dv-answer/disp-p-m@2x.png");
        r2: root.big ? @image-url("dv-answer/disp-w-r@2x.png") : @image-url("dv-answer/disp-p-r@2x.png");
    }
    HorizontalLayout {
        padding-left: root.big ? 16px : 12px;
        padding-right: root.big ? 16px : 12px;
        padding-top: root.big ? 12px : 9px;
        padding-bottom: root.big ? 12px : 9px;
        spacing: 0;
        VerticalLayout {
            alignment: space-between;
            Lab {
                text: "MESSAGES";
                color: Am.lab;
                font-size: 9px;
            }
            HorizontalLayout {
                alignment: start;
                Seg {
                    text: root.count;
                    ghost: root.count.character-count > 2 ? "888" : "88";
                    size: root.big ? 62px : 40px;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Lamp { on: root.new-on; }
                }
                Lab {
                    text: "NEW";
                    color: Am.lab;
                }
            }
        }
        Rectangle { width: root.big ? 18px : 12px; }
        Rectangle { width: 1px; background: #ffffff12; }
        Rectangle { width: root.big ? 18px : 12px; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: space-between;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Lamp { kind: 1; }
                }
                Text {
                    text: Main.recording ? (Main.paused ? "PAUSED" : "RECORDING") : "READY";
                    color: #e7c9bd;
                    font-family: "Barlow Condensed";
                    font-size: root.big ? 13px : 12px;
                    font-weight: 700;
                    letter-spacing: root.big ? 3.12px : 2.88px;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
            HorizontalLayout {
                alignment: start;
                Seg {
                    text: root.clock;
                    ghost: Main.elapsed.character-count > 5 ? "8:88:88.8" : "88:88.8";
                    size: root.big ? 34px : 22px;
                }
            }
            Text {
                text: Main.device-label;
                color: Am.disp-ink;
                font-family: "Courier Prime";
                font-size: root.big ? 13px : 11.5px;
                overflow: elide;
                accessible-role: none;
            }
        }
    }
}

// A key, with its face shifted down while it is held. `kind`: 0 a toolbar key (34x28),
// 1 the portrait REC key (92x76), 2 a wide rubber key and 3 the wide REC key (any width,
// 62 high), 4 and 5 the PLAY key (56 and 70 wide, 42 high).
component Key inherits Rectangle {
    in property <int> kind;
    in property <string> icon;
    in property <length> icon-size: 15px;
    in property <string> text;
    in property <string> label;
    in property <string> tip: root.label;
    in property <bool> enabled: true;
    // Latched down (Pause while paused).
    in property <bool> lit;
    callback clicked;
    property <bool> red: root.kind == 1 || root.kind == 3;
    property <bool> down: (t.pressed && root.enabled) || root.lit;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    face := Rectangle {
        y: root.down ? 1.5px : 0;
        opacity: root.enabled ? 1 : 0.7;
        // The fixed size keys are one picture, the wide ones three pieces.
        Art {
            visible: root.kind != 2 && root.kind != 3;
            x: -14px;
            y: -14px;
            width: parent.width + 28px;
            height: parent.height + 28px;
            lo: root.kind == 0 ? @image-url("dv-answer/tk.png") : root.kind == 1 ? @image-url("dv-answer/rec-p.png")
                : root.kind == 4 ? @image-url("dv-answer/play-p.png") : @image-url("dv-answer/play-w.png");
            hi: root.kind == 0 ? @image-url("dv-answer/tk@2x.png") : root.kind == 1 ? @image-url("dv-answer/rec-p@2x.png")
                : root.kind == 4 ? @image-url("dv-answer/play-p@2x.png") : @image-url("dv-answer/play-w@2x.png");
        }
        Slice3 {
            visible: root.kind == 2 || root.kind == 3;
            pad: 14px;
            cap: 24px;
            l: root.kind == 3 ? @image-url("dv-answer/rec-w-l.png") : @image-url("dv-answer/key-w-l.png");
            m: root.kind == 3 ? @image-url("dv-answer/rec-w-m.png") : @image-url("dv-answer/key-w-m.png");
            r: root.kind == 3 ? @image-url("dv-answer/rec-w-r.png") : @image-url("dv-answer/key-w-r.png");
            l2: root.kind == 3 ? @image-url("dv-answer/rec-w-l@2x.png") : @image-url("dv-answer/key-w-l@2x.png");
            m2: root.kind == 3 ? @image-url("dv-answer/rec-w-m@2x.png") : @image-url("dv-answer/key-w-m@2x.png");
            r2: root.kind == 3 ? @image-url("dv-answer/rec-w-r@2x.png") : @image-url("dv-answer/key-w-r@2x.png");
        }
        Rectangle {
            visible: root.lit;
            border-radius: 9px;
            background: #00000033;
        }
        Rectangle {
            visible: t.has-hover && root.enabled && !root.down;
            border-radius: 9px;
            background: #ffffff14;
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                Icon {
                    name: root.icon;
                    tint: root.lit ? Am.amber : root.red ? Am.rec-ink : Am.key-ink;
                    width: root.icon-size;
                    height: root.icon-size;
                }
            }
            if root.text != "": Text {
                text: root.text;
                color: root.lit ? Am.amber : root.red ? Am.rec-ink : Am.key-ink;
                font-family: "Barlow Condensed";
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 2px;
                horizontal-alignment: center;
                accessible-role: none;
            }
        }
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

// The word printed under a key.
component Under inherits Text {
    color: Am.print;
    font-family: "Barlow Condensed";
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 1.53px;
    horizontal-alignment: center;
    accessible-role: none;
}

// REC, which stops and saves while recording.
component RecKey inherits Key {
    callback refocus();
    icon: Main.recording ? "stop" : "mic";
    text: Main.recording ? "STOP" : "REC";
    label: Main.recording ? "Stop and save" : "Record";
    tip: Main.recording ? "Stop" : "Record";
    clicked => { Main.toggle-record(); root.refocus(); }
}

// LOAD (Import), or Pause and Resume while recording, when Import is not offered.
component LoadKey inherits Key {
    callback refocus();
    icon: !Main.recording ? "import" : Main.paused ? "play" : "pause";
    label: !Main.recording ? "Import audio or video" : Main.paused ? "Resume" : "Pause";
    tip: !Main.recording ? "Import" : root.label;
    lit: Main.recording && Main.paused;
    clicked => {
        if (Main.recording) {
            Main.toggle-pause();
            root.refocus();
        } else {
            Main.import-files();
        }
    }
}

// The LED level meter in its well: green, amber, then red, lit up to the level while
// recording (the scale runs from -40 dB to 0).
component Meter inherits Rectangle {
    in property <bool> big;
    // The room it may take; a wider portrait window gets more bars (10 at the mockup's
    // width), and the well fits them.
    in property <length> room: 120px;
    property <int> n: root.big ? 12 : clamp(floor((root.room - 13px) / 10px), 10, 20);
    width: root.big ? self.room : 13px + root.n * 10px;
    property <length> bw: root.big ? 8px : 7px;
    property <length> bh: root.big ? 48px : 26px;
    property <float> level: Main.recording && !Main.paused && Main.live.length > 0 ? Main.live[Main.live.length - 1] : 0;
    property <int> on: round(clamp((root.level * 60 - 20) / 40, 0, 1) * root.n);
    height: root.bh + 14px;
    Slice3 {
        pad: 3px;
        cap: 10px;
        l: root.big ? @image-url("dv-answer/mw-w-l.png") : @image-url("dv-answer/mw-p-l.png");
        m: root.big ? @image-url("dv-answer/mw-w-m.png") : @image-url("dv-answer/mw-p-m.png");
        r: root.big ? @image-url("dv-answer/mw-w-r.png") : @image-url("dv-answer/mw-p-r.png");
        l2: root.big ? @image-url("dv-answer/mw-w-l@2x.png") : @image-url("dv-answer/mw-p-l@2x.png");
        m2: root.big ? @image-url("dv-answer/mw-w-m@2x.png") : @image-url("dv-answer/mw-p-m@2x.png");
        r2: root.big ? @image-url("dv-answer/mw-w-r@2x.png") : @image-url("dv-answer/mw-p-r@2x.png");
    }
    for i in root.n: bar := Rectangle {
        property <color> c: i < root.n * 0.6 ? Am.green : i < root.n * 0.85 ? Am.amber : Am.led;
        property <bool> lit: i < root.on;
        x: 8px + i * (root.bw + 3px);
        y: 7px;
        width: root.bw;
        height: root.bh;
        // The glow around a lit bar.
        Rectangle {
            visible: bar.lit;
            x: -2px;
            y: -2px;
            width: parent.width + 4px;
            height: parent.height + 4px;
            border-radius: 3px;
            background: bar.c.with-alpha(0.3);
        }
        Rectangle {
            border-radius: 1.5px;
            background: bar.lit ? bar.c : Am.bar-off;
        }
    }
}

// The micro cassette window; its reels turn while recording, the full one on the left
// slower than the take-up reel. 8 frames turn a reel through 120 degrees, its repeat.
component Micro inherits Rectangle {
    in property <bool> big;
    property <bool> turning: Main.recording && !Main.paused;
    property <bool> hi: 1phx < 0.7px;
    property <int> left-frame: root.turning ? Math.mod(floor(Fx.t * 4), 8) : 0;
    property <int> right-frame: root.turning ? Math.mod(floor(Fx.t * 6), 8) : 3;
    property <length> d: root.big ? 22px : 16px;
    property <int> px: (root.big ? 22 : 16) * (root.hi ? 2 : 1);
    // Where the reels' middles sit, from the mockup's layout.
    property <length> lx: root.big ? 75.2px : 50.84px;
    property <length> rx: root.big ? 132.8px : 91.16px;
    property <length> cy: root.big ? 70.08px : 52.64px;
    width: root.big ? 208px : 142px;
    height: root.big ? 104px : 78px;
    accessible-role: none;
    Art {
        x: -3px;
        y: -3px;
        width: root.big ? 214px : 148px;
        height: root.big ? 110px : 84px;
        lo: root.big ? @image-url("dv-answer/mc-w.png") : @image-url("dv-answer/mc-p.png");
        hi: root.big ? @image-url("dv-answer/mc-w@2x.png") : @image-url("dv-answer/mc-p@2x.png");
    }
    Image {
        x: root.lx - root.d / 2;
        y: root.cy - root.d / 2;
        width: root.d;
        height: root.d;
        source: root.big ? (root.hi ? @image-url("dv-answer/reel-w@2x.png") : @image-url("dv-answer/reel-w.png"))
            : (root.hi ? @image-url("dv-answer/reel-p@2x.png") : @image-url("dv-answer/reel-p.png"));
        source-clip-x: root.left-frame * root.px;
        source-clip-y: 0;
        source-clip-width: root.px;
        source-clip-height: root.px;
        image-fit: fill;
    }
    Image {
        x: root.rx - root.d / 2;
        y: root.cy - root.d / 2;
        width: root.d;
        height: root.d;
        source: root.big ? (root.hi ? @image-url("dv-answer/reel-w@2x.png") : @image-url("dv-answer/reel-w.png"))
            : (root.hi ? @image-url("dv-answer/reel-p@2x.png") : @image-url("dv-answer/reel-p.png"));
        source-clip-x: root.right-frame * root.px;
        source-clip-y: 0;
        source-clip-width: root.px;
        source-clip-height: root.px;
        image-fit: fill;
    }
}

// The speaker grille of a wide window, built up from a short cut (256x39: 1px of shadow,
// a well of 37 rows, 1px of shadow) so it costs little at any height: the top 14 rows
// (the rounded corners and the shade), then one band of 7 rows (one row of dots) as
// often as it fits, then the bottom 9 rows. The dots stay in step, since every piece
// starts on a multiple of 7. Portrait windows use the small fixed one.
component Grille inherits Rectangle {
    property <bool> hi: 1phx < 0.7px;
    property <int> k: max(0, floor((root.height - 23px) / 7px));
    property <int> s: root.hi ? 2 : 1;
    Image {
        x: -1px;
        y: -1px;
        width: 256px;
        height: 15px;
        source: root.hi ? @image-url("dv-answer/grille-w@2x.png") : @image-url("dv-answer/grille-w.png");
        source-clip-x: 0;
        source-clip-y: 0;
        source-clip-width: 256 * root.s;
        source-clip-height: 15 * root.s;
        image-fit: fill;
    }
    for i in root.k: Image {
        x: -1px;
        y: 14px + i * 7px;
        width: 256px;
        height: 7px;
        source: root.hi ? @image-url("dv-answer/grille-w@2x.png") : @image-url("dv-answer/grille-w.png");
        source-clip-x: 0;
        source-clip-y: 15 * root.s;
        source-clip-width: 256 * root.s;
        source-clip-height: 7 * root.s;
        image-fit: fill;
    }
    Image {
        x: -1px;
        y: 14px + root.k * 7px;
        width: 256px;
        height: 10px;
        source: root.hi ? @image-url("dv-answer/grille-w@2x.png") : @image-url("dv-answer/grille-w.png");
        source-clip-x: 0;
        source-clip-y: 29 * root.s;
        source-clip-width: 256 * root.s;
        source-clip-height: 10 * root.s;
        image-fit: fill;
    }
}

// The machine in a portrait window: the display and REC on top, the micro cassette, the
// level meter and the speaker below.
component MachineFront inherits Rectangle {
    callback refocus();
    height: 206px;
    Display {
        x: 14px;
        y: 14px;
        width: parent.width - 28px - 92px - 12px;
        height: 92px;
    }
    VerticalLayout {
        x: parent.width - 14px - 92px;
        y: 14px;
        width: 92px;
        spacing: 4px;
        RecKey {
            kind: 1;
            width: 92px;
            height: 76px;
            icon-size: 24px;
            refocus => { root.refocus(); }
        }
        Under { text: Main.recording ? "SAVE" : "RECORD"; }
    }
    Micro {
        x: 14px;
        y: 14px + 92px + 12px;
    }
    level := VerticalLayout {
        x: 14px + 142px + 12px;
        y: 14px + 92px + 12px;
        width: parent.width - 28px - 92px - 12px - 142px - 12px;
        height: 78px;
        alignment: start;
        spacing: 5px;
        Lab { text: "LEVEL"; }
        HorizontalLayout {
            alignment: start;
            Meter { room: level.width; }
        }
        Lab {
            text: "IN 1";
            color: Am.print-soft;
            font-size: 8px;
        }
    }
    Art {
        x: parent.width - 14px - 92px - 1px;
        y: 14px + 92px + 12px - 1px;
        width: 94px;
        height: 80px;
        lo: @image-url("dv-answer/grille-p.png");
        hi: @image-url("dv-answer/grille-p@2x.png");
    }
}

// The machine in a wide window, on the left: the display, the cassette and the meter,
// the key bed (REC, LOAD, ASK, MINI) and the speaker. A short window takes the speaker
// away first, then the gaps.
component MachineSide inherits Rectangle {
    callback go(int);
    callback refocus();
    // The room under the padding for the display (124), the middle (104) and the keys (96).
    property <length> pad: root.height >= 420px ? 18px : 12px;
    property <length> spare: root.height - 2 * root.pad - 324px;
    property <bool> speaker: root.spare - 48px >= 40px;
    property <length> gap: root.speaker ? 16px : clamp(root.spare / 3, 4px, 16px);
    property <length> keys-y: root.pad + 124px + root.gap + 104px + root.gap;
    width: 404px;
    Rectangle { x: parent.width - 1px; width: 1px; background: Am.edge; }
    Rectangle { x: parent.width; width: 1px; background: #ffffff80; }
    Display {
        big: true;
        x: 20px;
        y: root.pad;
        width: parent.width - 40px;
        height: 124px;
    }
    HorizontalLayout {
        x: 20px;
        y: root.pad + 124px + root.gap;
        width: parent.width - 40px;
        height: 104px;
        spacing: 14px;
        Micro { big: true; }
        VerticalLayout {
            alignment: space-between;
            Lab { text: "INPUT LEVEL"; }
            Meter { big: true; room: 142px; }
            Rectangle {
                height: 11px;
                Lab {
                    x: 0;
                    text: "-40";
                    color: Am.print-soft;
                }
                // -12 dB sits 70% along the scale.
                Lab {
                    x: (parent.width - 16px) * 0.7 + 8px - self.width / 2;
                    text: "-12";
                    color: Am.print-soft;
                }
                Lab {
                    x: parent.width - self.width;
                    text: "0";
                    color: Am.rec;
                }
            }
        }
    }
    // The key bed.
    Rectangle {
        x: 20px;
        y: root.keys-y;
        width: 364px;
        height: 96px;
        Art {
            x: -1px;
            y: -1px;
            width: 366px;
            height: 98px;
            lo: @image-url("dv-answer/keys.png");
            hi: @image-url("dv-answer/keys@2x.png");
        }
        HorizontalLayout {
            padding: 8px;
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1.6;
                spacing: 4px;
                alignment: start;
                RecKey {
                    kind: 3;
                    height: 62px;
                    icon-size: 22px;
                    refocus => { root.refocus(); }
                }
                Under { text: Main.recording ? "SAVE" : "RECORD"; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                alignment: start;
                LoadKey {
                    kind: 2;
                    height: 62px;
                    icon-size: 17px;
                    text: !Main.recording ? "LOAD" : Main.paused ? "RESUME" : "PAUSE";
                    refocus => { root.refocus(); }
                }
                Under { text: !Main.recording ? "IMPORT" : Main.paused ? "RESUME" : "PAUSE"; }
            }
            if Main.can-ai: VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                alignment: start;
                Key {
                    kind: 2;
                    height: 62px;
                    icon: "message";
                    icon-size: 17px;
                    text: "ASK";
                    label: "Ask your clips";
                    tip: "Ask";
                    clicked => { root.go(6); }
                }
                Under { text: "CHAT"; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                alignment: start;
                Key {
                    kind: 2;
                    height: 62px;
                    icon: "pip";
                    icon-size: 17px;
                    text: "MINI";
                    label: "Small widget";
                    tip: "Widget";
                    clicked => { Main.compact-changed(true); }
                }
                Under { text: "WIDGET"; }
            }
        }
    }
    // The speaker and the printed features.
    if root.speaker: Grille {
        x: 20px;
        y: root.keys-y + 96px + root.gap;
        width: 254px;
        height: root.height - root.pad - self.y;
    }
    if root.speaker: VerticalLayout {
        x: 20px + 254px + 14px;
        y: root.keys-y + 96px + root.gap;
        width: 96px;
        height: root.height - root.pad - self.y - 2px;
        alignment: end;
        spacing: 6px;
        for line in ["AUTO MEMO", "VOICE ACTIVATED", "TONE REMOTE"]: Text {
            height: 12px;
            text: line;
            color: Am.print-soft;
            font-family: "Barlow Condensed";
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 1.6px;
            vertical-alignment: center;
            accessible-role: none;
        }
        Text {
            text: "TX8";
            color: Am.logo;
            font-family: "Barlow Condensed";
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 3.3px;
            accessible-role: none;
        }
    }
}

// The project picker as a mailbox label. ProjectMenu holds what it offers. `most` is
// the most room the name may take (it elides past it).
component Picker inherits Rectangle {
    in property <bool> big;
    in property <length> most: 200px;
    callback refocus();
    property <bool> enabled: !Main.recording;
    width: row.preferred-width;
    height: root.big ? 34px : 30px;
    opacity: root.enabled ? 1 : 0.6;
    accessible-role: combobox;
    accessible-label: "Project";
    accessible-value: Main.project >= 0 && Main.project < Main.projects.length ? Main.projects[Main.project] : "";
    accessible-expandable: true;
    accessible-action-default => { if (root.enabled) { menu.show(); } }
    accessible-action-expand => { if (root.enabled) { menu.show(); } }
    Slice3 {
        pad: 3px;
        cap: 10px;
        l: root.big ? @image-url("dv-answer/pick-w-l.png") : @image-url("dv-answer/pick-p-l.png");
        m: root.big ? @image-url("dv-answer/pick-w-m.png") : @image-url("dv-answer/pick-p-m.png");
        r: root.big ? @image-url("dv-answer/pick-w-r.png") : @image-url("dv-answer/pick-p-r.png");
        l2: root.big ? @image-url("dv-answer/pick-w-l@2x.png") : @image-url("dv-answer/pick-p-l@2x.png");
        m2: root.big ? @image-url("dv-answer/pick-w-m@2x.png") : @image-url("dv-answer/pick-p-m@2x.png");
        r2: root.big ? @image-url("dv-answer/pick-w-r@2x.png") : @image-url("dv-answer/pick-p-r@2x.png");
    }
    if t.has-hover && root.enabled: Rectangle {
        border-radius: 6px;
        background: #ffffff33;
    }
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 9px;
        spacing: 6px;
        Lab {
            text: root.big ? "MAILBOX" : "BOX";
            color: Am.print-soft;
            font-size: 8.5px;
            letter-spacing: 1.7px;
        }
        Text {
            text: Main.project >= 0 && Main.project < Main.projects.length ? Main.projects[Main.project] : "";
            color: #3e3428;
            font-family: "Courier Prime";
            font-size: root.big ? 14px : 13px;
            font-weight: 700;
            vertical-alignment: center;
            max-width: root.most;
            overflow: elide;
        }
        Icon {
            name: "down";
            tint: Am.print;
            width: 11px;
            height: 11px;
            y: (parent.height - self.height) / 2;
        }
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := ProjectMenu {
        width: parent.width;
        height: parent.height;
        projects: Main.projects;
        current: Main.project;
        has-clips: Main.clips.length > 0;
        choose(i) => { Main.choose-project(i); root.refocus(); }
        create => { Main.dialog-text = ""; Main.dialog = 4; }
        rename => { Main.dialog-text = Main.projects[Main.project]; Main.dialog = 5; }
        delete => { Main.delete-project(); root.refocus(); }
        export => { Main.export-project(); root.refocus(); }
    }
}

// The search field, sunk into the plastic.
component Search inherits Rectangle {
    in property <bool> big;
    callback go(int);
    callback refocus();
    height: root.big ? 34px : 30px;
    Slice3 {
        pad: 2px;
        cap: root.big ? 19px : 17px;
        l: root.big ? @image-url("dv-answer/srch-w-l.png") : @image-url("dv-answer/srch-p-l.png");
        m: root.big ? @image-url("dv-answer/srch-w-m.png") : @image-url("dv-answer/srch-p-m.png");
        r: root.big ? @image-url("dv-answer/srch-w-r.png") : @image-url("dv-answer/srch-p-r.png");
        l2: root.big ? @image-url("dv-answer/srch-w-l@2x.png") : @image-url("dv-answer/srch-p-l@2x.png");
        m2: root.big ? @image-url("dv-answer/srch-w-m@2x.png") : @image-url("dv-answer/srch-p-m@2x.png");
        r2: root.big ? @image-url("dv-answer/srch-w-r@2x.png") : @image-url("dv-answer/srch-p-r@2x.png");
    }
    TextField {
        height: parent.height;
        radius: parent.height / 2;
        fill: transparent;
        rest-edge: transparent;
        ink: Am.ink;
        hint: #6c604b;
        font-size: 12.5px;
        family: "Courier Prime";
        side: 10px;
        icon: "search";
        placeholder: "Search";
        label: "Search clips";
        takes-escape: true;
        focus-ticket: Main.search-ticket;
        text <=> Main.query;
        edited(t) => { Main.search(t, Main.search-all); }
        escaped => { Main.query = ""; Main.search("", Main.search-all); root.refocus(); }
        accepted => { if (Main.hits.length > 0) { Main.open-hit(0); root.go(1); } }
    }
}

// While searching with more than one project: search them all instead of this one.
component AllKey inherits Rectangle {
    in property <bool> big;
    width: all-text.preferred-width + 20px;
    height: root.big ? 34px : 30px;
    accessible-role: checkbox;
    accessible-label: "Search all projects";
    accessible-checked: Main.search-all;
    accessible-action-default => { Main.search-all = !Main.search-all; Main.search(Main.query, Main.search-all); }
    Slice3 {
        pad: 3px;
        cap: 10px;
        l: root.big ? @image-url("dv-answer/pick-w-l.png") : @image-url("dv-answer/pick-p-l.png");
        m: root.big ? @image-url("dv-answer/pick-w-m.png") : @image-url("dv-answer/pick-p-m.png");
        r: root.big ? @image-url("dv-answer/pick-w-r.png") : @image-url("dv-answer/pick-p-r.png");
        l2: root.big ? @image-url("dv-answer/pick-w-l@2x.png") : @image-url("dv-answer/pick-p-l@2x.png");
        m2: root.big ? @image-url("dv-answer/pick-w-m@2x.png") : @image-url("dv-answer/pick-p-m@2x.png");
        r2: root.big ? @image-url("dv-answer/pick-w-r@2x.png") : @image-url("dv-answer/pick-p-r@2x.png");
    }
    all-text := Lab {
        x: 10px;
        height: parent.height;
        text: "ALL PROJECTS";
        color: Main.search-all ? Am.rec : Am.print-soft;
        font-size: 9px;
        letter-spacing: 1.62px;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { Main.search-all = !Main.search-all; Main.search(Main.query, Main.search-all); }
    }
}

// The portrait toolbar: the mailbox, the search field and the keys LOAD (Pause while
// recording), ASK and MINI. The mailbox takes at most what the rest leaves (`avail` is
// the toolbar's width, worked out by the page).
component Toolbar inherits HorizontalLayout {
    in property <length> avail;
    callback go(int);
    callback refocus();
    property <length> keys-w: (Main.can-ai ? 3 : 2) * (34px + 8px);
    property <length> all-w: Main.query != "" && Main.projects.length > 1 ? 104px : 0;
    height: 52px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 4px;
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        Picker {
            // The padding, the mailbox around its name, the smallest search field and a gap.
            most: max(40px, root.avail - 24px - 66px - 8px - 90px - root.all-w - root.keys-w);
            refocus => { root.refocus(); }
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        min-width: 90px;
        Search {
            go(p) => { root.go(p); }
            refocus => { root.refocus(); }
        }
    }
    if Main.query != "" && Main.projects.length > 1: VerticalLayout {
        alignment: center;
        AllKey { }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        LoadKey {
            kind: 0;
            width: 34px;
            height: 28px;
            refocus => { root.refocus(); }
        }
        Under { text: !Main.recording ? "LOAD" : Main.paused ? "RESUME" : "PAUSE"; }
    }
    if Main.can-ai: VerticalLayout {
        alignment: center;
        spacing: 4px;
        Key {
            kind: 0;
            width: 34px;
            height: 28px;
            icon: "message";
            label: "Ask your clips";
            tip: "Ask";
            clicked => { root.go(6); }
        }
        Under { text: "ASK"; }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Key {
            kind: 0;
            width: 34px;
            height: 28px;
            icon: "pip";
            label: "Small widget";
            tip: "Widget";
            clicked => { Main.compact-changed(true); }
        }
        Under { text: "MINI"; }
    }
}

// The wide toolbar over the log: the mailbox and the search field.
component WideTools inherits HorizontalLayout {
    in property <length> avail;
    callback go(int);
    callback refocus();
    property <length> all-w: Main.query != "" && Main.projects.length > 1 ? 112px : 0;
    height: 36px;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        Picker {
            big: true;
            most: max(60px, min(260px, root.avail - 86px - 10px - 120px - root.all-w));
            refocus => { root.refocus(); }
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        min-width: 120px;
        Search {
            big: true;
            go(p) => { root.go(p); }
            refocus => { root.refocus(); }
        }
    }
    if Main.query != "" && Main.projects.length > 1: VerticalLayout {
        alignment: center;
        AllKey { big: true; }
    }
}

// A clip's waveform: thin bars, red on the highlighted message; what has played is
// darker.
component Wave inherits Rectangle {
    in property <[float]> values;
    in property <int> n;
    in property <bool> lit;
    in property <float> progress: -1;
    property <length> step: root.width / root.n;
    for i in root.n: Rectangle {
        property <float> v: root.values.length > 0 ? root.values[floor(i * root.values.length / root.n)] : 0.06;
        x: i * root.step + root.step * 0.2;
        width: root.step * 0.6;
        height: max(2px, root.height * (0.15 + 0.85 * self.v));
        y: (root.height - self.height) / 2;
        border-radius: 0.8px;
        background: (i + 0.5) / root.n <= root.progress ? (root.lit ? #8f2414 : Am.print) : root.lit ? Am.rec : Am.wave;
    }
}

// The round play key at the start of a row: red on the highlighted message.
component RowPlay inherits Rectangle {
    in property <bool> big;
    in property <bool> lit;
    in property <bool> playing;
    in property <string> name;
    callback clicked;
    width: root.big ? 30px : 22px;
    height: self.width;
    accessible-role: button;
    accessible-label: (root.playing ? "Pause " : "Play ") + root.name;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        y: t.pressed ? 1px : 0;
        Art {
            x: -6px;
            y: -6px;
            width: root.big ? 42px : 34px;
            height: root.big ? 42px : 34px;
            lo: root.big ? root.lit ? @image-url("dv-answer/pb-l-red.png") : @image-url("dv-answer/pb-l.png") : root.lit ? @image-url("dv-answer/pb-s-red.png") : @image-url("dv-answer/pb-s.png");
            hi: root.big ? root.lit ? @image-url("dv-answer/pb-l-red@2x.png") : @image-url("dv-answer/pb-l@2x.png") : root.lit ? @image-url("dv-answer/pb-s-red@2x.png") : @image-url("dv-answer/pb-s@2x.png");
        }
        Rectangle {
            visible: t.has-hover;
            border-radius: self.width / 2;
            background: #ffffff1f;
        }
        Icon {
            x: (parent.width - self.width) / 2 + (root.playing ? 0 : (root.big ? 1.5px : 1px));
            name: root.playing ? "pause" : "play";
            tint: #efe6da;
            width: root.big ? 11px : 9px;
            height: self.width;
        }
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.playing ? "Pause" : "Play", self.absolute-position, self.width, self.height); }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

// A stamp in the margin: TRANSCRIBED in red, + SYSTEM in the print colour.
component Stamp inherits Rectangle {
    in property <string> text;
    in property <bool> big;
    in property <color> ink: Am.rec;
    width: st.preferred-width + 6px;
    height: root.big ? 12px : 10.5px;
    border-radius: 2px;
    border-width: 1px;
    border-color: root.ink;
    st := Text {
        x: 3px;
        text: root.text;
        color: root.ink;
        font-family: "Barlow Condensed";
        font-size: root.big ? 9px : 8px;
        font-weight: 600;
        letter-spacing: root.big ? 1.08px : 0.96px;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// One message in the log: play, its number (lit on the display for the highlighted
// one), the name with when it was made, whether it is transcribed and whether it has
// the computer's sound, the waveform, the length and the menu.
component Row inherits Rectangle {
    in property <int> index;
    in property <ClipRow> item;
    in property <bool> big;
    in property <length> window-h;
    callback go(int);
    callback ask-rename(int);
    callback ask-delete(int);
    callback refocus();
    property <bool> selected: root.index == Main.selected;
    property <bool> picked: Main.picked[root.index];
    property <bool> active: root.index == Main.active-clip;
    property <bool> lit: root.selected || root.picked;
    property <string> num: (root.index < 9 ? "0" : "") + (root.index + 1);
    height: root.big ? 54px : 31px;
    accessible-role: list-item;
    accessible-label: root.item.name + ", " + root.item.duration;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected || root.picked;
    accessible-action-default => { root.select(false, false); }
    function select(ctrl: bool, shift: bool) {
        Main.pick(root.index, ctrl, shift);
        root.refocus();
    }
    if root.lit: Rectangle {
        opacity: root.selected ? 1 : 0.6;
        background: @linear-gradient(90deg, #fbe9dd 0%, #f6ecdc 100%);
    }
    if !root.lit && row-touch.has-hover: Rectangle { background: #00000008; }
    if root.selected: Rectangle {
        x: 0;
        width: 3px;
        background: Am.rec;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Am.paper-line;
    }
    row-touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.has-hover) {
                root.select(e.modifiers.control, e.modifiers.shift);
            }
            // On release: the press that closes an open menu is used up by that menu.
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                menu.show-at(self.mouse-x, self.mouse-y);
            }
        }
        // Opens just this clip, even out of several picked.
        double-clicked => { root.select(false, false); Main.open-clip(root.index); root.go(1); }
    }
    HorizontalLayout {
        padding-left: root.big ? 14px : 9px;
        padding-right: root.big ? 16px : 8px;
        padding-bottom: 1px;
        spacing: root.big ? 12px : 7px;
        VerticalLayout {
            alignment: center;
            RowPlay {
                big: root.big;
                lit: root.selected;
                playing: root.active && Main.playing;
                name: root.item.name;
                clicked => { Main.play-clip(root.index); root.refocus(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.big ? 30px : 20px;
                height: root.big ? 20px : 16px;
                border-radius: 3px;
                background: root.selected ? Am.smoke : transparent;
                if !root.selected: Text {
                    text: root.num;
                    color: Am.print-soft;
                    font-family: "Courier Prime";
                    font-size: root.big ? 12px : 10.5px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                if root.selected: Seg {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: root.num;
                    ghost: root.num.character-count > 2 ? "888" : "88";
                    size: root.big ? 13px : 11px;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: root.big ? 2px : 0;
            Text {
                text: root.item.name;
                color: root.active ? Am.rec : Am.ink;
                font-family: "Courier Prime";
                font-size: root.big ? 15px : 12.5px;
                font-weight: 700;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.item.when.to-uppercase();
                    color: Am.print-soft;
                    font-family: "Barlow Condensed";
                    font-size: root.big ? 10.5px : 9.5px;
                    font-weight: 600;
                    letter-spacing: root.big ? 1.26px : 1.14px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.item.transcribed: VerticalLayout {
                    alignment: center;
                    Stamp {
                        big: root.big;
                        text: "TRANSCRIBED";
                    }
                }
                // The sound of the computer was recorded too.
                if root.item.has-system: Text {
                    text: "+ SYSTEM";
                    color: Am.print-soft;
                    font-family: "Barlow Condensed";
                    font-size: root.big ? 10.5px : 9.5px;
                    font-weight: 600;
                    letter-spacing: root.big ? 1.26px : 1.14px;
                    vertical-alignment: center;
                }
            }
        }
        // The waveform: a click on the highlighted message moves its start, a double
        // click plays from there.
        VerticalLayout {
            alignment: center;
            Wave {
                width: root.big ? 132px : 44px;
                height: root.big ? 24px : 16px;
                n: root.big ? 34 : 14;
                values: root.item.wave;
                lit: root.selected;
                progress: root.active ? Main.play-fraction : -1;
                WaveSeek {
                    selected: root.selected;
                    active: root.active;
                    select(ctrl, shift) => { root.select(ctrl, shift); }
                    cue(f) => { Main.cue-clip(root.index, f); root.refocus(); }
                    play-at(f) => { Main.play-clip-at(root.index, f); root.refocus(); }
                    menu(x, y) => { menu.show-at(x - root.absolute-position.x, y - root.absolute-position.y); }
                }
            }
        }
        Text {
            width: root.big ? 72px : 48px;
            text: root.item.duration;
            color: Am.ink2;
            font-family: "Courier Prime";
            font-size: root.big ? 14px : 11.5px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        // The three-dot menu: manage, rename, export, delete.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.big ? 16px : 12px;
                height: root.big ? 26px : 22px;
                border-radius: 4px;
                background: dots.has-hover ? #0000000f : transparent;
                accessible-role: button;
                accessible-label: "Menu for " + root.item.name;
                accessible-action-default => { root.open-menu(); }
                Icon {
                    name: "dots";
                    tint: dots.has-hover ? Am.print : Am.print-soft;
                    width: root.big ? 15px : 12px;
                    height: self.width;
                }
                property <bool> hovering: dots.has-hover;
                changed hovering => { Tips.hover(self.hovering, "More options", self.absolute-position, self.width, self.height); }
                dots := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Tips.hide(); root.open-menu(); }
                }
            }
        }
    }
    function open-menu() {
        menu.show-at(root.width - 8px - 210px, (root.height + 22px) / 2 + 4px);
    }
    menu := ClipMenu {
        width: parent.width;
        height: parent.height;
        item: root.item;
        merge-count: root.picked ? Main.picked-count : 0;
        projects: Main.projects;
        project: Main.project;
        window-h: root.window-h;
        merge => { Main.start-merge(); root.go(5); }
        open => { Main.open-clip(root.index); root.go(1); }
        rename => { root.ask-rename(root.index); }
        export(kind) => { Main.selected = root.index; Main.export-as(kind); root.refocus(); }
        delete => { root.ask-delete(root.index); }
        move-to(p) => { Main.move-clip(root.index, p); root.refocus(); }
    }
}

// A search result in the log: the clip (and its project when all are searched, extra
// hits as +2), then the words around the match with the match in red.
component Hit inherits Rectangle {
    in property <SearchHit> hit;
    in property <bool> show-project;
    in property <bool> big;
    callback clicked;
    height: root.big ? 54px : 44px;
    background: t.has-hover ? #00000008 : transparent;
    accessible-role: button;
    accessible-label: root.hit.clip + ", " + root.hit.before + " " + root.hit.matched + " " + root.hit.after;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Am.paper-line;
    }
    VerticalLayout {
        padding-left: root.big ? 16px : 12px;
        padding-right: root.big ? 16px : 12px;
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.hit.clip;
                color: Am.ink;
                font-family: "Courier Prime";
                font-size: root.big ? 15px : 12.5px;
                font-weight: 700;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.show-project: Lab {
                text: root.hit.project.to-uppercase();
                color: Am.print-soft;
            }
            if root.hit.more > 0: Text {
                text: "+" + root.hit.more;
                color: Am.rec;
                font-family: "Courier Prime";
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        if root.hit.matched != "": HorizontalLayout {
            spacing: 4px;
            if root.hit.before != "": Text {
                text: root.hit.before;
                color: Am.print;
                font-family: "Courier Prime";
                font-size: root.big ? 12.5px : 11px;
                horizontal-stretch: 0;
            }
            Text {
                text: root.hit.matched;
                color: Am.rec;
                font-family: "Courier Prime";
                font-size: root.big ? 12.5px : 11px;
                font-weight: 700;
                horizontal-stretch: 0;
            }
            Text {
                text: root.hit.after;
                color: Am.print;
                font-family: "Courier Prime";
                font-size: root.big ? 12.5px : 11px;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The message log: the paper with its head (which message of how many) and the clips,
// or the search results while there is a query.
component Log inherits Rectangle {
    in property <bool> big;
    in property <length> window-h;
    callback go(int);
    callback ask-rename(int);
    callback ask-delete(int);
    callback refocus();
    property <length> r: root.big ? 9px : 8px;
    property <length> head-h: root.big ? 26px : 18px;
    // The outline around the paper.
    Rectangle {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 1px;
        border-top-left-radius: root.r + 1px;
        border-top-right-radius: root.r + 1px;
        background: #b4a789;
    }
    Rectangle {
        border-top-left-radius: root.r;
        border-top-right-radius: root.r;
        background: Am.paper;
    }
    // The paper sits in the plastic: a soft shade along its top edge.
    Rectangle { x: root.r; y: 0; width: parent.width - 2 * root.r; height: 1px; background: #0000001f; }
    Rectangle { x: root.r / 2; y: 1px; width: parent.width - root.r; height: 1px; background: #00000012; }
    Rectangle { x: 3px; y: 2px; width: parent.width - 6px; height: 1px; background: #00000008; }
    VerticalLayout {
        HorizontalLayout {
            height: root.head-h;
            padding-left: root.big ? 16px : 12px;
            padding-right: root.big ? 16px : 12px;
            Lab {
                text: Main.query != "" ? "SEARCH RESULTS" : "MESSAGE LOG";
                font-size: 10px;
                letter-spacing: 2.6px;
                horizontal-stretch: 1;
            }
            Lab {
                property <int> count: Main.query != "" ? Main.hits.length : Main.clips.length;
                property <bool> one: Main.query == "" && Main.selected >= 0 && Main.selected < Main.clips.length;
                text: Main.query != "" ? (self.count + (self.count == 1 ? " FOUND" : " FOUND"))
                    : self.one ? ((root.big ? "MESSAGE " : "") + (Main.selected + 1) + " OF " + self.count)
                    : self.count + (self.count == 1 ? " MESSAGE" : " MESSAGES");
                color: Am.rec;
                font-size: 10px;
                letter-spacing: 1.8px;
            }
        }
        Rectangle {
            height: 1.5px;
            background: #c9a99c;
        }
        if Main.query != "": Scroller {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                if Main.hits.length == 0: Text {
                    height: 40px;
                    text: "No matches";
                    color: Am.print-soft;
                    font-family: "Courier Prime";
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                for h[i] in Main.hits: Hit {
                    hit: h;
                    big: root.big;
                    show-project: Main.search-all;
                    clicked => { Main.open-hit(i); root.go(1); }
                }
            }
        }
        if Main.query == "": Scroller {
            vertical-stretch: 1;
            content-y <=> Main.list-y;
            property <int> count: Main.clips.length;
            init => { Main.list-height = self.visible-height; Main.clamp-list(); }
            changed visible-height => { Main.list-height = self.visible-height; Main.clamp-list(); }
            changed count => { Main.clamp-list(); }
            VerticalLayout {
                alignment: start;
                if Main.clips.length == 0: Text {
                    height: 40px;
                    text: "No messages";
                    color: Am.print-soft;
                    font-family: "Courier Prime";
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                for clip[i] in Main.clips: Row {
                    index: i;
                    item: clip;
                    big: root.big;
                    window-h: root.window-h;
                    go(p) => { root.go(p); }
                    ask-rename(n) => { root.ask-rename(n); }
                    ask-delete(n) => { root.ask-delete(n); }
                    refocus => { root.refocus(); }
                }
            }
        }
    }
}

// The footer: the PLAY key, the strip display with the clip in the player (else the
// highlighted one, else nothing) and its time, and the tape slider; a click on the
// slider jumps.
component Player inherits Rectangle {
    in property <bool> big;
    property <int> shown: Main.active-clip >= 0 && Main.active-clip < Main.clips.length ? Main.active-clip
        : Main.selected >= 0 && Main.selected < Main.clips.length ? Main.selected : -1;
    property <bool> is-active: self.shown >= 0 && self.shown == Main.active-clip;
    property <float> at: root.is-active ? clamp(Main.play-fraction, 0, 1) : 0;
    property <string> pos: root.shown < 0 ? "--:--" : root.is-active ? Main.play-position : "0:00";
    property <string> len: root.shown < 0 ? "--:--" : Main.clips[root.shown].duration;
    callback refocus();
    // The unlit layout of a clock string ("0:12", "1:09:26", "--:--"), by its length.
    pure function ghost(s: string) -> string {
        return s.character-count <= 4 ? "8:88" : s.character-count == 5 ? "88:88" : s.character-count == 7 ? "8:88:88" : "88:88:88";
    }
    vertical-stretch: 0;
    height: 64px;
    background: Am.foot;
    Rectangle { y: 0; height: 1px; background: Am.edge; }
    Rectangle { y: 1px; height: 1px; background: #ffffff80; }
    HorizontalLayout {
        padding-left: root.big ? 20px : 14px;
        padding-right: root.big ? 20px : 14px;
        spacing: root.big ? 16px : 12px;
        VerticalLayout {
            alignment: center;
            Key {
                kind: root.big ? 5 : 4;
                width: root.big ? 70px : 56px;
                height: 42px;
                icon: root.is-active && Main.playing ? "pause" : "play";
                icon-size: 14px;
                label: root.is-active && Main.playing ? "Pause" : "Play";
                enabled: root.shown >= 0;
                clicked => { Main.play-clip(root.shown); root.refocus(); }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 7px;
            horizontal-stretch: 1;
            Rectangle {
                height: 24px;
                Slice3 {
                    pad: 2px;
                    cap: 8px;
                    l: @image-url("dv-answer/strip-l.png");
                    m: @image-url("dv-answer/strip-m.png");
                    r: @image-url("dv-answer/strip-r.png");
                    l2: @image-url("dv-answer/strip-l@2x.png");
                    m2: @image-url("dv-answer/strip-m@2x.png");
                    r2: @image-url("dv-answer/strip-r@2x.png");
                }
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 10px;
                    Text {
                        text: root.shown >= 0 ? Main.clips[root.shown].name : "Nothing playing";
                        color: root.is-active && Main.playing ? #f1d3c5 : Am.disp-ink;
                        font-family: "Courier Prime";
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 5px;
                        accessible-role: AccessibleRole.text;
                        accessible-label: root.shown < 0 ? "" : root.pos + " of " + root.len;
                        VerticalLayout {
                            alignment: center;
                            Seg {
                                text: root.pos;
                                ghost: root.ghost(root.pos);
                                size: 12px;
                                lit: #ef4a35;
                            }
                        }
                        Text {
                            text: "/";
                            color: #7d3a31;
                            font-family: "Barlow Condensed";
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        VerticalLayout {
                            alignment: center;
                            Seg {
                                text: root.len;
                                ghost: root.ghost(root.len);
                                size: 12px;
                                lit: #ef4a35;
                            }
                        }
                    }
                }
            }
            // The tape slider.
            Rectangle {
                height: 6px;
                Slice3 {
                    pad: 1px;
                    cap: 4px;
                    l: @image-url("dv-answer/track-l.png");
                    m: @image-url("dv-answer/track-m.png");
                    r: @image-url("dv-answer/track-r.png");
                    l2: @image-url("dv-answer/track-l@2x.png");
                    m2: @image-url("dv-answer/track-m@2x.png");
                    r2: @image-url("dv-answer/track-r@2x.png");
                }
                if root.is-active && root.at > 0: Rectangle {
                    x: 0;
                    width: 6px + (parent.width - 6px) * root.at;
                    border-radius: 3px;
                    background: #cf3c2899;
                }
                Art {
                    x: -2px - 3px + (parent.width - 5px) * root.at;
                    y: -4px - 3px;
                    width: 15px;
                    height: 20px;
                    lo: @image-url("dv-answer/thumb.png");
                    hi: @image-url("dv-answer/thumb@2x.png");
                }
                // Click to jump; taller than the slider so it is easy to hit.
                TouchArea {
                    y: -8px;
                    height: parent.height + 16px;
                    enabled: root.shown >= 0;
                    mouse-cursor: pointer;
                    clicked => {
                        Main.selected = root.shown;
                        Main.seek-fraction(self.mouse-x / self.width);
                        root.refocus();
                    }
                }
            }
        }
    }
}

// The main page. Portrait: the title bar, the machine, the toolbar, the message log and
// the footer, top to bottom. Wide: the machine on the left, the toolbar and the log on
// the right, between the title bar and the footer.
export component MainPage inherits Rectangle {
    // The window's size classes, as AppWindow works them out.
    in property <bool> narrow;
    in property <bool> wide;
    in property <bool> tall;
    // Opens page p (see AppWindow.page).
    callback go(int);
    // The rename and delete questions for clip i.
    callback ask-rename(int);
    callback ask-delete(int);
    // Gives the keyboard back to the window's shortcuts.
    callback refocus();

    property <length> pitch: root.wide ? 54px : 31px;
    init => { Main.row-h = root.pitch; }
    changed pitch => { Main.row-h = root.pitch; Main.clamp-list(); }

    background: Am.body;
    VerticalLayout {
        Title { go(p) => { root.go(p); } }
        if !root.wide: MachineFront { refocus => { root.refocus(); } }
        if !root.wide: Toolbar {
            avail: root.width;
            go(p) => { root.go(p); }
            refocus => { root.refocus(); }
        }
        if !root.wide: HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 10px;
            padding-right: 10px;
            Log {
                window-h: root.height;
                go(p) => { root.go(p); }
                ask-rename(n) => { root.ask-rename(n); }
                ask-delete(n) => { root.ask-delete(n); }
                refocus => { root.refocus(); }
            }
        }
        if root.wide: HorizontalLayout {
            vertical-stretch: 1;
            MachineSide {
                go(p) => { root.go(p); }
                refocus => { root.refocus(); }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                spacing: 12px;
                WideTools {
                    avail: root.width - 404px - 32px;
                    go(p) => { root.go(p); }
                    refocus => { root.refocus(); }
                }
                Log {
                    big: true;
                    vertical-stretch: 1;
                    window-h: root.height;
                    go(p) => { root.go(p); }
                    ask-rename(n) => { root.ask-rename(n); }
                    ask-delete(n) => { root.ask-delete(n); }
                    refocus => { root.refocus(); }
                }
            }
        }

        // An export from the clip menu or the project menu: what it is, how far along,
        // and a check when done. It takes its own room above the footer.
        if Main.export-state != 0: Rectangle {
            vertical-stretch: 0;
            height: 30px;
            background: Am.paper;
            Rectangle { y: 0; height: 1px; background: Am.edge; }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                if Main.export-state == 2: Icon {
                    name: "check";
                    tint: Am.rec;
                    width: 12px;
                    height: 12px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: (Main.export-state == 2 ? "Exported " : "Exporting ") + Main.export-name;
                    color: Am.ink;
                    font-family: "Courier Prime";
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if Main.export-state == 1: Rectangle {
                    width: 120px;
                    height: 4px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    background: #9f9378;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(Main.export-progress, 0, 1);
                        border-radius: 2px;
                        background: Am.rec;
                    }
                }
                if Main.export-state == 1: Text {
                    text: round(Main.export-progress * 100) + "%";
                    color: Am.print;
                    font-family: "Courier Prime";
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                    width: 34px;
                    horizontal-alignment: right;
                }
            }
        }

        Player {
            big: root.wide;
            refocus => { root.refocus(); }
        }
    }

    // Messages float just above the footer, so nothing moves when they come and go.
    if Main.status != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 64px - self.height - 10px;
        width: min(msg.preferred-width + 28px, parent.width - 32px);
        height: 28px;
        border-radius: 6px;
        background: #1b1311f2;
        border-width: 1px;
        border-color: #a39679;
        msg := Text {
            text: Main.status;
            color: Am.disp-ink;
            font-family: "Courier Prime";
            font-size: 12px;
            overflow: elide;
            x: 14px;
            width: parent.width - 28px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
