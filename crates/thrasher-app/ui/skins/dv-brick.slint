// The Brick Phone main page: Thrasher as a chunky late 90s handset (docs/mockups/
// device-themes/dv-brick.html). The app lives on an amber backlit LCD and the keys do the
// work: the green call key records (Pause while recording), the red end key stops, the
// Menu soft key opens Settings and Find puts the cursor in the search, keys 1 2 3 are
// Import, Ask and the widget, and the nav rocker steps through the clips with Play in its
// middle. The input level is the signal bars icon. Portrait windows stand the handset up
// (the LCD on top, the keys below); wide ones turn it sideways like a game phone, the
// keypad on the left wing and the rocker and the call keys on the right.
//
// The rubber keys, the rocker, the antenna and the earpieces are PNGs in dv-brick/ (1x
// and 2x), cut from tools/skin-art/dv-brick.html with headless Edge; keys that stretch
// with the window are three slices. The LCD's glyphs are pixel art at whole scales and
// its rules and grid are tiles, all white and coloured here. The only motion is the
// status dot blinking while recording, on the Fx clock (RECORDING_FPS 4).

import { Main, Tips, Fx, ProjectMenu, TextField, Scroller, ClipMenu, WaveSeek, ClipRow, SearchHit, Brick } from "../common.slint";
import { Art, Px, Tile, KeyFace, Key, KeyIcon, KeyWord, Digit, Caps, Grille, Shell, Top, Sig, Timer, Sbar, Bezel, KeyRow, PadFace, Cap } from "dv-brick-parts.slint";

// The state as an inverted tag and a dot, which blinks while recording.
component Stat inherits HorizontalLayout {
    property <bool> blink: Main.recording && !Main.paused && Math.mod(floor(Fx.t), 2) == 1;
    spacing: 5px;
    alignment: center;
    Rectangle {
        width: tag.preferred-width + 8px;
        height: 11px;
        background: Brick.ink;
        // Pocket Small capitals are 5 px high; this sets them in the middle of the tag.
        tag := Text {
            x: 4px;
            y: (parent.height - 10px) / 2 - 0.5px;
            text: Main.recording ? (Main.paused ? "PAUSED" : "REC") : "READY";
            color: Brick.lcd1;
            font-family: Brick.caps;
            font-size: 8px;
            letter-spacing: 0.48px;
            accessible-role: none;
        }
    }
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 5px;
            height: 5px;
            background: Main.paused || root.blink ? Brick.ghost : Brick.ink;
        }
    }
}

// The microphone in use, as small caps after a small mic.
component Input inherits HorizontalLayout {
    in property <length> max: 200px;
    spacing: 5px;
    alignment: center;
    VerticalLayout {
        alignment: center;
        Px { source: @image-url("dv-brick/x-micsm.png"); }
    }
    Caps {
        text: Main.device-label.to-uppercase();
        max-width: root.max;
        overflow: elide;
    }
}

// The recorder at the top of the portrait LCD: the signal bars, the microphone, the timer
// and the state, and a mic marked REC (lit while recording).
component RecTop inherits Rectangle {
    height: 74px;
    Tile {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        source: @image-url("dv-brick/t-dash.png");
        tint: #3b1f0573;
    }
    HorizontalLayout {
        padding-bottom: 4px;
        spacing: 10px;
        VerticalLayout {
            width: 40px;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                Sig {
                    n: 7;
                    lo: 5px;
                    top: 42px;
                    bar: 4px;
                    gap: 2px;
                }
            }
            Caps {
                text: "IN";
                horizontal-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 5px;
            Input { max: root.width - 120px; }
            HorizontalLayout {
                alignment: center;
                Timer { size: 34px; }
            }
            Stat { }
        }
        VerticalLayout {
            width: 36px;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 16px;
                    height: 20px;
                    background: Main.recording ? Brick.ink : transparent;
                    Px {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("dv-brick/x-mic.png");
                        tint: Main.recording ? Brick.lcd1 : Brick.ink;
                    }
                }
            }
            Caps {
                text: "REC";
                horizontal-alignment: center;
            }
        }
    }
}

// The recorder on the left of the wide LCD: the state, a big mic on a dot screen (left out
// when the window is short), the timer, the microphone, the signal bars with their scale
// and what the green key does now.
component RecSide inherits Rectangle {
    in property <bool> mic: true;
    // Room for the bars, the scale and the hint below the rest.
    property <length> inner: root.width - 14px;
    property <length> bar: clamp(floor((root.inner - 45px) / 16 / 1px) * 1px, 4px, 9px);
    Tile {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        source: @image-url("dv-brick/t-dashv.png");
        tint: #3b1f0573;
    }
    VerticalLayout {
        padding-top: 2px;
        padding-right: 14px;
        padding-bottom: 10px;
        HorizontalLayout {
            Stat { }
            Rectangle { horizontal-stretch: 1; }
            Caps { text: "LINE 1"; }
        }
        if root.mic: HorizontalLayout {
            alignment: center;
            padding-top: 18px;
            padding-bottom: 12px;
            Rectangle {
                width: 96px;
                height: 96px;
                border-width: 2px;
                border-color: Brick.ink;
                Tile {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    source: @image-url("dv-brick/t-micdots.png");
                    tint: Brick.ghost;
                }
                Px {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    s: 4;
                    source: @image-url("dv-brick/x-mic.png");
                    tint: Brick.ink;
                }
            }
        }
        if !root.mic: Rectangle { height: 14px; }
        // The timer gives up size in a narrow recorder (it is 3.13 em wide).
        HorizontalLayout {
            alignment: center;
            Timer { size: clamp(floor(root.inner / 3.2 / 1px) * 1px, 36px, 60px); }
        }
        HorizontalLayout {
            padding-top: 10px;
            Input { max: root.inner - 20px; }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: center;
            sig := Sig {
                n: 16;
                lo: 4px;
                top: 46px;
                bar: root.bar;
                gap: 3px;
            }
        }
        // The scale under the bars, each mark where its level lights the bars.
        Rectangle {
            height: 13px;
            opacity: 0.7;
            for m in [{ t: "-60", f: 0 }, { t: "-30", f: 0.5 }, { t: "-12", f: 0.8 }, { t: "0", f: 1 }]: Caps {
                x: (root.inner - sig.width) / 2 + clamp(m.f * sig.width - self.preferred-width / 2, 0, sig.width - self.preferred-width);
                y: 5px;
                text: m.t;
            }
        }
        HorizontalLayout {
            padding-top: 12px;
            alignment: center;
            Caps {
                opacity: 0.75;
                text: !Main.recording ? "GREEN KEY TO RECORD" : Main.paused ? "GREEN KEY TO RESUME" : "RED KEY TO STOP";
            }
        }
    }
}

// The project picker as an inverted tag: a folder, the name and an arrow. ProjectMenu
// holds what it offers. Its name takes at most `max`, so the search keeps its room.
component Project inherits Rectangle {
    in property <bool> big;
    in property <length> max: 160px;
    callback refocus();
    property <bool> enabled: !Main.recording;
    property <string> name: Main.project >= 0 && Main.project < Main.projects.length ? Main.projects[Main.project] : "";
    width: row.preferred-width;
    background: t.has-hover && root.enabled ? #5a3410 : Brick.ink;
    opacity: root.enabled ? 1 : 0.55;
    accessible-role: combobox;
    accessible-label: "Project";
    accessible-value: root.name;
    accessible-expandable: true;
    accessible-action-default => { if (root.enabled) { menu.show(); } }
    accessible-action-expand => { if (root.enabled) { menu.show(); } }
    row := HorizontalLayout {
        padding-left: root.big ? 9px : 6px;
        padding-right: root.big ? 9px : 6px;
        spacing: 5px;
        VerticalLayout {
            alignment: center;
            Px { source: @image-url("dv-brick/x-fold.png"); tint: Brick.lcd1; }
        }
        Text {
            text: root.name;
            color: Brick.lcd1;
            font-family: Brick.words;
            font-size: root.big ? 20px : 17px;
            vertical-alignment: center;
            max-width: root.max;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Px { source: @image-url("dv-brick/x-chev.png"); tint: Brick.lcd1; }
        }
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := ProjectMenu {
        width: parent.width;
        height: parent.height;
        projects: Main.projects;
        current: Main.project;
        has-clips: Main.clips.length > 0;
        choose(i) => { Main.choose-project(i); root.refocus(); }
        create => { Main.dialog-text = ""; Main.dialog = 4; }
        rename => { Main.dialog-text = Main.projects[Main.project]; Main.dialog = 5; }
        delete => { Main.delete-project(); root.refocus(); }
        export => { Main.export-project(); root.refocus(); }
    }
}

// The LCD's tool row: the project, the search box and, while searching with more than
// one project, the switch to search them all. `avail` is the row's width, from the page.
component Tools inherits HorizontalLayout {
    in property <bool> big;
    in property <length> avail;
    callback go(int);
    callback refocus();
    property <bool> all-shown: Main.query != "" && Main.projects.length > 1;
    spacing: 6px;
    Project {
        big: root.big;
        // The name gives way first: the search keeps about 120 px and the switch its room.
        max: max(40px, root.avail - 150px - (root.all-shown ? (root.avail < 330px ? 40px : 96px) : 0) - 30px);
        refocus => { root.refocus(); }
    }
    Rectangle {
        horizontal-stretch: 1;
        border-width: 2px;
        border-color: Brick.ink;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 2px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Px { source: @image-url("dv-brick/x-mag.png"); }
            }
            VerticalLayout {
                alignment: center;
                TextField {
                    height: root.big ? 24px : 18px;
                    radius: 0;
                    fill: transparent;
                    rest-edge: transparent;
                    ink: Brick.ink;
                    hint: Brick.ink2;
                    select-fill: Brick.ink;
                    select-ink: Brick.lcd1;
                    // The box round it is the frame; no ring of its own.
                    bare-focus: true;
                    font-size: root.big ? 20px : 17px;
                    family: Brick.words;
                    side: 0;
                    placeholder: "Search";
                    label: "Search clips";
                    takes-escape: true;
                    focus-ticket: Main.search-ticket;
                    text <=> Main.query;
                    edited(t) => { Main.search(t, Main.search-all); }
                    escaped => { Main.query = ""; Main.search("", Main.search-all); root.refocus(); }
                    accepted => { if (Main.hits.length > 0) { Main.open-hit(0); root.go(1); } }
                }
            }
        }
    }
    if root.all-shown: Rectangle {
        width: all-text.preferred-width + 12px;
        background: Main.search-all ? Brick.ink : transparent;
        border-width: 2px;
        border-color: Brick.ink;
        accessible-role: checkbox;
        accessible-label: "Search all projects";
        accessible-checked: Main.search-all;
        accessible-action-default => { Main.search-all = !Main.search-all; Main.search(Main.query, Main.search-all); }
        all-text := Text {
            x: 6px;
            y: (parent.height - self.height) / 2;
            // Just "All" when the row is short of room.
            text: root.avail < 330px ? "All" : "All projects";
            color: Main.search-all ? Brick.lcd1 : Brick.ink;
            font-family: Brick.words;
            font-size: root.big ? 20px : 17px;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { Main.search-all = !Main.search-all; Main.search(Main.query, Main.search-all); }
        }
    }
}

// One clip on the LCD: play, its waveform, the name with when it was made and what it
// has, the length and the menu. The highlighted one is inverted; other picked ones half.
component Row inherits Rectangle {
    in property <int> index;
    in property <ClipRow> item;
    in property <bool> big;
    in property <length> window-h;
    // The row's width, from the LCD (its own would be a binding loop).
    in property <length> span;
    callback go(int);
    callback ask-rename(int);
    callback ask-delete(int);
    callback refocus();
    property <bool> selected: root.index == Main.selected;
    property <bool> picked: Main.picked[root.index];
    property <bool> active: root.index == Main.active-clip;
    property <bool> lit: root.selected || root.picked;
    property <color> fg: root.lit ? Brick.lcd1 : Brick.ink;
    // The waveform's bars: fewer, then none, as the row narrows, so the name keeps its room.
    property <int> bars: root.big ? (root.span >= 340px ? 18 : root.span >= 280px ? 10 : 0) : (root.span >= 300px ? 10 : 0);
    height: root.big ? 41px : 26px;
    background: root.selected ? Brick.ink : root.picked ? Brick.ink2 : row-touch.has-hover ? Brick.ghost : transparent;
    accessible-role: list-item;
    accessible-label: root.item.name + ", " + root.item.duration;
    accessible-item-selectable: true;
    accessible-item-selected: root.lit;
    accessible-action-default => { root.select(false, false); }
    function select(ctrl: bool, shift: bool) {
        Main.pick(root.index, ctrl, shift);
        root.refocus();
    }
    Tile {
        visible: !root.lit;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        source: @image-url("dv-brick/t-dot.png");
        tint: Brick.rule;
    }
    row-touch := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.has-hover) {
                root.select(e.modifiers.control, e.modifiers.shift);
            }
            // On release: the press that closes an open menu is used up by that menu.
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                menu.show-at(self.mouse-x, self.mouse-y);
            }
        }
        // Opens just this clip, even out of several picked.
        double-clicked => { root.select(false, false); Main.open-clip(root.index); root.go(1); }
    }
    HorizontalLayout {
        padding-left: root.big ? 6px : 3px;
        padding-right: root.big ? 8px : 4px;
        spacing: root.big ? (root.bars > 0 ? 10px : 6px) : 7px;
        // Play.
        Rectangle {
            width: 14px;
            accessible-role: button;
            accessible-label: (root.active && Main.playing ? "Pause " : "Play ") + root.item.name;
            accessible-action-default => { Main.play-clip(root.index); root.refocus(); }
            Rectangle {
                visible: pt.has-hover;
                x: 0;
                y: (parent.height - 14px) / 2;
                height: 14px;
                background: root.lit ? #f6bf5e33 : Brick.ghost;
            }
            Px {
                y: (parent.height - self.height) / 2 + (pt.pressed ? 1px : 0);
                source: root.active && Main.playing ? @image-url("dv-brick/x-pause.png") : @image-url("dv-brick/x-play.png");
                tint: root.fg;
            }
            property <bool> hovering: pt.has-hover;
            changed hovering => { Tips.hover(self.hovering, root.active && Main.playing ? "Pause" : "Play", self.absolute-position, self.width, self.height); }
            pt := TouchArea {
                mouse-cursor: pointer;
                clicked => { Tips.hide(); Main.play-clip(root.index); root.refocus(); }
            }
        }
        // The waveform, what has played solid: a click on the highlighted clip moves its
        // start, a double click plays from there.
        if root.bars > 0: VerticalLayout {
            alignment: center;
            wave := Rectangle {
                property <int> n: root.bars;
                width: wave.n * 3px - 1px;
                height: root.big ? 16px : 12px;
                for i in wave.n: Rectangle {
                    property <float> v: root.item.wave.length > 0 ? root.item.wave[floor(i * root.item.wave.length / wave.n)] : 0.06;
                    x: i * 3px;
                    width: 2px;
                    height: max(2px, round(self.v * wave.height / 1px) * 1px);
                    y: round((wave.height - self.height) / 2 / 1px) * 1px;
                    background: root.fg;
                    opacity: root.active && (i + 0.5) / wave.n > Main.play-fraction ? 0.4 : 0.85;
                }
                WaveSeek {
                    selected: root.selected;
                    active: root.active;
                    select(ctrl, shift) => { root.select(ctrl, shift); }
                    cue(f) => { Main.cue-clip(root.index, f); root.refocus(); }
                    play-at(f) => { Main.play-clip-at(root.index, f); root.refocus(); }
                    menu(x, y) => { menu.show-at(x - root.absolute-position.x, y - root.absolute-position.y); }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: root.big ? 3px : 1px;
            Text {
                height: root.big ? 17px : 14px;
                text: root.item.name;
                color: root.fg;
                font-family: Brick.words;
                font-size: root.big ? 20px : 17px;
                vertical-alignment: center;
                overflow: elide;
            }
            Caps {
                height: root.big ? 9px : 8px;
                text: root.item.meta.to-uppercase();
                color: root.fg;
                opacity: 0.78;
                overflow: elide;
            }
        }
        Text {
            text: root.item.duration;
            color: root.fg;
            font-family: Brick.words;
            font-size: root.big ? 20px : 17px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        // The menu: manage, rename, export, delete.
        Rectangle {
            width: 10px;
            accessible-role: button;
            accessible-label: "Menu for " + root.item.name;
            accessible-action-default => { root.open-menu(); }
            Rectangle {
                visible: dots.has-hover;
                y: (parent.height - 14px) / 2;
                height: 14px;
                background: root.lit ? #f6bf5e33 : Brick.ghost;
            }
            Px {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("dv-brick/x-dots.png");
                tint: root.fg;
            }
            property <bool> hovering: dots.has-hover;
            changed hovering => { Tips.hover(self.hovering, "More options", self.absolute-position, self.width, self.height); }
            dots := TouchArea {
                mouse-cursor: pointer;
                clicked => { Tips.hide(); root.open-menu(); }
            }
        }
    }
    function open-menu() {
        menu.show-at(root.width - 8px - 210px, root.height / 2 + 10px);
    }
    menu := ClipMenu {
        width: parent.width;
        height: parent.height;
        item: root.item;
        merge-count: root.picked ? Main.picked-count : 0;
        projects: Main.projects;
        project: Main.project;
        window-h: root.window-h;
        merge => { Main.start-merge(); root.go(5); }
        open => { Main.open-clip(root.index); root.go(1); }
        rename => { root.ask-rename(root.index); }
        export(kind) => { Main.selected = root.index; Main.export-as(kind); root.refocus(); }
        delete => { root.ask-delete(root.index); }
        move-to(p) => { Main.move-clip(root.index, p); root.refocus(); }
    }
}

// A search result: the clip (and its project when all are searched, extra hits as +2),
// then the words round the match with the match inverted.
component Hit inherits Rectangle {
    in property <SearchHit> hit;
    in property <bool> show-project;
    in property <bool> big;
    callback clicked;
    property <length> size: root.big ? 20px : 17px;
    height: root.big ? 44px : 34px;
    background: t.has-hover ? Brick.ghost : transparent;
    accessible-role: button;
    accessible-label: root.hit.clip + ", " + root.hit.before + " " + root.hit.matched + " " + root.hit.after;
    accessible-action-default => { root.clicked(); }
    Tile {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        source: @image-url("dv-brick/t-dot.png");
        tint: Brick.rule;
    }
    VerticalLayout {
        padding-left: 4px;
        padding-right: 6px;
        alignment: center;
        spacing: 1px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.hit.clip;
                color: Brick.ink;
                font-family: Brick.words;
                font-size: root.size;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.show-project: Caps {
                text: root.hit.project.to-uppercase();
                opacity: 0.78;
            }
            if root.hit.more > 0: Text {
                text: "+" + root.hit.more;
                color: Brick.ink;
                font-family: Brick.words;
                font-size: root.size;
                vertical-alignment: center;
            }
        }
        if root.hit.matched != "": HorizontalLayout {
            spacing: 4px;
            if root.hit.before != "": Text {
                text: root.hit.before;
                color: Brick.ink2;
                font-family: Brick.words;
                font-size: root.size - 2px;
                horizontal-stretch: 0;
            }
            Rectangle {
                width: mark.preferred-width + 4px;
                horizontal-stretch: 0;
                background: Brick.ink;
                mark := Text {
                    text: root.hit.matched;
                    color: Brick.lcd1;
                    font-family: Brick.words;
                    font-size: root.size - 2px;
                    horizontal-alignment: center;
                }
            }
            Text {
                text: root.hit.after;
                color: Brick.ink2;
                font-family: Brick.words;
                font-size: root.size - 2px;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The list on the LCD with its scrollbar: the clips, or the search results while there
// is a query.
component List inherits HorizontalLayout {
    in property <bool> big;
    in property <length> window-h;
    // A row's width (the list less its scrollbar), from the LCD.
    in property <length> span;
    callback go(int);
    callback ask-rename(int);
    callback ask-delete(int);
    callback refocus();
    spacing: 4px;
    if Main.query != "": HorizontalLayout {
        spacing: 4px;
        hits := Scroller {
            bar: false;
            vertical-stretch: 1;
            content-y <=> hbar.content-y;
            VerticalLayout {
                alignment: start;
                if Main.hits.length == 0: Text {
                    text: "No matches";
                    color: Brick.ink2;
                    font-family: Brick.words;
                    font-size: root.big ? 20px : 17px;
                    horizontal-alignment: center;
                }
                for h[i] in Main.hits: Hit {
                    hit: h;
                    big: root.big;
                    show-project: Main.search-all;
                    clicked => { Main.open-hit(i); root.go(1); }
                }
            }
        }
        hbar := Sbar {
            content-h: hits.content-height;
            view-h: hits.visible-height;
        }
    }
    if Main.query == "": HorizontalLayout {
        spacing: 4px;
        clips := Scroller {
            bar: false;
            vertical-stretch: 1;
            content-y <=> Main.list-y;
            property <int> count: Main.clips.length;
            init => { Main.list-height = self.visible-height; Main.clamp-list(); }
            changed visible-height => { Main.list-height = self.visible-height; Main.clamp-list(); }
            changed count => { Main.clamp-list(); }
            VerticalLayout {
                alignment: start;
                if Main.clips.length == 0: Text {
                    text: "No clips yet";
                    color: Brick.ink2;
                    font-family: Brick.words;
                    font-size: root.big ? 20px : 17px;
                    horizontal-alignment: center;
                }
                for clip[i] in Main.clips: Row {
                    index: i;
                    item: clip;
                    big: root.big;
                    window-h: root.window-h;
                    span: root.span;
                    go(p) => { root.go(p); }
                    ask-rename(n) => { root.ask-rename(n); }
                    ask-delete(n) => { root.ask-delete(n); }
                    refocus => { root.refocus(); }
                }
            }
        }
        Sbar {
            content-y <=> Main.list-y;
            content-h: clips.content-height;
            view-h: clips.visible-height;
        }
    }
}

// Now playing, along the LCD's foot: play, the clip in the player (else the highlighted
// one, else nothing yet), the time and the progress bar; a click on the bar jumps.
component Foot inherits Rectangle {
    in property <bool> big;
    callback refocus();
    property <int> shown: Main.active-clip >= 0 && Main.active-clip < Main.clips.length ? Main.active-clip
        : Main.selected >= 0 && Main.selected < Main.clips.length ? Main.selected : -1;
    property <bool> is-active: self.shown >= 0 && self.shown == Main.active-clip;
    property <float> at: root.is-active ? clamp(Main.play-fraction, 0, 1) : 0;
    height: root.big ? 38px : 30px;
    Rectangle { y: 0; height: 2px; background: Brick.ink; }
    HorizontalLayout {
        padding-top: 2px;
        spacing: root.big ? 12px : 8px;
        Rectangle {
            width: 14px;
            opacity: root.shown >= 0 ? 1 : 0.6;
            accessible-role: button;
            accessible-label: root.is-active && Main.playing ? "Pause" : "Play";
            accessible-action-default => { if (root.shown >= 0) { Main.play-clip(root.shown); } }
            Rectangle {
                visible: pk.has-hover && root.shown >= 0;
                y: (parent.height - 14px) / 2;
                height: 14px;
                background: Brick.ghost;
            }
            Px {
                y: (parent.height - self.height) / 2 + (pk.pressed ? 1px : 0);
                source: root.is-active && Main.playing ? @image-url("dv-brick/x-pause.png") : @image-url("dv-brick/x-play.png");
            }
            property <bool> hovering: pk.has-hover;
            changed hovering => { Tips.hover(self.hovering, root.is-active && Main.playing ? "Pause" : "Play", self.absolute-position, self.width, self.height); }
            pk := TouchArea {
                enabled: root.shown >= 0;
                mouse-cursor: pointer;
                clicked => { Tips.hide(); Main.play-clip(root.shown); root.refocus(); }
            }
        }
        Text {
            text: root.shown >= 0 ? Main.clips[root.shown].name : "Nothing playing";
            color: Brick.ink;
            font-family: Brick.words;
            font-size: root.big ? 20px : 17px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: root.big ? 0 : 1;
            max-width: root.big ? root.width * 0.4 : 100000px;
        }
        Caps {
            opacity: 0.8;
            text: root.shown < 0 ? "--:-- / --:--"
                : (root.is-active ? Main.play-position : "0:00") + " / " + Main.clips[root.shown].duration;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: root.big ? 1 : 0;
            min-width: root.big ? 40px : 70px;
            max-width: root.big ? 100000px : 70px;
            Rectangle {
                height: 6px;
                border-width: 1px;
                border-color: Brick.ink;
                Tile {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    source: @image-url("dv-brick/t-dash.png");
                    tint: Brick.ghost;
                }
                Rectangle {
                    x: 0;
                    width: parent.width * root.at;
                    background: Brick.ink;
                }
                // Click to jump; taller than the bar so it is easy to hit.
                TouchArea {
                    y: -8px;
                    height: parent.height + 16px;
                    enabled: root.shown >= 0;
                    mouse-cursor: pointer;
                    clicked => {
                        Main.selected = root.shown;
                        Main.seek-fraction(self.mouse-x / self.width);
                        root.refocus();
                    }
                }
            }
        }
    }
}

// The soft key labels along the bottom of the LCD: what Menu, the rocker and Find do.
component Soft inherits Rectangle {
    in property <bool> big;
    height: root.big ? 20px : 18px;
    background: #3b1f051f;
    Rectangle { y: 0; height: 1px; background: #3b1f054d; }
    HorizontalLayout {
        padding-left: root.big ? 14px : 10px;
        padding-right: root.big ? 14px : 10px;
        Text {
            text: "Menu";
            color: Brick.ink;
            font-family: Brick.words;
            font-size: root.big ? 17px : 16px;
            vertical-alignment: center;
            accessible-role: none;
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 4px;
            opacity: root.big ? 0.75 : 1;
            VerticalLayout {
                alignment: center;
                Px { source: @image-url("dv-brick/x-tri.png"); }
            }
            Text {
                text: root.big ? "Rocker plays" : "Play";
                color: Brick.ink;
                font-family: Brick.words;
                font-size: root.big ? 17px : 16px;
                vertical-alignment: center;
                accessible-role: none;
            }
            VerticalLayout {
                alignment: center;
                Px { source: @image-url("dv-brick/x-trid.png"); }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: "Find";
            color: Brick.ink;
            font-family: Brick.words;
            font-size: root.big ? 17px : 16px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// An export from the clip menu or the project menu, on a strip above the foot.
component Exporting inherits Rectangle {
    in property <bool> big;
    height: root.big ? 26px : 22px;
    Rectangle { y: 0; height: 1px; background: Brick.rule; }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: (Main.export-state == 2 ? "Exported " : "Exporting ") + Main.export-name;
            color: Brick.ink;
            font-family: Brick.words;
            font-size: root.big ? 18px : 16px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if Main.export-state == 1: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 70px;
                height: 6px;
                border-width: 1px;
                border-color: Brick.ink;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(Main.export-progress, 0, 1);
                    background: Brick.ink;
                }
            }
        }
        if Main.export-state == 1: Caps {
            text: round(Main.export-progress * 100) + "%";
            width: 26px;
            horizontal-alignment: right;
        }
    }
}

// The amber LCD: a backlit glow with a light sheen and the pixel grid, its corners
// rounded by bezel coloured masks (no rounded clipping), and the app on it.
component Lcd inherits Rectangle {
    in property <bool> big;
    in property <length> window-h;
    callback go(int);
    callback ask-rename(int);
    callback ask-delete(int);
    callback refocus();
    background: @radial-gradient(circle, #f6bf5e 0%, #f0b04c 45%, #e39a33 100%);
    Rectangle {
        y: 0;
        height: parent.height * 0.4;
        background: @linear-gradient(170deg, #ffffff38 0%, #ffffff00 70%);
    }
    Tile {
        width: parent.width;
        height: parent.height;
        source: @image-url("dv-brick/t-grid.png");
        tint: #3b1f0512;
    }
    // The wide recorder column.
    property <length> side-w: clamp((root.width - 24px) * 0.34, 150px, 232px);
    property <length> foot-top: root.height - (root.big ? 20px : 18px) - (root.big ? 38px : 30px) - (Main.export-state != 0 ? (root.big ? 26px : 22px) : 0);
    if !root.big: VerticalLayout {
        VerticalLayout {
            padding-top: 7px;
            padding-left: 8px;
            padding-right: 8px;
            vertical-stretch: 1;
            RecTop { }
            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 4px;
                Tools {
                    height: 22px;
                    avail: root.width - 16px;
                    go(p) => { root.go(p); }
                    refocus => { root.refocus(); }
                }
            }
            List {
                vertical-stretch: 1;
                window-h: root.window-h;
                span: root.width - 16px - 9px;
                go(p) => { root.go(p); }
                ask-rename(n) => { root.ask-rename(n); }
                ask-delete(n) => { root.ask-delete(n); }
                refocus => { root.refocus(); }
            }
            if Main.export-state != 0: Exporting { }
            Foot { refocus => { root.refocus(); } }
        }
        Soft { }
    }
    if root.big: VerticalLayout {
        HorizontalLayout {
            padding-top: 10px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 14px;
            vertical-stretch: 1;
            RecSide {
                width: root.side-w;
                mic: root.height >= 400px;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding-top: 2px;
                    padding-bottom: 8px;
                    Tools {
                        big: true;
                        height: 28px;
                        avail: root.width - 24px - root.side-w - 14px;
                        go(p) => { root.go(p); }
                        refocus => { root.refocus(); }
                    }
                }
                List {
                    big: true;
                    vertical-stretch: 1;
                    window-h: root.window-h;
                    span: root.width - 24px - root.side-w - 14px - 9px;
                    go(p) => { root.go(p); }
                    ask-rename(n) => { root.ask-rename(n); }
                    ask-delete(n) => { root.ask-delete(n); }
                    refocus => { root.refocus(); }
                }
            }
        }
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            if Main.export-state != 0: Exporting { big: true; }
            Foot {
                big: true;
                refocus => { root.refocus(); }
            }
        }
        Soft { big: true; }
    }
    // Messages float just above the foot, inverted, so nothing moves when they come and go.
    Rectangle {
        visible: Main.status != "";
        x: (parent.width - self.width) / 2;
        y: root.foot-top - self.height - 6px;
        width: min(msg.preferred-width + 20px, parent.width - 24px);
        height: root.big ? 26px : 22px;
        background: Brick.ink;
        msg := Text {
            x: 10px;
            width: parent.width - 20px;
            text: Main.status;
            color: Brick.lcd1;
            font-family: Brick.words;
            font-size: root.big ? 18px : 16px;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    // The rounded corners: the bezel's colour outside a quarter circle.
    for c in 4: Path {
        x: Math.mod(c, 2) == 0 ? 0 : root.width - 6px;
        y: c < 2 ? 0 : root.height - 6px;
        width: 6px;
        height: 6px;
        viewbox-width: 6;
        viewbox-height: 6;
        fill: Brick.bezel;
        commands: c == 0 ? "M 0 0 L 6 0 A 6 6 0 0 0 0 6 Z"
            : c == 1 ? "M 6 0 L 6 6 A 6 6 0 0 0 0 0 Z"
            : c == 2 ? "M 0 6 L 0 0 A 6 6 0 0 0 6 6 Z"
            : "M 6 6 L 0 6 A 6 6 0 0 0 6 0 Z";
    }
}

// The nav rocker: up and down step through the clips like the arrow keys, the OK key in
// the middle plays or pauses (the clip in the player, else the highlighted one). A pill
// in portrait, a round pad in wide windows.
component Rocker inherits Rectangle {
    in property <bool> big;
    callback step(int);
    callback refocus();
    property <int> shown: Main.active-clip >= 0 && Main.active-clip < Main.clips.length ? Main.active-clip
        : Main.selected >= 0 && Main.selected < Main.clips.length ? Main.selected : -1;
    property <bool> is-active: self.shown >= 0 && self.shown == Main.active-clip;
    property <length> ok: root.big ? 46px : 38px;
    property <length> arrow-y: root.big ? 8px : 4px;
    width: root.big ? 112px : 124px;
    height: root.big ? 112px : 76px;
    Art {
        x: -6px;
        y: -2px;
        width: root.width + 12px;
        height: root.height + 10px;
        lo: root.big ? @image-url("dv-brick/nav-w.png") : @image-url("dv-brick/nav-p.png");
        hi: root.big ? @image-url("dv-brick/nav-w@2x.png") : @image-url("dv-brick/nav-p@2x.png");
    }
    // Up.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0;
        width: root.big ? 60px : 84px;
        height: (parent.height - root.ok) / 2;
        accessible-role: button;
        accessible-label: "Previous clip";
        accessible-action-default => { root.step(-1); }
        KeyIcon {
            x: (parent.width - self.width) / 2;
            y: root.arrow-y + (up.pressed ? 1px : 0);
            width: 12px;
            height: 12px;
            lo: @image-url("dv-brick/i-up12.png");
            hi: @image-url("dv-brick/i-up12@2x.png");
            tint: up.has-hover ? Brick.amber : Brick.silver;
            opacity: up.has-hover ? 1 : 0.8;
        }
        property <bool> hovering: up.has-hover;
        changed hovering => { Tips.hover(self.hovering, "Previous", self.absolute-position, self.width, self.height); }
        up := TouchArea {
            mouse-cursor: pointer;
            clicked => { Tips.hide(); root.step(-1); }
        }
    }
    // Down.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height + root.ok) / 2;
        width: root.big ? 60px : 84px;
        height: (parent.height - root.ok) / 2;
        accessible-role: button;
        accessible-label: "Next clip";
        accessible-action-default => { root.step(1); }
        KeyIcon {
            x: (parent.width - self.width) / 2;
            y: parent.height - root.arrow-y - self.height + (dn.pressed ? 1px : 0);
            width: 12px;
            height: 12px;
            lo: @image-url("dv-brick/i-down12.png");
            hi: @image-url("dv-brick/i-down12@2x.png");
            tint: dn.has-hover ? Brick.amber : Brick.silver;
            opacity: dn.has-hover ? 1 : 0.8;
        }
        property <bool> hovering: dn.has-hover;
        changed hovering => { Tips.hover(self.hovering, "Next", self.absolute-position, self.width, self.height); }
        dn := TouchArea {
            mouse-cursor: pointer;
            clicked => { Tips.hide(); root.step(1); }
        }
    }
    // OK: play or pause.
    Rectangle {
        x: (parent.width - root.ok) / 2;
        y: (parent.height - root.ok) / 2;
        width: root.ok;
        height: root.ok;
        accessible-role: button;
        accessible-label: root.is-active && Main.playing ? "Pause" : "Play";
        accessible-enabled: root.shown >= 0;
        accessible-action-default => { if (root.shown >= 0) { Main.play-clip(root.shown); } }
        Art {
            x: -2px;
            y: -2px;
            width: parent.width + 4px;
            height: parent.height + 4px;
            lo: root.big ? @image-url("dv-brick/ok-w.png") : @image-url("dv-brick/ok-p.png");
            hi: root.big ? @image-url("dv-brick/ok-w@2x.png") : @image-url("dv-brick/ok-p@2x.png");
        }
        Rectangle {
            visible: okt.has-hover && root.shown >= 0;
            border-radius: self.width / 2;
            background: okt.pressed ? #00000038 : #ffffff0f;
        }
        KeyIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (okt.pressed ? 1px : 0);
            width: root.big ? 16px : 14px;
            height: self.width;
            opacity: root.shown >= 0 ? 1 : 0.5;
            lo: root.is-active && Main.playing ? (root.big ? @image-url("dv-brick/i-pause16.png") : @image-url("dv-brick/i-pause14.png"))
                : (root.big ? @image-url("dv-brick/i-play16.png") : @image-url("dv-brick/i-play14.png"));
            hi: root.is-active && Main.playing ? (root.big ? @image-url("dv-brick/i-pause16@2x.png") : @image-url("dv-brick/i-pause14@2x.png"))
                : (root.big ? @image-url("dv-brick/i-play16@2x.png") : @image-url("dv-brick/i-play14@2x.png"));
            tint: Brick.amber;
        }
        property <bool> hovering: okt.has-hover;
        changed hovering => { Tips.hover(self.hovering, root.is-active && Main.playing ? "Pause" : "Play", self.absolute-position, self.width, self.height); }
        okt := TouchArea {
            enabled: root.shown >= 0;
            mouse-cursor: pointer;
            clicked => { Tips.hide(); Main.play-clip(root.shown); root.refocus(); }
        }
    }
}

// The green call key: Record, then Pause and Resume while recording.
component CallKey inherits Key {
    in property <bool> big;
    callback refocus();
    kind: root.big ? 11 : 2;
    label: !Main.recording ? "Record" : Main.paused ? "Resume" : "Pause";
    clicked => {
        if (Main.recording) { Main.toggle-pause(); } else { Main.toggle-record(); }
        root.refocus();
    }
    KeyRow {
        width: parent.width;
        height: parent.height;
        icon: root.big ? 18px : 14px;
        lo: !Main.recording ? (root.big ? @image-url("dv-brick/i-mic18.png") : @image-url("dv-brick/i-mic14.png"))
            : Main.paused ? (root.big ? @image-url("dv-brick/i-play18.png") : @image-url("dv-brick/i-play14.png"))
            : (root.big ? @image-url("dv-brick/i-pause18.png") : @image-url("dv-brick/i-pause14.png"));
        hi: !Main.recording ? (root.big ? @image-url("dv-brick/i-mic18@2x.png") : @image-url("dv-brick/i-mic14@2x.png"))
            : Main.paused ? (root.big ? @image-url("dv-brick/i-play18@2x.png") : @image-url("dv-brick/i-play14@2x.png"))
            : (root.big ? @image-url("dv-brick/i-pause18@2x.png") : @image-url("dv-brick/i-pause14@2x.png"));
        word: !Main.recording ? "REC" : Main.paused ? "RESUME" : "PAUSE";
        tint: Brick.on-green;
        ink: Brick.on-green;
        word-size: root.big ? 10px : 8px;
    }
}

// The red end key: stops and saves the recording.
component EndKey inherits Key {
    in property <bool> big;
    callback refocus();
    kind: root.big ? 12 : 3;
    label: "Stop and save";
    tip: "Stop";
    enabled: Main.recording;
    clicked => { Main.toggle-record(); root.refocus(); }
    KeyRow {
        width: parent.width;
        height: parent.height;
        lo: @image-url("dv-brick/i-stop14.png");
        hi: @image-url("dv-brick/i-stop14@2x.png");
        word: "STOP";
        tint: Brick.on-red;
        ink: Brick.on-red;
    }
}

// The Menu soft key: Settings.
component MenuKey inherits Key {
    in property <bool> big;
    callback go(int);
    kind: root.big ? 13 : 0;
    label: "Settings";
    clicked => { root.go(3); }
    KeyRow {
        width: parent.width;
        height: parent.height;
        lo: @image-url("dv-brick/i-gear14.png");
        hi: @image-url("dv-brick/i-gear14@2x.png");
        word: "MENU";
        ink: Brick.silver;
    }
}

// The Find soft key: the cursor goes to the search, as Ctrl+F does.
component FindKey inherits Key {
    in property <bool> big;
    kind: root.big ? 13 : 1;
    label: "Search";
    clicked => { Main.search-ticket += 1; }
    KeyRow {
        width: parent.width;
        height: parent.height;
        lo: @image-url("dv-brick/i-search14.png");
        hi: @image-url("dv-brick/i-search14@2x.png");
        word: "FIND";
        ink: Brick.silver;
    }
}

// The keypad: 1 Import, 2 Ask (when the local AI is there; else a plain key) and 3 the
// widget, then the letters, which only show. Portrait gives it `rows` rows (one in a short
// window); wide keys are 43 x 50 on the left wing.
component Pad inherits Rectangle {
    in property <bool> big;
    in property <int> rows: 4;
    property <length> kw: root.big ? 43px : (root.width - 20px) / 3;
    property <length> kh: root.big ? 50px : 23px;
    property <length> gx: root.big ? 8px : 10px;
    property <length> gy: root.big ? 10px : 6px;
    property <int> kind: root.big ? 10 : 4;
    callback go(int);
    Key {
        x: 0;
        y: 0;
        width: root.kw;
        height: root.kh;
        kind: root.kind;
        label: "Import audio or video";
        tip: "Import";
        enabled: !Main.recording;
        clicked => { Main.import-files(); }
        PadFace {
            width: parent.width;
            height: parent.height;
            big: root.big;
            digit: "1";
            word: "IMPORT";
            job: true;
            lo: root.big ? @image-url("dv-brick/i-import12.png") : @image-url("dv-brick/i-import13.png");
            hi: root.big ? @image-url("dv-brick/i-import12@2x.png") : @image-url("dv-brick/i-import13@2x.png");
        }
    }
    if Main.can-ai: Key {
        x: root.kw + root.gx;
        y: 0;
        width: root.kw;
        height: root.kh;
        kind: root.kind;
        label: "Ask your clips";
        tip: "Ask";
        clicked => { root.go(6); }
        PadFace {
            width: parent.width;
            height: parent.height;
            big: root.big;
            digit: "2";
            word: "ASK";
            job: true;
            lo: root.big ? @image-url("dv-brick/i-ask12.png") : @image-url("dv-brick/i-ask13.png");
            hi: root.big ? @image-url("dv-brick/i-ask12@2x.png") : @image-url("dv-brick/i-ask13@2x.png");
        }
    }
    if !Main.can-ai: KeyFace {
        x: root.kw + root.gx;
        y: 0;
        width: root.kw;
        height: root.kh;
        kind: root.kind;
        PadFace {
            width: parent.width;
            height: parent.height;
            big: root.big;
            digit: "2";
            word: "ABC";
        }
    }
    Key {
        x: 2 * (root.kw + root.gx);
        y: 0;
        width: root.kw;
        height: root.kh;
        kind: root.kind;
        label: "Small widget";
        tip: "Widget";
        clicked => { Main.compact-changed(true); }
        PadFace {
            width: parent.width;
            height: parent.height;
            big: root.big;
            digit: "3";
            word: "WIDGET";
            job: true;
            lo: root.big ? @image-url("dv-brick/i-widget12.png") : @image-url("dv-brick/i-widget13.png");
            hi: root.big ? @image-url("dv-brick/i-widget12@2x.png") : @image-url("dv-brick/i-widget13@2x.png");
        }
    }
    for k[i] in [
        { d: "4", w: "GHI" }, { d: "5", w: "JKL" }, { d: "6", w: "MNO" },
        { d: "7", w: "PQRS" }, { d: "8", w: "TUV" }, { d: "9", w: "WXYZ" },
        { d: "*", w: "+" }, { d: "0", w: "SPACE" }, { d: "#", w: "SHIFT" },
    ]: KeyFace {
        visible: root.rows > 1;
        x: Math.mod(i, 3) * (root.kw + root.gx);
        y: (floor(i / 3) + 1) * (root.kh + root.gy);
        width: root.kw;
        height: root.kh;
        kind: root.kind;
        PadFace {
            width: parent.width;
            height: parent.height;
            big: root.big;
            digit: k.d;
            word: k.w;
        }
    }
}

// The main page: the handset fills the window. Portrait: the title, the bezel with the
// LCD, the soft keys, the call keys and the rocker, then the keypad. Wide: the keypad on
// the left wing, the LCD in the middle with the soft keys under it, the rocker and the
// call keys on the right wing.
export component MainPage inherits Rectangle {
    // The window's size classes, as AppWindow works them out.
    in property <bool> narrow;
    in property <bool> wide;
    in property <bool> tall;
    // Opens page p (see AppWindow.page).
    callback go(int);
    // The rename and delete questions for clip i.
    callback ask-rename(int);
    callback ask-delete(int);
    // Gives the keyboard back to the window's shortcuts.
    callback refocus();

    property <length> pitch: root.wide ? 41px : 26px;
    init => { Main.row-h = root.pitch; }
    changed pitch => { Main.row-h = root.pitch; Main.clamp-list(); }

    // The rocker steps the highlight as the arrow keys do, and scrolls it into view.
    function step(d: int) {
        if (Main.clips.length == 0 || Main.query != "") { return; }
        Main.selected = clamp(Main.selected < 0 ? Main.clips.length - 1 : Main.selected + d, 0, Main.clips.length - 1);
        if (Main.selected * Main.row-h < -Main.list-y) {
            Main.list-y = -(Main.selected * Main.row-h);
        } else if ((Main.selected + 1) * Main.row-h > -Main.list-y + Main.list-height) {
            Main.list-y = -((Main.selected + 1) * Main.row-h - Main.list-height);
        }
        root.refocus();
    }

    background: Brick.bg;

    // Portrait: the whole keypad when the window is tall enough, else just keys 1 2 3.
    property <int> pad-rows: root.height >= 540px ? 4 : 1;
    property <length> pad-h: root.pad-rows * 23px + (root.pad-rows - 1) * 6px;
    property <length> bez-x: root.wide ? 196px : 20px;
    property <length> bez-w: root.width - 2 * root.bez-x;
    property <length> bez-h: root.wide ? root.height - 118px : root.height - 164px - root.pad-h;
    property <length> bez-bottom: 58px + root.bez-h;
    // Portrait: the soft keys and the call keys beside the rocker.
    property <length> ctrl-y: root.bez-bottom + 12px;
    property <length> key-w: (root.width - 40px - 124px - 28px) / 2;
    // Wide: the right wing's parts close up on a short window.
    property <float> k: clamp((root.bez-h - 12px - 278px) / 108px, 0, 1);
    property <length> wing-y: 58px + max(6px, (root.bez-h - 278px - 108px * root.k) / 2 - 20px * root.k);
    property <length> pad-y: 58px + max(30px, (root.bez-h - 252px) / 2 - 55px + 22px);

    Art {
        x: root.wide ? 52px : 36px;
        y: 0;
        width: 34px;
        height: 40px;
        lo: @image-url("dv-brick/antenna.png");
        hi: @image-url("dv-brick/antenna@2x.png");
    }
    Shell {
        y: 12px;
        height: root.height - 12px;
        rt: root.wide ? 40px : 34px;
        rb: root.wide ? 40px : 52px;
    }
    Top {
        y: 12px;
        width: root.width;
        wide: root.wide;
    }
    Art {
        x: (parent.width - self.width) / 2;
        y: root.wide ? 34px : 50px;
        width: root.wide ? 72px : 62px;
        height: root.wide ? 10px : 7px;
        lo: root.wide ? @image-url("dv-brick/ear-w.png") : @image-url("dv-brick/ear-p.png");
        hi: root.wide ? @image-url("dv-brick/ear-w@2x.png") : @image-url("dv-brick/ear-p@2x.png");
    }
    Bezel {
        x: root.bez-x;
        y: 58px;
        width: root.bez-w;
        height: root.bez-h;
        big: root.wide;
    }
    Lcd {
        x: root.bez-x + 10px;
        y: 72px;
        width: root.bez-w - 20px;
        height: root.bez-h - 24px;
        big: root.wide;
        window-h: root.height;
        go(p) => { root.go(p); }
        ask-rename(n) => { root.ask-rename(n); }
        ask-delete(n) => { root.ask-delete(n); }
        refocus => { root.refocus(); }
    }

    // Portrait keys.
    if !root.wide: MenuKey {
        x: 20px;
        y: root.ctrl-y;
        width: root.key-w;
        height: 32px;
        go(p) => { root.go(p); }
    }
    if !root.wide: FindKey {
        x: root.width - 20px - root.key-w;
        y: root.ctrl-y;
        width: root.key-w;
        height: 32px;
    }
    if !root.wide: CallKey {
        x: 20px;
        y: root.ctrl-y + 44px;
        width: root.key-w;
        height: 32px;
        refocus => { root.refocus(); }
    }
    if !root.wide: EndKey {
        x: root.width - 20px - root.key-w;
        y: root.ctrl-y + 44px;
        width: root.key-w;
        height: 32px;
        refocus => { root.refocus(); }
    }
    if !root.wide: Rocker {
        x: (root.width - self.width) / 2;
        y: root.ctrl-y;
        step(d) => { root.step(d); }
        refocus => { root.refocus(); }
    }
    if !root.wide: Pad {
        x: 24px;
        y: root.ctrl-y + 84px;
        width: root.width - 48px;
        height: root.pad-h;
        rows: root.pad-rows;
        go(p) => { root.go(p); }
    }

    // Wide: the left wing.
    if root.wide: Cap {
        x: 28px;
        y: root.pad-y - 22px;
        width: 146px;
        text: "KEYPAD";
    }
    if root.wide: Pad {
        big: true;
        x: 28px;
        y: root.pad-y;
        width: 146px;
        height: 230px;
        go(p) => { root.go(p); }
    }
    // Under the LCD: the soft keys and a grille.
    if root.wide: MenuKey {
        big: true;
        x: root.bez-x + 10px;
        y: root.bez-bottom + 8px;
        width: 110px;
        height: 30px;
        go(p) => { root.go(p); }
    }
    if root.wide: FindKey {
        big: true;
        x: root.width - root.bez-x - 10px - 110px;
        y: root.bez-bottom + 8px;
        width: 110px;
        height: 30px;
    }
    if root.wide: Grille {
        x: (root.width - self.width) / 2;
        y: root.bez-bottom + 14px;
        cols: 7;
    }
    // The right wing: the rocker, the green key and the red key with their captions.
    if root.wide: Cap {
        x: root.width - 42px - 112px;
        y: root.wing-y;
        width: 112px;
        text: "CLIPS";
    }
    if root.wide: Rocker {
        big: true;
        x: root.width - 42px - 112px;
        y: root.wing-y + 22px;
        step(d) => { root.step(d); }
        refocus => { root.refocus(); }
    }
    if root.wide: CallKey {
        big: true;
        x: root.width - 30px - 136px;
        y: root.wing-y + 134px + 46px * root.k;
        width: 136px;
        height: 54px;
        refocus => { root.refocus(); }
    }
    if root.wide: Cap {
        x: root.width - 30px - 136px;
        y: root.wing-y + 196px + 46px * root.k;
        width: 136px;
        text: !Main.recording ? "CALL TO RECORD" : Main.paused ? "CALL TO RESUME" : "CALL TO PAUSE";
    }
    if root.wide: EndKey {
        big: true;
        x: root.width - 30px - 136px;
        y: root.wing-y + 206px + 74px * root.k;
        width: 136px;
        height: 42px;
        refocus => { root.refocus(); }
    }
    if root.wide: Cap {
        x: root.width - 30px - 136px;
        y: root.wing-y + 256px + 74px * root.k;
        width: 136px;
        text: "END TO STOP";
    }
    if root.wide: Grille {
        x: root.width - 56px - self.width;
        y: root.wing-y + 266px + 108px * root.k;
        cols: 6;
        rows: 2;
    }
}
