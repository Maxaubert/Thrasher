        { bg: #0a090c, card: #141118, row: #0c0a0f, raised: #1b1720, line: #29242e, line-soft: #1b1720, edge: #3a3440, text: #efe8f2, text2: #d9cfe0, muted: #a39aad, dim: #8d8496, accent: #ff7a1a, accent-hover: #ffb050, on-accent: #2a0d00, wave: #6f6880, wave-dim: #4a4452, track: #29242e, danger: #ff8f7a, hover: #241f2a, hover-soft: #1f1a24, row-hover: #120f15, picked: #2a1a10, popup: #1b1720, popup-edge: #5f5866, knob: #8d8496, faint: #7c7286, fainter: #4a4452, rec-rest: #6d3a20, divider: #1b1720, border: #29242e, card-edge: #29242e, footer: #0b0a0d, press: #3a2414, card-line: #00000000 },
        // Phonograph: mahogany and brass, ivory text (its main page is ui/skins/x-phono.slint).
        { bg: #1f0d07, card: #2e130b, row: #34160c, raised: #3d190d, line: #4a2412, line-soft: #3a1a0d, edge: #7a5717, text: #f1e6c9, text2: #e2d3ad, muted: #c9b48a, dim: #a88d63, accent: #d1a84f, accent-hover: #e6c46e, on-accent: #2b1a0e, wave: #8a6a3a, wave-dim: #5e4422, track: #3a1a0d, danger: #e0675a, hover: #4a1c10, hover-soft: #3f180d, row-hover: #2a1109, picked: #4f2a12, popup: #2e130b, popup-edge: #7a5717, knob: #b58a35, faint: #8a6a3a, fainter: #5e3a1c, rec-rest: #6e2a1a, divider: #3a1a0d, border: #4a2412, card-edge: #4a2412, footer: #1b0b06, press: #5e2614, card-line: #00000000 },
    ];
    out property <color> bg: root.palettes[root.current].bg;
    out property <color> card: root.palettes[root.current].card;
    out property <color> row: root.palettes[root.current].row;
    out property <color> raised: root.palettes[root.current].raised;
    out property <color> line: root.palettes[root.current].line;
    out property <color> line-soft: root.palettes[root.current].line-soft;
    out property <color> edge: root.palettes[root.current].edge;
    out property <color> text: root.palettes[root.current].text;
    out property <color> text2: root.palettes[root.current].text2;
    out property <color> muted: root.palettes[root.current].muted;
    out property <color> dim: root.palettes[root.current].dim;
    out property <color> accent: root.palettes[root.current].accent;
    out property <color> accent-hover: root.palettes[root.current].accent-hover;
    out property <color> on-accent: root.palettes[root.current].on-accent;
    out property <color> wave: root.palettes[root.current].wave;
    out property <color> wave-dim: root.palettes[root.current].wave-dim;
    out property <color> track: root.palettes[root.current].track;
    out property <color> danger: root.palettes[root.current].danger;
    out property <color> hover: root.palettes[root.current].hover;  // hovered button or row
    out property <color> hover-soft: root.palettes[root.current].hover-soft;  // hovered field
    out property <color> row-hover: root.palettes[root.current].row-hover;  // hovered clip row
    out property <color> picked: root.palettes[root.current].picked;  // clip picked for a merge
    out property <color> popup: root.palettes[root.current].popup;  // menus and tips
    out property <color> popup-edge: root.palettes[root.current].popup-edge;  // menu outline
    out property <color> knob: root.palettes[root.current].knob;  // switch knob when off
    out property <color> faint: root.palettes[root.current].faint;  // tenths of the timer while recording
    out property <color> fainter: root.palettes[root.current].fainter;  // tenths when idle
    out property <color> rec-rest: root.palettes[root.current].rec-rest;  // level bars at rest while recording
    out property <color> divider: root.palettes[root.current].divider;  // line between rows
    out property <color> border: root.palettes[root.current].border;  // card outline
    out property <color> card-edge: root.palettes[root.current].card-edge;  // transcript card outline
    out property <color> footer: root.palettes[root.current].footer;  // now playing bar
    out property <color> press: root.palettes[root.current].press;  // pressed download button
    out property <color> card-line: root.palettes[root.current].card-line;  // recorder and toolbar outline
    // The highlighted clip: Sakura tints it pink, the others keep it neutral.
    out property <color> selected-row: root.current == 4 ? root.accent.mix(root.row, 0.1) : root.row;
    out property <color> selected-edge: root.current == 4 ? root.accent.with-alpha(0.5) : root.edge;
    // Sakura and Kintsugi have a square seal for a record button.
    out property <bool> rec-square: root.current == 4 || root.current == 5;
    // Text fields: sunk into the window colour.
    out property <color> field: root.bg;
    out property <string> mono: "JetBrains Mono";
    // How the main page is built, one per palette in the order of `names`: 0 classic,
    // the look in ui/skins/classic.slint; 1 Tape Deck, ui/skins/tape.slint; 3 Desktop 95,
    // ui/skins/dv-os95.slint; 4 Comic Book, ui/skins/x-comic.slint; 6 Car Dashboard,
    // ui/skins/x-dash.slint; 7 Pocket, ui/skins/px-pocket.slint; 8 Quest Menu,
    // ui/skins/px-quest.slint; 9 Brick Phone, ui/skins/dv-brick.slint; 10 Answering
    // Machine, ui/skins/dv-answer.slint; 11 Pocket Synth, ui/skins/dv-synth.slint; 13 Cozy
    // Cabin, ui/skins/px-cozy.slint; 14 Pinball, ui/skins/x-pinball.slint; 15 Phonograph,
    // ui/skins/x-phono.slint. 2, 5 and 12 are free: Phosphor, Spatial Glass and Fighter
    // Select were removed (2026-11-06) and the other skins kept their numbers.
    out property <[int]> skins: [0, 0, 0, 0, 0, 0, 0, 0, 1, 3, 4, 6, 7, 8, 9, 10, 11, 13, 14, 15];
    out property <int> skin: root.skins[root.current];
    // How the other pages are built: 1 Tape Deck's (skins/tape-pages.slint), 3 Desktop 95's
    // (skins/dv-os95-pages.slint), 4 Comic Book's (skins/x-comic-pages.slint), 6 the Car
    // Dashboard's (skins/x-dash-pages.slint), 7 Pocket's (skins/px-pocket-pages.slint), 8 the Quest
    // Menu's (skins/px-quest-pages.slint), 9 the Brick Phone's (skins/dv-brick-pages.slint), 10 the
    // Answering Machine's (skins/dv-answer-pages.slint), 11 the Pocket Synth's
    // (skins/dv-synth-pages.slint), 13 the Cozy Cabin's (skins/px-cozy-pages.slint), 14
    // Pinball's (skins/x-pinball-pages.slint), 15 the Phonograph's (skins/x-phono-pages.slint),
    // else 0, the classic pages in the theme's palette
    // (also for skins whose pages are not built yet).
    // One comparison, not a chain of 13: Slint pastes a cheap global binding into every
    // read, so a long chain here was copied 36,000 times into the generated code (see
    // docs/device-themes.md, Generated code size). Skins 1 to 15 have their own pages.
    out property <int> pages: root.skin <= 15 ? root.skin : 0;
    // The Tape Deck skin: the shared widgets below draw their deck look for it.
    out property <bool> tape: root.skin == 1;
    // Desktop 95's pages: the shared widgets draw grey 95 bevels, checkboxes and menus.
    out property <bool> os95: root.pages == 3;
    // The height of a menu row: Desktop 95's and the Brick Phone's menus are tighter.
    out property <length> menu-h: root.os95 || root.pocket || root.brick ? 22px : root.quest ? 27px : root.answer ? 28px : root.synth ? 28px : root.cozy || root.pinball || root.phono ? 30px : 34px;
    // The space round a menu's rows: the Quest Menu's window frame is 9px.
    out property <length> menu-pad: root.quest ? 9px : 5px;
    // The Brick Phone's pages: the shared widgets draw ink on its amber LCD, menus as
    // numbered boxes with a double frame and a title bar.
    out property <bool> brick: root.pages == 9;
    // The title bar on top of a Brick Phone menu (else none).
    out property <length> menu-top: root.brick ? 24px : 0px;
    // The Comic Book skin: the shared widgets draw inked panels for it.
    out property <bool> comic: root.skin == 4;
    // The Car Dashboard skin: the shared widgets draw their glass and ice look for it.
    out property <bool> dash: root.pages == 6;
    // Pocket's pages: the shared widgets draw LCD keys, switches and windows on its green
    // LCD.
    out property <bool> pocket: root.pages == 7;
    // The Quest Menu's pages: the shared widgets draw pixel menu windows, keys and the glove.
    out property <bool> quest: root.pages == 8;
    // The Answering Machine's pages: the shared widgets draw rubber keys, cream picker
    // chips, slide switches and paper cards for it.
    out property <bool> answer: root.pages == 10;
    // The Pocket Synth: the shared widgets draw its keys, LED keys and black screens.
    out property <bool> synth: root.pages == 11;
    // The Cozy Cabin's pages: the shared widgets draw wooden keys, parchment notes in an ink
    // ring and latches (the Cz parts below).
    out property <bool> cozy: root.pages == 13;
    // Pinball's pages: the shared widgets draw chrome plates, the lit plasma key, lamp
    // switches and dark plates with a plasma top edge (the Pb parts below).
    out property <bool> pinball: root.pages == 14;
    // The Phonograph's pages: the shared widgets draw brass and ivory keys, lever switches
    // and ivory cards in a brass frame (the Pn parts below).
    out property <bool> phono: root.pages == 15;
}

// Pocket's colours and fonts (docs/mockups/device-themes/px-pocket.html and
// px-pocket-pages/), here so the shared widgets can draw its LCD look too.
export global Pk {
    // The LCD, light to dark.
    out property <color> l0: #c3ce7b;
    out property <color> l1: #8d9d49;
    out property <color> l2: #4e6127;
    out property <color> l3: #1a2710;
    // The plastic shell.
    out property <color> sh0: #c2c4b4;
    out property <color> sh1: #a6a897;
    out property <color> sh2: #7f8172;
    out property <color> sh3: #45473d;
    out property <color> sh-left: #b3b5a4;
    out property <color> sh-right: #96988a;
    // The screen surround.
    out property <color> sur: #34362f;
    out property <color> sur-lo: #25271f;
    out property <color> sur-hi: #44463d;
    out property <color> sur-ink: #7d806f;
    // The rubber keys.
    out property <color> key: #2f3c1a;
    out property <color> key-hi: #4e6127;
    out property <color> key-lo: #18210c;
    // The dark keys on the top edge.
    out property <color> hkey-hi: #5a5c50;
    out property <color> hkey-lo: #2e2f28;
    // Behind the handheld (the window corners).
    out property <color> page: #121410;
    out property <color> shade: #1e2019;
    out property <string> big: "Jersey 10";
    out property <string> small: "Pocket Small";
}

// Pocket's pixel icons by name, for the shared widgets (the empty image for a name it
// has none for, which then draws the line icon).
export global PkIcons {
    public pure function pick(name: string) -> image {
        return name == "play" ? @image-url("skins/px-pocket/play.png")
            : name == "pause" ? @image-url("skins/px-pocket/pause.png")
            : name == "stop" ? @image-url("skins/px-pocket/stop.png")
            : name == "close" ? @image-url("skins/px-pocket/x.png")
            : name == "dots" ? @image-url("skins/px-pocket/dots.png")
            : name == "grip" ? @image-url("skins/px-pocket/grip.png")
            : name == "pencil" ? @image-url("skins/px-pocket/pencil.png")
            : name == "trash" ? @image-url("skins/px-pocket/trash.png")
            : name == "folder" ? @image-url("skins/px-pocket/folder.png")
            : name == "plus" ? @image-url("skins/px-pocket/plus.png")
            : name == "export" ? @image-url("skins/px-pocket/up.png")
            : name == "languages" ? @image-url("skins/px-pocket/lang.png")
            : name == "sparkles" ? @image-url("skins/px-pocket/spark.png")
            : name == "copy" ? @image-url("skins/px-pocket/copy.png")
            : name == "check" ? @image-url("skins/px-pocket/tick.png")
            : name == "chevron" ? @image-url("skins/px-pocket/chev.png")
            : name == "back" ? @image-url("skins/px-pocket/back.png")
            : name == "search" ? @image-url("skins/px-pocket/find.png")
            : name == "down" ? @image-url("skins/px-pocket/down.png")
            : name == "expand" ? @image-url("skins/px-pocket/expand.png")
            : name == "loop" ? @image-url("skins/px-pocket/loop.png")
            : name == "mic" ? @image-url("skins/px-pocket/mics.png")
            : name == "message" ? @image-url("skins/px-pocket/ask.png")
            : @image-url("");
    }
}

// Pocket pixel art at a whole number of device pixels per art pixel, the nearest to `s`
// logical pixels, without smoothing.
export component PkPx inherits Image {
    in property <float> s: 2;
    property <length> u: max(1, round(root.s * 1px / 1phx)) * 1phx;
    width: self.source.width * self.u;
    height: self.source.height * self.u;
    image-fit: fill;
    image-rendering: pixelated;
}

// A Pocket tile (the dithers) repeated from the box's top left, one image pixel per
// logical pixel.
export component PkTile inherits Image {
    width: 100%;
    height: 100%;
    horizontal-tiling: repeat;
    vertical-tiling: repeat;
    horizontal-alignment: left;
    vertical-alignment: top;
}

// A ring of `w` pixels inside a box (the LCD keys' and windows' edges).
export component PkRing inherits Rectangle {
    in property <color> ink: Pk.l3;
    in property <length> w: 2px;
    Rectangle { x: 0; y: 0; width: parent.width; height: root.w; background: root.ink; }
    Rectangle { x: 0; y: parent.height - root.w; width: parent.width; height: root.w; background: root.ink; }
    Rectangle { x: 0; y: 0; width: root.w; height: parent.height; background: root.ink; }
    Rectangle { x: parent.width - root.w; y: 0; width: root.w; height: parent.height; background: root.ink; }
}

// The Quest Menu's colours and fonts (docs/mockups/device-themes/px-quest.html and
// px-quest-pages/), here so the shared widgets can draw its look too.
export global Quest {
    out property <color> ink: #0a0b1a;
    out property <color> win: #1c2b92;
    out property <color> win-hi: #2335a6;
    out property <color> win-mid: #1f2f9b;
    out property <color> win-lo: #15206f;
    out property <color> sel: #3049c9;
    out property <color> sel-hi: #4462e6;
    out property <color> sel-lo: #22379f;
    out property <color> white: #f4f1e6;
    out property <color> grey: #8d93b8;
    out property <color> dim: #5f679e;
    out property <color> gold: #ffd23f;
    out property <color> gold-lo: #b8860b;
    out property <color> hp: #4cd66b;
    out property <color> mp: #56a8ff;
    out property <color> red: #e5432f;
    out property <color> lred: #ff8a6a;
    out property <color> pale: #c9cdf0;
    out property <color> seg: #151d5c;
    out property <color> rule: #2a3486;
    out property <color> sep: #2a3aa8;
    out property <color> edge: #22264a;
    // The rule between the rows of a card.
    out property <color> row-rule: #1a2786;
    // A key that is off.
    out property <color> off: #141c63;
    out property <string> font: "Pixel 95";
    // Silkscreen 400 with a square 5 (its own 5 is two pixels from its S), shared with
    // Pocket and Brick Phone; the title is Silkscreen 700, which has no digits there.
    out property <string> label: "Pocket Small";
    out property <string> title: "Silkscreen";
    out property <string> figures: "Quest Figures";
}

// The Quest Menu's pixel art at a whole scale, without smoothing (1x cuts in
// skins/px-quest/, from tools/skin-art/px-quest.html).
export component QPx inherits Image {
    in property <float> s: 3;
    width: self.source.width * root.s * 1px;
    height: self.source.height * root.s * 1px;
    image-fit: fill;
    image-rendering: pixelated;
}

// The Quest Menu's pixel icons by the names the shared widgets use (empty when it has none).
export global QIcons {
    public pure function pick(name: string) -> image {
        return name == "plus" ? @image-url("skins/px-quest/plus.png")
            : name == "pencil" ? @image-url("skins/px-quest/pencil.png")
            : name == "export" ? @image-url("skins/px-quest/up.png")
            : name == "trash" ? @image-url("skins/px-quest/trash.png")
            : name == "folder" ? @image-url("skins/px-quest/folder.png")
            : name == "languages" ? @image-url("skins/px-quest/lang.png")
            : name == "sparkles" ? @image-url("skins/px-quest/spark.png")
            : name == "copy" ? @image-url("skins/px-quest/copy.png")
            : name == "check" ? @image-url("skins/px-quest/tick.png")
            : name == "close" ? @image-url("skins/px-quest/x.png")
            : name == "back" ? @image-url("skins/px-quest/back.png")
            : name == "chevron" ? @image-url("skins/px-quest/chev.png")
            : name == "play" ? @image-url("skins/px-quest/play.png")
            : name == "pause" ? @image-url("skins/px-quest/pause.png")
            : name == "stop" ? @image-url("skins/px-quest/stop.png")
            : name == "dots" ? @image-url("skins/px-quest/dots.png")
            : name == "expand" ? @image-url("skins/px-quest/expand.png")
            : name == "search" ? @image-url("skins/px-quest/search.png")
            : name == "rewind" ? @image-url("skins/px-quest/rew.png")
            : name == "forward" ? @image-url("skins/px-quest/ff.png")
            : name == "grip" ? @image-url("skins/px-quest/grip.png")
            : name == "down" ? @image-url("skins/px-quest/down.png")
            : name == "import" ? @image-url("skins/px-quest/imp.png")
            : name == "message" ? @image-url("skins/px-quest/ask.png")
            : name == "widget" ? @image-url("skins/px-quest/widget.png")
            : @image-url("");
    }
}

// The face of a Quest Menu key: a 3px ink ring with its corners cut, round a dark blue
// face. `kind`: 0 plain, 1 the main action (lit blue, a light top and a dark bottom
// row), 2 red (Delete), 3 off, 4 on (lit blue). A hovered plain key lights.
export component QFace inherits Rectangle {
    in property <int> kind;
    in property <bool> hover;
    property <bool> lit: root.kind == 1 || root.kind == 2;
    Rectangle { x: 3px; y: 0; width: parent.width - 6px; height: parent.height; background: Quest.ink; }
    Rectangle { x: 0; y: 3px; width: parent.width; height: parent.height - 6px; background: Quest.ink; }
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        background: root.kind == 2 ? (root.hover ? #f0684f : Quest.red) : root.kind == 1 ? (root.hover ? Quest.sel-hi : Quest.sel)
            : root.kind == 4 ? Quest.sel : root.kind == 3 ? Quest.off : root.hover ? Quest.sel : Quest.win-lo;
    }
    Rectangle { visible: root.lit; x: 3px; y: 3px; width: parent.width - 6px; height: 3px; background: root.kind == 2 ? #f0684f : Quest.sel-hi; }
    Rectangle { visible: root.lit; x: 3px; y: parent.height - 6px; width: parent.width - 6px; height: 3px; background: root.kind == 2 ? #a92a1c : Quest.sel-lo; }
}

// A Quest Menu window floating over the page (menus, lists, tips): an ink ring with cut
// corners, a white (or gold) ring, a grey (or dark gold) ring and the blue face, lighter
// at the top and darker at the bottom. The content sits 9px in.
export component QFrame inherits Rectangle {
    in property <bool> gold;
    property <color> outer: root.gold ? Quest.gold : Quest.white;
    property <color> inner: root.gold ? Quest.gold-lo : Quest.grey;
    Rectangle { x: 3px; y: 0; width: parent.width - 6px; height: parent.height; background: Quest.ink; }
    Rectangle { x: 0; y: 3px; width: parent.width; height: parent.height - 6px; background: Quest.ink; }
    Rectangle { x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; background: root.outer; }
    Rectangle { x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px; background: root.inner; }
    Rectangle { x: 9px; y: 9px; width: parent.width - 18px; height: 6px; background: Quest.win-hi; }
    Rectangle { x: 9px; y: 15px; width: parent.width - 18px; height: 6px; background: Quest.win-mid; }
    Rectangle { x: 9px; y: 21px; width: parent.width - 18px; height: max(0px, parent.height - 39px); background: Quest.win; }
    Rectangle { x: 9px; y: max(21px, parent.height - 18px); width: parent.width - 18px; height: min(9px, max(0px, parent.height - 30px)); background: Quest.win-lo; }
}

// The lit row of a Quest Menu list: the light blue bar with a light top and a dark
// bottom row, and the glove pointing at it from the left.
export component QLit inherits Rectangle {
    in property <bool> glove: true;
    Rectangle { x: 0; y: 0; background: Quest.sel; }
    Rectangle { x: 0; y: 0; height: 3px; background: Quest.sel-hi; }
    Rectangle { x: 0; y: parent.height - 3px; height: 3px; background: Quest.sel-lo; }
    QPx {
        visible: root.glove;
        x: 1px;
        y: (parent.height - self.height) / 2;
        source: @image-url("skins/px-quest/hand.png");
    }
}

// The Answering Machine's colours (docs/mockups/device-themes/dv-answer.html and
// dv-answer-pages/), here so the shared widgets can draw its look too.
export global Am {
    out property <color> print: #5b4f3d;
    out property <color> print-soft: #86795f;
    out property <color> logo: #6e624d;
    out property <color> edge: #a89b7f;
    out property <color> paper: #efe8d8;
    out property <color> paper-line: #d6cab0;
    out property <color> smoke: #1b1311;
    out property <color> led: #ff4630;
    // The unlit segments: the mockup's rgba(255,70,48,.09) on the smoked display.
    out property <color> led-dim: #ff46301a;
    out property <color> rec: #cf3c28;
    out property <color> ink: #2f271e;
    out property <color> ink2: #3c3227;
    out property <color> key-ink: #ece4d8;
    out property <color> rec-ink: #fff3ec;
    out property <color> disp-ink: #d9b9ab;
    out property <color> lab: #9f7f72;
    out property <color> green: #7fd15a;
    out property <color> amber: #ffb22e;
    out property <color> bar-off: #3a2a24;
    out property <color> wave: #8b7c63;
    out property <brush> body: @linear-gradient(180deg, #e8dfcb 0%, #d9cfb9 30%, #bfb399 100%);
    out property <brush> foot: @linear-gradient(180deg, #cfc4ac 0%, #bcb096 100%);
    // The other pages: the smoked display's top colour, the paper's outline, the rule
    // under a paper head, a lit row, the cream of a picker chip and of a label field.
    out property <color> smoke2: #2a1d19;
    out property <color> paper-edge: #b4a789;
    out property <color> rule: #c9a99c;
    out property <color> lit: #f6ddd2;
    out property <color> chip-hi: #f3ecdc;
    out property <color> chip-lo: #e1d7c1;
    out property <color> chip-lip: #94876c;
    out property <color> cream: #f6f0e2;
    out property <color> name-ink: #3e3428;
}

// A body with a vertical gradient and round corners, which the software renderer cannot
// draw in one piece (gradients ignore the corners): solid caps as tall as the corners at
// the top and the bottom and a square gradient between them, starting and ending on the
// caps' colours. The Answering Machine's rubber keys, picker chips and smoked displays.
export component AmFace inherits Rectangle {
    in property <color> top;
    in property <color> bottom;
    in property <length> r;
    property <length> cap: min(root.height / 2, root.r);
    Rectangle { x: 0; y: 0; width: parent.width; height: 2 * root.cap; border-radius: root.r; background: root.top; }
    Rectangle { x: 0; y: parent.height - 2 * root.cap; width: parent.width; height: 2 * root.cap; border-radius: root.r; background: root.bottom; }
    Rectangle {
        x: 0;
        y: root.cap;
        width: parent.width;
        height: max(0px, parent.height - 2 * root.cap);
        background: @linear-gradient(180deg, root.top 0%, root.bottom 100%);
    }
}

// The Answering Machine's rubber key, the face shifted down onto its lip while it is held
// or latched. `kind`: 0 rubber, 1 red. The lip and the shadow hang under the key's box, as
// the mockup's box-shadow does. Used by the shared widgets and the skin's pages.
export component AmKey inherits Rectangle {
    in property <int> kind;
    in property <bool> down;
    in property <bool> hover;
    in property <bool> enabled: true;
    in property <length> r: 9px;
    in property <length> lip: 2.5px;
    property <bool> red: root.kind == 1;
    property <length> sink: root.down ? root.lip - 0.5px : 0;
    Rectangle {
        visible: !root.down;
        x: 0;
        y: root.lip + 1.5px;
        width: parent.width;
        height: parent.height;
        border-radius: root.r;
        background: #00000024;
    }
    Rectangle {
        x: 0;
        y: root.sink + (root.down ? 0.5px : root.lip);
        width: parent.width;
        height: parent.height;
        border-radius: root.r;
        background: !root.enabled ? (root.red ? #9b6458 : #57514a) : root.red ? #9a2617 : #2f2b27;
    }
    AmFace {
        x: 0;
        y: root.sink;
        width: parent.width;
        height: parent.height;
        r: root.r;
        top: !root.enabled ? (root.red ? #c98d80 : #7d766f) : root.red ? #e55a43 : #635c56;
        bottom: !root.enabled ? (root.red ? #b9786a : #6d665f) : root.red ? #b8311f : #433d38;
    }
    Rectangle {
        x: root.r * 0.7;
        y: root.sink + 1px;
        width: parent.width - root.r * 1.4;
        height: 1px;
        background: root.red ? #ffffff4d : #ffffff2e;
    }
    Rectangle {
        visible: root.down;
        x: 0;
        y: root.sink;
        width: parent.width;
        height: parent.height;
        border-radius: root.r;
        background: #00000026;
    }
    Rectangle {
        visible: root.hover && root.enabled && !root.down;
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: root.r;
        background: #ffffff14;
    }
}

// The Answering Machine's cream picker chip: a 1px outline, a darker lip under it and a
// white light along its top.
export component AmChip inherits Rectangle {
    in property <bool> hover;
    in property <bool> focused;
    in property <length> r: 6px;
    Rectangle { x: -1px; y: 0.5px; width: parent.width + 2px; height: parent.height + 2px; border-radius: root.r + 1px; background: Am.chip-lip; }
    Rectangle { x: -1px; y: -1px; width: parent.width + 2px; height: parent.height + 2px; border-radius: root.r + 1px; background: root.focused ? Am.rec : Am.edge; }
    AmFace { x: 0; y: 0; width: parent.width; height: parent.height; r: root.r; top: Am.chip-hi; bottom: Am.chip-lo; }
    Rectangle { x: root.r; y: 1px; width: parent.width - 2 * root.r; height: 1px; background: #ffffff; }
    Rectangle { visible: root.hover; x: 0; y: 0; width: parent.width; height: parent.height; border-radius: root.r; background: #ffffff40; }
}

// The Answering Machine's smoked display: the dark glass with its sheen, in the beige
// rim of the plastic.
export component AmSmoke inherits Rectangle {
    in property <length> r: 5px;
    Rectangle { x: -1.5px; y: -1.5px; width: parent.width + 3px; height: parent.height + 3px; border-radius: root.r + 1.5px; background: #a39679; }
    AmFace { x: 0; y: 0; width: parent.width; height: parent.height; r: root.r; top: Am.smoke2; bottom: Am.smoke; }
    Rectangle { x: root.r; y: 0; width: parent.width - 2 * root.r; height: 2px; background: #00000059; }
}

// Desktop 95's colours (docs/mockups/device-themes/dv-os95.html and dv-os95-pages/), here so
// the shared widgets can draw its look too.
export global Os {
    out property <color> face: #c0c0c0;
    out property <color> hi: #ffffff;
    out property <color> lt: #dfdfdf;
    out property <color> sh: #808080;
    out property <color> dk: #0a0a0a;
    out property <color> navy: #0a1f7a;
    out property <color> desk: #127170;
    out property <color> scope: #3cff6a;
    out property <color> ink2: #333333;
    out property <color> note: #555555;
    out property <color> red: #e0201b;
    out property <color> tag: #1c3fa8;
    out property <color> tip: #ffffe1;
    out property <brush> active: @linear-gradient(90deg, #0a1f7a 0%, #2f8fd6 100%);
    out property <brush> inactive: @linear-gradient(90deg, #7b7b7b 0%, #b4b4b4 100%);
    out property <string> font: "Pixel 95";
}

// The two pixel lines round a 95 box. Kind 0 raised (a window or a key), 1 pressed, 2 sunken
// (a field), 3 thinly sunken (a status bar cell), 4 etched (a group box), 5 thinly raised,
// 6 the default button (a black ring round the raised key).
export component OsBevel inherits Rectangle {
    in property <int> kind;
    property <int> k: root.kind == 6 ? 0 : root.kind;
    property <length> o: root.kind == 6 ? 1px : 0;
    property <color> o-tl: root.k == 0 ? Os.hi : root.k == 1 ? Os.dk : root.k == 5 ? Os.hi : Os.sh;
    property <color> o-br: root.k == 0 ? Os.dk : root.k == 5 ? Os.sh : Os.hi;
    property <color> i-tl: root.k == 0 ? Os.lt : root.k == 1 ? Os.sh : root.k == 2 ? Os.dk : Os.hi;
    property <color> i-br: root.k == 0 ? Os.sh : root.k == 4 ? Os.sh : Os.lt;
    property <bool> one: root.k == 3 || root.k == 5;
    Rectangle {
        visible: root.kind == 6;
        border-width: 1px;
        border-color: Os.dk;
    }
    Rectangle {
        x: root.o;
        y: root.o;
        width: parent.width - 2 * root.o;
        height: parent.height - 2 * root.o;
        Rectangle { visible: !root.one; x: 1px; y: 1px; width: parent.width - 2px; height: 1px; background: root.i-tl; }
        Rectangle { visible: !root.one; x: 1px; y: 1px; width: 1px; height: parent.height - 2px; background: root.i-tl; }
        Rectangle { visible: !root.one; x: 1px; y: parent.height - 2px; width: parent.width - 2px; height: 1px; background: root.i-br; }
        Rectangle { visible: !root.one; x: parent.width - 2px; y: 1px; width: 1px; height: parent.height - 2px; background: root.i-br; }
        Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: root.o-tl; }
        Rectangle { x: 0; y: 0; width: 1px; height: parent.height; background: root.o-tl; }
        Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: root.o-br; }
        Rectangle { x: parent.width - 1px; y: 0; width: 1px; height: parent.height; background: root.o-br; }
    }
}

// A 95 pixel icon at a whole scale of its art, without smoothing.
export component OsPx inherits Image {
    in property <float> s: 1;
    width: self.source.width * root.s * 1px;
    height: self.source.height * root.s * 1px;
    image-fit: fill;
    image-rendering: pixelated;
}

// The dotted focus line round a 95 control or a highlighted row: a checker tile in one colour.
export component OsDotted inherits Rectangle {
    // Pure black did not colorize in the off-screen preview (the image stayed white).
    in property <color> tint: #010101;
    property <bool> hi: 1phx < 0.7px;
    property <image> tile: root.hi ? @image-url("skins/dv-os95/checker@2x.png") : @image-url("skins/dv-os95/checker.png");
    Image { x: 0; y: 0; width: parent.width; height: 1px; source: root.tile; colorize: root.tint; horizontal-tiling: repeat; vertical-tiling: repeat; horizontal-alignment: left; vertical-alignment: top; }
    Image { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; source: root.tile; colorize: root.tint; horizontal-tiling: repeat; vertical-tiling: repeat; horizontal-alignment: left; vertical-alignment: top; }
    Image { x: 0; y: 0; width: 1px; height: parent.height; source: root.tile; colorize: root.tint; horizontal-tiling: repeat; vertical-tiling: repeat; horizontal-alignment: left; vertical-alignment: top; }
    Image { x: parent.width - 1px; y: 0; width: 1px; height: parent.height; source: root.tile; colorize: root.tint; horizontal-tiling: repeat; vertical-tiling: repeat; horizontal-alignment: left; vertical-alignment: top; }
}

// A 95 pixel icon for one of the shared icon names, for the buttons and menus that take an
// icon by name; empty for a name it has no picture for.
export global OsIcons {
    public pure function pick(name: string) -> image {
        return name == "plus" ? @image-url("skins/dv-os95/plus.png")
            : name == "pencil" ? @image-url("skins/dv-os95/pen.png")
            : name == "export" ? @image-url("skins/dv-os95/up.png")
            : name == "trash" ? @image-url("skins/dv-os95/bin.png")
            : name == "folder" ? @image-url("skins/dv-os95/fopen.png")
            : name == "languages" ? @image-url("skins/dv-os95/globe.png")
            : name == "sparkles" ? @image-url("skins/dv-os95/spark.png")
            : name == "copy" ? @image-url("skins/dv-os95/copy.png")
            : name == "check" ? @image-url("skins/dv-os95/tick.png")
            : name == "close" ? @image-url("skins/dv-os95/x7.png")
            : name == "back" ? @image-url("skins/dv-os95/playl.png")
            : name == "chevron" ? @image-url("skins/dv-os95/play.png")
            : name == "play" ? @image-url("skins/dv-os95/play.png")
            : name == "pause" ? @image-url("skins/dv-os95/pause.png")
            : name == "dots" ? @image-url("skins/dv-os95/dots.png")
            : name == "expand" ? @image-url("skins/dv-os95/expand.png")
            : name == "search" ? @image-url("skins/dv-os95/mag.png")
            : name == "rewind" ? @image-url("skins/dv-os95/rew.png")
            : name == "forward" ? @image-url("skins/dv-os95/ff.png")
            : @image-url("");
    }
}

// The Comic Book's inks and papers (docs/mockups/device-themes/x-comic.html and
// x-comic-pages/). Here, so the shared widgets can draw the comic look too.
export global Comic {
    out property <color> ink: #141010;
    out property <color> paper: #fdf4dc;
    out property <color> paper2: #f6e8c3;
    out property <color> red: #e3342f;
    out property <color> yellow: #ffd43b;
    out property <color> blue: #2a6fdb;
    out property <color> cyan: #7cc6ee;
    out property <color> grey: #b9ad93;
    out property <color> sub: #6d6452;
    out property <color> sub-on-yellow: #5a4400;
    // A hovered menu line, a hovered hit and a pale pick.
    out property <color> wash: #fff1b0;
    out property <color> pale: #fff4c2;
    // Words that are greyed: a pending word, a placeholder.
    out property <color> faint: #9a8f78;
    // The rule between the lines of a card.
    out property <color> rule: #eadfc4;
}

// A comic panel's hard ink shadow: a solid copy of the box `off` down and right, drawn
// before the face (children of a popup may draw outside it).
export component InkShadow inherits Rectangle {
    in property <length> off: 3px;
    in property <length> radius: 0;
    x: root.off;
    y: root.off;
    background: Comic.ink;
    border-radius: root.radius;
}

// The Tape Deck's colours and key faces, from its mockups (docs/mockups/device-themes/
// tape.html and tape-pages/). Here, so the shared widgets can draw the deck look too.
export global Deck {
    out property <color> cream: #efe3c8;
    out property <color> cream2: #e2d3b2;
    out property <color> ink: #2a1c12;
    out property <color> ink-soft: #6b5644;
    out property <color> hand: #24170e;
    out property <color> alu-ink: #3b342c;
    out property <color> key-ink: #3a3129;
    out property <color> red: #c9331f;
    out property <color> amber: #f2a64a;
    out property <color> chassis: #22170f;
    out property <color> chassis2: #1a120c;
    out property <color> slot: #120c08;
    out property <color> rail: #cdb68f;
    // The colour bands of the tape spines, in turn.
    out property <[color]> bands: [#c9331f, #d99a2b, #3f7c74, #7a4a2a, #2f5a8a];
    out property <brush> key-face: @linear-gradient(180deg, #ece7dc 0%, #c9c1b2 78%, #8f8778 78%, #6f685b 100%);
    out property <brush> key-down: @linear-gradient(180deg, #d9d3c6 0%, #bdb5a6 88%, #8f8778 88%, #6f685b 100%);
    out property <brush> latch-down: @linear-gradient(180deg, #b9b1a3 0%, #a39b8d 86%, #6f685b 86%, #5c5549 100%);
    out property <brush> amber-face: @linear-gradient(180deg, #ffc27a 0%, #f2a64a 40%, #cf8424 78%, #8a5414 78%, #6e430f 100%);
    out property <brush> rec-face: @linear-gradient(180deg, #e2543a 0%, #c9331f 40%, #a72614 78%, #6e170b 78%, #55120a 100%);
    out property <brush> rec-down: @linear-gradient(180deg, #c9452d 0%, #b22c18 40%, #921f10 82%, #6e170b 82%, #55120a 100%);
    out property <brush> dark-face: @linear-gradient(180deg, #3a2d22 0%, #2a1f17 80%, #17100b 80%, #0e0906 100%);
    out property <brush> cream-card: @linear-gradient(180deg, #f4ead3 0%, #e2d3b2 100%);
    out property <brush> cream-sub: @linear-gradient(180deg, #e9dbbc 0%, #d8c7a2 100%);
    out property <brush> spine: @linear-gradient(180deg, #efe3c8 0%, #e2d3b2 100%);
    out property <brush> spine-out: @linear-gradient(180deg, #fff6e2 0%, #f1e2c1 100%);
    out property <brush> alu: @linear-gradient(180deg, #dcd6ca 0%, #bdb5a7 70%, #a9a193 100%);
    out property <brush> dymo: @linear-gradient(180deg, #1b1b1d 0%, #0b0b0c 100%);
    out property <brush> dymo-red: @linear-gradient(180deg, #d4442c 0%, #a72614 100%);
    out property <brush> brass: @linear-gradient(180deg, #e3c58a 0%, #b48c4b 100%);
}






// The Brick Phone's colours and fonts (docs/mockups/device-themes/dv-brick.html and
// dv-brick-pages/): charcoal rubber, the amber LCD and its ink. Here, so the shared widgets
// can draw the LCD look too; the skin's pages import it.
export global Brick {
    out property <color> bg: #101010;
    out property <color> p1: #55585e;
    out property <color> p2: #33353a;
    out property <color> p3: #232428;
    out property <color> silver: #c9ccd1;
    out property <color> label: #8d9097;
    out property <color> amber: #ffb24a;
    out property <color> lcd1: #f6bf5e;
    out property <color> lcd2: #e39a33;
    out property <color> ink: #3b1f05;
    out property <color> ink2: #3b1f059e;
    out property <color> ghost: #3b1f0521;
    out property <color> rule: #3b1f0559;
    out property <color> bezel: #111214;
    out property <color> on-green: #eaffea;
    out property <color> on-red: #ffe7e2;
    out property <color> close: #f08a7c;
    out property <string> words: "VT323";
    out property <string> caps: "Pocket Small";
    out property <string> keys: "Chakra Petch";
    out property <string> figures: "Brick Figures";
}

// The Brick Phone's pixel glyphs by the names of the line icons (Icon), white for colorize,
// drawn at whole scales (BrickPx). An unknown name gives no picture.
export global BrickIcons {
    public pure function pick(name: string) -> image {
        return name == "plus" ? @image-url("skins/dv-brick/x-plus.png")
            : name == "pencil" ? @image-url("skins/dv-brick/x-pencil.png")
            : name == "export" ? @image-url("skins/dv-brick/x-box.png")
            : name == "trash" ? @image-url("skins/dv-brick/x-trash.png")
            : name == "check" ? @image-url("skins/dv-brick/x-check.png")
            : name == "chevron" ? @image-url("skins/dv-brick/x-rt.png")
            : name == "back" ? @image-url("skins/dv-brick/x-lf.png")
            : name == "close" ? @image-url("skins/dv-brick/x-x.png")
            : name == "languages" ? @image-url("skins/dv-brick/x-lang.png")
            : name == "sparkles" ? @image-url("skins/dv-brick/x-spark.png")
            : name == "copy" ? @image-url("skins/dv-brick/x-copy.png")
            : name == "folder" ? @image-url("skins/dv-brick/x-folder.png")
            : name == "play" ? @image-url("skins/dv-brick/x-play.png")
            : name == "pause" ? @image-url("skins/dv-brick/x-pause.png")
            : name == "search" ? @image-url("skins/dv-brick/x-mag.png")
            : name == "grip" ? @image-url("skins/dv-brick/x-grip.png")
            : name == "loop" ? @image-url("skins/dv-brick/x-loop.png")
            : name == "down" ? @image-url("skins/dv-brick/x-chev.png")
            : name == "up" ? @image-url("skins/dv-brick/x-up.png")
            : name == "dots" ? @image-url("skins/dv-brick/x-dots.png")
            : name == "message" ? @image-url("skins/dv-brick/x-speak.png")
            : name == "speak" ? @image-url("skins/dv-brick/x-speak.png")
            : name == "hour" ? @image-url("skins/dv-brick/x-hour.png")
            : @image-url("");
    }
}

// A Brick Phone pixel glyph at a whole scale of its art, without smoothing, in one colour.
export component BrickPx inherits Image {
    in property <float> s: 1;
    in property <color> tint: Brick.ink;
    width: self.source.width * root.s * 1px;
    height: self.source.height * root.s * 1px;
    image-fit: fill;
    image-rendering: pixelated;
    colorize: root.tint;
}

// The Brick Phone's place number: a digit inverted in a small square (menus, sections,
// order rows, sources); `lit` turns it amber on ink (a hovered menu line).
export component BrickNum inherits Rectangle {
    in property <string> text;
    in property <bool> lit;
    in property <length> size: 13px;
    width: max(root.size, num.preferred-width + 4px);
    height: root.size;
    background: root.lit ? Brick.lcd1 : Brick.ink;
    num := Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.lit ? Brick.ink : Brick.lcd1;
        font-family: Brick.caps;
        font-size: 8px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// The Brick Phone's menu frame over a MenuCard: an amber ring outside the ink edge, the inner
// ink line of the double frame and the title bar. Its own component, so the menus (whose
// card is inlined wherever it is used) share its code.
export component BrickMenuFrame inherits Rectangle {
    in property <string> title;
    in property <length> title-indent;
    Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-width: 2px;
        border-color: Brick.lcd1;
    }
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-width: 1px;
        border-color: Brick.ink;
    }
    if root.title != "": Rectangle {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: 20px;
        background: Brick.ink;
        Text {
            x: 8px + root.title-indent;
            y: 0;
            width: parent.width - 16px - root.title-indent;
            height: parent.height;
            text: root.title;
            color: Brick.lcd1;
            font-family: Brick.words;
            font-size: 18px;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
}

// A Brick Phone glyph by an icon's name (BrickIcons), centred in its box; `has` says
// whether there is one for the name.
export component BrickGlyph inherits Rectangle {
    in property <string> name;
    in property <color> tint: Brick.ink;
    in property <length> shift;
    property <image> pic: BrickIcons.pick(root.name);
    out property <bool> has: root.pic.width > 0;
    BrickPx {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + root.shift;
        source: root.pic;
        tint: root.tint;
    }
}

// The Brick Phone's scroll bar on a Scroller: a ruled track between two ink lines and a
// solid thumb; drag it.
export component BrickBar inherits Rectangle {
    in-out property <length> content-y;
    in property <length> content-h;
    in property <length> view-h;
    property <length> range: root.content-h - root.view-h;
    property <length> th: root.range > 1px ? max(14px, root.height * root.view-h / max(root.content-h, 1px)) : root.height;
    width: 5px;
    Rectangle { x: 0; width: 1px; background: Brick.ink; }
    Rectangle { x: parent.width - 1px; width: 1px; background: Brick.ink; }
    Image {
        x: 1px;
        y: 0;
        width: 3px;
        height: parent.height;
        source: @image-url("skins/dv-brick/t-rule.png");
        colorize: Brick.ghost;
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        horizontal-alignment: left;
        vertical-alignment: top;
    }
    thumb := Rectangle {
        // Nothing to scroll: no thumb, just the ruled track.
        visible: root.range > 1px;
        y: root.range > 1px ? (-root.content-y / root.range) * (root.height - root.th) : 0;
        height: root.th;
        background: Brick.ink;
        TouchArea {
            x: -4px;
            width: parent.width + 8px;
            enabled: root.range > 1px;
            moved => {
                if (self.pressed) {
                    root.content-y = clamp(-(thumb.y + self.mouse-y - self.pressed-y) / max(1px, root.height - root.th) * root.range, -root.range, 0);
                }
            }
        }
    }
}

// A key of the Pocket Synth (docs/mockups/device-themes/dv-synth-pages/), its body drawn
// as the pads of its main page are: a soft shadow (a nine-slice picture of the main page's
// pad shadow), a hard lip under it, solid rounded caps of its two colours with the
// gradient between them, the white inner ring and the top light line. `kind`: 0 the white
// cap, 1 orange, 2 dark, 3 orange and glowing; `down` holds it in (a latched key).
export component SynKey inherits Rectangle {
    in property <int> kind;
    in property <bool> down;
    in property <bool> pressed;
    in property <bool> hover;
    in property <bool> enabled: true;
    in property <length> radius: 7px;
    // A round key (the menu and close keys): a 1px lip and no soft shadow.
    in property <bool> round;
    property <bool> sunk: root.down || (root.pressed && root.enabled);
    property <bool> lit: root.kind == 1 || root.kind == 3;
    property <length> r: root.round ? root.height / 2 : min(root.radius, root.height / 2);
    property <color> c1: root.lit ? #ff6a30 : root.kind == 2 ? #3a3a38 : root.round ? #f7f6f2 : #f6f5f1;
    property <color> c2: root.lit ? #e94a12 : root.kind == 2 ? #1f1f1e : root.round ? #dfdcd5 : #e6e4de;
    property <color> lip: root.lit ? #a8360b : root.kind == 2 ? #0f0f0e : root.round ? #aeaa9f : #b3afa5;
    Image {
        visible: !root.sunk && !root.round && root.kind != 3;
        x: -12px;
        y: -12px;
        width: root.width + 24px;
        height: root.height + 24px;
        source: @image-url("skins/dv-synth/pad-shade.png", nine-slice(22 22 22 22));
    }
    Image {
        visible: root.kind == 3;
        x: -20px;
        y: -20px;
        width: root.width + 40px;
        height: root.height + 40px;
        source: @image-url("skins/dv-synth/pad-glow.png", nine-slice(30 30 30 30));
    }
    Rectangle {
        x: 0;
        y: root.sunk ? 1px : (root.round ? 1px : 2px);
        width: root.width;
        height: root.height;
        border-radius: root.r;
        background: root.lip;
    }
    Rectangle {
        x: 0;
        y: root.sunk ? 1px : 0;
        width: root.width;
        height: root.height;
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.r;
            border-top-left-radius: root.r;
            border-top-right-radius: root.r;
            background: root.round ? root.c1.mix(root.c2, 0.5) : root.c1;
        }
        Rectangle {
            x: 0;
            y: root.r;
            width: parent.width;
            height: max(0px, parent.height - 2 * root.r);
            background: @linear-gradient(180deg, root.c1 0%, root.c2 100%);
        }
        Rectangle {
            x: 0;
            y: parent.height - root.r;
            width: parent.width;
            height: root.r;
            border-bottom-left-radius: root.r;
            border-bottom-right-radius: root.r;
            background: root.round ? root.c1.mix(root.c2, 0.5) : root.c2;
        }
        Rectangle {
            visible: root.kind == 0;
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            border-radius: root.r;
            border-width: 1px;
            border-color: root.round ? #cdc9c0 : #d2cfc7;
        }
        Rectangle {
            visible: !root.round && !root.sunk;
            x: root.r * 0.6;
            y: root.lit || root.kind == 2 ? 0 : 1px;
            width: parent.width - root.r * 1.2;
            height: 1px;
            background: root.lit ? #ff9a6e : root.kind == 2 ? #555555 : #ffffff;
        }
        Rectangle {
            visible: root.hover && root.enabled;
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            border-radius: root.r;
            background: root.pressed ? #00000014 : root.lit || root.kind == 2 ? #ffffff1a : #0000000a;
        }
    }
}

// A black screen of the Pocket Synth drawn round its box: the grey rim, the dark bezel
// (orange while it is typed on) and the black face.
export component SynScreen inherits Rectangle {
    in property <length> radius: 7px;
    in property <length> bezel: 3px;
    in property <bool> hot;
    Rectangle {
        x: -root.bezel - 1px;
        y: -root.bezel - 1px;
        width: root.width + 2 * root.bezel + 2px;
        height: root.height + 2 * root.bezel + 2px;
        border-radius: root.radius + root.bezel + 1px;
        background: root.bezel > 2px ? #9a968c : #a19d93;
    }
    Rectangle {
        x: -root.bezel;
        y: -root.bezel;
        width: root.width + 2 * root.bezel;
        height: root.height + 2 * root.bezel;
        border-radius: root.radius + root.bezel;
        background: root.hot ? #ff5a1e : root.bezel > 2px ? #222221 : #262625;
    }
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: root.radius;
        background: #0b0c0c;
    }
    @children
}









// The Cozy Cabin's colours and fonts (docs/mockups/device-themes/px-cozy-pages/), here so
// the shared widgets can draw its wooden keys, parchment notes and latches too. The main
// page keeps its own copy (`C` in skins/px-cozy.slint).
export global Cz {
    out property <color> ink: #2a170d;
    out property <color> wood-dd: #3a2213;
    out property <color> wood-d: #5a341d;
    out property <color> wood: #7a4a28;
    out property <color> wood-l: #9a6234;
    out property <color> wood-hl: #c08a4e;
    out property <color> slot: #2f1b0f;
    out property <color> slot-hl: #4d2e19;
    out property <color> honey: #f0b23c;
    out property <color> honey-l: #ffd982;
    out property <color> honey-d: #b97a1c;
    out property <color> ember: #e0662c;
    out property <color> ember-l: #f08a52;
    out property <color> ember-d: #9a3c18;
    out property <color> moss: #6f9238;
    out property <color> moss-l: #a3c25a;
    out property <color> moss-d: #4c6c20;
    out property <color> cream: #f6e7c4;
    out property <color> parch: #ead4a2;
    out property <color> parch-d: #c8a56a;
    out property <color> parch-dd: #9c7a45;
    out property <color> parch-hl: #fff3d6;
    out property <color> dim: #c9a77a;
    out property <color> brown: #6b4a28;
    out property <color> well: #3b2414;
    out property <color> well-lo: #22130a;
    // A hovered line on parchment.
    out property <color> hover: #f6e2b0;
    out property <string> font: "Pixel 95";
    out property <string> title: "Jersey 10";
    out property <string> caps: "Tiny5";
    out property <string> figures: "Cozy Figures";
    // A key's face, its light top left and dark bottom right, and its words, by `kind`:
    // 0 wood, 1 honey (the main action), 2 ember (deleting, merging), 3 parchment, 4 on
    // (dark wood, lit honey words).
    public pure function face(kind: int) -> color {
        return kind == 1 ? Cz.honey : kind == 2 ? Cz.ember : kind == 3 ? Cz.parch : kind == 4 ? Cz.wood-d : Cz.wood-l;
    }
    public pure function hi(kind: int) -> color {
        return kind == 1 ? Cz.honey-l : kind == 2 ? Cz.ember-l : kind == 3 ? Cz.parch-hl : kind == 4 ? Cz.wood-dd : Cz.wood-hl;
    }
    public pure function lo(kind: int) -> color {
        return kind == 1 ? Cz.honey-d : kind == 2 ? Cz.ember-d : kind == 3 ? Cz.parch-d : kind == 4 ? Cz.wood : Cz.wood-d;
    }
    public pure function ink-of(kind: int) -> color {
        return kind == 1 || kind == 3 ? Cz.ink : kind == 4 ? Cz.honey-l : Cz.cream;
    }
}

// The mockup's 3px bevel inside a box: a light band along the top and left, a dark one
// along the bottom and right (the top left one covers the corners).
export component CzBevel inherits Rectangle {
    in property <color> hi;
    in property <color> lo;
    in property <length> w: 3px;
    Rectangle { x: 0; y: parent.height - root.w; width: parent.width; height: root.w; background: root.lo; }
    Rectangle { x: parent.width - root.w; y: 0; width: root.w; height: parent.height; background: root.lo; }
    Rectangle { x: 0; y: 0; width: parent.width; height: root.w; background: root.hi; }
    Rectangle { x: 0; y: 0; width: root.w; height: parent.height; background: root.hi; }
}

// A key in its 3px ink ring with a bevel (see Cz.face for `kind`); brighter while hovered,
// the bevel turned round while pressed.
export component CzKey inherits Rectangle {
    in property <int> kind;
    in property <bool> hover;
    in property <bool> pressed;
    background: Cz.ink;
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        background: root.hover ? Cz.face(root.kind).brighter(0.1) : Cz.face(root.kind);
        CzBevel {
            x: 0;
            y: 0;
            hi: root.pressed ? Cz.lo(root.kind) : Cz.hi(root.kind);
            lo: root.pressed ? Cz.hi(root.kind) : Cz.lo(root.kind);
        }
    }
}

// A parchment note in its ink ring: the menus, the pick lists and the cards of the pages.
// `hot` rings it honey (a field or picker with the cursor), `ember` while it is edited.
export component CzNote inherits Rectangle {
    in property <bool> hot;
    in property <bool> ember;
    in property <bool> tile: true;
    background: root.ember ? Cz.ember : root.hot ? Cz.honey : Cz.ink;
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        background: Cz.parch;
        clip: true;
        if root.tile: Image {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            source: @image-url("skins/px-cozy/parch.png");
            horizontal-tiling: repeat;
            vertical-tiling: repeat;
            horizontal-alignment: left;
            vertical-alignment: top;
            image-rendering: pixelated;
        }
        CzBevel { x: 0; y: 0; hi: Cz.parch-hl; lo: Cz.parch-d; }
    }
}

// A dark well in its ink ring (search fields, the export strip, bars).
export component CzWell inherits Rectangle {
    in property <bool> hot;
    background: root.hot ? Cz.honey : Cz.ink;
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        background: Cz.well;
        Rectangle { x: 0; y: 0; width: parent.width; height: 3px; background: Cz.well-lo; }
        Rectangle { x: 0; y: 0; width: 3px; height: parent.height; background: Cz.well-lo; }
    }
}

// A segmented honey bar in a dark well: 9px blocks with 3px gaps, as far as `progress`.
export component CzBar inherits Rectangle {
    in property <float> progress;
    in property <color> fill: Cz.honey;
    property <length> inner: root.width - 12px;
    property <int> blocks: max(1, floor((root.inner + 3px) / 12px));
    CzWell { x: 0; y: 0; width: root.width; height: root.height; }
    for k in root.blocks: Rectangle {
        x: 6px + k * 12px;
        y: 6px;
        width: 9px;
        height: root.height - 12px;
        background: root.fill;
        visible: (k + 0.5) / root.blocks <= clamp(root.progress, 0, 1);
    }
}

// The Cozy Cabin's switch: a wooden latch in a dark slot, sliding right onto moss when on.
export component CzSwitch inherits Rectangle {
    in property <bool> on;
    in property <bool> hover;
    background: Cz.ink;
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        background: root.on ? Cz.moss : Cz.well;
        Rectangle { x: 0; y: 0; width: parent.width; height: 3px; background: root.on ? Cz.moss-d : Cz.well-lo; }
        Rectangle { x: 0; y: 0; width: 3px; height: parent.height; background: root.on ? Cz.moss-d : Cz.well-lo; }
        Rectangle {
            x: root.on ? parent.width - self.width - 3px : 3px;
            y: 3px;
            width: parent.height - 6px;
            height: parent.height - 6px;
            background: root.on ? Cz.cream : root.hover ? Cz.parch-d : Cz.parch-dd;
            CzBevel {
                x: 0;
                y: 0;
                hi: root.on ? #ffffff : Cz.parch-d;
                lo: root.on ? Cz.parch-d : Cz.brown;
            }
        }
    }
}

// A Cozy Cabin text in the pixel capitals.
export component CzCaps inherits Text {
    color: Cz.cream;
    font-family: Cz.caps;
    font-size: 12px;
    letter-spacing: 2px;
    vertical-alignment: center;
}

// The dotted rule between settings rows and menu groups: 3px dashes in parchment brown.
export component CzRule inherits Image {
    height: 3px;
    source: @image-url("skins/px-cozy/rule.png");
    horizontal-tiling: repeat;
    horizontal-alignment: left;
    image-rendering: pixelated;
    colorize: Cz.parch-dd;
}

// Split out of MenuCard, so its copies share it (see docs/device-themes.md, "Generated code size").
component MenuCardArt inherits Rectangle {
    in property <string> title;
    in property <length> title-indent;
    in property <bool> list;
    in property <bool> sub;
    // Brick Phone: the double frame and the title bar.
    if Theme.brick: BrickMenuFrame {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.title;
        title-indent: root.title-indent;
    }
    // Desktop 95: a grey raised menu.
    if Theme.os95 && !root.list: OsBevel { kind: 0; }
    // Pocket: an LCD window with a hard two shade edge (dark ring, mid green shadow).
    if Theme.pocket: Rectangle { x: 4px; y: 4px; width: parent.width; height: parent.height; background: Pk.l2; }
    if Theme.pocket: Rectangle { x: 0; y: 0; width: parent.width; height: parent.height; background: Pk.l0; }
    if Theme.pocket: PkRing { x: 0; y: 0; width: parent.width; height: parent.height; }
    // Comic Book: a white panel with a thick ink edge and a hard shadow.
    if Theme.comic: InkShadow { off: 5px; }
    if Theme.comic: Rectangle { background: #ffffff; border-width: 3px; border-color: Comic.ink; }
    // Quest Menu: a menu window with the double pixel frame.
    if Theme.quest: QFrame { x: 0; y: 0; }
    // Pinball: a dark plate with a plasma top edge.
    if Theme.pinball: Rectangle { x: 0; y: 0; width: parent.width; height: 2px; background: Pb.plasma; }
    // Phonograph: an ivory card in a brass ring with a dark edge.
    if Theme.phono: Rectangle { x: -1px; y: -1px; width: parent.width + 2px; height: parent.height + 2px; border-radius: 5px; border-width: 1px; border-color: Pn.soot; }
    // Cozy Cabin: a parchment note in an ink ring with a hard shadow.
    if Theme.cozy: Rectangle { x: 6px; y: 6px; width: parent.width; height: parent.height; background: #00000059; }
    // In a box: `visible` on a component makes Slint copy it at every use.
    if Theme.cozy: Rectangle { x: 0; y: 0; width: parent.width; height: parent.height; CzNote { } }
    // Pocket Synth: a black screen in the grey bezel of its main screens.
    if Theme.synth: SynScreen { x: 4px; y: 4px; width: root.width - 8px; height: root.height - 8px; radius: 8px; }
    // Car Dashboard: a glass sheet with an ice light along its top edge.
    if Theme.dash: Rectangle {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: 1px;
        background: @linear-gradient(90deg, #62d2ff00 0%, #62d2ff 50%, #62d2ff00 100%);
    }
    if Theme.tape: Rectangle {
        background: #0d0805;
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            background: root.sub ? Deck.cream-sub : Deck.cream-card;
        }
        Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 2px; background: Deck.red; }
        Rectangle { x: 1px; y: 3px; width: parent.width - 2px; height: 1px; background: Deck.amber; }
    }
}

// The card a menu sits on: the dark popup, or for Tape Deck a cream J-card insert with
// the red and amber rule of the cassette label along its top. `sub` is a submenu card.
export component MenuCard inherits Rectangle {
    in property <bool> sub;
    in property <length> shadow-y: 6px;
    // Desktop 95: a white drop down list with a black line instead of a grey menu.
    in property <bool> list;
    // Brick Phone: the title in the inverted bar on top (Projects, the clip's name, Export),
    // moved right by `title-indent` for an icon drawn before it.
    in property <string> title;
    in property <length> title-indent;
    // Answering Machine: a card of message paper.
    background: Theme.tape || Theme.comic || Theme.synth || Theme.pocket || Theme.quest || Theme.cozy ? transparent : Theme.phono ? Pn.card : Theme.pinball ? Pb.pop : Theme.brick ? Brick.lcd1 : Theme.os95 ? (root.list ? #ffffff : Os.face) : Theme.dash ? #171b21 : Theme.answer ? Am.paper : root.sub ? Theme.raised : Theme.popup;
    border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.cozy || Theme.pinball ? 0 : Theme.phono ? 4px : Theme.dash ? 12px : Theme.answer ? 6px : Theme.synth ? 12px : 10px;
    border-width: Theme.cozy ? 0 : Theme.phono ? 2px : Theme.tape || Theme.comic || Theme.pocket || Theme.quest || Theme.synth ? 0 : Theme.os95 ? (root.list ? 1px : 0) : Theme.brick ? 2px : 1px;
    border-color: Theme.phono ? Pn.brass-mid : Theme.pinball ? Pb.edge : Theme.os95 ? #000000 : Theme.dash ? #ffffff33 : Theme.answer ? Am.chip-lip : Theme.edge;
    drop-shadow-blur: Theme.cozy ? 0 : Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick ? 0 : 20px;
    drop-shadow-offset-y: root.shadow-y;
    drop-shadow-color: #00000099;
    // Each skin's frame, in one shared component (the card is copied at every use).
    MenuCardArt {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.title;
        title-indent: root.title-indent;
        list: root.list;
        sub: root.sub;
    }
    @children
}

// A key face of the deck, the face shifted down while it is held. `kind`: 0 cream,
// 1 amber, 2 red, 3 dark; `down` holds it (a latched key); `lip` is where the face ends
// and its front edge starts, as a part of the height. Used by the shared widgets.
export component DeckKey inherits Rectangle {
    in property <int> kind;
    in property <bool> down;
    in property <bool> pressed;
    in property <bool> hover;
    in property <bool> enabled: true;
    in property <bool> shadow: true;
    property <bool> sunk: root.down || (root.pressed && root.enabled);
    Rectangle { visible: root.shadow; y: 1px; background: #000000b0; }
    Rectangle {
        y: root.sunk ? 1px : 0;
        height: parent.height - (root.sunk ? 1px : 0);
        background: root.kind == 1 ? Deck.amber-face : root.kind == 2 ? (root.down ? Deck.rec-down : Deck.rec-face)
            : root.kind == 3 ? Deck.dark-face : root.down ? Deck.latch-down : Deck.key-face;
        opacity: root.enabled ? 1 : 0.45;
        Rectangle { y: 0; height: 1px; background: root.kind == 1 ? #ffe0b0 : root.kind == 2 ? #ff9a7f : root.kind == 3 ? #4a3a2e : root.down ? #00000030 : #ffffff; }
        Rectangle { visible: root.hover && root.enabled && !root.sunk; background: #ffffff14; }
    }
}

// The clock of the theme effects, in seconds. The app advances it while an effect
// shows, faster while recording, and leaves it still otherwise.
export global Fx {
    in property <float> t;
    // The same clock in steps of a twentieth of a second, for slow drifts (glows, rays,
    // stars): they cover much of the window, so they redraw only when this steps.
    in property <float> slow;
}

// Line icons on a 24 unit grid, drawn as paths so they never depend on fonts.
export component Icon inherits Path {
    in property <string> name;
    in property <color> tint: Theme.text;
    in property <bool> solid: name == "play" || name == "pause" || name == "stop" || name == "dots" || name == "grip" || name == "dot" || name == "rew" || name == "ff";
    width: 14px;
    height: 14px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: solid ? transparent : tint;
    stroke-width: 2px;
    fill: solid ? tint : transparent;
    commands: name == "gear" ? "M 15 12 A 3 3 0 1 1 9 12 A 3 3 0 1 1 15 12 Z M 12 2 L 12 5 M 12 19 L 12 22 M 2 12 L 5 12 M 19 12 L 22 12 M 5 5 L 7 7 M 17 17 L 19 19 M 5 19 L 7 17 M 17 7 L 19 5"
        : name == "pin" ? "M 12 17 L 12 22 M 9 3 L 15 3 L 14 10 L 18 14 L 6 14 L 10 10 Z"
        : name == "widget" ? "M 3 8 L 21 8 L 21 16 L 3 16 Z"
        : name == "expand" ? "M 4 4 L 20 4 L 20 20 L 4 20 Z M 4 9 L 20 9"
        : name == "close" ? "M 6 6 L 18 18 M 18 6 L 6 18"
        : name == "back" ? "M 15 6 L 9 12 L 15 18"
        : name == "chevron" ? "M 9 6 L 15 12 L 9 18"
        : name == "down" ? "M 6 9 L 12 15 L 18 9"
        : name == "up" ? "M 6 15 L 12 9 L 18 15"
        : name == "grip" ? "M 7.6 6 A 1.6 1.6 0 1 0 10.8 6 A 1.6 1.6 0 1 0 7.6 6 Z M 13.2 6 A 1.6 1.6 0 1 0 16.4 6 A 1.6 1.6 0 1 0 13.2 6 Z M 7.6 12 A 1.6 1.6 0 1 0 10.8 12 A 1.6 1.6 0 1 0 7.6 12 Z M 13.2 12 A 1.6 1.6 0 1 0 16.4 12 A 1.6 1.6 0 1 0 13.2 12 Z M 7.6 18 A 1.6 1.6 0 1 0 10.8 18 A 1.6 1.6 0 1 0 7.6 18 Z M 13.2 18 A 1.6 1.6 0 1 0 16.4 18 A 1.6 1.6 0 1 0 13.2 18 Z"
        : name == "dot" ? "M 4 12 A 8 8 0 1 0 20 12 A 8 8 0 1 0 4 12 Z"
        : name == "import" ? "M 12 4 L 12 15 M 7 10 L 12 15 L 17 10 M 4 19 L 20 19"
        : name == "dots" ? "M 10.2 5 A 1.8 1.8 0 1 0 13.8 5 A 1.8 1.8 0 1 0 10.2 5 Z M 10.2 12 A 1.8 1.8 0 1 0 13.8 12 A 1.8 1.8 0 1 0 10.2 12 Z M 10.2 19 A 1.8 1.8 0 1 0 13.8 19 A 1.8 1.8 0 1 0 10.2 19 Z"
        : name == "pencil" ? "M 4 20 L 8 20 L 19 9 L 15 5 L 4 16 Z"
        : name == "trash" ? "M 4 7 L 20 7 M 10 11 L 10 17 M 14 11 L 14 17 M 6 7 L 7 20 L 17 20 L 18 7 M 9 7 L 9 4 L 15 4 L 15 7"
        : name == "rewind" ? "M 3 12 A 9 9 0 1 0 12 3 A 9.75 9.75 0 0 0 5.26 5.74 L 3 8 M 3 3 L 3 8 L 8 8"
        : name == "forward" ? "M 21 12 A 9 9 0 1 1 12 3 C 14.52 3 16.93 4 18.74 5.74 L 21 8 M 21 3 L 21 8 L 16 8"
        : name == "mic" ? "M 9 6 A 3 3 0 0 1 15 6 L 15 12 A 3 3 0 0 1 9 12 Z M 5 11 A 7 7 0 0 0 19 11 M 12 18 L 12 21"
        : name == "play" ? "M 8 5 L 19 12 L 8 19 Z"
        : name == "pause" ? "M 6 5 L 10 5 L 10 19 L 6 19 Z M 14 5 L 18 5 L 18 19 L 14 19 Z"
        : name == "stop" ? "M 6 6 L 18 6 L 18 18 L 6 18 Z"
        : name == "minimize" ? "M 5 12 L 19 12"
        : name == "check" ? "M 5 12 L 10 17 L 19 7"
        : name == "updown" ? "M 8 10 L 12 6 L 16 10 M 8 14 L 12 18 L 16 14"
        : name == "folder" ? "M 3 7 L 9 7 L 11 9 L 21 9 L 21 19 L 3 19 Z"
        : name == "search" ? "M 18 11 A 7 7 0 1 1 4 11 A 7 7 0 1 1 18 11 Z M 20 20 L 16 16"
        // Icons after Lucide.
        : name == "cog" ? "M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z"
        : name == "pushpin" ? "M12 17v5 M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"
        : name == "pip" ? "M21 9V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4 M14 13h6a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2z"
        : name == "file-plus" ? "M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z M14 2v4a2 2 0 0 0 2 2h4 M12 12v6 M9 15h6"
        : name == "message" ? "M7.9 20A9 9 0 1 0 4 16.1L2 22Z"
        : name == "sparkles" ? "M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z M20 3v4 M22 5h-4 M4 17v2 M5 18H3"
        : name == "languages" ? "m5 8 6 6 M4 14l6-6 2-3 M2 5h12 M7 2h1 M22 22l-5-10-5 10 M14 18h6"
        : name == "copy" ? "M10 8h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-10a2 2 0 0 1-2-2v-10a2 2 0 0 1 2-2z M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
        : name == "list" ? "M8 6h13 M8 12h13 M8 18h13 M3 6h1 M3 12h1 M3 18h1"
        // Tape Deck.
        : name == "plus" ? "M 12 5 L 12 19 M 5 12 L 19 12"
        : name == "export" ? "M 12 15 L 12 4 M 7 9 L 12 4 L 17 9 M 4 19 L 20 19"
        : name == "eject" ? "M 5 14 L 12 6 L 19 14 Z M 5 18 L 19 18"
        // Loop.
        : name == "loop" ? "m17 2 4 4-4 4 M3 11v-1a4 4 0 0 1 4-4h14 M7 22l-4-4 4-4 M21 13v1a4 4 0 0 1-4 4H3"
        // Answering Machine.
        : name == "rew" ? "M 11 6 L 11 18 L 3 12 Z M 21 6 L 21 18 L 13 12 Z"
        : name == "ff" ? "M 13 6 L 13 18 L 21 12 Z M 3 6 L 3 18 L 11 12 Z"
        : name == "tape" ? "M 3 6 L 21 6 L 21 18 L 3 18 Z M 10.5 12 A 2 2 0 1 1 6.5 12 A 2 2 0 1 1 10.5 12 Z M 17.5 12 A 2 2 0 1 1 13.5 12 A 2 2 0 1 1 17.5 12 Z M 10.5 12 L 13.5 12 M 6 18 L 7.5 15.5 L 16.5 15.5 L 18 18"
        : name == "warn" ? "M 12 4 L 21 20 L 3 20 Z M 12 10 L 12 14.5 M 12 17.2 L 12 17.3"
        : "";
}

// The Phonograph's keys and switches (docs/mockups/device-themes/x-phono-pages/), drawn by
// the shared widgets for it; its colours and plates are in skins/x-phono-parts.slint.

// A Phonograph key: `kind` 0 ivory, 1 brass (the main action), 2 red wax, 3 ivory held down
// (a key that is on). A dark rim with the key's depth under it, a brass ring round ivory.
export component PnKey inherits Rectangle {
    in property <int> kind;
    in property <bool> hover;
    in property <bool> pressed;
    property <bool> down: root.pressed || root.kind == 3;
    Rectangle {
        x: -2.5px;
        y: -2.5px;
        width: root.width + 5px;
        height: root.height + 5px + (root.down ? 1px : 3px);
        border-radius: 7px;
        background: Pn.soot;
    }
    Rectangle {
        x: -1.5px;
        y: -1.5px;
        width: root.width + 3px;
        height: root.height + 3px;
        border-radius: 6px;
        background: root.kind == 1 ? #4a3209 : root.kind == 2 ? Pn.wax-lo : Pn.brass-mid;
    }
    // The face's middle colour under its gradient: the software renderer draws a gradient of
    // three or more stops in bands that can leave a row open at a stop when the key sits on a
    // half pixel, and the brass ring showed through it as a line across the key.
    Rectangle {
        border-radius: 5px;
        background: root.kind == 1 ? Pn.brass : root.kind == 2 ? Pn.wax : root.down ? #e9dcb8 : Pn.ivory;
    }
    Rectangle {
        border-radius: 5px;
        background: root.kind == 1 ? Pn.brass-face : root.kind == 2 ? Pn.wax-face : root.down ? Pn.ivory-sunk : Pn.ivory-face;
    }
    Rectangle { visible: root.hover && !root.pressed; border-radius: 5px; background: #ffffff2e; }
    Rectangle { visible: root.pressed; border-radius: 5px; background: #00000024; }
}

// A round brass knob holding an icon (back and forward 5, Back): red wax when filled (Play),
// sunk darker while it is on.
export component PnKnob inherits Rectangle {
    in property <bool> on;
    in property <bool> filled;
    in property <bool> hover;
    in property <bool> pressed;
    Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: self.width / 2;
        background: root.filled ? #4a3209 : Pn.soot;
    }
    Rectangle {
        visible: root.filled;
        x: -1px;
        y: -1px;
        width: root.width + 2px;
        height: root.height + 2px;
        border-radius: self.width / 2;
        background: #e8c86e;
    }
    // Rings, not a radial gradient: the software renderer fills a gradient as a square.
    PnDisc {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        c0: root.filled ? #d0463a : root.on || root.pressed ? #b58a35 : #f6e3a1;
        c1: root.filled ? #a3261c : #d1a84f;
        c2: root.filled ? #5e1209 : #7a5717;
        mid: !root.filled && (root.on || root.pressed) ? 0.55 : 0.5;
    }
    Rectangle { visible: root.hover && !root.pressed; border-radius: self.width / 2; background: #ffffff2e; }
}

// The red pointer before the hovered or current line of a Phonograph menu.
export component PnPointer inherits Path {
    width: 5px;
    height: 7px;
    viewbox-width: 5;
    viewbox-height: 7;
    commands: "M 0 0 L 5 3.5 L 0 7 Z";
    fill: Pn.wax;
    accessible-role: none;
}

// A Phonograph dropdown: a brass card holder round an ivory card (as the main page's project
// holder), a bright brass ring while it has the focus.
export component PnHolder inherits Rectangle {
    in property <bool> hot;
    in property <bool> hover;
    Rectangle {
        visible: root.hot;
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: 5px;
        border-width: 2px;
        border-color: Pn.brass-hi;
    }
    Rectangle {
        x: 3px;
        y: 3px;
        width: root.width - 6px;
        height: root.height - 6px;
        border-radius: 2px;
        background: root.hover ? @linear-gradient(180deg, #fffaea 0%, #f1e4c2 100%) : @linear-gradient(180deg, #fbf4df 0%, #e8dab6 100%);
        Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: #00000026; }
    }
}

// The face of a Phonograph IconBtn: a knob when it is round, else a key.
component PnIconFace inherits Rectangle {
    in property <bool> round;
    in property <bool> on;
    in property <bool> filled;
    in property <bool> hover;
    in property <bool> pressed;
    if root.round: PnKnob { on: root.on; filled: root.filled; hover: root.hover; pressed: root.pressed; }
    if !root.round: PnKey { kind: root.filled ? 1 : root.on ? 3 : 0; hover: root.hover; pressed: root.pressed; }
}

// The Phonograph's lever switch: a dark slot ringed in brass with a brass ball, the slot
// wax red and the ball at the right while it is on.
export component PnLever inherits Rectangle {
    in property <bool> on;
    in property <bool> hover;
    Rectangle {
        x: -2.5px;
        y: -2.5px;
        width: root.width + 5px;
        height: root.height + 5px;
        border-radius: self.height / 2;
        background: #160904;
    }
    Rectangle {
        x: -1.5px;
        y: -1.5px;
        width: root.width + 3px;
        height: root.height + 3px;
        border-radius: self.height / 2;
        background: root.hover ? Pn.brass : Pn.brass-mid;
    }
    // The slot: the software renderer fills a gradient as a square, so the shading runs only
    // between two solid round ends (dark wax on the left, bright on the right, when on).
    Rectangle {
        border-radius: self.height / 2;
        background: root.on ? #5e1209 : #1b0d07;
    }
    Rectangle {
        visible: root.on;
        x: root.width - root.height;
        width: root.height;
        border-radius: self.height / 2;
        background: #a3261c;
    }
    Rectangle {
        visible: root.on;
        x: root.height / 2;
        width: root.width - root.height;
        background: @linear-gradient(90deg, #5e1209 0%, #a3261c 100%);
    }
    // The ball and the shadow under it, in rings.
    Rectangle {
        x: root.on ? root.width - root.height + 2px : 2px;
        y: 3px;
        width: root.height - 4px;
        height: root.height - 4px;
        border-radius: self.width / 2;
        background: #00000080;
    }
    PnDisc {
        x: root.on ? root.width - root.height + 2px : 2px;
        y: 2px;
        width: root.height - 4px;
        height: root.height - 4px;
        c0: #fff3c8;
        c1: #d1a84f;
        c2: #7a5717;
        mid: 0.45;
    }
}

// Pinball's keys and switches (docs/mockups/device-themes/x-pinball-pages/), drawn by the
// shared widgets for it; its colours, lamps, inserts and dot matrix are in
// skins/x-pinball-parts.slint.

// A Pinball key: `kind` 0 a dark chrome plate, 1 the lit plasma start button, 2 red, 3 a dark
// plate lit plasma (a key that is on), 4 green (done). Lighter while hovered, darker pressed.
export component PbKey inherits Rectangle {
    in property <int> kind;
    in property <bool> hover;
    in property <bool> pressed;
    background: root.kind == 1 ? @linear-gradient(180deg, #ffd090 0%, #ff9a3a 55%, #e0600c 100%)
        : root.kind == 2 ? @linear-gradient(180deg, #ff6a50 0%, #d8241a 60%, #90100a 100%)
        : root.kind == 4 ? @linear-gradient(180deg, #b8ffd0 0%, #4be08a 60%, #1a8a4a 100%)
        : root.kind == 3 ? @linear-gradient(180deg, #2e1a0e 0%, #1a0f0a 100%)
        : @linear-gradient(180deg, #25212b 0%, #141118 100%);
    border-width: 1px;
    border-color: root.kind == 1 ? Pb.plasma-hi : root.kind == 2 ? #ff8a6a : root.kind == 4 ? #8affb8 : root.kind == 3 ? #c25a14 : root.hover ? #c9c3cf : Pb.edge;
    Rectangle { visible: root.hover && !root.pressed; background: #ffffff1a; }
    Rectangle { visible: root.pressed; background: #00000040; }
}

// A round chrome ring holding an icon (back and forward 5, the transcript's tools): plasma
// ringed on a warm dark face while it is on, the plasma button when filled.
export component PbRing inherits Rectangle {
    in property <bool> on;
    in property <bool> filled;
    in property <bool> hover;
    in property <bool> pressed;
    border-radius: min(self.width, self.height) / 2;
    background: root.filled ? @linear-gradient(180deg, #ffd090 0%, #ff9a3a 55%, #e0600c 100%)
        : root.pressed ? #0a090c : root.on ? #2a1408 : root.hover ? #221d28 : #141118;
    border-width: 2px;
    border-color: root.filled ? Pb.plasma-hi : root.on ? Pb.plasma : root.hover ? #c9c3cf : Pb.chrome;
}

// Pinball's switch: a dark slot with a lamp in it, sliding right and lit orange when on.
export component PbSwitch inherits Rectangle {
    in property <bool> on;
    in property <bool> hover;
    border-radius: root.height / 2;
    background: #050507;
    border-width: 1.5px;
    border-color: root.on ? #c25a14 : root.hover ? #c9c3cf : Pb.edge;
    Lamp {
        x: root.on ? root.width - root.height : 0;
        y: -0.5px;
        width: root.height - 1px;
        height: root.height - 1px;
        kind: root.on ? 1 : 0;
    }
}

// What a tooltip looks like: a small dark bubble with a thin warm edge.
export component Tip inherits Rectangle {
    in property <string> text;
    // Tape Deck: a cream paper tag with a red edge and a stepped shadow.
    if Theme.tape: Rectangle { x: 1px; y: 2px; background: #00000059; }
    if Theme.tape: Rectangle { x: 1px; y: 4px; height: parent.height - 2px; background: #00000026; }
    if Theme.tape: Rectangle {
        background: Deck.cream-card;
        border-width: 1px;
        border-color: Deck.ink;
        Rectangle { x: 0; width: 3px; background: Deck.red; }
    }
    // Desktop 95: the yellow tip with a black line.
    // Comic Book: a small yellow caption with a hard shadow.
    if Theme.comic: InkShadow { }
    if Theme.comic: Rectangle { background: Comic.yellow; border-width: 2.2px; border-color: Comic.ink; }
    // Pocket: a dark LCD tag with a light edge.
    // Brick Phone: a small amber label with an ink frame.
    // Answering Machine: a small paper slip.
    background: Theme.tape || Theme.comic ? transparent : Theme.phono ? Pn.tip : Theme.pinball ? #050507 : Theme.cozy ? Cz.parch-hl : Theme.pocket ? Pk.l3 : Theme.quest ? Quest.ink : Theme.brick ? Brick.lcd1 : Theme.os95 ? Os.tip : Theme.dash ? #20262e : Theme.answer ? Am.paper : Theme.synth ? #0b0c0c : Theme.popup.with-alpha(0.95);
    border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.cozy || Theme.pinball ? 0 : Theme.phono ? 3px : Theme.answer ? 4px : Theme.synth ? 5px : 7px;
    border-width: Theme.cozy ? 3px : Theme.tape || Theme.comic ? 0 : Theme.brick ? 2px : Theme.pocket ? 2px : Theme.quest ? 3px : 1px;
    border-color: Theme.phono ? #4a3209 : Theme.pinball ? Pb.edge : Theme.cozy ? Cz.ink : Theme.pocket ? Pk.l0 : Theme.quest ? #ffcc1f : Theme.os95 ? #000000 : Theme.dash ? #ffffff33 : Theme.answer ? #8d8168 : Theme.synth ? #9a968c : Theme.popup-edge;
    drop-shadow-blur: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.cozy ? 0 : 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000099;
    width: bubble.preferred-width;
    height: bubble.preferred-height;
    // Car Dashboard: a glass tag with an ice line along its top.
    if Theme.dash: Rectangle { x: 8px; y: 0; width: parent.width - 16px; height: 1px; background: #62d2ff; }
    // Pinball: a black plate with a plasma top line.
    if Theme.pinball: Rectangle { x: 0; y: 0; width: parent.width; height: 2px; background: Pb.plasma; }
    bubble := HorizontalLayout {
        padding-left: Theme.os95 ? 6px : Theme.dash ? 10px : Theme.pocket ? 8px : Theme.brick ? 8px : 9px;
        padding-right: Theme.dash ? 10px : Theme.os95 ? 6px : Theme.pocket ? 8px : Theme.brick ? 8px : 9px;
        padding-top: Theme.os95 ? 2px : Theme.comic ? 4px : Theme.brick ? 3px : 5px;
        padding-bottom: Theme.os95 ? 2px : Theme.comic || Theme.quest ? 4px : Theme.pocket ? 4px : Theme.brick ? 2px : 5px;
        Text {
            text: root.text;
            color: Theme.phono ? Pn.engrave : Theme.pinball ? #f3ecf7 : Theme.cozy ? Cz.ink : Theme.pocket ? Pk.l0 : Theme.tape ? Deck.ink : Theme.os95 ? #000000 : Theme.comic ? Comic.ink : Theme.dash ? #eef2f6 : Theme.quest ? Quest.white : Theme.answer ? Am.ink : Theme.synth ? #eef3ee : Theme.text2;
            font-family: Theme.phono ? Pn.font : Theme.pinball ? Pb.font : Theme.cozy ? Cz.font : Theme.pocket ? Pk.small : Theme.tape ? "Oswald" : Theme.comic ? "Comic Neue" : Theme.os95 ? Os.font : Theme.dash ? "Manrope" : Theme.answer ? "Barlow Condensed" : Theme.quest ? Quest.font : Theme.brick ? Brick.words : Theme.synth ? Theme.mono : "Inter Tight";
            font-size: Theme.phono ? 13.5px : Theme.pinball ? 13px : Theme.pocket ? 8px : Theme.tape || Theme.cozy ? 11.5px : Theme.dash ? 11px : Theme.synth ? 10.5px : Theme.brick ? 16px : Theme.quest ? 13px : 12px;
            font-weight: Theme.phono ? 500 : Theme.pinball ? 600 : Theme.os95 || Theme.pocket || Theme.quest || Theme.cozy ? 400 : Theme.comic ? 700 : Theme.dash || Theme.answer ? 700 : 500;
            letter-spacing: Theme.tape ? 0.6px : Theme.pocket ? 1px : Theme.answer ? 1.2px : 0;
            font-italic: Theme.phono;
        }
    }
}

// A text button. Primary is the orange one; the rest are outlined.
export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <length> font-size: 13px;
    // Tape Deck: the red key (Delete, Merge) instead of the amber one; Car Dashboard:
    // the red pill (Delete).
    in property <bool> red;
    callback clicked;
    height: 36px;
    // At least this wide (the 95 message box keys are 74px).
    in property <length> least;
    min-width: max(root.least, Theme.os95 ? os-label.preferred-width + 16px : Theme.pocket ? pk-word.preferred-width + 16px : Theme.quest ? q-word.preferred-width + 20px : Theme.answer ? am-word.preferred-width + 24px : label.preferred-width + (Theme.tape ? 24px : Theme.comic ? 20px : Theme.dash ? 28px : Theme.brick ? 16px : Theme.synth ? (root.height < 30px ? 20px : 28px) : Theme.cozy || Theme.pinball || Theme.phono ? 28px : 26px));
    // Drawn in body, not on the root: a root opacity, visible, shadow or border makes
    // Slint inline the whole widget at every use (docs/device-themes.md, Generated code size).
    // No x, y or size: it fills the root and passes its children's layout constraints on.
    body := Rectangle {
        // Car Dashboard: a glass pill; the main one ice, Delete red.
        border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.dash ? self.height / 2 : 9px;
        // Brick Phone: an LCD button in an ink frame, inverted for the main action.
        // Pocket Synth: a white key in capitals, the main action orange, `red` the dark key.
        background: Theme.tape || Theme.comic || Theme.pocket || Theme.quest || Theme.answer || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? transparent
            : Theme.brick ? (primary || on ? Brick.ink : t.has-hover && enabled ? Brick.ghost : transparent)
            : Theme.os95 ? Os.face
            : Theme.dash ? (primary && red ? (t.has-hover && enabled ? #ff6b78 : #ff4d5e) : primary ? (t.has-hover && enabled ? Theme.accent-hover : Theme.accent) : on ? #62d2ff1f : t.has-hover && enabled ? #1f252d : #181d23)
            : primary ? (t.has-hover && enabled ? Theme.accent-hover : Theme.accent) : (t.has-hover && enabled ? Theme.raised : transparent);
        border-width: Theme.brick ? 2px : primary || Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.answer || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : 1px;
        border-color: on ? Theme.accent : Theme.dash ? #ffffff1f : Theme.edge;
        opacity: enabled || Theme.tape || Theme.os95 || Theme.pocket || Theme.quest || Theme.answer ? 1 : Theme.comic || Theme.phono ? 0.45 : Theme.brick || Theme.cozy || Theme.pinball ? 0.38 : 0.4;
        Rectangle {
            visible: Theme.pocket;
            x: 0;
            y: root.pk-down ? 2px : 0;
            width: parent.width;
            height: parent.height - (root.pk-down ? 2px : 0);
            background: root.pk-dark ? (root.enabled ? Pk.l3 : Pk.l1) : t.has-hover && root.enabled ? #b3bf6a : Pk.l0;
            Rectangle { visible: !root.pk-dark && !root.pk-down; x: 2px; y: parent.height - 4px; width: parent.width - 4px; height: 2px; background: Pk.l1; }
            Rectangle { visible: root.pk-dark && !root.pk-down && root.enabled; x: 0; y: parent.height - 2px; width: parent.width; height: 2px; background: Pk.l2; }
            PkRing { visible: !root.pk-dark; ink: root.enabled ? Pk.l3 : Pk.l1; }
            PkRing { visible: (root.red || root.danger) && root.enabled; x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; ink: Pk.l0; }
            pk-word := Text {
                x: 0;
                y: -1px;
                width: parent.width;
                height: parent.height;
                text: root.text;
                color: root.pk-dark ? Pk.l0 : root.enabled ? Pk.l3 : Pk.l1;
                font-family: Pk.big;
                font-size: root.height <= 22px ? 16px : 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        // Quest Menu: a pixel key, the main action lit with gold words, Delete red, an off key
        // dark with dim words.
        if Theme.quest: QFace {
            x: 0;
            y: 0;
            kind: !root.enabled ? 3 : root.primary && (root.red || root.danger) ? 2 : root.primary ? 1 : root.on ? 4 : 0;
            hover: t.has-hover && root.enabled;
        }
        q-word := Text {
            visible: Theme.quest;
            x: 0;
            y: (t.pressed && t.has-hover && root.enabled ? 1px : 0);
            width: parent.width;
            height: parent.height;
            text: root.text;
            color: !root.enabled ? Quest.dim : root.primary && (root.red || root.danger) ? Quest.white : root.primary || root.on ? Quest.gold : root.danger || root.red ? Quest.lred : Quest.white;
            font-family: Quest.font;
            font-size: root.height < 26px ? 13px : 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        if Theme.answer: AmKey {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            kind: root.primary || root.red ? 1 : 0;
            down: root.am-down;
            hover: t.has-hover;
            enabled: root.enabled;
        }
        if Theme.answer && root.on: Rectangle {
            x: parent.width - 11px;
            y: 5px + (root.am-down ? 2px : 0);
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: Am.amber;
        }
        am-word := Text {
            visible: Theme.answer;
            x: 0;
            y: root.am-down ? 2px : 0;
            width: parent.width;
            height: parent.height;
            text: root.text.to-uppercase();
            color: root.primary || root.red ? (root.enabled ? Am.rec-ink : #f0c9bf) : !root.enabled ? #8f877d : root.danger ? #ff8a72 : Am.key-ink;
            font-family: "Barlow Condensed";
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        if Theme.os95: OsBevel {
            kind: root.os-down ? 1 : root.primary ? 6 : 0;
        }
        if Theme.os95 && !root.enabled: Text {
            x: 1px;
            y: 1px;
            width: parent.width;
            height: parent.height;
            text: root.text;
            color: Os.hi;
            font-family: Os.font;
            font-size: 12.5px;
            font-weight: root.primary ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        os-label := Text {
            visible: Theme.os95;
            x: root.os-down ? 1px : 0;
            y: root.os-down ? 1px : 0;
            width: parent.width;
            height: parent.height;
            text: root.text;
            color: root.enabled ? #000000 : Os.sh;
            font-family: Os.font;
            font-size: 12.5px;
            font-weight: root.primary ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        if Theme.comic && root.enabled && !root.ink-down: InkShadow { off: 2px; }
        if Theme.comic: Rectangle {
            x: root.ink-down ? 2px : 0;
            y: root.ink-down ? 2px : 0;
            background: root.red || root.danger ? Comic.red : root.primary || root.on ? Comic.yellow : #ffffff;
            border-width: 2.5px;
            border-color: Comic.ink;
            Rectangle { visible: t.has-hover && root.enabled && !root.ink-down; x: 2.5px; y: 2.5px; width: parent.width - 5px; height: parent.height - 5px; background: #ffffff40; }
            Text {
                y: 1px;
                height: parent.height - 1px;
                text: root.text.to-uppercase();
                color: root.red || root.danger ? #ffffff : Comic.ink;
                font-family: "Bangers";
                font-size: root.height < 32px ? 12.5px : 14px;
                letter-spacing: 1px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        // Tape Deck: a piano key, amber for the main action, red for deleting.
        if Theme.tape: DeckKey {
            kind: root.red ? 2 : root.primary ? 1 : 0;
            down: root.on;
            pressed: t.pressed && t.has-hover;
            hover: t.has-hover;
            enabled: root.enabled;
        }
        if Theme.tape: Text {
            y: (t.pressed && t.has-hover && root.enabled) || root.on ? 1px : 0;
            width: parent.width;
            height: parent.height * 0.78;
            text: root.text.to-uppercase();
            color: root.red ? #fff3e6 : root.primary ? #2a1406 : Deck.key-ink;
            opacity: root.enabled ? 1 : 0.5;
            font-family: "Oswald";
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2.2px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        if Theme.synth: SynKey {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            kind: root.red ? 2 : root.primary ? 1 : 0;
            radius: root.height < 30px ? 6px : 7px;
            down: root.on;
            pressed: t.pressed && t.has-hover;
            hover: t.has-hover;
        }
        // Cozy Cabin: a key in an ink ring, honey for the main action, ember for `red`, dark
        // wood while it is on, parchment else.
        if Theme.cozy: CzKey {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            kind: root.cz-kind;
            hover: t.has-hover && root.enabled;
            pressed: t.pressed && t.has-hover && root.enabled;
        }
        // Pinball: the lit plasma start button for the main action, red for `red`, a dark
        // chrome plate lit plasma while it is on, else the dark plate.
        if Theme.pinball: PbKey {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            kind: root.pb-kind;
            hover: t.has-hover && root.enabled;
            pressed: t.pressed && t.has-hover && root.enabled;
        }
        // Phonograph: a brass key for the main action, red wax for `red`, ivory held down
        // while it is on, else ivory.
        if Theme.phono: PnKey {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            kind: root.pn-kind;
            hover: t.has-hover && root.enabled;
            pressed: t.pressed && t.has-hover && root.enabled;
        }
        label := Text {
            visible: !Theme.tape && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.answer;
            text: Theme.tape || Theme.comic || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? root.text.to-uppercase() : root.text;
            color: Theme.phono ? (root.danger && root.pn-kind == 0 ? Pn.wax : Pn.ink-of(root.pn-kind)) : Theme.pinball ? (root.danger && root.pb-kind == 0 ? Pb.danger : Pb.ink-of(root.pb-kind)) : Theme.cozy ? (root.danger && root.cz-kind == 3 ? Cz.ember-d : Cz.ink-of(root.cz-kind)) : Theme.brick ? (primary || on ? Brick.lcd1 : Brick.ink)
                : Theme.synth ? (root.red ? #ecebe6 : primary ? #ffffff : danger ? #e94a12 : #2a2a28)
                : Theme.dash && primary && red ? #ffffff : primary ? Theme.on-accent : danger ? Theme.danger : on ? Theme.accent : Theme.text;
            font-family: Theme.tape ? "Oswald" : Theme.os95 ? Os.font : Theme.comic ? "Bangers" : Theme.dash ? "Manrope" : Theme.brick ? Brick.words : Theme.synth ? Theme.mono : Theme.phono ? Pn.caps : Theme.pinball ? Pb.font : Theme.cozy ? Cz.caps : "Inter Tight";
            font-size: Theme.phono ? (root.height < 28px ? 9px : 10.5px) : Theme.pinball ? (root.height < 28px ? 11px : 13px) : Theme.cozy ? (root.height < 30px ? 10px : 11px) : Theme.tape ? 10px : Theme.comic ? 14px : Theme.brick ? (root.height >= 24px ? 19px : 16px) : Theme.synth ? (root.height < 30px ? 8.5px : 9.5px) : root.font-size;
            font-weight: Theme.phono ? 700 : Theme.pinball ? 700 : Theme.tape ? 600 : Theme.comic || Theme.brick || Theme.cozy ? 400 : Theme.synth ? 700 : primary ? 800 : Theme.dash ? 700 : 500;
            letter-spacing: Theme.phono ? (root.height < 28px ? 1.4px : 1.7px) : Theme.pinball ? 2px : Theme.tape ? 2.2px : Theme.comic ? 1px : Theme.synth ? (root.height < 30px ? 1.36px : 1.52px) : Theme.cozy ? 2px : 0;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // Children given at a use site are drawn (and faded) with the rest, as before.
        @children
    }
    // Pocket: an LCD key, a dark ring with a mid green band along its foot; the main
    // action dark (Delete with a light inner ring), held down and dark while on, pale when
    // off.
    property <bool> pk-dark: root.primary || root.red || root.danger || root.on;
    // Cozy Cabin: which key face (see CzKey); parchment unless it is one of those.
    property <int> cz-kind: root.red ? 2 : root.primary ? 1 : root.on ? 4 : 3;
    // Pinball: which key face (see PbKey).
    property <int> pb-kind: root.red ? 2 : root.primary ? 1 : root.on ? 3 : 0;
    // Phonograph: which key face (see PnKey).
    property <int> pn-kind: root.red ? 2 : root.primary ? 1 : root.on ? 3 : 0;
    property <bool> pk-down: root.on || (t.pressed && t.has-hover && root.enabled);
    // Answering Machine: a rubber key, red for the main action and for deleting, held
    // down while it is on (with an amber lamp), grey when off.
    property <bool> am-down: (t.pressed && t.has-hover && root.enabled) || root.on;
    // Desktop 95: a grey push button, the main action the default button with its black
    // ring, the words a pixel down and right while it is held; grey etched words when off.
    property <bool> os-down: (t.pressed && t.has-hover && root.enabled) || root.on;
    // Comic Book: an ink key with a hard shadow that sinks onto it when pressed (or on):
    // yellow for the main action, red for deleting and merging.
    property <bool> ink-down: Theme.comic && ((t.pressed && t.has-hover && root.enabled) || root.on);
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if (enabled) { root.clicked(); } }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A round or square button holding one icon.
export component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    // The tooltip: a word or two, no punctuation. The label is for screen readers.
    in property <string> tip: label;
    in property <length> size: 30px;
    in property <length> icon-size: 13px;
    in property <bool> round;
    in property <bool> filled;
    in property <bool> outlined;
    in property <bool> active;
    in property <color> tint: filled ? Theme.on-accent : active ? Theme.accent : Theme.dim;
    in property <bool> enabled: true;
    in property <length> radius: round ? size / 2 : 7px;
    callback clicked;
    width: size;
    height: size;
    // Drawn in body, not on the root: a root opacity, visible, shadow or border makes
    // Slint inline the whole widget at every use (docs/device-themes.md, Generated code size).
    // No x, y or size: it fills the root and passes its children's layout constraints on.
    body := Rectangle {
        border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : radius;
        // Car Dashboard: a glass key, lit ice while it is on.
        // Brick Phone: a square LCD button in an ink frame with a pixel glyph, inverted while on.
        // Pocket Synth: a white key (round when the button is round), orange while it is on.
        background: Theme.tape || Theme.comic || Theme.pocket || Theme.quest || Theme.answer || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? transparent : Theme.os95 ? Os.face
            : Theme.brick ? (filled || active ? Brick.ink : t.has-hover && enabled ? Brick.ghost : transparent)
            : filled ? (t.has-hover ? Theme.accent-hover : Theme.accent)
            : Theme.dash ? (active ? #62d2ff1f : t.has-hover && enabled ? #1f252d : #181d23)
            : t.has-hover && enabled ? Theme.raised : transparent;
        border-width: Theme.pocket || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.quest ? 0 : Theme.answer ? 0 : Theme.synth ? 0 : Theme.brick ? 2px : (outlined || Theme.dash) && !Theme.tape && !filled ? 1px : outlined && !Theme.tape && !Theme.os95 && !Theme.comic ? 1px : 0;
        // Answering Machine: a rubber nub, red when filled, held down with an amber icon
        // while it is on.
        if Theme.answer: AmKey {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            r: root.round ? min(root.width, root.height) / 2 : 6px;
            lip: 1.5px;
            kind: root.filled ? 1 : 0;
            down: root.active || (t.pressed && t.has-hover && root.enabled);
            hover: t.has-hover;
            enabled: root.enabled;
        }
        border-color: Theme.dash ? (active ? #62d2ff59 : #ffffff1f) : Theme.edge;
        opacity: enabled || Theme.tape || Theme.os95 || Theme.pocket ? 1 : Theme.comic || Theme.quest || Theme.phono ? 0.45 : Theme.brick || Theme.cozy || Theme.pinball ? 0.38 : 0.4;
        if Theme.pocket: Rectangle {
            x: 0;
            y: root.pk-dark || (t.pressed && t.has-hover && root.enabled) ? 2px : 0;
            width: parent.width;
            height: parent.height - (root.pk-dark ? 2px : 0);
            background: root.pk-dark ? Pk.l3 : t.has-hover && root.enabled ? #b3bf6a : Pk.l0;
            PkRing { visible: !root.pk-dark; ink: root.enabled ? Pk.l3 : Pk.l1; }
            PkPx {
                visible: root.pk-icon.width > 0;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.pk-icon;
                colorize: root.pk-dark ? Pk.l0 : root.enabled ? Pk.l3 : Pk.l1;
            }
            Icon {
                visible: root.pk-icon.width == 0;
                name: root.icon;
                tint: root.pk-dark ? Pk.l0 : root.enabled ? Pk.l3 : Pk.l1;
                width: root.icon-size;
                height: root.icon-size;
            }
        }
        if Theme.quest: QFace {
            x: 0;
            y: 0;
            kind: root.filled || root.active ? 4 : 0;
            hover: t.has-hover && root.enabled;
        }
        if Theme.quest && root.q-icon.width > 0: QPx {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (t.pressed && t.has-hover && root.enabled ? 1px : 0);
            s: root.size >= 26px && root.q-icon.width <= 7 && root.q-icon.height <= 7 ? 3 : 2;
            source: root.q-icon;
            colorize: root.filled || root.active ? Quest.gold : Quest.white;
        }
        if Theme.quest && root.q-icon.width == 0: Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon;
            tint: root.filled || root.active ? Quest.gold : Quest.white;
            width: root.icon-size;
            height: root.icon-size;
        }
        brick-glyph := BrickGlyph {
            visible: Theme.brick;
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            name: Theme.brick ? root.icon : "";
            shift: t.pressed && t.has-hover ? 1px : 0;
            tint: root.filled || root.active ? Brick.lcd1 : Brick.ink;
        }
        if Theme.os95 && root.active: Image {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            source: 1phx < 0.7px ? @image-url("skins/dv-os95/checker@2x.png") : @image-url("skins/dv-os95/checker.png");
            horizontal-tiling: repeat;
            vertical-tiling: repeat;
            horizontal-alignment: left;
            vertical-alignment: top;
        }
        if Theme.os95: OsBevel { kind: root.os-down ? 1 : 0; }
        if Theme.os95 && root.os-icon.width > 0: OsPx {
            x: (parent.width - self.width) / 2 + (root.os-down ? 1px : 0);
            y: (parent.height - self.height) / 2 + (root.os-down ? 1px : 0);
            source: root.os-icon;
            opacity: root.enabled ? 1 : 0.4;
        }
        Icon {
            visible: Theme.os95 && root.os-icon.width == 0;
            name: root.icon;
            tint: #000000;
            opacity: root.enabled ? 1 : 0.4;
            width: root.icon-size;
            height: root.icon-size;
        }
        if Theme.comic && root.enabled && !root.ink-down: InkShadow { off: 2px; radius: root.ink-r; }
        if Theme.comic: Rectangle {
            x: root.ink-down ? 2px : 0;
            y: root.ink-down ? 2px : 0;
            border-radius: root.ink-r;
            background: root.filled || root.active ? Comic.yellow : t.has-hover && root.enabled ? Comic.pale : #ffffff;
            border-width: 2.5px;
            border-color: Comic.ink;
            Icon {
                name: root.icon;
                tint: Comic.ink;
                stroke-width: 2.4px;
                width: root.icon-size;
                height: root.icon-size;
            }
        }
        // Tape Deck: a small square key, amber while it is on.
        if Theme.tape: DeckKey {
            kind: root.filled || root.active ? 1 : 0;
            pressed: t.pressed && t.has-hover;
            hover: t.has-hover;
            enabled: root.enabled;
        }
        if Theme.tape: Icon {
            y: (parent.height * 0.8 - self.height) / 2 + (t.pressed && t.has-hover && root.enabled ? 1px : 0);
            name: root.icon;
            tint: root.filled || root.active ? #2a1406 : Deck.key-ink;
            opacity: root.enabled ? 1 : 0.5;
            width: root.icon-size;
            height: root.icon-size;
        }
        if Theme.synth: SynKey {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            kind: root.filled || root.active ? 1 : 0;
            round: root.round;
            radius: 6px;
            pressed: t.pressed && t.has-hover;
            hover: t.has-hover;
        }
        // Cozy Cabin: a small parchment key, honey when filled, dark wood while it is on.
        if Theme.cozy: CzKey {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            kind: root.filled ? 1 : root.active ? 4 : 3;
            hover: t.has-hover && root.enabled;
            pressed: t.pressed && t.has-hover && root.enabled;
        }
        // Pinball: a round chrome ring, plasma ringed while it is on, the lit plasma button
        // when filled.
        if Theme.pinball: PbRing {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            on: root.active;
            filled: root.filled;
            hover: t.has-hover && root.enabled;
            pressed: t.pressed && t.has-hover && root.enabled;
        }
        // Phonograph: a round brass knob (red wax when filled) when the button is round, else
        // a small ivory key, brass when filled, held down while it is on.
        if Theme.phono: PnIconFace {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            round: root.round;
            on: root.active;
            filled: root.filled;
            hover: t.has-hover && root.enabled;
            pressed: t.pressed && t.has-hover && root.enabled;
        }
        Icon {
            visible: !Theme.tape && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !(Theme.brick && brick-glyph.has);
            name: root.icon;
            tint: Theme.answer ? (root.active ? Am.amber : root.filled ? Am.rec-ink : #e7dfd2)
                : Theme.synth ? (root.filled || root.active ? #ffffff : root.round ? #55524c : #2a2a28)
                : Theme.phono ? (root.round ? (root.filled ? Pn.wax-ink : Pn.engrave) : root.active ? Pn.wax : Pn.ink) : Theme.pinball ? (root.filled ? Pb.key-ink : root.active ? Pb.plasma-hi : t.has-hover && root.enabled ? #ffffff : #d8d2de) : Theme.cozy ? (root.active && !root.filled ? Cz.honey-l : Cz.ink)
                : t.has-hover && !root.filled && !root.active ? Theme.text : root.tint;
            stroke-width: Theme.synth ? 1.6px : 2px;
            width: root.icon-size;
            height: root.icon-size;
        }
        @children
    }
    // Pocket: a small LCD key with a pixel icon, held down and dark while on, pale when
    // off.
    property <image> pk-icon: Theme.pocket ? PkIcons.pick(root.icon) : @image-url("");
    property <bool> pk-dark: root.filled || root.active;
    // Quest Menu: a small pixel key with a pixel icon, lit with the icon gold while on.
    property <image> q-icon: Theme.quest ? QIcons.pick(root.icon) : @image-url("");
    // Desktop 95: a small grey key with a pixel icon; pushed in (on a checker) while on.
    property <bool> os-down: (t.pressed && t.has-hover && root.enabled) || root.active;
    property <image> os-icon: Theme.os95 ? OsIcons.pick(root.icon) : @image-url("");
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if (enabled) { root.clicked(); } }
    // Comic Book: a small ink key with a hard shadow, yellow while it is on; round when
    // the button is round.
    property <bool> ink-down: Theme.comic && t.pressed && t.has-hover && root.enabled;
    property <length> ink-r: root.round ? root.height / 2 : 0;
    // The button has no text, so hovering it names what it does.
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}


export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    // Off: dimmed, and shown as off whatever `checked` holds.
    in property <bool> enabled: true;
    // Desktop 95 only: the words beside the box, which take the click too.
    in property <string> caption;
    callback toggled(bool);
    // Quest Menu: a lamp check box (a gold square in a gold ring when on) instead of the
    // ON OFF pair.
    in property <bool> lamp;
    property <bool> on: root.checked && root.enabled;
    width: Theme.phono ? 40px : Theme.pinball ? 36px : Theme.cozy ? 42px : Theme.quest ? (root.lamp ? 15px : q-pair.preferred-width) : Theme.os95 ? 13px + (root.caption != "" ? 6px + cap.preferred-width : 0) : Theme.synth ? (root.caption != "" ? syn-cap.preferred-width + 33px : 36px) : Theme.tape ? 53px : Theme.comic ? 42px : Theme.pocket ? 44px : Theme.brick ? 40px : Theme.answer ? 58px : 38px;
    height: Theme.phono ? 20px : Theme.pinball ? 18px : Theme.cozy ? 24px : Theme.quest ? (root.lamp ? 15px : 18px) : Theme.os95 ? 16px : Theme.synth ? (root.caption != "" ? 26px : 24px) : Theme.tape ? 18px : Theme.pocket ? 18px : Theme.brick ? 15px : Theme.answer ? 16px : 22px;
    // Drawn in body, not on the root: a root opacity, visible, shadow or border makes
    // Slint inline the whole widget at every use (docs/device-themes.md, Generated code size).
    // No x, y or size: it fills the root and passes its children's layout constraints on.
    body := Rectangle {
        border-radius: Theme.tape || Theme.os95 || Theme.pocket || Theme.quest || Theme.brick || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : 11px;
        // Cozy Cabin: a wooden latch in a dark slot, on moss when on.
        if Theme.cozy: CzSwitch { x: 0; y: 0; width: root.width; height: root.height; on: root.on; hover: ph-t.has-hover && root.enabled; }
        // Pinball: a dark slot with a lamp that slides right and lights orange when on.
        if Theme.pinball: PbSwitch { x: 0; y: 0; width: root.width; height: root.height; on: root.on; hover: ph-t.has-hover && root.enabled; }
        // Phonograph: a lever in a brass ringed slot that turns wax red when on.
        if Theme.phono: PnLever { x: 0; y: 0; width: root.width; height: root.height; on: root.on; hover: ph-t.has-hover && root.enabled; }
        // Pocket: a two cell OFF ON switch in a dark ring, the live cell dark; pale when off.
        if Theme.pocket: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: Pk.l0;
            Rectangle { x: root.on ? 22px : 2px; y: 2px; width: 20px; height: 14px; background: root.enabled ? Pk.l3 : Pk.l1; }
            PkRing { ink: root.enabled ? Pk.l3 : Pk.l1; }
            Text {
                x: 2px;
                y: 2px;
                width: 20px;
                height: 14px;
                text: "OFF";
                color: !root.on ? Pk.l0 : Pk.l2;
                font-family: Pk.small;
                font-size: 8px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
            Text {
                x: 22px;
                y: 2px;
                width: 20px;
                height: 14px;
                text: "ON";
                color: root.on ? Pk.l0 : root.enabled ? Pk.l2 : Pk.l1;
                font-family: Pk.small;
                font-size: 8px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        // Car Dashboard: a blue track with a white knob when on, a dark one with a grey knob
        // when off.
        // Brick Phone: an OFF ON pair in an ink frame, the live side inverted.
        background: Theme.tape || Theme.os95 || Theme.pocket || Theme.quest || Theme.brick || Theme.answer || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? transparent : Theme.comic ? (on ? Comic.yellow : #ffffff) : on ? (Theme.dash ? #3a8dff : Theme.accent) : Theme.track;
        border-width: Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.pocket ? 0 : Theme.quest ? 0 : Theme.dash ? (on ? 0 : 1px) : Theme.comic ? 2.5px : Theme.brick ? 2px : 0;
        border-color: Theme.dash ? #ffffff1f : Theme.comic ? Comic.ink : Theme.brick ? Brick.ink : #1f7a38;
        opacity: root.enabled || Theme.os95 || Theme.pocket ? 1 : Theme.comic || Theme.quest ? 0.4 : Theme.brick || Theme.cozy || Theme.pinball || Theme.phono ? 0.38 : Theme.answer ? 0.5 : 0.45;
        // Quest Menu: ON and OFF side by side, the current one gold with the cursor before it.
        q-pair := HorizontalLayout {
            visible: Theme.quest && !root.lamp;
            x: 0;
            y: 0;
            height: parent.height;
            spacing: 12px;
            for w[k] in ["ON", "OFF"]: HorizontalLayout {
                property <bool> cur: (k == 0) == root.on;
                spacing: 4px;
                QPx {
                    y: (parent.height - self.height) / 2;
                    s: 2;
                    source: @image-url("skins/px-quest/tri.png");
                    colorize: Quest.gold;
                    opacity: parent.cur ? 1 : 0;
                }
                Text {
                    text: w;
                    color: parent.cur ? Quest.gold : Quest.dim;
                    font-family: Quest.label;
                    font-size: 11px;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
        // Quest Menu: the lamp check box.
        if Theme.quest && root.lamp: Rectangle {
            x: 0;
            y: 0;
            background: Quest.ink;
            border-width: 3px;
            border-color: root.on ? Quest.gold : Quest.grey;
            Rectangle { visible: root.on; x: 4.5px; y: 4.5px; width: 6px; height: 6px; background: Quest.gold; }
        }
        if Theme.brick: Rectangle {
            x: root.on ? parent.width / 2 : 0;
            y: 0;
            width: parent.width / 2;
            height: parent.height;
            background: Brick.ink;
        }
        if Theme.brick: Text {
            x: 0;
            y: 0;
            width: parent.width / 2;
            height: parent.height;
            text: "OFF";
            color: root.on ? Brick.ink : Brick.lcd1;
            font-family: Brick.caps;
            font-size: 7px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        if Theme.brick: Text {
            x: parent.width / 2;
            y: 0;
            width: parent.width / 2;
            height: parent.height;
            text: "ON";
            color: root.on ? Brick.lcd1 : Brick.ink;
            font-family: Brick.caps;
            font-size: 7px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        // Answering Machine: a two way slide switch in a dark slot, its left half red while on,
        // with ON or OFF printed beside it.
        if Theme.answer: Rectangle {
            x: 0;
            y: 0;
            width: 34px;
            height: 16px;
            Rectangle { x: 0; y: 1px; width: parent.width; height: parent.height; border-radius: 3px; background: #ffffff8c; }
            Rectangle { x: 0; y: 0; width: parent.width; height: parent.height; border-radius: 3px; background: #2a221d; }
            Rectangle {
                visible: root.on;
                x: 0;
                y: 0;
                width: 17px;
                height: parent.height;
                border-top-left-radius: 3px;
                border-bottom-left-radius: 3px;
                background: #6b1a10;
            }
            Rectangle { x: 3px; y: 0; width: parent.width - 6px; height: 2px; background: #00000059; }
            Rectangle {
                x: root.on ? 17px : 2px;
                y: 2px;
                width: 15px;
                height: 12px;
                animate x { duration: 120ms; easing: ease-out; }
                Rectangle { x: 0; y: 1px; width: parent.width; height: parent.height; border-radius: 2px; background: #00000080; }
                AmFace { x: 0; y: 0; width: parent.width; height: parent.height; r: 2px; top: #efe7d6; bottom: #c9bea6; }
                Rectangle { x: 2px; y: 0; width: parent.width - 4px; height: 1px; background: #ffffff; }
                for g in 3: Rectangle { x: 5px + g * 2px; y: 3px; width: 1px; height: 6px; background: #9d917a; }
            }
        }
        if Theme.answer: Text {
            x: 40px;
            y: 0;
            height: 16px;
            text: root.on ? "ON" : "OFF";
            color: root.on ? Am.rec : Am.print-soft;
            font-family: "Barlow Condensed";
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 1.28px;
            vertical-alignment: center;
            accessible-role: none;
        }
        // Pocket Synth: a white key that stays down with its LED lit orange while it is on; with
        // a caption, the words in capitals beside the LED (a latching key).
        if Theme.synth: SynKey {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            radius: 6px;
            down: root.on;
            pressed: ph-t.pressed && ph-t.has-hover;
            hover: ph-t.has-hover;
        }
        if Theme.synth: Image {
            x: (root.caption != "" ? 10px : (root.width - 6px) / 2) - 6px;
            y: (root.height - 6px) / 2 - 6px + (root.on ? 1px : 0);
            width: 18px;
            height: 18px;
            source: root.on ? (1phx < 0.7px ? @image-url("skins/dv-synth/led-on@2x.png") : @image-url("skins/dv-synth/led-on.png"))
                : (1phx < 0.7px ? @image-url("skins/dv-synth/led-off@2x.png") : @image-url("skins/dv-synth/led-off.png"));
            image-fit: fill;
        }
        syn-cap := Text {
            visible: Theme.synth && root.caption != "";
            x: 23px;
            y: root.on ? 1px : 0;
            height: root.height;
            text: root.caption.to-uppercase();
            color: #2a2a28;
            font-family: Theme.mono;
            font-size: 8.5px;
            font-weight: 700;
            letter-spacing: 1.2px;
            vertical-alignment: center;
            accessible-role: none;
        }
        // Desktop 95: a checkbox, grey when off, with its words beside it.
        if Theme.os95: Rectangle {
            x: 0;
            y: (parent.height - 13px) / 2;
            width: 13px;
            height: 13px;
            background: root.enabled ? #ffffff : Os.face;
            OsBevel { kind: 2; }
            OsPx {
                visible: root.on;
                x: 2px;
                y: 3px;
                source: @image-url("skins/dv-os95/tick.png");
                colorize: root.enabled ? #000000 : Os.sh;
            }
        }
        cap := Text {
            visible: Theme.os95 && root.caption != "";
            x: 19px;
            height: parent.height;
            text: root.caption;
            color: root.enabled ? #000000 : Os.sh;
            font-family: Os.font;
            font-size: 12.5px;
            vertical-alignment: center;
            accessible-role: none;
        }
        // Comic Book: an inked pill, yellow when on, its knob grey or red.
        if Theme.comic: Rectangle {
            x: root.on ? 21.5px : 4.5px;
            y: 4.5px;
            width: 13px;
            height: 13px;
            border-radius: 6.5px;
            background: root.on ? Comic.red : Comic.grey;
            border-width: 2px;
            border-color: Comic.ink;
            animate x { duration: 120ms; easing: ease-out; }
        }
        // Tape Deck: a slide switch in a sunk slot, with a lamp that lights when it is on.
        if Theme.tape: Rectangle {
            x: 0;
            y: 5px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.on ? @radial-gradient(circle, #fff0c8 0%, #f2a64a 45%, #9a5a14 100%) : @radial-gradient(circle, #6a5a48 0%, #3a2f25 60%, #211912 100%);
        }
        if Theme.tape: Rectangle {
            x: 15px;
            width: 38px;
            Rectangle { y: 1px; background: #ffffff80; }
            Rectangle { height: parent.height; background: root.on ? #3a2410 : #1b1410; }
            Rectangle { y: 0; height: 2px; background: #00000080; }
            Rectangle {
                x: root.on ? 20px : 2px;
                y: 2px;
                width: 16px;
                height: 14px;
                background: Deck.key-face;
                Rectangle { y: 0; height: 1px; background: #ffffff; }
                animate x { duration: 120ms; easing: ease-out; }
            }
        }
        knob := Rectangle {
            visible: !Theme.tape && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.brick && !Theme.answer && !Theme.synth && !Theme.cozy && !Theme.pinball && !Theme.phono;
            x: root.on ? root.width - self.width - 3px : 3px;
            y: 3px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: Theme.dash ? (root.on ? #ffffff : #7d8894) : root.on ? Theme.on-accent : Theme.knob;
            animate x { duration: 120ms; easing: ease-out; }
        }
        // Children given at a use site are drawn (and faded) with the rest, as before.
        @children
    }
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: on;
    accessible-label: label;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; root.toggled(root.checked); } }
    ph-t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}

// Vertical bars, one per value. Bars left of `progress` (a fraction) are orange.
export component Wave inherits Rectangle {
    in property <[float]> values;
    in property <float> progress: -1;
    in property <color> played: Theme.accent;
    in property <color> rest: Theme.wave;
    in property <length> gap: 2px;
    in property <length> min-bar: 2px;
    HorizontalLayout {
        spacing: root.gap;
        for v[i] in root.values: Rectangle {
            Rectangle {
                width: parent.width;
                height: max(root.min-bar, v * root.height);
                y: (parent.height - self.height) / 2;
                border-radius: 1.5px;
                background: (i + 0.5) / root.values.length <= root.progress ? root.played : root.rest;
            }
        }
    }
}

// One choice in the export menu.
export component ExportItem inherits Rectangle {
    in property <string> text;
    in property <string> tag;
    in property <bool> current;
    // Desktop 95: the picture before the words.
    in property <image> os-icon;
    // Brick Phone: its number in the menu.
    in property <int> num;
    callback clicked;
    height: Theme.menu-h;
    border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.answer || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.dash ? 8px : 6px;
    // Tape Deck: an amber highlighter stroke under the hovered line. Desktop 95: navy.
    // Comic Book: a pale
    // yellow line, the current format yellow with a red edge. Car Dashboard: ice
    // glass under the hovered line and the current format. Answering Machine: the hovered
    // line lit with a red edge, the current format in red.
    // Pocket: a dark row with the arrow cursor under the pointer, the current format mid
    // green.
    background: Theme.tape || Theme.quest ? transparent : Theme.phono ? (t.has-hover || root.current ? Pn.lit-row : transparent) : Theme.pinball ? (t.has-hover ? Pb.lit-row : transparent) : Theme.cozy ? (root.current ? Cz.honey : t.has-hover ? Cz.hover : transparent) : Theme.pocket ? (t.has-hover ? Pk.l3 : root.current ? Pk.l1 : transparent) : Theme.synth ? (t.has-hover ? #232625 : transparent) : Theme.dash ? (t.has-hover || root.current ? #62d2ff1f : transparent) : Theme.os95 ? (t.has-hover ? Os.navy : transparent) : Theme.comic ? (root.current ? Comic.yellow : t.has-hover ? Comic.wash : transparent)
        : Theme.brick ? (t.has-hover ? Brick.ink : transparent)
        : t.has-hover ? (Theme.answer ? Am.lit : Theme.hover) : transparent;
    accessible-role: button;
    accessible-label: "Export " + text;
    accessible-action-default => { root.clicked(); }
    if Theme.pocket && t.has-hover: PkPx { x: 5px; y: (parent.height - self.height) / 2; s: 1; source: @image-url("skins/px-pocket/chev.png"); colorize: Pk.l0; }
    if Theme.comic && root.current: Rectangle { x: 0; width: 4px; background: Comic.red; }
    if Theme.cozy && root.current: Rectangle { x: 0; width: 3px; background: Cz.ember; }
    if Theme.pinball && (root.current || t.has-hover): Rectangle { x: 0; width: 3px; background: Pb.plasma; }
    // Phonograph: the brass band with a red pointer on the hovered line and the current format.
    if Theme.phono && (root.current || t.has-hover): PnPointer { x: 5px; y: (parent.height - 7px) / 2; }
    // Quest Menu: the lit row with the glove; the current format in gold.
    if Theme.quest && t.has-hover: QLit { x: 0; y: 0; }
    if Theme.answer && t.has-hover: Rectangle { x: 0; y: 0; width: 3px; height: parent.height; background: Am.rec; }
    if Theme.tape && t.has-hover: Rectangle { y: 7px; height: 20px; background: Deck.amber.with-alpha(0.5); }
    if Theme.tape && root.current: Rectangle {
        x: 3px;
        y: (parent.height - self.height) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Deck.amber;
    }
    if Theme.os95: HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            width: 16px;
            OsPx {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.current ? @image-url("skins/dv-os95/tick.png") : root.os-icon;
                colorize: root.current && t.has-hover ? #ffffff : transparent;
            }
        }
        Text {
            text: root.text;
            color: t.has-hover ? #ffffff : #000000;
            font-family: Os.font;
            font-size: 12.5px;
            font-weight: root.current ? 700 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.tag;
            color: t.has-hover ? #d8e2ff : Os.note;
            font-family: Os.font;
            font-size: 11.5px;
            vertical-alignment: center;
        }
    }
    if Theme.quest: HorizontalLayout {
        padding-left: 27px;
        padding-right: 9px;
        spacing: 8px;
        Text {
            text: root.text;
            color: root.current ? Quest.gold : Quest.white;
            font-family: Quest.font;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.tag.to-uppercase();
            color: t.has-hover ? Quest.pale : Quest.grey;
            font-family: Quest.label;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
    // Brick Phone: its number, the format and the note in small caps; inverted while hovered.
    if Theme.brick: HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            BrickNum { text: root.num; lit: t.has-hover; }
        }
        Text {
            text: root.text;
            color: t.has-hover ? Brick.lcd1 : Brick.ink;
            font-family: Brick.words;
            font-size: 18px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.tag.to-uppercase();
            color: t.has-hover ? Brick.lcd1 : Brick.ink;
            opacity: 0.75;
            font-family: Brick.caps;
            font-size: 7px;
            letter-spacing: 0.4px;
            vertical-alignment: center;
        }
        if root.current: VerticalLayout {
            alignment: center;
            BrickPx { source: @image-url("skins/dv-brick/x-check.png"); tint: t.has-hover ? Brick.lcd1 : Brick.ink; }
        }
    }
    if !Theme.os95 && !Theme.quest && !Theme.brick: HorizontalLayout {
        padding-left: Theme.tape ? 12px : Theme.pocket || Theme.phono ? 16px : 10px;
        padding-right: Theme.tape || Theme.phono ? 12px : 10px;
        spacing: 10px;
        Text {
            text: root.text;
            color: Theme.pocket ? (t.has-hover ? Pk.l0 : Pk.l3) : Theme.tape ? Deck.ink : Theme.comic ? Comic.ink : Theme.synth ? #eef3ee : Theme.phono ? Pn.ink : Theme.pinball ? (root.current ? Pb.name-sel : Pb.ink) : Theme.cozy ? Cz.ink : Theme.dash && root.current ? Theme.accent
                : Theme.answer ? (root.current ? Am.rec : Am.ink) : t.has-hover || root.current ? Theme.text : Theme.text2;
            font-family: Theme.pocket ? Pk.big : Theme.tape ? "Oswald" : Theme.os95 ? Os.font : Theme.comic ? "Comic Neue" : Theme.dash ? "Manrope" : Theme.answer ? "Courier Prime" : Theme.synth ? Theme.mono : Theme.phono ? Pn.font : Theme.pinball ? Pb.font : Theme.cozy ? Cz.font : "Inter Tight";
            font-size: Theme.phono ? 15px : Theme.pinball ? 15px : Theme.pocket ? 20px : Theme.comic ? 13.5px : Theme.dash || Theme.answer ? 12.5px : Theme.synth ? 11.5px : 13px;
            font-weight: Theme.pocket || Theme.cozy || Theme.pinball ? 400 : Theme.phono ? 600 : Theme.dash || Theme.answer ? 700 : Theme.comic ? 700 : Theme.synth ? 500 : root.current ? 600 : 400;
            letter-spacing: Theme.tape ? 0.5px : 0;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: Theme.comic || Theme.pocket || Theme.answer || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? root.tag.to-uppercase() : root.tag;
            color: Theme.phono ? Pn.ink-soft : Theme.pinball ? Pb.mute : Theme.cozy ? (root.current ? Cz.brown : Cz.parch-dd) : Theme.pocket ? (t.has-hover ? Pk.l1 : Pk.l2) : Theme.tape ? Deck.ink-soft : Theme.comic ? (root.current ? Comic.sub-on-yellow : Comic.sub) : Theme.answer ? Am.print-soft : Theme.synth ? #7d857f : Theme.dim;
            font-family: Theme.pocket ? Pk.small : Theme.comic ? "Bangers" : Theme.answer ? "Barlow Condensed" : Theme.cozy ? Cz.caps : Theme.phono ? Pn.caps : Theme.mono;
            font-size: Theme.phono ? 8.5px : Theme.pinball ? 10px : Theme.pocket ? 8px : Theme.tape ? 10.5px : Theme.comic ? 12px : Theme.answer ? 9px : Theme.synth ? 7.5px : Theme.cozy ? 10px : 11px;
            font-weight: Theme.answer || Theme.synth || Theme.cozy ? 700 : Theme.phono ? 600 : 400;
            letter-spacing: Theme.comic || Theme.pocket ? 1px : Theme.answer ? 1.44px : Theme.synth ? 1.1px : Theme.cozy || Theme.phono ? 1.5px : 0;
            vertical-alignment: center;
        }
        // Pocket Synth: the current format marked by an orange square.
        if Theme.synth && root.current: VerticalLayout {
            alignment: center;
            Rectangle { width: 6px; height: 6px; background: #ff5a1e; }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A line between the groups of a menu: an etched pair of lines for Desktop 95, a thick ink
// rule across the Comic Book's panel.
export component MenuRule inherits Rectangle {
    height: 9px;
    if !Theme.os95 && !Theme.pocket && !Theme.quest: Rectangle {
        x: Theme.comic ? -2px : Theme.brick ? 4px : Theme.pinball ? 0 : 10px;
        y: Theme.comic ? 3px : (parent.height - self.height) / 2;
        width: parent.width + (Theme.comic ? 4px : Theme.brick ? -8px : Theme.pinball ? 0 : -20px);
        height: Theme.comic ? 2.5px : 1px;
        background: Theme.phono ? transparent : Theme.pinball ? Pb.rule : Theme.cozy ? transparent : Theme.tape ? #2a1c1240 : Theme.comic ? Comic.ink : Theme.answer ? Am.paper-line : Theme.synth ? #2b2f2d : Theme.edge;
    }
    // Phonograph: brass fading out at both ends.
    if Theme.phono: PnRule { x: 10px; y: 4px; width: parent.width - 20px; }
    // Quest Menu: a 3px blue rule across the window.
    if Theme.quest: Rectangle { x: 0; y: 3px; width: parent.width; height: 3px; background: Quest.sep; }
    // Cozy Cabin: a dotted rule.
    if Theme.cozy: CzRule { x: 12px; y: 3px; width: parent.width - 24px; }
    if Theme.os95: Rectangle { x: 1px; y: 3px; width: parent.width - 2px; height: 1px; background: Os.sh; }
    if Theme.os95: Rectangle { x: 1px; y: 4px; width: parent.width - 2px; height: 1px; background: Os.hi; }
    // Pocket: a dotted rule in mid green.
    if Theme.pocket: PkTile { x: 4px; y: 4px; width: parent.width - 8px; height: 2px; source: @image-url("skins/px-pocket/rule-row.png"); colorize: Pk.l2; }
}

// The name of a group in a Pocket menu: light small caps on a mid green band across the
// menu. It takes no room in the other looks.
component MenuBand inherits Rectangle {
    in property <string> text;
    visible: Theme.pocket;
    horizontal-stretch: Theme.pocket ? 1 : 0;
    max-width: Theme.pocket ? 100000px : 0px;
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 14px;
        background: Pk.l2;
        Text {
            x: 16px;
            y: 0;
            height: parent.height;
            text: root.text;
            color: Pk.l0;
            font-family: Pk.small;
            font-size: 8px;
            letter-spacing: 1px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The name of a group in a Comic Book menu: yellow letters on an ink tag. It takes no
// room in the other looks.
component MenuTag inherits Rectangle {
    in property <string> text;
    visible: Theme.comic;
    width: Theme.comic ? t.preferred-width + 12px : 0;
    horizontal-stretch: 0;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 17px;
        background: Comic.ink;
        t := Text {
            x: 6px;
            y: 1px;
            height: parent.height - 1px;
            text: root.text;
            color: Comic.yellow;
            font-family: "Bangers";
            font-size: 11.5px;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
    }
}

// The name of a group of choices in a menu (an ink tag in the Comic Book).
component MenuGroup inherits HorizontalLayout {
    in property <string> text;
    padding-left: Theme.os95 ? 30px : Theme.pocket ? 0 : Theme.quest ? 27px : Theme.brick ? 27px : Theme.phono ? 16px : 10px;
    height: 24px;
    MenuTag { text: root.text; }
    MenuBand { text: root.text; }
    Text {
        visible: !Theme.comic && !Theme.pocket;
        text: Theme.pocket ? "" : Theme.cozy || Theme.pinball || Theme.phono ? root.text.to-uppercase() : root.text;
        max-width: Theme.pocket ? 0px : 100000px;
        color: Theme.phono ? Pn.brass-lo : Theme.pinball ? Pb.cap : Theme.tape ? Deck.ink-soft : Theme.os95 ? Os.note : Theme.dash ? #56606c : Theme.quest ? Quest.gold : Theme.cozy ? Cz.brown : Theme.answer ? Am.print-soft : Theme.synth ? #7d857f : Theme.dim;
        font-family: Theme.os95 ? Os.font : Theme.dash ? "Manrope" : Theme.quest ? Quest.label : Theme.brick ? Brick.caps : Theme.answer ? "Barlow Condensed" : Theme.phono ? Pn.caps : Theme.pinball ? Pb.font : Theme.cozy ? Cz.caps : Theme.mono;
        font-size: Theme.phono ? 8.5px : Theme.pinball ? 10px : Theme.tape || Theme.cozy ? 9.5px : Theme.os95 ? 11px : Theme.dash || Theme.answer ? 8.5px : Theme.brick ? 7px : Theme.synth ? 7.5px : 10px;
        font-weight: Theme.dash ? 800 : Theme.answer || Theme.cozy || Theme.pinball || Theme.phono ? 700 : Theme.synth ? 700 : 400;
        letter-spacing: Theme.phono ? 2px : Theme.pinball ? 3px : Theme.tape ? 1.7px : Theme.os95 ? 1px : Theme.dash || Theme.answer ? 2.2px : Theme.synth ? 1.9px : Theme.cozy ? 2px : 0;
        vertical-alignment: center;
    }
}

// Every export, grouped: the full project, the audio formats, and the transcript
// files. `choose` gets 7 for the full project, 0 to 2 for FLAC, WAV and MP3, and 3 to 6
// for SRT, VTT, word timestamps and the timed text.
export component ExportChoices inherits VerticalLayout {
    in property <bool> subtitles;
    in property <int> format: -1;
    callback choose(int);
    ExportItem { num: 1; text: "All files"; tag: "folder"; os-icon: @image-url("skins/dv-os95/fopen.png"); clicked => { root.choose(7); } }
    MenuRule { }
    MenuGroup { text: "AUDIO"; }
    ExportItem { num: 2; text: "FLAC"; tag: "lossless"; os-icon: @image-url("skins/dv-os95/wave.png"); current: root.format == 0; clicked => { root.choose(0); } }
    ExportItem { num: 3; text: "WAV"; tag: "standard"; os-icon: @image-url("skins/dv-os95/wave.png"); current: root.format == 1; clicked => { root.choose(1); } }
    ExportItem { num: 4; text: "MP3"; tag: "small"; os-icon: @image-url("skins/dv-os95/wave.png"); current: root.format == 2; clicked => { root.choose(2); } }
    if root.subtitles: MenuRule { }
    if root.subtitles: MenuGroup { text: "TRANSCRIPT"; }
    if root.subtitles: ExportItem { num: 5; text: "Text with times"; tag: "txt"; os-icon: @image-url("skins/dv-os95/notepad.png"); clicked => { root.choose(6); } }
    if root.subtitles: ExportItem { num: 6; text: "Subtitles SRT"; tag: "video"; os-icon: @image-url("skins/dv-os95/notepad.png"); clicked => { root.choose(3); } }
    if root.subtitles: ExportItem { num: 7; text: "Subtitles VTT"; tag: "web"; os-icon: @image-url("skins/dv-os95/notepad.png"); clicked => { root.choose(4); } }
    if root.subtitles: ExportItem { num: 8; text: "Word timestamps"; tag: "json"; os-icon: @image-url("skins/dv-os95/notepad.png"); clicked => { root.choose(5); } }
}

// Height of ExportChoices.
// The window's height, so a dropdown can open upwards when there is no room below.
export global Win {
    in-out property <length> width: 520px;
    in-out property <length> height: 600px;
}

export global ExportSize {
    out property <length> audio: Theme.menu-h + 9px + 24px + 3 * Theme.menu-h;
    out property <length> transcript: 9px + 24px + 4 * Theme.menu-h;
}

// One row in a menu.
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> more;
    // The current choice: a check mark on the right.
    in property <bool> checked;
    in property <bool> enabled: true;
    // The row a submenu belongs to stays lit while its submenu is open.
    in property <bool> lit;
    // Tape Deck and Comic Book and Car Dashboard only: an icon before the text; Tape Deck: the plain
    // hover of the
    // project drawer; Car Dashboard: the icon on a tile (a project).
    in property <string> icon;
    in property <bool> drawer;
    // Comic Book only: the name in Bangers capitals (the projects of the project menu).
    in property <bool> caption;
    in property <bool> tile;
    // Brick Phone only: its number in the menu (0 for none); the icon sits on the right.
    in property <int> num;
    // Pocket Synth only: a project's number before its name, as the banks are numbered.
    in property <string> syn-num;
    out property <bool> hovered: t.has-hover;
    callback clicked;
    // Desktop 95 only: a picture before the words (else the one for `icon`).
    in property <image> os-icon: Theme.os95 ? OsIcons.pick(root.icon) : @image-url("");
    property <bool> os-hot: (t.has-hover || root.lit) && root.enabled;
    height: Theme.menu-h;
    // Drawn in body, not on the root: a root opacity, visible, shadow or border makes
    // Slint inline the whole widget at every use (docs/device-themes.md, Generated code size).
    // No x, y or size: it fills the root and passes its children's layout constraints on.
    body := Rectangle {
        border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.brick || Theme.answer || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.dash ? 8px : 6px;
        // Answering Machine: the hovered row (and the row of an open submenu) lit with a red
        // edge.
        if Theme.answer && (t.has-hover || root.lit) && root.enabled: Rectangle { x: 0; y: 0; width: 3px; height: parent.height; background: Am.rec; }
        // Pinball: the hovered row and the row of an open submenu lit plasma with an edge.
        Rectangle { visible: root.pb-lit; x: 0; y: 0; width: 3px; height: parent.height; background: Pb.plasma; }
        // Phonograph: the hovered row and the row of an open submenu on a brass band with a
        // red pointer.
        if root.pn-lit: PnPointer { x: 5px; y: (parent.height - 7px) / 2; }
        background: Theme.tape || Theme.quest ? transparent : Theme.pocket ? (root.pk-hot ? Pk.l3 : root.checked ? Pk.l1 : transparent)
            : Theme.pinball ? (root.pb-lit ? Pb.lit-row : transparent)
            : Theme.phono ? (root.pn-lit ? Pn.lit-row : transparent)
            : Theme.cozy ? (root.cz-lit ? Cz.honey : t.has-hover && root.enabled ? Cz.hover : transparent)
            : Theme.os95 || Theme.brick ? (root.os-hot ? (Theme.brick ? Brick.ink : Os.navy) : transparent)
            : Theme.comic ? (root.ink-lit ? Comic.yellow : t.has-hover && root.enabled ? Comic.wash : transparent)
            : Theme.synth ? (root.syn-lit ? #ff5a1e : t.has-hover && root.enabled ? #232625 : transparent)
            : (t.has-hover || root.lit) && root.enabled ? (Theme.dash ? #62d2ff1f : Theme.answer ? Am.lit : Theme.hover) : transparent;
        Rectangle { visible: root.ink-lit; x: 0; width: 4px; background: Comic.red; }
        Rectangle { visible: root.cz-lit; x: 0; width: 3px; background: Cz.ember; }
        QLit { visible: root.q-lit; x: 0; y: 0; }
        opacity: root.enabled || Theme.os95 || Theme.pocket || Theme.quest || (Theme.synth && root.checked) ? 1 : Theme.brick ? 0.38 : 0.4;
        if Theme.pocket: HorizontalLayout {
            padding-left: 16px;
            padding-right: 10px;
            spacing: 8px;
            if root.pk-icon.width > 0: PkPx { y: (parent.height - self.height) / 2; source: root.pk-icon; colorize: root.pk-ink; }
            Text {
                text: root.text;
                color: root.pk-ink;
                font-family: Pk.big;
                font-size: 20px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                accessible-role: none;
            }
            if root.more: PkPx { y: (parent.height - self.height) / 2; source: @image-url("skins/px-pocket/chev.png"); colorize: root.pk-ink; }
            if root.checked: PkPx { y: (parent.height - self.height) / 2; source: @image-url("skins/px-pocket/tick.png"); colorize: root.pk-ink; }
        }
        PkPx { visible: root.pk-hot; x: 5px; y: (parent.height - self.height) / 2; s: 1; source: @image-url("skins/px-pocket/chev.png"); colorize: Pk.l0; }
        // Brick Phone: the number, the words, the icon or arrow and the check; inverted while
        // hovered or while its submenu is open.
        if Theme.brick: HorizontalLayout {
            padding-left: 6px;
            padding-right: 8px;
            spacing: 7px;
            if root.num > 0: VerticalLayout {
                alignment: center;
                BrickNum { text: root.num; lit: root.os-hot; }
            }
            Text {
                text: root.text;
                color: root.os-hot ? Brick.lcd1 : Brick.ink;
                font-family: Brick.words;
                font-size: 18px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                accessible-role: none;
            }
            if root.icon != "" && !root.tile: VerticalLayout {
                alignment: center;
                BrickPx { source: BrickIcons.pick(root.icon); tint: root.os-hot ? Brick.lcd1 : Brick.ink; }
            }
            if root.more || root.checked: VerticalLayout {
                alignment: center;
                BrickPx {
                    source: root.more ? @image-url("skins/dv-brick/x-rt.png") : @image-url("skins/dv-brick/x-check.png");
                    tint: root.os-hot ? Brick.lcd1 : Brick.ink;
                }
            }
        }
        // Tape Deck: an amber highlighter stroke under the hovered line.
        if Theme.tape && !root.drawer && (t.has-hover || root.lit) && root.enabled: Rectangle { y: 7px; height: 20px; background: Deck.amber.with-alpha(0.5); }
        if Theme.tape && root.drawer && t.has-hover && root.enabled: Rectangle { background: #00000014; }
        // Desktop 95: navy while hovered; grey etched words when it is off.
        if Theme.os95: HorizontalLayout {
            padding-left: 6px;
            padding-right: 8px;
            spacing: 6px;
            Rectangle {
                width: 16px;
                OsPx {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.os-icon;
                    colorize: root.os-hot && root.os-icon.width < 12 ? #ffffff : transparent;
                    opacity: root.enabled ? 1 : 0.45;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                Text {
                    visible: !root.enabled;
                    x: 1px;
                    y: 1px;
                    width: parent.width;
                    height: parent.height;
                    text: root.text;
                    color: Os.hi;
                    font-family: Os.font;
                    font-size: 12.5px;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.text;
                    color: !root.enabled ? Os.sh : root.os-hot ? #ffffff : #000000;
                    font-family: Os.font;
                    font-size: 12.5px;
                    font-weight: root.checked ? 700 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
            }
            if root.more || root.checked: Rectangle {
                width: 10px;
                OsPx {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.more ? @image-url("skins/dv-os95/play.png") : @image-url("skins/dv-os95/tick.png");
                    colorize: root.os-hot ? #ffffff : transparent;
                }
            }
        }
        // Quest Menu: the words in the pixel face (gold for the current choice, light red for
        // Delete, dim when off), an icon before them, the more arrow or a gold check after.
        if Theme.quest: HorizontalLayout {
            padding-left: 27px;
            padding-right: 9px;
            spacing: 8px;
            property <image> q-icon: QIcons.pick(root.icon);
            if root.icon != "" && self.q-icon.width > 0: QPx {
                y: (parent.height - self.height) / 2;
                source: parent.q-icon;
                colorize: !root.enabled ? Quest.dim : root.danger ? Quest.lred : Quest.white;
            }
            Text {
                text: root.text;
                color: !root.enabled ? Quest.dim : root.danger ? Quest.lred : root.checked ? Quest.gold : Quest.white;
                font-family: Quest.font;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.more: QPx {
                y: (parent.height - self.height) / 2;
                source: @image-url("skins/px-quest/chev.png");
                s: 2;
                colorize: root.q-lit ? Quest.gold : Quest.grey;
            }
            if root.checked: QPx {
                y: (parent.height - self.height) / 2;
                source: @image-url("skins/px-quest/tick.png");
                colorize: Quest.gold;
            }
        }
        if !Theme.os95 && !Theme.pocket && !Theme.quest && !Theme.brick: HorizontalLayout {
            padding-left: Theme.phono ? 16px : 10px;
            padding-right: Theme.phono ? 12px : 8px;
            spacing: (Theme.tape || Theme.comic || Theme.answer || Theme.cozy || Theme.pinball || Theme.phono) && root.icon != "" ? 9px : 10px;
            if (Theme.tape || Theme.comic || Theme.answer || Theme.cozy || Theme.pinball || Theme.phono) && root.icon != "": Icon {
                name: root.icon;
                tint: Theme.phono ? (root.danger ? Pn.wax : Pn.ink) : Theme.pinball ? (root.danger ? Pb.danger : Pb.icon) : Theme.cozy ? (root.danger ? Cz.ember-d : Cz.ink) : Theme.comic ? (root.danger ? Comic.red : Comic.ink) : Theme.answer ? (root.danger ? Am.rec : Am.print) : root.danger ? Deck.red : Deck.alu-ink;
                width: 13px;
                height: 13px;
                y: (parent.height - self.height) / 2;
            }
            // Car Dashboard: an icon before every row, and a folder tile before a project.
            if Theme.dash && root.icon == "folder" && root.tile: Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: root.checked ? #3a8dff : #20262e;
                Icon { name: "folder"; tint: root.checked ? #04121c : #8a95a3; width: 11px; height: 11px; }
            }
            if Theme.dash && root.icon != "" && !root.tile: Icon {
                name: root.icon;
                tint: root.danger ? #ff8a95 : root.lit ? Theme.accent : Theme.dim;
                width: 13px;
                height: 13px;
                y: (parent.height - self.height) / 2;
            }
            // Pocket Synth: an icon before an action, a number before a project.
            if Theme.synth && root.icon != "" && !root.tile: Icon {
                name: root.icon;
                tint: root.syn-lit ? #ffffff : root.danger ? #ff7a48 : #eef3ee;
                stroke-width: 1.8px;
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
            }
            if Theme.synth && root.syn-num != "": Text {
                width: 14px;
                text: root.syn-num;
                color: root.syn-lit ? #ffd9c8 : #7d857f;
                font-family: Theme.mono;
                font-size: 8px;
                font-weight: 700;
                vertical-alignment: center;
                accessible-role: none;
            }
            Text {
                text: Theme.comic && root.caption ? root.text.to-uppercase() : root.text;
                color: Theme.tape ? (root.danger ? Deck.red : Deck.ink) : Theme.comic ? (root.danger ? Comic.red : Comic.ink)
                    : Theme.dash ? (root.danger ? #ff8a95 : root.lit || (root.tile && root.checked) ? Theme.accent : Theme.text)
                    : Theme.answer ? (root.danger ? Am.rec : Am.ink)
                    : Theme.synth ? (root.syn-lit ? #ffffff : root.danger ? #ff7a48 : #eef3ee)
                    : Theme.pinball ? (root.danger ? Pb.danger : !root.enabled && root.checked ? Pb.mute : root.checked ? Pb.name-sel : Pb.ink)
                    : Theme.phono ? (root.danger || root.checked ? Pn.wax : Pn.ink)
                    : Theme.cozy ? (root.danger ? Cz.ember-d : !root.enabled && root.checked ? Cz.parch-dd : Cz.ink)
                    : root.danger ? Theme.danger : t.has-hover ? Theme.text : Theme.text2;
                font-family: Theme.tape ? "Oswald" : Theme.os95 ? Os.font : Theme.comic ? (root.caption ? "Bangers" : "Comic Neue") : Theme.dash ? "Manrope" : Theme.answer ? "Courier Prime" : Theme.synth ? Theme.mono : Theme.phono ? Pn.font : Theme.pinball ? Pb.font : Theme.cozy ? Cz.font : "Inter Tight";
                font-size: Theme.phono ? 15px : Theme.pinball ? 15px : Theme.cozy ? 13px : Theme.comic ? (root.caption ? 15px : 13.5px) : Theme.dash || Theme.answer ? 12.5px : Theme.synth ? 11.5px : 13px;
                font-weight: Theme.cozy || Theme.pinball ? 400 : Theme.phono ? 600 : Theme.comic ? (root.caption ? 400 : 700) : Theme.dash || Theme.answer ? 700 : Theme.synth ? 500 : Theme.tape && root.checked ? 600 : 400;
                letter-spacing: Theme.tape ? 0.5px : Theme.comic && root.caption ? 1px : 0;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.more: Icon {
                name: "chevron";
                tint: Theme.phono ? Pn.ink : Theme.pinball ? Pb.plasma : Theme.cozy ? Cz.brown : Theme.tape ? Deck.ink-soft : Theme.comic ? Comic.ink : Theme.synth ? (root.syn-lit ? #ffffff : #b9c0ba) : Theme.dim;
                width: 13px;
                height: 13px;
                y: (parent.height - self.height) / 2;
            }
            // Pocket Synth: the current project an orange square where it cannot be picked.
            if root.checked && Theme.synth && !root.enabled: VerticalLayout {
                alignment: center;
                Rectangle { width: 6px; height: 6px; background: #ff5a1e; }
            }
            if root.checked && !(Theme.synth && !root.enabled): Icon {
                name: "check";
                tint: Theme.tape ? Deck.red : Theme.comic ? Comic.ink : Theme.answer ? (root.enabled ? Am.rec : Am.print-soft) : Theme.synth ? #ffffff : Theme.phono ? Pn.ink : Theme.pinball ? (root.enabled ? Pb.plasma : Pb.mute) : Theme.cozy ? (root.enabled ? Cz.ink : Cz.parch-dd) : Theme.accent;
                width: 13px;
                height: 13px;
                y: (parent.height - self.height) / 2;
            }
        }
        // Children given at a use site are drawn (and faded) with the rest, as before.
        @children
    }
    // Pocket Synth: the open row and the current project lit orange, a dark line under the
    // pointer.
    property <bool> syn-lit: Theme.synth && root.enabled && (root.lit || root.checked);
    // Cozy Cabin: the open row and the current project honey with an ember edge.
    property <bool> cz-lit: Theme.cozy && root.enabled && (root.lit || root.checked);
    // Pinball: the hovered row and the open row lit plasma.
    property <bool> pb-lit: Theme.pinball && root.enabled && (root.lit || t.has-hover);
    // Phonograph: the hovered row and the open row on a brass band.
    property <bool> pn-lit: Theme.phono && root.enabled && (root.lit || t.has-hover);
    // Comic Book: a pale yellow line on hover; the open row and the current project
    // yellow with a red edge.
    property <bool> ink-lit: Theme.comic && root.enabled && (root.lit || root.checked);
    // Car Dashboard: ice glass under the hovered row and the row of an open submenu.
    // Pocket: a dark row with the arrow cursor while hovered or open, the current choice
    // mid green with a check.
    property <bool> pk-hot: Theme.pocket && (t.has-hover || root.lit) && root.enabled;
    // Quest Menu: the hovered row and the row of an open submenu lit, the glove on it.
    property <bool> q-lit: Theme.quest && (t.has-hover || root.lit) && root.enabled;
    accessible-role: button;
    accessible-label: text;
    accessible-checked: root.checked;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    property <image> pk-icon: Theme.pocket ? PkIcons.pick(root.icon) : @image-url("");
    property <color> pk-ink: root.pk-hot ? Pk.l0 : root.enabled ? Pk.l3 : Pk.l1;
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The project menu: pick a project, make a new one, or rename, delete (when empty) or
// export the current one. Project 0 is Inbox. It opens under the element it fills, so a
// skin can give the picker its own look.
export component ProjectMenu inherits Rectangle {
    in property <[string]> projects;
    in property <int> current;
    in property <bool> has-clips;
    callback choose(int);
    callback create();
    callback rename();
    callback delete();
    callback export();
    // Opens above the picker instead of below it (a picker at the bottom of the window).
    in property <bool> up;
    property <int> shown-rows: min(root.projects.length, 8);
    public function show() { popup.show(); }
    popup := PopupWindow {
        x: 0;
        y: root.up ? -self.height - 4px : root.height + 4px;
        width: 220px;
        height: root.shown-rows * Theme.menu-h + 9px + (root.current > 0 ? 4 : 2) * Theme.menu-h + 2 * Theme.menu-pad + Theme.menu-top;
        close-policy: close-on-click-outside;
        // Tape Deck: an aluminium drawer of label tapes, the current project on red tape.
        if Theme.tape: Rectangle {
            background: Deck.alu;
            border-width: 1px;
            border-color: #0f0a06;
            Image {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                source: 1phx < 0.7px ? @image-url("skins/tape/alu@2x.png") : @image-url("skins/tape/alu.png");
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
                horizontal-alignment: left;
                vertical-alignment: top;
            }
            Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 1px; background: #ffffff99; }
            VerticalLayout {
                padding: 5px;
                Flickable {
                    height: root.shown-rows * 34px;
                    content-height: root.projects.length * 34px;
                    for p[i] in root.projects: Rectangle {
                        y: i * 34px;
                        width: parent.width;
                        height: 34px;
                        background: pt.has-hover ? #00000014 : transparent;
                        accessible-role: button;
                        accessible-label: p;
                        accessible-checked: i == root.current;
                        accessible-action-default => { root.choose(i); popup.close(); }
                        Rectangle {
                            x: 8px;
                            y: 6px;
                            width: strip.preferred-width + 18px;
                            height: 22px;
                            border-radius: 2px;
                            background: i == root.current ? Deck.dymo-red : Deck.dymo;
                            Rectangle { y: parent.height; height: 1px; background: #00000080; }
                            strip := Text {
                                text: p.to-uppercase();
                                color: #f5f1e8;
                                font-family: Theme.mono;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 2.4px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                accessible-role: none;
                            }
                        }
                        if i == root.current: Icon {
                            x: parent.width - 21px;
                            y: (parent.height - self.height) / 2;
                            name: "check";
                            tint: Deck.red;
                            width: 13px;
                            height: 13px;
                        }
                        pt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.choose(i); popup.close(); }
                        }
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle { x: 10px; y: 4px; width: parent.width - 20px; height: 1px; background: #00000047; }
                    Rectangle { x: 10px; y: 5px; width: parent.width - 20px; height: 1px; background: #ffffff8c; }
                }
                MenuRow { drawer: true; icon: "plus"; text: "New project"; clicked => { root.create(); popup.close(); } }
                if root.current > 0: MenuRow { drawer: true; icon: "pencil"; text: "Rename project"; clicked => { root.rename(); popup.close(); } }
                MenuRow { drawer: true; icon: "export"; text: "Export project"; enabled: root.has-clips; clicked => { root.export(); popup.close(); } }
                if root.current > 0: MenuRow { drawer: true; icon: "trash"; text: "Delete project"; danger: true; enabled: !root.has-clips; clicked => { root.delete(); popup.close(); } }
            }
        }
        // Desktop 95: a white drop down list with folders.
        if !Theme.tape: MenuCard {
            list: true;
            // Brick Phone: the phone book, numbered under its title.
            title: "Projects";
            VerticalLayout {
                padding: Theme.menu-pad;
                padding-top: 5px + Theme.menu-top;
                Flickable {
                    height: root.shown-rows * Theme.menu-h;
                    content-height: root.projects.length * Theme.menu-h;
                    for p[i] in root.projects: MenuRow {
                        y: i * Theme.menu-h;
                        width: parent.width;
                        num: i + 1;
                        text: p;
                        os-icon: Theme.os95 ? @image-url("skins/dv-os95/folder.png") : @image-url("");
                        caption: true;
                        icon: Theme.dash || Theme.answer ? "folder" : "";
                        tile: true;
                        syn-num: Theme.synth ? (i < 9 ? "0" : "") + (i + 1) : "";
                        checked: i == root.current;
                        clicked => { root.choose(i); popup.close(); }
                    }
                }
                MenuRule { }
                MenuRow { icon: "plus"; text: "New project"; clicked => { root.create(); popup.close(); } }
                if root.current > 0: MenuRow { icon: "pencil"; text: "Rename project"; clicked => { root.rename(); popup.close(); } }
                MenuRow { icon: "export"; text: "Export project"; enabled: root.has-clips; clicked => { root.export(); popup.close(); } }
                if root.current > 0: MenuRow { icon: "trash"; text: "Delete project"; danger: true; enabled: !root.has-clips; clicked => { root.delete(); popup.close(); } }
            }
        }
    }
}

// The project dropdown over the clip list; ProjectMenu holds what it offers.
export component ProjectPicker inherits Rectangle {
    in property <[string]> projects;
    in property <int> current;
    in property <bool> enabled: true;
    in property <bool> has-clips;
    callback choose(int);
    callback create();
    callback rename();
    callback delete();
    callback export();
    width: row.preferred-width + 16px;
    height: 30px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: t.has-hover && root.enabled ? Theme.raised : transparent;
    accessible-role: combobox;
    accessible-label: "Project";
    accessible-value: root.current >= 0 && root.current < root.projects.length ? root.projects[root.current] : "";
    accessible-expandable: true;
    accessible-action-default => { if (root.enabled) { menu.show(); } }
    accessible-action-expand => { if (root.enabled) { menu.show(); } }
    // Name and arrow inside the box, so both light up and open the list.
    row := HorizontalLayout {
        x: 8px;
        width: parent.width - 16px;
        alignment: start;
        spacing: 6px;
        Text {
            text: root.current >= 0 && root.current < root.projects.length ? root.projects[root.current] : "";
            color: Theme.text;
            font-size: 13px;
            font-weight: 800;
            vertical-alignment: center;
        }
        Icon {
            name: "down";
            tint: Theme.muted;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
        }
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := ProjectMenu {
        width: parent.width;
        height: parent.height;
        projects: root.projects;
        current: root.current;
        has-clips: root.has-clips;
        choose(i) => { root.choose(i); }
        create => { root.create(); }
        rename => { root.rename(); }
        delete => { root.delete(); }
        export => { root.export(); }
    }
}

// The menu of a clip row: manage, rename, export, move, delete, and merge when several
// are picked. It fills the row it belongs to and opens at a point in it, kept inside
// the window.
export component ClipMenu inherits Rectangle {
    in property <ClipRow> item;
    // How many clips are picked, when this one is among them; the menu offers to merge.
    in property <int> merge-count;
    // The projects, for "Move to", and the one this clip is in.
    in property <[string]> projects;
    in property <int> project;
    // The window's height, so the menu and its submenus stay inside it.
    in property <length> window-h: 10000px;
    callback merge();
    callback open();
    callback rename();
    callback export(int);
    callback delete();
    callback move-to(int);
    // The submenu open beside the menu: 1 export formats, 2 projects, 0 none.
    property <int> sub;
    // Where the menu opens.
    property <length> menu-x;
    property <length> menu-y;
    // Opens the menu at a point of the row (row coordinates).
    public function show-at(x: length, y: length) {
        menu.close();
        root.menu-x = min(x, root.width - 210px);
        root.menu-y = y;
        root.sub = 0;
        menu.show();
    }
    // Sizes of the menu and its submenus.
    property <length> main-w: 210px;
    property <length> sub-w: root.sub == 1 ? 250px : 210px;
    property <length> merge-h: root.merge-count >= 2 ? Theme.menu-h + 9px : 0;
    property <length> main-h: (root.projects.length > 1 ? 5 : 4) * Theme.menu-h + 9px + 2 * Theme.menu-pad + self.merge-h + Theme.menu-top;
    property <length> sub-h: Theme.menu-top + (root.sub == 1 ? 2 * Theme.menu-pad + ExportSize.audio + (root.item.transcribed ? ExportSize.transcript : 0)
        : 2 * Theme.menu-pad + min(root.projects.length, 8) * Theme.menu-h);
    // Where the submenu's row sits in the menu.
    property <length> sub-row-y: Theme.menu-pad + Theme.menu-top + self.merge-h + (root.sub == 2 ? 3 : 2) * Theme.menu-h;
    // Brick Phone: the menu's lines are numbered like a phone menu.
    property <int> first: root.merge-count >= 2 ? 1 : 0;
    // The submenu opens to the right when there is room, else to the left.
    property <bool> sub-left: root.menu-x + self.main-w + 4px + self.sub-w > root.width;
    property <length> left-x: min(root.menu-x, root.width - self.main-w);
    // The menu and the submenu are placed here so both fit in the window. Left to
    // Slint, a popup that grows past the window's bottom gets pushed up as a whole,
    // so the menu jumped when a submenu opened.
    property <length> top-y: max(8px - root.absolute-position.y, min(root.menu-y, root.window-h - root.absolute-position.y - root.main-h - 8px));
    property <length> room: root.window-h - root.absolute-position.y - root.top-y - 8px;
    property <length> sub-fit: min(root.sub-row-y - Theme.menu-pad, root.room - root.sub-h);
    // How far the popup starts above the menu, when the submenu needs that room.
    property <length> lift: root.sub != 0 ? max(0px, min(-root.sub-fit, root.absolute-position.y + root.top-y - 8px)) : 0px;
    property <length> sub-y: max(0px, root.sub-fit + root.lift);
    menu := PopupWindow {
        x: root.sub != 0 && root.sub-left ? root.left-x - root.sub-w - 4px : root.left-x;
        y: root.top-y - root.lift;
        width: root.main-w + (root.sub != 0 ? root.sub-w + 4px : 0);
        height: max(root.lift + root.main-h, root.sub != 0 ? root.sub-y + root.sub-h : 0);
        close-policy: close-on-click-outside;
        MenuCard {
            x: root.sub != 0 && root.sub-left ? root.sub-w + 4px : 0;
            y: root.lift;
            width: root.main-w;
            height: root.main-h;
            title: root.merge-count >= 2 ? root.merge-count + " clips" : root.item.name;
            VerticalLayout {
                padding: Theme.menu-pad;
                padding-top: 5px + Theme.menu-top;
                if root.merge-count >= 2: MenuRow {
                    num: 1;
                    text: "Merge " + root.merge-count + " clips";
                    icon: Theme.dash || Theme.answer ? "list" : Theme.synth ? "plus" : "";
                    changed hovered => { if (self.hovered) { root.sub = 0; } }
                    clicked => { root.merge(); menu.close(); }
                }
                if root.merge-count >= 2: MenuRule { }
                MenuRow {
                    num: root.first + 1;
                    text: "Manage";
                    icon: Theme.dash || Theme.answer ? "chevron" : Theme.synth ? "list" : "";
                    changed hovered => { if (self.hovered) { root.sub = 0; } }
                    clicked => { root.open(); menu.close(); }
                }
                MenuRow {
                    num: root.first + 2;
                    text: "Rename";
                    icon: Theme.dash || Theme.answer || Theme.synth ? "pencil" : "";
                    changed hovered => { if (self.hovered) { root.sub = 0; } }
                    clicked => { root.rename(); menu.close(); }
                }
                MenuRow {
                    num: root.first + 3;
                    text: "Export";
                    icon: Theme.dash || Theme.answer || Theme.synth ? "export" : "";
                    more: true;
                    lit: root.sub == 1;
                    changed hovered => { if (self.hovered) { root.sub = 1; } }
                    clicked => { root.sub = 1; }
                }
                if root.projects.length > 1: MenuRow {
                    num: root.first + 4;
                    text: "Move to";
                    icon: Theme.dash || Theme.answer || Theme.synth ? "folder" : "";
                    more: true;
                    lit: root.sub == 2;
                    changed hovered => { if (self.hovered) { root.sub = 2; } }
                    clicked => { root.sub = 2; }
                }
                MenuRule { }
                MenuRow {
                    num: root.first + (root.projects.length > 1 ? 5 : 4);
                    text: "Delete";
                    icon: Theme.dash || Theme.pocket || Theme.brick || Theme.answer || Theme.synth ? "trash" : "";
                    danger: true;
                    changed hovered => { if (self.hovered) { root.sub = 0; } }
                    clicked => { root.delete(); menu.close(); }
                }
            }
        }
        // The submenu, level with its row.
        if root.sub != 0: MenuCard {
            x: root.sub-left ? 0 : root.main-w + 4px;
            y: root.sub-y;
            width: root.sub-w;
            height: root.sub-h;
            sub: true;
            title: root.sub == 1 ? "Export" : "Move to";
            if root.sub == 1: VerticalLayout {
                padding: Theme.menu-pad;
                padding-top: 5px + Theme.menu-top;
                ExportChoices {
                    subtitles: root.item.transcribed;
                    choose(kind) => { root.export(kind); menu.close(); }
                }
            }
            if root.sub == 2: VerticalLayout {
                padding: Theme.menu-pad;
                padding-top: 5px + Theme.menu-top;
                Flickable {
                    height: min(root.projects.length, 8) * Theme.menu-h;
                    content-height: root.projects.length * Theme.menu-h;
                    for p[i] in root.projects: MenuRow {
                        y: i * Theme.menu-h;
                        width: parent.width;
                        num: i + 1;
                        text: p;
                        checked: i == root.project;
                        icon: Theme.dash || Theme.answer ? "folder" : "";
                        tile: true;
                        enabled: i != root.project;
                        clicked => { root.move-to(i); menu.close(); }
                    }
                }
            }
        }
    }
}

// The waveform of a clip row as a seek bar. A click on the highlighted (or playing) clip
// moves its start there, a double click plays from there; on another clip a click just
// highlights it. Ctrl or Shift picks clips, as anywhere on the row.
export component WaveSeek inherits TouchArea {
    in property <bool> selected;
    in property <bool> active;
    callback select(bool, bool);
    callback cue(float);
    callback play-at(float);
    // A right click, at this point in window coordinates.
    callback menu(length, length);
    mouse-cursor: pointer;
    property <bool> picking;
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down) { self.picking = e.modifiers.control || e.modifiers.shift; }
        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.picking && self.has-hover) {
            root.select(e.modifiers.control, e.modifiers.shift);
        }
        // A right click here opens the same menu as anywhere on the row.
        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
            root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
    // Seeking is only for the highlighted clip: on another clip a click just
    // highlights it, and the rest of a double-click there does nothing.
    property <bool> fresh;
    clicked => {
        if (!self.picking) {
            if (!root.selected && !root.active) {
                root.select(false, false);
                self.fresh = true;
            } else if (!self.fresh) {
                root.cue(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
    }
    double-clicked => {
        if (!self.fresh) {
            root.play-at(clamp(self.mouse-x / self.width, 0, 1));
        }
    }
    Timer {
        interval: 500ms;
        running: root.fresh;
        triggered => { root.fresh = false; }
    }
}

export component ClipItem inherits Rectangle {
    in property <ClipRow> item;
    // Width of the small waveform; 0 leaves it out (narrow windows).
    in property <length> wave-width: 84px;
    in property <bool> selected;
    // Part of a selection of several clips (Ctrl or Shift click).
    in property <bool> picked;
    // How many clips are picked, when this one is among them; its menu offers to merge.
    in property <int> merge-count;
    in property <bool> active;
    in property <bool> playing;
    in property <float> progress;
    callback play();
    callback cue(float);
    callback play-at(float);
    // A click highlights the clip and a double click opens it. Ctrl and Shift pick
    // several. The three-dot menu (or a right click, or the right arrow key) opens
    // it.
    callback select(bool, bool);
    callback merge();
    callback open();
    callback rename();
    callback export(int);
    callback delete();
    // The projects, for "Move to", and the one this clip is in.
    in property <[string]> projects;
    in property <int> project;
    callback move-to(int);
    // The window's height, so the menu and its submenus stay inside it.
    in property <length> window-h: 10000px;
    height: 52px;
    border-radius: 10px;
    background: root.picked ? Theme.picked : root.active || root.selected ? Theme.selected-row : row-touch.has-hover ? Theme.row-hover : transparent;
    border-width: root.selected || root.picked ? 1px : 0;
    border-color: root.picked ? Theme.accent.with-alpha(0.33) : Theme.selected-edge;
    accessible-role: list-item;
    accessible-label: root.item.name + ", " + root.item.duration;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected || root.picked;
    accessible-action-default => { root.select(false, false); }
    row-touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.has-hover) {
                root.select(e.modifiers.control, e.modifiers.shift);
            }
            // On release: the press that closes an open menu is used up by that menu,
            // so opening on the press would only work every other time.
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.menu-at(self.mouse-x, self.mouse-y);
            }
        }
        // Opens just this clip, even out of several picked.
        double-clicked => { root.select(false, false); root.open(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            IconBtn {
                size: 32px;
                round: true;
                icon-size: 11px;
                icon: root.active && root.playing ? "pause" : "play";
                label: (root.active && root.playing ? "Pause " : "Play ") + root.item.name;
                tip: root.active && root.playing ? "Pause" : "Play";
                filled: root.active;
                outlined: !root.active;
                tint: root.active ? Theme.on-accent : Theme.text;
                clicked => { root.play(); }
            }
        }
        // A click on the waveform moves the clip's start there (and jumps while it
        // plays); a double click plays from there.
        if root.wave-width > 0: Rectangle {
            width: root.wave-width;
            height: 28px;
            y: (parent.height - self.height) / 2;
            Wave {
                height: 22px;
                y: (parent.height - self.height) / 2;
                gap: 1px;
                values: root.item.wave;
                progress: root.active ? root.progress : -1;
            }
            WaveSeek {
                selected: root.selected;
                active: root.active;
                select(ctrl, shift) => { root.select(ctrl, shift); }
                cue(f) => { root.cue(f); }
                play-at(f) => { root.play-at(f); }
                menu(x, y) => { root.menu-at(x - root.absolute-position.x, y - root.absolute-position.y); }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.item.meta;
                color: root.active ? Theme.accent : Theme.dim;
                font-size: 11px;
                overflow: elide;
            }
        }
        Text {
            text: root.item.duration;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 12px;
            vertical-alignment: center;
        }
        // The three-dot menu: manage, rename, export, delete.
        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            background: dots.has-hover ? Theme.raised : transparent;
            accessible-role: button;
            accessible-label: "Menu for " + root.item.name;
            accessible-action-default => { root.open-menu(); }
            Icon {
                name: "dots";
                tint: dots.has-hover ? Theme.text : Theme.dim;
                width: 16px;
                height: 16px;
            }
            property <bool> hovering: dots.has-hover;
            changed hovering => { Tips.hover(self.hovering, "More options", self.absolute-position, self.width, self.height); }
            dots := TouchArea {
                mouse-cursor: pointer;
                clicked => { Tips.hide(); root.open-menu(); }
            }

        }
    }
    // Opens the menu where the right click was (row coordinates), or under the dots.
    function menu-at(x: length, y: length) {
        menu.show-at(x, y);
    }
    function open-menu() {
        menu.show-at(root.width - 8px - 210px, (root.height + 28px) / 2 + 4px);
    }
    menu := ClipMenu {
        width: parent.width;
        height: parent.height;
        item: root.item;
        merge-count: root.merge-count;
        projects: root.projects;
        project: root.project;
        window-h: root.window-h;
        merge => { root.merge(); }
        open => { root.open(); }
        rename => { root.rename(); }
        export(kind) => { root.export(kind); }
        delete => { root.delete(); }
        move-to(p) => { root.move-to(p); }
    }
}

// A back link at the top of a page.
export component BackLink inherits Rectangle {
    in property <string> text;
    callback clicked;
    width: row.preferred-width + 16px;
    height: 28px;
    border-radius: 6px;
    background: t.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: "Back to " + text;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        x: 8px;
        spacing: 4px;
        Icon { name: "back"; tint: Theme.muted; y: (parent.height - self.height) / 2; }
        Text {
            text: root.text;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}


// Pinball's Export key: the lit plasma start button with an up arrow and EXPORT; while
// exporting the ball runs along a rail with the percent beside it; green with DONE when done.
component PbExportArt inherits Rectangle {
    in property <int> state;
    in property <float> progress;
    in property <bool> hover;
    in property <bool> pressed;
    Rectangle {
        visible: root.state != 1;
        PbKey {
            kind: root.state == 2 ? 4 : 1;
            hover: root.hover && root.state == 0;
            pressed: root.pressed && root.state == 0;
        }
    }
    if root.state == 1: Rectangle {
        property <length> rail-w: root.width - 44px;
        Rectangle {
            x: 0;
            y: (root.height - 7px) / 2;
            width: parent.rail-w;
            height: 7px;
            border-radius: 3.5px;
            background: #050507;
            border-width: 1px;
            border-color: #5e5866;
            Rectangle { x: 4px; y: 2px; width: parent.width - 8px; height: 1px; background: #4a4550; }
        }
        Image {
            x: clamp(root.progress, 0, 1) * (parent.rail-w - 13px);
            y: (root.height - 13px) / 2;
            width: 13px;
            height: 13px;
            source: 1phx < 0.7px ? @image-url("skins/x-pinball/ball@2x.png") : @image-url("skins/x-pinball/ball.png");
            image-fit: fill;
        }
        Text {
            x: parent.rail-w + 8px;
            width: 36px;
            height: root.height;
            text: round(root.progress * 100) + "%";
            color: Pb.plasma-hi;
            font-family: Theme.mono;
            font-size: 12px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    if root.state != 1: HorizontalLayout {
        x: 0;
        y: root.pressed && root.state == 0 ? 1px : 0;
        width: root.width;
        height: root.height;
        alignment: center;
        spacing: 6px;
        Icon {
            y: (parent.height - self.height) / 2;
            name: root.state == 2 ? "check" : "export";
            tint: root.state == 2 ? #032810 : Pb.key-ink;
            stroke-width: 2.6px;
            width: 14px;
            height: 14px;
        }
        Text {
            text: root.state == 2 ? "DONE" : "EXPORT";
            color: root.state == 2 ? #032810 : Pb.key-ink;
            font-family: Pb.font;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 2px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// A small square key on an order row: the x (remove), or the three dots (the part's menu).
component PbXKey inherits Rectangle {
    in property <bool> dots;
    in property <string> label;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    border-width: root.dots ? 0 : 1.5px;
    border-color: t.has-hover && root.enabled ? #c9c3cf : Pb.edge;
    background: !root.dots && t.has-hover && root.enabled ? #221d28 : transparent;
    if !root.dots: Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: "close";
        tint: root.enabled ? #c9c3cf : Pb.mute;
        stroke-width: 2.6px;
        width: 13px;
        height: 13px;
    }
    for k in (root.dots ? 3 : 0): Rectangle {
        x: (parent.width - 3.5px) / 2;
        y: (parent.height - 15.5px) / 2 + k * 6px;
        width: 3.5px;
        height: 3.5px;
        border-radius: 1.75px;
        background: t.has-hover && root.enabled ? Pb.plasma-hi : Pb.dots;
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { if (root.tip != "") { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); } }
    t := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                Tips.hide();
                root.clicked();
            }
        }
    }
}

// Pinball's row of a merge or a merged clip's parts: a grip, the place on a numbered arrow
// insert (lit while it plays or is lifted), a play ring, the clip with its length (or the
// part's note) under it, and an x or the dots. The lifted row is framed plasma.
component PbOrderRow inherits Rectangle {
    in property <OrderRow> item;
    in property <int> place;
    in property <bool> lifted;
    in property <bool> playing;
    in property <bool> playable;
    in property <bool> removable;
    in property <bool> menu;
    in property <bool> enabled;
    callback play();
    callback remove();
    callback open-menu();
    background: root.lifted ? #1d1410 : Pb.list;
    border-width: root.lifted ? 1.5px : 0;
    border-color: Pb.plasma;
    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: #ffffff0d; }
    Icon {
        x: 8px;
        y: (parent.height - self.height) / 2;
        name: "grip";
        tint: root.lifted ? Pb.plasma-hi : #6f6880;
        width: 14px;
        height: 14px;
    }
    Insert {
        x: 29px;
        y: (parent.height - self.height) / 2;
        width: 34px;
        height: 27px;
        index: root.place - 1;
        lit: root.playing || root.lifted;
        Text {
            x: -2px;
            width: parent.width;
            height: parent.height;
            text: root.place;
            color: #1a0a04;
            font-family: Theme.mono;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    HorizontalLayout {
        x: 72px;
        width: root.width - 80px;
        height: root.height;
        spacing: 9px;
        if root.playable: VerticalLayout {
            alignment: center;
            IconBtn {
                size: 26px;
                icon: root.playing ? "pause" : "play";
                icon-size: 11px;
                active: root.playing;
                label: (root.playing ? "Pause " : "Play ") + root.item.name;
                tip: root.playing ? "Pause" : "Play";
                clicked => { root.play(); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            Text { text: root.item.name; color: Pb.name; font-family: Pb.font; font-size: 16px; font-weight: 600; overflow: elide; }
            if root.item.note != "": Text { text: root.item.note; color: Pb.mute; font-family: Theme.mono; font-size: 10.5px; overflow: elide; }
        }
        if root.removable: VerticalLayout {
            alignment: center;
            PbXKey {
                width: 24px;
                height: 24px;
                label: "Remove " + root.item.name;
                tip: "Remove";
                enabled: root.enabled;
                clicked => { root.remove(); }
            }
        }
        if root.menu: VerticalLayout {
            alignment: center;
            PbXKey {
                width: 16px;
                height: 28px;
                dots: true;
                label: "Options for " + root.item.name;
                tip: "Options";
                enabled: root.enabled;
                clicked => { root.open-menu(); }
            }
        }
    }
}

// Pinball's record hotkey: PRESS THE KEYS on a small dot matrix while it listens, NOT SET on a
// dark plate, or the keys as plasma key caps joined by plus signs; flush right.
component PbShortcutArt inherits Rectangle {
    in property <bool> listening;
    in property <[string]> keys;
    if root.listening: DotBox {
        x: root.width - self.width - 4px;
        y: (root.height - self.height) / 2;
        text: "PRESS THE KEYS";
        pitch: 1.8px;
    }
    if !root.listening && root.keys.length == 0: Rectangle {
        x: root.width - self.width;
        y: (root.height - self.height) / 2;
        width: not-set.preferred-width + 14px;
        height: 20px;
        border-width: 1px;
        border-color: Pb.edge;
        not-set := Text {
            text: "NOT SET";
            color: Pb.mute;
            font-family: Theme.mono;
            font-size: 9px;
            letter-spacing: 1.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    if !root.listening && root.keys.length > 0: HorizontalLayout {
        alignment: end;
        spacing: 4px;
        for k[i] in root.keys: HorizontalLayout {
            spacing: 4px;
            Text {
                text: i > 0 ? "+" : "";
                color: Pb.mute;
                font-family: Theme.mono;
                font-size: 11px;
                vertical-alignment: center;
                accessible-role: none;
            }
            Rectangle {
                width: max(26px, kc.preferred-width + 12px);
                height: 22px;
                y: (parent.height - self.height) / 2;
                background: @linear-gradient(180deg, #ffe0b0 0%, #ffb050 100%);
                border-width: 1px;
                border-color: #fff0d0;
                Rectangle { x: 0; y: parent.height - 3px; width: parent.width; height: 3px; background: #b05a10; }
                kc := Text {
                    y: -1px;
                    text: k;
                    color: Pb.key-ink;
                    font-family: Theme.mono;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
    }
}

// The Phonograph's Export key: red wax with EXPORT and an up arrow; while exporting the key
// darkens and fills with brighter wax up to the percent; brass with a check and DONE when done.
component PnExportArt inherits Rectangle {
    in property <int> state;
    in property <float> progress;
    in property <bool> hover;
    in property <bool> pressed;
    PnKey {
        kind: root.state == 2 ? 1 : 2;
        hover: root.hover && root.state == 0;
        pressed: root.pressed && root.state == 0;
    }
    if root.state == 1: Rectangle {
        border-radius: 5px;
        background: #4a0e07;
        Rectangle {
            x: 0;
            width: clamp(root.progress, 0, 1) * parent.width;
            border-radius: 5px;
            background: Pn.wax-face;
        }
        Text {
            text: round(root.progress * 100) + "%";
            color: Pn.wax-ink;
            font-family: Pn.caps;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 1.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    if root.state != 1: HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        alignment: center;
        spacing: 7px;
        if root.state == 2: Icon {
            y: (parent.height - self.height) / 2;
            name: "check";
            tint: Pn.engrave;
            stroke-width: 2.4px;
            width: 13px;
            height: 13px;
        }
        Text {
            text: root.state == 2 ? "DONE" : "EXPORT";
            color: root.state == 2 ? Pn.engrave : Pn.wax-ink;
            font-family: Pn.caps;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 1.7px;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.state == 0: Icon {
            y: (parent.height - self.height) / 2;
            name: "up";
            tint: Pn.wax-ink;
            stroke-width: 2.4px;
            width: 13px;
            height: 13px;
        }
    }
}

// The end of a Phonograph order row: a brass screw with an x (remove), or the three brass
// studs (the part's menu).
component PnXKey inherits Rectangle {
    in property <bool> dots;
    in property <string> label;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    if !root.dots: PnDisc {
        x: (parent.width - 20px) / 2;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        c0: t.has-hover && root.enabled ? #fff3c8 : #f6e3a1;
        c1: t.has-hover && root.enabled ? #e3c069 : #d1a84f;
        c2: #7a5717;
        edge-width: 1px;
        edge: #4a3209;
        Icon {
            name: "close";
            tint: root.enabled ? Pn.engrave : Pn.ink-soft;
            stroke-width: 2.4px;
            width: 15px;
            height: 15px;
        }
    }
    Rectangle {
        visible: root.dots && t.has-hover && root.enabled;
        border-radius: 3px;
        background: #f6d27873;
    }
    for k in (root.dots ? 3 : 0): Rectangle {
        x: (parent.width - 3.5px) / 2;
        y: (parent.height - 15.5px) / 2 + k * 6px;
        width: 3.5px;
        height: 3.5px;
        border-radius: 1.75px;
        // Solid: the software renderer fills a gradient as a square.
        background: #a07a2a;
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { if (root.tip != "") { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); } }
    t := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                Tips.hide();
                root.clicked();
            }
        }
    }
}

// The Phonograph's row of a merge or a merged clip's parts, as a cylinder tin: brass grip
// studs, the place on a brass disc, the lid that plays it (wax red while it plays), the
// label in the colours of the main page's tins with the name (a merge row's length at its
// right end, a part's note under the name), and the brass screw (remove) or the studs (the
// menu). The lifted tin is ringed in bright brass.
component PnOrderRow inherits Rectangle {
    in property <OrderRow> item;
    in property <int> place;
    in property <bool> lifted;
    in property <bool> playing;
    in property <bool> playable;
    in property <bool> removable;
    in property <bool> menu;
    in property <bool> enabled;
    callback play();
    callback remove();
    callback open-menu();
    property <length> body-x: root.playable ? 62px : 46px;
    property <length> body-h: root.height - 8px;
    property <color> label: Math.mod(root.place - 1, 3) == 0 ? #eadbb7 : Math.mod(root.place - 1, 3) == 1 ? #dfe0bf : #ead3c0;
    // The grip: two columns of three brass studs.
    for k in 6: Rectangle {
        x: 6px + Math.mod(k, 2) * 5px;
        y: (root.height - 14px) / 2 + floor(k / 2) * 5px;
        width: 3.5px;
        height: 3.5px;
        border-radius: 1.75px;
        background: root.lifted ? Pn.brass-hi : #a07a2a;
    }
    // The place on a brass disc.
    PnDisc {
        x: 20px;
        y: (root.height - 20px) / 2;
        width: 20px;
        height: 20px;
        c0: #f6e3a1;
        c1: #d1a84f;
        c2: #7a5717;
        edge-width: 1px;
        edge: #4a3209;
        Text {
            text: root.place;
            color: Pn.engrave;
            font-family: Pn.font;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    // The tin: a bright brass ring while lifted, its shadow, the dark rims and the label.
    Rectangle {
        x: root.body-x;
        y: 4px;
        width: root.width - root.body-x;
        height: root.body-h;
        Rectangle {
            visible: root.lifted;
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: 6px;
            background: #4a3209;
            Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; border-radius: 5px; background: Pn.brass-hi; }
        }
        Rectangle { visible: !root.lifted; y: 2px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; background: #00000059; }
        Rectangle { border-top-right-radius: 4px; border-bottom-right-radius: 4px; background: #1c0f08; }
        Rectangle {
            y: 3px;
            height: parent.height - 6px;
            border-top-right-radius: 1px;
            border-bottom-right-radius: 1px;
            background: root.label;
        }
        Rectangle {
            border-top-right-radius: 4px;
            border-bottom-right-radius: 4px;
            background: @linear-gradient(180deg, #00000059 0%, #00000000 26%, #ffffff2e 38%, #00000000 55%, #00000052 100%);
        }
        Rectangle { x: 8px; y: 5px; width: parent.width - 16px; height: 1px; background: #5a371473; }
        Rectangle { x: 8px; y: parent.height - 6px; width: parent.width - 16px; height: 1px; background: #5a371473; }
        HorizontalLayout {
            padding-left: root.playable ? 18px : 12px;
            padding-right: 6px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                // Garamond's line box is tall: pulled together so the note clears the ruled line.
                spacing: root.playable ? 0 : -2px;
                Text { text: root.item.name; color: Pn.ink; font-family: Pn.font; font-size: root.playable ? 16px : 15px; font-weight: 600; overflow: elide; }
                if root.item.note != "" && !root.playable: Text {
                    text: root.item.note.to-uppercase();
                    color: Pn.ink-soft;
                    font-family: Pn.caps;
                    font-size: 8px;
                    font-weight: 600;
                    letter-spacing: 0.8px;
                    overflow: elide;
                }
            }
            // A merge row: the clip's length at the right end, as the mockup's tins.
            if root.item.note != "" && root.playable: Text {
                text: root.item.note;
                color: Pn.ink;
                font-family: Pn.font;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.removable: VerticalLayout {
                alignment: center;
                PnXKey {
                    width: 24px;
                    height: 24px;
                    label: "Remove " + root.item.name;
                    tip: "Remove";
                    enabled: root.enabled;
                    clicked => { root.remove(); }
                }
            }
            if root.menu: VerticalLayout {
                alignment: center;
                PnXKey {
                    width: 16px;
                    height: 26px;
                    dots: true;
                    label: "Options for " + root.item.name;
                    tip: "Options";
                    enabled: root.enabled;
                    clicked => { root.open-menu(); }
                }
            }
        }
    }
    // The lid over the tin's left end: play, pause while it plays.
    if root.playable: Rectangle {
        x: root.body-x - 14px;
        y: (root.height - 28px) / 2;
        width: 28px;
        height: 28px;
        accessible-role: button;
        accessible-label: (root.playing ? "Pause " : "Play ") + root.item.name;
        accessible-action-default => { root.play(); }
        // A brass ring round a dark rim and the lid's face, in solid rings (the software
        // renderer fills a gradient as a square).
        PnDisc {
            x: 0;
            y: lt.pressed ? 1px : 0;
            width: 28px;
            height: 28px;
            c0: #e7c66f;
            c1: #a07326;
            c2: #4d360c;
            mid: 0.72;
            Rectangle { x: 6.5px; y: 6.5px; width: 15px; height: 15px; border-radius: 7.5px; background: root.playing ? #5e1209 : #7a5717; }
            Rectangle { x: 7.5px; y: 7.5px; width: 13px; height: 13px; border-radius: 6.5px; background: root.playing ? #d0463a : #d8b35c; }
            Rectangle { visible: lt.has-hover; border-radius: 14px; background: #fff6d826; }
            Icon {
                x: (parent.width - self.width) / 2 + (root.playing ? 0 : 1px);
                name: root.playing ? "pause" : "play";
                tint: root.playing ? Pn.wax-ink : Pn.ink;
                width: 16px;
                height: 16px;
            }
        }
        property <bool> hovering: lt.has-hover;
        changed hovering => { Tips.hover(self.hovering, root.playing ? "Pause" : "Play", self.absolute-position, self.width, self.height); }
        lt := TouchArea {
            mouse-cursor: pointer;
            clicked => { Tips.hide(); root.play(); }
        }
    }
}

// The Phonograph's record hotkey: Press the keys in italic by an amber jewel while it
// listens, Not set in italic, or the keys as small ivory key caps; flush right.
component PnShortcutArt inherits Rectangle {
    in property <bool> listening;
    in property <[string]> keys;
    if root.listening || root.keys.length == 0: HorizontalLayout {
        alignment: end;
        spacing: 8px;
        if root.listening: VerticalLayout {
            alignment: center;
            PnDisc {
                width: 9px;
                height: 9px;
                c0: #fff0c0;
                c1: #e9a52c;
                c2: #6a420a;
                mid: 0.45;
            }
        }
        Text {
            text: root.listening ? "Press the keys" : "Not set";
            color: root.listening ? Pn.plate-ink : Pn.hint;
            font-family: Pn.font;
            font-size: 14.5px;
            font-weight: 500;
            font-italic: true;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    if !root.listening && root.keys.length > 0: HorizontalLayout {
        alignment: end;
        spacing: 8px;
        for k in root.keys: Rectangle {
            width: max(30px, kc.preferred-width + 16px);
            height: 22px;
            y: (parent.height - self.height) / 2 - 1px;
            PnKey { kind: 0; }
            kc := Text {
                text: k.to-uppercase();
                color: Pn.ink;
                font-family: Pn.caps;
                font-size: 8.5px;
                font-weight: 700;
                letter-spacing: 1.3px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
}

// The Cozy Cabin's Export key: honey with EXPORT and an up arrow; while exporting a dark
// well filling with honey blocks under the percent; honey with a check and DONE when done.
component CzExportArt inherits Rectangle {
    in property <int> state;
    in property <float> progress;
    in property <bool> hover;
    in property <bool> pressed;
    Rectangle {
        visible: root.state != 1;
        CzKey {
            kind: 1;
            hover: root.hover && root.state == 0;
            pressed: root.pressed && root.state == 0;
        }
    }
    if root.state == 1: CzBar { x: 0; y: 0; width: root.width; height: root.height; progress: root.progress; }
    HorizontalLayout {
        x: 0;
        y: root.pressed && root.state == 0 ? 1px : 0;
        width: root.width;
        height: root.height;
        alignment: center;
        spacing: 8px;
        if root.state == 2: VerticalLayout {
            alignment: center;
            PkPx { s: 2; source: @image-url("skins/px-cozy/check.png"); colorize: Cz.ink; }
        }
        Rectangle {
            width: word.preferred-width + 2px;
            if root.state == 1: Text {
                x: 2px;
                y: 2px;
                height: parent.height;
                text: word.text;
                color: Cz.ink;
                font-family: Cz.title;
                font-size: 20px;
                vertical-alignment: center;
                accessible-role: none;
            }
            word := Text {
                x: 0;
                y: 0;
                height: parent.height;
                text: root.state == 1 ? round(root.progress * 100) + "%" : root.state == 2 ? "DONE" : "EXPORT";
                color: root.state == 1 ? Cz.cream : Cz.ink;
                font-family: root.state == 1 ? Cz.title : Cz.caps;
                font-size: root.state == 1 ? 20px : 12px;
                letter-spacing: root.state == 1 ? 1px : 2px;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        if root.state == 0: VerticalLayout {
            alignment: center;
            PkPx { s: 2; source: @image-url("skins/px-cozy/up.png"); colorize: Cz.ink; }
        }
    }
}

// The export button. A click opens a menu above it with every export (see
// ExportChoices for what `export` gets).
export component ExportButton inherits Rectangle {
    in property <int> format;
    in property <bool> subtitles;
    // 1 while exporting, filling with `progress`; 2 for a moment when done.
    in property <int> state;
    in property <float> progress;
    // Open the menu below the button instead of above it (a button at the top of a page).
    in property <bool> drop;
    callback export(int);
    function choose(kind: int) {
        popup.close();
        root.export(kind);
    }
    height: 36px;
    width: Theme.os95 ? os-row.preferred-width : Theme.pocket ? 96px : Theme.answer ? label.preferred-width + 58px : max(label.preferred-width + 60px, 128px);
    border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? 0 : Theme.dash ? self.height / 2 : 9px;
    clip: !Theme.tape && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.answer && !Theme.synth && !Theme.cozy && !Theme.pinball && !Theme.phono;
    background: Theme.tape || Theme.comic || Theme.pocket || Theme.quest || Theme.answer || Theme.synth || Theme.cozy || Theme.pinball || Theme.phono ? transparent : Theme.os95 ? Os.face : root.state == 1 ? Theme.raised : t.has-hover ? Theme.accent-hover : Theme.accent;
    // Answering Machine: a rubber key, held down while it exports and filling with red,
    // with an amber lamp when done.
    if Theme.answer: AmKey {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        down: root.state == 1 || (t.pressed && t.has-hover);
        hover: t.has-hover;
    }
    if Theme.answer && root.state == 1: Rectangle {
        x: 0;
        y: 2px;
        width: max(18px, parent.width * clamp(root.progress, 0, 1));
        height: parent.height;
        border-radius: 9px;
        background: #cf3c2873;
    }
    if Theme.answer && root.state == 2: Rectangle {
        x: parent.width - 11px;
        y: 5px;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: Am.amber;
    }
    // Quest Menu: the lit key with an up arrow and gold words; while exporting an ink
    // box with a grey ring filling with gold, the percent in the middle; then Done.
    if Theme.quest && root.state != 1: QFace {
        x: 0;
        y: 0;
        kind: 1;
        hover: t.has-hover;
    }
    if Theme.quest && root.state == 1: Rectangle {
        x: 0;
        y: 0;
        background: Quest.ink;
        border-width: 3px;
        border-color: Quest.grey;
        Rectangle {
            x: 3px;
            y: 3px;
            width: (parent.width - 6px) * clamp(root.progress, 0, 1);
            height: parent.height - 6px;
            background: Quest.gold;
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: q-pct.preferred-width + 8px;
            height: 15px;
            background: Quest.ink;
            q-pct := Text {
                y: 1px;
                height: parent.height - 1px;
                text: round(root.progress * 100) + "%";
                color: Quest.white;
                font-family: Quest.label;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
    if Theme.quest && root.state != 1: HorizontalLayout {
        x: 0;
        y: t.pressed && t.has-hover ? 1px : 0;
        width: parent.width;
        height: parent.height;
        alignment: center;
        spacing: 7px;
        QPx {
            y: (parent.height - self.height) / 2;
            source: root.state == 2 ? @image-url("skins/px-quest/tick.png") : @image-url("skins/px-quest/up.png");
            s: 2;
            colorize: Quest.gold;
        }
        Text {
            text: root.state == 2 ? "Done" : "Export";
            color: Quest.gold;
            font-family: Quest.font;
            font-size: 14px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    // Pocket: the dark LCD key with the up arrow; while exporting a dithered bar filling
    // dark with the percent on it; then a check and Done.
    if Theme.pocket: Rectangle {
        x: 0;
        y: t.pressed && t.has-hover ? 2px : 0;
        width: parent.width;
        height: parent.height - (t.pressed && t.has-hover ? 2px : 0);
        background: root.state == 1 ? transparent : t.has-hover ? Pk.l2 : Pk.l3;
        Rectangle { visible: root.state != 1 && !(t.pressed && t.has-hover); x: 0; y: parent.height - 2px; width: parent.width; height: 2px; background: Pk.l2; }
        PkTile { visible: root.state == 1; source: @image-url("skins/px-pocket/dith.png"); }
        Rectangle {
            visible: root.state == 1;
            x: 0;
            width: round(parent.width * clamp(root.progress, 0, 1) / 2px) * 2px;
            background: Pk.l3;
        }
        PkRing { visible: root.state == 1; }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            if root.state != 1: VerticalLayout {
                alignment: center;
                PkPx { source: root.state == 2 ? @image-url("skins/px-pocket/tick.png") : @image-url("skins/px-pocket/up.png"); colorize: Pk.l0; }
            }
            Rectangle {
                width: pk-label.preferred-width;
                Rectangle {
                    visible: root.state == 1;
                    x: -3px;
                    y: (parent.height - 16px) / 2;
                    width: parent.width + 6px;
                    height: 16px;
                    background: Pk.l0;
                }
                pk-label := Text {
                    y: -1px;
                    text: root.state == 1 ? round(root.progress * 100) + "%" : root.state == 2 ? "Done" : "Export";
                    color: root.state == 1 ? Pk.l3 : Pk.l0;
                    font-family: Pk.big;
                    font-size: 20px;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
    }
    // Desktop 95: the Start button of the taskbar, pushed in while its menu is open or an
    // export runs: the logo and Export, an hourglass and a blocky bar, or a tick and Done.
    property <bool> os-down: (t.pressed && t.has-hover) || root.state == 1;
    if Theme.os95: OsBevel { kind: root.os-down ? 1 : 0; }
    Rectangle {
        visible: Theme.os95;
        x: root.os-down ? 1px : 0;
        y: root.os-down ? 1px : 0;
        width: parent.width;
        height: parent.height;
    os-row := HorizontalLayout {
        padding-left: 5px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            OsPx {
                source: root.state == 1 ? @image-url("skins/dv-os95/hour.png") : root.state == 2 ? @image-url("skins/dv-os95/tick.png") : @image-url("skins/dv-os95/logo.png");
            }
        }
        if root.state == 1: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 14px;
                background: #ffffff;
                OsBevel { kind: 2; }
                property <int> blocks: floor(clamp(root.progress, 0, 1) * 5);
                for i in self.blocks: Rectangle {
                    x: 2px + i * 10px;
                    y: 2px;
                    width: 8px;
                    height: parent.height - 4px;
                    background: Os.navy;
                }
            }
        }
        Text {
            text: root.state == 1 ? round(root.progress * 100) + "%" : root.state == 2 ? "Done" : "Export";
            color: #000000;
            font-family: Os.font;
            font-size: root.state == 1 ? 12.5px : 14px;
            font-weight: root.state == 1 ? 400 : 700;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    }
    // Comic Book: the red ink key; while exporting a white key that fills with red
    // halftone under the percent in a caption; yellow with a check when done.
    property <bool> ink-down: Theme.comic && t.pressed && t.has-hover;
    if Theme.comic && !root.ink-down: InkShadow { off: 2px; }
    Rectangle {
        visible: Theme.comic;
        x: root.ink-down ? 2px : 0;
        y: root.ink-down ? 2px : 0;
        background: root.state == 1 ? #ffffff : root.state == 2 ? Comic.yellow : t.has-hover ? #ec4a45 : Comic.red;
        Rectangle {
            visible: root.state == 1;
            x: 2.5px;
            y: 2.5px;
            width: (parent.width - 5px) * clamp(root.progress, 0, 1);
            height: parent.height - 5px;
            background: Comic.red;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: @image-url("skins/x-comic/dots-red.png");
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
                horizontal-alignment: left;
                vertical-alignment: top;
            }
            Rectangle { x: parent.width - 2.5px; width: 2.5px; background: Comic.ink; }
        }
        Rectangle { border-width: 2.5px; border-color: Comic.ink; }
        HorizontalLayout {
            y: 1px;
            height: parent.height - 1px;
            alignment: center;
            spacing: 6px;
            if root.state == 2: Icon {
                name: "check";
                tint: Comic.ink;
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2 - 1px;
                stroke-width: 2.8px;
            }
            if root.state != 1: Text {
                text: root.state == 2 ? "DONE" : "EXPORT";
                color: root.state == 2 ? Comic.ink : #ffffff;
                font-family: "Bangers";
                font-size: 16px;
                letter-spacing: 1px;
                vertical-alignment: center;
                accessible-role: none;
            }
            if root.state == 1: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: pct.preferred-width + 10px;
                    height: 20px;
                    background: #ffffff;
                    border-width: 2px;
                    border-color: Comic.ink;
                    pct := Text {
                        y: 1px;
                        height: parent.height - 1px;
                        text: round(root.progress * 100) + "%";
                        color: Comic.ink;
                        font-family: "Bangers";
                        font-size: 14px;
                        letter-spacing: 1px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
            if root.state == 0: Icon {
                name: "up";
                tint: #ffffff;
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2 - 1px;
                stroke-width: 2.8px;
            }
        }
    }
    border-width: 0;
    border-color: root.state == 1 ? #ffffff38 : #ffffff;
    // Tape Deck: the amber key; while exporting a dark key that fills with amber.
    if Theme.tape: DeckKey {
        kind: root.state == 1 ? 3 : 1;
        pressed: t.pressed && t.has-hover;
        hover: t.has-hover;
    }
    if Theme.tape && root.state == 1: Rectangle {
        x: 0;
        y: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        height: parent.height * 0.8;
        background: Deck.amber.with-alpha(0.38);
        animate width { duration: 150ms; }
    }
    if Theme.tape: HorizontalLayout {
        y: t.pressed && t.has-hover ? 1px : 0;
        height: parent.height * 0.8;
        alignment: center;
        spacing: 7px;
        if root.state == 2: Icon {
            name: "check";
            tint: #2a1406;
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
            stroke-width: 2.5px;
        }
        Text {
            text: root.state == 1 ? round(root.progress * 100) + "%" : root.state == 2 ? "DONE" : "EXPORT";
            color: root.state == 1 ? #f4ead6 : #2a1406;
            font-family: root.state == 1 ? Theme.mono : "Oswald";
            font-size: 11px;
            font-weight: 600;
            letter-spacing: root.state == 1 ? 0.5px : 2.9px;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.state == 0: Icon {
            name: "up";
            tint: #2a1406;
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
            stroke-width: 2.5px;
        }
    }
    accessible-role: button;
    accessible-label: root.state == 1 ? "Exporting " + round(root.progress * 100) + "%" : "Export";
    accessible-expandable: true;
    accessible-action-default => { popup.show(); }
    accessible-action-expand => { popup.show(); }
    // Pocket Synth: the orange key in capitals; a dark key that fills orange under the
    // percent while exporting; orange with a check when done.
    if Theme.synth: SynKey {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        kind: root.state == 1 ? 2 : 1;
        radius: 8px;
        pressed: t.pressed && t.has-hover;
        hover: t.has-hover && root.state == 0;
    }
    if Theme.synth && root.state == 1: Rectangle {
        x: 0;
        y: 0;
        width: max(8px, root.width * clamp(root.progress, 0, 1));
        height: root.height;
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
        border-top-right-radius: root.progress > 0.97 ? 8px : 0;
        border-bottom-right-radius: root.progress > 0.97 ? 8px : 0;
        background: #ff5a1e8c;
    }
    if Theme.synth: HorizontalLayout {
        x: 0;
        y: t.pressed && t.has-hover ? 1px : 0;
        width: root.width;
        height: root.height;
        alignment: center;
        spacing: 8px;
        if root.state == 2: Icon {
            name: "check";
            tint: #ffffff;
            stroke-width: 2.4px;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.state == 1 ? round(root.progress * 100) + "%" : root.state == 2 ? "DONE" : "EXPORT";
            color: #ffffff;
            font-family: Theme.mono;
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: 1.5px;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.state == 0: Icon {
            name: "up";
            tint: #ffffff;
            stroke-width: 2.2px;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
        }
    }
    if Theme.cozy: CzExportArt {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        state: root.state;
        progress: root.progress;
        hover: t.has-hover;
        pressed: t.pressed && t.has-hover;
    }
    if Theme.pinball: PbExportArt {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        state: root.state;
        progress: root.progress;
        hover: t.has-hover;
        pressed: t.pressed && t.has-hover;
    }
    if Theme.phono: PnExportArt {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        state: root.state;
        progress: root.progress;
        hover: t.has-hover;
        pressed: t.pressed && t.has-hover;
    }
    if root.state == 1 && !Theme.tape && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.answer && !Theme.synth && !Theme.cozy && !Theme.pinball && !Theme.phono: Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        background: Theme.accent.with-alpha(0.35);
        animate width { duration: 150ms; }
    }
    HorizontalLayout {
        visible: !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.synth && !Theme.cozy && !Theme.pinball && !Theme.phono;
        alignment: root.state == 0 ? LayoutAlignment.stretch : LayoutAlignment.center;
        padding-left: 18px;
        padding-right: 14px;
        spacing: 10px;
        if root.state == 2: Icon {
            name: "check";
            tint: Theme.tape || Theme.os95 ? transparent : Theme.answer ? Am.key-ink : Theme.on-accent;
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
            stroke-width: 2.5px;
        }
        label := Text {
            text: root.state == 1 ? round(root.progress * 100) + "%" : root.state == 2 ? (Theme.answer ? "DONE" : "Done") : Theme.answer ? "EXPORT" : "Export";
            color: Theme.tape || Theme.os95 ? transparent : Theme.answer ? Am.key-ink : root.state == 1 ? Theme.text : Theme.on-accent;
            font-family: Theme.answer ? (root.state == 1 ? "Courier Prime" : "Barlow Condensed") : root.state == 1 ? Theme.mono : Theme.dash ? "Manrope" : "Inter Tight";
            font-size: Theme.answer ? (root.state == 1 ? 12px : 10px) : 13px;
            font-weight: Theme.answer ? 700 : 800;
            letter-spacing: Theme.answer && root.state != 1 ? 2px : 0;
            vertical-alignment: center;
        }
        if root.state == 0: Icon {
            name: Theme.answer ? "export" : "up";
            tint: Theme.tape || Theme.os95 ? transparent : Theme.answer ? Am.key-ink : Theme.on-accent;
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
            stroke-width: 2.5px;
        }
    }
    t := TouchArea {
        enabled: root.state == 0;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    // Opens above the button and closes on a choice or a click anywhere else.
    // The button sits on the right, so the menu lines up with its right edge.
    // Desktop 95: the Start menu, above the button and level with its left edge, with the
    // blue band and its upright words on the left.
    popup := PopupWindow {
        x: Theme.os95 ? 0 : root.width - self.width;
        y: root.drop ? root.height + 6px : -self.height - (Theme.os95 ? 2px : 6px);
        width: Theme.os95 ? 276px : 250px;
        height: 2 * Theme.menu-pad + ExportSize.audio + (root.subtitles ? ExportSize.transcript : 0);
        close-policy: close-on-click-outside;
        MenuCard {
            if Theme.os95: Rectangle {
                x: 3px;
                y: 3px;
                width: 24px;
                height: parent.height - 6px;
                background: @linear-gradient(0deg, #0a1f7a 0%, #2f8fd6 100%);
                clip: true;
                Image {
                    x: 0;
                    y: parent.height - self.height;
                    width: 24px;
                    height: 160px;
                    source: 1phx < 0.7px ? @image-url("skins/dv-os95/ban@2x.png") : @image-url("skins/dv-os95/ban.png");
                    image-fit: fill;
                }
            }
            VerticalLayout {
                padding: Theme.menu-pad;
                padding-left: Theme.os95 ? 29px : Theme.menu-pad;
                ExportChoices {
                    subtitles: root.subtitles;
                    format: root.format;
                    choose(kind) => { root.choose(kind); }
                }
            }
        }
    }
}

// An invisible strip along a window edge or corner that resizes the window.
export component ResizeEdge inherits TouchArea {
    in property <int> direction;
    callback resize(int);
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
            root.resize(root.direction);
        }
    }
}

// A window button in the title bar. The close button turns red on hover, like Windows.
export component WinBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger;
    callback clicked;
    width: 44px;
    height: 32px;
    background: t.has-hover ? (danger ? #c42b1c : Theme.raised) : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    Icon {
        name: root.icon;
        tint: t.has-hover ? (root.danger ? #ffffff : Theme.text) : Theme.dim;
        width: 12px;
        height: 12px;
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.label, self.absolute-position, self.width, self.height); }
    t := TouchArea { clicked => { Tips.hide(); root.clicked(); } }
}

// The window's own title bar: drag it to move the window. Whatever is put inside goes
// on the left; minimise and close are always on the right.
export component TitleBar inherits Rectangle {
    in property <length> left-padding: 8px;
    // Pushes the content to the left; off when the content stretches itself.
    in property <bool> fill: true;
    callback minimize();
    callback close();
    height: 32px;
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    HorizontalLayout {
        padding-left: root.left-padding;
        spacing: 2px;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            @children
            if root.fill: Rectangle { horizontal-stretch: 1; }
        }
        WinBtn { icon: "minimize"; label: "Minimize"; clicked => { root.minimize(); } }
        WinBtn { icon: "close"; label: "Close"; danger: true; clicked => { root.close(); } }
    }
}

// A round back button and a large page title.
// A list whose rows can be dragged into another order, or moved with their arrows.
// `moved(from, to)` reports a move; `act(i)` the row's text button, if `action` names one,
// or Remove in the row's menu.
// A Cozy Cabin key in an order row: a dark slot with a honey glyph (ember while it is on),
// or a bare glyph (`bare`) that lightens under the pointer. Named and tipped like IconBtn.
component CzSlotKey inherits Rectangle {
    in property <image> icon;
    in property <float> s: 2;
    in property <bool> lit;
    in property <bool> bare;
    in property <string> label;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    background: root.bare ? (t.has-hover && root.enabled ? #00000033 : transparent) : root.lit ? Cz.ember : Cz.slot;
    if !root.bare: CzBevel {
        x: 0;
        y: 0;
        hi: root.lit ? Cz.ember-l : #170c05;
        lo: root.lit ? Cz.ember-d : #4f301b;
    }
    PkPx {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        s: root.s;
        source: root.icon;
        colorize: root.lit ? Cz.cream : root.bare ? (t.has-hover && root.enabled ? Cz.cream : Cz.dim) : t.has-hover ? Cz.honey-l : Cz.honey;
        opacity: root.enabled ? 1 : 0.4;
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { if (root.tip != "") { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); } }
    t := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                Tips.hide();
                root.clicked();
            }
        }
    }
}

// The Cozy Cabin's row of a merge or a merged clip's parts: an inventory slot with a grip,
// the place on a honey tile, a play slot, the clip and its length (or the part's note under
// it) and a small x or the dots. The lifted row is parchment ringed honey.
component CzOrderRow inherits Rectangle {
    in property <OrderRow> item;
    in property <int> place;
    in property <bool> lifted;
    in property <bool> playing;
    in property <bool> playable;
    in property <bool> removable;
    in property <bool> menu;
    in property <bool> enabled;
    callback play();
    callback remove();
    callback open-menu();
    // The honey ring of the lifted row, outside the slot.
    Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; background: root.lifted ? Cz.honey : transparent; }
    Rectangle {
        background: root.lifted ? Cz.parch : Cz.slot-hl;
        CzBevel { x: 0; y: 0; hi: root.lifted ? Cz.parch-hl : #23130a; lo: root.lifted ? Cz.parch-d : #63402a; }
    }
    PkPx { x: 9px; y: (root.height - self.height) / 2; s: 3; source: @image-url("skins/px-cozy/grip.png"); colorize: root.lifted ? Cz.parch-dd : #8c6b4a; }
    Rectangle {
        x: 27px;
        y: (root.height - 24px) / 2;
        width: 24px;
        height: 24px;
        background: Cz.honey;
        CzBevel { x: 0; y: 0; hi: Cz.honey-l; lo: Cz.honey-d; }
        Text {
            text: root.place;
            color: Cz.ink;
            font-family: Cz.title;
            font-size: 19px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    HorizontalLayout {
        x: 60px;
        width: root.width - 66px;
        height: root.height;
        spacing: 9px;
        if root.playable: VerticalLayout {
            alignment: center;
            CzSlotKey {
                width: 33px;
                height: 33px;
                lit: root.playing;
                icon: root.playing ? @image-url("skins/px-cozy/tpause.png") : @image-url("skins/px-cozy/tplay.png");
                label: (root.playing ? "Pause " : "Play ") + root.item.name;
                tip: root.playing ? "Pause" : "Play";
                clicked => { root.play(); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.item.name; color: root.lifted ? Cz.ink : Cz.cream; font-family: Cz.font; font-size: 14px; font-weight: 500; overflow: elide; }
            if root.item.note != "" && !root.removable: Text { text: root.item.note; color: root.lifted ? Cz.brown : Cz.dim; font-family: Cz.font; font-size: 12px; overflow: elide; }
        }
        if root.item.note != "" && root.removable: Text {
            text: root.item.note;
            color: root.lifted ? Cz.ink : Cz.parch;
            font-family: Cz.title;
            font-size: 21px;
            vertical-alignment: center;
        }
        if root.removable: VerticalLayout {
            alignment: center;
            CzSlotKey {
                width: 24px;
                height: 24px;
                bare: true;
                icon: @image-url("skins/px-cozy/x5.png");
                label: "Remove " + root.item.name;
                tip: "Remove";
                enabled: root.enabled;
                clicked => { root.remove(); }
            }
        }
        if root.menu: VerticalLayout {
            alignment: center;
            CzSlotKey {
                width: 18px;
                height: 27px;
                bare: true;
                s: 3;
                icon: @image-url("skins/px-cozy/dots.png");
                label: "Options for " + root.item.name;
                tip: "Options";
                enabled: root.enabled;
                clicked => { root.open-menu(); }
            }
        }
    }
}


export component OrderList inherits Rectangle {
    in property <[OrderRow]> rows;
    // A text button on each row; empty for none.
    in property <string> action;
    // A three dot menu on each row instead, with Rename (`rename(i)`) and Remove (`act(i)`).
    in property <bool> menu;
    callback rename(int);
    property <int> menu-row: -1;
    // An x on each row instead, that takes the row out of the list.
    in property <bool> removable;
    // A play button on each row; the row named `playing-name` shows pause.
    in property <bool> playable;
    in property <string> playing-name;
    in property <bool> enabled: true;
    callback moved(int, int);
    callback act(int);
    callback play(int);
    property <length> row-h: Theme.tape ? 48px : Theme.quest ? 36px : Theme.os95 ? 34px : Theme.comic ? 44px : Theme.pocket ? (root.menu ? 38px : 34px) : Theme.brick ? 32px : Theme.answer ? 40px : Theme.synth ? 54px : Theme.cozy ? 51px : Theme.phono ? 48px : Theme.pinball ? 51px : 50px;
    property <bool> hi: 1phx < 0.7px;
    property <int> dragging: -1;
    property <length> drag-dy;
    property <int> target: root.dragging < 0 ? -1 : clamp(round((root.dragging * root.row-h + root.drag-dy) / root.row-h), 0, root.rows.length - 1);
    height: root.rows.length * root.row-h;
    // One touch area for the whole list, under the rows: the drag is measured
    // against the list, which stays put, not against a row that moves. The row's
    // buttons sit on top and take their own clicks.
    TouchArea {
        enabled: root.enabled && root.rows.length > 1;
        mouse-cursor: root.dragging >= 0 ? grabbing : grab;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.drag-dy = 0;
                root.dragging = clamp(floor(self.mouse-y / root.row-h), 0, root.rows.length - 1);
            }
            if (e.kind == PointerEventKind.up && root.dragging >= 0) {
                let from = root.dragging;
                let to = root.target;
                root.dragging = -1;
                root.drag-dy = 0;
                if (to != from) { root.moved(from, to); }
            }
        }
        moved => {
            if (self.pressed && root.dragging >= 0) {
                root.drag-dy = clamp(self.mouse-y - self.pressed-y, -root.dragging * root.row-h, (root.rows.length - 1 - root.dragging) * root.row-h);
            }
        }
    }
    // Pocket: a mid green frame where the dragged row will land.
    if Theme.pocket && root.dragging >= 0: PkRing {
        x: 0;
        y: root.target * root.row-h;
        width: root.width;
        height: root.row-h;
        ink: Pk.l1;
    }
    // Brick Phone: an ink frame where the dragged row will land.
    Rectangle {
        visible: Theme.brick && root.dragging >= 0;
        x: 0;
        y: root.target * root.row-h + 2px;
        width: root.width;
        height: root.row-h - 4px;
        border-width: 1px;
        border-color: Brick.ink;
    }
    // Answering Machine: a red insert line where the dragged row will land.
    Rectangle {
        visible: Theme.answer && root.dragging >= 0;
        x: 8px;
        y: (root.target > root.dragging ? root.target + 1 : root.target) * root.row-h - 1.5px;
        width: parent.width - 16px;
        height: 3px;
        border-radius: 1.5px;
        background: Am.rec;
        z: 2;
    }
    // Cozy Cabin: an empty slot ringed in brown where the dragged row will land.
    // Pinball: a dashed slot where the dragged row will land.
    Rectangle {
        visible: Theme.pinball && root.dragging >= 0;
        x: 0;
        y: root.target * root.row-h;
        width: root.width;
        height: root.row-h - 1px;
        background: #141118;
        border-width: 1.5px;
        border-color: #5a2a0a;
    }
    // Phonograph: an empty slot on the shelf where the dragged tin will land.
    Rectangle {
        visible: Theme.phono && root.dragging >= 0;
        x: 46px;
        y: root.target * root.row-h + 5px;
        width: root.width - 46px;
        height: root.row-h - 10px;
        border-radius: 4px;
        background: #00000040;
        border-width: 1px;
        border-color: #d1a84f59;
    }
    Rectangle {
        visible: Theme.cozy && root.dragging >= 0;
        x: 0;
        y: root.target * root.row-h + 3px;
        width: root.width;
        height: root.row-h - 6px;
        border-width: 3px;
        border-color: #6b4a2e;
    }
    // Pocket Synth: a dashed orange slot where the dragged row will land.
    Rectangle {
        visible: Theme.synth && root.dragging >= 0;
        x: 0;
        y: root.target * root.row-h;
        width: root.width;
        height: root.row-h - 8px;
        border-radius: 9px;
        border-width: 1.5px;
        border-color: #e94a1299;
    }
    for r[i] in root.rows: Rectangle {
        // The dragged row follows the mouse, raised, buttons and all; the others make
        // room where it would land.
        y: i * root.row-h + (i == root.dragging ? root.drag-dy
            : root.dragging >= 0 && i > root.dragging && i <= root.target ? -root.row-h
            : root.dragging >= 0 && i < root.dragging && i >= root.target ? root.row-h
            : 0);
        // The others slide, only while dragging; the dragged row never lags, and after
        // the drop every row takes its new place at once.
        animate y { duration: root.dragging >= 0 && i != root.dragging ? 150ms : 0ms; easing: ease-out; }
        height: root.row-h;
        z: i == root.dragging ? 1 : 0;
        border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest ? 0 : Theme.answer ? 4px : 10px;
        // Answering Machine: the dragged row lifts off the paper.
        background: i == root.dragging && !Theme.tape && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.brick && !Theme.synth && !Theme.cozy && !Theme.pinball && !Theme.phono ? (Theme.answer ? #f9f1e3 : Theme.raised) : transparent;
        border-width: i == root.dragging && !Theme.tape && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.brick && !Theme.synth && !Theme.cozy && !Theme.pinball && !Theme.phono ? 1px : 0;
        border-color: Theme.edge;
        drop-shadow-blur: i == root.dragging && !Theme.tape && !Theme.os95 && !Theme.comic && !Theme.pocket && !Theme.quest && !Theme.brick && !Theme.synth && !Theme.cozy && !Theme.pinball && !Theme.phono ? 16px : 0;
        drop-shadow-offset-y: i == root.dragging && !Theme.tape && !Theme.comic && !Theme.pocket && !Theme.brick ? 6px : 0;
        // Brick Phone: a grip, the place inverted, a play glyph, the clip and its length and
        // an x (or the dots of the parts' menu); the dragged one lifts inverted.
        if Theme.brick: brr := Rectangle {
            property <bool> lifted: i == root.dragging;
            property <bool> playing: r.name == root.playing-name;
            property <color> fg: self.lifted ? Brick.lcd1 : Brick.ink;
            property <bool> short: r.note.character-count <= 8;
            Rectangle {
                visible: brr.lifted;
                x: 8px;
                y: -6px;
                background: Brick.ink;
                border-width: 2px;
                border-color: Brick.lcd1;
            }
            Image {
                visible: !brr.lifted;
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                source: @image-url("skins/dv-brick/t-dot.png");
                colorize: Brick.rule;
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
                horizontal-alignment: left;
                vertical-alignment: top;
                image-rendering: pixelated;
            }
            HorizontalLayout {
                x: brr.lifted ? 8px : 0;
                y: brr.lifted ? -6px : 0;
                width: parent.width - (brr.lifted ? 8px : 0);
                height: parent.height;
                padding-left: 4px;
                padding-right: 2px;
                spacing: 7px;
                VerticalLayout { alignment: center; BrickPx { source: @image-url("skins/dv-brick/x-grip.png"); tint: brr.fg; } }
                VerticalLayout {
                    alignment: center;
                    BrickNum {
                        lit: brr.lifted;
                        text: (i == root.dragging ? root.target : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1 : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1 : i) + 1;
                    }
                }
                if root.playable: Rectangle {
                    width: 14px;
                    accessible-role: button;
                    accessible-label: (brr.playing ? "Pause " : "Play ") + r.name;
                    accessible-action-default => { root.play(i); }
                    Rectangle { visible: bpt.has-hover; y: (parent.height - 14px) / 2; height: 14px; background: Brick.ghost; }
                    BrickPx {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 + (bpt.pressed ? 1px : 0);
                        source: brr.playing ? @image-url("skins/dv-brick/x-pause.png") : @image-url("skins/dv-brick/x-play.png");
                        s: 1;
                        tint: brr.fg;
                    }
                    property <bool> hovering: bpt.has-hover;
                    changed hovering => { Tips.hover(self.hovering, brr.playing ? "Pause" : "Play", self.absolute-position, self.width, self.height); }
                    bpt := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Tips.hide(); root.play(i); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 1px;
                    Text {
                        text: r.name;
                        color: brr.fg;
                        font-family: Brick.words;
                        font-size: 18px;
                        height: 16px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if r.note != "" && !brr.short: Text {
                        text: r.note.to-uppercase();
                        color: brr.fg;
                        opacity: 0.78;
                        font-family: Brick.caps;
                        font-size: 7px;
                        overflow: elide;
                    }
                }
                if brr.short && r.note != "": Text {
                    text: r.note;
                    color: brr.fg;
                    font-family: Brick.words;
                    font-size: 18px;
                    vertical-alignment: center;
                }
                if root.removable || root.menu: Rectangle {
                    width: 14px;
                    opacity: root.enabled ? 1 : 0.38;
                    accessible-role: button;
                    accessible-label: root.menu ? "Options for " + r.name : "Remove " + r.name;
                    accessible-action-default => { if (root.enabled) { bet.act(); } }
                    Rectangle {
                        visible: bet.has-hover && root.enabled;
                        y: (parent.height - 16px) / 2;
                        height: 16px;
                        background: root.menu ? Brick.lcd1 : Brick.ghost;
                        border-width: root.menu ? 1px : 0;
                        border-color: Brick.ink;
                    }
                    BrickPx {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: root.menu ? @image-url("skins/dv-brick/x-dots.png") : @image-url("skins/dv-brick/x-x.png");
                        tint: bet.has-hover && root.menu ? Brick.ink : brr.fg;
                    }
                    property <bool> hovering: bet.has-hover;
                    changed hovering => { Tips.hover(self.hovering, root.menu ? "Options" : "Remove", self.absolute-position, self.width, self.height); }
                    bet := TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: pointer;
                        function act() {
                            Tips.hide();
                            if (root.menu) { root.menu-row = i; row-menu.show(); } else { root.act(i); }
                        }
                        clicked => { self.act(); }
                    }
                }
                if root.action != "": VerticalLayout {
                    alignment: center;
                    Btn {
                        text: root.action;
                        height: 20px;
                        enabled: root.enabled;
                        accessible-label: root.action + " " + r.name;
                        clicked => { root.act(i); }
                    }
                }
            }
        }
        drop-shadow-color: #00000099;
        // Tape Deck: a tape spine with a grip, its place in amber and a play knob.
        if Theme.tape: tr := Rectangle {
            property <bool> lifted: i == root.dragging;
            property <bool> playing: r.name == root.playing-name;
            property <length> spine-x: root.playable ? 76px : 40px;
            Icon {
                x: 4px;
                y: (parent.height - self.height) / 2;
                name: "grip";
                tint: #8a7258;
                width: 14px;
                height: 18px;
            }
            Text {
                x: 20px;
                width: 16px;
                height: parent.height;
                text: (i == root.dragging ? root.target : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1 : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1 : i) + 1;
                color: Deck.amber;
                font-family: Theme.mono;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.playable: Rectangle {
                x: 42px;
                y: (parent.height - self.height) / 2;
                width: 28px;
                height: 28px;
                accessible-role: button;
                accessible-label: (tr.playing ? "Pause " : "Play ") + r.name;
                accessible-action-default => { root.play(i); }
                Image {
                    x: -2px;
                    y: -1px;
                    width: 32px;
                    height: 32px;
                    source: tr.playing ? (root.hi ? @image-url("skins/tape/knob-sel@2x.png") : @image-url("skins/tape/knob-sel.png"))
                        : (root.hi ? @image-url("skins/tape/knob@2x.png") : @image-url("skins/tape/knob.png"));
                    image-fit: fill;
                }
                Rectangle { visible: kt.has-hover; border-radius: 14px; background: #ffffff1f; }
                Icon {
                    x: (parent.width - self.width) / 2 + (tr.playing ? 0 : 1px);
                    name: tr.playing ? "pause" : "play";
                    tint: tr.playing ? #2a1406 : Deck.ink;
                    width: 10px;
                    height: 10px;
                }
                property <bool> hovering: kt.has-hover;
                changed hovering => { Tips.hover(self.hovering, tr.playing ? "Pause" : "Play", self.absolute-position, self.width, self.height); }
                kt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Tips.hide(); root.play(i); }
                }
            }
            Rectangle {
                x: parent.spine-x + (parent.lifted ? 8px : 0);
                y: 5px;
                width: parent.width - parent.spine-x;
                height: 38px;
                Rectangle { visible: tr.lifted; x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px; background: Deck.amber; }
                Rectangle { visible: tr.lifted; y: parent.height + 2px; height: 4px; background: #00000059; }
                Rectangle { y: 1px; background: #00000099; }
                Rectangle { border-radius: 3px; background: tr.lifted ? Deck.spine-out : Deck.spine; }
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.hi ? @image-url("skins/tape/spine@2x.png") : @image-url("skins/tape/spine.png");
                    horizontal-tiling: repeat;
                    vertical-tiling: repeat;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                }
                Rectangle { x: 0; width: 15.4px; border-top-left-radius: 3px; border-bottom-left-radius: 3px; background: Deck.bands[Math.mod(i, 5)]; }
                Rectangle { x: 15.4px; width: 1px; background: #00000026; }
                VerticalLayout {
                    x: 30px;
                    width: parent.width - 30px - 32px;
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: r.name;
                        color: Deck.hand;
                        font-family: "Caveat";
                        font-size: 20px;
                        font-weight: 700;
                        height: 20px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if r.note != "": Text { text: r.note; color: Deck.ink-soft; font-family: Theme.mono; font-size: 10px; overflow: elide; }
                }
                if root.removable || root.menu: Rectangle {
                    x: parent.width - 30px;
                    y: (parent.height - self.height) / 2;
                    width: 26px;
                    height: 26px;
                    border-radius: 3px;
                    background: et.has-hover && root.enabled ? #0000001a : transparent;
                    opacity: root.enabled ? 1 : 0.4;
                    accessible-role: button;
                    accessible-label: root.menu ? "Options for " + r.name : "Remove " + r.name;
                    accessible-action-default => { if (root.enabled) { et.act(); } }
                    Icon {
                        name: root.menu ? "dots" : "close";
                        tint: et.has-hover ? Deck.ink : Deck.ink-soft;
                        width: root.menu ? 14px : 11px;
                        height: root.menu ? 14px : 11px;
                    }
                    property <bool> hovering: et.has-hover;
                    changed hovering => { Tips.hover(self.hovering, root.menu ? "Options" : "Remove", self.absolute-position, self.width, self.height); }
                    et := TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: pointer;
                        function act() {
                            Tips.hide();
                            if (root.menu) { root.menu-row = i; row-menu.show(); } else { root.act(i); }
                        }
                        clicked => { self.act(); }
                    }
                }
            }
        }
        if Theme.os95: os-row := Rectangle {
            property <bool> lifted: i == root.dragging;
            property <bool> playing: r.name == root.playing-name;
            property <int> place: (i == root.dragging ? root.target : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1 : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1 : i) + 1;
            // Lifted: a raised button with a dotted line, a little right and up.
            if os-row.lifted: Rectangle {
                x: 10px;
                y: -6px;
                background: Os.face;
                OsBevel { kind: 0; }
                OsDotted { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px; }
            }
            HorizontalLayout {
                x: os-row.lifted ? 10px : 0;
                y: os-row.lifted ? -6px : 0;
                padding-left: 4px;
                padding-right: 6px;
                spacing: 6px;
                VerticalLayout { alignment: center; OsPx { source: @image-url("skins/dv-os95/grip.png"); } }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        background: Os.navy;
                        Text { text: os-row.place; color: #ffffff; font-family: Os.font; font-size: 11.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                if root.playable: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        size: 21px;
                        icon: os-row.playing ? "pause" : "play";
                        active: os-row.playing;
                        label: (os-row.playing ? "Pause " : "Play ") + r.name;
                        tip: os-row.playing ? "Pause" : "Play";
                        clicked => { root.play(i); }
                    }
                }
                VerticalLayout { alignment: center; OsPx { source: @image-url("skins/dv-os95/wave.png"); } }
                Text { text: r.name; color: #000000; font-family: Os.font; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                if r.note != "": Text { text: r.note; color: Os.ink2; font-family: Os.font; font-size: 12.5px; vertical-alignment: center; horizontal-stretch: 0; }
                if root.removable: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        size: 18px;
                        icon: "close";
                        label: "Remove " + r.name;
                        tip: "Remove";
                        enabled: root.enabled;
                        clicked => { root.act(i); }
                    }
                }
                if root.menu: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        width: 14px;
                        height: 18px;
                        icon: "dots";
                        label: "Options for " + r.name;
                        tip: "Options";
                        enabled: root.enabled;
                        clicked => {
                            root.menu-row = i;
                            row-menu.show();
                        }
                    }
                }
            }
        }
        // Comic Book: a grip, the place in a red ink circle, a play button and the clip as
        // a speech bubble back to it; the dragged one lifts pale yellow on its shadow.
        if Theme.comic: cr := Rectangle {
            property <bool> lifted: i == root.dragging;
            property <bool> playing: r.name == root.playing-name;
            property <length> bubble-x: root.playable ? 92px : 60px;
            // A short note (the length) sits on the right in Bangers, a long one under the name.
            property <bool> short: r.note != "" && r.note.character-count <= 8;
            Icon {
                x: 2px;
                y: (parent.height - self.height) / 2;
                name: "grip";
                tint: Comic.ink;
                width: 14px;
                height: 20px;
            }
            Rectangle {
                x: 22px;
                y: (parent.height - self.height) / 2;
                width: 25px;
                height: 25px;
                border-radius: 12.5px;
                background: Comic.red;
                border-width: 2.5px;
                border-color: Comic.ink;
                Text {
                    y: 1px;
                    height: parent.height - 1px;
                    width: parent.width;
                    text: (i == root.dragging ? root.target : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1 : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1 : i) + 1;
                    color: #ffffff;
                    font-family: "Bangers";
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.playable: Rectangle {
                x: 55px;
                y: (parent.height - self.height) / 2;
                width: 27px;
                height: 27px;
                accessible-role: button;
                accessible-label: (cr.playing ? "Pause " : "Play ") + r.name;
                accessible-action-default => { root.play(i); }
                Rectangle {
                    y: cpt.pressed && cpt.has-hover ? 1px : 0;
                    border-radius: parent.width / 2;
                    background: cr.playing ? Comic.red : cpt.has-hover ? Comic.pale : #ffffff;
                    border-width: 2.5px;
                    border-color: Comic.ink;
                    Icon {
                        x: (parent.width - self.width) / 2 + (cr.playing ? 0 : 1px);
                        name: cr.playing ? "pause" : "play";
                        tint: cr.playing ? #ffffff : Comic.ink;
                        width: 15px;
                        height: 15px;
                    }
                }
                property <bool> hovering: cpt.has-hover;
                changed hovering => { Tips.hover(self.hovering, cr.playing ? "Pause" : "Play", self.absolute-position, self.width, self.height); }
                cpt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Tips.hide(); root.play(i); }
                }
            }
            cb := Rectangle {
                x: parent.bubble-x + (cr.lifted ? 10px : 0);
                y: (parent.height - self.height) / 2 - (cr.lifted ? 4px : 0);
                width: parent.width - parent.bubble-x - 6px;
                height: 36px;
                if cr.lifted: InkShadow { off: 4px; radius: parent.height / 2; }
                Rectangle {
                    border-radius: parent.height / 2;
                    background: cr.lifted ? #fff7d6 : #ffffff;
                    border-width: cr.lifted ? 2.6px : 2.2px;
                    border-color: Comic.ink;
                }
                // The tail, back towards the play button.
                Path {
                    x: -9px;
                    y: 0;
                    width: 13px;
                    height: parent.height;
                    viewbox-width: 13;
                    viewbox-height: parent.height / 1px;
                    fill: cr.lifted ? #fff7d6 : #ffffff;
                    stroke: Comic.ink;
                    stroke-width: 2.2px;
                    stroke-line-join: round;
                    commands: "M 11.5 " + (cb.height / 2px - 4) + " L 1.5 " + (cb.height / 2px + 6) + " L 11.5 " + (cb.height / 2px + 2.5);
                }
                HorizontalLayout {
                    padding-left: 13px;
                    padding-right: 4px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: r.name;
                            color: Comic.ink;
                            font-family: "Comic Neue";
                            font-weight: 700;
                            font-size: 13.5px;
                            overflow: elide;
                        }
                        if r.note != "" && !cr.short: Text { text: r.note; color: Comic.sub; font-family: "Comic Neue"; font-weight: 700; font-size: 10.5px; overflow: elide; }
                    }
                    if cr.short: Text {
                        text: r.note;
                        color: Comic.ink;
                        font-family: "Bangers";
                        font-size: 15px;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                    if root.removable || root.menu: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 3px;
                            background: cet.has-hover && root.enabled ? (root.menu ? Comic.yellow : #0000000f) : transparent;
                            border-width: cet.has-hover && root.enabled && root.menu ? 2px : 0;
                            border-color: Comic.ink;
                            opacity: root.enabled ? 1 : 0.4;
                            accessible-role: button;
                            accessible-label: root.menu ? "Options for " + r.name : "Remove " + r.name;
                            accessible-action-default => { if (root.enabled) { cet.act(); } }
                            Icon {
                                name: root.menu ? "dots" : "close";
                                tint: Comic.ink;
                                stroke-width: 2.6px;
                                width: root.menu ? 15px : 12px;
                                height: root.menu ? 15px : 12px;
                            }
                            property <bool> hovering: cet.has-hover;
                            changed hovering => { Tips.hover(self.hovering, root.menu ? "Options" : "Remove", self.absolute-position, self.width, self.height); }
                            cet := TouchArea {
                                enabled: root.enabled;
                                mouse-cursor: pointer;
                                function act() {
                                    Tips.hide();
                                    if (root.menu) { root.menu-row = i; row-menu.show(); } else { root.act(i); }
                                }
                                clicked => { self.act(); }
                            }
                        }
                    }
                }
            }
        }
        // Quest Menu: a party slot: a grip, the place in gold in a slot, a pixel play key, a
        // small waveform, the name, its length or note and an x. The lifted row is lit and
        // ringed in gold.
        Rectangle {
            visible: Theme.quest && i == root.dragging;
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            background: Quest.gold;
            Rectangle { x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; background: Quest.sel; }
            Rectangle { x: 3px; y: 3px; width: parent.width - 6px; height: 3px; background: Quest.sel-hi; }
            Rectangle { x: 3px; y: parent.height - 6px; width: parent.width - 6px; height: 3px; background: Quest.sel-lo; }
        }
        if Theme.quest: HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 8px;
            QPx {
                y: (parent.height - self.height) / 2;
                source: @image-url("skins/px-quest/grip.png");
                colorize: Quest.grey;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 27px;
                    height: 27px;
                    background: Quest.ink;
                    border-width: 3px;
                    border-color: Quest.gold-lo;
                    Text {
                        y: 1px;
                        height: parent.height - 1px;
                        text: (i == root.dragging ? root.target
                            : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1
                            : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1
                            : i) + 1;
                        color: Quest.gold;
                        font-family: Quest.label;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            if root.playable: VerticalLayout {
                alignment: center;
                IconBtn {
                    size: 27px;
                    active: r.name == root.playing-name;
                    icon: r.name == root.playing-name ? "pause" : "play";
                    label: (r.name == root.playing-name ? "Pause " : "Play ") + r.name;
                    tip: r.name == root.playing-name ? "Pause" : "Play";
                    clicked => { root.play(i); }
                }
            }
            if root.playable: Rectangle {
                width: 51px;
                for k in 9: Rectangle {
                    x: k * 6px;
                    width: 3px;
                    height: 3px + Math.mod(k * 7 + i * 5 + 3, 6) * 3px;
                    y: round((parent.height - self.height) / 2 / 3px) * 3px;
                    background: Quest.dim;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 1px;
                Text { text: r.name; color: Quest.white; font-family: Quest.font; font-size: 14px; font-weight: 500; overflow: elide; }
                if r.note != "" && !root.playable: Text { text: r.note; color: Quest.grey; font-family: Quest.font; font-size: 11px; overflow: elide; }
            }
            if r.note != "" && root.playable: Text {
                text: r.note;
                color: Quest.white;
                font-family: Quest.label;
                font-size: 11px;
                vertical-alignment: center;
            }
            if root.removable: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 21px;
                    height: 21px;
                    background: xt.has-hover && root.enabled ? Quest.sel : transparent;
                    opacity: root.enabled ? 1 : 0.45;
                    accessible-role: button;
                    accessible-label: "Remove " + r.name;
                    accessible-action-default => { if (root.enabled) { root.act(i); } }
                    QPx {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("skins/px-quest/x.png");
                        colorize: xt.has-hover && root.enabled ? Quest.white : Quest.grey;
                    }
                    property <bool> hovering: xt.has-hover;
                    changed hovering => { Tips.hover(self.hovering, "Remove", self.absolute-position, self.width, self.height); }
                    xt := TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: pointer;
                        clicked => { Tips.hide(); root.act(i); }
                    }
                }
            }
            if root.menu: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 15px;
                    height: 21px;
                    background: dt.has-hover && root.enabled ? Quest.sel : transparent;
                    opacity: root.enabled ? 1 : 0.45;
                    accessible-role: button;
                    accessible-label: "Options for " + r.name;
                    accessible-action-default => { if (root.enabled) { root.menu-row = i; row-menu.show(); } }
                    QPx {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("skins/px-quest/dots.png");
                        colorize: dt.has-hover && root.enabled ? Quest.white : Quest.grey;
                    }
                    property <bool> hovering: dt.has-hover;
                    changed hovering => { Tips.hover(self.hovering, "Options", self.absolute-position, self.width, self.height); }
                    dt := TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: pointer;
                        clicked => { Tips.hide(); root.menu-row = i; row-menu.show(); }
                    }
                }
            }
            if root.action != "": VerticalLayout {
                alignment: center;
                Btn {
                    text: root.action;
                    height: 24px;
                    enabled: root.enabled;
                    accessible-label: root.action + " " + r.name;
                    clicked => { root.act(i); }
                }
            }
        }
        // Car Dashboard: a stop on a route, numbered in an ice ring on the route line,
        // with a cover tile.
        if Theme.dash: HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 9px;
            Icon {
                name: "grip";
                tint: #56606c;
                width: 13px;
                height: 13px;
                y: (parent.height - self.height) / 2;
            }
            Rectangle {
                width: 22px;
                Rectangle {
                    visible: root.rows.length > 1 && root.dragging < 0;
                    x: 10px;
                    y: i == 0 ? parent.height / 2 : 0;
                    width: 2px;
                    height: i == 0 || i == root.rows.length - 1 ? parent.height / 2 : parent.height;
                    background: #62d2ff59;
                }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 22px;
                    border-radius: 11px;
                    background: #0e1115;
                    border-width: 1.5px;
                    border-color: Theme.accent;
                    Text {
                        text: (i == root.dragging ? root.target
                            : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1
                            : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1
                            : i) + 1;
                        color: Theme.accent;
                        font-family: "Manrope";
                        font-size: 10.5px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            if root.playable: VerticalLayout {
                alignment: center;
                IconBtn {
                    size: 28px;
                    round: true;
                    filled: r.name == root.playing-name;
                    icon: r.name == root.playing-name ? "pause" : "play";
                    icon-size: 10px;
                    tint: r.name == root.playing-name ? Theme.on-accent : Theme.text;
                    label: (r.name == root.playing-name ? "Pause " : "Play ") + r.name;
                    tip: r.name == root.playing-name ? "Pause" : "Play";
                    clicked => { root.play(i); }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    property <color> hue: Math.mod(i, 3) == 0 ? #3a8dff : Math.mod(i, 3) == 1 ? #62d2ff : #9b7bff;
                    width: 30px;
                    height: 30px;
                    border-radius: 7px;
                    background: self.hue.with-alpha(0.1);
                    border-width: 1px;
                    border-color: #ffffff12;
                    for k in 9: Rectangle {
                        x: 6px + k * 2.2px;
                        width: 1.3px;
                        height: 4px + Math.mod(k * 7 + i * 3 + 3, 5) * 2px;
                        y: (parent.height - self.height) / 2;
                        background: parent.hue;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 1px;
                Text { text: r.name; color: Theme.text; font-family: "Manrope"; font-size: 12.5px; font-weight: 800; overflow: elide; }
                if r.note != "": Text { text: r.note; color: Theme.muted; font-family: "Manrope"; font-size: 10.5px; overflow: elide; }
            }
            if root.removable: VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: "close";
                    icon-size: 11px;
                    round: true;
                    label: "Remove " + r.name;
                    tip: "Remove";
                    size: 26px;
                    enabled: root.enabled;
                    clicked => { root.act(i); }
                }
            }
            if root.menu: VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: "dots";
                    icon-size: 14px;
                    size: 26px;
                    label: "Options for " + r.name;
                    tip: "Options";
                    enabled: root.enabled;
                    clicked => {
                        root.menu-row = i;
                        row-menu.show();
                    }
                }
            }
            if root.action != "": VerticalLayout {
                alignment: center;
                Btn {
                    text: root.action;
                    height: 26px;
                    font-size: 11px;
                    enabled: root.enabled;
                    accessible-label: root.action + " " + r.name;
                    clicked => { root.act(i); }
                }
            }
        }
        // Pocket: a grip, the place on a dark tag, a play key, the name and its length (or
        // the part's note under it) on a dotted rule; the dragged row lifts dark with a
        // hard shadow.
        if Theme.pocket: pkr := Rectangle {
            property <bool> lifted: i == root.dragging;
            property <bool> playing: r.name == root.playing-name;
            property <color> ink: self.lifted ? Pk.l0 : root.enabled ? Pk.l3 : Pk.l1;
            x: self.lifted ? 6px : 0;
            y: self.lifted ? -4px : 0;
            Rectangle { visible: pkr.lifted; x: 4px; y: 4px; background: Pk.l2; }
            Rectangle { visible: pkr.lifted; background: Pk.l3; }
            PkTile { visible: !pkr.lifted; y: parent.height - 2px; height: 2px; source: @image-url("skins/px-pocket/rule-row.png"); }
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 6px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    PkPx { source: @image-url("skins/px-pocket/grip.png"); colorize: pkr.lifted ? Pk.l1 : root.enabled ? Pk.l2 : Pk.l1; }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 16px;
                        height: 18px;
                        background: pkr.lifted ? Pk.l0 : root.enabled ? Pk.l3 : Pk.l1;
                        Text {
                            y: -1px;
                            text: (i == root.dragging ? root.target
                                : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1
                                : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1
                                : i) + 1;
                            color: pkr.lifted ? Pk.l3 : Pk.l0;
                            font-family: Pk.big;
                            font-size: 20px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.playable: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        size: 18px;
                        icon: pkr.playing ? "pause" : "play";
                        active: pkr.playing;
                        label: (pkr.playing ? "Pause " : "Play ") + r.name;
                        tip: pkr.playing ? "Pause" : "Play";
                        clicked => { root.play(i); }
                    }
                }
                if root.playable: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 14px;
                        for k in 8: Rectangle {
                            property <int> h: Math.mod(k * 7 + i * 3 + 3, 4);
                            x: k * 4px;
                            y: (3 - self.h) * 2px;
                            width: 2px;
                            height: (self.h * 2 + 1) * 2px;
                            background: pkr.lifted ? Pk.l1 : Pk.l2;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { height: 18px; text: r.name; color: pkr.ink; font-family: Pk.big; font-size: 20px; vertical-alignment: center; overflow: elide; }
                    if !root.playable && r.note != "": Text {
                        height: 10px;
                        text: r.note;
                        color: pkr.lifted ? Pk.l1 : Pk.l2;
                        font-family: Pk.small;
                        font-size: 8px;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.playable && r.note != "": Text { text: r.note; color: pkr.ink; font-family: Pk.big; font-size: 20px; vertical-alignment: center; }
                if root.removable: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        accessible-role: button;
                        accessible-label: "Remove " + r.name;
                        accessible-action-default => { if (root.enabled) { root.act(i); } }
                        background: pkxt.has-hover && root.enabled ? Pk.l1 : transparent;
                        PkPx { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("skins/px-pocket/x.png"); colorize: pkr.ink; }
                        property <bool> hovering: pkxt.has-hover;
                        changed hovering => { Tips.hover(self.hovering, "Remove", self.absolute-position, self.width, self.height); }
                        pkxt := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { Tips.hide(); root.act(i); } }
                    }
                }
                if root.menu: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 14px;
                        height: 22px;
                        accessible-role: button;
                        accessible-label: "Options for " + r.name;
                        accessible-action-default => { if (root.enabled) { root.menu-row = i; row-menu.show(); } }
                        background: pkdt.has-hover && root.enabled ? Pk.l3 : transparent;
                        PkPx { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; s: 1; source: @image-url("skins/px-pocket/dots.png"); colorize: pkdt.has-hover && root.enabled ? Pk.l0 : pkr.ink; }
                        property <bool> hovering: pkdt.has-hover;
                        changed hovering => { Tips.hover(self.hovering, "Options", self.absolute-position, self.width, self.height); }
                        pkdt := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { Tips.hide(); root.menu-row = i; row-menu.show(); } }
                    }
                }
                if root.action != "": VerticalLayout {
                    alignment: center;
                    Btn {
                        text: root.action;
                        height: 18px;
                        enabled: root.enabled;
                        accessible-label: root.action + " " + r.name;
                        clicked => { root.act(i); }
                    }
                }
            }
        }
        // Answering Machine: a message on the log: a grip, the place on a small red display,
        // a round play key (red while it plays), the name and length, and a remove nub.
        if Theme.answer: HorizontalLayout {
            padding-left: 10px;
            padding-right: 8px;
            spacing: 8px;
            Icon {
                name: "grip";
                tint: Am.print-soft;
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    // The place the row has right now, also mid-drag.
                    property <int> place: (i == root.dragging ? root.target
                        : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1
                        : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1
                        : i) + 1;
                    width: 26px;
                    height: 17px;
                    border-radius: 3px;
                    background: Am.smoke;
                    Text {
                        text: (self.place < 10 ? "0" : "") + self.place;
                        property <int> place: parent.place;
                        color: Am.led;
                        font-family: "Memo Segments";
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            if root.playable: VerticalLayout {
                alignment: center;
                IconBtn {
                    size: 22px;
                    round: true;
                    filled: r.name == root.playing-name;
                    icon: r.name == root.playing-name ? "pause" : "play";
                    icon-size: 9px;
                    label: (r.name == root.playing-name ? "Pause " : "Play ") + r.name;
                    tip: r.name == root.playing-name ? "Pause" : "Play";
                    clicked => { root.play(i); }
                }
            }
            Text {
                text: r.name;
                color: Am.ink;
                font-family: "Courier Prime";
                font-size: 12.5px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if r.note != "": Text {
                text: r.note;
                color: Am.ink2;
                font-family: "Courier Prime";
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: right;
                min-width: 44px;
            }
            if root.removable: VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: "close";
                    icon-size: 10px;
                    width: 22px;
                    height: 20px;
                    label: "Remove " + r.name;
                    tip: "Remove";
                    enabled: root.enabled;
                    clicked => { root.act(i); }
                }
            }
            if root.menu: VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: "dots";
                    icon-size: 13px;
                    width: 22px;
                    height: 20px;
                    label: "Options for " + r.name;
                    tip: "Options";
                    enabled: root.enabled;
                    clicked => {
                        root.menu-row = i;
                        row-menu.show();
                    }
                }
            }
            if root.action != "": VerticalLayout {
                alignment: center;
                Btn {
                    text: root.action;
                    height: 26px;
                    enabled: root.enabled;
                    accessible-label: root.action + " " + r.name;
                    clicked => { root.act(i); }
                }
            }
        }
        // Pocket Synth: a long key in the chain: a grip, its place on a little black screen in
        // orange, a play key (orange while it plays), the clip and a round key at the end; the
        // dragged one in an orange ring.
        if Theme.synth: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.row-h - 8px;
            Rectangle {
                visible: i == root.dragging;
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #ff5a1e;
            }
            SynKey { x: 0; y: 0; width: parent.width; height: parent.height; radius: 9px; }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 10px;
                spacing: 9px;
                Icon {
                    name: "grip";
                    tint: #9d998f;
                    width: 13px;
                    height: 15px;
                    y: (parent.height - self.height) / 2;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 4px;
                        background: #0b0c0c;
                        Text {
                            text: (i == root.dragging ? root.target
                                : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1
                                : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1
                                : i) + 1;
                            color: #ff5a1e;
                            font-family: Theme.mono;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.playable: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        size: 30px;
                        height: 28px;
                        filled: r.name == root.playing-name;
                        icon: r.name == root.playing-name ? "pause" : "play";
                        icon-size: 10px;
                        label: (r.name == root.playing-name ? "Pause " : "Play ") + r.name;
                        tip: r.name == root.playing-name ? "Pause" : "Play";
                        clicked => { root.play(i); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: r.name; color: #1c1c1b; font-family: "Inter Tight"; font-size: 12.5px; font-weight: 600; overflow: elide; }
                    if r.note != "": Text { text: r.note; color: #7a766d; font-family: Theme.mono; font-size: 9px; font-weight: 500; overflow: elide; }
                }
                if root.removable: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        icon: "close";
                        icon-size: 8px;
                        round: true;
                        label: "Remove " + r.name;
                        tip: "Remove";
                        size: 20px;
                        enabled: root.enabled;
                        clicked => { root.act(i); }
                    }
                }
                if root.menu: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        icon: "dots";
                        icon-size: 10px;
                        round: true;
                        size: 20px;
                        label: "Options for " + r.name;
                        tip: "Options";
                        enabled: root.enabled;
                        clicked => {
                            root.menu-row = i;
                            row-menu.show();
                        }
                    }
                }
                if root.action != "": VerticalLayout {
                    alignment: center;
                    Btn {
                        text: root.action;
                        height: 26px;
                        font-size: 12px;
                        enabled: root.enabled;
                        accessible-label: root.action + " " + r.name;
                        clicked => { root.act(i); }
                    }
                }
            }
        }
        if Theme.cozy: CzOrderRow {
            x: 0;
            y: 3px;
            width: parent.width;
            height: root.row-h - 6px;
            item: r;
            place: (i == root.dragging ? root.target
                : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1
                : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1
                : i) + 1;
            lifted: i == root.dragging;
            playing: r.name == root.playing-name;
            playable: root.playable;
            removable: root.removable;
            menu: root.menu;
            enabled: root.enabled;
            play => { root.play(i); }
            remove => { root.act(i); }
            open-menu => {
                root.menu-row = i;
                row-menu.show();
            }
        }
        if Theme.pinball: PbOrderRow {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.row-h;
            item: r;
            place: (i == root.dragging ? root.target
                : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1
                : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1
                : i) + 1;
            lifted: i == root.dragging;
            playing: r.name == root.playing-name;
            playable: root.playable;
            removable: root.removable;
            menu: root.menu;
            enabled: root.enabled;
            play => { root.play(i); }
            remove => { root.act(i); }
            open-menu => {
                root.menu-row = i;
                row-menu.show();
            }
        }
        if Theme.phono: PnOrderRow {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.row-h;
            item: r;
            place: (i == root.dragging ? root.target
                : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1
                : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1
                : i) + 1;
            lifted: i == root.dragging;
            playing: r.name == root.playing-name;
            playable: root.playable;
            removable: root.removable;
            menu: root.menu;
            enabled: root.enabled;
            play => { root.play(i); }
            remove => { root.act(i); }
            open-menu => {
                root.menu-row = i;
                row-menu.show();
            }
        }
        if !Theme.tape && !Theme.os95 && !Theme.comic && !Theme.dash && !Theme.pocket && !Theme.quest && !Theme.brick && !Theme.answer && !Theme.synth && !Theme.cozy && !Theme.pinball && !Theme.phono: HorizontalLayout {
            padding-left: 10px;
            padding-right: 8px;
            spacing: 10px;
            Icon {
                name: "grip";
                tint: Theme.dim;
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
            }
            Text {
                // The place the row has right now, also mid-drag.
                text: (i == root.dragging ? root.target
                    : root.dragging >= 0 && i > root.dragging && i <= root.target ? i - 1
                    : root.dragging >= 0 && i < root.dragging && i >= root.target ? i + 1
                    : i) + 1;
                color: Theme.accent;
                font-family: Theme.mono;
                font-size: 12px;
                vertical-alignment: center;
                width: 16px;
            }
            if root.playable: VerticalLayout {
                alignment: center;
                IconBtn {
                    size: 30px;
                    round: true;
                    outlined: r.name != root.playing-name;
                    filled: r.name == root.playing-name;
                    icon: r.name == root.playing-name ? "pause" : "play";
                    icon-size: 10px;
                    tint: r.name == root.playing-name ? Theme.on-accent : Theme.text;
                    label: (r.name == root.playing-name ? "Pause " : "Play ") + r.name;
                    tip: r.name == root.playing-name ? "Pause" : "Play";
                    clicked => { root.play(i); }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 1px;
                Text { text: r.name; color: Theme.text; font-size: 14px; overflow: elide; }
                if r.note != "": Text { text: r.note; color: Theme.dim; font-size: 11px; overflow: elide; }
            }
            if root.removable: VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: "close";
                    icon-size: 12px;
                    label: "Remove " + r.name;
                    tip: "Remove";
                    size: 28px;
                    enabled: root.enabled;
                    clicked => { root.act(i); }
                }
            }
            if root.menu: VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: "dots";
                    icon-size: 14px;
                    size: 28px;
                    label: "Options for " + r.name;
                    tip: "Options";
                    enabled: root.enabled;
                    clicked => {
                        root.menu-row = i;
                        row-menu.show();
                    }
                }
            }
            if root.action != "": VerticalLayout {
                alignment: center;
                Btn {
                    text: root.action;
                    height: 28px;
                    font-size: 12px;
                    enabled: root.enabled;
                    accessible-label: root.action + " " + r.name;
                    clicked => { root.act(i); }
                }
            }
        }
        Rectangle {
            visible: i < root.rows.length - 1 && root.dragging < 0 && !Theme.tape && !Theme.os95 && !Theme.comic && !Theme.dash && !Theme.pocket && !Theme.quest && !Theme.brick && !Theme.synth && !Theme.cozy && !Theme.pinball && !Theme.phono;
            x: 10px;
            y: parent.height - 1px;
            width: parent.width - 20px;
            height: 1px;
            background: Theme.divider;
        }
    }
    // The row menu, under the row's dots.
    row-menu := PopupWindow {
        x: root.width - 8px - 160px;
        y: (root.menu-row + 1) * root.row-h - 8px;
        width: 160px;
        height: 2 * Theme.menu-h + 2 * Theme.menu-pad;
        close-policy: close-on-click-outside;
        MenuCard {
            VerticalLayout {
                padding: Theme.menu-pad;
                MenuRow {
                    num: 1;
                    text: "Rename";
                    icon: Theme.dash || Theme.answer || Theme.synth ? "pencil" : "";
                    clicked => { root.rename(root.menu-row); row-menu.close(); }
                }
                MenuRow {
                    num: 2;
                    text: "Remove";
                    danger: Theme.dash || Theme.synth;
                    icon: Theme.dash || Theme.synth || Theme.answer ? "close" : "";
                    clicked => { root.act(root.menu-row); row-menu.close(); }
                }
            }
        }
    }
}

export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> note;
    callback back();
    padding-left: 20px;
    padding-right: 22px;
    padding-bottom: 6px;
    spacing: 10px;
    Rectangle {
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: bt.has-hover ? Theme.raised : Theme.card;
        accessible-role: button;
        accessible-label: "Back";
        accessible-action-default => { root.back(); }
        Icon { name: "back"; tint: Theme.muted; width: 15px; height: 15px; }
        bt := TouchArea { mouse-cursor: pointer; clicked => { root.back(); } }
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 24px;
        font-weight: 800;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Text {
        text: root.note;
        color: Theme.dim;
        font-size: 12px;
        vertical-alignment: center;
    }
}

// A dropdown in the Ember look; the list opens below it.
export component Select inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    in property <string> label;
    callback selected(int);
    // Up and Down pick the next option straight away, closed or open, so two
    // choices are easy to compare.
    function step(by: int) {
        if (root.model.length == 0) { return; }
        let next = clamp(root.current-index + by, 0, root.model.length - 1);
        if (next != root.current-index) {
