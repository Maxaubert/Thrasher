        Rectangle {
            // Tape Deck: a strip of black label tape, the current choice amber. Desktop 95: a
            // white list with a black line, the current choice navy.
            background: Theme.phono ? Pn.card : Theme.pinball ? Pb.pop : Theme.pocket ? Pk.l0 : Theme.quest ? transparent : Theme.brick || Theme.cozy ? transparent : Theme.tape ? #0b0b0c : Theme.os95 ? #ffffff : Theme.comic ? #ffffff : Theme.dash ? #171b21 : Theme.synth ? transparent : Theme.popup;
            border-radius: Theme.tape || Theme.os95 || Theme.comic || Theme.pocket || Theme.quest || Theme.cozy || Theme.pinball ? 0 : Theme.phono ? 4px : Theme.dash ? 12px : Theme.answer ? 6px : Theme.synth ? 12px : 10px;
            border-width: Theme.cozy ? 0 : Theme.phono ? 2px : Theme.comic ? 3px : Theme.synth ? 0 : Theme.quest ? 0 : Theme.pocket ? 2px : Theme.brick ? 0 : 1px;
            border-color: Theme.phono ? Pn.brass-mid : Theme.pinball ? Pb.edge : Theme.pocket ? Pk.l3 : Theme.tape || Theme.os95 ? #000000 : Theme.comic ? Comic.ink : Theme.dash ? #ffffff33 : Theme.answer ? Am.chip-lip : Theme.edge;
            drop-shadow-blur: Theme.tape || Theme.comic || Theme.os95 || Theme.pocket || Theme.quest || Theme.brick || Theme.cozy ? 0 : 20px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000099;
            if Theme.quest: QFrame { x: 0; y: 0; }
            if Theme.pinball: Rectangle { x: 0; y: 0; width: parent.width; height: 2px; background: Pb.plasma; }
            if Theme.phono: Rectangle { x: -1px; y: -1px; width: parent.width + 2px; height: parent.height + 2px; border-radius: 5px; border-width: 1px; border-color: Pn.soot; }
            if Theme.cozy: Rectangle { x: 6px; y: 6px; width: parent.width; height: parent.height; background: #00000059; }
            if Theme.cozy: Rectangle { x: 0; y: 0; width: parent.width; height: parent.height; CzNote { } }
            FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                        root.step(e.text == Key.UpArrow ? -1 : 1);
                        // Keep the picked row in view.
                        let top = root.current-index * root.row-h;
                        if (top < -list.content-y) { list.content-y = -top; }
                        if (top + root.row-h > -list.content-y + list.height) { list.content-y = list.height - top - root.row-h; }
