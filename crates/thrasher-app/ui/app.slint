// Thrasher, first window. Deliberately plain: it will be redesigned after the
// mockups (issue #3). Two modes: the full window, and a small always-on-top widget.

import { ComboBox, CheckBox, LineEdit, ListView, Button, ScrollView, TextEdit } from "std-widgets.slint";

// The notification-area icon. Its image is drawn in Rust (red dot while recording).
export component Tray inherits SystemTrayIcon {
    in property <image> image;
    in property <bool> recording;
    callback toggle-record();
    callback show-window();
    callback show-widget();
    callback quit();
    icon: image;
    tooltip: recording ? "Thrasher: recording" : "Thrasher";
    clicked => { show-window(); }
    Menu {
        MenuItem {
            title: recording ? "Stop recording" : "Start recording";
            activated => { toggle-record(); }
        }
        MenuItem {
            title: "Show window";
            activated => { show-window(); }
        }
        MenuItem {
            title: "Show widget";
            activated => { show-widget(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { quit(); }
        }
    }
}

export struct ModelRow {
    name: string,
    description: string,
    size: string,
    downloaded: bool,
    active: bool,
}

export struct WordRow {
    text: string,
    is-silence: bool,
}

export struct ClipRow {
    name: string,
    duration: string,
    has-system: bool,
}

global Theme {
    out property <color> bg: #121212;
    out property <color> surface: #1c1c1c;
    out property <color> surface-hi: #262626;
    out property <color> text: #e8e8e8;
    out property <color> muted: #8a8a8a;
    out property <color> accent: #3b82f6;
    out property <color> rec: #ef4444;
}

component Meter inherits Rectangle {
    in property <float> level;
    in property <string> label;
    height: 18px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: label;
            color: Theme.muted;
            width: 52px;
            font-size: 11px;
            vertical-alignment: center;
        }
        Rectangle {
            background: Theme.surface-hi;
            border-radius: 3px;
            Rectangle {
                x: 0;
                width: parent.width * clamp(level, 0, 1);
                height: parent.height;
                border-radius: 3px;
                background: level > 0.95 ? Theme.rec : Theme.accent;
                animate width { duration: 60ms; }
            }
        }
    }
}

component RecordButton inherits Rectangle {
    in property <bool> recording;
    in property <bool> paused;
    in property <length> size: 72px;
    callback clicked;
    width: size;
    height: size;
    border-radius: size / 2;
    border-width: 2px;
    border-color: recording ? Theme.rec : #3a3a3a;
    background: touch.has-hover ? Theme.surface-hi : Theme.surface;
    Rectangle {
        width: recording ? size * 0.34 : size * 0.44;
        height: self.width;
        border-radius: recording ? 4px : self.width / 2;
        background: paused ? #a35a5a : Theme.rec;
        animate width, border-radius { duration: 120ms; }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Icons are drawn as paths so they never depend on which fonts are installed.
component IconButton inherits Rectangle {
    // "close", "widget", "expand" or "pin"
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: active ? Theme.accent : (t.has-hover ? Theme.surface-hi : transparent);
    Path {
        width: 12px;
        height: 12px;
        stroke: Theme.text;
        stroke-width: 1.5px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: icon == "close" ? "M 1 1 L 11 11 M 11 1 L 1 11"
            : icon == "widget" ? "M 1 4 L 11 4 L 11 9 L 1 9 Z"
            : icon == "expand" ? "M 1 1 L 11 1 L 11 11 L 1 11 Z M 1 4 L 11 4"
            : "M 4 1 L 8 1 L 8 6 L 10 8 L 2 8 L 4 6 Z M 6 8 L 6 11";
    }
    t := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Thrasher";
    background: compact ? transparent : Theme.bg;
    default-font-size: 13px;
    preferred-width: 440px;
    preferred-height: 640px;
    min-width: compact ? 240px : 360px;
    min-height: compact ? 64px : 420px;
    always-on-top: pinned || compact;
    no-frame: compact;

    in-out property <bool> recording;
    in-out property <bool> paused;
    in property <string> elapsed: "0:00";
    in property <float> mic-level;
    in property <float> system-level;
    in property <[string]> mic-devices;
    in-out property <int> mic-index;
    in-out property <bool> record-system;
    in property <[ClipRow]> clips;
    in-out property <int> selected: -1;
    in property <bool> playing;
    in property <string> play-position;
    in property <string> status;
    in property <bool> can-undo;
    in property <string> folder;
    in property <string> hotkey;
    in property <bool> can-transcribe;
    in property <bool> transcribing;
    in property <float> transcribe-progress;
    in property <string> transcript;
    in property <[ModelRow]> models;
    in property <int> downloading: -1;
    in property <float> download-progress;
    in-out property <bool> show-models;
    in property <[WordRow]> words;
    in property <int> current-word: -1;
    in-out property <bool> editing-transcript;
    in-out property <int> export-format;
    in-out property <bool> clean-voice;
    in-out property <bool> pinned;
    in-out property <bool> compact;
    in-out property <bool> renaming;
    in-out property <length> list-y;
    in-out property <length> list-height: 300px;

    callback toggle-record();
    callback toggle-pause();
    callback play-selected();
    callback stop-playback();
    callback delete-selected();
    callback delete-last();
    callback undo-delete();
    callback rename-selected(string);
    callback mic-changed(int);
    callback system-changed(bool);
    callback pinned-changed(bool);
    callback compact-changed(bool);
    callback open-folder();
    callback export-selected();
    callback transcribe-selected();
    callback selection-changed(int);
    callback apply-transcript(string);
    callback seek-word(int);
    callback export-format-changed(int);
    callback clean-voice-changed(bool);
    callback download-model(int);
    callback cancel-download();
    callback use-model(int);
    callback quit();

    changed selected => { root.selection-changed(root.selected); }

    function move-selection(delta: int) {
        if (clips.length == 0) { return; }
        selected = clamp(selected < 0 ? clips.length - 1 : selected + delta, 0, clips.length - 1);
        if (selected * 34px < -list-y) {
            list-y = -(selected * 34px);
        } else if ((selected + 1) * 34px > -list-y + list-height) {
            list-y = -((selected + 1) * 34px - list-height);
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (renaming) { return reject; }
            if (event.text == " ") { root.toggle-record(); return accept; }
            if (event.text == Key.Return) { root.play-selected(); return accept; }
            if (event.text == Key.Escape) { root.stop-playback(); return accept; }
            if (event.text == Key.Delete) { root.delete-selected(); return accept; }
            if (event.text == Key.Backspace) { root.delete-last(); return accept; }
            if (event.text == Key.UpArrow) { root.move-selection(-1); return accept; }
            if (event.text == Key.DownArrow) { root.move-selection(1); return accept; }
            if (event.text == Key.F2 && selected >= 0) { root.renaming = true; return accept; }
            if (event.modifiers.control && event.text == "z") { root.undo-delete(); return accept; }
            if (event.text == "p" && recording) { root.toggle-pause(); return accept; }
            reject
        }

        // ---------- Widget mode ----------
        if compact: Rectangle {
            background: Theme.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: recording ? Theme.rec : #2e2e2e;
            WindowMoveArea {
                HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;
                    alignment: start;
                    RecordButton {
                        size: 44px;
                        recording: root.recording;
                        paused: root.paused;
                        clicked => { root.toggle-record(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        width: 90px;
                        Text {
                            text: root.elapsed;
                            color: recording ? Theme.text : Theme.muted;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        Rectangle {
                            height: 4px;
                            background: Theme.surface-hi;
                            border-radius: 2px;
                            Rectangle {
                                x: 0;
                                height: parent.height;
                                width: parent.width * clamp(max(root.mic-level, root.system-level), 0, 1);
                                background: Theme.accent;
                                border-radius: 2px;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 2px;
                            IconButton {
                                icon: "expand";
                                clicked => { root.compact-changed(false); }
                            }
                            IconButton {
                                icon: "close";
                                clicked => { root.quit(); }
                            }
                        }
                    }
                }
            }
        }

        // ---------- Full window ----------
        if !compact: VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Thrasher";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { }
                if root.can-transcribe: Button {
                    text: root.show-models ? "Clips" : "Models";
                    clicked => { root.show-models = !root.show-models; }
                }
                IconButton {
                    icon: "pin";
                    active: root.pinned;
                    clicked => { root.pinned = !root.pinned; root.pinned-changed(root.pinned); }
                }
                IconButton {
                    icon: "widget";
                    clicked => { root.compact-changed(true); }
                }
            }

            // Recorder
            Rectangle {
                background: Theme.surface;
                border-radius: 12px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 16px;
                        RecordButton {
                            recording: root.recording;
                            paused: root.paused;
                            clicked => { root.toggle-record(); }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: root.elapsed;
                                color: root.recording ? Theme.text : Theme.muted;
                                font-size: 28px;
                                font-weight: 600;
                            }
                            Text {
                                text: root.recording ? (root.paused ? "Paused" : "Recording") : (root.hotkey != "" ? "Space, or " + root.hotkey + " anywhere" : "Space to record");
                                color: root.recording && !root.paused ? Theme.rec : Theme.muted;
                                font-size: 12px;
                            }
                        }
                        Rectangle { }
                        if root.recording: VerticalLayout {
                            alignment: center;
                            Button {
                                text: root.paused ? "Resume" : "Pause";
                                clicked => { root.toggle-pause(); }
                            }
                        }
                    }
                    Meter { label: "Mic"; level: root.mic-level; }
                    if root.record-system: Meter { label: "System"; level: root.system-level; }
                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox {
                            model: root.mic-devices;
                            current-index <=> root.mic-index;
                            enabled: !root.recording;
                            selected => { root.mic-changed(self.current-index); }
                        }
                        CheckBox {
                            text: "System audio";
                            checked <=> root.record-system;
                            enabled: !root.recording;
                            toggled => { root.system-changed(self.checked); }
                        }
                    }
                }
            }

            if root.show-models: VerticalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                Text {
                    text: "Transcription models. Downloaded once, then everything runs on this PC.";
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                for m[i] in root.models: Rectangle {
                    background: m.active ? #1e3a5f : Theme.surface;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: m.name; color: Theme.text; font-weight: 600; overflow: elide; }
                            Text {
                                text: root.downloading == i
                                    ? "Downloading " + round(root.download-progress * 100) + "%"
                                    : m.description;
                                color: Theme.muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            if m.downloaded && !m.active: Button {
                                text: "Use";
                                clicked => { root.use-model(i); }
                            }
                            if m.downloaded && m.active: Text { text: "In use"; color: Theme.accent; }
                            if !m.downloaded && root.downloading != i: Button {
                                text: "Download " + m.size;
                                enabled: root.downloading < 0;
                                clicked => { root.download-model(i); }
                            }
                            if root.downloading == i: Button {
                                text: "Cancel";
                                clicked => { root.cancel-download(); }
                            }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Clips
            if !root.show-models: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Clips";
                    color: Theme.muted;
                    vertical-alignment: center;
                }
                Rectangle { }
                if root.can-undo: Button {
                    text: "Undo delete";
                    clicked => { root.undo-delete(); }
                }
                Button {
                    text: "Folder";
                    clicked => { root.open-folder(); }
                }
            }
            if !root.show-models: ListView {
                vertical-stretch: 1;
                content-y <=> root.list-y;
                init => { root.list-height = self.visible-height; }
                changed visible-height => { root.list-height = self.visible-height; }
                for clip[i] in root.clips: Rectangle {
                    height: 34px;
                    border-radius: 6px;
                    background: i == root.selected ? #1e3a5f : (row-touch.has-hover ? Theme.surface : transparent);
                    row-touch := TouchArea {
                        clicked => { root.selected = i; keys.focus(); }
                        double-clicked => { root.selected = i; root.play-selected(); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: clip.name;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if clip.has-system: Text {
                            text: "+ system";
                            color: Theme.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: clip.duration;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.transcribing: Text {
                text: "Transcribing… " + round(root.transcribe-progress * 100) + "%";
                color: Theme.muted;
            }
            // Synced transcript: the word being heard is highlighted; click a word to jump.
            if root.transcript != "" && !root.transcribing && !root.editing-transcript: VerticalLayout {
                spacing: 4px;
                Rectangle {
                    background: Theme.surface;
                    border-radius: 8px;
                    height: 130px;
                    ScrollView {
                        // A new transcript starts at the top; Slint would keep the old offset.
                        property <string> shown: root.transcript;
                        init => { self.content-y = 0; }
                        changed shown => { self.content-y = 0; }
                        changed content-height => { if (root.current-word < 0) { self.content-y = 0; } }
                        FlexboxLayout {
                            padding: 8px;
                            spacing: 2px;
                            flex-wrap: wrap;
                            for w[i] in root.words: Rectangle {
                                border-radius: 4px;
                                background: i == root.current-word ? Theme.accent : (wt.has-hover ? Theme.surface-hi : transparent);
                                width: label.preferred-width + 6px;
                                height: label.preferred-height + 2px;
                                label := Text {
                                    text: w.text;
                                    color: w.is-silence ? Theme.muted : Theme.text;
                                    font-size: w.is-silence ? 11px : 13px;
                                }
                                wt := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.seek-word(i); keys.focus(); }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "Click a word to play from there.";
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Edit";
                        clicked => { root.editing-transcript = true; }
                    }
                }
            }
            if root.transcript != "" && !root.transcribing && root.editing-transcript: VerticalLayout {
                spacing: 4px;
                transcript-edit := TextEdit {
                    height: 130px;
                    text: root.transcript;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Delete words or pauses, or change a [silence:7s] tag. Retype a word to bring it back.";
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Cancel";
                        clicked => { root.editing-transcript = false; keys.focus(); }
                    }
                    Button {
                        text: "Apply";
                        enabled: transcript-edit.text != root.transcript;
                        clicked => { root.apply-transcript(transcript-edit.text); keys.focus(); }
                    }
                }
            }

            if root.renaming && root.selected >= 0: HorizontalLayout {
                spacing: 6px;
                name-edit := LineEdit {
                    text: root.clips[root.selected].name;
                    accepted(t) => { root.renaming = false; root.rename-selected(t); keys.focus(); }
                    init => { self.focus(); self.select-all(); }
                }
                Button {
                    text: "Cancel";
                    clicked => { root.renaming = false; keys.focus(); }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: root.playing ? "Stop" : "Play";
                    enabled: root.selected >= 0;
                    clicked => { if (root.playing) { root.stop-playback(); } else { root.play-selected(); } keys.focus(); }
                }
                Button {
                    text: "Rename";
                    enabled: root.selected >= 0 && !root.recording;
                    clicked => { root.renaming = true; }
                }
                Button {
                    text: "Delete";
                    enabled: root.selected >= 0;
                    clicked => { root.delete-selected(); keys.focus(); }
                }
                Button {
                    text: "Export";
                    enabled: root.selected >= 0;
                    clicked => { root.export-selected(); keys.focus(); }
                }
                CheckBox {
                    text: "Clean voice";
                    checked <=> root.clean-voice;
                    toggled => { root.clean-voice-changed(self.checked); keys.focus(); }
                }
                ComboBox {
                    model: ["FLAC", "WAV", "MP3"];
                    current-index <=> root.export-format;
                    selected => { root.export-format-changed(self.current-index); keys.focus(); }
                }
                if root.can-transcribe: Button {
                    text: "Transcribe";
                    enabled: root.selected >= 0 && !root.transcribing && !root.recording;
                    clicked => { root.transcribe-selected(); keys.focus(); }
                }
                Rectangle { }
                if root.playing: Text {
                    text: root.play-position;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.status != "" ? root.status : root.folder;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }

    init => { keys.focus(); }
}
