            visible: !Theme.quest;
            padding-left: Theme.tape ? 9px : Theme.pocket ? 8px : Theme.brick ? 6px : 12px;
            padding-right: Theme.tape ? 7px : Theme.pocket ? 8px : Theme.brick ? 4px : 9px;
            spacing: Theme.tape ? 6px : Theme.brick ? 5px : 8px;
            shown := Text {
                text: root.current-index >= 0 && root.current-index < root.model.length
                    ? (Theme.tape ? root.model[root.current-index].to-uppercase() : root.model[root.current-index]) : "";
                color: Theme.pocket ? Pk.l0 : Theme.tape ? #f5f1e8 : Theme.os95 ? transparent : Theme.comic ? Comic.ink : Theme.answer ? Am.name-ink : Theme.synth ? #eef3ee : Theme.phono ? Pn.ink : Theme.pinball ? Pb.ink : Theme.cozy ? Cz.ink : Theme.text;
                font-family: Theme.pocket ? Pk.big : Theme.tape || Theme.synth ? Theme.mono : Theme.comic ? "Comic Neue" : Theme.dash ? "Manrope" : Theme.answer ? "Courier Prime" : Theme.brick ? Brick.words : Theme.phono ? Pn.font : Theme.pinball ? Pb.font : Theme.cozy ? Cz.font : "Inter Tight";
                font-size: Theme.phono ? 14px : Theme.pinball ? 14px : Theme.pocket ? 20px : Theme.tape ? 11px : Theme.dash ? 12px : Theme.brick ? 16px : Theme.answer ? 12.5px : Theme.synth ? 11px : 13px;
                font-weight: Theme.tape || Theme.dash || Theme.comic || Theme.answer ? 700 : Theme.phono ? 600 : Theme.synth || Theme.cozy ? 500 : 400;
                letter-spacing: Theme.tape ? 1px : 0;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if Theme.pocket: PkPx { y: (parent.height - self.height) / 2; source: @image-url("skins/px-pocket/down.png"); colorize: Pk.l0; }
            if Theme.cozy: PkPx { y: (parent.height - self.height) / 2; s: 2; source: @image-url("skins/px-cozy/down.png"); colorize: Cz.brown; }
            Icon {
                visible: !Theme.os95 && !Theme.pocket && !Theme.brick && !Theme.cozy;
                name: Theme.pinball || Theme.phono || Theme.tape || Theme.comic || Theme.dash || Theme.answer || Theme.synth ? "down" : "updown";
                tint: Theme.phono ? Pn.ink : Theme.pinball ? Pb.plasma : Theme.tape ? #f5f1e8 : Theme.comic ? Comic.ink : Theme.dash ? Theme.dim : Theme.answer ? Am.print : Theme.synth ? #b9c0ba : Theme.muted;
                stroke-width: Theme.comic ? 2.8px : 2px;
                width: Theme.phono ? 10px : Theme.pinball ? 10px : Theme.pocket || Theme.cozy ? 0 : Theme.dash || Theme.synth ? 10px : Theme.brick ? 8px : 12px;
                height: Theme.pinball || Theme.phono || Theme.dash || Theme.synth ? 10px : Theme.brick ? 8px : 12px;
