// The Car Dashboard's parts, shared by its main page (x-dash.slint) and its other pages
// (x-dash-pages.slint): the cockpit's colours, art at 1x or 2x, the title bar and its
// window keys, the round spoke button and a clip's cover tile.

import { Theme, Main, Tips, Icon } from "../common.slint";

// The cockpit's colours, from the mockup.
export global Dash {
    out property <color> body: #0c0e11;
    out property <color> glass: #13171c;
    out property <color> glass2: #181d23;
    out property <color> well: #0e1115;
    out property <color> line: #ffffff12;
    out property <color> line2: #ffffff1f;
    out property <color> text: #eef2f6;
    out property <color> text2: #c9d2dc;
    out property <color> dim: #8a95a3;
    out property <color> faint: #56606c;
    out property <color> ice: #62d2ff;
    out property <color> ice2: #3a8dff;
    out property <color> ink: #04121c;
    out property <color> rec: #ff4d5e;
    out property <color> ok: #47e0a0;
    out property <color> warn: #ffb547;
    out property <color> track: #1c2229;
    // The tints of the playlist's cover tiles, in turn.
    out property <[color]> hues: [#3a8dff, #62d2ff, #9b7bff, #47e0a0];
}

// A piece of art, the 2x cut when the display is dense.
export component Art inherits Image {
    in property <image> lo;
    in property <image> hi;
    source: 1phx < 0.7px ? root.hi : root.lo;
    image-fit: fill;
}

// Minimise and close.
export component WinKey inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked;
    width: 30px;
    height: 26px;
    border-radius: 6px;
    background: t.has-hover ? #ffffff0f : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon {
        name: root.icon;
        tint: t.has-hover ? Dash.text : Dash.dim;
        width: 12px;
        height: 12px;
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.label, self.absolute-position, self.width, self.height); }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

// The back chip of a title bar: an ice chevron and a word in small caps.
export component BackChip inherits Rectangle {
    in property <string> text;
    in property <string> label;
    callback clicked;
    width: chip-row.preferred-width;
    height: 24px;
    border-radius: 12px;
    background: t.has-hover ? #1f252d : Dash.glass2;
    border-width: 1px;
    border-color: Dash.line2;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    chip-row := HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 6px;
        Icon { name: "back"; tint: Dash.ice; width: 12px; height: 12px; y: (parent.height - self.height) / 2; }
        Text {
            text: root.text;
            color: Dash.text2;
            font-family: "Manrope";
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The title bar: the brand, (wide) the mode words, minimise and close. Settings moved
// to the wheel. The other pages name their own mode (PLAY MODE, SETUP MODE), and the
// clip page puts a back chip before the brand.
export component Title inherits Rectangle {
    in property <bool> wide;
    in property <string> mode: "REC";
    in property <string> mode2: "MODE";
    // The back chip's word (CLIPS); empty for none.
    in property <string> back-text;
    in property <string> back-label;
    callback back();
    height: 34px;
    background: Dash.body;
    Rectangle { y: parent.height - 1px; height: 1px; background: Dash.line; }
    // The light along the top edge.
    Rectangle {
        y: 0;
        height: 1px;
        opacity: 0.9;
        background: @linear-gradient(90deg, #3a8dff00 0%, #3a8dff 25%, #62d2ff 50%, #9b7bff 75%, #9b7bff00 100%);
    }
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    HorizontalLayout {
        padding-left: root.back-text != "" ? 10px : 14px;
        padding-right: 6px;
        spacing: 10px;
        if root.back-text != "": VerticalLayout {
            alignment: center;
            BackChip { text: root.back-text; label: root.back-label; clicked => { root.back(); } }
        }
        HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 0;
            VerticalLayout {
                alignment: center;
                Art {
                    width: 16px;
                    height: 16px;
                    lo: @image-url("dash/logo.png");
                    hi: @image-url("dash/logo@2x.png");
                }
            }
            Text {
                text: "THRASHER";
                color: Dash.text;
                font-family: "Manrope";
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 3.1px;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 14px;
            if root.wide: HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.mode;
                    color: Dash.dim;
                    font-family: "Manrope";
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1.4px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.mode2;
                    color: Dash.faint;
                    font-family: "Manrope";
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1.4px;
                    vertical-alignment: center;
                }
            }
            if root.wide: Text {
                text: "LOCAL ONLY";
                color: Dash.faint;
                font-family: "Manrope";
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.4px;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            WinKey { icon: "minimize"; label: "Minimize"; clicked => { Main.minimize-window(); } }
        }
        VerticalLayout {
            alignment: center;
            WinKey { icon: "close"; label: "Close"; clicked => { Main.close-window(); } }
        }
    }
}

// A round spoke button.
export component Spoke inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> tip: label;
    // The word under it (wide).
    in property <string> caption;
    in property <bool> lit;
    callback clicked;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Art {
        x: -root.width / 12;
        y: -root.width / 12;
        width: root.width * 42 / 36;
        height: root.width * 42 / 36;
        lo: @image-url("dash/sbtn.png");
        hi: @image-url("dash/sbtn@2x.png");
    }
    if t.has-hover || root.lit: Rectangle {
        border-radius: root.width / 2;
        background: root.lit ? #62d2ff26 : t.pressed ? #ffffff08 : #ffffff14;
    }
    Icon {
        y: (parent.height - self.height) / 2 + (t.pressed ? 1px : 0);
        name: root.icon;
        tint: root.lit ? Dash.ice : t.has-hover ? #ffffff : #d7dee6;
        width: root.width * 0.46;
        height: root.width * 0.46;
    }
    // The caption shrinks with the wheel (36px is its full size), so neighbours on a
    // short window do not run into each other.
    property <float> cs: min(1, root.width / 36px);
    if root.caption != "": Text {
        x: (parent.width - 60px) / 2;
        y: parent.height + 5px * root.cs;
        width: 60px;
        text: root.caption;
        color: Dash.faint;
        font-family: "Manrope";
        font-size: max(6.5px, 8px * root.cs);
        font-weight: 700;
        letter-spacing: 0.64px * root.cs;
        horizontal-alignment: center;
        accessible-role: none;
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

// A clip's waveform on its cover tile, as thin bars in the tile's tint; what has played
// is bright.
export component Tile inherits Rectangle {
    in property <[float]> values;
    in property <color> hue;
    in property <float> progress: -1;
    in property <bool> lit;
    border-radius: 7px;
    background: root.hue.with-alpha(0.1);
    border-width: 1px;
    border-color: root.lit ? #62d2ff59 : Dash.line;
    property <length> wave-w: root.width * 0.8;
    // 14 bars, as in the mockup.
    property <int> n: 14;
    property <length> step: root.wave-w / root.n;
    for i in root.n: Rectangle {
        property <float> v: root.values.length > 0 ? root.values[floor(i * root.values.length / root.n)] : 0.06;
        x: (root.width - root.wave-w) / 2 + i * root.step + (root.step - self.width) / 2;
        width: root.step * 0.6;
        height: max(2px, root.height * (0.12 + 0.44 * self.v));
        y: (root.height - self.height) / 2;
        border-radius: 0.6px;
        background: (i + 0.5) / root.n <= root.progress ? #ffffff : root.hue;
    }
}
