// The parts every page and every skin is built from: the data rows the app fills in,
// the globals (theme, effects clock, tooltips, the main page's state) and the shared
// widgets. app.slint holds the window itself; ui/skins/ the looks of the main page.

// One line of the model library: a group heading, or a model in that group's card.
export struct ModelRow {
    header: bool,
    title: string,
    by: string,
    // Position in the catalog, for download and use.
    index: int,
    size: string,
    quality: int,
    speed: int,
    downloaded: bool,
    active: bool,
    first: bool,
    last: bool,
    // Which group of the catalog it is in, for skins that colour the groups.
    group: int,
}

export struct WordRow {
    text: string,
    is-silence: bool,
    // A word typed in and spoken in the user's voice; pending while it is generated.
    spoken: bool,
    pending: bool,
    // Generating it failed; editing the phrase tries again.
    failed: bool,
}

export struct OrderRow {
    name: string,
    note: string,
}

// A search result: the clip, its project, the words around the match and where to
// play from.
export struct SearchHit {
    clip: string,
    project: string,
    project-index: int,
    before: string,
    matched: string,
    after: string,
    more: int,
    at: float,
}

// A language in the translate menu. `ready`: it can be made now; `done`: this clip
// has it already; `install`: what is missing (1 a Whisper model, 2 the AI model).
export struct LangRow {
    code: string,
    name: string,
    native: string,
    ready: bool,
    done: bool,
    install: int,
}

// A transcript passage an answer was given from, numbered as the answer cites it.
export struct AskSource {
    n: int,
    clip: string,
    place: int,
    at: float,
    time: string,
    text: string,
}

export struct ClipRow {
    name: string,
    duration: string,
    // "Today 09:14 · transcribed" and the like.
    meta: string,
    // Just when it was made, "Today 09:14", for skins that show the rest their own way.
    when: string,
    has-system: bool,
    transcribed: bool,
    // Peak per column, 0..1, for the small waveform.
    wave: [float],
}

// The one tooltip in the window. A button without text reports here while the mouse
// is over it; the window draws the bubble on top of everything after a short wait.
export global Tips {
    in-out property <string> text;
    // The hovered button, in window coordinates.
    in-out property <Point> at;
    in-out property <length> w;
    in-out property <length> h;
    in-out property <bool> wanted;
    in-out property <bool> shown;
    public function hover(on: bool, text: string, at: Point, w: length, h: length) {
        if (on) {
            self.text = text;
            self.at = at;
            self.w = w;
            self.h = h;
            self.shown = false;
            self.wanted = true;
        } else if (self.text == text) {
            self.wanted = false;
            self.shown = false;
        }
    }
    public function hide() {
        self.wanted = false;
        self.shown = false;
    }
}

export struct Palette {
    bg: color,
    card: color,
    row: color,
    raised: color,
    line: color,
    line-soft: color,
    edge: color,
    text: color,
    text2: color,
    muted: color,
    dim: color,
    accent: color,
    accent-hover: color,
    on-accent: color,
    wave: color,
    wave-dim: color,
    track: color,
    danger: color,
    hover: color,
    hover-soft: color,
    row-hover: color,
    picked: color,
    popup: color,
    popup-edge: color,
    knob: color,
    faint: color,
    fainter: color,
    rec-rest: color,
    divider: color,
    border: color,
    card-edge: color,
    footer: color,
    press: color,
    // Outline of the recorder and toolbar cards; transparent for none.
    card-line: color,
}

