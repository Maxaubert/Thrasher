// The Car Dashboard look of every page but the main one (mockups in
// docs/mockups/device-themes/x-dash-pages/): the clip page is the car's now playing
// screen (the arc gauge as the trip meter, the waveform as the route strip, the
// transcript on the glass centre screen), settings is the vehicle menu, the models are
// the head unit's app store, merging is a route planner, Ask is the voice assistant,
// the widget a pocket instrument cluster, and every question a glass sheet.
//
// Behaviour is shared: the state is in the Pages and Main globals, the actions are
// AppWindow's (reached through the callbacks here), and the shared widgets (the
// transcript card, menus, dropdowns, switches, pills) draw their dash look themselves
// for this skin (`Theme.dash`).

import { ThemeGallery } from "../gallery.slint";
import { Theme, Main, Pages, Tips, Icon, Btn, IconBtn, Toggle, Select, TextField, ShortcutBox, Scroller, OrderList, TranscriptCard, ExportButton, TrimTouch, AskSource } from "../common.slint";
import { Dash, Art, Title } from "dash-parts.slint";

// ---------- Small parts ----------

// Small caps: the names of cards, lists and readouts.
component Caps inherits Text {
    color: Dash.faint;
    font-family: "Manrope";
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 2.3px;
    vertical-alignment: center;
}

// A glass screen: the cards and panels of every page.
component Glass inherits Rectangle {
    background: Dash.glass;
    border-radius: 12px;
    border-width: 1px;
    border-color: Dash.line;
}

// A status lamp: green, ice or red with its glow, or a dark one.
component Lamp inherits Rectangle {
    // 0 dark, 1 ready (green), 2 ice, 3 red, 4 amber (paused, no glow).
    in property <int> kind;
    width: 6px;
    height: 6px;
    Rectangle { visible: root.kind == 0 || root.kind == 4; border-radius: 3px; background: root.kind == 4 ? Dash.warn : #3a424c; }
    Art {
        visible: root.kind >= 1 && root.kind <= 3;
        x: -8px;
        y: -8px;
        width: 22px;
        height: 22px;
        lo: root.kind == 1 ? @image-url("dash/lamp-ok.png") : root.kind == 2 ? @image-url("dash/lamp-pause.png") : @image-url("dash/lamp-rec.png");
        hi: root.kind == 1 ? @image-url("dash/lamp-ok@2x.png") : root.kind == 2 ? @image-url("dash/lamp-pause@2x.png") : @image-url("dash/lamp-rec@2x.png");
    }
}

// A round key with an icon (the spoke button's face), and a word under it if it has
// one: Rename and Delete, back and forward 5 seconds, pause in the widget.
component Key inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> tip: root.label;
    in property <string> caption;
    in property <bool> red;
    in property <bool> enabled: true;
    in property <length> icon-size: root.width * 0.46;
    callback clicked;
    width: 34px;
    height: self.width;
    // Drawn in body, not on the root: a root opacity, visible, shadow or border makes
    // Slint inline the whole widget at every use (docs/device-themes.md, Generated code size).
    // No x, y or size: it fills the root and passes its children's layout constraints on.
    body := Rectangle {
        opacity: root.enabled ? 1 : 0.4;
        Art {
            x: -root.width / 12;
            y: -root.width / 12;
            width: root.width * 42 / 36;
            height: root.width * 42 / 36;
            lo: @image-url("dash/sbtn.png");
            hi: @image-url("dash/sbtn@2x.png");
        }
        Rectangle {
            visible: t.has-hover && root.enabled;
            border-radius: root.width / 2;
            background: t.pressed ? #ffffff08 : #ffffff14;
        }
        Icon {
            y: (parent.height - self.height) / 2 + (t.pressed ? 1px : 0);
            name: root.icon;
            tint: root.red ? #ff8a95 : t.has-hover && root.enabled ? #ffffff : #d7dee6;
            width: root.icon-size;
            height: root.icon-size;
        }
        if root.caption != "": Text {
            x: (parent.width - 60px) / 2;
            y: parent.height + 5px;
            width: 60px;
            text: root.caption;
            color: Dash.faint;
            font-family: "Manrope";
            font-size: 8px;
            font-weight: 800;
            letter-spacing: 0.64px;
            horizontal-alignment: center;
            accessible-role: none;
        }
        @children
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

// The white play key of a transport.
component PlayKey inherits Rectangle {
    in property <bool> playing;
    in property <string> label: root.playing ? "Pause" : "Play";
    callback clicked;
    width: 44px;
    height: self.width;
    border-radius: self.width / 2;
    background: t.pressed ? #d9dfe6 : t.has-hover ? #ffffff : #f2f5f8;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon {
        x: (parent.width - self.width) / 2 + (root.playing ? 0 : 1.5px);
        name: root.playing ? "pause" : "play";
        tint: #0b0d10;
        width: root.width * 0.36;
        height: root.width * 0.36;
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.label, self.absolute-position, self.width, self.height); }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

// A glass chip that can be lit: the model shelves, All projects.
component Chip inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <bool> on;
    // A lamp before the word (All projects).
    in property <bool> lamp;
    in property <length> font-size: 11px;
    callback clicked;
    width: chip-row.preferred-width;
    height: 26px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: root.on ? #62d2ff1f : t.has-hover ? #1f252d : Dash.glass2;
    border-width: 1px;
    border-color: root.on ? #62d2ff80 : Dash.line2;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    chip-row := HorizontalLayout {
        padding-left: root.lamp ? 10px : 11px;
        padding-right: 11px;
        spacing: 6px;
        if root.lamp: VerticalLayout {
            alignment: center;
            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.on ? Dash.ice : #56606c; }
        }
        Text {
            text: root.text;
            color: root.on ? Dash.ice : Dash.text2;
            font-family: "Manrope";
            font-size: root.font-size;
            font-weight: 700;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The header of a page: the round back key, the page's name and a note in a chip.
component PageHead inherits Rectangle {
    in property <string> title;
    in property <string> note;
    callback back();
    height: 50px;
    vertical-stretch: 0;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: bt.has-hover ? #1f252d : Dash.glass2;
                border-width: 1px;
                border-color: Dash.line2;
                accessible-role: button;
                accessible-label: "Back";
                accessible-action-default => { root.back(); }
                Icon { name: "back"; tint: Dash.text2; width: 13px; height: 13px; }
                bt := TouchArea { mouse-cursor: pointer; clicked => { root.back(); } }
            }
        }
        Text {
            text: root.title;
            color: Dash.text;
            font-family: "Manrope";
            font-size: 19px;
            font-weight: 800;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.note != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: note.preferred-width + 18px;
                height: 22px;
                border-radius: 11px;
                background: Dash.glass2;
                border-width: 1px;
                border-color: Dash.line2;
                note := Text {
                    text: root.note;
                    color: Dash.text2;
                    font-family: Theme.mono;
                    font-size: 10.5px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// The latest message, by an ice lamp, in a footer.
component Status inherits HorizontalLayout {
    in property <string> text: Main.status;
    spacing: 9px;
    if root.text != "": VerticalLayout {
        alignment: center;
        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Dash.ice; }
    }
    Text {
        text: root.text;
        color: Dash.text2;
        font-family: "Manrope";
        font-size: 11.5px;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

// The media card along the bottom of a page: dark glass under a line, its contents in
// a row.
component Footer inherits Rectangle {
    height: 52px;
    vertical-stretch: 0;
    background: @linear-gradient(180deg, #101317 0%, #0b0d10 100%);
    Rectangle { y: 0; height: 1px; background: Dash.line; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        @children
    }
}

// A message as a glass pill, floating just above the footer (pages without room for
// the status in their footer).
component Toast inherits Rectangle {
    in property <string> text;
    in property <length> above: 8px;
    height: 0;
    if root.text != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: -root.above - self.height;
        width: min(msg.preferred-width + 38px, parent.width - 32px);
        height: 30px;
        border-radius: 15px;
        background: #1b2027;
        border-width: 1px;
        border-color: #ffffff33;
        Rectangle {
            x: 11px;
            y: (parent.height - self.height) / 2;
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: Dash.ice;
        }
        msg := Text {
            x: 26px;
            width: parent.width - 38px;
            text: root.text;
            color: Dash.text;
            font-family: "Manrope";
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A field in the search well: dark, an ice frame while it has the cursor.
component Field inherits TextField {
    height: 34px;
    radius: 9px;
    fill: Dash.well;
    rest-edge: Dash.line2;
    ink: Dash.text;
    hint: Dash.faint;
    font-size: 12.5px;
    family: root.mono ? Theme.mono : "Manrope";
    side: 12px;
    select-fill: #3a8dff73;
}

// The arc of the gauge on the 200 unit box: the scale is a PNG, the value arc a path to
// a point worked out from `f` (0 to 1), the tip a white dot there. `level` takes the
// main page's scale with its red end (the widget); the rest is the plain one.
component Arc inherits Rectangle {
    in property <float> f;
    in property <bool> level;
    in property <bool> tip: true;
    property <float> u: root.width / 200px;
    property <float> v: clamp(root.f, 0, 1);
    property <angle> end: (135 + 270 * root.v) * 1deg;
    property <float> ex: 100 + 80 * cos(root.end);
    property <float> ey: 100 + 80 * sin(root.end);
    height: self.width;
    Art {
        width: 100%;
        height: 100%;
        lo: root.level ? @image-url("dash/gauge-p.png") : @image-url("dash/gauge-c.png");
        hi: root.level ? @image-url("dash/gauge-p@2x.png") : @image-url("dash/gauge-c@2x.png");
    }
    if root.v > 0.004: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 200;
        viewbox-height: 200;
        stroke: @linear-gradient(45deg, #3a8dff 0%, #62d2ff 70%, #e9fbff 100%);
        stroke-width: 7px * root.u;
        stroke-line-cap: round;
        commands: "M 43.4315 156.5685 A 80 80 0 " + (root.v > 2 / 3 ? "1" : "0") + " 1 " + root.ex + " " + root.ey;
    }
    if root.tip: Rectangle {
        x: root.ex * root.u * 1px - self.width / 2;
        y: root.ey * root.u * 1px - self.height / 2;
        width: max(9px, 15px * root.u);
        height: self.width;
        border-radius: self.width / 2;
        background: #62d2ff80;
        Rectangle {
            width: parent.width * 0.73;
            height: self.width;
            border-radius: self.width / 2;
            background: #b1e9ff;
        }
        Rectangle {
            width: parent.width * 0.47;
            height: self.width;
            border-radius: self.width / 2;
            background: #ffffff;
        }
    }
    @children
}

// ---------- One clip ----------

// The trip meter: the play position on the arc, the state, the time and the length.
// Wide windows label the start and the end of the scale.
component TripMeter inherits Arc {
    in property <bool> big;
    property <bool> active: Main.active-clip == Main.selected;
    property <float> s: root.width / 130px;
    property <string> total: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].duration : "";
    f: root.active ? Main.play-fraction : 0;
    accessible-role: AccessibleRole.text;
    accessible-label: (root.active && Main.playing ? "Playing " : root.active ? "Paused " : "Stopped ") + (root.active ? Main.play-position : "0:00") + " of " + root.total;
    VerticalLayout {
        alignment: center;
        spacing: 1px * root.s;
        HorizontalLayout {
            alignment: center;
            spacing: 5px * root.s;
            VerticalLayout {
                alignment: center;
                Lamp { kind: root.active && Main.playing ? 2 : root.active ? 1 : 0; }
            }
            Text {
                text: root.active && Main.playing ? "PLAYING" : root.active ? "PAUSED" : "STOPPED";
                color: root.active && Main.playing ? Dash.ice : root.active ? Dash.ok : Dash.dim;
                font-family: "Manrope";
                font-size: max(7.5px, 7px * root.s);
                font-weight: 800;
                letter-spacing: 1.8px * root.s;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        Text {
            text: root.active ? Main.play-position : "0:00";
            color: #ffffff;
            font-family: Theme.mono;
            font-size: 22px * root.s;
            font-weight: 300;
            horizontal-alignment: center;
            accessible-role: none;
        }
        Text {
            text: "OF " + root.total;
            color: Dash.faint;
            font-family: "Manrope";
            font-size: max(7px, 6.5px * root.s);
            font-weight: 800;
            letter-spacing: 1.6px * root.s;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }
    if root.big: Text {
        x: root.width * 0.2 - self.width / 2;
        y: root.height * 0.84;
        text: "0:00";
        color: Dash.faint;
        font-family: Theme.mono;
        font-size: 9px;
        accessible-role: none;
    }
    if root.big: Text {
        x: root.width * 0.8 - self.width / 2;
        y: root.height * 0.84;
        text: root.total;
        color: Dash.faint;
        font-family: Theme.mono;
        font-size: 9px;
        accessible-role: none;
    }
}

// The route strip: the clip's waveform in the well, the played part ice, the trimmed
// ends dimmed, the trim handles as ice grips and the play head a white line. TrimTouch
// drags the handles and seeks.
component RouteStrip inherits Rectangle {
    callback trimmed(float, float);
    callback tapped();
    property <bool> active: Main.active-clip == Main.selected;
    property <float> played: root.active ? clamp(Main.play-fraction, 0, 1) : 0;
    property <length> inner-w: root.width - 20px;
    property <length> start-x: Pages.trim-start * root.inner-w;
    property <length> end-x: Pages.trim-end * root.inner-w;
    property <int> n: max(1, floor(root.inner-w / 3.5px));
    border-radius: 10px;
    background: Dash.well;
    border-width: 1px;
    border-color: Dash.line;
    Rectangle {
        x: 10px;
        width: root.inner-w;
        for i in root.n: Rectangle {
            property <float> v: Pages.detail-wave.length > 0 ? Pages.detail-wave[floor(i * Pages.detail-wave.length / root.n)] : 0.06;
            x: i * 3.5px;
            width: 2px;
            height: max(2px, self.v * (root.height - 14px));
            y: (root.height - self.height) / 2;
            border-radius: 1px;
            background: (i + 0.5) / root.n <= root.played ? Dash.ice : #4a5664;
        }
        Rectangle { x: 0; width: root.start-x; background: #0e1115c0; }
        Rectangle { x: root.end-x; width: parent.width - root.end-x; background: #0e1115c0; }
        if root.active: Rectangle {
            x: root.played * (parent.width - 2px);
            width: 2px;
            background: #ffffff;
            Rectangle { x: -2px; y: 2px; width: 6px; height: 6px; border-radius: 3px; background: #ffffff; }
        }
        for k in [0, 1]: Rectangle {
            property <bool> on: k == 0 ? Pages.trim-start > 0.0005 : Pages.trim-end < 0.9995;
            property <bool> hot: touch.grab == k + 1 || (touch.has-hover && abs(touch.at - (k == 0 ? root.start-x : root.end-x)) <= 8px);
            property <bool> lit: self.on || self.hot;
            x: (k == 0 ? root.start-x : root.end-x) - 1.5px;
            width: 3px;
            background: self.lit ? Dash.ice : #56606c;
            Rectangle {
                x: -3px;
                y: (parent.height - self.height) / 2;
                width: 9px;
                height: 20px;
                border-radius: 4.5px;
                background: parent.lit ? Dash.ice : #56606c;
                for g in 3: Rectangle { x: 2.5px; y: 6px + g * 3px; width: 4px; height: 1px; background: #04121c80; }
            }
        }
    }
    touch := TrimTouch {
        pad: 10px;
        trimmed(a, b) => { root.trimmed(a, b); }
        tapped => { root.tapped(); }
    }
}

// The drive mode selector of the playback speed.
component Speed inherits VerticalLayout {
    in property <bool> big;
    callback picked(int);
    spacing: 4px;
    alignment: end;
    Caps { text: "SPEED"; font-size: 8px; letter-spacing: 1.8px; }
    Rectangle {
        width: steps.preferred-width;
        height: root.big ? 32px : 30px;
        border-radius: 8px;
        background: Dash.well;
        border-width: 1px;
        border-color: Dash.line2;
        accessible-role: list;
        accessible-label: "Speed";
        steps := HorizontalLayout {
            padding: 3px;
            spacing: 1px;
            for v[i] in ["0.75", "1.0", "1.25", "1.5", "2.0"]: Rectangle {
                width: root.big ? 28px : 27px;
                border-radius: 6px;
                background: i == Pages.speed-index ? #62d2ff26 : st.has-hover ? #ffffff0a : transparent;
                border-width: i == Pages.speed-index ? 1px : 0;
                border-color: #62d2ff59;
                accessible-role: button;
                accessible-label: v + "×";
                accessible-checked: i == Pages.speed-index;
                accessible-action-default => { Pages.speed-index = i; root.picked(i); }
                Text {
                    text: v;
                    color: i == Pages.speed-index ? Dash.ice : st.has-hover ? Dash.text2 : Dash.faint;
                    font-family: Theme.mono;
                    font-size: root.big ? 10.5px : 9.5px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                st := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Pages.speed-index = i; root.picked(i); }
                }
            }
        }
    }
}

// The wheel's transport: back 5 seconds, play or pause, forward 5 seconds, the speed
// and Loop.
component Transport inherits HorizontalLayout {
    in property <bool> big;
    callback toggle-play();
    callback skip(float);
    callback speed-changed(int);
    callback refocus();
    property <bool> playing: Main.active-clip == Main.selected && Main.playing;
    vertical-stretch: 0;
    spacing: 8px;
    VerticalLayout {
        alignment: end;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Key {
                    width: root.big ? 34px : 32px;
                    icon: "rewind";
                    icon-size: self.width * 0.56;
                    label: "Back 5 seconds";
                    clicked => { root.skip(-5); root.refocus(); }
                    Text {
                        y: (parent.height - self.height) / 2 + 1px;
                        text: "5";
                        color: #d7dee6;
                        font-family: "Manrope";
                        font-size: 7px;
                        font-weight: 800;
                        accessible-role: none;
                    }
                }
            }
            PlayKey {
                width: root.big ? 46px : 42px;
                playing: root.playing;
                clicked => { root.toggle-play(); root.refocus(); }
            }
            VerticalLayout {
                alignment: center;
                Key {
                    width: root.big ? 34px : 32px;
                    icon: "forward";
                    icon-size: self.width * 0.56;
                    label: "Forward 5 seconds";
                    clicked => { root.skip(5); root.refocus(); }
                    Text {
                        y: (parent.height - self.height) / 2 + 1px;
                        text: "5";
                        color: #d7dee6;
                        font-family: "Manrope";
                        font-size: 7px;
                        font-weight: 800;
                        accessible-role: none;
                    }
                }
            }
        }
    }
    Rectangle { width: 2px; }
    Speed {
        big: root.big;
        picked(i) => { root.speed-changed(i); root.refocus(); }
    }
    Rectangle { horizontal-stretch: 1; }
    VerticalLayout {
        alignment: end;
        Btn {
            height: root.big ? 32px : 30px;
            font-size: 12px;
            text: "Loop";
            on: Pages.looping;
            clicked => { Pages.looping = !Pages.looping; root.refocus(); }
        }
    }
}

// The clip's name and when, where and how it was made.
component ClipName inherits VerticalLayout {
    in property <bool> big;
    property <string> name: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].name : "";
    spacing: 2px;
    alignment: center;
    Text {
        text: root.name;
        color: Dash.text;
        font-family: "Manrope";
        font-size: root.big ? 19px : 18px;
        font-weight: 800;
        overflow: elide;
    }
    Text {
        text: Pages.detail-meta;
        color: Dash.dim;
        font-family: "Manrope";
        font-size: 10.5px;
        font-weight: 500;
        overflow: elide;
    }
}

// Rename and Delete, the spoke keys beside the name.
component ClipKeys inherits HorizontalLayout {
    callback rename();
    callback delete();
    spacing: 14px;
    padding-bottom: 16px;
    alignment: start;
    Key {
        width: 32px;
        icon: "pencil";
        icon-size: 13px;
        caption: "RENAME";
        label: "Rename clip";
        tip: "Rename";
        enabled: !Main.recording;
        clicked => { root.rename(); }
    }
    Key {
        width: 32px;
        icon: "trash";
        icon-size: 14px;
        red: true;
        caption: "DELETE";
        label: "Delete clip";
        tip: "Delete";
        enabled: !Main.recording;
        clicked => { root.delete(); }
    }
}

// Renaming the clip in the cluster: its name in the field, Cancel and Rename under it.
component RenameField inherits VerticalLayout {
    callback rename(string);
    callback cancel();
    spacing: 8px;
    alignment: center;
    field := Field {
        height: 32px;
        font-size: 13px;
        label: "Clip name";
        text: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].name : "";
        init => { self.grab(); }
        accepted(t) => { root.rename(t); }
        escaped => { root.cancel(); }
        takes-escape: true;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 6px;
        Btn { height: 26px; font-size: 11px; text: "Cancel"; clicked => { root.cancel(); } }
        Btn { height: 26px; font-size: 11px; primary: true; text: "Rename"; clicked => { root.rename(field.text); } }
    }
}

// Clean voice on export, the one option of a clip.
component CleanVoice inherits HorizontalLayout {
    callback changed-to(bool);
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        Toggle {
            label: "Clean voice on export";
            checked <=> Pages.clean-voice;
            toggled(on) => { root.changed-to(on); }
        }
    }
    Text {
        text: "Clean voice on export";
        color: Dash.text;
        font-family: "Manrope";
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: "Less noise";
        color: Dash.faint;
        font-family: "Manrope";
        font-size: 10.5px;
        font-weight: 500;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
}

// A merged clip's parts, as stops on a route that can be put in another order.
component Parts inherits VerticalLayout {
    callback moved(int, int);
    callback take-out(int);
    callback rename(int);
    spacing: 4px;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        height: 18px;
        Caps { text: "PARTS"; horizontal-stretch: 1; }
        if Pages.parts-busy: Caps { text: "WORKING"; color: Dash.warn; }
    }
    OrderList {
        rows: Pages.parts;
        menu: true;
        enabled: !Pages.parts-busy && !Main.recording;
        moved(a, b) => { root.moved(a, b); }
        act(i) => { root.take-out(i); }
        rename(i) => { root.rename(i); }
    }
}

// The footer of the clip page: the export running (its name and a bar) or the latest
// message, and the Export pill.
component ClipFooter inherits Footer {
    callback refocus();
    if Main.export-state == 1: HorizontalLayout {
        horizontal-stretch: 1;
        spacing: 10px;
        VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Dash.ice; } }
        Text {
            text: "Exporting " + Main.export-name;
            color: Dash.text2;
            font-family: "Manrope";
            font-size: 11.5px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            max-width: 220px;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 4px;
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: Dash.track;
            Rectangle {
                x: 0;
                width: parent.width * clamp(Main.export-progress, 0, 1);
                border-radius: 2px;
                background: Dash.ice;
            }
        }
    }
    if Main.export-state != 1: Status { horizontal-stretch: 1; }
    VerticalLayout {
        alignment: center;
        ExportButton {
            width: 116px;
            height: 34px;
            format: Pages.export-format;
            subtitles: Pages.transcript != "";
            state: Main.export-state;
            progress: Main.export-progress;
            export(kind) => { Main.export-as(kind); root.refocus(); }
        }
    }
}

// The clip's cover tile in the wide cluster: its waveform in ice.
component Cover inherits Rectangle {
    property <[float]> values: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].wave : [];
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: #62d2ff14;
    border-width: 1px;
    border-color: Dash.line2;
    for i in 12: Rectangle {
        property <float> v: root.values.length > 0 ? root.values[floor(i * root.values.length / 12)] : 0.06;
        x: 7px + i * 2.6px;
        width: 1.6px;
        height: max(2px, root.height * (0.1 + 0.4 * self.v));
        y: (root.height - self.height) / 2;
        border-radius: 0.8px;
        background: Dash.ice;
    }
}

// The one-clip page. Portrait: the cluster (the trip meter beside the name and the
// keys), the route strip, the transport, the transcript on the centre screen, the
// option and the footer. Wide: the cluster on the left, the transcript on the right.
export component ClipPage inherits VerticalLayout {
    in property <bool> narrow;
    in property <bool> wide;
    callback go(int);
    callback refocus();
    // Leaving the editor asks about unsaved changes first (AppWindow.leave-editor).
    callback leave-editor(int);
    callback start-edit();
    callback ask-delete(int);
    callback rename-selected(string);
    callback toggle-play();
    callback skip(float);
    callback speed-changed(int);
    callback trim-changed(float, float);
    callback clean-voice-changed(bool);
    callback parts-move(int, int);
    callback part-take-out(int);
    callback rename-part(int);
    // The transcript card's actions (see TranscriptCard).
    callback choose-lang(string);
    callback lang-filter(string);
    callback install-for(int);
    callback summarise();
    callback edit-changed(string);
    callback apply-transcript(string);
    callback transcribe();
    callback seek-word(int);
    pure callback edit-markup(string) -> styled-text;
    pure callback plain-selection(string, int, int) -> string;

    property <string> name: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].name : "";

    function rename(t: string) {
        Pages.renaming = false;
        root.rename-selected(t);
        root.refocus();
    }

    Title {
        wide: root.wide;
        mode: "PLAY";
        back-text: "CLIPS";
        back-label: "Back to Clips";
        back => { if (Pages.editing) { root.leave-editor(0); } else { root.go(0); } }
    }

    // Portrait.
    if !root.wide: Rectangle {
        vertical-stretch: 0;
        height: deck.preferred-height;
        background: @linear-gradient(180deg, #12171d 0%, #0c0e11 100%);
        deck := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 8px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 14px;
                TripMeter {
                    width: clamp(124px + (root.width - 420px) * 0.1, 124px, 150px);
                }
                if !Pages.renaming: VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 10px;
                    ClipName { }
                    ClipKeys {
                        rename => { Pages.renaming = true; }
                        delete => { root.ask-delete(Main.selected); }
                    }
                }
                if Pages.renaming: RenameField {
                    horizontal-stretch: 1;
                    rename(t) => { root.rename(t); }
                    cancel => { Pages.renaming = false; root.refocus(); }
                }
            }
            RouteStrip {
                height: 44px;
                trimmed(a, b) => { root.trim-changed(a, b); }
                tapped => { root.refocus(); }
            }
            Transport {
                toggle-play => { root.toggle-play(); }
                skip(s) => { root.skip(s); }
                speed-changed(i) => { root.speed-changed(i); }
                refocus => { root.refocus(); }
            }
        }
    }
    if !root.wide && Pages.parts.length >= 2: VerticalLayout {
        vertical-stretch: 0;
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 2px;
        Parts {
            moved(a, b) => { root.parts-move(a, b); }
            take-out(i) => { root.part-take-out(i); }
            rename(i) => { root.rename-part(i); }
        }
    }
    if !root.wide: VerticalLayout {
        vertical-stretch: 1;
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 10px;
        TranscriptCard {
            vertical-stretch: 1;
            clip-name: root.name;
            transcript: Pages.transcript;
            transcribing: Pages.transcribing;
            translating: Pages.translating;
            translation: Pages.translation;
            shown-lang <=> Pages.shown-lang;
            langs: Pages.langs;
            choose-lang(c) => { root.choose-lang(c); }
            lang-filter(t) => { root.lang-filter(t); }
            install-for(k) => { root.install-for(k); }
            summary: Pages.summary;
            summarising: Pages.summarising;
            can-ai: Main.can-ai;
            show-summary <=> Pages.show-summary;
            summarise => { root.summarise(); }
            transcribe-progress: Pages.transcribe-progress;
            words: Pages.words;
            current-word: Pages.current-word;
            show-marks <=> Pages.show-marks;
            can-transcribe: Pages.can-transcribe;
            recording: Main.recording;
            editing: Pages.editing;
            edit-draft <=> Pages.edit-draft;
            edit-badge: Pages.edit-badge;
            speaking: Pages.speaking;
            edit => { root.start-edit(); }
            edited(t) => { root.edit-changed(t); }
            cancel => { root.leave-editor(-1); }
            save => { root.apply-transcript(Pages.edit-draft); }
            edit-markup(t) => { return root.edit-markup(t); }
            plain-selection(t, a, b) => { return root.plain-selection(t, a, b); }
            transcribe => { root.transcribe(); root.refocus(); }
            seek-word(i) => { root.seek-word(i); root.refocus(); }
        }
    }
    if !root.wide: Rectangle {
        vertical-stretch: 0;
        height: 40px;
        Rectangle { y: 0; height: 1px; background: Dash.line; }
        CleanVoice {
            x: 14px;
            width: parent.width - 28px;
            changed-to(on) => { root.clean-voice-changed(on); }
        }
    }

    // Wide.
    if root.wide: HorizontalLayout {
        vertical-stretch: 1;
        Rectangle {
            width: 420px;
            background: @linear-gradient(180deg, #12171d 0%, #0c0e11 100%);
            Rectangle { x: parent.width - 1px; width: 1px; background: Dash.line; }
            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 14px;
                padding-bottom: 12px;
                spacing: 10px;
                HorizontalLayout {
                    alignment: center;
                    vertical-stretch: 0;
                    TripMeter {
                        big: true;
                        width: clamp(root.height - 470px, 150px, 210px);
                    }
                }
                if !Pages.renaming: HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 12px;
                    VerticalLayout { alignment: center; padding-bottom: 14px; Cover { } }
                    ClipName { big: true; horizontal-stretch: 1; padding-bottom: 14px; }
                    VerticalLayout {
                        alignment: center;
                        ClipKeys {
                            spacing: 12px;
                            rename => { Pages.renaming = true; }
                            delete => { root.ask-delete(Main.selected); }
                        }
                    }
                }
                if Pages.renaming: RenameField {
                    vertical-stretch: 0;
                    rename(t) => { root.rename(t); }
                    cancel => { Pages.renaming = false; root.refocus(); }
                }
                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 5px;
                    RouteStrip {
                        height: 60px;
                        trimmed(a, b) => { root.trim-changed(a, b); }
                        tapped => { root.refocus(); }
                    }
                    HorizontalLayout {
                        Text {
                            text: Main.active-clip == Main.selected ? Main.play-position : "0:00";
                            color: Dash.dim;
                            font-family: Theme.mono;
                            font-size: 10.5px;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: Main.selected >= 0 && Main.selected < Main.clips.length ? Main.clips[Main.selected].duration : "";
                            color: Dash.dim;
                            font-family: Theme.mono;
                            font-size: 10.5px;
                        }
                    }
                }
                Transport {
                    big: true;
                    toggle-play => { root.toggle-play(); }
                    skip(s) => { root.skip(s); }
                    speed-changed(i) => { root.speed-changed(i); }
                    refocus => { root.refocus(); }
                }
                Rectangle { min-height: 0; vertical-stretch: 1; }
                Rectangle { height: 1px; vertical-stretch: 0; background: Dash.line; }
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 14px;
                    Caps { text: "OPTIONS"; }
                    CleanVoice {
                        horizontal-stretch: 1;
                        changed-to(on) => { root.clean-voice-changed(on); }
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 14px;
            padding-bottom: 12px;
            spacing: 10px;
            if Pages.parts.length >= 2: Parts {
                moved(a, b) => { root.parts-move(a, b); }
                take-out(i) => { root.part-take-out(i); }
                rename(i) => { root.rename-part(i); }
            }
            TranscriptCard {
                vertical-stretch: 1;
                clip-name: root.name;
                transcript: Pages.transcript;
                transcribing: Pages.transcribing;
                translating: Pages.translating;
                translation: Pages.translation;
                shown-lang <=> Pages.shown-lang;
                langs: Pages.langs;
                choose-lang(c) => { root.choose-lang(c); }
                lang-filter(t) => { root.lang-filter(t); }
                install-for(k) => { root.install-for(k); }
                summary: Pages.summary;
                summarising: Pages.summarising;
                can-ai: Main.can-ai;
                show-summary <=> Pages.show-summary;
                summarise => { root.summarise(); }
                transcribe-progress: Pages.transcribe-progress;
                words: Pages.words;
                current-word: Pages.current-word;
                show-marks <=> Pages.show-marks;
                can-transcribe: Pages.can-transcribe;
                recording: Main.recording;
                editing: Pages.editing;
                edit-draft <=> Pages.edit-draft;
                edit-badge: Pages.edit-badge;
                speaking: Pages.speaking;
                edit => { root.start-edit(); }
                edited(t) => { root.edit-changed(t); }
                cancel => { root.leave-editor(-1); }
                save => { root.apply-transcript(Pages.edit-draft); }
                edit-markup(t) => { return root.edit-markup(t); }
                plain-selection(t, a, b) => { return root.plain-selection(t, a, b); }
                transcribe => { root.transcribe(); root.refocus(); }
                seek-word(i) => { root.seek-word(i); root.refocus(); }
            }
        }
    }

    ClipFooter { refocus => { root.refocus(); } }
}

// ---------- Settings ----------

// A card of the vehicle menu: a glass tile headed by an ice icon tile and its name.
component Card inherits Rectangle {
    in property <string> title;
    in property <string> icon;
    background: Dash.glass;
    border-radius: 12px;
    border-width: 1px;
    border-color: Dash.line;
    height: unit.preferred-height;
    unit := VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 6px;
        spacing: 2px;
        HorizontalLayout {
            height: 26px;
            spacing: 9px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    Art { width: 20px; height: 20px; lo: @image-url("dash/ctile.png"); hi: @image-url("dash/ctile@2x.png"); }
                    Icon { name: root.icon; tint: Dash.ink; width: 12px; height: 12px; }
                }
            }
            Caps {
                text: root.title;
                color: Dash.dim;
                letter-spacing: 2.6px;
                horizontal-stretch: 1;
            }
        }
        Rectangle { height: 4px; }
        @children
    }
}

// One line of a card: its name (and a note in small type) and its controls.
component SRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <bool> first;
    min-height: 36px;
    if !root.first: Rectangle { y: 0; height: 1px; background: Dash.line; }
    HorizontalLayout {
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Dash.text;
                font-family: "Manrope";
                font-size: 12.5px;
                font-weight: 700;
                overflow: elide;
            }
            if root.note != "": Text {
                text: root.note;
                color: Dash.faint;
                font-family: "Manrope";
                font-size: 10px;
                font-weight: 500;
                overflow: elide;
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            @children
        }
    }
}

// A value on the right of a row: OmniVoice, Downloading 64%.
component Value inherits Text {
    color: Dash.dim;
    font-family: "Manrope";
    font-size: 11.5px;
    font-weight: 700;
    vertical-alignment: center;
}

// The dropdown of a row, as wide as its choice needs.
component RowSelect inherits Select {
    width: min(self.natural, 220px);
    height: 28px;
}

export component SettingsPage inherits VerticalLayout {
    in property <bool> wide;
    callback back();
    callback go(int);
    callback refocus();
    callback theme-changed(int);
    callback mic-changed(int);
    callback system-changed(bool);
    callback recording-limit-changed(int);
    callback hotkey-captured(string, bool, bool, bool, bool) -> bool;
    callback hotkey-accepted(string);
    callback open-folder();
    callback change-folder();
    callback template-edited(string);
    callback template-accepted(string);
    callback export-format-changed(int);
    callback clean-voice-changed(bool);
    callback language-changed(int);
    callback auto-transcribe-changed(bool);
    callback ai-names-changed(bool);
    callback max-pause-changed(int);
    callback ai-model-changed(int);
    callback download-ai(int);
    callback close-to-tray-changed(bool);
    callback start-with-windows-changed(bool);

    Title { wide: root.wide; mode: "SETUP"; }
    PageHead { title: "Settings"; back => { root.back(); } }
    Scroller {
        vertical-stretch: 1;
        VerticalLayout {
            padding-left: 12px;
            padding-right: root.wide ? 12px : 16px;
            padding-top: 4px;
            padding-bottom: 16px;
            alignment: start;
            // Wide: the gallery on the left like the driver display, the cards in two
            // columns beside it. Portrait: one column.
            FlexboxLayout {
                flex-direction: root.wide ? FlexboxLayoutDirection.row : FlexboxLayoutDirection.column;
                flex-wrap: no-wrap;
                alignment: stretch;
                cross-axis-alignment: root.wide ? CrossAxisAlignment.start : CrossAxisAlignment.stretch;
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    Card {
                        title: "APPEARANCE";
                        icon: "sparkles";
                        VerticalLayout {
                            padding-bottom: 6px;
                            ThemeGallery { picked(i) => { root.theme-changed(i); } }
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    Card {
                        title: "RECORDING";
                        icon: "mic";
                        SRow {
                            first: true;
                            label: "Microphone";
                            VerticalLayout {
                                alignment: center;
                                RowSelect {
                                    label: "Microphone";
                                    model: Pages.mic-devices;
                                    current-index <=> Pages.mic-index;
                                    enabled: !Main.recording;
                                    selected(i) => { root.mic-changed(i); }
                                }
                            }
                        }
                        SRow {
                            label: "System audio";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "System audio";
                                    checked <=> Pages.record-system;
                                    toggled(on) => { root.system-changed(on); }
                                }
                            }
                        }
                        SRow {
                            label: "Stop recording after";
                            VerticalLayout {
                                alignment: center;
                                RowSelect {
                                    label: "Stop recording after";
                                    model: Pages.recording-limits;
                                    current-index <=> Pages.recording-limit-index;
                                    selected(i) => { root.recording-limit-changed(i); }
                                }
                            }
                        }
                        SRow {
                            label: "Record hotkey";
                            VerticalLayout {
                                alignment: center;
                                ShortcutBox {
                                    label: "Record hotkey";
                                    keys: Pages.hotkey-parts;
                                    captured(text, ctrl, alt, shift, meta) => { return root.hotkey-captured(text, ctrl, alt, shift, meta); }
                                    cleared => { root.hotkey-accepted(""); }
                                    done => { root.refocus(); }
                                }
                            }
                            if Pages.hotkey-parts.length > 0: VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 24px;
                                    round: true;
                                    outlined: true;
                                    icon: "close";
                                    icon-size: 9px;
                                    label: "Clear the shortcut";
                                    tip: "Clear shortcut";
                                    clicked => { root.hotkey-accepted(""); }
                                }
                            }
                        }
                    }
                    Card {
                        title: "FILES";
                        icon: "folder";
                        SRow {
                            first: true;
                            label: "Folder";
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: min(path.preferred-width + 20px, 150px);
                                    height: 26px;
                                    border-radius: 7px;
                                    background: Dash.well;
                                    border-width: 1px;
                                    border-color: Dash.line;
                                    path := Text {
                                        x: 9px;
                                        width: parent.width - 18px;
                                        text: Pages.folder;
                                        color: Dash.text2;
                                        font-family: Theme.mono;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 26px;
                                    outlined: true;
                                    icon: "folder";
                                    label: "Open the folder";
                                    tip: "Open folder";
                                    clicked => { root.open-folder(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn { text: "Change"; height: 26px; font-size: 11px; enabled: !Main.recording; clicked => { root.change-folder(); } }
                            }
                        }
                        Rectangle {
                            height: names.preferred-height;
                            Rectangle { y: 0; height: 1px; background: Dash.line; }
                            names := VerticalLayout {
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 6px;
                                Text {
                                    text: "File name";
                                    color: Dash.text;
                                    font-family: "Manrope";
                                    font-size: 12.5px;
                                    font-weight: 700;
                                }
                                Field {
                                    height: 32px;
                                    mono: true;
                                    font-size: 12px;
                                    label: "File name";
                                    text: Pages.name-template;
                                    invalid: Pages.name-invalid;
                                    edited(t) => { root.template-edited(t); }
                                    accepted(t) => { root.template-accepted(t); root.refocus(); }
                                }
                                Text {
                                    text: Pages.name-preview;
                                    color: Pages.name-invalid ? #ff6b78 : Dash.faint;
                                    font-family: Pages.name-invalid ? "Manrope" : Theme.mono;
                                    font-size: 10.5px;
                                    font-weight: Pages.name-invalid ? 700 : 400;
                                    overflow: elide;
                                }
                            }
                        }
                        SRow {
                            label: "Export format";
                            VerticalLayout {
                                alignment: center;
                                RowSelect {
                                    label: "Export format";
                                    model: ["FLAC", "WAV", "MP3"];
                                    current-index <=> Pages.export-format;
                                    selected(i) => { root.export-format-changed(i); }
                                }
                            }
                        }
                        SRow {
                            label: "Clean voice on export";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Clean voice on export";
                                    checked <=> Pages.clean-voice;
                                    toggled(on) => { root.clean-voice-changed(on); }
                                }
                            }
                        }
                    }
                    Card {
                        title: "WINDOW";
                        icon: "widget";
                        SRow {
                            first: true;
                            label: "Close button hides to tray";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Close button hides to tray";
                                    checked <=> Pages.close-to-tray;
                                    toggled(on) => { root.close-to-tray-changed(on); }
                                }
                            }
                        }
                        SRow {
                            label: "Start with Windows";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Start with Windows";
                                    checked <=> Pages.start-with-windows;
                                    toggled(on) => { root.start-with-windows-changed(on); }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    Card {
                        title: "TRANSCRIPTION";
                        icon: "message";
                        if !Pages.can-transcribe: SRow { first: true; label: "Not in this build"; }
                        if Pages.can-transcribe: SRow {
                            first: true;
                            label: "Language";
                            VerticalLayout {
                                alignment: center;
                                RowSelect {
                                    label: "Language";
                                    model: Pages.languages;
                                    current-index <=> Pages.language-index;
                                    selected(i) => { root.language-changed(i); }
                                }
                            }
                        }
                        if Pages.can-transcribe: SRow {
                            label: "Auto transcribe";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "Auto transcribe";
                                    checked <=> Pages.auto-transcribe;
                                    toggled(on) => { root.auto-transcribe-changed(on); }
                                }
                            }
                        }
                        if Pages.can-transcribe && Main.can-ai: SRow {
                            label: "AI names";
                            note: Pages.auto-transcribe ? "" : "Auto transcribe off";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: "AI names";
                                    enabled: Pages.auto-transcribe;
                                    checked <=> Pages.ai-names;
                                    toggled(on) => { root.ai-names-changed(on); }
                                }
                            }
                        }
                        if Pages.can-transcribe: SRow {
                            label: "Max pause";
                            VerticalLayout {
                                alignment: center;
                                RowSelect {
                                    label: "Max pause";
                                    model: Pages.max-pauses;
                                    current-index <=> Pages.max-pause-index;
                                    selected(i) => { root.max-pause-changed(i); }
                                }
                            }
                        }
                        if Pages.can-transcribe: Rectangle {
                            height: model-row.preferred-height;
                            accessible-role: button;
                            accessible-label: "Browse models";
                            accessible-action-default => { root.go(4); }
                            model-touch := TouchArea { mouse-cursor: pointer; clicked => { root.go(4); } }
                            model-row := SRow {
                                width: 100%;
                                label: "Model";
                                note: Pages.model-summary;
                                Text {
                                    text: "Browse";
                                    color: model-touch.has-hover ? #8adfff : Dash.ice;
                                    font-family: "Manrope";
                                    font-size: 11.5px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                                Icon { name: "chevron"; tint: Dash.ice; width: 11px; height: 11px; y: (parent.height - self.height) / 2; }
                            }
                        }
                    }
                    if Main.can-ai: Card {
                        title: "AI";
                        icon: "sparkles";
                        SRow {
                            first: true;
                            label: "Model";
                            VerticalLayout {
                                alignment: center;
                                RowSelect {
                                    label: "AI model";
                                    model: Pages.ai-models;
                                    current-index <=> Pages.ai-model-index;
                                    selected(i) => { root.ai-model-changed(i); }
                                }
                            }
                        }
                        SRow {
                            label: Pages.ai-ready ? "Ready" : Pages.ai-download >= 0 ? "Downloading " + round(Pages.ai-download * 100) + "%" : "Not downloaded";
                            if Pages.ai-ready: VerticalLayout {
                                alignment: center;
                                Lamp { kind: 1; }
                            }
                            if !Pages.ai-ready && Pages.ai-download >= 0: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 90px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Dash.track;
                                    Rectangle { x: 0; width: parent.width * clamp(Pages.ai-download, 0, 1); border-radius: 2px; background: Dash.ice; }
                                }
                            }
                            if !Pages.ai-ready && Pages.ai-download < 0: VerticalLayout {
                                alignment: center;
                                Btn { text: "Download"; height: 26px; font-size: 11px; clicked => { root.download-ai(0); } }
                            }
                        }
                        SRow {
                            label: "Translation";
                            note: "Ministral 3B · 2.1 GB";
                            if Pages.translator-ready: Value { text: "Ready"; color: Dash.ice; }
                            if !Pages.translator-ready && Pages.translator-download >= 0: Value {
                                text: "Downloading " + round(Pages.translator-download * 100) + "%";
                                color: Dash.ice;
                            }
                            if !Pages.translator-ready && Pages.translator-download < 0: VerticalLayout {
                                alignment: center;
                                Btn { text: "Download"; height: 26px; font-size: 11px; clicked => { root.download-ai(1); } }
                            }
                        }
                    }
                    Card {
                        title: "YOUR VOICE";
                        icon: "mic";
                        SRow {
                            first: true;
                            label: "Voice engine";
                            Value { text: "OmniVoice"; }
                        }
                        SRow {
                            label: "Voice sample";
                            Value { text: "20 s from the clip"; }
                        }
                    }
                }
            }
        }
    }
    // The latest message along the bottom.
    Rectangle {
        height: 34px;
        vertical-stretch: 0;
        background: #0b0d10;
        Rectangle { y: 0; height: 1px; background: Dash.line; }
        Status {
            x: 16px;
            width: parent.width - 32px;
        }
    }
}

// ---------- Models ----------

// Quality or speed as five signal bars.
component Bars inherits HorizontalLayout {
    in property <string> label;
    in property <int> value;
    spacing: 5px;
    Text {
        text: root.label;
        color: Dash.faint;
        font-family: "Manrope";
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 1.2px;
        vertical-alignment: center;
    }
    HorizontalLayout {
        spacing: 1.5px;
        alignment: start;
        for k in 5: Rectangle {
            width: 2.5px;
            height: 3px + k * 1.6px;
            y: (parent.height - 9.4px) / 2 + (9.4px - self.height);
            border-radius: 0.6px;
            background: k < root.value ? Dash.ice : #2e3842;
        }
    }
}

// The shelves of the store as glass chips, in a row (portrait).
component ShelfChips inherits HorizontalLayout {
    callback changed();
    spacing: 5px;
    alignment: start;
    for f[i] in ["All", "Norwegian", "Swedish", "English", "Downloaded"]: Chip {
        text: f;
        on: Pages.model-filter == i;
        clicked => { Pages.model-filter = i; root.changed(); }
    }
}

// The shelves as a list (wide), the current one framed in ice.
component ShelfList inherits VerticalLayout {
    callback changed();
    spacing: 2px;
    for f[i] in ["All", "Norwegian", "Swedish", "English", "Downloaded"]: Rectangle {
        height: 32px;
        border-radius: 8px;
        background: Pages.model-filter == i ? #3a8dff24 : st.has-hover ? #ffffff08 : transparent;
        border-width: Pages.model-filter == i ? 1px : 0;
        border-color: #62d2ff59;
        accessible-role: button;
        accessible-label: f;
        accessible-checked: Pages.model-filter == i;
        accessible-action-default => { Pages.model-filter = i; root.changed(); }
        if Pages.model-filter == i: Rectangle { x: 8px; y: 9px; width: 3px; height: parent.height - 18px; border-radius: 1.5px; background: Dash.ice; }
        Text {
            x: 18px;
            text: f;
            color: Pages.model-filter == i ? Dash.text : Dash.dim;
            font-family: "Manrope";
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
            height: parent.height;
            accessible-role: none;
        }
        st := TouchArea {
            mouse-cursor: pointer;
            clicked => { Pages.model-filter = i; root.changed(); }
        }
    }
}

component ModelSearch inherits Field {
    height: 32px;
    icon: "search";
    label: "Search models";
    placeholder: "Search " + Pages.model-count + " models";
}

component Compressed inherits HorizontalLayout {
    callback changed();
    spacing: 9px;
    VerticalLayout {
        alignment: center;
        Toggle {
            label: "Show compressed versions too";
            checked <=> Pages.model-compressed;
            toggled => { root.changed(); }
        }
    }
    Text {
        text: "Show compressed";
        color: Dash.text;
        font-family: "Manrope";
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

export component ModelsPage inherits VerticalLayout {
    in property <bool> wide;
    callback back();
    callback filter-changed();
    callback use-model(int);
    callback cancel-download();
    callback download-model(int);
    Title { wide: root.wide; mode: "MODEL"; mode2: "STORE"; }
    PageHead { title: "Models"; note: root.wide ? "" : Pages.models-used; back => { root.back(); } }
    if !root.wide: VerticalLayout {
        vertical-stretch: 0;
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 6px;
        spacing: 9px;
        ModelSearch { text <=> Pages.model-query; edited => { root.filter-changed(); } }
        ShelfChips { changed => { root.filter-changed(); } }
        Compressed { changed => { root.filter-changed(); } }
    }
    HorizontalLayout {
        vertical-stretch: 1;
        if root.wide: Rectangle {
            width: 280px;
            background: @linear-gradient(180deg, #12171d 0%, #0c0e11 100%);
            Rectangle { x: parent.width - 1px; width: 1px; background: Dash.line; }
            VerticalLayout {
                padding: 14px;
                padding-top: 12px;
                spacing: 12px;
                ModelSearch { text <=> Pages.model-query; edited => { root.filter-changed(); } }
                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 6px;
                    Caps { text: "SHELF"; }
                    ShelfList { changed => { root.filter-changed(); } }
                }
                Compressed { changed => { root.filter-changed(); } }
                Rectangle { vertical-stretch: 1; }
                Rectangle { height: 1px; background: Dash.line; }
                VerticalLayout {
                    spacing: 2px;
                    Caps { text: "DISK"; }
                    Text {
                        text: Pages.models-used.to-uppercase();
                        color: Dash.text;
                        font-family: Theme.mono;
                        font-size: 20px;
                        font-weight: 300;
                        overflow: elide;
                    }
                }
            }
        }
        Scroller {
            horizontal-stretch: 1;
            VerticalLayout {
                alignment: start;
                padding-left: 12px;
                padding-right: root.wide ? 16px : 14px;
                padding-top: 2px;
                padding-bottom: 12px;
                spacing: 6px;
                for m in Pages.models: VerticalLayout {
                    if m.header: HorizontalLayout {
                        padding-top: 8px;
                        padding-bottom: 0;
                        padding-left: 2px;
                        spacing: 10px;
                        Caps { text: m.title.to-uppercase(); color: Dash.ice; horizontal-stretch: 0; }
                        Text {
                            text: m.by;
                            color: Dash.faint;
                            font-family: "Manrope";
                            font-size: 10px;
                            font-weight: 500;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    if !m.header: Rectangle {
                        height: card.preferred-height;
                        border-radius: 10px;
                        background: m.active ? #3a8dff1c : Dash.glass;
                        border-width: 1px;
                        border-color: m.active ? #62d2ff66 : Dash.line;
                        card := VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 3px;
                                    Text {
                                        text: m.title;
                                        color: Dash.text;
                                        font-family: "Manrope";
                                        font-size: 12.5px;
                                        font-weight: 800;
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        Bars { label: "QUALITY"; value: m.quality; }
                                        Bars { label: "SPEED"; value: m.speed; }
                                        Text { text: m.size; color: Dash.dim; font-family: Theme.mono; font-size: 10px; vertical-alignment: center; }
                                    }
                                }
                                if m.active: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: inuse.preferred-width + 28px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #62d2ff14;
                                        border-width: 1px;
                                        border-color: Dash.ice;
                                        Rectangle {
                                            x: 10px;
                                            y: (parent.height - self.height) / 2;
                                            width: 5px;
                                            height: 5px;
                                            border-radius: 2.5px;
                                            background: Dash.ice;
                                        }
                                        inuse := Text {
                                            x: 20px;
                                            y: (parent.height - self.height) / 2;
                                            text: "In use";
                                            color: Dash.ice;
                                            font-family: "Manrope";
                                            font-size: 11px;
                                            font-weight: 800;
                                        }
                                    }
                                }
                                if m.downloaded && !m.active: VerticalLayout {
                                    alignment: center;
                                    Btn { text: "Use"; height: 26px; font-size: 11px; clicked => { root.use-model(m.index); } }
                                }
                                if Pages.downloading == m.index: VerticalLayout {
                                    alignment: center;
                                    Btn { text: "Cancel"; height: 26px; font-size: 11px; clicked => { root.cancel-download(); } }
                                }
                                if !m.downloaded && Pages.downloading != m.index: VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        text: "Download";
                                        height: 26px;
                                        font-size: 11px;
                                        enabled: Pages.downloading < 0;
                                        accessible-label: "Download " + m.title;
                                        clicked => { root.download-model(m.index); }
                                    }
                                }
                            }
                            if Pages.downloading == m.index: HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 4px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 2px;
                                    background: Dash.track;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * clamp(Pages.download-progress, 0, 1);
                                        border-radius: 2px;
                                        background: Dash.ice;
                                    }
                                }
                                Text {
                                    text: round(Pages.download-progress * 100) + "%";
                                    color: Dash.ice;
                                    font-family: Theme.mono;
                                    font-size: 10px;
                                    font-weight: 700;
                                    width: 32px;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }
                if Pages.models.length == 0: VerticalLayout {
                    padding-top: 50px;
                    spacing: 10px;
                    HorizontalLayout { alignment: center; Icon { name: "search"; tint: Dash.faint; width: 24px; height: 24px; } }
                    Text {
                        text: "No models match";
                        color: Dash.dim;
                        font-family: "Manrope";
                        font-size: 13px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
    Toast { text: Main.status; above: 10px; }
}

// ---------- Merge ----------

// The route total on the gauge: the merged length, every stop as a leg of colour along
// a bar under it.
component Route inherits VerticalLayout {
    spacing: 12px;
    HorizontalLayout {
        alignment: center;
        Arc {
            width: 200px;
            f: Pages.merge-rows.length > 0 ? 1 : 0;
            accessible-role: AccessibleRole.text;
            accessible-label: "Total " + Pages.merge-total;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    alignment: center;
                    spacing: 5px;
                    VerticalLayout { alignment: center; Lamp { kind: 2; } }
                    Text {
                        text: "ROUTE";
                        color: Dash.ice;
                        font-family: "Manrope";
                        font-size: 9px;
                        font-weight: 800;
                        letter-spacing: 2.2px;
                        accessible-role: none;
                    }
                }
                Text {
                    text: Pages.merge-total;
                    color: #ffffff;
                    font-family: Theme.mono;
                    font-size: 34px;
                    font-weight: 300;
                    horizontal-alignment: center;
                    accessible-role: none;
                }
                Caps { text: "TOTAL"; horizontal-alignment: center; accessible-role: none; }
            }
        }
    }
    VerticalLayout {
        spacing: 6px;
        Caps { text: "STOPS"; }
        legs := Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Dash.track;

            HorizontalLayout {
                spacing: 2px;
                for f[i] in Pages.merge-legs: Rectangle {
                    horizontal-stretch: max(0.02, f);
                    border-radius: 3px;
                    background: Dash.hues[Math.mod(i, 4)];
                }
            }
        }
    }
}

export component MergePage inherits VerticalLayout {
    in property <bool> wide;
    callback go(int);
    callback move(int, int);
    callback remove(int);
    callback play(int);
    callback run(string);
    property <string> playing-name: Main.active-clip >= 0 && Main.active-clip < Main.clips.length && Main.playing ? Main.clips[Main.active-clip].name : "";
    Title { wide: root.wide; mode: "MERGE"; }
    PageHead { title: "Merge clips"; note: Pages.merge-rows.length + " clips"; back => { root.go(0); } }
    HorizontalLayout {
        vertical-stretch: 1;
        if root.wide: Rectangle {
            width: 400px;
            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 6px;
                padding-bottom: 14px;
                spacing: 18px;
                alignment: start;
                Route { }
                VerticalLayout {
                    spacing: 6px;
                    Caps { text: "NEW CLIP"; }
                    Field { text <=> Pages.merge-name; placeholder: "Name"; label: "Name of the merged clip"; }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: root.wide ? 6px : 12px;
            padding-right: root.wide ? 16px : 12px;
            padding-bottom: 10px;
            Glass {
                VerticalLayout {
                    padding: 8px;
                    padding-top: 6px;
                    spacing: 2px;
                    HorizontalLayout {
                        height: 24px;
                        padding-left: 6px;
                        padding-right: 6px;
                        Caps { text: "ORDER"; horizontal-stretch: 1; }
                        Caps { text: Pages.merge-rows.length + " CLIPS"; }
                    }
                    Scroller {
                        VerticalLayout {
                            alignment: start;
                            OrderList {
                                rows: Pages.merge-rows;
                                removable: true;
                                playable: true;
                                playing-name: root.playing-name;
                                enabled: !Pages.merging;
                                moved(a, b) => { root.move(a, b); }
                                act(i) => { root.remove(i); }
                                play(i) => { root.play(i); }
                            }
                        }
                    }
                }
            }
        }
    }
    if !root.wide: VerticalLayout {
        vertical-stretch: 0;
        padding-left: 14px;
        padding-right: 14px;
        padding-bottom: 12px;
        spacing: 6px;
        Caps { text: "NEW CLIP"; }
        Field { text <=> Pages.merge-name; placeholder: "Name"; label: "Name of the merged clip"; }
    }
    Footer {
        // Portrait has no room for the message beside the keys: it floats above the
        // footer instead, so it is never cut short.
        if root.wide: Status { horizontal-stretch: 1; }
        if !root.wide: Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                Btn { height: 32px; font-size: 12px; text: "Cancel"; clicked => { root.go(0); } }
                Btn {
                    height: 32px;
                    font-size: 12px;
                    min-width: 136px;
                    primary: true;
                    text: Pages.merging ? "Merging" : "Merge " + Pages.merge-rows.length + " clips";
                    enabled: !Pages.merging && Pages.merge-name != "";
                    clicked => { root.run(Pages.merge-name); }
                }
            }
        }
    }
    if !root.wide: Toast { text: Main.status; above: 8px; }
}

// ---------- Ask ----------

// A source of an answer: its number in an ice ring, a tile, the clip (and its project),
// the time and the words.
component Source inherits Rectangle {
    in property <AskSource> source;
    in property <bool> show-project;
    in property <string> project;
    callback clicked;
    height: 50px;
    border-radius: 10px;
    background: t.has-hover ? #ffffff0a : transparent;
    border-width: t.has-hover ? 1px : 0;
    border-color: Dash.line2;
    accessible-role: button;
    accessible-label: root.source.n + " " + root.source.clip + " " + root.source.time;
    accessible-action-default => { root.clicked(); }
    property <color> hue: Dash.hues[Math.mod(root.source.n, 4)];
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                border-width: 1.5px;
                border-color: Dash.ice;
                Text {
                    text: root.source.n;
                    color: Dash.ice;
                    font-family: "Manrope";
                    font-size: 10.5px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 7px;
                background: root.hue.with-alpha(0.1);
                border-width: 1px;
                border-color: Dash.line;
                for i in 9: Rectangle {
                    x: 7px + i * 2.2px;
                    width: 1.3px;
                    height: 4px + Math.mod(i * 7 + 3, 5) * 2.2px;
                    y: (parent.height - self.height) / 2;
                    background: root.hue;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.source.clip;
                    color: Dash.text;
                    font-family: "Manrope";
                    font-size: 13px;
                    font-weight: 800;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.show-project && root.project != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: pj.preferred-width + 10px;
                        height: 14px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Dash.line2;
                        pj := Text {
                            text: root.project.to-uppercase();
                            color: Dash.dim;
                            font-family: "Manrope";
                            font-size: 8px;
                            font-weight: 800;
                            letter-spacing: 1.2px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.source.time;
                    color: Dash.text2;
                    font-family: Theme.mono;
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.source.text;
                color: Dash.dim;
                font-family: "Manrope";
                font-size: 10.5px;
                font-weight: 500;
                overflow: elide;
            }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The answer on a glass card, under the assistant's ice orb.
component Answer inherits Glass {
    in property <length> max-h: 320px;
    height: min(body.preferred-height + 40px, root.max-h);
    Rectangle {
        x: 14px;
        y: 12px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: @radial-gradient(circle, #e9fbff 0%, #62d2ff 45%, #3a8dff 100%);
    }
    Caps {
        x: 38px;
        y: 12px;
        height: 16px;
        text: "ANSWER";
        color: Dash.ice;
    }
    Scroller {
        y: 36px;
        height: parent.height - 40px;
        body := VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-bottom: 10px;
            if Pages.answer == "": HorizontalLayout {
                spacing: 10px;
                height: 22px;
                Text {
                    text: "Thinking";
                    color: Dash.dim;
                    font-family: "Manrope";
                    font-size: 12.5px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            if Pages.answer != "": Text {
                text: Pages.answer;
                color: Dash.text;
                font-family: "Manrope";
                font-size: 12.5px;
                font-weight: 700;
                wrap: word-wrap;
            }
        }
    }
}

// The sources, numbered as the answer cites them, on a glass card.
component Sources inherits Glass {
    callback open(int);
    VerticalLayout {
        padding: 6px;
        padding-top: 4px;
        spacing: 2px;
        HorizontalLayout {
            height: 24px;
            padding-left: 8px;
            padding-right: 8px;
            Caps { text: "SOURCES"; horizontal-stretch: 1; }
            Caps { text: Pages.sources.length + (Pages.sources.length == 1 ? " CLIP" : " CLIPS"); }
        }
        Scroller {
            VerticalLayout {
                alignment: start;
                spacing: 2px;
                for s[i] in Pages.sources: Source {
                    source: s;
                    show-project: Pages.ask-all;
                    project: s.place >= 0 && s.place < Main.projects.length ? Main.projects[s.place] : "";
                    clicked => { root.open(i); }
                }
            }
        }
    }
}

export component AskPage inherits VerticalLayout {
    in property <bool> wide;
    callback go(int);
    callback ask(string, bool);
    callback open-source(int);
    Title { wide: root.wide; mode: "ASK"; }
    PageHead { title: "Ask"; back => { root.go(0); } }
    HorizontalLayout {
        vertical-stretch: 0;
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 10px;
        spacing: 8px;
        Field {
            height: 36px;
            horizontal-stretch: 1;
            icon: "message";
            placeholder: "Ask about your clips";
            label: "Question";
            text <=> Pages.question;
            init => { self.grab(); }
            accepted => { if (Pages.question != "" && !Pages.asking) { root.ask(Pages.question, Pages.ask-all); } }
        }
        if Main.projects.length > 1: VerticalLayout {
            alignment: center;
            Chip {
                height: 36px;
                lamp: true;
                text: "All projects";
                label: "Ask all projects";
                on: Pages.ask-all;
                clicked => { Pages.ask-all = !Pages.ask-all; }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                height: 36px;
                font-size: 12px;
                primary: true;
                text: "Ask";
                enabled: Pages.question != "" && !Pages.asking;
                clicked => { root.ask(Pages.question, Pages.ask-all); }
            }
        }
    }
    if !root.wide: VerticalLayout {
        vertical-stretch: 1;
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 12px;
        spacing: 10px;
        if Pages.answer != "" || Pages.asking: Answer { }
        if Pages.sources.length > 0: Sources {
            vertical-stretch: 1;
            open(i) => { root.open-source(i); root.go(1); }
        }
        if Pages.sources.length == 0: Rectangle { vertical-stretch: 1; }
    }
    if root.wide: HorizontalLayout {
        vertical-stretch: 1;
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1.1;
            alignment: start;
            if Pages.answer != "" || Pages.asking: Answer { max-h: 460px; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            if Pages.sources.length > 0: Sources {
                height: min(self.preferred-height, 460px);
                open(i) => { root.open-source(i); root.go(1); }
            }
        }
    }
    Toast { text: Main.status; above: 10px; }
}

// ---------- The widget ----------

// The small always-on-top window as a mini cluster (variant A): the arc as the level
// with the timer inside, the status lamp and word with open window, Pause while
// recording and the red record hub. The edge turns red while recording. The whole card
// moves the window.
export component Widget inherits Rectangle {
    property <float> level: Main.recording && !Main.paused && Main.live.length > 0 ? Main.live[Main.live.length - 1] : 0;
    background: @radial-gradient(circle, #141a21 0%, #0c0e11 100%);
    border-radius: 14px;
    border-width: 1px;
    border-color: Main.recording ? #ff4d5e99 : Dash.line2;
    WindowMoveArea {
        Arc {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: min(parent.height - 16px, 108px);
            level: true;
            f: clamp((root.level * 60 - 12) / 48, 0, 1);
            accessible-role: AccessibleRole.text;
            accessible-label: (Main.recording ? (Main.paused ? "Paused " : "Recording ") : "Ready ") + Main.elapsed;
            VerticalLayout {
                alignment: center;
                Text {
                    text: Main.elapsed;
                    color: #ffffff;
                    font-family: Theme.mono;
                    font-size: 19px;
                    font-weight: 300;
                    horizontal-alignment: center;
                    accessible-role: none;
                }
                Caps { text: "ELAPSED"; font-size: 6.5px; letter-spacing: 1.6px; horizontal-alignment: center; accessible-role: none; }
            }
        }
        // The lamp and the word, and open window, top right.
        HorizontalLayout {
            x: parent.width - self.width - 8px;
            y: 8px;
            height: 22px;
            width: self.preferred-width;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Lamp { kind: Main.recording ? (Main.paused ? 4 : 3) : 1; }
            }
            Text {
                text: Main.recording ? (Main.paused ? "PAUSED" : "REC") : "READY";
                color: Main.recording ? (Main.paused ? Dash.warn : Dash.rec) : Dash.ok;
                font-family: "Manrope";
                font-size: 8.5px;
                font-weight: 800;
                letter-spacing: 1.7px;
                vertical-alignment: center;
            }
            Rectangle { width: 4px; }
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 6px;
                background: ow.has-hover ? #ffffff14 : transparent;
                accessible-role: button;
                accessible-label: "Open the window";
                accessible-action-default => { Main.compact-changed(false); }
                Icon { name: "expand"; tint: ow.has-hover ? Dash.text : Dash.dim; width: 11px; height: 11px; }
                property <bool> hovering: ow.has-hover;
                changed hovering => { Tips.hover(self.hovering, "Open window", self.absolute-position, self.width, self.height); }
                ow := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Tips.hide(); Main.compact-changed(false); }
                }
            }
        }
        // Pause (while recording) and the record hub, lower right.
        HorizontalLayout {
            x: parent.width - self.width - 12px;
            y: parent.height - 62px;
            height: 52px;
            width: self.preferred-width;
            spacing: 10px;
            if Main.recording: VerticalLayout {
                alignment: center;
                Key {
                    width: 32px;
                    icon: Main.paused ? "play" : "pause";
                    icon-size: 11px;
                    label: Main.paused ? "Resume" : "Pause";
                    clicked => { Main.toggle-pause(); }
                }
            }
            Rectangle {
                width: 52px;
                height: 52px;
                accessible-role: button;
                accessible-label: Main.recording ? "Stop recording" : "Record";
                accessible-action-default => { Main.toggle-record(); }
                Art {
                    x: -parent.width * 26 / 76;
                    y: -parent.height * 26 / 76;
                    width: parent.width * 128 / 76;
                    height: parent.height * 128 / 76;
                    lo: Main.recording ? @image-url("dash/rec-on.png") : @image-url("dash/rec.png");
                    hi: Main.recording ? @image-url("dash/rec-on@2x.png") : @image-url("dash/rec@2x.png");
                }
                Rectangle { visible: rt.has-hover; border-radius: 26px; background: #ffffff1a; }
                Icon {
                    name: Main.recording ? "stop" : "mic";
                    tint: #ffffff;
                    width: Main.recording ? 15px : 20px;
                    height: Main.recording ? 15px : 20px;
                }
                property <bool> hovering: rt.has-hover;
                changed hovering => { Tips.hover(self.hovering, Main.recording ? "Stop" : "Record", self.absolute-position, self.width, self.height); }
                rt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Tips.hide(); Main.toggle-record(); }
                }
            }
        }
    }
}

// ---------- Questions and covers ----------

// A glass sheet with an ice light along its top edge (the dialogs and the speaking
// cover).
component Sheet inherits Rectangle {
    background: #161a20;
    border-radius: 16px;
    border-width: 1px;
    border-color: #ffffff33;
    Rectangle {
        x: 20px;
        y: 0;
        width: parent.width - 40px;
        height: 1px;
        background: @linear-gradient(90deg, #3a8dff00 0%, #3a8dff 25%, #62d2ff 50%, #9b7bff 75%, #9b7bff00 100%);
    }
    @children
}

// A question over the dimmed cockpit: a round icon tile, the title (a clip's name in
// ice), a note or a field, and the pills. AppWindow works out the words; the pills
// report back. A click outside cancels.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> note;
    in property <string> field;
    in property <string> ok;
    in property <bool> ok-enabled;
    // A single clip's delete question shows its name in ice.
    in property <string> clip-name;
    callback close();
    callback confirm();
    callback discard();
    property <int> kind: Main.dialog;
    property <bool> writes: root.kind == 1 || root.kind >= 4;
    background: #040609b8;
    TouchArea { clicked => { root.close(); } }
    Sheet {
        width: min(parent.width - 48px, 340px);
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 30px;
        TouchArea { }
        box := VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 20px;
            padding-bottom: 16px;
            spacing: 4px;
            HorizontalLayout {
                alignment: start;
                padding-bottom: 8px;
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: root.kind == 2 ? #ff4d5e24 : #62d2ff1f;
                    Icon {
                        name: root.kind == 2 ? "trash" : root.kind == 4 ? "plus" : root.kind == 5 ? "folder" : "pencil";
                        tint: root.kind == 2 ? #ff8a95 : Dash.ice;
                        width: 15px;
                        height: 15px;
                    }
                }
            }
            if root.clip-name == "": Text {
                text: root.title;
                color: Dash.text;
                font-family: "Manrope";
                font-size: 16px;
                font-weight: 800;
                overflow: elide;
            }
            if root.clip-name != "": HorizontalLayout {
                spacing: 5px;
                alignment: start;
                Text {
                    text: "Delete";
                    color: Dash.text;
                    font-family: "Manrope";
                    font-size: 16px;
                    font-weight: 800;
                }
                Text {
                    text: root.clip-name;
                    color: Dash.ice;
                    font-family: "Manrope";
                    font-size: 16px;
                    font-weight: 800;
                    overflow: elide;
                }
            }
            if root.note != "": Text {
                text: root.note;
                color: Dash.dim;
                font-family: "Manrope";
                font-size: 12px;
                font-weight: 500;
                wrap: word-wrap;
            }
            if root.writes: VerticalLayout {
                padding-top: 10px;
                spacing: 6px;
                Caps { text: root.field.to-uppercase(); font-size: 8.5px; }
                Field {
                    label: root.field;
                    text <=> Main.dialog-text;
                    init => { self.grab(); }
                    accepted => { if (root.ok-enabled) { root.confirm(); } }
                }
            }
            HorizontalLayout {
                padding-top: 14px;
                alignment: end;
                spacing: 8px;
                Btn { height: 30px; font-size: 12px; text: "Cancel"; clicked => { root.close(); } }
                if root.kind == 3: Btn { height: 30px; font-size: 12px; text: "Discard changes"; clicked => { root.discard(); } }
                Btn {
                    height: 30px;
                    font-size: 12px;
                    min-width: 76px;
                    primary: true;
                    red: root.kind == 2;
                    text: root.ok;
                    enabled: root.ok-enabled;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}

// New words being spoken: a sheet with the arc filling as the percent, the stage line
// and Cancel. It blocks clicks.
export component Speaking inherits Rectangle {
    callback cancel();
    background: #040609c8;
    TouchArea { }
    Sheet {
        width: min(parent.width - 48px, 340px);
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 30px;
        box := VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 18px;
            padding-bottom: 16px;
            spacing: 10px;
            Text {
                text: "Speaking new words";
                color: Dash.text;
                font-family: "Manrope";
                font-size: 15px;
                font-weight: 800;
            }
            HorizontalLayout {
                spacing: 14px;
                Arc {
                    width: 64px;
                    tip: false;
                    f: Pages.speak-progress;
                    Text {
                        text: round(Pages.speak-progress * 100) + "%";
                        color: #ffffff;
                        font-family: "Manrope";
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: Pages.speak-stage;
                    color: Dash.dim;
                    font-family: "Manrope";
                    font-size: 11.5px;
                    font-weight: 500;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                alignment: end;
                Btn { height: 30px; font-size: 12px; text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}

// Files dragged over the window: four ice corner brackets inset 12px, the import ring
// and the words.
export component Drop inherits Rectangle {
    background: #04060ad0;
    for c in 4: Rectangle {
        x: Math.mod(c, 2) == 0 ? 12px : parent.width - 12px - self.width;
        y: c < 2 ? 12px : parent.height - 12px - self.height;
        width: 26px;
        height: 26px;
        Rectangle {
            x: Math.mod(c, 2) == 0 ? 0 : parent.width - 2px;
            width: 2px;
            border-radius: 1px;
            background: Dash.ice;
        }
        Rectangle {
            y: c < 2 ? 0 : parent.height - 2px;
            height: 2px;
            border-radius: 1px;
            background: Dash.ice;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 54px;
                height: 54px;
                border-radius: 27px;
                background: #62d2ff1a;
                border-width: 1.5px;
                border-color: #62d2ffb3;
                Icon { name: "import"; tint: Dash.ice; width: 20px; height: 20px; }
            }
        }
        Text {
            text: "Drop to import";
            color: Dash.text;
            font-family: "Manrope";
            font-size: 17px;
            font-weight: 800;
            horizontal-alignment: center;
        }
    }
}
