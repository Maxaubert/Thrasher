// The Spatial Glass parts shared by its main page (x-spatial.slint) and its other pages
// (x-spatial-pages.slint): the nine-slice shadows, the frosted panes, the glass capsules
// and the round glass buttons. The art is in x-spatial/ (tools/skin-art/x-spatial.html).

import { Glass, Main, Tips, Icon } from "../common.slint";

// The shadow under a pane: a nine-slice picture around it, drawn outside the box only,
// so the glass stays clear. `kind`: 0 a pane, 1 the pane nearest you, 2 the ornament,
// 3 a title pill.
export component Shadow inherits Image {
    in property <int> kind;
    // The box it falls from.
    in property <length> box-w;
    in property <length> box-h;
    // The picture's margins round the box: top, right, bottom, left.
    property <length> mt: root.kind == 0 ? 32px : root.kind == 1 ? 36px : root.kind == 2 ? 24px : 14px;
    property <length> mr: root.kind == 0 ? 48px : root.kind == 1 ? 60px : root.kind == 2 ? 40px : 24px;
    property <length> mb: root.kind == 0 ? 72px : root.kind == 1 ? 90px : root.kind == 2 ? 56px : 36px;
    x: -root.mr;
    y: -root.mt;
    width: root.box-w + 2 * root.mr;
    height: root.box-h + root.mt + root.mb;
    source: root.kind == 0 ? @image-url("x-spatial/shadow-pane.png", nine-slice(56 72 96 72))
        : root.kind == 1 ? @image-url("x-spatial/shadow-near.png", nine-slice(60 84 114 84))
        : root.kind == 2 ? @image-url("x-spatial/shadow-pill.png", nine-slice(48 64 80 64))
        : @image-url("x-spatial/shadow-tab.png", nine-slice(29 39 51 39));
    accessible-role: none;
}

// A pane of frosted glass: the fill, the light falling on its top, the edge and the
// bright line along its top. The renderer ignores corners on gradients, so the light
// is a rounded band down to the corners' end and a square gradient below it that starts
// as bright as the band, so no seam shows where they meet.
export component Pane inherits Rectangle {
    in property <length> radius: 24px;
    in property <int> shadow: 0;
    // Lifted toward you (the pane you type in): brighter glass and edge.
    in property <bool> lift;
    Shadow { kind: root.shadow; box-w: root.width; box-h: root.height; }
    Rectangle { border-radius: root.radius; background: root.lift ? #5e5c6aa6 : Glass.fill; }
    Rectangle {
        y: 0;
        height: root.radius;
        border-top-left-radius: root.radius;
        border-top-right-radius: root.radius;
        background: #ffffff17;
    }
    Rectangle {
        y: root.radius;
        height: max(0px, parent.height * 0.4 - root.radius);
        background: @linear-gradient(180deg, #ffffff17 0%, #ffffff00 100%);
    }
    Rectangle { border-radius: root.radius; border-width: 1px; border-color: root.lift ? #ffffff8c : Glass.edge; }
    Rectangle {
        x: root.radius * 0.6;
        y: 1px;
        width: parent.width - root.radius * 1.2;
        height: 1px;
        background: @linear-gradient(90deg, #ffffff00 0%, #ffffff8c 18%, #ffffff8c 82%, #ffffff00 100%);
    }
    @children
}

// A capsule of glass (the title pill, the ornament): brighter than a pane.
export component Capsule inherits Rectangle {
    in property <int> shadow: 3;
    property <length> r: root.height / 2;
    Shadow { kind: root.shadow; box-w: root.width; box-h: root.height; }
    Rectangle { border-radius: root.r; background: #5e5d6584; }
    Rectangle {
        y: 0;
        height: root.r;
        border-top-left-radius: root.r;
        border-top-right-radius: root.r;
        background: #ffffff10;
    }
    Rectangle { border-radius: root.r; border-width: 1px; border-color: Glass.edge; }
    Rectangle {
        x: root.r * 0.7;
        y: 1px;
        width: parent.width - root.r * 1.4;
        height: 1px;
        background: @linear-gradient(90deg, #ffffff00 0%, #ffffff8c 20%, #ffffff8c 80%, #ffffff00 100%);
    }
    @children
}

// A round glass button, 28, 30 or 34 across; its shadow is part of the picture.
export component GlassBtn inherits Rectangle {
    in property <int> size: 30;
    in property <string> icon;
    in property <length> icon-size: 15px;
    in property <string> label;
    in property <string> tip: label;
    in property <bool> enabled: true;
    in property <color> tint: Glass.ink;
    callback clicked;
    property <bool> hi: 1phx < 0.7px;
    width: root.size * 1px;
    height: root.size * 1px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Image {
        x: -10px;
        y: -10px;
        width: parent.width + 20px;
        height: parent.height + 20px;
        source: root.size == 28 ? (root.hi ? @image-url("x-spatial/rb-28@2x.png") : @image-url("x-spatial/rb-28.png"))
            : root.size == 34 ? (root.hi ? @image-url("x-spatial/rb-34@2x.png") : @image-url("x-spatial/rb-34.png"))
            : (root.hi ? @image-url("x-spatial/rb-30@2x.png") : @image-url("x-spatial/rb-30.png"));
        image-fit: fill;
        opacity: root.enabled ? 1 : 0.45;
    }
    Rectangle {
        visible: t.has-hover && root.enabled;
        border-radius: self.width / 2;
        background: t.pressed ? #ffffff30 : #ffffff1a;
    }
    Icon {
        x: (parent.width - self.width) / 2 + (root.icon == "play" ? 1px : 0);
        y: (parent.height - self.height) / 2;
        name: root.icon;
        tint: root.enabled ? root.tint : Glass.ink3;
        width: root.icon-size;
        height: root.icon-size;
    }
    property <bool> hovering: t.has-hover;
    changed hovering => { Tips.hover(self.hovering, root.tip, self.absolute-position, self.width, self.height); }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { Tips.hide(); root.clicked(); }
    }
}

// The lamp and the word of the recorder's state, on a small glass chip.
export component Status inherits Rectangle {
    property <color> lamp: Main.recording ? (Main.paused ? Glass.amber : Glass.rec-hi) : Glass.green;
    width: row.preferred-width;
    height: 22px;
    border-radius: 11px;
    background: #ffffff1a;
    border-width: 1px;
    border-color: #ffffff2e;
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        Rectangle {
            width: 7px;
            Rectangle {
                width: 13px;
                height: 13px;
                border-radius: 6.5px;
                background: root.lamp.with-alpha(0.25);
            }
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.lamp;
            }
        }
        Text {
            text: Main.recording ? (Main.paused ? "PAUSED" : "RECORDING") : "READY";
            color: Glass.ink;
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 1.7px;
            vertical-alignment: center;
        }
    }
}

// The timer: minutes and seconds in light figures, the tenth smaller and dimmer on the
// same baseline.
export component Timer inherits HorizontalLayout {
    in property <length> size: 40px;
    alignment: start;
    property <length> small: root.size * 0.55;
    accessible-role: AccessibleRole.text;
    accessible-label: Main.elapsed + Main.elapsed-tenth;
    Text {
        text: Main.elapsed;
        color: Glass.ink;
        font-family: Glass.figures;
        font-weight: 300;
        font-size: root.size;
        letter-spacing: -0.02 * root.size;
        accessible-role: none;
    }
    Rectangle {
        width: tenth.preferred-width;
        // Inter's descent is 0.242 em: lift the small text by the difference.
        tenth := Text {
            y: parent.height - self.height - 0.242 * (root.size - root.small);
            text: Main.elapsed-tenth;
            color: Glass.ink3;
            font-family: Glass.figures;
            font-weight: 400;
            font-size: root.small;
            accessible-role: none;
        }
    }
}

// A tall pane tilted toward you: its left edge is nearer, so taller. The renderer cannot
// turn things, so the pane's slanted ends are drawn and its contents stay square (the
// wide recorder, and the wide pages' left panes).
export component TiltPane inherits Rectangle {
    property <float> w: root.width / 1px;
    property <float> h: root.height / 1px;
    // How much shorter the far (right) edge is at each end; contents start lower by half.
    out property <float> d: 12 * root.h / 470;
    property <float> r: 24;
    property <float> k: root.d / root.w;
    // Where the far top corner ends.
    property <float> cap: root.d + root.r;
    // The shadow, in upright strips that each shrink it to the slant at their right end:
    // one upright box would leave its unshadowed inside showing past the slanted ends, as
    // a pale corner above the far top and a dark slab under the far bottom. Shrunk to its
    // right end, a strip's clear inside never reaches past the glass.
    for i in 16: Rectangle {
        property <length> x0: i == 0 ? -60px : root.width * i / 16;
        property <length> x1: i == 15 ? root.width + 60px : root.width * (i + 1) / 16;
        property <length> inset: root.d * (i + 1) / 16 * 1px;
        x: self.x0;
        y: -36px;
        width: self.x1 - self.x0;
        height: root.height + 126px;
        clip: true;
        Image {
            x: -60px - parent.x0;
            y: parent.inset;
            width: root.width + 120px;
            height: root.height + 126px - 2 * parent.inset;
            source: @image-url("x-spatial/shadow-near.png", nine-slice(60 84 114 84));
            accessible-role: none;
        }
    }
    // The glass. The renderer draws a path into a mask of its full size every time
    // anything over it changes, so only the slanted ends are paths and the upright
    // middle is plain rectangles. The ends' outlines are open paths, so no line is drawn
    // where an end meets the middle; they sit half a pixel in so the edge is not cut.
    // A stroked path is fitted into its box less the stroke's width, keeping its shape,
    // so its box is 1px larger each way to keep the outline at the scale of the fill (in
    // the exact box it shrinks 3%, about 5px in from each side).
    // The top end is lit evenly, as a flat pane's top is.
    Path {
        y: 0;
        width: 100%;
        height: root.cap * 1px;
        viewbox-width: root.w;
        viewbox-height: root.cap;
        fill: #69676f86;
        commands: "M 0 " + root.cap + " L 0 " + root.r + " Q 0 0 " + root.r + " " + (root.r * root.k)
            + " L " + (root.w - root.r) + " " + (root.d - root.r * root.k)
            + " Q " + root.w + " " + root.d + " " + root.w + " " + root.cap + " Z";
    }
    Path {
        x: -0.5px;
        y: -0.5px;
        width: parent.width + 1px;
        height: root.cap * 1px + 1px;
        viewbox-width: root.w;
        viewbox-height: root.cap;
        stroke: Glass.edge;
        stroke-width: 1px;
        commands: "M 0.5 " + root.cap + " L 0.5 " + root.r + " Q 0.5 0.5 " + root.r + " " + (0.5 + root.r * root.k)
            + " L " + (root.w - root.r) + " " + (root.d - root.r * root.k + 0.5)
            + " Q " + (root.w - 0.5) + " " + (root.d + 0.5) + " " + (root.w - 0.5) + " " + root.cap;
    }
    // The bright line along the top.
    Path {
        x: -0.5px;
        y: -0.5px;
        width: parent.width + 1px;
        height: root.cap * 1px + 1px;
        viewbox-width: root.w;
        viewbox-height: root.cap;
        stroke: Glass.edge-top;
        stroke-width: 1px;
        commands: "M " + (root.r * 0.8) + " " + (1.5 + root.r * 0.8 * root.k)
            + " L " + (root.w - root.r * 0.8) + " " + (root.d + 1 - root.r * 0.8 * root.k);
    }
    Rectangle {
        y: root.cap * 1px;
        height: parent.height - 2 * self.y;
        background: Glass.fill;
    }
    Rectangle {
        x: 1px;
        y: root.cap * 1px;
        width: parent.width - 2px;
        height: max(0px, parent.height * 0.4 - self.y);
        background: @linear-gradient(180deg, #ffffff17 0%, #ffffff00 100%);
    }
    Rectangle { x: 0; y: root.cap * 1px; width: 1px; height: parent.height - 2 * self.y; background: Glass.edge; }
    Rectangle { x: parent.width - 1px; y: root.cap * 1px; width: 1px; height: parent.height - 2 * self.y; background: Glass.edge; }
    // The bottom end.
    Path {
        y: parent.height - self.height;
        width: 100%;
        height: root.cap * 1px;
        viewbox-width: root.w;
        viewbox-height: root.cap;
        fill: Glass.fill;
        commands: "M " + root.w + " 0 Q " + root.w + " " + root.r + " " + (root.w - root.r) + " " + (root.r + root.r * root.k)
            + " L " + root.r + " " + (root.cap - root.r * root.k)
            + " Q 0 " + root.cap + " 0 " + root.d + " L 0 0 Z";
    }
    Path {
        x: -0.5px;
        y: parent.height - root.cap * 1px - 0.5px;
        width: parent.width + 1px;
        height: root.cap * 1px + 1px;
        viewbox-width: root.w;
        viewbox-height: root.cap;
        stroke: Glass.edge;
        stroke-width: 1px;
        commands: "M " + (root.w - 0.5) + " 0 Q " + (root.w - 0.5) + " " + root.r + " " + (root.w - root.r) + " " + (root.r + root.r * root.k - 0.5)
            + " L " + root.r + " " + (root.cap - 0.5 - root.r * root.k)
            + " Q 0.5 " + (root.cap - 0.5) + " 0.5 " + root.d + " L 0.5 0";
    }
    @children
}

// The grab bar under the ornament: drag it to move the window.
export component Grab inherits Rectangle {
    in property <length> bar: 110px;
    width: root.bar + 40px;
    height: 18px;
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    Rectangle {
        x: 20px + 1px;
        y: (parent.height - 6px) / 2 + 2px;
        width: root.bar - 2px;
        height: 6px;
        border-radius: 3px;
        background: #00000040;
    }
    Rectangle {
        x: 20px;
        y: (parent.height - 6px) / 2;
        width: root.bar;
        height: 6px;
        border-radius: 3px;
        background: #ffffff8c;
    }
}
