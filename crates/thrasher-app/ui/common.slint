                        border-radius: Theme.pocket ? 0 : Theme.os95 || Theme.quest ? 0 : Theme.comic ? 0 : Theme.brick ? 0 : Theme.synth ? 0 : 3px;
                        // Quest Menu: the word playing on gold.
                        // Pocket Synth: the word playing inverted in orange.
                        background: Theme.phono ? (i == root.current-word ? #e9c873 : wt.has-hover ? #b58a3526 : transparent) : Theme.pinball ? (i == root.current-word ? Pb.plasma : wt.has-hover ? #ffffff14 : transparent) : Theme.cozy ? (i == root.current-word ? Cz.honey : wt.has-hover ? #0000001a : transparent) : Theme.quest ? (i == root.current-word ? Quest.gold : wt.has-hover ? Quest.win-lo : transparent) : Theme.synth ? (i == root.current-word ? #ff5a1e : wt.has-hover ? #ffffff17 : transparent)
                            : Theme.comic ? (i == root.current-word ? Comic.yellow : wt.has-hover ? Comic.pale : transparent)
                            : i == root.current-word ? (Theme.pocket ? Pk.l3 : Theme.answer ? Am.lit : Theme.accent)
                            : Theme.answer && w.is-silence ? #e8dfcb
                            : wt.has-hover ? (Theme.tape ? #00000014 : Theme.os95 ? #e4e8f6 : Theme.raised) : transparent;
                        border-width: Theme.comic && i == root.current-word ? 2px : Theme.brick && w.is-silence ? 1px : Theme.answer && w.is-silence ? 1px : 0;
                        border-color: Theme.comic ? Comic.ink : Theme.brick ? Brick.ink : Theme.answer ? #b9ad95 : i == root.current-word ? #ffffff66 : #9fe3ff66;
                        width: hidden ? 0 : label.preferred-width + 6px;
                        height: hidden ? 0 : label.preferred-height + (Theme.comic ? 6px : 4px);
                        label := Text {
                            text: w.text;
                            // Spoken words are generated speech: shown in a different colour.
                            color: Theme.quest ? (i == root.current-word ? Quest.ink
                                    : w.is-silence ? Quest.mp
                                    : !marks ? Quest.white
                                    : w.failed ? Quest.lred
                                    : w.pending ? Quest.dim
                                    : w.spoken ? Quest.mp
                                    : Quest.white)
                                : Theme.tape ? (i == root.current-word ? #2a1406
                                    : w.is-silence ? #c66a12
                                    : !marks ? #2f2117
                                    : w.failed ? Deck.red
                                    : w.pending ? #a99880
                                    : w.spoken ? #c66a12
                                    : #2f2117)
                                : Theme.comic ? (w.is-silence ? Comic.blue
                                    : !marks ? Comic.ink
                                    : w.failed ? Comic.red
                                    : w.pending ? Comic.faint
                                    : w.spoken ? Comic.blue
                                    : Comic.ink)
                                : Theme.synth ? (i == root.current-word ? #ffffff
                                    : w.is-silence ? #ff5a1e
                                    : !marks ? #dfe5df
                                    : w.failed ? #ff7a48
                                    : w.pending ? #5f6662
                                    : w.spoken ? #ffb08c
                                    : #dfe5df)
                                : Theme.pocket ? (i == root.current-word ? Pk.l0
                                    : w.is-silence ? Pk.l2
                                    : !marks ? Pk.l3
                                    : w.failed ? Theme.danger
                                    : w.pending ? Pk.l1
                                    : w.spoken ? Pk.l2
                                    : Pk.l3)
                                : Theme.pinball ? (i == root.current-word ? Pb.key-ink : w.is-silence ? Pb.mark : !marks ? (i < root.current-word ? Pb.ink : Pb.body) : w.failed ? Pb.danger : w.pending ? #6f6880 : w.spoken ? Pb.plasma-hi : Pb.body)
                                : Theme.phono ? (i == root.current-word ? Pn.ink : w.is-silence ? Pn.wax : !marks ? Pn.ink : w.failed ? Pn.wax : w.pending ? Pn.faded : w.spoken ? Pn.wax : Pn.ink)
                                : Theme.cozy ? (i == root.current-word ? Cz.ink : w.is-silence ? Cz.moss-d : !marks ? Cz.ink : w.failed ? Cz.ember-d : w.pending ? Cz.parch-dd : w.spoken ? Cz.moss-d : Cz.ink)
                                : Theme.answer ? (i == root.current-word ? Am.rec
                                    : w.is-silence ? Am.print-soft
                                    : !marks ? Am.ink
                                    : w.failed ? Am.rec
                                    : w.pending ? #b1a58d
                                    : w.spoken ? #a8650a
                                    : Am.ink)
                                : i == root.current-word ? Theme.on-accent
                                : w.is-silence ? Theme.accent
                                : !marks ? Theme.text2
                                : w.failed ? Theme.danger
                                : w.pending ? Theme.faint
                                : w.spoken ? Theme.accent
                                : Theme.text2;
                            font-family: Theme.pocket ? Pk.big : Theme.quest ? Quest.font : Theme.brick ? Brick.words : Theme.tape || Theme.synth ? Theme.mono : Theme.phono ? Pn.font : Theme.pinball ? (w.is-silence ? Theme.mono : Pb.font) : Theme.cozy ? Cz.font : Theme.dash ? "Manrope" : Theme.os95 ? "VT323" : Theme.comic ? "Comic Neue" : Theme.answer ? (w.is-silence ? "Barlow Condensed" : "Courier Prime") : "Inter Tight";
                            font-weight: Theme.phono ? (w.is-silence ? 500 : 600) : Theme.pinball ? (i == root.current-word ? 700 : 400) : Theme.cozy ? 400 : Theme.comic || ((Theme.tape || Theme.synth) && w.is-silence) || (Theme.answer && (w.is-silence || i == root.current-word)) ? 700 : 400;
                            font-size: Theme.phono ? (w.is-silence ? 13px : 15.5px) : Theme.pinball ? (w.is-silence ? 10.5px : 15.5px) : Theme.cozy ? 14px : Theme.pocket ? 20px : Theme.quest ? 14px : Theme.brick ? (w.is-silence ? round(root.brick-size * 0.85 / 1px) * 1px : root.brick-size) : Theme.tape || Theme.synth ? 12px : Theme.os95 ? 19px : Theme.comic ? 13.5px : Theme.answer ? (w.is-silence ? 10px : 13px) : 15px;
                            font-italic: (w.spoken && marks) || (Theme.phono && w.is-silence);
                        }
                        wt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.seek-word(i); }
                        }
                    }
                }
            }
                }
            }
        }
    // Comic Book: the panel's tag across its top left corner.
    Rectangle {
        visible: Theme.comic;
        x: 0;
        y: 0;
        width: tag-text.preferred-width + 16px;
        height: 19px;
        background: root.editing ? Comic.red : Comic.ink;
        tag-text := Text {
            x: 8px;
            y: 2px;
            height: parent.height - 2px;
            text: root.editing ? "TYPING" : root.summary-view ? "SUMMARY" : root.lang-view ? "TRANSLATION" : "TRANSCRIPT";
            color: root.editing ? #ffffff : Comic.yellow;
            font-family: "Bangers";
            font-size: 13px;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
    }
    // Holds the transcript for a moment while it is copied.
    copy-buf := TextInput {
        x: 0;
        y: 0;
        width: 20px;
        height: 20px;
        color: transparent;
        read-only: true;
    }
    copied-timer := Timer {
        interval: 1500ms;
        running: false;
        triggered => {
            root.copied = false;
            self.running = false;
        }
    }
}

// The main page's state and actions, in one place for every skin: a skin reads and
// sets these and calls the actions, and only decides how things look and where they
// sit. AppWindow links its own properties to these (<=>), so the app sets them there
// as before; the actions are handled in Rust through this global.
export global Main {
    // Recording: whether it runs, the timer, the live level bars and the microphone.
    in-out property <bool> recording;
    in-out property <bool> paused;
    in property <string> elapsed: "00:00";
    in property <string> elapsed-tenth: ".0";
    in property <[float]> live;
    in property <string> device-label;

    // The clips of the project shown and the highlighted one, or -1.
    in property <[ClipRow]> clips;
    // How many of them have a transcript (the Desktop 95 status bar shows it).
    in property <int> transcribed-count;
    in-out property <int> selected: -1;
    // Clip loaded in the player (playing or paused), or -1.
    in property <int> active-clip: -1;
    in property <bool> playing;
    in property <float> play-fraction;
    in property <string> play-position: "0:00";
    // Picking clips: a click, Ctrl+click (add or remove) or Shift+click (a range).
    in property <[bool]> picked;
    in property <int> picked-count;
    // How far the list is scrolled (0 or less) and how much of it shows.
    in-out property <length> list-y;
    // The height of one clip row; the skin shown sets it (54px for the classic look).
    in-out property <length> row-h: 54px;
    in-out property <length> list-height: 300px;
    // Clips side by side in one row of the list: 4 for the Pocket Synth's pad bank (skin
    // 11) in a wide window; every other skin one. Keyboard scrolling and clamp-list count
    // rows with it.
    out property <int> list-cols: Theme.skin == 11 && Win.width >= 820px ? 4 : 1;

    // The projects (0 is Inbox) and the one shown.
    in property <[string]> projects: ["Inbox"];
    in property <int> project;
    // Search over the list: the text, whether it covers all projects, and the results.
    in-out property <string> query;
    in-out property <bool> search-all;
    in property <[SearchHit]> hits;
    // Ctrl+F counts it up, which puts the cursor in the search field.
    in-out property <int> search-ticket;
    // The local AI is there, so Ask is offered.
    in property <bool> can-ai;
    // The question in front of the page (see AppWindow.dialog) and the text typed in it.
    in-out property <int> dialog;
    in-out property <string> dialog-text;
    // The message floating above the footer.
    in-out property <string> status;
    // Export progress: 0 none, 1 exporting (export-progress, 0 to 1), 2 done. The
    // Export button fills as it goes; on the clips page a strip above the player shows it.
    in-out property <int> export-state;
    in property <float> export-progress;
    // What is being exported, a file or folder name.
    in property <string> export-name;

    callback toggle-record();
    callback toggle-pause();
    callback minimize-window();
    callback close-window();
    // Shrinks the window to the small widget (true) or opens it again.
    callback compact-changed(bool);
    // Asks for audio files and adds each as a clip; AppWindow.imported reports back.
    callback import-files();
    callback choose-project(int);
    callback delete-project();
    callback export-project();
    // Clip i moves to project p.
    callback move-clip(int, int);
    callback search(string, bool);
    callback open-hit(int);
    // Play or pause clip `i` from the list.
    callback play-clip(int);
    callback open-clip(int);
    // Clip i at a point of its length (0..1): cue puts it there without playing,
    // play-clip-at plays from there.
    callback cue-clip(int, float);
    callback play-clip-at(int, float);
    callback pick(int, bool, bool);
    callback start-merge();
    // See ExportButton for the kinds.
    callback export-as(int);
    // Jumps in the clip in the player, as a part of its length.
    callback seek-fraction(float);

    // Keeps the list from staying scrolled past its end after it shrinks (a delete).
    public function clamp-list() {
        self.list-y = clamp(self.list-y, min(0px, self.list-height - Math.ceil(self.clips.length / self.list-cols) * self.row-h), 0px);
    }
}

// The state of the other pages (one clip, settings, models, merge, ask, the questions and
// the overlays), in one place for every skin, as Main is for the main page. AppWindow
// links its own properties to these (<=>), so the app sets them there as before; a skin
// reads them here and reports actions back through its callbacks.
export global Pages {
    // One clip.
    in-out property <int> speed-index: 1;
    in-out property <bool> show-marks: true;
    in-out property <bool> looping;
    in property <[float]> detail-wave;
    in-out property <float> trim-start: 0;
    in-out property <float> trim-end: 1;
    in property <string> detail-meta;
    // The same without its file name, and the file name alone (Desktop 95's two lines).
    in property <string> detail-head;
    in property <string> detail-file;
    in-out property <bool> renaming;
    in property <[OrderRow]> parts;
    in property <bool> parts-busy;
    // The transcript card.
    in property <bool> can-transcribe;
    in property <bool> transcribing;
    in property <bool> translating;
    in property <string> translation;
    in-out property <string> shown-lang;
    in property <[LangRow]> langs;
    in property <string> summary;
    in property <bool> summarising;
    in-out property <bool> show-summary;
    in property <float> transcribe-progress;
    in property <string> transcript;
    in property <[WordRow]> words;
    in property <int> current-word: -1;
    in property <string> edit-badge;
    in-out property <string> edit-draft;
    in-out property <bool> editing;
    in-out property <bool> speaking;
    in property <float> speak-progress;
    in property <string> speak-stage;
    // Settings.
    in property <[string]> mic-devices;
    in-out property <int> mic-index;
    in-out property <bool> record-system;
    in property <string> folder;
    in property <string> name-template;
    in property <string> name-preview;
    in property <bool> name-invalid;
    in-out property <int> export-format;
    in-out property <bool> clean-voice;
    in property <[string]> languages;
    in-out property <int> language-index;
    in property <[string]> hotkey-parts;
    in-out property <bool> close-to-tray: true;
    in property <[string]> recording-limits;
    in-out property <int> recording-limit-index: 2;
    in-out property <bool> start-with-windows;
    in-out property <bool> auto-transcribe;
    in-out property <bool> ai-names;
    in property <[string]> max-pauses;
    in-out property <int> max-pause-index;
    in property <[string]> ai-models;
    in-out property <int> ai-model-index;
    in property <bool> ai-ready;
    in property <float> ai-download: -1;
    in property <bool> translator-ready;
    in property <float> translator-download: -1;
    // Models.
    in property <[ModelRow]> models;
    in property <string> model-summary;
    in property <string> models-used;
    in property <int> model-count;
    in-out property <string> model-query;
    in-out property <int> model-filter;
    in-out property <bool> model-compressed;
    in property <int> downloading: -1;
    in property <float> download-progress;
    // Merge.
    in property <[OrderRow]> merge-rows;
    in-out property <string> merge-name;
    in property <bool> merging;
    // The merged length ("19:00") and each clip's part of it, in order (the Car
    // Dashboard's route gauge and its legs).
    in property <string> merge-total;
    in property <[float]> merge-legs;
    // Ask.
    in-out property <string> question;
    in-out property <bool> ask-all;
    in property <string> answer;
    in property <bool> asking;
    in property <[AskSource]> sources;
    // The questions (Main.dialog): which clip, how many a delete removes, which part.
    in-out property <int> dialog-clip;
    in-out property <int> delete-count: 1;
    in-out property <int> dialog-part;
    // Files are being dragged over the window.
    in property <bool> dropping;
}

// The trim handles and seeking of the one-clip waveform: a drag near a handle moves the
// start or end of the kept part, a click elsewhere jumps there. The drawing sits `pad`
// in from each side, so a handle at an end can still be grabbed. Every skin's waveform
// puts one over its drawing.
export component TrimTouch inherits TouchArea {
    in property <length> pad: 8px;
    // The handle being dragged: 1 start, 2 end, 0 none; and whether it moved.
    in-out property <int> grab;
    in-out property <bool> dragged;
    property <length> inner-w: self.width - 2 * root.pad;
    out property <length> at: self.mouse-x - root.pad;
    property <length> start-x: Pages.trim-start * root.inner-w;
    property <length> end-x: Pages.trim-end * root.inner-w;
    // The kept part changed: its start and end, as parts of the length.
    callback trimmed(float, float);
    // After every click, so the window gets its keys back.
    callback tapped();
    mouse-cursor: abs(self.at - root.start-x) <= 8px || abs(self.at - root.end-x) <= 8px
        ? MouseCursor.ew-resize : MouseCursor.pointer;
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
            root.dragged = false;
            root.grab = abs(self.at - root.start-x) <= 8px ? 1
                : abs(self.at - root.end-x) <= 8px ? 2 : 0;
        }
        if (e.kind == PointerEventKind.up && root.grab != 0) {
            if (root.dragged) { root.trimmed(Pages.trim-start, Pages.trim-end); }
            root.grab = 0;
        }
    }
    moved => {
        if (root.grab == 1) {
            Pages.trim-start = clamp(self.at / root.inner-w, 0, Pages.trim-end - 0.01);
            root.dragged = true;
        } else if (root.grab == 2) {
            Pages.trim-end = clamp(self.at / root.inner-w, Pages.trim-start + 0.01, 1);
            root.dragged = true;
        }
    }
    clicked => {
        // Runs before the release above; `dragged` is reset on the next press.
        if (!root.dragged) { Main.seek-fraction(clamp(self.at / root.inner-w, 0, 1)); }
        root.tapped();
    }
}
