        y: root.upwards ? -root.list-height - 4px : root.height + 4px;
        // Brick Phone: wide enough for the longest setting's name in its title bar.
        width: Theme.brick ? max(root.width, 180px) : max(root.width, Theme.quest ? 180px : 120px);
        height: root.list-height;
        close-policy: close-on-click-outside;
